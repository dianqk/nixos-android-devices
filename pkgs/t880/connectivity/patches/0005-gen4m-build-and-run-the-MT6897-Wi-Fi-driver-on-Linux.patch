+				 buf, len);
+}
+#endif
+
+static int t880_cfg_del_station(struct wiphy *wiphy, struct wireless_dev *wdev,
+	struct station_del_parameters *params)
+{
+	return mtk_cfg_del_station(wiphy, wdev->netdev, params);
+}
+
+/* cfg80211 now allocates the cookie; gen4m keeps a non-zero preset. */
+static int t880_cfg_remain_on_channel(struct wiphy *wiphy,
+	struct wireless_dev *wdev, struct ieee80211_channel *chan,
+	unsigned int duration, u64 cookie, const u8 *rx_addr)
+{
+	u64 c = cookie;
+
+	return mtk_cfg_remain_on_channel(wiphy, wdev, chan, duration, &c);
+}
+
+static int t880_cfg_mgmt_tx(struct wiphy *wiphy, struct wireless_dev *wdev,
+	struct cfg80211_mgmt_tx_params *params, u64 cookie)
+{
+	u64 c = cookie;
+
+	return mtk_cfg_mgmt_tx(wiphy, wdev, params, &c);
+}
