+/*
+ * T880 port: adapters from the 7.x cfg80211_ops prototypes (wireless_dev,
+ * link_id/radio_idx, caller-provided cookies) to the gen4m handlers.
+ */
+static int t880_cfg_add_key(struct wiphy *wiphy, struct wireless_dev *wdev,
+	int link_id, u8 key_index, bool pairwise, const u8 *mac_addr,
+	struct key_params *params)
+{
+	return mtk_cfg_add_key(wiphy, wdev->netdev, link_id, key_index,
+			       pairwise, mac_addr, params);
+}
+
+static int t880_cfg_get_key(struct wiphy *wiphy, struct wireless_dev *wdev,
+	int link_id, u8 key_index, bool pairwise, const u8 *mac_addr,
+	void *cookie, void (*callback)(void *cookie, struct key_params *))
+{
+	return mtk_cfg_get_key(wiphy, wdev->netdev, link_id, key_index,
+			       pairwise, mac_addr, cookie, callback);
+}
+
+static int t880_cfg_del_key(struct wiphy *wiphy, struct wireless_dev *wdev,
+	int link_id, u8 key_index, bool pairwise, const u8 *mac_addr)
+{
+	return mtk_cfg_del_key(wiphy, wdev->netdev, link_id, key_index,
+			       pairwise, mac_addr);
+}
+
+static int t880_cfg_set_default_mgmt_key(struct wiphy *wiphy,
+	struct wireless_dev *wdev, int link_id, u8 key_index)
+{
+	return mtk_cfg_set_default_mgmt_key(wiphy, wdev->netdev, link_id,
+					    key_index);
+}
+
+#if (CFG_SUPPORT_BCN_PROT == 1)
+static int t880_cfg_set_default_beacon_key(struct wiphy *wiphy,
+	struct wireless_dev *wdev, int link_id, u8 key_index)
+{
+	return mtk_cfg_set_default_beacon_key(wiphy, wdev->netdev, link_id,
+					      key_index);
+}
+#endif
+
+static int t880_cfg_get_station(struct wiphy *wiphy, struct wireless_dev *wdev,
+	const u8 *mac, struct station_info *sinfo)
+{
+	return mtk_cfg_get_station(wiphy, wdev->netdev, mac, sinfo);
