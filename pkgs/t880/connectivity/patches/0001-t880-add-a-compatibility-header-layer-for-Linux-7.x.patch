diff --git a/compat/include/linux/of_gpio.h b/compat/include/linux/of_gpio.h
new file mode 100644
index 0000000..466eaa8
--- /dev/null
+++ b/compat/include/linux/of_gpio.h
@@ -0,0 +1,12 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* T880 port: the legacy of_gpio API is gone; nothing here needs a GPIO. */
+#ifndef T880_OF_GPIO_H
+#define T880_OF_GPIO_H
+#include <linux/errno.h>
+#include <linux/gpio.h>
+#include <linux/of.h>
+static inline int of_get_named_gpio(const struct device_node *np, const char *propname, int index)
+{
+	return -ENOENT;
+}
+#endif
diff --git a/compat/include/mtk_ccci_common.h b/compat/include/mtk_ccci_common.h
new file mode 100644
index 0000000..a5a2159
--- /dev/null
+++ b/compat/include/mtk_ccci_common.h
@@ -0,0 +1,2 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* T880 out-of-tree build: vendor header not available (unused paths). */
diff --git a/compat/include/mtk_disp_notify.h b/compat/include/mtk_disp_notify.h
new file mode 100644
index 0000000..2c33e2d
--- /dev/null
+++ b/compat/include/mtk_disp_notify.h
@@ -0,0 +1,12 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* T880 port: no MediaTek display notifier; registration is a no-op. */
+#ifndef _MTK_DISP_NOTIFY_H_
+#define _MTK_DISP_NOTIFY_H_
+#include <linux/notifier.h>
+#define MTK_DISP_EARLY_EVENT_BLANK 0x00
+#define MTK_DISP_EVENT_BLANK 0x01
+#define MTK_DISP_BLANK_UNBLANK 0x00
+#define MTK_DISP_BLANK_POWERDOWN 0x01
+static inline int mtk_disp_notifier_register(const char *source, struct notifier_block *nb) { return 0; }
+static inline int mtk_disp_notifier_unregister(struct notifier_block *nb) { return 0; }
+#endif
diff --git a/compat/include/soc/mediatek/emi.h b/compat/include/soc/mediatek/emi.h
new file mode 100644
index 0000000..a5a2159
--- /dev/null
+++ b/compat/include/soc/mediatek/emi.h
@@ -0,0 +1,2 @@
