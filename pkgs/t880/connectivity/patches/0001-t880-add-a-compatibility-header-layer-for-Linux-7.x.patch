From c2d0abaff2965f44ee0360256814de754c860624 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Fri, 16 Oct 2026 12:20:48 +0800
Subject: [PATCH] t880: add a compatibility header layer for Linux 7.x

The vendor connectivity drivers target Android kernels and MediaTek
platform headers. Add a force-included header with the renamed kernel
APIs (timers, alarm, strncpy, the connsys SiP SMC id) and minimal stub
headers for the MediaTek platform interfaces these drivers include but
do not need on a mainline kernel (EMI, CCCI, build-in adapter, display
notifier, connsys power throttling), plus <asm/unaligned.h> and the
legacy of_gpio helper used by the Bluetooth driver.

Signed-off-by: dianqk <dianqk@dianqk.net>
---
 compat/include/asm/unaligned.h                |  3 ++
 compat/include/conn_power_throttling.h        | 42 +++++++++++++++++++
 .../include/connectivity_build_in_adapter.h   |  5 +++
 compat/include/linux/of_gpio.h                | 12 ++++++
 compat/include/mtk_ccci_common.h              |  2 +
 compat/include/mtk_disp_notify.h              | 12 ++++++
 compat/include/soc/mediatek/emi.h             |  2 +
 compat/t880_compat.h                          | 40 ++++++++++++++++++
 8 files changed, 118 insertions(+)
 create mode 100644 compat/include/asm/unaligned.h
 create mode 100644 compat/include/conn_power_throttling.h
 create mode 100644 compat/include/connectivity_build_in_adapter.h
 create mode 100644 compat/include/linux/of_gpio.h
 create mode 100644 compat/include/mtk_ccci_common.h
 create mode 100644 compat/include/mtk_disp_notify.h
 create mode 100644 compat/include/soc/mediatek/emi.h
 create mode 100644 compat/t880_compat.h

diff --git a/compat/include/asm/unaligned.h b/compat/include/asm/unaligned.h
new file mode 100644
index 0000000..f5d94b5
--- /dev/null
+++ b/compat/include/asm/unaligned.h
@@ -0,0 +1,3 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* T880 port: <asm/unaligned.h> moved to <linux/unaligned.h> (6.12). */
+#include <linux/unaligned.h>
diff --git a/compat/include/conn_power_throttling.h b/compat/include/conn_power_throttling.h
new file mode 100644
index 0000000..b000845
--- /dev/null
+++ b/compat/include/conn_power_throttling.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * T880 port: types of the MediaTek connsys power-throttling interface
+ * (connadp/power_throttling/conn_power_throttling.h) with no-op calls. The
+ * mainline kernel has no low-battery/thermal arbitration for connsys; the
+ * drivers keep their default (unthrottled) level.
+ */
+#ifndef T880_CONN_POWER_THROTTLING_H
+#define T880_CONN_POWER_THROTTLING_H
+enum conn_pwr_drv_type {
+	CONN_PRW_DRV_ALL = -1,
+	CONN_PWR_DRV_BT = 0,
+	CONN_PWR_DRV_FM = 1,
+	CONN_PWR_DRV_GPS = 2,
+	CONN_PWR_DRV_WIFI = 3,
+	CONN_PWR_DRV_MAX
+};
+enum conn_pwr_low_battery_level {
+	CONN_PWR_THR_LV_0 = 0,
+	CONN_PWR_THR_LV_1 = 1,
+	CONN_PWR_THR_LV_2 = 2,
+	CONN_PWR_THR_LV_3 = 3,
+	CONN_PWR_THR_LV_4 = 4,
+	CONN_PWR_THR_LV_5 = 5,
+	CONN_PWR_LOW_BATTERY_MAX
+};
+enum conn_pwr_event_type {
+	CONN_PWR_EVENT_LEVEL = 0,
+	CONN_PWR_EVENT_MAX_TEMP = 1,
+	CONN_PWR_EVENT_MAX
+};
+struct conn_pwr_event_max_temp {
+	int max_temp;
+	int recovery_temp;
+};
+typedef int (*CONN_PWR_EVENT_CB)(enum conn_pwr_event_type type, void *data);
+static inline int conn_pwr_register_event_cb(enum conn_pwr_drv_type type, CONN_PWR_EVENT_CB cb) { return 0; }
+static inline int conn_pwr_drv_pre_on(enum conn_pwr_drv_type type, enum conn_pwr_low_battery_level *level) { return 0; }
+static inline int conn_pwr_drv_post_off(enum conn_pwr_drv_type type) { return 0; }
+static inline int conn_pwr_get_drv_level(enum conn_pwr_drv_type type, enum conn_pwr_low_battery_level *level) { *level = CONN_PWR_THR_LV_0; return 0; }
+static inline int conn_pwr_notify_event(enum conn_pwr_drv_type drv, enum conn_pwr_event_type event, void *data) { return 0; }
+#endif
diff --git a/compat/include/connectivity_build_in_adapter.h b/compat/include/connectivity_build_in_adapter.h
