+/* T880 out-of-tree build: vendor header not available (unused paths). */
diff --git a/compat/t880_compat.h b/compat/t880_compat.h
new file mode 100644
index 0000000..538e578
--- /dev/null
+++ b/compat/t880_compat.h
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Out-of-tree build of the MediaTek connectivity stack on mainline. */
+#ifndef T880_COMPAT_H
+#define T880_COMPAT_H
+#include <linux/string.h>
+#include <linux/vmalloc.h>
+#include <linux/timer.h>
+#include <linux/slab.h>
+
+/* MediaTek SiP SMC for the connsys (vendor mtk_sip_svc.h) */
+#ifndef MTK_SIP_KERNEL_CONNSYS_CONTROL
+#define MTK_SIP_KERNEL_CONNSYS_CONTROL	0xC2000534
+#endif
+
+#include <linux/alarmtimer.h>
+
+/* Removed or renamed APIs on 7.3 */
+#ifndef from_timer
+#define from_timer(var, callback_timer, timer_fieldname) \
+	timer_container_of(var, callback_timer, timer_fieldname)
+#endif
+#define del_timer_sync(t)	timer_delete_sync(t)
+#define del_timer(t)		timer_delete(t)
+
+static inline char *t880_strncpy(char *dst, const char *src, size_t n)
+{
+	size_t i;
+
+	for (i = 0; i < n && src[i]; i++)
+		dst[i] = src[i];
+	for (; i < n; i++)
+		dst[i] = '\0';
+	return dst;
+}
+#define strncpy t880_strncpy
+
+/* alarm_start_relative() became alarm_start_timer(..., true) */
+#define alarm_start_relative(a, t)	alarm_start_timer(a, t, true)
+
+#endif /* T880_COMPAT_H */
