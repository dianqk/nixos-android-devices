+#[cfg(test)]
+mod dependency_tests {
+    use super::*;
+    use std::sync::atomic::{AtomicU64, Ordering};
+    static NEXT: AtomicU64 = AtomicU64::new(0);
+
+    struct Fixture(PathBuf);
+    impl Fixture {
+        fn new() -> Self {
+            let dir = env::temp_dir().join(format!("make-initrd-dependencies-{}-{}",
+                std::process::id(), NEXT.fetch_add(1, Ordering::Relaxed)));
+            fs::create_dir(&dir).unwrap();
+            Self(dir)
+        }
+        fn file(&self, name: &str) -> PathBuf {
+            let file = self.0.join(name);
+            fs::create_dir_all(file.parent().unwrap()).unwrap();
+            fs::write(&file, b"fixture").unwrap();
+            file
+        }
+        fn rpaths(&self) -> Vec<Box<Path>> { vec![self.0.join("lib").into_boxed_path()] }
+    }
+    impl Drop for Fixture {
+        fn drop(&mut self) { fs::remove_dir_all(&self.0).unwrap(); }
+    }
+    fn names(values: &[&str]) -> Vec<String> { values.iter().map(|s| s.to_string()).collect() }
+
+    #[test]
+    fn available_dlopen_alternative_satisfies_group() {
+        let f = Fixture::new();
+        let expected = f.file("lib/libcrypto.so.3");
+        assert_eq!(find_dependency(&f.0.join("bin/tool"), &names(&["libcrypto.so.3", "libcrypto.so.4"]), &f.rpaths()), Some(expected));
+    }
+    #[test]
+    fn fallback_dlopen_alternative_is_included() {
+        let f = Fixture::new();
+        let expected = f.file("lib/libssl.so.4");
+        assert_eq!(find_dependency(&f.0.join("bin/tool"), &names(&["libssl.so.3", "libssl.so.4"]), &f.rpaths()), Some(expected));
+    }
+    #[test]
+    fn only_first_available_alternative_is_selected() {
+        let f = Fixture::new();
+        let expected = f.file("lib/libbpf.so.1");
+        f.file("lib/libbpf.so.0");
+        assert_eq!(find_dependency(&f.0.join("bin/tool"), &names(&["libbpf.so.1", "libbpf.so.0"]), &f.rpaths()), Some(expected));
+    }
+    #[test]
+    fn missing_dependency_is_not_satisfied() {
+        let f = Fixture::new();
+        assert_eq!(find_dependency(&f.0.join("bin/tool"), &names(&["missing.so.1", "missing.so.2"]), &f.rpaths()), None);
+    }
+    #[test]
+    fn needed_toolchain_sibling_is_included() {
+        let f = Fixture::new();
+        let expected = f.file("toolchain/libgcc_s.so.1");
+        assert_eq!(find_dependency(&f.0.join("toolchain/libstdc++.so.6"), &names(&["libgcc_s.so.1"]), &f.rpaths()), Some(expected));
+    }
+    #[test]
+    fn runpath_takes_precedence_over_sibling() {
+        let f = Fixture::new();
+        let expected = f.file("lib/libgcc_s.so.1");
+        f.file("toolchain/libgcc_s.so.1");
+        assert_eq!(find_dependency(&f.0.join("toolchain/libstdc++.so.6"), &names(&["libgcc_s.so.1"]), &f.rpaths()), Some(expected));
+    }
+}
