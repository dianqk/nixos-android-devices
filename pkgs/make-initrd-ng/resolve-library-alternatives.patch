+// A dlopen note lists alternative SONAMEs in preference order (UAPI.12).
+// Keep DT_NEEDED entries as singleton groups: each one is required separately.
+fn find_dependency(source: &Path, alternatives: &[String], rpaths: &[Box<Path>]) -> Option<PathBuf> {
+    alternatives.iter().find_map(|name| {
+        rpaths.iter().map(|dir| dir.join(name))
+            // Toolchain libraries can omit their own directory from RUNPATH.
+            // Include an existing sibling rather than merely hiding its warning.
+            .chain(source.parent().map(|dir| dir.join(name)))
+            .find(|candidate| candidate.is_file())
+    })
 }
 
