From: dianqk <dianqk@dianqk.net>
Date: Sat, 3 Oct 2026 17:20:00 +0800
Subject: [PATCH] avcodec/v4l2: drain encoders through LAST instead of empty buffers

A successful encoder STOP can produce EOS before the final CAPTURE buffers.
Recycled capture buffers may also return empty with ERROR, without LAST.
Neither condition terminates the stateful encoder drain. Waiting for LAST or
EPIPE prevents a timing-dependent loss of the final encoded picture.

Track successful ENCODER_CMD support, keep legacy STREAMOFF and decoder
behavior, and repoll event-only wakeups instead of returning early EOF/EAGAIN.
Consume empty non-LAST buffers without requeueing them into a stopped encoder.

API contract:
https://docs.kernel.org/userspace-api/media/v4l/dev-encoder.html#drain

--- a/libavcodec/v4l2_context.c
+++ b/libavcodec/v4l2_context.c
@@ -183,12 +183,18 @@
 
     ret = ioctl(s->fd, VIDIOC_DQEVENT, &evt);
     if (ret < 0) {
+        int err = errno;
         av_log(logger(ctx), AV_LOG_ERROR, "%s VIDIOC_DQEVENT\n", ctx->name);
+        if (s->encoder_drain && err != EAGAIN && err != EINTR)
+            return AVERROR(err);
         return 0;
     }
 
     if (evt.type == V4L2_EVENT_EOS) {
-        ctx->done = 1;
+        /* EOS may precede the final CAPTURE buffers. Modern encoders must
+         * dequeue through LAST/EPIPE, not stop at this deprecated event. */
+        if (!s->encoder_drain)
+            ctx->done = 1;
         return 0;
     }
 
@@ -264,6 +270,7 @@
             return AVERROR(errno);
     }
 
+    ctx_to_m2mctx(ctx)->encoder_drain = 1;
     return 0;
 }
 
@@ -277,6 +284,11 @@
         .fd = ctx_to_m2mctx(ctx)->fd,
     };
     int i, ret;
+    int encoder_drain = ctx_to_m2mctx(ctx)->encoder_drain &&
+                        !V4L2_TYPE_IS_OUTPUT(ctx->type);
+
+    if (encoder_drain && (ctx->done || ctx_to_m2mctx(ctx)->encoder_drain_error))
+        return NULL;
 
     if (!V4L2_TYPE_IS_OUTPUT(ctx->type) && ctx->buffers) {
         for (i = 0; i < ctx->num_buffers; i++) {
@@ -291,7 +303,7 @@
     }
 
     /* if we are draining and there are no more capture buffers queued in the driver we are done */
-    if (!V4L2_TYPE_IS_OUTPUT(ctx->type) && ctx_to_m2mctx(ctx)->draining) {
+    if (!encoder_drain && !V4L2_TYPE_IS_OUTPUT(ctx->type) && ctx_to_m2mctx(ctx)->draining) {
         for (i = 0; i < ctx->num_buffers; i++) {
             /* capture buffer initialization happens during decode hence
              * detection happens at runtime
@@ -319,8 +331,15 @@
         ret = poll(&pfd, 1, timeout);
         if (ret > 0)
             break;
-        if (errno == EINTR)
+        if (ret < 0 && errno == EINTR)
             continue;
+        if (encoder_drain)
+            ctx_to_m2mctx(ctx)->encoder_drain_error = AVERROR(ret < 0 ? errno : ETIMEDOUT);
+        return NULL;
+    }
+
+    if (encoder_drain && (pfd.revents & (POLLERR | POLLHUP | POLLNVAL))) {
+        ctx_to_m2mctx(ctx)->encoder_drain_error = AVERROR(EIO);
         return NULL;
     }
 
@@ -349,6 +368,8 @@
         ret = v4l2_handle_event(ctx);
         if (ret < 0) {
             /* if re-init failed, abort */
+            if (encoder_drain)
+                ctx_to_m2mctx(ctx)->encoder_drain_error = ret;
             ctx->done = 1;
             return NULL;
         }
@@ -359,6 +380,11 @@
             return NULL;
         }
     }
+
+    /* An event-only wakeup does not complete an encoder drain. */
+    if (encoder_drain && (pfd.revents & POLLPRI) &&
+        !(pfd.revents & (POLLIN | POLLRDNORM)))
+        goto start;
 
     /* 2. dequeue the buffer */
     if (pfd.revents & (POLLIN | POLLRDNORM | POLLOUT | POLLWRNORM)) {
@@ -387,6 +413,10 @@
 
         ret = ioctl(ctx_to_m2mctx(ctx)->fd, VIDIOC_DQBUF, &buf);
         if (ret) {
+            if (encoder_drain && errno == EAGAIN)
+                goto start;
+            if (encoder_drain && errno != EPIPE)
+                ctx_to_m2mctx(ctx)->encoder_drain_error = AVERROR(errno);
             if (errno != EAGAIN) {
                 ctx->done = 1;
                 if (errno != EPIPE)
@@ -400,6 +430,13 @@
             int bytesused = V4L2_TYPE_IS_MULTIPLANAR(buf.type) ?
                             buf.m.planes[0].bytesused : buf.bytesused;
             if (bytesused == 0) {
+                ctx->buffers[buf.index].status = V4L2BUF_AVAILABLE;
+                if (encoder_drain && !(buf.flags & V4L2_BUF_FLAG_LAST)) {
+                    /* A recycled buffer can return empty/ERROR after STOP.
+                     * Consume it without requeueing; real output and LAST
+                     * may still be waiting behind it. */
+                    goto start;
+                }
                 ctx->done = 1;
                 return NULL;
             }
@@ -570,6 +607,11 @@
         return AVERROR(errno);
 
     ctx->streamon = (cmd == VIDIOC_STREAMON);
+    if (ctx->streamon) {
+        ctx_to_m2mctx(ctx)->encoder_drain = 0;
+        ctx_to_m2mctx(ctx)->encoder_drain_error = 0;
+        ctx->done = 0;
+    }
 
     return 0;
 }
@@ -582,8 +624,10 @@
 
     if (!frame) {
         ret = v4l2_stop_encode(ctx);
-        if (ret)
+        if (ret) {
             av_log(logger(ctx), AV_LOG_ERROR, "%s stop_encode\n", ctx->name);
+            return ret;
+        }
         s->draining= 1;
         return 0;
     }
@@ -655,6 +699,8 @@
      */
     avbuf = v4l2_dequeue_v4l2buf(ctx, -1);
     if (!avbuf) {
+        if (ctx_to_m2mctx(ctx)->encoder_drain_error)
+            return ctx_to_m2mctx(ctx)->encoder_drain_error;
         if (ctx->done)
             return AVERROR_EOF;
 
--- a/libavcodec/v4l2_m2m.h
+++ b/libavcodec/v4l2_m2m.h
@@ -56,6 +56,9 @@
 
     /* null frame/packet received */
     int draining;
+    /* Successful encoder STOP requires draining CAPTURE through LAST/EPIPE. */
+    int encoder_drain;
+    int encoder_drain_error;
     AVPacket buf_pkt;
 
     /* Reference to a frame. Only used during encoding */
