+++ b/libavcodec/v4l2_nv12_copy.h
@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef AVCODEC_V4L2_NV12_COPY_H
+#define AVCODEC_V4L2_NV12_COPY_H
+
+#include <errno.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+/* Source rows describe visible pixels; V4L2 stride/height describe storage.
+ * NV12 and NV21 each have one contiguous V4L2 plane and two AVFrame planes.
+ */
+static inline int ff_v4l2_copy_nv12(uint8_t *dst, size_t capacity,
+                                  int stride, int storage_height,
+                                  const uint8_t *y, int y_stride,
+                                  const uint8_t *uv, int uv_stride,
+                                  int width, int height, size_t *used)
+{
+    size_t y_size, uv_size, uv_rows;
+    int row, uv_width;
+
+    if (!dst || !y || !uv || !used || width <= 0 || height <= 0 ||
+        stride <= 0 || storage_height < height || width > stride)
+        return -EINVAL;
+    /* Avoid width + 1 overflow and permit an odd visible width. */
+    uv_width = width / 2 + width % 2;
+    if (uv_width > stride / 2)
+        return -EINVAL;
+    uv_width *= 2;
+    if ((y_stride < width && y_stride > -width) ||
+        (uv_stride < uv_width && uv_stride > -uv_width))
+        return -EINVAL;
+    if ((size_t)storage_height > capacity / stride)
+        return -ENOSPC;
+    y_size = (size_t)stride * storage_height;
+    uv_rows = (size_t)storage_height / 2 + storage_height % 2;
+    if (uv_rows > (capacity - y_size) / stride)
+        return -ENOSPC;
+    uv_size = uv_rows * stride;
+
+    memset(dst, 16, y_size);
+    memset(dst + y_size, 128, uv_size);
+    for (row = 0; row < height; row++)
+        memcpy(dst + (size_t)row * stride, y + (ptrdiff_t)row * y_stride, width);
+    for (row = 0; row < height / 2 + height % 2; row++)
+        memcpy(dst + y_size + (size_t)row * stride,
+               uv + (ptrdiff_t)row * uv_stride, uv_width);
+    *used = y_size + uv_size;
+    return 0;
+}
+#endif
