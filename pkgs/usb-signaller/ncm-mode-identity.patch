+    fn ncm_mode(gadget_name: &str, netboot: bool) -> UDCMode {
+        // Global IP forwarding can serve other interfaces and does not identify
+        // this gadget's mode. Keep the read-only netboot protection first.
+        if netboot {
+            UDCMode::Netboot
+        } else if gadget_name == "usb-signaller-tethering" {
+            UDCMode::Tethering
+        } else {
