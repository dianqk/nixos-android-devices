// SPDX-License-Identifier: BSD-3-Clause
//
// IPrimordial is not published in minkipc; MinkSocket's Primordial.c
// implements it with a single method, registerSubNotifier(target, handler,
// &subNotifier). Operation number and argument layout checked against the
// Primordial invoke function of the vendor libminksocket_vendor.so
// (Aurora OS1.0.3.0.UNACNXM, AArch64, code at 0x175b8): method ID 0 is
// accepted only with ObjectCounts 0x1200 (no buffers, two input objects, one
// output object); 0xffff/0xfffe are release/retain. The same library compares
// forwarder handles with 0x3ff (PRIMORDIAL_HANDLE, see mink_compat.h).
//
// This build leaves out MinkSocket's close notifier (CLOSE_NOTIFIER), so
// registerSubNotifier answers Object_ERROR_UNAVAIL.
interface IPrimordial {
  method registerSubNotifier(in interface target, in interface handler,
                             out interface subNotifier);
};
