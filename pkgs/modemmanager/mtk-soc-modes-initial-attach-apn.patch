                                     payload->data, payload->len);
 }
 
+GBytes *
+mm_mtk_mipc_apn_set_ia_request (guint8        ps,
+                                guint16       transaction_id,
+                                const gchar  *apn,
+                                GError      **error)
+{
+    g_autoptr(GByteArray) payload = NULL;
+    g_autofree guint8 *apn_value = NULL;
+    guint16 apn_len = 0;
+    const guint8 wildcard = '*';
+    guint8 byte;
+
+    g_return_val_if_fail (error == NULL || *error == NULL, NULL);
+    if (!apn) {
+        g_set_error_literal (error, MM_MTK_MIPC_ERROR, MM_MTK_MIPC_ERROR_INVALID,
+                             "MIPC APN must be given");
+        return NULL;
+    }
+    apn_value = c_string_value (apn, MM_MTK_MIPC_MAX_APN_LEN, "APN", &apn_len, error);
+    if (!apn_value)
+        return NULL;
+
+    payload = g_byte_array_new ();
+    /* Stock wire order; empty credentials are sent as "*" without a NUL. */
+    append_tlv (payload, 0x8106, &wildcard, 1);
+    append_tlv (payload, 0x0101, apn_value, apn_len);
+    byte = 3;
+    append_tlv (payload, 0x0102, &byte, 1);
+    append_tlv (payload, 0x0103, &byte, 1);
+    byte = 0;
+    append_tlv (payload, 0x0104, &byte, 1);
+    append_tlv (payload, 0x8105, &wildcard, 1);
+    return mm_mtk_mipc_frame_build (MM_MTK_MIPC_APN_SET_IA_REQ, ps, transaction_id,
+                                    payload->data, payload->len);
+}
+
+GBytes *
+mm_mtk_mipc_nw_set_rat_request (guint8  ps,
+                                guint16 transaction_id,
+                                guint8  mode,
+                                guint8  preference)
+{
+    g_autoptr(GByteArray) payload = g_byte_array_new ();
+
+    append_tlv (payload, 0x0100, &mode, 1);
+    append_tlv (payload, 0x0101, &preference, 1);
+    return mm_mtk_mipc_frame_build (MM_MTK_MIPC_NW_SET_RAT_REQ, ps, transaction_id,
+                                    payload->data, payload->len);
+}
