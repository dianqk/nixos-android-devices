@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#ifndef MM_MTK_MIPC_CLIENT_H
+#define MM_MTK_MIPC_CLIENT_H
+
+#include <gio/gio.h>
+
+G_BEGIN_DECLS
+
+/* One-shot MIPC control transactions for the modem object.
+ *
+ * The data bearer keeps /dev/ttyCMIPC1 open while a call is up, so control
+ * requests use their own CCCI MIPC channel (/dev/ttyCMIPC2): open, TEST and
+ * OPEN handshake, one request, wait for its confirmation, CLOSE, close.  The
+ * blocking I/O runs in a GTask worker thread with poll() deadlines.  The
+ * result is the confirmation's result TLV (0x0000); a non-zero result is
+ * returned as an error. */
+
+#define MM_MTK_MIPC_CONTROL_PORT "/dev/ttyCMIPC2"
+
+/* Takes ownership of nothing: `request` is referenced for the operation. */
+void     mm_mtk_mipc_client_transact        (gpointer             source_object,
+                                             GBytes              *request,
+                                             guint16              cnf_message_id,
+                                             guint8               ps,
+                                             guint16              transaction_id,
+                                             guint                timeout_ms,
+                                             GAsyncReadyCallback  callback,
+                                             gpointer             user_data);
+gboolean mm_mtk_mipc_client_transact_finish (gpointer             source_object,
+                                             GAsyncResult        *res,
+                                             GError             **error);
+
+G_END_DECLS
+
+#endif
