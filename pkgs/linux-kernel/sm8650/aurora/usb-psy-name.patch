From 278ec303e203184855c86044927133179897fd57 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Wed, 21 Oct 2026 10:14:22 +0800
Subject: [PATCH] arm64: dts: qcom: aurora: Report the gadget current to the
 battery manager

Name the battery manager's USB supply in the DWC3 node so the gadget's
configured current (vbus_draw) becomes the charger input current limit,
as the stock eUSB2 PHY does with the "usb" supply. Without it a PC port
stays at the firmware's unconfigured 100 mA SDP limit.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/qcom/sm8650-xiaomi-aurora.dts | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8650-xiaomi-aurora.dts b/arch/arm64/boot/dts/qcom/sm8650-xiaomi-aurora.dts
index 67c4c849d04e..36ef4d7fd33d 100644
--- a/arch/arm64/boot/dts/qcom/sm8650-xiaomi-aurora.dts
+++ b/arch/arm64/boot/dts/qcom/sm8650-xiaomi-aurora.dts
@@ -176,6 +176,8 @@ &usb_1 {
 	usb-role-switch;
 	role-switch-default-mode = "peripheral";
 	maximum-speed = "super-speed";
+	/* Report the configured gadget current as the charger input limit. */
+	usb-psy-name = "qcom-battmgr-usb";
 	status = "okay";
 };
 
