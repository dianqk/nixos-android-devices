 static int n1_get_modes(struct drm_panel *panel, struct drm_connector *connector)
 {
-	return drm_connector_helper_get_modes_fixed(connector, &n1_mode);
+	struct n1_panel *ctx = to_n1(panel);
+	struct drm_display_mode *mode;
+	int i;
+
+	ctx->connector = connector;
+	for (i = 0; i < ARRAY_SIZE(n1_modes); i++) {
+		mode = drm_mode_duplicate(connector->dev, &n1_modes[i]);
+		if (!mode)
+			return -ENOMEM;
