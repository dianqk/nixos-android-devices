-static int n1_prepare(struct drm_panel *panel)
-{
-	struct n1_panel *ctx = to_n1(panel);
+/*
+ * The stock 60 Hz mode uses a 1.36 GHz lane rate and a 7300 us MDP
+ * transfer budget. Copying its video-style porches gives only 677 MHz
+ * with MSM's DSC clock calculation, extending the payload to 13.6 ms.
+ *
+ * Command mode has no wire-level horizontal porches. Represent the
+ * transfer budget in horizontal blanking, as required by the current MSM
+ * host, while retaining 60 Hz and the original vertical/TE timing:
+ *   compressed active = ceil(1440 * 8 / 30) = 384
+ *   compressed total = ceil(1360000000 * 4 / (30 * 3244 * 60)) = 932
+ *   htotal = 1440 + (932 - 384) = 1988
+ * The resulting lane rate is 1.36053 GHz (within 0.04% of stock).
+ * See dsi_adjust_pclk_for_compression(); this does not change DDIC commands.
+ */
+static const struct drm_display_mode n1_modes[] = { {
+	.clock = 386944,
+	.hdisplay = 1440, .hsync_start = 1472, .hsync_end = 1488, .htotal = 1988,
+	.vdisplay = 3200, .vsync_start = 3216, .vsync_end = 3220, .vtotal = 3244,
+	.width_mm = 70, .height_mm = 156,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+}, {
+	/* Same lane budget at 120 Hz: compressed total 466, htotal 1522. */
+	.clock = 592484,
+	.hdisplay = 1440, .hsync_start = 1472, .hsync_end = 1488, .htotal = 1522,
+	.vdisplay = 3200, .vsync_start = 3216, .vsync_end = 3220, .vtotal = 3244,
+	.width_mm = 70, .height_mm = 156,
+	.type = DRM_MODE_TYPE_DRIVER,
+} };
+
+/* The panel bridge prepares after atomic state is swapped. Like NT36532E,
+ * select the incoming CRTC mode on every full modeset, including DPMS wake.
+ * Never silently initialize 60 Hz for an unrecognized active mode.
+ */
+static int n1_get_current_mode(struct n1_panel *ctx)
+{
+	struct drm_connector *connector = ctx->connector;
+	struct drm_crtc_state *state;
+	int i;
+
+	if (!connector || !connector->state || !connector->state->crtc)
+		return 0;
+	state = connector->state->crtc->state;
+	if (!state)
+		return -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(n1_modes); i++) {
+		if (drm_mode_match(&state->mode, &n1_modes[i],
+				   DRM_MODE_MATCH_TIMINGS | DRM_MODE_MATCH_CLOCK))
+			return i;
+	}
+	return -EINVAL;
+}
+
+static int n1_send_cmds(struct n1_panel *ctx, const struct n1_cmd *cmds,
+		       size_t count)
+{
 	struct mipi_dsi_device *dsi = ctx->dsi;
-	struct drm_dsc_picture_parameter_set pps;
 	int i, ret;
-	u8 power = 0;
-
-	for (i = 0; i < ARRAY_SIZE(ctx->supplies); i++) {
-		ret = regulator_enable(ctx->supplies[i].consumer);
-		if (ret) {
-			while (i--)
-				regulator_disable(ctx->supplies[i].consumer);
-			return ret;
-		}
-	}
-	msleep(8);
-	gpiod_set_value_cansleep(ctx->reset, 0);
-	usleep_range(1000, 1500);
-	gpiod_set_value_cansleep(ctx->reset, 1);
-	usleep_range(1000, 1500);
-	gpiod_set_value_cansleep(ctx->reset, 0);
-	msleep(10);
-	dev_info(&dsi->dev, "N1 powered and reset; sending stock 60 Hz commands\n");
-
-	/* Keep downstream packet types, byte order and delays, including the
-	 * short payloads deliberately sent as long packets. Vendor batching
-	 * flags are not part of the wire protocol and are not transferred.
-	 */
-	for (i = 0; i < ARRAY_SIZE(n1_on_cmds); i++) {
-		const struct n1_cmd *c = &n1_on_cmds[i];
+
+	/* Preserve stock packet types, byte order, LP state and delays. */
+	for (i = 0; i < count; i++) {
+		const struct n1_cmd *c = &cmds[i];
 		struct mipi_dsi_msg msg = {
 			.channel = dsi->channel,
 			.type = c->type,
@@ -215,11 +262,81 @@
 		if (ret < 0) {
 			dev_err(&dsi->dev, "N1 command %d (0x%02x) failed: %d\n",
 				i, c->data[0], ret);
-			goto fail;
+			return ret;
 		}
 		if (c->delay_ms)
 			msleep(c->delay_ms);
 	}
+	return 0;
+}
+
+static int n1_init(struct n1_panel *ctx, bool high_refresh)
+{
+	int ret;
+
+	ret = n1_send_cmds(ctx, n1_init_common, ARRAY_SIZE(n1_init_common));
+	if (ret)
+		return ret;
+	if (high_refresh) {
+		ret = n1_send_cmds(ctx, n1_init_120hz_osc,
+				   ARRAY_SIZE(n1_init_120hz_osc));
+		if (ret)
+			return ret;
+	}
+	ret = n1_send_cmds(ctx, n1_init_brightness, ARRAY_SIZE(n1_init_brightness));
+	if (ret)
+		return ret;
+	if (high_refresh)
+		ret = n1_send_cmds(ctx, n1_init_120hz, ARRAY_SIZE(n1_init_120hz));
+	else
+		ret = n1_send_cmds(ctx, n1_init_60hz, ARRAY_SIZE(n1_init_60hz));
+	if (ret)
+		return ret;
+	return n1_send_cmds(ctx, n1_init_exit_sleep, ARRAY_SIZE(n1_init_exit_sleep));
+}
+
+static void n1_power_off(struct n1_panel *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	regulator_disable(ctx->supplies[2].consumer);
+	msleep(3);
+	regulator_disable(ctx->supplies[1].consumer);
+	msleep(3);
+	regulator_disable(ctx->supplies[0].consumer);
+}
+
+static int n1_prepare(struct drm_panel *panel)
+{
+	struct n1_panel *ctx = to_n1(panel);
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	struct drm_dsc_picture_parameter_set pps;
+	int i, ret, mode;
+	u8 power = 0;
+
+	mode = n1_get_current_mode(ctx);
+	if (mode < 0)
+		return dev_err_probe(&dsi->dev, mode, "unsupported N1 mode\n");
+
+	for (i = 0; i < ARRAY_SIZE(ctx->supplies); i++) {
+		ret = regulator_enable(ctx->supplies[i].consumer);
+		if (ret) {
+			while (i--)
+				regulator_disable(ctx->supplies[i].consumer);
+			return ret;
+		}
+	}
+	msleep(8);
+	gpiod_set_value_cansleep(ctx->reset, 0);
+	usleep_range(1000, 1500);
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	usleep_range(1000, 1500);
+	gpiod_set_value_cansleep(ctx->reset, 0);
+	msleep(10);
+	dev_info(&dsi->dev, "N1 powered and reset; sending stock %d Hz commands\n",
+		 drm_mode_vrefresh(&n1_modes[mode]));
+	ret = n1_init(ctx, mode == 1);
+	if (ret)
+		goto fail;
 	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
 	drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
 	ret = mipi_dsi_picture_parameter_set(dsi, &pps);
@@ -252,31 +369,24 @@
 	return 0;
 }
 
