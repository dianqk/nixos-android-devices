From 80d218b82af161a2e2a4e0357b5ce019a56cad97 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Mon, 2 Nov 2026 00:11:25 +0800
Subject: [PATCH] media: i2c: add a Sony LYT-900 driver

Add a driver for the Sony LYT-900 50 MP sensor with one fixed mode:
4096x3072, the full 8192x6144 array binned 2x2, 30 fps over three C-PHY
trios at 3.4 Gsps from a 19.2 MHz EXCK.

The initialisation and mode tables are the vendor sequences of the
Xiaomi 14 Ultra wide module, with the CSI-2 data format changed from
RAW14 to RAW10. They flip the readout (0x0101 = 3): BGGR. Timing: IOP
19.2 MHz / 12 * 2125 = 3400 Msps per trio (link frequency 1.7 GHz);
line length 8832 and 9156 lines, 30 fps, pixel rate 2426.88 MHz.

The control, power sequencing and runtime PM code follows the IMX858
driver; analogue gain is 16384 / (16384 - code), up to 64x. The vendor
sequence also loads per-module calibration and switches modes for
in-sensor zoom; neither is done here. Autofocus, OIS and the aperture
are not handled.

Signed-off-by: dianqk <dianqk@dianqk.net>
---
 drivers/media/i2c/Kconfig  |   11 +
 drivers/media/i2c/Makefile |    1 +
 drivers/media/i2c/lyt900.c | 2599 ++++++++++++++++++++++++++++++++++++
 3 files changed, 2611 insertions(+)
 create mode 100644 drivers/media/i2c/lyt900.c

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 497eed4e03..a0cd1d865c 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -321,6 +321,17 @@ config VIDEO_IMX858
 	  To compile this driver as a module, choose M here: the
 	  module will be called imx858.
 
+config VIDEO_LYT900
+	tristate "Sony LYT-900 sensor support"
+	depends on OF && GPIOLIB
+	select V4L2_CCI_I2C
+	help
+	  This is a Video4Linux2 sensor driver for the Sony
+	  LYT-900 camera.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called lyt900.
+
 config VIDEO_MAX9271_LIB
 	tristate
 
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index efd2133be6..0feb34f412 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -71,6 +71,7 @@ obj-$(CONFIG_VIDEO_LM3560) += lm3560.o
 obj-$(CONFIG_VIDEO_LM3646) += lm3646.o
 obj-$(CONFIG_VIDEO_LT6911UXE) += lt6911uxe.o
 obj-$(CONFIG_VIDEO_M52790) += m52790.o
+obj-$(CONFIG_VIDEO_LYT900) += lyt900.o
 obj-$(CONFIG_VIDEO_MAX9271_LIB) += max9271.o
 obj-$(CONFIG_VIDEO_MAX9286) += max9286.o
 obj-$(CONFIG_VIDEO_MAX96714) += max96714.o
diff --git a/drivers/media/i2c/lyt900.c b/drivers/media/i2c/lyt900.c
new file mode 100644
index 0000000000..7f5020c13a
--- /dev/null
+++ b/drivers/media/i2c/lyt900.c
@@ -0,0 +1,2599 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Sony LYT-900 image sensor driver
+ *
+ * One fixed mode: 4096x3072 RAW10 (2x2 binned full array), 30 fps, three
+ * C-PHY trios at 3.4 Gsps from a 19.2 MHz EXCK. The register tables are
+ * the vendor sequences of a production camera module, with the output
+ * format changed from 14 to 10 bits.
+ */
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+#define LYT900_REG_MODE_SELECT		CCI_REG8(0x0100)
+#define LYT900_MODE_STANDBY		0x00
+#define LYT900_MODE_STREAMING		0x01
+#define LYT900_REG_GROUP_HOLD		CCI_REG8(0x0104)
+#define LYT900_REG_CHIP_ID		CCI_REG16(0x0016)
+#define LYT900_CHIP_ID			0xa18a
+#define LYT900_REG_EXPOSURE		CCI_REG16(0x0202)
+#define LYT900_REG_ANALOG_GAIN		CCI_REG16(0x0204)
+#define LYT900_REG_DIGITAL_GAIN		CCI_REG16(0x020e)
+#define LYT900_REG_FRAME_LENGTH		CCI_REG16(0x0340)
+#define LYT900_REG_TEST_PATTERN		CCI_REG16(0x0600)
+/* Long-exposure shifts of coarse integration time and frame length. */
+#define LYT900_REG_CIT_LSHIFT		CCI_REG8(0x3160)
+#define LYT900_REG_FLL_LSHIFT		CCI_REG8(0x3161)
+
+#define LYT900_EXCK_FREQ		(19200 * HZ_PER_KHZ)
+
+/* Keep the sensor powered across quick restarts. */
+#define LYT900_AUTOSUSPEND_MS		2000
+/*
+ * Minimum time between power-off and power-on. A Qualcomm CCI master that
+ * stays clocked while the sensor's I/O supply is cycled hangs on its next
+ * transfer; the CCI is reinitialised when it runtime-resumes, which it
+ * does after 1 s without traffic.
+ */
+#define LYT900_MIN_OFF_MS		1200
+
+/* Pixel array addressed by the mode's crop (0x0344-0x034b). */
+#define LYT900_NATIVE_WIDTH		8192
+#define LYT900_NATIVE_HEIGHT		6144
+
+#define LYT900_WIDTH			4096
+#define LYT900_HEIGHT			3072
+#define LYT900_FRAME_LENGTH_MAX		0xffff
+#define LYT900_EXPOSURE_MARGIN		48
+#define LYT900_EXPOSURE_MIN		8
+#define LYT900_EXPOSURE_DEFAULT		1000
+
+/* Analogue gain = 16384 / (16384 - code); 16128 is 64x. */
+#define LYT900_ANA_GAIN_MIN		0
+#define LYT900_ANA_GAIN_MAX		16128
+#define LYT900_ANA_GAIN_DEFAULT		0
+/* Digital gain is 8.8 fixed point. */
+#define LYT900_DGTL_GAIN_MIN		0x0100
+#define LYT900_DGTL_GAIN_MAX		0x0fff
+#define LYT900_DGTL_GAIN_DEFAULT	0x0100
+
+/* In power-up order; powered down in reverse. */
+static const char * const lyt900_supply_names[] = {
+	"avdd",		/* Analogue (2.8 V) */
+	"avdd2",	/* Second analogue (1.8 V) */
+	"dovdd",	/* Digital I/O (1.8 V) */
+	"dvdd",		/* Digital core (0.86 V) */
+};
+
+static const char * const lyt900_test_pattern_menu[] = {
+	"Disabled",
+	"Solid Colour",
+	"Colour Bars",
+	"Colour Bars Fade To Grey",
+	"PN9",
+};
+
