+ *  IOP: 19.2 MHz / 12 (0x030d) * 2125 (0x030e) = 3400 Msps per trio; the
+ *       link frequency is half the symbol rate.
+ *  Line length 8832 (0x0342) and 9156 lines (0x0340) at 30 fps give the
+ *  2426.88 MHz pixel rate (IVT 19.2 MHz * 79 / 10 = 151.68 MHz, 16 pixels
+ *  per clock). The tables flip the readout (0x0101 = 3): BGGR.
+ */
+static const struct lyt900_variant lyt900_wide = {
+	.bus_type = V4L2_MBUS_CSI2_CPHY,
+	.num_lanes = 3,
+	.link_freq = 1700000000,
+	.pixel_rate = 2426880000ULL,
+	.line_length = 8832,
+	.frame_length = 9156,
+	.code = MEDIA_BUS_FMT_SBGGR10_1X10,
+};
+
+struct lyt900 {
+	struct device *dev;
+	const struct lyt900_variant *variant;
+	struct regmap *regmap;
+	struct clk *xclk;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(lyt900_supply_names)];
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *vblank;
+
+	ktime_t power_off_time;
+};
+
+static inline struct lyt900 *to_lyt900(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct lyt900, sd);
+}
+
+static int lyt900_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct lyt900 *lyt900 = container_of(ctrl->handler, struct lyt900, ctrls);
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		/* Keep the exposure within the new frame length. */
+		u32 max = LYT900_HEIGHT + ctrl->val - LYT900_EXPOSURE_MARGIN;
+
+		ret = __v4l2_ctrl_modify_range(lyt900->exposure,
+					       lyt900->exposure->minimum, max,
+					       lyt900->exposure->step,
+					       min_t(u32, max,
+						     lyt900->exposure->default_value));
+		if (ret)
+			return ret;
+	}
+
+	/* Registers are written when streaming starts. */
+	if (pm_runtime_get_if_in_use(lyt900->dev) <= 0)
+		return 0;
+
+	cci_write(lyt900->regmap, LYT900_REG_GROUP_HOLD, 1, &ret);
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(lyt900->regmap, LYT900_REG_EXPOSURE, ctrl->val, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		cci_write(lyt900->regmap, LYT900_REG_ANALOG_GAIN, ctrl->val, &ret);
+		break;
+	case V4L2_CID_DIGITAL_GAIN:
+		cci_write(lyt900->regmap, LYT900_REG_DIGITAL_GAIN, ctrl->val, &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(lyt900->regmap, LYT900_REG_FRAME_LENGTH,
+			  LYT900_HEIGHT + ctrl->val, &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		cci_write(lyt900->regmap, LYT900_REG_TEST_PATTERN, ctrl->val, &ret);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+	cci_write(lyt900->regmap, LYT900_REG_GROUP_HOLD, 0, &ret);
+
+	pm_runtime_put_autosuspend(lyt900->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops lyt900_ctrl_ops = {
+	.s_ctrl = lyt900_set_ctrl,
+};
+
+static int lyt900_init_controls(struct lyt900 *lyt900)
+{
+	struct v4l2_ctrl_handler *hdl = &lyt900->ctrls;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *ctrl;
+	const struct lyt900_variant *v = lyt900->variant;
+	u32 hblank = v->line_length - LYT900_WIDTH;
+	u32 vblank = v->frame_length - LYT900_HEIGHT;
+	int ret;
+
+	ret = v4l2_fwnode_device_parse(lyt900->dev, &props);
+	if (ret)
+		return ret;
+
+	v4l2_ctrl_handler_init(hdl, 10);
+
+	ctrl = v4l2_ctrl_new_int_menu(hdl, NULL, V4L2_CID_LINK_FREQ,
+				      0, 0, &v->link_freq);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(hdl, NULL, V4L2_CID_PIXEL_RATE, v->pixel_rate,
+			  v->pixel_rate, 1, v->pixel_rate);
+
+	ctrl = v4l2_ctrl_new_std(hdl, NULL, V4L2_CID_HBLANK, hblank, hblank, 1,
+				 hblank);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	lyt900->vblank = v4l2_ctrl_new_std(hdl, &lyt900_ctrl_ops,
+					   V4L2_CID_VBLANK, vblank,
+					   LYT900_FRAME_LENGTH_MAX - LYT900_HEIGHT,
+					   1, vblank);
+
+	lyt900->exposure = v4l2_ctrl_new_std(hdl, &lyt900_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     LYT900_EXPOSURE_MIN,
+					     v->frame_length -
+					     LYT900_EXPOSURE_MARGIN,
+					     1, LYT900_EXPOSURE_DEFAULT);
+
+	v4l2_ctrl_new_std(hdl, &lyt900_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  LYT900_ANA_GAIN_MIN, LYT900_ANA_GAIN_MAX, 1,
+			  LYT900_ANA_GAIN_DEFAULT);
+
+	v4l2_ctrl_new_std(hdl, &lyt900_ctrl_ops, V4L2_CID_DIGITAL_GAIN,
+			  LYT900_DGTL_GAIN_MIN, LYT900_DGTL_GAIN_MAX, 1,
+			  LYT900_DGTL_GAIN_DEFAULT);
+
+	v4l2_ctrl_new_std_menu_items(hdl, &lyt900_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(lyt900_test_pattern_menu) - 1,
+				     0, 0, lyt900_test_pattern_menu);
+
+	v4l2_ctrl_new_fwnode_properties(hdl, &lyt900_ctrl_ops, &props);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		v4l2_ctrl_handler_free(hdl);
+		return dev_err_probe(lyt900->dev, ret, "control init failed\n");
+	}
+
+	lyt900->sd.ctrl_handler = hdl;
+
+	return 0;
+}
+
+static int lyt900_identify(struct lyt900 *lyt900)
+{
+	u64 id;
+	int ret;
+
+	ret = cci_read(lyt900->regmap, LYT900_REG_CHIP_ID, &id, NULL);
+	/* The CCI resets itself after a timeout; one retry recovers it. */
+	if (ret == -ETIMEDOUT)
+		ret = cci_read(lyt900->regmap, LYT900_REG_CHIP_ID, &id, NULL);
+	if (ret)
+		return dev_err_probe(lyt900->dev, ret, "failed to read chip ID\n");
+	if (id != LYT900_CHIP_ID)
+		return dev_err_probe(lyt900->dev, -ENODEV,
+				     "chip ID %#06llx, expected %#06x\n",
+				     id, LYT900_CHIP_ID);
+
+	return 0;
+}
+
+static int lyt900_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct lyt900 *lyt900 = to_lyt900(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(lyt900->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = lyt900_identify(lyt900);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_multi_reg_write(lyt900->regmap, lyt900_init_regs,
+				  ARRAY_SIZE(lyt900_init_regs), NULL);
+	if (!ret)
+		ret = cci_multi_reg_write(lyt900->regmap,
+					  lyt900->variant->init_regs,
+					  lyt900->variant->num_init_regs, NULL);
+	if (ret) {
+		dev_err(lyt900->dev, "failed to write init registers: %d\n", ret);
+		goto err_rpm_put;
+	}
+
+	ret = cci_multi_reg_write(lyt900->regmap, lyt900_4096x3072_regs,
+				  ARRAY_SIZE(lyt900_4096x3072_regs), NULL);
+	if (!ret)
+		ret = cci_multi_reg_write(lyt900->regmap,
+					  lyt900->variant->mode_regs,
+					  lyt900->variant->num_mode_regs, NULL);
+	if (ret) {
+		dev_err(lyt900->dev, "failed to write mode registers: %d\n", ret);
+		goto err_rpm_put;
+	}
+
+	cci_write(lyt900->regmap, LYT900_REG_CIT_LSHIFT, 0, &ret);
+	cci_write(lyt900->regmap, LYT900_REG_FLL_LSHIFT, 0, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = __v4l2_ctrl_handler_setup(lyt900->sd.ctrl_handler);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_write(lyt900->regmap, LYT900_REG_MODE_SELECT,
+			LYT900_MODE_STREAMING, NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(lyt900->dev);
+	return ret;
+}
+
+static int lyt900_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct lyt900 *lyt900 = to_lyt900(sd);
+	int ret;
+
+	ret = cci_write(lyt900->regmap, LYT900_REG_MODE_SELECT,
+			LYT900_MODE_STANDBY, NULL);
+	if (ret)
+		dev_err(lyt900->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(lyt900->dev);
+
+	return ret;
+}
+
+static void lyt900_fill_format(struct lyt900 *lyt900,
+			       struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = LYT900_WIDTH;
+	fmt->height = LYT900_HEIGHT;
+	fmt->code = lyt900->variant->code;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int lyt900_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+
+	code->code = to_lyt900(sd)->variant->code;
+
+	return 0;
+}
+
+static int lyt900_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index || fse->code != to_lyt900(sd)->variant->code)
+		return -EINVAL;
+
+	fse->min_width = LYT900_WIDTH;
+	fse->max_width = LYT900_WIDTH;
+	fse->min_height = LYT900_HEIGHT;
+	fse->max_height = LYT900_HEIGHT;
+
+	return 0;
+}
+
+static int lyt900_set_format(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state,
+			     struct v4l2_subdev_format *fmt)
+{
+	lyt900_fill_format(to_lyt900(sd), &fmt->format);
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+
+	return 0;
+}
+
+static int lyt900_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		/* The mode reads the whole array and bins it 2x2. */
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = LYT900_NATIVE_WIDTH;
+		sel->r.height = LYT900_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int lyt900_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	lyt900_fill_format(to_lyt900(sd),
+			   v4l2_subdev_state_get_format(state, 0));
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops lyt900_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops lyt900_pad_ops = {
+	.enum_mbus_code = lyt900_enum_mbus_code,
+	.enum_frame_size = lyt900_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = lyt900_set_format,
+	.get_selection = lyt900_get_selection,
+	.enable_streams = lyt900_enable_streams,
+	.disable_streams = lyt900_disable_streams,
+};
+
+static const struct v4l2_subdev_ops lyt900_subdev_ops = {
+	.video = &lyt900_video_ops,
+	.pad = &lyt900_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops lyt900_internal_ops = {
+	.init_state = lyt900_init_state,
+};
+
+/*
+ * Power sequencing follows the vendor module: supplies in order, XCLR
+ * released 3 ms later, EXCK 1.5 ms after that, then 8 ms before the first
+ * register access; power-down reverses it with 2 ms steps.
+ */
+static int lyt900_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct lyt900 *lyt900 = to_lyt900(sd);
+	unsigned int i;
+	s64 off;
+	int ret;
+
+	off = ktime_ms_delta(ktime_get(), lyt900->power_off_time);
+	if (lyt900->power_off_time && off >= 0 && off < LYT900_MIN_OFF_MS)
+		msleep(LYT900_MIN_OFF_MS - off);
+
+	gpiod_set_value_cansleep(lyt900->reset_gpio, 1);
+
+	for (i = 0; i < ARRAY_SIZE(lyt900->supplies); i++) {
+		ret = regulator_enable(lyt900->supplies[i].consumer);
+		if (ret) {
+			dev_err(dev, "failed to enable %s: %d\n",
+				lyt900->supplies[i].supply, ret);
+			goto err_supplies;
+		}
+	}
+	usleep_range(3000, 3500);
+
+	gpiod_set_value_cansleep(lyt900->reset_gpio, 0);
+	usleep_range(1500, 2000);
+
+	ret = clk_prepare_enable(lyt900->xclk);
+	if (ret) {
+		dev_err(dev, "failed to enable clock: %d\n", ret);
+		goto err_reset;
+	}
+	usleep_range(8000, 9000);
+
+	return 0;
+
+err_reset:
+	gpiod_set_value_cansleep(lyt900->reset_gpio, 1);
+	usleep_range(2000, 2500);
+err_supplies:
+	while (i--)
+		regulator_disable(lyt900->supplies[i].consumer);
+	lyt900->power_off_time = ktime_get();
+	return ret;
+}
+
+static int lyt900_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct lyt900 *lyt900 = to_lyt900(sd);
+	unsigned int i;
+
+	clk_disable_unprepare(lyt900->xclk);
+	usleep_range(2000, 2500);
+
+	gpiod_set_value_cansleep(lyt900->reset_gpio, 1);
+	usleep_range(2000, 2500);
+
+	for (i = ARRAY_SIZE(lyt900->supplies); i--;)
+		regulator_disable(lyt900->supplies[i].consumer);
+	lyt900->power_off_time = ktime_get();
+
+	return 0;
+}
+
+static int lyt900_parse_endpoint(struct lyt900 *lyt900)
+{
+	const struct lyt900_variant *v = lyt900->variant;
+	struct v4l2_fwnode_endpoint ep = { .bus_type = v->bus_type };
+	struct fwnode_handle *endpoint;
+	unsigned long link_freq_bitmap;
+	int ret;
+
+	endpoint = fwnode_graph_get_endpoint_by_id(dev_fwnode(lyt900->dev), 0, 0,
+						   FWNODE_GRAPH_ENDPOINT_NEXT);
+	if (!endpoint)
+		return dev_err_probe(lyt900->dev, -EINVAL, "missing endpoint\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return dev_err_probe(lyt900->dev, ret, "failed to parse endpoint\n");
+
+	if (ep.bus.mipi_csi2.num_data_lanes != v->num_lanes) {
+		ret = dev_err_probe(lyt900->dev, -EINVAL,
+				    "%u data lanes unsupported, need %u\n",
+				    ep.bus.mipi_csi2.num_data_lanes,
+				    v->num_lanes);
+		goto out;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(lyt900->dev, ep.link_frequencies,
+				       ep.nr_of_link_frequencies,
+				       &v->link_freq, 1,
+				       &link_freq_bitmap);
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+	return ret;
+}
+
+static int lyt900_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct lyt900 *lyt900;
+	unsigned long rate;
+	unsigned int i;
+	int ret;
+
+	lyt900 = devm_kzalloc(dev, sizeof(*lyt900), GFP_KERNEL);
+	if (!lyt900)
+		return -ENOMEM;
+
+	lyt900->dev = dev;
+	lyt900->variant = device_get_match_data(dev);
+	v4l2_i2c_subdev_init(&lyt900->sd, client, &lyt900_subdev_ops);
+
+	ret = lyt900_parse_endpoint(lyt900);
+	if (ret)
+		return ret;
+
+	lyt900->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(lyt900->regmap))
+		return dev_err_probe(dev, PTR_ERR(lyt900->regmap),
+				     "failed to init CCI\n");
+
+	lyt900->xclk = devm_clk_get(dev, NULL);
+	if (IS_ERR(lyt900->xclk))
+		return dev_err_probe(dev, PTR_ERR(lyt900->xclk),
+				     "failed to get clock\n");
+
+	rate = clk_get_rate(lyt900->xclk);
+	if (rate != LYT900_EXCK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "clock %lu Hz unsupported, need %lu Hz\n",
+				     rate, LYT900_EXCK_FREQ);
+
+	lyt900->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(lyt900->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(lyt900->reset_gpio),
+				     "failed to get reset GPIO\n");
+
+	for (i = 0; i < ARRAY_SIZE(lyt900_supply_names); i++)
+		lyt900->supplies[i].supply = lyt900_supply_names[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(lyt900->supplies),
+				      lyt900->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	ret = lyt900_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = lyt900_identify(lyt900);
+	if (ret)
+		goto err_power_off;
+
+	ret = lyt900_init_controls(lyt900);
+	if (ret)
+		goto err_power_off;
+
+	lyt900->sd.internal_ops = &lyt900_internal_ops;
+	lyt900->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	lyt900->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	lyt900->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&lyt900->sd.entity, 1, &lyt900->pad);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init entity pads\n");
+		goto err_free_ctrls;
+	}
+
+	lyt900->sd.state_lock = lyt900->ctrls.lock;
+	ret = v4l2_subdev_init_finalize(&lyt900->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init subdev\n");
+		goto err_entity;
+	}
+
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, LYT900_AUTOSUSPEND_MS);
+	pm_runtime_use_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&lyt900->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to register subdev\n");
+		goto err_pm;
+	}
+
+	pm_runtime_put_autosuspend(dev);
+
+	return 0;
+
+err_pm:
+	pm_runtime_dont_use_autosuspend(dev);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+	pm_runtime_put_noidle(dev);
+	v4l2_subdev_cleanup(&lyt900->sd);
+err_entity:
+	media_entity_cleanup(&lyt900->sd.entity);
+err_free_ctrls:
+	v4l2_ctrl_handler_free(&lyt900->ctrls);
+err_power_off:
+	lyt900_power_off(dev);
+	return ret;
+}
+
+static void lyt900_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct lyt900 *lyt900 = to_lyt900(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&lyt900->ctrls);
+
+	pm_runtime_dont_use_autosuspend(lyt900->dev);
+	pm_runtime_disable(lyt900->dev);
+	if (!pm_runtime_status_suspended(lyt900->dev))
+		lyt900_power_off(lyt900->dev);
+	pm_runtime_set_suspended(lyt900->dev);
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(lyt900_pm_ops, lyt900_power_off,
+				 lyt900_power_on, NULL);
+
+static const struct of_device_id lyt900_of_match[] = {
+	{ .compatible = "sony,lyt900", .data = &lyt900_wide },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, lyt900_of_match);
+
+static struct i2c_driver lyt900_driver = {
+	.driver = {
+		.name = "lyt900",
+		.of_match_table = lyt900_of_match,
+		.pm = pm_ptr(&lyt900_pm_ops),
+	},
+	.probe = lyt900_probe,
+	.remove = lyt900_remove,
+};
+module_i2c_driver(lyt900_driver);
