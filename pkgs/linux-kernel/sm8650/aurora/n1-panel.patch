From a19e3321b79dff7d1dea0bc81fdff4e05e7faeeb Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Tue, 6 Oct 2026 11:52:45 +0800
Subject: [PATCH] drm/panel: add Xiaomi N1 command-mode DSC panel

Drive the Xiaomi 14 Ultra N1 42-02-0a panel with its stock 60 Hz command
sequence, ordered supplies and reset timing. Use four DSI lanes, 10 bpc
RGB and DSC 1.2 at 8 bpp, with two 720x20 slices. Initial brightness is
307/4095; higher refresh rates and HBM are not exposed.

Lifecycle/PPS reference:
https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git/tree/drivers/gpu/drm/panel/panel-novatek-nt37801.c?h=v7.3-rc5

The N1 DDIC identity is not established by this implementation. Command
bytes are board initialization data, not a per-unit calibration readback.

---
 drivers/gpu/drm/panel/Kconfig           |   9 +
 drivers/gpu/drm/panel/Makefile          |   1 +
 drivers/gpu/drm/panel/panel-xiaomi-n1.c | 357 ++++++++++++++++++++++++
 3 files changed, 367 insertions(+)
 create mode 100644 drivers/gpu/drm/panel/panel-xiaomi-n1.c

diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index cbdf7b8f7..4fdb1db0f 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -1416,3 +1416,12 @@ config DRM_PANEL_XINPENG_XPP055C272
 	  XPP055C272 controller for 720x1280 LCD panels with MIPI/RGB/SPI
 	  system interfaces.
 endmenu
+
+config DRM_PANEL_XIAOMI_N1
+	tristate "Xiaomi N1 42-02-0a AMOLED DSI panel"
+	depends on OF && DRM_MIPI_DSI && BACKLIGHT_CLASS_DEVICE
+	select DRM_DISPLAY_DSC_HELPER
+	select DRM_DISPLAY_HELPER
+	help
+	  Support the CSOT N1 panel on Xiaomi 14 Ultra (aurora), using
+	  1440x3200 at 60 Hz, command mode and DSC compression.
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
index 3b523cf37..c87310fd4 100644
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -137,3 +137,4 @@ obj-$(CONFIG_DRM_PANEL_VISIONOX_VTDR6130) += panel-visionox-vtdr6130.o
 obj-$(CONFIG_DRM_PANEL_VISIONOX_R66451) += panel-visionox-r66451.o
 obj-$(CONFIG_DRM_PANEL_WIDECHIPS_WS2401) += panel-widechips-ws2401.o
 obj-$(CONFIG_DRM_PANEL_XINPENG_XPP055C272) += panel-xinpeng-xpp055c272.o
+obj-$(CONFIG_DRM_PANEL_XIAOMI_N1) += panel-xiaomi-n1.o
