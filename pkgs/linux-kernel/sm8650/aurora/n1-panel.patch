+
+static struct n1_panel *to_n1(struct drm_panel *panel)
+{
+	return container_of(panel, struct n1_panel, panel);
+}
+
+static void n1_power_off(struct n1_panel *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	regulator_disable(ctx->supplies[2].consumer);
+	msleep(3);
+	regulator_disable(ctx->supplies[1].consumer);
+	msleep(3);
+	regulator_disable(ctx->supplies[0].consumer);
+}
+
+static int n1_prepare(struct drm_panel *panel)
+{
+	struct n1_panel *ctx = to_n1(panel);
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	struct drm_dsc_picture_parameter_set pps;
+	int i, ret;
+	u8 power = 0;
+
+	for (i = 0; i < ARRAY_SIZE(ctx->supplies); i++) {
+		ret = regulator_enable(ctx->supplies[i].consumer);
+		if (ret) {
+			while (i--)
+				regulator_disable(ctx->supplies[i].consumer);
+			return ret;
+		}
+	}
+	msleep(8);
+	gpiod_set_value_cansleep(ctx->reset, 0);
+	usleep_range(1000, 1500);
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	usleep_range(1000, 1500);
+	gpiod_set_value_cansleep(ctx->reset, 0);
+	msleep(10);
+	dev_info(&dsi->dev, "N1 powered and reset; sending stock 60 Hz commands\n");
+
+	/* Keep downstream packet types, byte order and delays, including the
+	 * short payloads deliberately sent as long packets. Vendor batching
+	 * flags are not part of the wire protocol and are not transferred.
+	 */
+	for (i = 0; i < ARRAY_SIZE(n1_on_cmds); i++) {
+		const struct n1_cmd *c = &n1_on_cmds[i];
+		struct mipi_dsi_msg msg = {
+			.channel = dsi->channel,
+			.type = c->type,
+			.flags = MIPI_DSI_MSG_USE_LPM,
+			.tx_len = c->len,
+			.tx_buf = c->data,
+		};
+		ret = dsi->host->ops->transfer(dsi->host, &msg);
+		if (ret < 0) {
+			dev_err(&dsi->dev, "N1 command %d (0x%02x) failed: %d\n",
+				i, c->data[0], ret);
+			goto fail;
+		}
+		if (c->delay_ms)
+			msleep(c->delay_ms);
+	}
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
+	ret = mipi_dsi_picture_parameter_set(dsi, &pps);
+	if (ret < 0)
+		goto fail;
+	ret = mipi_dsi_compression_mode(dsi, true);
+	if (ret < 0)
+		goto fail;
+	msleep(28);
+	ctx->prepared = true;
+	ret = mipi_dsi_dcs_get_power_mode(dsi, &power);
+	dev_info(&dsi->dev, "N1 prepared; power-mode=0x%02x read=%d\n", power, ret);
+	return 0;
+fail:
+	n1_power_off(ctx);
+	return ret;
+}
+
+static int n1_unprepare(struct drm_panel *panel)
+{
+	struct n1_panel *ctx = to_n1(panel);
+
+	ctx->prepared = false;
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	mipi_dsi_dcs_set_display_off(ctx->dsi);
+	msleep(20);
+	mipi_dsi_dcs_enter_sleep_mode(ctx->dsi);
+	msleep(120);
+	n1_power_off(ctx);
+	return 0;
+}
+
+static const struct drm_display_mode n1_mode = {
+	.clock = 295853,
+	.hdisplay = 1440, .hsync_start = 1472, .hsync_end = 1488, .htotal = 1520,
+	.vdisplay = 3200, .vsync_start = 3216, .vsync_end = 3220, .vtotal = 3244,
+	.width_mm = 70, .height_mm = 156,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+static int n1_get_modes(struct drm_panel *panel, struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &n1_mode);
+}
+
+static const struct drm_panel_funcs n1_funcs = {
+	.prepare = n1_prepare, .unprepare = n1_unprepare, .get_modes = n1_get_modes,
+};
+
+static int n1_bl_update(struct backlight_device *bl)
+{
+	struct n1_panel *ctx = bl_get_data(bl);
+	unsigned long saved;
+	int ret;
+
+	if (!ctx->prepared)
+		return 0;
+	saved = ctx->dsi->mode_flags;
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_dcs_set_display_brightness_large(ctx->dsi,
+						     backlight_get_brightness(bl));
+	ctx->dsi->mode_flags = saved;
+	return ret;
+}
+
+static const struct backlight_ops n1_bl_ops = { .update_status = n1_bl_update };
+
+static int n1_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct n1_panel *ctx;
+	struct backlight_properties props = {
+		.type = BACKLIGHT_RAW, .brightness = 307, .max_brightness = 4095,
+	};
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct n1_panel, panel, &n1_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+	ctx->dsi = dsi;
+	ctx->supplies[0].supply = "vddio";
+	ctx->supplies[1].supply = "vddd";
+	ctx->supplies[2].supply = "vci";
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "N1 regulators unavailable\n");
+	ctx->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset), "N1 reset unavailable\n");
+	ctx->panel.prepare_prev_first = true;
+	ctx->panel.backlight = devm_backlight_device_register(dev, "n1-panel", dev,
+							     ctx, &n1_bl_ops, &props);
+	if (IS_ERR(ctx->panel.backlight))
+		return PTR_ERR(ctx->panel.backlight);
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB101010;
+	dsi->mode_flags = MIPI_DSI_CLOCK_NON_CONTINUOUS;
+	ctx->dsc = (struct drm_dsc_config) {
+		.dsc_version_major = 1, .dsc_version_minor = 2,
+		.slice_height = 20, .slice_width = 720, .slice_count = 2,
+		.bits_per_component = 10, .bits_per_pixel = 8 << 4,
+		.block_pred_enable = true,
+	};
+	dsi->dsc = &ctx->dsc;
+	mipi_dsi_set_drvdata(dsi, ctx);
+	drm_panel_add(&ctx->panel);
+	ret = mipi_dsi_attach(dsi);
+	if (ret) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "N1 DSI attach failed\n");
+	}
+	dev_info(dev, "N1 42-02-0a driver attached; 1440x3200 60 Hz RGB10 DSC\n");
+	return 0;
+}
+
+static void n1_remove(struct mipi_dsi_device *dsi)
+{
+	struct n1_panel *ctx = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id n1_match[] = {
+	{ .compatible = "xiaomi,n1-42-02-0a" }, { }
+};
+MODULE_DEVICE_TABLE(of, n1_match);
+static struct mipi_dsi_driver n1_driver = {
+	.probe = n1_probe, .remove = n1_remove,
+	.driver = { .name = "panel-xiaomi-n1", .of_match_table = n1_match },
+};
+module_mipi_dsi_driver(n1_driver);
+MODULE_DESCRIPTION("Xiaomi N1 42-02-0a AMOLED panel");
+MODULE_LICENSE("GPL");
