From 0904072bc161859c487e6491e8711e51d9649540 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Tue, 6 Oct 2026 12:07:17 +0800
Subject: [PATCH] iommu/arm-smmu: preserve SM8650 display boot mappings

SM8650 MDSS can still fetch the firmware splash buffer while the IOMMU
and display drivers probe. Add it to the existing display clients that
start with an identity domain, until DRM installs its own mappings.
This follows the established SM8450 display handoff path and does not
change the default domain for USB, UFS or other devices.

---
 drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c b/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c
index 795e8ec7e..40c35e5d7 100644
--- a/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c
+++ b/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c
@@ -426,6 +426,7 @@ static const struct of_device_id qcom_smmu_client_of_match[] __maybe_unused = {
 	{ .compatible = "qcom,sm8150-mdss" },
 	{ .compatible = "qcom,sm8250-mdss" },
 	{ .compatible = "qcom,sm8450-mdss" },
+	{ .compatible = "qcom,sm8650-mdss" },
 	{ .compatible = "qcom,x1e80100-mdss" },
 	{ }
 };
-- 
2.55.0

