From af244549570ac97bb4c7f932a09838e2c83b27f0 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Tue, 6 Oct 2026 20:58:12 +0800
Subject: [PATCH] arm64: dts: qcom: enable Aurora physical keys

Match the stock Aurora DT: PM8550 GPIO6 active-low volume up with a 32 ms debounce and 1.8 V pull-up; PMK8550 PON power and RESIN volume down. Use the upstream PMK8550 interrupt definitions.
---
 .../boot/dts/qcom/sm8650-xiaomi-aurora.dts    | 39 +++++++++++++++++++
 1 file changed, 39 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8650-xiaomi-aurora.dts b/arch/arm64/boot/dts/qcom/sm8650-xiaomi-aurora.dts
index 5096b8925..8e11e3a1c 100644
--- a/arch/arm64/boot/dts/qcom/sm8650-xiaomi-aurora.dts
+++ b/arch/arm64/boot/dts/qcom/sm8650-xiaomi-aurora.dts
@@ -6,6 +6,7 @@
 /dts-v1/;
 #include <dt-bindings/regulator/qcom,rpmh-regulator.h>
 #include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
 #include "sm8650.dtsi"
 #include "pm8550.dtsi"
 #include "pm8550b.dtsi"
@@ -236,3 +237,41 @@ &mdss_dsi0_phy {
 	vdds-supply = <&vreg_l1i>;
 	status = "okay";
 };
+
+/* Physical keys follow the Aurora PMIC wiring. */
+/ {
+	gpio-keys {
+		compatible = "gpio-keys";
+		pinctrl-0 = <&volume_up_n>;
+		pinctrl-names = "default";
+
+		key-volume-up {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&pm8550_gpios 6 GPIO_ACTIVE_LOW>;
+			debounce-interval = <32>;
+			linux,can-disable;
+			wakeup-source;
+		};
+	};
+};
+
+&pm8550_gpios {
+	volume_up_n: volume-up-n-state {
+		pins = "gpio6";
+		function = "normal";
+		bias-pull-up;
+		input-enable;
+		power-source = <1>;
+	};
+};
+
+&pon_pwrkey {
+	linux,code = <KEY_POWER>;
+	status = "okay";
+};
+
+&pon_resin {
+	linux,code = <KEY_VOLUMEDOWN>;
+	status = "okay";
+};
-- 
2.55.0

