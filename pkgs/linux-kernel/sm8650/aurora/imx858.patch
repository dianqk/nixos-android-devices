+#define IMX858_EXPOSURE_MARGIN		48
+#define IMX858_EXPOSURE_MIN		8
+#define IMX858_EXPOSURE_DEFAULT		1000
+
+/* Analogue gain = 1024 / (1024 - code); 992 is 32x. */
