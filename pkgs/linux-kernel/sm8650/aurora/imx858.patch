+struct imx858_variant {
+	const struct cci_reg_sequence *init_regs;
+	unsigned int num_init_regs;
+	const struct cci_reg_sequence *mode_regs;
+	unsigned int num_mode_regs;
+	enum v4l2_mbus_type bus_type;
+	unsigned int num_lanes;
+	s64 link_freq;
+	u64 pixel_rate;
+	u32 line_length;
+	u32 frame_length;
+	u32 code;
+};
+
+/*
+ * D-PHY modules. PLL (EXCK 19.2 MHz):
+ *  IVT: 19.2 MHz / 3 (0x0305) * 343 (0x0306) = 2195.2 MHz,
+ *       / 5 (0x0301) = 439.04 MHz IVTPXCK, two pixels per clock.
+ *  IOP: 19.2 MHz / 5 (0x030d) * 651 (0x030e) = 2499.84 Mbps per lane,
+ *       / 1 (0x030b); D-PHY DDR clock 1249.92 MHz.
+ * Line length 7908 (0x0342), 3699 lines (0x0340): 30 fps. The tables flip
+ * the readout (0x0101 = 3), turning the RGGB array into BGGR.
+ */
+static const struct imx858_variant imx858_ultra = {
+	.bus_type = V4L2_MBUS_CSI2_DPHY,
+	.num_lanes = 4,
+	.link_freq = 1249920000,
+	.pixel_rate = 878080000,
+	.line_length = 7908,
+	.frame_length = 3699,
+	.code = MEDIA_BUS_FMT_SBGGR10_1X10,
+};
+
+/*
+ * Tele 5x module, three C-PHY trios: IOP 19.2 MHz / 15 * 1953 = 2499.84
+ * Msps per trio (link frequency is half the symbol rate); line length 7500
+ * and 3902 lines at 878.08 MHz: 30.00 fps. Its tables flip vertically only
+ * (0x0101 = 2): GBRG.
+ */
+static const struct imx858_variant imx858_tele5x = {
+	.init_regs = imx858_tele5x_init_regs,
+	.num_init_regs = ARRAY_SIZE(imx858_tele5x_init_regs),
+	.mode_regs = imx858_tele5x_mode_regs,
+	.num_mode_regs = ARRAY_SIZE(imx858_tele5x_mode_regs),
+	.bus_type = V4L2_MBUS_CSI2_CPHY,
+	.num_lanes = 3,
+	.link_freq = 1249920000,
+	.pixel_rate = 878080000,
+	.line_length = 7500,
+	.frame_length = 3902,
+	.code = MEDIA_BUS_FMT_SGBRG10_1X10,
+};
+
+static const struct imx858_variant imx858_tele3x = {
+	.mode_regs = imx858_tele3x_mode_regs,
+	.num_mode_regs = ARRAY_SIZE(imx858_tele3x_mode_regs),
+	.bus_type = V4L2_MBUS_CSI2_DPHY,
+	.num_lanes = 4,
+	.link_freq = 1249920000,
+	.pixel_rate = 878080000,
+	.line_length = 7908,
+	.frame_length = 3699,
+	.code = MEDIA_BUS_FMT_SBGGR10_1X10,
+};
+
+struct imx858 {
+	struct device *dev;
+	const struct imx858_variant *variant;
+	struct regmap *regmap;
+	struct clk *xclk;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(imx858_supply_names)];
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *vblank;
+
+	ktime_t power_off_time;
+};
+
+static inline struct imx858 *to_imx858(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct imx858, sd);
+}
+
+static int imx858_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct imx858 *imx858 = container_of(ctrl->handler, struct imx858, ctrls);
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		/* Keep the exposure within the new frame length. */
+		u32 max = IMX858_HEIGHT + ctrl->val - IMX858_EXPOSURE_MARGIN;
+
+		ret = __v4l2_ctrl_modify_range(imx858->exposure,
+					       imx858->exposure->minimum, max,
+					       imx858->exposure->step,
+					       min_t(u32, max,
+						     imx858->exposure->default_value));
+		if (ret)
+			return ret;
+	}
+
+	/* Registers are written when streaming starts. */
+	if (pm_runtime_get_if_in_use(imx858->dev) <= 0)
+		return 0;
+
+	cci_write(imx858->regmap, IMX858_REG_GROUP_HOLD, 1, &ret);
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(imx858->regmap, IMX858_REG_EXPOSURE, ctrl->val, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		cci_write(imx858->regmap, IMX858_REG_ANALOG_GAIN, ctrl->val, &ret);
+		break;
+	case V4L2_CID_DIGITAL_GAIN:
+		cci_write(imx858->regmap, IMX858_REG_DIGITAL_GAIN, ctrl->val, &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(imx858->regmap, IMX858_REG_FRAME_LENGTH,
+			  IMX858_HEIGHT + ctrl->val, &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		cci_write(imx858->regmap, IMX858_REG_TEST_PATTERN, ctrl->val, &ret);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+	cci_write(imx858->regmap, IMX858_REG_GROUP_HOLD, 0, &ret);
+
+	pm_runtime_put_autosuspend(imx858->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops imx858_ctrl_ops = {
+	.s_ctrl = imx858_set_ctrl,
+};
+
+static int imx858_init_controls(struct imx858 *imx858)
+{
+	struct v4l2_ctrl_handler *hdl = &imx858->ctrls;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *ctrl;
+	const struct imx858_variant *v = imx858->variant;
+	u32 hblank = v->line_length - IMX858_WIDTH;
+	u32 vblank = v->frame_length - IMX858_HEIGHT;
+	int ret;
+
+	ret = v4l2_fwnode_device_parse(imx858->dev, &props);
+	if (ret)
+		return ret;
+
+	v4l2_ctrl_handler_init(hdl, 10);
+
+	ctrl = v4l2_ctrl_new_int_menu(hdl, NULL, V4L2_CID_LINK_FREQ,
+				      0, 0, &v->link_freq);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(hdl, NULL, V4L2_CID_PIXEL_RATE, v->pixel_rate,
+			  v->pixel_rate, 1, v->pixel_rate);
+
+	ctrl = v4l2_ctrl_new_std(hdl, NULL, V4L2_CID_HBLANK, hblank, hblank, 1,
+				 hblank);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	imx858->vblank = v4l2_ctrl_new_std(hdl, &imx858_ctrl_ops,
+					   V4L2_CID_VBLANK, vblank,
+					   IMX858_FRAME_LENGTH_MAX - IMX858_HEIGHT,
+					   1, vblank);
+
+	imx858->exposure = v4l2_ctrl_new_std(hdl, &imx858_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     IMX858_EXPOSURE_MIN,
+					     v->frame_length -
+					     IMX858_EXPOSURE_MARGIN,
+					     1, IMX858_EXPOSURE_DEFAULT);
+
+	v4l2_ctrl_new_std(hdl, &imx858_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  IMX858_ANA_GAIN_MIN, IMX858_ANA_GAIN_MAX, 1,
+			  IMX858_ANA_GAIN_DEFAULT);
+
+	v4l2_ctrl_new_std(hdl, &imx858_ctrl_ops, V4L2_CID_DIGITAL_GAIN,
+			  IMX858_DGTL_GAIN_MIN, IMX858_DGTL_GAIN_MAX, 1,
+			  IMX858_DGTL_GAIN_DEFAULT);
+
+	v4l2_ctrl_new_std_menu_items(hdl, &imx858_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(imx858_test_pattern_menu) - 1,
+				     0, 0, imx858_test_pattern_menu);
+
+	v4l2_ctrl_new_fwnode_properties(hdl, &imx858_ctrl_ops, &props);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		v4l2_ctrl_handler_free(hdl);
+		return dev_err_probe(imx858->dev, ret, "control init failed\n");
+	}
+
+	imx858->sd.ctrl_handler = hdl;
+
+	return 0;
+}
+
+static int imx858_identify(struct imx858 *imx858)
+{
+	u64 id;
+	int ret;
+
+	ret = cci_read(imx858->regmap, IMX858_REG_CHIP_ID, &id, NULL);
+	/* The CCI resets itself after a timeout; one retry recovers it. */
+	if (ret == -ETIMEDOUT)
+		ret = cci_read(imx858->regmap, IMX858_REG_CHIP_ID, &id, NULL);
+	if (ret)
+		return dev_err_probe(imx858->dev, ret, "failed to read chip ID\n");
+	if (id != IMX858_CHIP_ID)
+		return dev_err_probe(imx858->dev, -ENODEV,
+				     "chip ID %#06llx, expected %#06x\n",
+				     id, IMX858_CHIP_ID);
+
+	return 0;
+}
+
+static int imx858_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct imx858 *imx858 = to_imx858(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(imx858->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = imx858_identify(imx858);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_multi_reg_write(imx858->regmap, imx858_init_regs,
+				  ARRAY_SIZE(imx858_init_regs), NULL);
+	if (!ret)
+		ret = cci_multi_reg_write(imx858->regmap,
+					  imx858->variant->init_regs,
+					  imx858->variant->num_init_regs, NULL);
+	if (ret) {
+		dev_err(imx858->dev, "failed to write init registers: %d\n", ret);
+		goto err_rpm_put;
+	}
+
+	ret = cci_multi_reg_write(imx858->regmap, imx858_4096x3072_regs,
+				  ARRAY_SIZE(imx858_4096x3072_regs), NULL);
+	if (!ret)
+		ret = cci_multi_reg_write(imx858->regmap,
+					  imx858->variant->mode_regs,
+					  imx858->variant->num_mode_regs, NULL);
+	if (ret) {
+		dev_err(imx858->dev, "failed to write mode registers: %d\n", ret);
+		goto err_rpm_put;
+	}
+
+	cci_write(imx858->regmap, IMX858_REG_CIT_LSHIFT, 0, &ret);
+	cci_write(imx858->regmap, IMX858_REG_FLL_LSHIFT, 0, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = __v4l2_ctrl_handler_setup(imx858->sd.ctrl_handler);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_write(imx858->regmap, IMX858_REG_MODE_SELECT,
+			IMX858_MODE_STREAMING, NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(imx858->dev);
+	return ret;
+}
+
+static int imx858_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct imx858 *imx858 = to_imx858(sd);
+	int ret;
+
+	ret = cci_write(imx858->regmap, IMX858_REG_MODE_SELECT,
+			IMX858_MODE_STANDBY, NULL);
+	if (ret)
+		dev_err(imx858->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(imx858->dev);
+
+	return ret;
+}
+
+static void imx858_fill_format(struct imx858 *imx858,
+			       struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = IMX858_WIDTH;
+	fmt->height = IMX858_HEIGHT;
+	fmt->code = imx858->variant->code;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int imx858_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+
+	code->code = to_imx858(sd)->variant->code;
+
+	return 0;
+}
+
+static int imx858_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index || fse->code != to_imx858(sd)->variant->code)
+		return -EINVAL;
+
+	fse->min_width = IMX858_WIDTH;
+	fse->max_width = IMX858_WIDTH;
+	fse->min_height = IMX858_HEIGHT;
+	fse->max_height = IMX858_HEIGHT;
+
+	return 0;
+}
+
+static int imx858_set_format(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state,
+			     struct v4l2_subdev_format *fmt)
+{
+	imx858_fill_format(to_imx858(sd), &fmt->format);
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+
+	return 0;
+}
+
+static int imx858_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		/* The mode reads the whole array and bins it 2x2. */
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = IMX858_NATIVE_WIDTH;
+		sel->r.height = IMX858_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int imx858_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	imx858_fill_format(to_imx858(sd),
+			   v4l2_subdev_state_get_format(state, 0));
+
+	return 0;
+}
