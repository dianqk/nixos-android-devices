From cf36a2e42651056a767b5fed588bd71d6a58f6ee Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Sun, 1 Nov 2026 20:32:11 +0800
Subject: [PATCH] media: i2c: add a Sony IMX858 driver

Add a driver for the Sony IMX858 50 MP sensor with one fixed mode:
4096x3072 RAW10, the full 8192x6144 array binned 2x2, 30 fps over four
D-PHY lanes at 2499.84 Mbps from a 19.2 MHz EXCK.

The initialisation and mode tables are the vendor sequences of the
Xiaomi 14 Ultra ultra-wide module. They select a horizontally and
vertically flipped readout (0x0101 = 3); the media bus code assumes the
usual Sony RGGB array order, which that readout turns into BGGR.
The tele 3.2x module (compatible "xiaomi,aurora-imx858-tele3x") uses
the same tables with four registers (0x38a0/1, 0x3b00/1) changed.
The tele 5x module ("xiaomi,aurora-imx858-tele5x") uses three C-PHY
trios at 2499.84 Msps (link frequency 1249.92 MHz), line length 7500
and 3902 lines, and a vertically flipped readout (GBRG).

Timing follows from the tables: IVTPXCK = 19.2 MHz / 3 * 343 / 5 =
439.04 MHz at two pixels per clock gives a pixel rate of 878.08 MHz;
with a line length of 7908 and 3699 lines this is 30.02 fps. IOP
19.2 MHz / 5 * 651 = 2499.84 Mbps per lane, link frequency 1249.92 MHz.

Controls: exposure (coarse integration, frame length - 48), analogue
gain (1024 / (1024 - code), up to 32x), digital gain (8.8), vertical
blanking (frame length up to 0xffff), read-only horizontal blanking,
pixel rate and link frequency, the SMIA test patterns and the fwnode
orientation and rotation. Control writes are wrapped in group hold.

Power sequencing follows the vendor module: AVDD, DOVDD and DVDD in
turn, XCLR released 3 ms later, EXCK 1.5 ms after that and 8 ms before
the first register access; power-down stops EXCK, asserts XCLR 2 ms
later and removes the supplies in reverse after another 2 ms. Runtime
PM autosuspends after 2 s, so quick restarts keep the sensor powered.

A Qualcomm CCI master that stays clocked while the sensor's I/O supply
is switched off and on hangs on its next transfer until the controller
is reset. The CCI reinitialises itself when it runtime-resumes, 1 s
after its last transfer, so keep the sensor off for at least 1.2 s and
retry the chip ID read once after a timeout (the CCI resets itself on
timeout) before loading the registers.

The vendor sequence also loads per-module calibration from the module
EEPROM (3072 bytes at 0xc000 and 384 bytes at 0xd200). This driver does
not load it yet, so its sensitivity and phase-detection pixel
corrections are absent. Autofocus is not handled.

Signed-off-by: dianqk <dianqk@dianqk.net>
---
 drivers/media/i2c/Kconfig  |   11 +
 drivers/media/i2c/Makefile |    1 +
 drivers/media/i2c/imx858.c | 1059 ++++++++++++++++++++++++++++++++++++
 3 files changed, 1071 insertions(+)
 create mode 100644 drivers/media/i2c/imx858.c

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 5c52007f9c..f84f31b79d 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -310,6 +310,17 @@ config VIDEO_IMX678
 	  To compile this driver as a module, choose M here: the
 	  module will be called imx678.
 
+config VIDEO_IMX858
+	tristate "Sony IMX858 sensor support"
+	depends on OF && GPIOLIB
+	select V4L2_CCI_I2C
+	help
+	  This is a Video4Linux2 sensor driver for the Sony
+	  IMX858 camera.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called imx858.
+
 config VIDEO_MAX9271_LIB
 	tristate
 
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index d04bd57245..c3d6ea882b 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -62,6 +62,7 @@ obj-$(CONFIG_VIDEO_IMX355) += imx355.o
 obj-$(CONFIG_VIDEO_IMX412) += imx412.o
 obj-$(CONFIG_VIDEO_IMX415) += imx415.o
 obj-$(CONFIG_VIDEO_IMX678) += imx678.o
+obj-$(CONFIG_VIDEO_IMX858) += imx858.o
 obj-$(CONFIG_VIDEO_IMX471) += imx471.o
 obj-$(CONFIG_VIDEO_IR_I2C) += ir-kbd-i2c.o
 obj-$(CONFIG_VIDEO_ISL7998X) += isl7998x.o
diff --git a/drivers/media/i2c/imx858.c b/drivers/media/i2c/imx858.c
new file mode 100644
index 0000000000..06f930da83
