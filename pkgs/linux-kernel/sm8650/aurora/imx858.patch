+#define IMX858_DGTL_GAIN_MAX		0x0fff
+#define IMX858_DGTL_GAIN_DEFAULT	0x0100
+
+/* In power-up order; powered down in reverse. */
+static const char * const imx858_supply_names[] = {
+	"avdd",		/* Analogue (2.8 V) */
+	"dovdd",	/* Digital I/O (1.8 V) */
+	"dvdd",		/* Digital core (1.1 V) */
+};
+
