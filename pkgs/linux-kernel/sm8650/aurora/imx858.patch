+#define IMX858_REG_FLL_LSHIFT		CCI_REG8(0x3161)
+
+#define IMX858_EXCK_FREQ		(19200 * HZ_PER_KHZ)
+
+/* Keep the sensor powered across quick restarts. */
+#define IMX858_AUTOSUSPEND_MS		2000
