+/*
+ * Power sequencing follows the vendor module: supplies in order, XCLR
+ * released 3 ms later, EXCK 1.5 ms after that, then 8 ms before the first
+ * register access; power-down reverses it with 2 ms steps.
+ */
+static int imx858_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx858 *imx858 = to_imx858(sd);
+	unsigned int i;
+	s64 off;
+	int ret;
+
+	off = ktime_ms_delta(ktime_get(), imx858->power_off_time);
+	if (imx858->power_off_time && off >= 0 && off < IMX858_MIN_OFF_MS)
+		msleep(IMX858_MIN_OFF_MS - off);
+
+	gpiod_set_value_cansleep(imx858->reset_gpio, 1);
+
+	for (i = 0; i < ARRAY_SIZE(imx858->supplies); i++) {
+		ret = regulator_enable(imx858->supplies[i].consumer);
+		if (ret) {
+			dev_err(dev, "failed to enable %s: %d\n",
+				imx858->supplies[i].supply, ret);
+			goto err_supplies;
+		}
+	}
+	usleep_range(3000, 3500);
+
+	gpiod_set_value_cansleep(imx858->reset_gpio, 0);
+	usleep_range(1500, 2000);
+
+	ret = clk_prepare_enable(imx858->xclk);
+	if (ret) {
+		dev_err(dev, "failed to enable clock: %d\n", ret);
+		goto err_reset;
+	}
+	usleep_range(8000, 9000);
+
+	return 0;
+
+err_reset:
+	gpiod_set_value_cansleep(imx858->reset_gpio, 1);
+	usleep_range(2000, 2500);
+err_supplies:
+	while (i--)
+		regulator_disable(imx858->supplies[i].consumer);
+	imx858->power_off_time = ktime_get();
+	return ret;
+}
+
+static int imx858_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx858 *imx858 = to_imx858(sd);
+	unsigned int i;
+
+	clk_disable_unprepare(imx858->xclk);
+	usleep_range(2000, 2500);
+
+	gpiod_set_value_cansleep(imx858->reset_gpio, 1);
+	usleep_range(2000, 2500);
+
+	for (i = ARRAY_SIZE(imx858->supplies); i--;)
+		regulator_disable(imx858->supplies[i].consumer);
+	imx858->power_off_time = ktime_get();
+
+	return 0;
+}
+
+static int imx858_parse_endpoint(struct imx858 *imx858)
+{
+	const struct imx858_variant *v = imx858->variant;
+	struct v4l2_fwnode_endpoint ep = { .bus_type = v->bus_type };
+	struct fwnode_handle *endpoint;
+	unsigned long link_freq_bitmap;
+	int ret;
+
+	endpoint = fwnode_graph_get_endpoint_by_id(dev_fwnode(imx858->dev), 0, 0,
+						   FWNODE_GRAPH_ENDPOINT_NEXT);
+	if (!endpoint)
+		return dev_err_probe(imx858->dev, -EINVAL, "missing endpoint\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return dev_err_probe(imx858->dev, ret, "failed to parse endpoint\n");
+
+	if (ep.bus.mipi_csi2.num_data_lanes != v->num_lanes) {
+		ret = dev_err_probe(imx858->dev, -EINVAL,
+				    "%u data lanes unsupported, need %u\n",
+				    ep.bus.mipi_csi2.num_data_lanes,
+				    v->num_lanes);
+		goto out;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(imx858->dev, ep.link_frequencies,
+				       ep.nr_of_link_frequencies,
+				       &v->link_freq, 1,
+				       &link_freq_bitmap);
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+	return ret;
+}
+
+static int imx858_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct imx858 *imx858;
+	unsigned long rate;
+	unsigned int i;
+	int ret;
+
+	imx858 = devm_kzalloc(dev, sizeof(*imx858), GFP_KERNEL);
+	if (!imx858)
+		return -ENOMEM;
+
+	imx858->dev = dev;
+	imx858->variant = device_get_match_data(dev);
+	v4l2_i2c_subdev_init(&imx858->sd, client, &imx858_subdev_ops);
+
+	ret = imx858_parse_endpoint(imx858);
+	if (ret)
+		return ret;
+
+	imx858->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(imx858->regmap))
+		return dev_err_probe(dev, PTR_ERR(imx858->regmap),
+				     "failed to init CCI\n");
+
+	imx858->xclk = devm_clk_get(dev, NULL);
+	if (IS_ERR(imx858->xclk))
+		return dev_err_probe(dev, PTR_ERR(imx858->xclk),
+				     "failed to get clock\n");
+
+	rate = clk_get_rate(imx858->xclk);
+	if (rate != IMX858_EXCK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "clock %lu Hz unsupported, need %lu Hz\n",
+				     rate, IMX858_EXCK_FREQ);
+
+	imx858->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(imx858->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(imx858->reset_gpio),
+				     "failed to get reset GPIO\n");
+
+	for (i = 0; i < ARRAY_SIZE(imx858_supply_names); i++)
+		imx858->supplies[i].supply = imx858_supply_names[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(imx858->supplies),
+				      imx858->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	ret = imx858_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = imx858_identify(imx858);
+	if (ret)
+		goto err_power_off;
+
+	ret = imx858_init_controls(imx858);
+	if (ret)
+		goto err_power_off;
+
+	imx858->sd.internal_ops = &imx858_internal_ops;
+	imx858->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	imx858->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	imx858->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&imx858->sd.entity, 1, &imx858->pad);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init entity pads\n");
+		goto err_free_ctrls;
+	}
+
+	imx858->sd.state_lock = imx858->ctrls.lock;
+	ret = v4l2_subdev_init_finalize(&imx858->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init subdev\n");
+		goto err_entity;
+	}
+
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, IMX858_AUTOSUSPEND_MS);
+	pm_runtime_use_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&imx858->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to register subdev\n");
+		goto err_pm;
+	}
+
+	pm_runtime_put_autosuspend(dev);
+
+	return 0;
+
+err_pm:
+	pm_runtime_dont_use_autosuspend(dev);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+	pm_runtime_put_noidle(dev);
+	v4l2_subdev_cleanup(&imx858->sd);
+err_entity:
+	media_entity_cleanup(&imx858->sd.entity);
+err_free_ctrls:
+	v4l2_ctrl_handler_free(&imx858->ctrls);
+err_power_off:
+	imx858_power_off(dev);
+	return ret;
+}
+
+static void imx858_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx858 *imx858 = to_imx858(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&imx858->ctrls);
+
+	pm_runtime_dont_use_autosuspend(imx858->dev);
+	pm_runtime_disable(imx858->dev);
+	if (!pm_runtime_status_suspended(imx858->dev))
+		imx858_power_off(imx858->dev);
+	pm_runtime_set_suspended(imx858->dev);
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(imx858_pm_ops, imx858_power_off,
+				 imx858_power_on, NULL);
+
+static const struct of_device_id imx858_of_match[] = {
+	{ .compatible = "xiaomi,aurora-imx858-tele3x", .data = &imx858_tele3x },
+	{ .compatible = "xiaomi,aurora-imx858-tele5x", .data = &imx858_tele5x },
+	{ .compatible = "sony,imx858", .data = &imx858_ultra },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, imx858_of_match);
+
+static struct i2c_driver imx858_driver = {
+	.driver = {
+		.name = "imx858",
+		.of_match_table = imx858_of_match,
+		.pm = pm_ptr(&imx858_pm_ops),
+	},
+	.probe = imx858_probe,
+	.remove = imx858_remove,
+};
+module_i2c_driver(imx858_driver);
+
+MODULE_DESCRIPTION("Sony IMX858 image sensor driver");
+MODULE_LICENSE("GPL");
