From 0166f6c59085a62f901c3240fc7d60994be272b4 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Sun, 1 Nov 2026 22:57:59 +0800
Subject: [PATCH] media: i2c: add an OmniVision OV32B40 driver

Add a driver for the OmniVision OV32B40 32 MP sensor with one fixed
mode: 3264x2448 RAW10, the 6528x4896 array binned 2x2, over four D-PHY
lanes at 1684.8 Mbps (link frequency 842.4 MHz) from a 19.2 MHz XVCLK.

The initialisation and mode tables are the vendor sequences of the
Xiaomi 14 Ultra front camera module. Controls: exposure, analogue gain
(8.8, up to 15.5x), vertical blanking, read-only horizontal blanking,
pixel rate and link frequency, a colour bar test pattern and the fwnode
orientation and rotation. Control writes use group hold 3. Runtime PM
autosuspends after 2 s.

Signed-off-by: dianqk <dianqk@dianqk.net>
---
 drivers/media/i2c/Kconfig   |   11 +
 drivers/media/i2c/Makefile  |    1 +
 drivers/media/i2c/ov32b40.c | 1413 +++++++++++++++++++++++++++++++++++
 3 files changed, 1425 insertions(+)
 create mode 100644 drivers/media/i2c/ov32b40.c

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index f84f31b79d..497eed4e03 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -558,6 +558,17 @@ config VIDEO_OV2740
 	  To compile this driver as a module, choose M here: the
 	  module will be called ov2740.
 
+config VIDEO_OV32B40
+	tristate "OmniVision OV32B40 sensor support"
+	depends on OF && GPIOLIB
+	select V4L2_CCI_I2C
+	help
+	  This is a Video4Linux2 sensor driver for the OmniVision
+	  OV32B40 camera.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called ov32b40.
+
 config VIDEO_OV4689
 	tristate "OmniVision OV4689 sensor support"
 	depends on GPIOLIB
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index c3d6ea882b..efd2133be6 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -103,6 +103,7 @@ obj-$(CONFIG_VIDEO_OV2685) += ov2685.o
 obj-$(CONFIG_VIDEO_OV2732) += ov2732.o
 obj-$(CONFIG_VIDEO_OV2735) += ov2735.o
 obj-$(CONFIG_VIDEO_OV2740) += ov2740.o
+obj-$(CONFIG_VIDEO_OV32B40) += ov32b40.o
 obj-$(CONFIG_VIDEO_OV4689) += ov4689.o
 obj-$(CONFIG_VIDEO_OV5640) += ov5640.o
 obj-$(CONFIG_VIDEO_OV5645) += ov5645.o
diff --git a/drivers/media/i2c/ov32b40.c b/drivers/media/i2c/ov32b40.c
new file mode 100644
index 0000000000..7e95b38546
--- /dev/null
+++ b/drivers/media/i2c/ov32b40.c
@@ -0,0 +1,1413 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * OmniVision OV32B40 image sensor driver
+ *
+ * One fixed mode: 3264x2448 RAW10 (2x2 binned full array), 30 fps, four
+ * D-PHY lanes at 1684.8 Mbps from a 19.2 MHz XVCLK. The register tables
+ * are the vendor sequences of a production camera module.
+ */
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+#define OV32B40_REG_MODE_SELECT		CCI_REG8(0x0100)
+#define OV32B40_MODE_STANDBY		0x00
+#define OV32B40_MODE_STREAMING		0x01
+#define OV32B40_REG_SOFTWARE_RESET	CCI_REG8(0x0103)
+#define OV32B40_REG_CHIP_ID		CCI_REG16(0x300b)
+#define OV32B40_CHIP_ID			0x3242
+#define OV32B40_REG_GROUP_HOLD		CCI_REG8(0x3208)
+#define OV32B40_GROUP_START		0x03
+#define OV32B40_GROUP_END		0x13
+#define OV32B40_GROUP_LAUNCH		0xa3
+#define OV32B40_REG_EXPOSURE		CCI_REG24(0x3500)
+#define OV32B40_REG_ANALOG_GAIN		CCI_REG16(0x3508)
+#define OV32B40_REG_VTS			CCI_REG16(0x380e)
+#define OV32B40_REG_TEST_PATTERN	CCI_REG8(0x5040)
+
+#define OV32B40_XVCLK_FREQ		(19200 * HZ_PER_KHZ)
+#define OV32B40_AUTOSUSPEND_MS		2000
+
+/*
+ * PLL1 (MIPI): 19.2 MHz / 4 * 351 (0x0304) = 1684.8 Mbps per lane, link
+ * frequency 842.4 MHz. The pixel rate is the CSI-2 payload rate of four
+ * lanes at 10 bits per pixel; the line length is expressed in it.
+ */
+#define OV32B40_LINK_FREQ		842400000ULL
+#define OV32B40_PIXEL_RATE		673920000ULL
+#define OV32B40_NUM_LANES		4
+
+#define OV32B40_NATIVE_WIDTH		6528
+#define OV32B40_NATIVE_HEIGHT		4896
+#define OV32B40_WIDTH			3264
+#define OV32B40_HEIGHT			2448
+/* 30 fps at VTS 5332 (0x380e). */
+#define OV32B40_LINE_LENGTH		4213
+#define OV32B40_VTS			5332
+#define OV32B40_VTS_MAX			0xffff
+#define OV32B40_EXPOSURE_MARGIN		8
+#define OV32B40_EXPOSURE_MIN		4
+#define OV32B40_EXPOSURE_DEFAULT	2560
+
+/* Analogue gain is 8.8 fixed point, 1x to 15.5x. */
+#define OV32B40_ANA_GAIN_MIN		0x0100
+#define OV32B40_ANA_GAIN_MAX		0x0f80
+#define OV32B40_ANA_GAIN_DEFAULT	0x0100
+
+#define OV32B40_MBUS_CODE		MEDIA_BUS_FMT_SBGGR10_1X10
+
+/* In power-up order; powered down in reverse. */
+static const char * const ov32b40_supply_names[] = {
+	"dovdd",	/* Digital I/O (1.8 V) */
+	"avdd",		/* Analogue (2.8 V) */
+	"dvdd",		/* Digital core (1.1 V) */
+};
+
+static const char * const ov32b40_test_pattern_menu[] = {
+	"Disabled",
+	"Colour Bars",
+};
+
+static const s64 ov32b40_link_freq_menu[] = {
+	OV32B40_LINK_FREQ,
+};
+
