+struct ov32b40 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *xclk;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(ov32b40_supply_names)];
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *exposure;
+};
+
+static inline struct ov32b40 *to_ov32b40(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct ov32b40, sd);
+}
+
+static int ov32b40_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct ov32b40 *ov = container_of(ctrl->handler, struct ov32b40, ctrls);
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		u32 max = OV32B40_HEIGHT + ctrl->val - OV32B40_EXPOSURE_MARGIN;
+
+		ret = __v4l2_ctrl_modify_range(ov->exposure,
+					       ov->exposure->minimum, max,
+					       ov->exposure->step,
+					       min_t(u32, max,
+						     ov->exposure->default_value));
+		if (ret)
+			return ret;
+	}
+
+	if (pm_runtime_get_if_in_use(ov->dev) <= 0)
+		return 0;
+
+	cci_write(ov->regmap, OV32B40_REG_GROUP_HOLD, OV32B40_GROUP_START, &ret);
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(ov->regmap, OV32B40_REG_EXPOSURE, ctrl->val, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		cci_write(ov->regmap, OV32B40_REG_ANALOG_GAIN, ctrl->val, &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(ov->regmap, OV32B40_REG_VTS,
+			  OV32B40_HEIGHT + ctrl->val, &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		cci_write(ov->regmap, OV32B40_REG_TEST_PATTERN,
+			  ctrl->val ? 0x80 : 0x00, &ret);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+	cci_write(ov->regmap, OV32B40_REG_GROUP_HOLD, OV32B40_GROUP_END, &ret);
+	cci_write(ov->regmap, OV32B40_REG_GROUP_HOLD, OV32B40_GROUP_LAUNCH, &ret);
+
+	pm_runtime_put_autosuspend(ov->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops ov32b40_ctrl_ops = {
+	.s_ctrl = ov32b40_set_ctrl,
+};
+
+static int ov32b40_init_controls(struct ov32b40 *ov)
+{
+	struct v4l2_ctrl_handler *hdl = &ov->ctrls;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *ctrl;
+	u32 hblank = OV32B40_LINE_LENGTH - OV32B40_WIDTH;
+	u32 vblank = OV32B40_VTS - OV32B40_HEIGHT;
+	int ret;
+
+	ret = v4l2_fwnode_device_parse(ov->dev, &props);
+	if (ret)
+		return ret;
+
+	v4l2_ctrl_handler_init(hdl, 9);
+
+	ctrl = v4l2_ctrl_new_int_menu(hdl, NULL, V4L2_CID_LINK_FREQ, 0, 0,
+				      ov32b40_link_freq_menu);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(hdl, NULL, V4L2_CID_PIXEL_RATE, OV32B40_PIXEL_RATE,
+			  OV32B40_PIXEL_RATE, 1, OV32B40_PIXEL_RATE);
+
+	ctrl = v4l2_ctrl_new_std(hdl, NULL, V4L2_CID_HBLANK, hblank, hblank, 1,
+				 hblank);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(hdl, &ov32b40_ctrl_ops, V4L2_CID_VBLANK, vblank,
+			  OV32B40_VTS_MAX - OV32B40_HEIGHT, 1, vblank);
+
+	ov->exposure = v4l2_ctrl_new_std(hdl, &ov32b40_ctrl_ops,
+					 V4L2_CID_EXPOSURE,
+					 OV32B40_EXPOSURE_MIN,
+					 OV32B40_VTS - OV32B40_EXPOSURE_MARGIN,
+					 1, OV32B40_EXPOSURE_DEFAULT);
+
+	v4l2_ctrl_new_std(hdl, &ov32b40_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  OV32B40_ANA_GAIN_MIN, OV32B40_ANA_GAIN_MAX, 1,
+			  OV32B40_ANA_GAIN_DEFAULT);
+
+	v4l2_ctrl_new_std_menu_items(hdl, &ov32b40_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(ov32b40_test_pattern_menu) - 1,
+				     0, 0, ov32b40_test_pattern_menu);
+
+	v4l2_ctrl_new_fwnode_properties(hdl, &ov32b40_ctrl_ops, &props);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		v4l2_ctrl_handler_free(hdl);
+		return dev_err_probe(ov->dev, ret, "control init failed\n");
+	}
+
+	ov->sd.ctrl_handler = hdl;
+
+	return 0;
+}
+
+static int ov32b40_identify(struct ov32b40 *ov)
+{
+	u64 id;
+	int ret;
+
+	ret = cci_read(ov->regmap, OV32B40_REG_CHIP_ID, &id, NULL);
+	if (ret)
+		return dev_err_probe(ov->dev, ret, "failed to read chip ID\n");
+	if (id != OV32B40_CHIP_ID)
+		return dev_err_probe(ov->dev, -ENODEV,
+				     "chip ID %#06llx, expected %#06x\n",
+				     id, OV32B40_CHIP_ID);
+
+	return 0;
+}
+
+static int ov32b40_enable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct ov32b40 *ov = to_ov32b40(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(ov->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = cci_write(ov->regmap, OV32B40_REG_SOFTWARE_RESET, 0x01, NULL);
+	if (ret)
+		goto err_rpm_put;
+	usleep_range(5000, 6000);
+
+	ret = cci_multi_reg_write(ov->regmap, ov32b40_init_regs,
+				  ARRAY_SIZE(ov32b40_init_regs), NULL);
+	if (!ret)
+		ret = cci_multi_reg_write(ov->regmap, ov32b40_3264x2448_regs,
+					  ARRAY_SIZE(ov32b40_3264x2448_regs),
+					  NULL);
+	if (ret) {
+		dev_err(ov->dev, "failed to write registers: %d\n", ret);
+		goto err_rpm_put;
+	}
+
+	ret = __v4l2_ctrl_handler_setup(ov->sd.ctrl_handler);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_write(ov->regmap, OV32B40_REG_MODE_SELECT,
+			OV32B40_MODE_STREAMING, NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(ov->dev);
+	return ret;
+}
+
+static int ov32b40_disable_streams(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *state, u32 pad,
+				   u64 streams_mask)
+{
+	struct ov32b40 *ov = to_ov32b40(sd);
+	int ret;
+
+	ret = cci_write(ov->regmap, OV32B40_REG_MODE_SELECT,
+			OV32B40_MODE_STANDBY, NULL);
+	if (ret)
+		dev_err(ov->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(ov->dev);
+
+	return ret;
+}
+
+static void ov32b40_fill_format(struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = OV32B40_WIDTH;
+	fmt->height = OV32B40_HEIGHT;
+	fmt->code = OV32B40_MBUS_CODE;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int ov32b40_enum_mbus_code(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+
+	code->code = OV32B40_MBUS_CODE;
+
+	return 0;
+}
+
+static int ov32b40_enum_frame_size(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *state,
+				   struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index || fse->code != OV32B40_MBUS_CODE)
+		return -EINVAL;
+
+	fse->min_width = OV32B40_WIDTH;
+	fse->max_width = OV32B40_WIDTH;
+	fse->min_height = OV32B40_HEIGHT;
+	fse->max_height = OV32B40_HEIGHT;
+
+	return 0;
+}
+
+static int ov32b40_set_format(struct v4l2_subdev *sd,
+			      struct v4l2_subdev_state *state,
+			      struct v4l2_subdev_format *fmt)
+{
+	ov32b40_fill_format(&fmt->format);
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+
+	return 0;
+}
+
+static int ov32b40_get_selection(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		/* The mode reads the whole array and bins it 2x2. */
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = OV32B40_NATIVE_WIDTH;
+		sel->r.height = OV32B40_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int ov32b40_init_state(struct v4l2_subdev *sd,
+			      struct v4l2_subdev_state *state)
+{
+	ov32b40_fill_format(v4l2_subdev_state_get_format(state, 0));
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops ov32b40_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops ov32b40_pad_ops = {
+	.enum_mbus_code = ov32b40_enum_mbus_code,
+	.enum_frame_size = ov32b40_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = ov32b40_set_format,
+	.get_selection = ov32b40_get_selection,
+	.enable_streams = ov32b40_enable_streams,
+	.disable_streams = ov32b40_disable_streams,
+};
+
+static const struct v4l2_subdev_ops ov32b40_subdev_ops = {
+	.video = &ov32b40_video_ops,
+	.pad = &ov32b40_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops ov32b40_internal_ops = {
+	.init_state = ov32b40_init_state,
+};
+
+static int ov32b40_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct ov32b40 *ov = to_ov32b40(sd);
+	unsigned int i;
+	int ret;
+
+	gpiod_set_value_cansleep(ov->reset_gpio, 1);
+
+	for (i = 0; i < ARRAY_SIZE(ov->supplies); i++) {
+		ret = regulator_enable(ov->supplies[i].consumer);
+		if (ret) {
+			dev_err(dev, "failed to enable %s: %d\n",
+				ov->supplies[i].supply, ret);
+			goto err_supplies;
+		}
+	}
+	usleep_range(2000, 2500);
+
+	ret = clk_prepare_enable(ov->xclk);
+	if (ret) {
+		dev_err(dev, "failed to enable clock: %d\n", ret);
+		goto err_supplies;
+	}
+	usleep_range(1000, 1500);
+
+	gpiod_set_value_cansleep(ov->reset_gpio, 0);
+	/* At least 8192 XVCLK cycles before the first SCCB access. */
+	usleep_range(10000, 11000);
+
+	return 0;
+
+err_supplies:
+	while (i--)
+		regulator_disable(ov->supplies[i].consumer);
+	return ret;
+}
+
+static int ov32b40_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct ov32b40 *ov = to_ov32b40(sd);
+	unsigned int i;
+
+	gpiod_set_value_cansleep(ov->reset_gpio, 1);
+	usleep_range(1000, 1500);
+	clk_disable_unprepare(ov->xclk);
+
+	for (i = ARRAY_SIZE(ov->supplies); i--;)
+		regulator_disable(ov->supplies[i].consumer);
+
+	return 0;
+}
+
+static int ov32b40_parse_endpoint(struct ov32b40 *ov)
+{
+	struct v4l2_fwnode_endpoint ep = { .bus_type = V4L2_MBUS_CSI2_DPHY };
+	struct fwnode_handle *endpoint;
+	unsigned long link_freq_bitmap;
+	int ret;
+
+	endpoint = fwnode_graph_get_endpoint_by_id(dev_fwnode(ov->dev), 0, 0,
+						   FWNODE_GRAPH_ENDPOINT_NEXT);
+	if (!endpoint)
+		return dev_err_probe(ov->dev, -EINVAL, "missing endpoint\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return dev_err_probe(ov->dev, ret, "failed to parse endpoint\n");
+
+	if (ep.bus.mipi_csi2.num_data_lanes != OV32B40_NUM_LANES) {
+		ret = dev_err_probe(ov->dev, -EINVAL,
+				    "%u data lanes unsupported, need %u\n",
+				    ep.bus.mipi_csi2.num_data_lanes,
+				    OV32B40_NUM_LANES);
+		goto out;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(ov->dev, ep.link_frequencies,
+				       ep.nr_of_link_frequencies,
+				       ov32b40_link_freq_menu,
+				       ARRAY_SIZE(ov32b40_link_freq_menu),
+				       &link_freq_bitmap);
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+	return ret;
+}
+
+static int ov32b40_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct ov32b40 *ov;
+	unsigned long rate;
+	unsigned int i;
+	int ret;
+
+	ov = devm_kzalloc(dev, sizeof(*ov), GFP_KERNEL);
+	if (!ov)
+		return -ENOMEM;
+
+	ov->dev = dev;
+	v4l2_i2c_subdev_init(&ov->sd, client, &ov32b40_subdev_ops);
+
+	ret = ov32b40_parse_endpoint(ov);
+	if (ret)
+		return ret;
+
+	ov->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(ov->regmap))
+		return dev_err_probe(dev, PTR_ERR(ov->regmap),
+				     "failed to init CCI\n");
+
+	ov->xclk = devm_clk_get(dev, NULL);
+	if (IS_ERR(ov->xclk))
+		return dev_err_probe(dev, PTR_ERR(ov->xclk),
+				     "failed to get clock\n");
+
+	rate = clk_get_rate(ov->xclk);
+	if (rate != OV32B40_XVCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "clock %lu Hz unsupported, need %lu Hz\n",
+				     rate, OV32B40_XVCLK_FREQ);
+
+	ov->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ov->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ov->reset_gpio),
+				     "failed to get reset GPIO\n");
+
+	for (i = 0; i < ARRAY_SIZE(ov32b40_supply_names); i++)
+		ov->supplies[i].supply = ov32b40_supply_names[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ov->supplies),
+				      ov->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	ret = ov32b40_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = ov32b40_identify(ov);
+	if (ret)
+		goto err_power_off;
+
+	ret = ov32b40_init_controls(ov);
+	if (ret)
+		goto err_power_off;
+
+	ov->sd.internal_ops = &ov32b40_internal_ops;
+	ov->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	ov->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	ov->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&ov->sd.entity, 1, &ov->pad);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init entity pads\n");
+		goto err_free_ctrls;
+	}
+
+	ov->sd.state_lock = ov->ctrls.lock;
+	ret = v4l2_subdev_init_finalize(&ov->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init subdev\n");
+		goto err_entity;
+	}
+
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, OV32B40_AUTOSUSPEND_MS);
+	pm_runtime_use_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&ov->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to register subdev\n");
+		goto err_pm;
+	}
+
+	pm_runtime_put_autosuspend(dev);
+
+	return 0;
+
+err_pm:
+	pm_runtime_dont_use_autosuspend(dev);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+	pm_runtime_put_noidle(dev);
+	v4l2_subdev_cleanup(&ov->sd);
+err_entity:
+	media_entity_cleanup(&ov->sd.entity);
+err_free_ctrls:
+	v4l2_ctrl_handler_free(&ov->ctrls);
+err_power_off:
+	ov32b40_power_off(dev);
+	return ret;
+}
+
+static void ov32b40_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct ov32b40 *ov = to_ov32b40(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&ov->ctrls);
+
+	pm_runtime_dont_use_autosuspend(ov->dev);
+	pm_runtime_disable(ov->dev);
+	if (!pm_runtime_status_suspended(ov->dev))
+		ov32b40_power_off(ov->dev);
+	pm_runtime_set_suspended(ov->dev);
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(ov32b40_pm_ops, ov32b40_power_off,
+				 ov32b40_power_on, NULL);
+
+static const struct of_device_id ov32b40_of_match[] = {
+	{ .compatible = "ovti,ov32b40" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ov32b40_of_match);
+
+static struct i2c_driver ov32b40_driver = {
+	.driver = {
+		.name = "ov32b40",
+		.of_match_table = ov32b40_of_match,
+		.pm = pm_ptr(&ov32b40_pm_ops),
+	},
+	.probe = ov32b40_probe,
+	.remove = ov32b40_remove,
+};
+module_i2c_driver(ov32b40_driver);
+
+MODULE_DESCRIPTION("OmniVision OV32B40 image sensor driver");
+MODULE_LICENSE("GPL");
