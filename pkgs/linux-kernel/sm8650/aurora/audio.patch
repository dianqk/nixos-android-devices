From: dianqk <dianqk@dianqk.net>
Date: Wed, 7 Oct 2026 17:00:00 +0800
Subject: [PATCH] arm64: dts: qcom: connect Aurora WCD9395 and dual CS35L43 audio

Board wiring and 48kHz stereo S32_LE Secondary TDM follow Xiaomi Android 14
OS1.0.3.0.UNACNXM. WCD/SoundWire integration follows upstream SM8650 HDK
(Copyright (c) 2023, Linaro Limited, BSD-3-Clause). Reuse the common machine
slot handling with an explicit Aurora format/clock configuration.
Use DSP_A as selected by the OEM CS35L43 startup; I2S long-sync maps
channel zero to the wrong slot and loses channel one on this TDM bus.

BOB1 uses a range because 3296000 alone is not selectable by pmic5_bob
(3000000 + n * 32000). Track its downstream LDO consumers so idle cleanup
cannot disable the shared USB/panel supply.

Local board details: preserve OEM amplifier reset/IRQ pin configuration and
standby mode; otherwise this driver defaults to runtime-PM hibernation.

Sources:
https://github.com/MiCode/vendor_qcom_opensource_audio-kernel/tree/d2ddef03a379bc82c7bcd08481e29e08bbff80eb
https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git/tree/arch/arm64/boot/dts/qcom/sm8650-hdk.dts?h=v7.3-rc5

Signed-off-by: dianqk <dianqk@dianqk.net>
---
diff --git a/Documentation/devicetree/bindings/sound/qcom,sm8250.yaml b/Documentation/devicetree/bindings/sound/qcom,sm8250.yaml
index 1536fcd96..5a30a91cd 100644
--- a/Documentation/devicetree/bindings/sound/qcom,sm8250.yaml
+++ b/Documentation/devicetree/bindings/sound/qcom,sm8250.yaml
@@ -16,6 +16,9 @@ description:
 properties:
   compatible:
     oneOf:
+      - items:
+          - const: xiaomi,aurora-sndcard
+          - const: qcom,sm8650-sndcard
       - items:
           - enum:
               - lenovo,yoga-c630-sndcard
diff --git a/arch/arm64/boot/dts/qcom/sm8650-xiaomi-aurora.dts b/arch/arm64/boot/dts/qcom/sm8650-xiaomi-aurora.dts
index 1d388e931..3ed7d8787 100644
--- a/arch/arm64/boot/dts/qcom/sm8650-xiaomi-aurora.dts
+++ b/arch/arm64/boot/dts/qcom/sm8650-xiaomi-aurora.dts
@@ -583,3 +583,220 @@ touch_irq_default: touch-irq-default-state {
 		input-enable;
 	};
 };
+
+/* Audio wiring from Xiaomi aurora-u-oss and Android 14 live DT. */
+/ {
+	sound {
+		compatible = "xiaomi,aurora-sndcard", "qcom,sm8650-sndcard";
+		model = "Xiaomi-Aurora";
+		audio-routing = "IN1_HPHL", "HPHL_OUT", "IN2_HPHR", "HPHR_OUT",
+			"AMIC1", "MIC BIAS1", "AMIC2", "MIC BIAS2",
+			"AMIC3", "MIC BIAS4", "AMIC4", "MIC BIAS1",
+			"TX SWR_INPUT0", "ADC1_OUTPUT", "TX SWR_INPUT1", "ADC2_OUTPUT",
+			"TX SWR_INPUT2", "ADC3_OUTPUT", "TX SWR_INPUT3", "ADC4_OUTPUT";
+
+		speaker-dai-link {
+			link-name = "Speaker Playback";
+			cpu {
+				sound-dai = <&q6apmbedai SECONDARY_TDM_RX_0>;
+				dai-tdm-slot-num = <4>;
+				dai-tdm-slot-width = <32>;
+				dai-tdm-slot-rx-mask = <1 1 0 0>;
+			};
+			codec {
+				sound-dai = <&bottom_spkr>, <&top_spkr>;
+				dai-tdm-slot-num = <4>;
+				dai-tdm-slot-width = <32>;
+				dai-tdm-slot-rx-mask = <1 1 0 0>;
+			};
+			platform { sound-dai = <&q6apm>; };
+		};
+		wcd-playback-dai-link {
+			link-name = "WCD Playback";
+			cpu { sound-dai = <&q6apmbedai RX_CODEC_DMA_RX_0>; };
+			codec { sound-dai = <&wcd939x 0>, <&swr1 0>, <&lpass_rxmacro 0>; };
+			platform { sound-dai = <&q6apm>; };
+		};
+		wcd-capture-dai-link {
+			link-name = "WCD Capture";
+			cpu { sound-dai = <&q6apmbedai TX_CODEC_DMA_TX_3>; };
+			codec { sound-dai = <&wcd939x 1>, <&swr2 0>, <&lpass_txmacro 0>; };
+			platform { sound-dai = <&q6apm>; };
+		};
+	};
+
+	wcd939x: audio-codec {
+		compatible = "qcom,wcd9395-codec", "qcom,wcd9390-codec";
+		#sound-dai-cells = <1>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&wcd_reset_default>;
+		reset-gpios = <&tlmm 107 GPIO_ACTIVE_LOW>;
+		vdd-buck-supply = <&vreg_l15b>;
+		vdd-rxtx-supply = <&vreg_l15b>;
+		vdd-io-supply = <&vreg_l15b>;
+		vdd-mic-bias-supply = <&vreg_bob1>;
+		vdd-px-supply = <&vreg_l3c>;
+		qcom,micbias1-microvolt = <2750000>;
+		qcom,micbias2-microvolt = <2750000>;
+		qcom,micbias3-microvolt = <2750000>;
+		qcom,micbias4-microvolt = <2750000>;
+		qcom,rx-device = <&wcd_rx>;
+		qcom,tx-device = <&wcd_tx>;
+	};
+};
+
+&apps_rsc {
+	regulators-0 {
+		/* PM8550 BOB1 also feeds active USB/panel LDOs. */
+		vdd-l2-l13-l14-supply = <&vreg_bob1>;
+		vdd-l5-l16-supply = <&vreg_bob1>;
+		vdd-l6-l7-supply = <&vreg_bob1>;
+		vdd-l8-l9-supply = <&vreg_bob1>;
+
+		vreg_bob1: bob1 {
+			regulator-name = "vreg_bob1";
+			regulator-min-microvolt = <3296000>;
+			regulator-max-microvolt = <3960000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
+		};
+	};
+};
+
+&i2c_master_hub_0 { status = "okay"; };
+&i2c_hub_4 {
+	status = "okay";
+	clock-frequency = <400000>;
+
+	bottom_spkr: amplifier@40 {
+		compatible = "cirrus,cs35l43";
+		reg = <0x40>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&bottom_spkr_reset_default &bottom_spkr_irq_default>;
+		cirrus,low-pwr-mode-standby;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "B";
+		cirrus,dsp-part-name = "aurora-B-cs35l43";
+		reset-gpios = <&tlmm 85 GPIO_ACTIVE_HIGH>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <88 IRQ_TYPE_LEVEL_LOW>;
+		cirrus,vpbr-thld = <8>;
+		cirrus,vpbr-max-att = <3>;
+		cirrus,vpbr-atk-vol = <5>;
+		cirrus,vpbr-atk-rate = <0>;
+		cirrus,vpbr-wait = <0>;
+		cirrus,vpbr-rel-rate = <0>;
+		cirrus,vpbr-enable;
+		cirrus,gpio2-src-sel = <4>;
+		cirrus,asp-sdout-hiz = <3>;
+		cirrus,bst-ipk-ma = <4000>;
+	};
+
+	top_spkr: amplifier@42 {
+		compatible = "cirrus,cs35l43";
+		reg = <0x42>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&top_spkr_reset_default &top_spkr_irq_default>;
+		cirrus,low-pwr-mode-standby;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "T";
+		cirrus,dsp-part-name = "aurora-T-cs35l43";
+		reset-gpios = <&tlmm 111 GPIO_ACTIVE_HIGH>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <92 IRQ_TYPE_LEVEL_LOW>;
+		cirrus,vpbr-thld = <8>;
+		cirrus,vpbr-max-att = <3>;
+		cirrus,vpbr-atk-vol = <5>;
+		cirrus,vpbr-atk-rate = <0>;
+		cirrus,vpbr-wait = <0>;
+		cirrus,vpbr-rel-rate = <0>;
+		cirrus,vpbr-enable;
+		cirrus,gpio2-src-sel = <4>;
+		cirrus,asp-sdout-hiz = <3>;
+		cirrus,bst-ipk-ma = <4000>;
+	};
+};
+
+&lpass_vamacro { qcom,dmic-sample-rate = <600000>; };
+
+&tlmm {
+	/* Aurora routes Secondary TDM through main TLMM, not LPASS LPI. */
+	secondary_tdm_default: secondary-tdm-default-state {
+		clk-pins { pins = "gpio121"; function = "i2s1_sck"; drive-strength = <8>; bias-disable; output-high; };
+		ws-pins { pins = "gpio123"; function = "i2s1_ws"; drive-strength = <8>; bias-disable; output-high; };
+		data-in-pins { pins = "gpio122"; function = "i2s1_data0"; drive-strength = <8>; bias-disable; };
+		data-out-pins { pins = "gpio124"; function = "i2s1_data1"; drive-strength = <8>; bias-disable; };
+	};
+};
+
+&q6apmbedai {
+	pinctrl-names = "default";
+	pinctrl-0 = <&secondary_tdm_default>;
+	#address-cells = <1>;
+	#size-cells = <0>;
+	dai@28 {
+		reg = <SECONDARY_TDM_RX_0>;
+		clocks = <&q6prmcc LPASS_CLK_ID_SEC_TDM_IBIT LPASS_CLK_ATTRIBUTE_INVERT_COUPLE_NO>;
+		clock-names = "bclk";
+	};
+};
+
+&swr1 {
+	status = "okay";
+	wcd_rx: codec@0,4 {
+		compatible = "sdw20217010e00";
+		reg = <0 4>;
+		qcom,rx-port-mapping = <1 2 3 4 5 9>;
+	};
+};
+
+&swr2 {
+	status = "okay";
+	wcd_tx: codec@0,3 {
+		compatible = "sdw20217010e00";
+		reg = <0 3>;
+		qcom,tx-port-mapping = <2 2 3 4>;
+	};
+};
+
+&tlmm {
+	wcd_reset_default: wcd-reset-default-state {
+		pins = "gpio107";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+	};
+};
+
+&tlmm {
+	bottom_spkr_reset_default: bottom-spkr-reset-default-state {
+		pins = "gpio85";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+		output-high;
+	};
+	bottom_spkr_irq_default: bottom-spkr-irq-default-state {
+		pins = "gpio88";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+		input-enable;
+	};
+};
+
+&tlmm {
+	top_spkr_reset_default: top-spkr-reset-default-state {
+		pins = "gpio111";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+		output-high;
+	};
+	top_spkr_irq_default: top-spkr-irq-default-state {
+		pins = "gpio92";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+		input-enable;
+	};
+};
diff --git a/sound/soc/qcom/sc8280xp.c b/sound/soc/qcom/sc8280xp.c
index 4d48e1012..1678bb8c9 100644
--- a/sound/soc/qcom/sc8280xp.c
+++ b/sound/soc/qcom/sc8280xp.c
@@ -67,6 +67,7 @@ struct qcom_snd_soc_common {
 	const struct snd_kcontrol_new *controls;
 	int num_controls;
 	unsigned int codec_dai_fmt;
+	snd_pcm_format_t tdm_format;
 	bool codec_sysclk_set;
 	bool mi2s_mclk_enable;
 	bool mi2s_bclk_enable;
@@ -126,7 +127,9 @@ static int sc8280xp_tdm_hw_params(struct snd_pcm_substream *substream,
 	if (!cpu_cfg.slots)
 		return 0;
 
-	ret = snd_soc_dai_set_fmt(cpu_dai, SND_SOC_DAIFMT_BP_FP);
+	ret = snd_soc_dai_set_fmt(cpu_dai,
+		(data->priv->codec_dai_fmt & ~SND_SOC_DAIFMT_CLOCK_PROVIDER_MASK) |
+		SND_SOC_DAIFMT_BP_FP);
 	if (ret && ret != -ENOTSUPP)
 		return ret;
 
@@ -218,6 +221,7 @@ static int sc8280xp_snd_init(struct snd_soc_pcm_runtime *rtd)
 static int sc8280xp_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 				     struct snd_pcm_hw_params *params)
 {
+	struct sc8280xp_snd_data *data = snd_soc_card_get_drvdata(rtd->card);
 	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
 	struct snd_interval *rate = hw_param_interval(params,
 					SNDRV_PCM_HW_PARAM_RATE);
@@ -229,6 +233,11 @@ static int sc8280xp_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 	snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S16_LE);
 	channels->min = 2;
 	channels->max = 2;
+	if (cpu_dai->id >= PRIMARY_TDM_RX_0 && cpu_dai->id <= QUINARY_TDM_TX_7 &&
+	    data->priv->tdm_format) {
+		snd_mask_none(fmt);
+		snd_mask_set_format(fmt, data->priv->tdm_format);
+	}
 	switch (cpu_dai->id) {
 	case TX_CODEC_DMA_TX_0:
 	case TX_CODEC_DMA_TX_1:
@@ -538,6 +547,17 @@ static const struct qcom_snd_soc_common sm8550_priv_data = {
 			 SND_SOC_DAIFMT_I2S,
 };
 
+static const struct qcom_snd_soc_common aurora_priv_data = {
+	.tdm_format = SNDRV_PCM_FORMAT_S32_LE,
+	.mi2s_bclk_enable = true,
+	.driver_name = "sm8650",
+	.dapm_widgets = sc8280xp_dapm_widgets,
+	.num_dapm_widgets = ARRAY_SIZE(sc8280xp_dapm_widgets),
+	.wcd_jack = true,
+	.codec_sysclk_set = true,
+	.codec_dai_fmt = SND_SOC_DAIFMT_BC_FC | SND_SOC_DAIFMT_IB_NF | SND_SOC_DAIFMT_DSP_A,
+};
+
 static const struct qcom_snd_soc_common sm8650_priv_data = {
 	.driver_name = "sm8650",
 	.dapm_widgets = sc8280xp_dapm_widgets,
@@ -574,6 +594,7 @@ static const struct of_device_id snd_sc8280xp_dt_match[] = {
 	{ .compatible = "qcom,sm8450-sndcard", .data = &sm8450_priv_data },
 	{ .compatible = "qcom,sm8475-sndcard", .data = &sm8475_priv_data },
 	{ .compatible = "qcom,sm8550-sndcard", .data = &sm8550_priv_data },
+	{ .compatible = "xiaomi,aurora-sndcard", .data = &aurora_priv_data },
 	{ .compatible = "qcom,sm8650-sndcard", .data = &sm8650_priv_data },
 	{ .compatible = "qcom,sm8750-sndcard", .data = &sm8750_priv_data },
 	{}
