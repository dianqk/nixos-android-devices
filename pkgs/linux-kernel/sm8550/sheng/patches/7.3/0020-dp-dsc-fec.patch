+	panel = container_of(msm_dp_panel, struct msm_dp_panel_private,
+			msm_dp_panel);
+	val = msm_dp_read_link(panel, MMSS_DP_FLUSH);
+	msm_dp_write_link(panel, MMSS_DP_FLUSH, val | DP_PPS_FLUSH);
+}
