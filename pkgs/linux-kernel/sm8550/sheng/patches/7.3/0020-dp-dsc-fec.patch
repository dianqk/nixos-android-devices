From: dianqk <dianqk@dianqk.net>
Date: Tue, 29 Sep 2026 00:00:00 +0800
Subject: [PATCH] drm/msm: support DP SST DSC and FEC

Porting notes: Three-way port the fork DSC/FEC commit after 0019; resolve 7.3 panel, bridge and DPU interfaces as hunks. Use pure per-mode DSC feasibility checks during atomic validation and update the active configuration only at bridge pre-enable, before DPU encoder enable. Limit DSC to RGB and validate the complete configuration before accepting compressed modes. Do not restore obsolete ASSR logic or unrelated DPU clocks. The OPP zero-rate follow-up is already present in 7.3.

Original author dates, messages, and trailers: patches/ORIGINS.md.
Source-Commit: https://github.com/ianchb/sm8550-mainline/commit/64cb2eeb22150eddea1f6c67ff70a5939c6cd32b
---
diff --git a/drivers/gpu/drm/msm/Kconfig b/drivers/gpu/drm/msm/Kconfig
index ed1c477..ba9df50 100644
--- a/drivers/gpu/drm/msm/Kconfig
+++ b/drivers/gpu/drm/msm/Kconfig
@@ -119,6 +119,7 @@ config DRM_MSM_DP
 	depends on DRM_MSM
 	depends on DRM_MSM_KMS
 	select DRM_DISPLAY_HDMI_AUDIO_HELPER
+	select DRM_DISPLAY_DSC_HELPER
 	select RATIONAL
 	select DRM_DISPLAY_DP_AUX_BUS
 	select DRM_DISPLAY_DP_HELPER
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
index 1f20695..247d50f 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
@@ -649,6 +649,8 @@ struct drm_dsc_config *dpu_encoder_get_dsc_config(struct drm_encoder *drm_enc)
 
 	if (dpu_enc->disp_info.intf_type == INTF_DSI)
 		return msm_dsi_get_dsc_config(priv->kms->dsi[index]);
+	if (dpu_enc->disp_info.intf_type == INTF_DP)
+		return msm_dp_get_dsc_config(priv->kms->dp[index]);
 
 	return NULL;
 }
@@ -665,7 +667,8 @@ void dpu_encoder_update_topology(struct drm_encoder *drm_enc,
 	struct drm_connector *connector;
 	struct drm_connector_state *conn_state;
 	struct drm_framebuffer *fb;
-	struct drm_dsc_config *dsc;
+	bool dsc_enabled;
+	u32 bpp;
 
 	int i;
 
@@ -673,10 +676,18 @@ void dpu_encoder_update_topology(struct drm_encoder *drm_enc,
 		if (dpu_enc->phys_encs[i])
 			topology->num_intf++;
 
-	dsc = dpu_encoder_get_dsc_config(drm_enc);
+	connector = drm_atomic_get_new_connector_for_encoder(state, drm_enc);
+	if (disp_info->intf_type == INTF_DP) {
+		bpp = connector ? connector->display_info.bpc * 3 : 0;
+		dsc_enabled = connector && msm_dp_mode_has_dsc(
+			priv->kms->dp[disp_info->h_tile_instance[0]], adj_mode,
+			bpp ?: 24);
+	} else {
+		dsc_enabled = !!dpu_encoder_get_dsc_config(drm_enc);
+	}
 
 	/* We only support 2 DSC mode (with 2 LM and 1 INTF) */
-	if (dsc) {
+	if (dsc_enabled) {
 		/*
 		 * Use 2 DSC encoders, 2 layer mixers and 1 or 2 interfaces
 		 * when Display Stream Compression (DSC) is enabled,
@@ -692,7 +703,6 @@ void dpu_encoder_update_topology(struct drm_encoder *drm_enc,
 			topology->num_dsc = 1;
 	}
 
-	connector = drm_atomic_get_new_connector_for_encoder(state, drm_enc);
 	if (!connector)
 		return;
 	conn_state = drm_atomic_get_new_connector_state(state, connector);
@@ -1222,9 +1232,17 @@ static void dpu_encoder_virt_atomic_mode_set(struct drm_encoder *drm_enc,
 	num_dsc = dpu_rm_get_assigned_resources(&dpu_kms->rm, global_state,
 						drm_enc->crtc, DPU_HW_BLK_DSC,
 						hw_dsc, ARRAY_SIZE(hw_dsc));
-	for (i = 0; i < num_dsc; i++) {
-		dpu_enc->hw_dsc[i] = to_dpu_hw_dsc(hw_dsc[i]);
-		dsc_mask |= BIT(dpu_enc->hw_dsc[i]->idx - DSC_0);
+	for (i = 0; i < MAX_CHANNELS_PER_ENC; i++) {
+		/*
+		 * Clear stale entries: use_dsc_merge() counts non-NULL
+		 * hw_dsc pointers, and a leftover pair from a previous
+		 * DSC mode would wrongly disable merge_3d for the
+		 * following non-DSC mode (screen underflows, halves
+		 * duplicated).
+		 */
+		dpu_enc->hw_dsc[i] = i < num_dsc ? to_dpu_hw_dsc(hw_dsc[i]) : NULL;
+		if (i < num_dsc)
+			dsc_mask |= BIT(dpu_enc->hw_dsc[i]->idx - DSC_0);
 	}
 
 	dpu_enc->dsc_mask = dsc_mask;
@@ -2098,8 +2116,16 @@ void dpu_encoder_prepare_for_kickoff(struct drm_encoder *drm_enc)
 		}
 	}
 
-	if (dpu_enc->dsc)
+	if (dpu_enc->dsc) {
 		dpu_encoder_prep_dsc(dpu_enc, dpu_enc->dsc);
+
+		if (dpu_enc->disp_info.intf_type == INTF_DP) {
+			struct msm_drm_private *priv = drm_enc->dev->dev_private;
+
+			msm_dp_display_flush_pps(priv->kms->dp[
+					dpu_enc->disp_info.h_tile_instance[0]]);
+		}
+	}
 }
 
 /**
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
index ba810f2..7c20118 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
@@ -46,6 +46,7 @@ static void drm_mode_to_intf_timing_params(
 		const struct drm_display_mode *mode,
 		struct dpu_hw_intf_timing_params *timing)
 {
+	u32 extra_width = 0;
 	memset(timing, 0, sizeof(*timing));
 
 	if ((mode->htotal < mode->hsync_end)
@@ -110,11 +111,9 @@ static void drm_mode_to_intf_timing_params(
 		timing->v_front_porch = 0;
 	}
 
-	/*
-	 * for DP, divide the horizonal parameters by 2 when
-	 * widebus is enabled
-	 */
-	if (phys_enc->hw_intf->cap->type == INTF_DP && timing->wide_bus_en) {
+	/* DP DSC uses the same two-pixel interface path as wide bus. */
+	if (phys_enc->hw_intf->cap->type == INTF_DP &&
+	    (timing->wide_bus_en || timing->compression_en)) {
 		timing->width = timing->width >> 1;
 		timing->xres = timing->xres >> 1;
 		timing->h_back_porch = timing->h_back_porch >> 1;
@@ -127,17 +126,37 @@ static void drm_mode_to_intf_timing_params(
 	 * timing parameters by compression ratio. bits of 3 components(R/G/B)
 	 * is compressed into bits of 1 pixel.
 	 */
-	if (phys_enc->hw_intf->cap->type != INTF_DP && timing->compression_en) {
+	if (timing->compression_en) {
 		struct drm_dsc_config *dsc =
 		       dpu_encoder_get_dsc_config(phys_enc->parent);
 		/*
 		 * TODO: replace drm_dsc_get_bpp_int with logic to handle
 		 * fractional part if there is fraction
 		 */
-		timing->width = timing->width * drm_dsc_get_bpp_int(dsc) /
-				(dsc->bits_per_component * 3);
-		timing->xres = timing->width;
 		timing->dce_bytes_per_line = msm_dsc_get_bytes_per_line(dsc);
+		if (phys_enc->hw_intf->cap->type != INTF_DP) {
+			timing->width = timing->width * drm_dsc_get_bpp_int(dsc) /
+					(dsc->bits_per_component * 3);
+			timing->xres = timing->width;
+		} else {
+			u32 ack_required = DIV_ROUND_UP(timing->dce_bytes_per_line, 6);
+			u32 line_width = dsc->pic_width / 2;
+
+			if (ack_required)
+				timing->extra_dto_cycles = ack_required - 1;
+
+			/* 8bpp DSC uses the 1/3 DTO for 8/10 bpc RGB. */
+			if (drm_dsc_get_bpp_int(dsc) == 8) {
+				u32 last_pclk = line_width % 3;
+				u32 last_ack = ack_required - line_width / 3;
+
+				if (last_ack && last_pclk < 1)
+					extra_width = 1 - last_pclk;
+			}
+
+			timing->width += extra_width;
+			timing->h_back_porch += extra_width;
+		}
 	}
 }
 
@@ -297,6 +316,13 @@ static void dpu_encoder_phys_vid_setup_timing_engine(
 	}
 
 	drm_mode_to_intf_timing_params(phys_enc, &mode, &timing_params);
+	if (timing_params.compression_en)
+		DPU_DEBUG_VIDENC(phys_enc,
+			"DSC timing width=%u xres=%u hbp=%u bytes=%u dto=%u\n",
+			timing_params.width, timing_params.xres,
+			timing_params.h_back_porch,
+			timing_params.dce_bytes_per_line,
+			timing_params.extra_dto_cycles);
 
 	fmt = mdp_get_format(&phys_enc->dpu_kms->base, fmt_fourcc, 0);
 	DPU_DEBUG_VIDENC(phys_enc, "fmt_fourcc 0x%X\n", fmt_fourcc);
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.c
index ac82b69..949fbc4 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.c
@@ -185,10 +185,8 @@ static void dpu_hw_intf_setup_timing_engine(struct dpu_hw_intf *intf,
 	 * For compressed stream, data validity window needs to be adjusted for
 	 * compression ratio and then further halved.
 	 *
-	 * For the compression mode in DP case, the p->width is already
-	 * adjusted in drm_mode_to_intf_timing_params().
 	 */
-	if (p->compression_en && !dp_intf) {
+	if (p->compression_en) {
 		if (p->wide_bus_en)
 			data_width = DIV_ROUND_UP(p->dce_bytes_per_line, 6);
 		else
@@ -197,9 +195,7 @@ static void dpu_hw_intf_setup_timing_engine(struct dpu_hw_intf *intf,
 		data_width = p->width >> 1;
 	}
 
-	/* TODO: handle DSC+DP case, we only handle DSC+DSI case so far */
-	if (p->compression_en && !dp_intf &&
-	    intf->mdss_ver->core_major_ver >= 7)
+	if (p->compression_en && intf->mdss_ver->core_major_ver >= 7)
 		intf_cfg2 |= INTF_CFG2_DCE_DATA_COMPRESS;
 
 	hsync_data_start_x = hsync_start_x;
@@ -219,6 +215,12 @@ static void dpu_hw_intf_setup_timing_engine(struct dpu_hw_intf *intf,
 
 		active_hctl = (active_h_end << 16) | active_h_start;
 		display_hctl = active_hctl;
+		if (p->compression_en) {
+			active_data_hctl =
+				((hsync_start_x + p->extra_dto_cycles) << 16) |
+				hsync_start_x;
+			display_data_hctl = active_data_hctl;
+		}
 
 		intf_cfg |= INTF_CFG_ACTIVE_H_EN | INTF_CFG_ACTIVE_V_EN;
 	}
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.h b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.h
index badd263..5423c17 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.h
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.h
@@ -35,6 +35,7 @@ struct dpu_hw_intf_timing_params {
 
 	bool wide_bus_en;
 	bool compression_en;
+	u32 extra_dto_cycles;	/* for DP only */
 	u32 dce_bytes_per_line;
 };
 
diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.c b/drivers/gpu/drm/msm/dp/dp_ctrl.c
index 59070f3..81bc303 100644
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -404,7 +404,9 @@ static void msm_dp_ctrl_config_ctrl_streams(struct msm_dp_ctrl_private *ctrl,
 	if (msm_dp_panel->msm_dp_mode.out_fmt_is_yuv_420)
 		config |= DP_CONFIGURATION_CTRL_RGB_YUV; /* YUV420 */
 
+	/* DSC output uses the 8 bpc DP configuration depth. */
 	tbd = msm_dp_link_get_test_bits_depth(ctrl->link,
+					      msm_dp_panel->msm_dp_mode.dsc_en ? 24 :
 					      msm_dp_panel->msm_dp_mode.bpp);
 
 	config |= tbd << DP_CONFIGURATION_CTRL_BPC_SHIFT;
@@ -958,7 +960,10 @@ static void _dp_ctrl_calc_tu(struct msm_dp_ctrl_private *ctrl,
 	temp_fp = drm_fixp_div(temp2_fp, tu->pclk_fp);
 	tu->extra_buffer_margin = drm_fixp2int_ceil(temp_fp);
 
-	temp1_fp = drm_fixp_from_fraction(tu->bpp, 8);
+	if (in->compress_ratio == 375 && tu->bpp == 30)
+		temp1_fp = drm_fixp_from_fraction(24, 8);
+	else
+		temp1_fp = drm_fixp_from_fraction(tu->bpp, 8);
 	temp2_fp = drm_fixp_mul(tu->pclk_fp, temp1_fp);
 	temp1_fp = drm_fixp_from_fraction(tu->nlanes, 1);
 	temp2_fp = drm_fixp_div(temp2_fp, temp1_fp);
@@ -1276,11 +1281,11 @@ static void msm_dp_ctrl_calc_tu_parameters(struct msm_dp_ctrl_private *ctrl,
 	in.nlanes = ctrl->link->link_params.num_lanes;
 	in.bpp = panel->msm_dp_mode.bpp;
 	in.pixel_enc = panel->msm_dp_mode.out_fmt_is_yuv_420 ? 420 : 444;
-	in.dsc_en = 0;
+	in.dsc_en = panel->msm_dp_mode.dsc_en;
 	in.async_en = 0;
-	in.fec_en = 0;
-	in.num_of_dsc_slices = 0;
-	in.compress_ratio = 100;
+	in.fec_en = in.dsc_en && panel->fec_capable;
+	in.num_of_dsc_slices = in.dsc_en ? panel->dsc.slice_count : 0;
+	in.compress_ratio = in.dsc_en ? (in.bpp * 100) / 8 : 100;
 
 	_dp_ctrl_calc_tu(ctrl, &in, tu_table);
 }
@@ -1713,9 +1718,18 @@ static int msm_dp_ctrl_setup_main_link(struct msm_dp_ctrl_private *ctrl,
 			int *training_step)
 {
 	int ret = 0;
+	u32 val;
 
 	msm_dp_ctrl_mainlink_enable(ctrl);
 
+	val = msm_dp_read_link(ctrl, REG_DP_MAINLINK_CTRL);
+	val &= ~(DP_MAINLINK_CTRL_FEC_ENABLE | DP_MAINLINK_CTRL_FEC_SEQ_EN |
+		 DP_MAINLINK_CTRL_FEC_FLUSH_EN);
+	msm_dp_write_link(ctrl, REG_DP_MAINLINK_CTRL, val);
+
+	if (panel->fec_capable)
+		drm_dp_dpcd_writeb(ctrl->aux, DP_FEC_CONFIGURATION, DP_FEC_READY);
+
 	if (ctrl->link->sink_request & DP_TEST_LINK_PHY_TEST_PATTERN)
 		return ret;
 
@@ -1730,6 +1744,35 @@ static int msm_dp_ctrl_setup_main_link(struct msm_dp_ctrl_private *ctrl,
 	return ret;
 }
 
+static void msm_dp_ctrl_enable_fec_dsc(struct msm_dp_ctrl_private *ctrl,
+				       struct msm_dp_panel *panel)
+{
+	u32 val;
+	u8 status = 0;
+	int retry;
+
+	if (!panel->fec_capable)
+		return;
+
+	if (panel->msm_dp_mode.dsc_en) {
+		for (retry = 0; retry < 3; retry++) {
+			val = msm_dp_read_link(ctrl, REG_DP_MAINLINK_CTRL);
+			val |= DP_MAINLINK_CTRL_FEC_ENABLE | DP_MAINLINK_CTRL_FEC_SEQ_EN |
+				DP_MAINLINK_CTRL_FEC_FLUSH_EN | DP_MAINLINK_FB_BOUNDARY_SEL;
+			msm_dp_write_link(ctrl, REG_DP_MAINLINK_CTRL, val);
+			usleep_range(900, 1000);
+			if (drm_dp_dpcd_readb(ctrl->aux, DP_FEC_STATUS, &status) == 1 &&
+				(status & DP_FEC_DECODE_EN_DETECTED))
+				break;
+		}
+		drm_dbg_dp(ctrl->drm_dev, "FEC status %#x after %d attempt(s)\n",
+			   status, min(retry + 1, 3));
+	}
+
+	drm_dp_dpcd_writeb(ctrl->aux, DP_DSC_ENABLE,
+			   panel->msm_dp_mode.dsc_en ? 1 : 0);
+}
+
 int msm_dp_ctrl_core_clk_enable(struct msm_dp_ctrl *msm_dp_ctrl)
 {
 	struct msm_dp_ctrl_private *ctrl;
@@ -2609,7 +2652,7 @@ int msm_dp_ctrl_on_stream(struct msm_dp_ctrl *msm_dp_ctrl, struct msm_dp_panel *
 		pixel_rate_orig,
 		panel->msm_dp_mode.out_fmt_is_yuv_420);
 
-	msm_dp_panel_clear_dsc_dto(panel);
+	msm_dp_panel_dsc_hw_config(panel, msm_dp_ctrl->wide_bus_en);
 
 	msm_dp_ctrl_setup_tr_unit(ctrl, panel);
 
@@ -2622,6 +2665,8 @@ int msm_dp_ctrl_on_stream(struct msm_dp_ctrl *msm_dp_ctrl, struct msm_dp_panel *
 	mainlink_ready = msm_dp_ctrl_mainlink_ready(ctrl);
 	drm_dbg_dp(ctrl->drm_dev,
 		"mainlink %s\n", mainlink_ready ? "READY" : "NOT READY");
+	if (mainlink_ready)
+		msm_dp_ctrl_enable_fec_dsc(ctrl, panel);
 
 	return ret;
 }
diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
index cab60f2..431155c 100644
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -788,8 +788,11 @@ enum drm_mode_status msm_dp_display_mode_valid(struct msm_dp *dp,
 	if (!mode_bpp)
 		mode_bpp = default_bpp;
 
-	mode_bpp = msm_dp_panel_get_mode_bpp(msm_dp_display->panel,
-			mode_bpp, link_pclk_khz);
+	if (msm_dp_panel_mode_has_dsc(msm_dp_display->panel, mode, mode_bpp))
+		mode_bpp = 8;
+	else
+		mode_bpp = msm_dp_panel_get_mode_bpp(msm_dp_display->panel,
+					mode_bpp, link_pclk_khz);
 
 	mode_rate_khz = link_pclk_khz * mode_bpp;
 	supported_rate_khz = link_info->num_lanes * link_info->rate * 8;
@@ -800,6 +803,43 @@ enum drm_mode_status msm_dp_display_mode_valid(struct msm_dp *dp,
 	return MODE_OK;
 }
 
+struct drm_dsc_config *msm_dp_get_dsc_config(struct msm_dp *dp)
+{
+	struct msm_dp_display_private *display;
+
+	if (!dp)
+		return NULL;
+
+	display = container_of(dp, struct msm_dp_display_private,
+				msm_dp_display);
+	return msm_dp_panel_get_dsc_config(display->panel);
+}
+
+bool msm_dp_mode_has_dsc(struct msm_dp *dp,
+			 const struct drm_display_mode *mode, u32 bpp)
+{
+	struct msm_dp_display_private *display;
+
+	if (!dp || !mode)
+		return false;
+
+	display = container_of(dp, struct msm_dp_display_private,
+				msm_dp_display);
+	return msm_dp_panel_mode_has_dsc(display->panel, mode, bpp ?: 24);
+}
+
+void msm_dp_display_flush_pps(struct msm_dp *dp)
+{
+	struct msm_dp_display_private *display;
+
+	if (!dp)
+		return;
+
+	display = container_of(dp, struct msm_dp_display_private,
+				msm_dp_display);
+	msm_dp_panel_flush_pps(display->panel);
+}
+
 int msm_dp_display_get_modes(struct msm_dp *dp)
 {
 	struct msm_dp_display_private *msm_dp_display;
@@ -1355,7 +1395,8 @@ bool msm_dp_display_vsc_sdp_supported(const struct msm_dp *msm_dp_display)
 bool msm_dp_needs_periph_flush(const struct msm_dp *msm_dp_display,
 			       const struct drm_display_mode *mode)
 {
-	return msm_dp_display_vsc_sdp_supported(msm_dp_display);
+	return msm_dp_display_vsc_sdp_supported(msm_dp_display) ||
+		!!msm_dp_get_dsc_config((struct msm_dp *)msm_dp_display);
 }
 
 bool msm_dp_wide_bus_available(const struct msm_dp *msm_dp_display)
diff --git a/drivers/gpu/drm/msm/dp/dp_display.h b/drivers/gpu/drm/msm/dp/dp_display.h
index de7ae60..55a537a 100644
--- a/drivers/gpu/drm/msm/dp/dp_display.h
+++ b/drivers/gpu/drm/msm/dp/dp_display.h
@@ -28,6 +28,10 @@ struct msm_dp {
 
 int msm_dp_display_get_modes(struct msm_dp *msm_dp_display);
 bool msm_dp_display_check_video_test(struct msm_dp *msm_dp_display);
+struct drm_dsc_config *msm_dp_get_dsc_config(struct msm_dp *msm_dp_display);
+bool msm_dp_mode_has_dsc(struct msm_dp *msm_dp_display,
+			 const struct drm_display_mode *mode, u32 bpp);
+void msm_dp_display_flush_pps(struct msm_dp *msm_dp_display);
 bool msm_dp_display_vsc_sdp_supported(const struct msm_dp *msm_dp_display);
 int msm_dp_display_get_test_bpp(struct msm_dp *msm_dp_display);
 void msm_dp_display_signal_audio_start(struct msm_dp *msm_dp_display);
diff --git a/drivers/gpu/drm/msm/dp/dp_panel.c b/drivers/gpu/drm/msm/dp/dp_panel.c
index d03415c..cbb9eb9 100644
--- a/drivers/gpu/drm/msm/dp/dp_panel.c
+++ b/drivers/gpu/drm/msm/dp/dp_panel.c
@@ -6,8 +6,10 @@
 #include "dp_panel.h"
 #include "dp_reg.h"
 #include "dp_utils.h"
+#include "../msm_dsc_helper.h"
 
 #include <drm/display/drm_hdmi_helper.h>
+#include <drm/display/drm_dsc_helper.h>
 #include <drm/drm_connector.h>
 #include <drm/drm_edid.h>
 #include <drm/drm_of.h>
@@ -105,6 +107,37 @@ static int msm_dp_panel_read_dpcd(struct msm_dp_panel *msm_dp_panel)
 		return rc;
 
