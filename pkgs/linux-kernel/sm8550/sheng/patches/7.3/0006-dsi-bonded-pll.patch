From: dianqk <dianqk@dianqk.net>
Date: Tue, 29 Sep 2026 00:00:00 +0800
Subject: [PATCH] drm/msm/dsi: scope bonded PLL bias workaround to SM8550

Porting notes: retain the upstream 7.3 PLL reference counting for standalone links. Repeat the bias write only for bonded SM8550 PHYs, following the narrow treatment already used for bonded SM8475. The original broad reapplication was reverted upstream because of a standalone regression.

Original author dates, messages, and trailers: patches/ORIGINS.md.
Source-Commit: https://github.com/ianchb/sm8550-mainline/commit/04ad2e4507e7f2402b541dfcae76da7688fb5610
---
diff --git a/drivers/gpu/drm/msm/dsi/phy/dsi_phy_7nm.c b/drivers/gpu/drm/msm/dsi/phy/dsi_phy_7nm.c
index 5d805a7..3f28a0a 100644
--- a/drivers/gpu/drm/msm/dsi/phy/dsi_phy_7nm.c
+++ b/drivers/gpu/drm/msm/dsi/phy/dsi_phy_7nm.c
@@ -420,17 +420,25 @@ static void dsi_pll_disable_pll_bias(struct dsi_pll_7nm *pll)
 	ndelay(250);
 }
 
+static bool dsi_pll_7nm_needs_sm8550_bonded_bias_fix(struct dsi_pll_7nm *pll)
+{
+	return pll->phy->cfg == &dsi_phy_4nm_8550_cfgs &&
+	       pll->phy->usecase != MSM_DSI_PHY_STANDALONE;
+}
+
 static void dsi_pll_enable_pll_bias(struct dsi_pll_7nm *pll)
 {
 	unsigned long flags;
 	u32 data;
 
 	spin_lock_irqsave(&pll->pll_enable_lock, flags);
-	if (pll->pll_enable_cnt++) {
+	if (pll->pll_enable_cnt++ &&
+	    !dsi_pll_7nm_needs_sm8550_bonded_bias_fix(pll)) {
 		spin_unlock_irqrestore(&pll->pll_enable_lock, flags);
 		WARN_ON(pll->pll_enable_cnt == INT_MAX);
 		return;
 	}
+	WARN_ON(pll->pll_enable_cnt == INT_MAX);
 
 	data = readl(pll->phy->base + REG_DSI_7nm_PHY_CMN_CTRL_0);
 	data |= DSI_7nm_PHY_CMN_CTRL_0_PLL_SHUTDOWNB;
@@ -1091,7 +1099,8 @@ static int dsi_7nm_phy_enable(struct msm_dsi_phy *phy,
 	}
 
 	spin_lock_irqsave(&pll->pll_enable_lock, flags);
-	pll->pll_enable_cnt = 1;
+	if (!dsi_pll_7nm_needs_sm8550_bonded_bias_fix(pll))
+		pll->pll_enable_cnt = 1;
 	/* de-assert digital and pll power down */
 	data = DSI_7nm_PHY_CMN_CTRL_0_DIGTOP_PWRDN_B |
 	       DSI_7nm_PHY_CMN_CTRL_0_PLL_SHUTDOWNB;
