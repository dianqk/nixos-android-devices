From: dianqk <dianqk@dianqk.net>
Date: Tue, 29 Sep 2026 00:00:00 +0800
Subject: [PATCH] media: wire Sheng camera sensors, focus and activity LED

Porting notes: Apply the fork camera integration as hunks on 7.3. Extend the existing lens schema only for GT9764 and its additional properties; preserve the DW9768/GT9769 AAC timing limit. Keep activity LED handling because Sheng board sensors explicitly use the shared activity LED. Limit custom focus stepping to GT9764, preserve upstream DW9768/GT9769 movement, and finish at the exact requested focus.

Original author dates, messages, and trailers: patches/ORIGINS.md.
Source-Commit: https://github.com/ianchb/sm8550-mainline/commit/cbe4cd84372fa2040153885fa73d3e4aa30c6385
Source-Commit: https://github.com/ianchb/sm8550-mainline/commit/43f26d07947b0ab05553561e850d6a916ad80908
Source-Commit: https://github.com/ianchb/sm8550-mainline/commit/1acf0452e7e24f686d5695b62ca1d366c9369519
Source-Commit: https://github.com/ianchb/sm8550-mainline/commit/db6fc1a0862887c53e0b14c3f73056a5b11dc695
Source-Commit: https://github.com/ianchb/sm8550-mainline/commit/95d63f921e24c5a4b21b31fccbf9e9c390065ea8
Source-Commit: https://github.com/ianchb/sm8550-mainline/commit/b230434fb3ffc4c6d27c1b32585669628a6145a2
---
diff --git a/Documentation/devicetree/bindings/media/i2c/dongwoon,dw9768.yaml b/Documentation/devicetree/bindings/media/i2c/dongwoon,dw9768.yaml
index a0855d3..eead518 100644
--- a/Documentation/devicetree/bindings/media/i2c/dongwoon,dw9768.yaml
+++ b/Documentation/devicetree/bindings/media/i2c/dongwoon,dw9768.yaml
@@ -22,6 +22,7 @@ properties:
   compatible:
     enum:
       - dongwoon,dw9768 # for DW9768 VCM
+      - giantec,gt9764  # for GT9764 VCM
       - giantec,gt9769  # for GT9769 VCM
 
   reg:
@@ -53,7 +54,7 @@ properties:
     $ref: /schemas/types.yaml#/definitions/uint32
     default: 0x20
     minimum: 0x00
-    maximum: 0x3f
+    maximum: 0xff
 
   dongwoon,clock-presc:
     description:
@@ -69,6 +70,26 @@ properties:
       - 5    #  Dividing Rate -  4
     default: 1
 
+  dongwoon,initial-focus:
+    description: Initial focus position used when powering up and parking the lens.
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 1023
+
+  dongwoon,move-delay-us:
+    description: Delay in microseconds between focus position steps.
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          not:
+            contains:
+              const: giantec,gt9764
+    then:
+      properties:
+        dongwoon,aac-timing:
+          maximum: 0x3f
+
 required:
   - compatible
   - reg
diff --git a/Documentation/devicetree/bindings/media/video-interface-devices.yaml b/Documentation/devicetree/bindings/media/video-interface-devices.yaml
index a81d2a1..1c6ac70 100644
--- a/Documentation/devicetree/bindings/media/video-interface-devices.yaml
+++ b/Documentation/devicetree/bindings/media/video-interface-devices.yaml
@@ -18,13 +18,22 @@ properties:
       driver device node.
 
   leds:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
     minItems: 1
     maxItems: 1
 
   led-names:
     enum:
+      - activity
       - privacy
 
+  activity-led-brightness:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    minimum: 1
+    description:
+      Brightness used for the activity LED while the video device is
+      streaming. The LED remains available for userspace control while active.
+
   lens-focus:
     $ref: /schemas/types.yaml#/definitions/phandle
     description:
@@ -405,6 +414,18 @@ properties:
         # attached in a way that allows it to move freely.
       - 2
 
+allOf:
+  - if:
+      required:
+        - activity-led-brightness
+    then:
+      properties:
+        led-names:
+          const: activity
+      required:
+        - leds
+        - led-names
+
 additionalProperties: true
 
 ...
diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 5c52007..a7eeefc 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -425,6 +425,16 @@ config VIDEO_OV02A10
 	  To compile this driver as a module, choose M here: the
 	  module will be called ov02a10.
 
+config VIDEO_OV02B1B
+	tristate "OmniVision OV02B1B sensor support"
+	select V4L2_CCI_I2C
+	help
