 			power-domains = <&cpu_pd4>;
 			power-domain-names = "psci";
@@ -208,6 +244,9 @@ l2_400: l2-cache {
 				compatible = "cache";
 				cache-level = <2>;
 				cache-unified;
+				cache-size = <0x80000>;
+				cache-line-size = <64>;
+				cache-sets = <1024>;
 				next-level-cache = <&l3_0>;
 			};
