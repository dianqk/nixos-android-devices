From: dianqk <dianqk@dianqk.net>
Date: Tue, 29 Sep 2026 00:00:00 +0800
Subject: [PATCH] arm64: dts: qcom: sheng: use boolean CS35L43 VPBR properties

The shared CS35L43 driver and binding use a boolean VPBR property.
Driver provenance is retained in patches/ORIGINS.md and the shared patch.

---
diff --git a/arch/arm64/boot/dts/qcom/sm8550-xiaomi-sheng.dts b/arch/arm64/boot/dts/qcom/sm8550-xiaomi-sheng.dts
--- a/arch/arm64/boot/dts/qcom/sm8550-xiaomi-sheng.dts
+++ b/arch/arm64/boot/dts/qcom/sm8550-xiaomi-sheng.dts
@@ -1062,7 +1062,7 @@
 		cirrus,vpbr-atk-rate = <0>;
 		cirrus,vpbr-wait = <0>;
 		cirrus,vpbr-rel-rate = <0>;
-		cirrus,vpbr-enable = <1>;
+		cirrus,vpbr-enable;
 		cirrus,gpio2-src-sel = <4>;
 		cirrus,asp-sdout-hiz = <3>;
 		cirrus,bst-ipk-ma = <4000>;
@@ -1083,7 +1083,7 @@
 		cirrus,vpbr-atk-rate = <0>;
 		cirrus,vpbr-wait = <0>;
 		cirrus,vpbr-rel-rate = <0>;
-		cirrus,vpbr-enable = <1>;
+		cirrus,vpbr-enable;
 		cirrus,gpio2-src-sel = <4>;
 		cirrus,asp-sdout-hiz = <3>;
 		cirrus,bst-ipk-ma = <4000>;
@@ -1104,7 +1104,7 @@
 		cirrus,vpbr-atk-rate = <0>;
 		cirrus,vpbr-wait = <0>;
