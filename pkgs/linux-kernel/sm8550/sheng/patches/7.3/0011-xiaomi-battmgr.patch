+#define XM_BATT_AUTHENTIC			0x03
+#define XM_BATT_REAL_TYPE			0x07
+#define XM_BATT_VERIFY_PROCESS			0x0c
+#define XM_BATT_VDM_CMD_CHARGER_VERSION		0x0d
