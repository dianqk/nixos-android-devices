Subject: [PATCH] ASoC: count runtime components correctly

Allocate space for the components present in a runtime, including multi-codec links.

diff --git a/sound/soc/soc-core.c b/sound/soc/soc-core.c
--- a/sound/soc/soc-core.c
+++ b/sound/soc/soc-core.c
@@ -536,6 +536,9 @@
 		device_unregister(dev);
 		return NULL;
 	}
+
+	/* The flex allocator initializes the count to capacity, not occupancy. */
+	rtd->num_components = 0;
 
 	rtd->dev = dev;
 	INIT_LIST_HEAD(&rtd->list);
