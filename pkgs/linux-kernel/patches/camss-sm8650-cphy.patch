@@ -1312,8 +1537,16 @@ static void csiphy_lanes_enable(struct csiphy_device *csiphy,
 			regs->lane_regs = &lane_regs_sm8650[0];
 			regs->lane_array_size = ARRAY_SIZE(lane_regs_sm8650);
 		} else if (c->phy_cfg == V4L2_MBUS_CSI2_CPHY) {
-			regs->lane_regs = NULL;
-			regs->lane_array_size = 0;
+			/* The C-PHY symbol rate is twice the link frequency. */
+			if (link_freq * 2 <= 2500000000LL) {
+				regs->lane_regs = &lane_regs_sm8650_3ph_2p5gsps[0];
+				regs->lane_array_size =
+					ARRAY_SIZE(lane_regs_sm8650_3ph_2p5gsps);
+			} else {
+				regs->lane_regs = &lane_regs_sm8650_3ph_3p5gsps[0];
+				regs->lane_array_size =
