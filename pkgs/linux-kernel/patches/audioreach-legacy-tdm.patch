From: Yoni Yang <yoni980807@gmail.com>
Date: Tue, 29 Sep 2026 17:47:15 +0000
Subject: [PATCH] ASoC: qcom: support the legacy AudioReach TDM endpoint

Selected audio protocol hunks from:
https://github.com/yoni13/armada-houji/blob/f5c689be6e603b259a5a85774d78c9cbd7cfefa4/ports/houji/patches/0011-houji-audioreach-tdm.patch

Original containing commit message:
Add experimental Xiaomi 14 port with stock ABL boot

Build Houji kernel, userspace and internal boot images from pinned public inputs and bundled stock firmware. Include the guarded installer, device integrations, regression tests and build/flash documentation. Hide the incompatible generic installer on Houji.

Local changes: retain 7.3's existing DAI slot/clock lifetime handling, map its
slot_mask/nslots_per_frame/slot_width fields to the legacy DSP payload, and
reject slot masks outside the frame. Do not import Houji machine routing,
WCD939x ADC or capture-channel changes. Add S32_LE playback capability and
hw_params handling for Aurora's end-to-end 32-bit TDM path. Aurora uses this endpoint
with the stock Android 14 ADSP, distinct from the newer AUDIO_IF API.
---
diff --git a/include/dt-bindings/sound/qcom,q6dsp-lpass-ports.h b/include/dt-bindings/sound/qcom,q6dsp-lpass-ports.h
index 3a99703db..043eed2d2 100644
--- a/include/dt-bindings/sound/qcom,q6dsp-lpass-ports.h
+++ b/include/dt-bindings/sound/qcom,q6dsp-lpass-ports.h
@@ -275,5 +275,6 @@
 #define LPASS_CLK_ATTRIBUTE_COUPLE_NO		0x1
 #define LPASS_CLK_ATTRIBUTE_COUPLE_DIVIDEND	0x2
 #define LPASS_CLK_ATTRIBUTE_COUPLE_DIVISOR	0x3
+#define LPASS_CLK_ATTRIBUTE_INVERT_COUPLE_NO	0x4
 
 #endif /* __DT_BINDINGS_Q6_AUDIO_PORTS_H__ */
diff --git a/sound/soc/qcom/qdsp6/audioreach.c b/sound/soc/qcom/qdsp6/audioreach.c
index cce0ad31f..fe425304d 100644
--- a/sound/soc/qcom/qdsp6/audioreach.c
+++ b/sound/soc/qcom/qdsp6/audioreach.c
@@ -145,6 +145,25 @@ struct apm_sh_module_media_fmt_cmd {
 
 #define APM_PCM_OUT_FMT_CFG_PSIZE(p, n) ALIGN(struct_size(p, channel_mapping, n), 4)
 
+/* Qualcomm pcm_tdm_api.h: PARAM_ID_TDM_INTF_CFG (28-byte payload). */
+#define PARAM_ID_TDM_INTF_CFG 0x0800101B
+#define PARAM_ID_TDM_LANE_CFG 0x0800106A
+#define PARAM_ID_HW_INTF_CLK_CFG 0x0800113C
+struct apm_tdm_module_intf_cfg {
+	struct apm_module_param_data param_data;
+	u32 lpaif_type;
+	u32 intf_idx;
+	u16 sync_src;
+	u16 data_out_enable;
+	u32 slot_mask;
+	u16 slots_per_frame;
+	u16 slot_width;
+	u16 sync_mode;
+	u16 invert_sync;
+	u16 sync_data_delay;
+	u16 reserved;
+} __packed;
+
 struct apm_i2s_module_intf_cfg {
 	struct apm_module_param_data param_data;
 	struct param_id_i2s_intf_cfg cfg;
@@ -1141,6 +1160,106 @@ static int audioreach_audio_if_set_media_format(struct q6apm_graph *graph,
 	return q6apm_send_cmd_sync(graph->apm, pkt, 0);
 }
 
+static int audioreach_tdm_set_media_format(struct q6apm_graph *graph,
+					 const struct audioreach_module *module,
+					 const struct audioreach_module_config *cfg)
+{
+	struct apm_tdm_module_intf_cfg *intf;
+	struct apm_module_hw_ep_mf_cfg *hw;
+	struct apm_module_frame_size_factor_cfg *fs;
+	struct apm_module_param_data *param;
+	u32 *clock_cfg;
+	u16 *lane_cfg;
+	int intf_size = ALIGN(sizeof(*intf), 8);
+	int lane_size = ALIGN(APM_MODULE_PARAM_DATA_SIZE + 4, 8);
+	int clock_size = APM_MODULE_PARAM_DATA_SIZE + 16;
+	int size = intf_size + APM_HW_EP_CFG_PSIZE + APM_FS_CFG_PSIZE + lane_size + clock_size;
+	u16 sync_src, sync_mode, delay, invert;
+	u32 clock_attr = 0;
+	void *p;
+
+	if (!cfg->nslots_per_frame || cfg->nslots_per_frame > 32 ||
+	    !cfg->slot_mask || (cfg->nslots_per_frame < 32 &&
+	    cfg->slot_mask >> cfg->nslots_per_frame) ||
+	    hweight32(cfg->slot_mask) != cfg->num_channels ||
+	    cfg->bit_width > cfg->slot_width || module->sd_line_idx >= 16)
+		return -EINVAL;
+
+	switch (cfg->fmt & SND_SOC_DAIFMT_CLOCK_PROVIDER_MASK) {
+	case SND_SOC_DAIFMT_BP_FP: sync_src = 1; break;
+	case SND_SOC_DAIFMT_BC_FC: sync_src = 0; break;
+	default: return -EINVAL;
+	}
+	switch (cfg->fmt & SND_SOC_DAIFMT_FORMAT_MASK) {
+	case SND_SOC_DAIFMT_I2S: sync_mode = 1; delay = 1; break;
+	case SND_SOC_DAIFMT_DSP_A: sync_mode = 0; delay = 1; break;
+	case SND_SOC_DAIFMT_DSP_B: sync_mode = 0; delay = 0; break;
+	default: return -EINVAL;
+	}
+	switch (cfg->fmt & SND_SOC_DAIFMT_INV_MASK) {
+	case SND_SOC_DAIFMT_NB_NF: invert = 0; break;
+	case SND_SOC_DAIFMT_NB_IF: invert = 1; break;
+	case SND_SOC_DAIFMT_IB_NF: invert = 0; clock_attr = 4; break;
+	case SND_SOC_DAIFMT_IB_IF: invert = 1; clock_attr = 4; break;
+	default: return -EINVAL;
+	}
+
+	struct gpr_pkt *pkt __free(kfree) = audioreach_alloc_apm_cmd_pkt(size, APM_CMD_SET_CFG, 0);
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
+	p = (void *)pkt + GPR_HDR_SIZE + APM_CMD_HDR_SIZE;
+	intf = p;
+	intf->param_data.module_instance_id = module->instance_id;
+	intf->param_data.param_id = PARAM_ID_TDM_INTF_CFG;
+	intf->param_data.param_size = sizeof(*intf) - APM_MODULE_PARAM_DATA_SIZE;
+	intf->lpaif_type = module->hw_interface_type;
+	intf->intf_idx = module->hw_interface_idx;
+	intf->sync_src = sync_src;
+	intf->data_out_enable = 1;
+	intf->slot_mask = cfg->slot_mask;
+	intf->slots_per_frame = cfg->nslots_per_frame;
+	intf->slot_width = cfg->slot_width;
+	intf->sync_mode = sync_mode;
+	intf->invert_sync = invert;
+	intf->sync_data_delay = delay;
+
+	p += intf_size;
+	hw = p;
+	hw->param_data.module_instance_id = module->instance_id;
+	hw->param_data.param_id = PARAM_ID_HW_EP_MF_CFG;
+	hw->param_data.param_size = sizeof(*hw) - APM_MODULE_PARAM_DATA_SIZE;
+	hw->mf.sample_rate = cfg->sample_rate;
+	hw->mf.bit_width = cfg->bit_width;
+	hw->mf.num_channels = cfg->num_channels;
+	hw->mf.data_format = module->data_format;
+
+	p += APM_HW_EP_CFG_PSIZE;
+	fs = p;
+	fs->param_data.module_instance_id = module->instance_id;
+	fs->param_data.param_id = PARAM_ID_HW_EP_FRAME_SIZE_FACTOR;
+	fs->param_data.param_size = sizeof(fs->frame_size_factor);
+	fs->frame_size_factor = 1;
+
+	p += APM_FS_CFG_PSIZE;
+	param = p;
+	param->module_instance_id = module->instance_id;
+	param->param_id = PARAM_ID_TDM_LANE_CFG;
+	param->param_size = 4;
+	lane_cfg = p + APM_MODULE_PARAM_DATA_SIZE;
+	lane_cfg[0] = BIT(module->sd_line_idx);
+
+	p += lane_size;
+	param = p;
+	param->module_instance_id = module->instance_id;
+	param->param_id = PARAM_ID_HW_INTF_CLK_CFG;
+	param->param_size = 16;
+	clock_cfg = p + APM_MODULE_PARAM_DATA_SIZE;
+	/* ID/frequency/root zero: derive the interface's clock automatically. */
+	clock_cfg[2] = clock_attr;
+
+	return q6apm_send_cmd_sync(graph->apm, pkt, 0);
+}
+
 static int audioreach_logging_set_media_format(struct q6apm_graph *graph,
 					       const struct audioreach_module *module)
 {
@@ -1489,6 +1608,9 @@ int audioreach_set_media_format(struct q6apm_graph *graph,
 	case  MODULE_ID_SMECNS_V2:
 		rc = audioreach_set_module_config(graph, module, cfg);
 		break;
+	case MODULE_ID_TDM_SINK:
+	case MODULE_ID_TDM_SOURCE:
+		return audioreach_tdm_set_media_format(graph, module, cfg);
 	case MODULE_ID_I2S_SOURCE:
 	case MODULE_ID_I2S_SINK:
 		rc = audioreach_i2s_set_media_format(graph, module, cfg);
diff --git a/sound/soc/qcom/qdsp6/audioreach.h b/sound/soc/qcom/qdsp6/audioreach.h
index 35541b2d8..d8f6128e9 100644
--- a/sound/soc/qcom/qdsp6/audioreach.h
+++ b/sound/soc/qcom/qdsp6/audioreach.h
@@ -22,6 +22,8 @@ struct q6apm_graph;
 #define MODULE_ID_PLACEHOLDER_DECODER	0x07001009
 #define MODULE_ID_I2S_SINK		0x0700100A
 #define MODULE_ID_I2S_SOURCE		0x0700100B
+#define MODULE_ID_TDM_SINK		0x0700100E
+#define MODULE_ID_TDM_SOURCE		0x0700100F
 #define MODULE_ID_SAL			0x07001010
 #define MODULE_ID_MFC			0x07001015
 #define MODULE_ID_DATA_LOGGING		0x0700101A
diff --git a/sound/soc/qcom/qdsp6/q6dsp-lpass-clocks.c b/sound/soc/qcom/qdsp6/q6dsp-lpass-clocks.c
index ab7d20580..44859ddee 100644
--- a/sound/soc/qcom/qdsp6/q6dsp-lpass-clocks.c
+++ b/sound/soc/qcom/qdsp6/q6dsp-lpass-clocks.c
@@ -113,7 +113,7 @@ static struct clk_hw *q6dsp_of_clk_hw_get(struct of_phandle_args *clkspec,
 	unsigned int idx = clkspec->args[0];
 	unsigned int attr = clkspec->args[1];
 
-	if (idx >= Q6DSP_MAX_CLK_ID || attr > LPASS_CLK_ATTRIBUTE_COUPLE_DIVISOR) {
+	if (idx >= Q6DSP_MAX_CLK_ID || attr > LPASS_CLK_ATTRIBUTE_INVERT_COUPLE_NO) {
 		dev_err(cc->dev, "Invalid clk specifier (%d, %d)\n", idx, attr);
 		return ERR_PTR(-EINVAL);
 	}
diff --git a/sound/soc/qcom/qdsp6/q6prm-clocks.c b/sound/soc/qcom/qdsp6/q6prm-clocks.c
index b4f9abbe0..a907c91b0 100644
--- a/sound/soc/qcom/qdsp6/q6prm-clocks.c
+++ b/sound/soc/qcom/qdsp6/q6prm-clocks.c
@@ -19,6 +19,7 @@
 	}
 
 static const struct q6dsp_clk_init q6prm_clks[] = {
+	Q6PRM_CLK(LPASS_CLK_ID_SEC_TDM_IBIT),
 	Q6PRM_CLK(LPASS_CLK_ID_PRI_MI2S_IBIT),
 	Q6PRM_CLK(LPASS_CLK_ID_PRI_MI2S_EBIT),
 	Q6PRM_CLK(LPASS_CLK_ID_SEC_MI2S_IBIT),
diff --git a/sound/soc/qcom/qdsp6/q6prm.h b/sound/soc/qcom/qdsp6/q6prm.h
index cf619ef65..f36ac6871 100644
--- a/sound/soc/qcom/qdsp6/q6prm.h
+++ b/sound/soc/qcom/qdsp6/q6prm.h
@@ -66,6 +66,8 @@
 /* Clock ID for MCLK5 */
 #define Q6PRM_LPASS_CLK_ID_MCLK_5                                 0x304
 
+#define Q6PRM_LPASS_CLK_ID_SEC_TDM_IBIT 0x202
+
 #define Q6PRM_LPASS_CLK_ID_WSA_CORE_MCLK			0x305
 #define Q6PRM_LPASS_CLK_ID_WSA_CORE_NPL_MCLK			0x306
 
diff --git a/sound/soc/qcom/qdsp6/topology.c b/sound/soc/qcom/qdsp6/topology.c
index faafbc5c0..066d59c2d 100644
--- a/sound/soc/qcom/qdsp6/topology.c
+++ b/sound/soc/qcom/qdsp6/topology.c
@@ -899,6 +899,8 @@ static int audioreach_widget_load_buffer(struct snd_soc_component *component,
 	case MODULE_ID_DATA_LOGGING:
 		audioreach_widget_log_module_load(mod, mod_array);
 		break;
+	case MODULE_ID_TDM_SINK:
+	case MODULE_ID_TDM_SOURCE:
 	case MODULE_ID_I2S_SINK:
 	case MODULE_ID_I2S_SOURCE:
 		audioreach_widget_i2s_module_load(mod, mod_array);

diff --git a/sound/soc/qcom/qdsp6/q6apm-dai.c b/sound/soc/qcom/qdsp6/q6apm-dai.c
index 033197bdd..346b16bc6 100644
--- a/sound/soc/qcom/qdsp6/q6apm-dai.c
+++ b/sound/soc/qcom/qdsp6/q6apm-dai.c
@@ -113,7 +113,8 @@ static const struct snd_pcm_hardware q6apm_dai_hardware_playback = {
 				 SNDRV_PCM_INFO_PAUSE | SNDRV_PCM_INFO_RESUME |
 				 SNDRV_PCM_INFO_NO_REWINDS | SNDRV_PCM_INFO_SYNC_APPLPTR |
 				 SNDRV_PCM_INFO_BATCH),
-	.formats =              (SNDRV_PCM_FMTBIT_S16_LE | SNDRV_PCM_FMTBIT_S24_LE),
+	.formats =              (SNDRV_PCM_FMTBIT_S16_LE | SNDRV_PCM_FMTBIT_S24_LE |
+				 SNDRV_PCM_FMTBIT_S32_LE),
 	.rates =                SNDRV_PCM_RATE_8000_192000,
 	.rate_min =             8000,
 	.rate_max =             192000,
@@ -522,6 +523,9 @@ static int q6apm_dai_hw_params(struct snd_soc_component *component,
 	case SNDRV_PCM_FORMAT_S24_LE:
 		prtd->bits_per_sample = 24;
 		break;
+	case SNDRV_PCM_FORMAT_S32_LE:
+		prtd->bits_per_sample = 32;
+		break;
 	default:
 		return -EINVAL;
 	}
