+/* Unbound peripherals have no initialized clock-stop capabilities. */
+static bool qcom_swrm_needs_reset(struct qcom_swrm_ctrl *ctrl)
+{
+	struct sdw_slave *slave;
+	bool reset = false;
+
+	mutex_lock(&ctrl->bus.bus_lock);
+	list_for_each_entry(slave, &ctrl->bus.slaves, node) {
+		if (!slave->probed || slave->prop.clk_stop_mode1) {
+			reset = true;
+			break;
+		}
+	}
+	mutex_unlock(&ctrl->bus.bus_lock);
+
+	return reset;
+}
+
+static bool qcom_swrm_slave_present(u32 status, unsigned int dev_num)
+{
+	u32 state = (status >> (dev_num * SWRM_MCP_SLV_STATUS_SZ)) &
+		    SWRM_MCP_SLV_STATUS_MASK;
+
+	return state == SDW_SLAVE_ATTACHED || state == SDW_SLAVE_ALERT;
+}
+
+static bool qcom_swrm_context_lost(struct qcom_swrm_ctrl *ctrl, u32 status)
+{
+	struct sdw_slave *slave;
+	bool lost = false;
+
+	mutex_lock(&ctrl->bus.bus_lock);
+	list_for_each_entry(slave, &ctrl->bus.slaves, node) {
+		if (!slave->probed || !slave->dev_num)
+			continue;
+		if (qcom_swrm_slave_present(ctrl->suspended_slave_status,
+					  slave->dev_num) &&
+		    !qcom_swrm_slave_present(status, slave->dev_num)) {
+			lost = true;
+			break;
+		}
+	}
+	mutex_unlock(&ctrl->bus.bus_lock);
+
+	return lost;
+}
+
+static bool qcom_swrm_peripherals_ready(struct qcom_swrm_ctrl *ctrl)
+{
+	struct sdw_slave *slave;
+	u32 status;
+	bool ready = true;
+
+	/* Do not update slave_status here: the IRQ must observe the change. */
+	ctrl->reg_read(ctrl, SWRM_MCP_SLV_STATUS, &status);
+	mutex_lock(&ctrl->bus.bus_lock);
+	list_for_each_entry(slave, &ctrl->bus.slaves, node) {
+		if (!slave->probed)
+			continue;
+		if (!slave->dev_num ||
+		    !qcom_swrm_slave_present(status, slave->dev_num)) {
+			ready = false;
+			break;
+		}
+	}
+	mutex_unlock(&ctrl->bus.bus_lock);
+
+	return ready;
+}
+
+static int qcom_swrm_reenumerate(struct qcom_swrm_ctrl *ctrl)
+{
+	bool ready;
+	int ret;
+
+	sdw_clear_slave_status(&ctrl->bus, SDW_UNATTACH_REQUEST_MASTER_RESET);
+	reinit_completion(&ctrl->enumeration);
+	ctrl->reg_write(ctrl, SWRM_COMP_SW_RESET, 0x01);
+	if (ctrl->version < SWRM_VERSION_2_0_0)
+		ctrl->reg_write(ctrl, SWRM_COMP_SW_RESET, 0x01);
+	usleep_range(100, 105);
+	/* The component reset alone does not reset peripheral protocol state. */
+	if (ctrl->version < SWRM_VERSION_2_0_0)
+		ctrl->reg_write(ctrl, SWRM_MCP_BUS_CTRL, SWRM_MCP_BUS_RESET);
+	qcom_swrm_init(ctrl);
+	usleep_range(100, 105);
+	if (!swrm_wait_for_frame_gen_enabled(ctrl))
+		return -ETIMEDOUT;
+
+	if (!wait_for_completion_timeout(&ctrl->enumeration,
+					 msecs_to_jiffies(TIMEOUT_MS)))
+		return -ETIMEDOUT;
+
+	ret = read_poll_timeout(qcom_swrm_peripherals_ready, ready, ready,
+				1000, TIMEOUT_MS * 1000, false, ctrl);
+	if (ret)
+		return ret;
+
+	/* Processing alerts here could wait for this very resume callback. */
+	schedule_work(&ctrl->status_work);
+	return 0;
+}
