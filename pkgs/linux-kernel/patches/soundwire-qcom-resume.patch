+
+/* An enumerated peripheral may already have a pending SCP alert. */
+static void qcom_swrm_process_status(struct qcom_swrm_ctrl *ctrl,
+				   enum sdw_slave_status *status)
+{
+	enum sdw_slave_status initial[SDW_MAX_DEVICES + 1];
+	struct sdw_slave *slave;
+	bool attach = false;
+
+	memcpy(initial, status, sizeof(initial));
+	mutex_lock(&ctrl->bus.bus_lock);
+	list_for_each_entry(slave, &ctrl->bus.slaves, node) {
+		if (slave->dev_num && slave->status == SDW_SLAVE_UNATTACHED &&
+		    status[slave->dev_num] == SDW_SLAVE_ALERT) {
+			initial[slave->dev_num] = SDW_SLAVE_ATTACHED;
+			attach = true;
+		}
+	}
+	mutex_unlock(&ctrl->bus.bus_lock);
+	if (attach)
+		sdw_handle_slave_status(&ctrl->bus, initial);
+	sdw_handle_slave_status(&ctrl->bus, status);
+}
+
+/* Slave alert handling may resume a peripheral and thus its manager. */
+static void qcom_swrm_handle_status(struct qcom_swrm_ctrl *ctrl)
+{
+	if (pm_runtime_enabled(ctrl->dev) && !pm_runtime_active(ctrl->dev)) {
+		schedule_work(&ctrl->status_work);
+		return;
+	}
+
+	mutex_lock(&ctrl->status_lock);
+	qcom_swrm_process_status(ctrl, ctrl->status);
+	mutex_unlock(&ctrl->status_lock);
+}
+
+static void qcom_swrm_status_work(struct work_struct *work)
+{
+	struct qcom_swrm_ctrl *ctrl = container_of(work, struct qcom_swrm_ctrl,
+						status_work);
+	enum sdw_slave_status status[SDW_MAX_DEVICES + 1];
+	u32 value;
+	int i, ret;
+
+	/* Wait outside the resume callback until the manager is fully active. */
+	ret = pm_runtime_resume_and_get(ctrl->dev);
+	if (ret < 0)
+		return;
+
+	mutex_lock(&ctrl->status_lock);
+	ctrl->reg_read(ctrl, SWRM_MCP_SLV_STATUS, &value);
+	for (i = 0; i <= SDW_MAX_DEVICES; i++)
+		status[i] = (value >> (i * SWRM_MCP_SLV_STATUS_SZ)) &
+			    SWRM_MCP_SLV_STATUS_MASK;
+	/* Do not consume the IRQ handler's cached enumeration state. */
+	qcom_swrm_process_status(ctrl, status);
+	mutex_unlock(&ctrl->status_lock);
+	pm_runtime_mark_last_busy(ctrl->dev);
+	pm_runtime_put_autosuspend(ctrl->dev);
 }
 
