+static int cs35l43_get_fs_mon_config_index(int freq)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(cs35l43_fs_mon); i++) {
+		if (cs35l43_fs_mon[i].freq == freq)
+			return i;
+	}
+
+	return -EINVAL;
+}
