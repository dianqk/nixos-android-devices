From: dianqk <dianqk@dianqk.net>
Date: Tue, 29 Sep 2026 00:00:00 +0800
Subject: [PATCH] ASoC: port CS35L43 amplifier codec

Porting notes: Add the fork codec files and apply narrow 7.3 cs_dsp, Kconfig, and Makefile hunks. Convert the fork text binding to a 7.3 YAML schema for the implemented properties. Board-specific nodes are separate.

Original author dates, messages, and trailers: ../sm8550/sheng/patches/ORIGINS.md.
Source-Commit: https://github.com/ianchb/sm8550-mainline/commit/b4fb5849f227f0b0856cee9573a8d47cfcd1f545
Source-Commit: https://github.com/ianchb/sm8550-mainline/commit/66828741c83c2929b68f57fce768a82382adc923
---
diff --git a/Documentation/devicetree/bindings/sound/cirrus,cs35l43.yaml b/Documentation/devicetree/bindings/sound/cirrus,cs35l43.yaml
new file mode 100644
index 0000000..5ab0c18
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/cirrus,cs35l43.yaml
@@ -0,0 +1,139 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/cirrus,cs35l43.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Cirrus Logic CS35L43 speaker amplifier
+
+maintainers:
+  - map220v <map220v300@gmail.com>
+
+allOf:
+  - $ref: dai-common.yaml#
+
+properties:
+  compatible:
+    const: cirrus,cs35l43
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  reset-gpios:
+    maxItems: 1
+
+  '#sound-dai-cells':
+    const: 0
+
+  sound-name-prefix:
+    $ref: /schemas/types.yaml#/definitions/string
+
+  VA-supply: true
+  VP-supply: true
+
+  cirrus,dsp-part-name:
+    description: DSP firmware part name for this amplifier.
+    $ref: /schemas/types.yaml#/definitions/string
+
+  cirrus,asp-sdout-hiz:
+    description: ASP serial output high impedance mode.
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 3
+
+  cirrus,boost-ctl-millivolt:
+    description: Boost converter output voltage in millivolts.
+    $ref: /schemas/types.yaml#/definitions/uint32
+    minimum: 2550
+    maximum: 11000
+
+  cirrus,bst-ipk-ma:
+    description: Boost converter peak current limit in milliamps.
+    $ref: /schemas/types.yaml#/definitions/uint32
+    minimum: 1600
+    maximum: 4500
+
+  cirrus,classh-disable:
+    description: Disable Class H tracking.
+    type: boolean
+
+  cirrus,low-pwr-mode-standby:
+    description: Use standby as the low power mode.
+    type: boolean
+
+  cirrus,dsp-noise-gate-enable:
+    description: Enable the DSP noise gate.
+    type: boolean
+
+  cirrus,gpio1-output-enable:
+    description: Enable GPIO1 as an output.
+    type: boolean
+
+  cirrus,gpio2-output-enable:
+    description: Enable GPIO2 as an output.
+    type: boolean
+
+  cirrus,hw-noise-gate-select:
+    description: Hardware noise gate source selection bit mask.
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+  cirrus,hw-noise-gate-delay:
+    description: Hardware noise gate activation delay selector.
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+  cirrus,hw-noise-gate-threshold:
+    description: Hardware noise gate threshold selector.
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+  cirrus,dsp-noise-gate-threshold:
+    description: DSP noise gate threshold selector.
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+  cirrus,dsp-noise-gate-delay:
+    description: DSP noise gate activation delay selector.
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+  cirrus,gpio1-src-sel:
+    description: GPIO1 source selector.
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+  cirrus,gpio2-src-sel:
+    description: GPIO2 source selector.
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+  cirrus,vpbr-enable:
+    description: Enable VP brownout prevention.
+    type: boolean
+
+  cirrus,vpbr-rel-rate:
+    description: Brownout attenuation release rate selector.
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+  cirrus,vpbr-wait:
+    description: Brownout attenuation release wait selector.
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+  cirrus,vpbr-atk-rate:
+    description: Brownout attenuation attack rate selector.
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+  cirrus,vpbr-atk-vol:
+    description: Brownout attenuation attack step selector.
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+  cirrus,vpbr-max-att:
+    description: Maximum brownout attenuation selector.
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+  cirrus,vpbr-thld:
+    description: VP brownout voltage threshold selector.
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+required:
+  - compatible
+  - reg
+  - '#sound-dai-cells'
+
+unevaluatedProperties: false
