From 502d49e821d7bcd3631aa3877aaec8bc9b48bb69 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Tue, 10 Nov 2026 13:04:10 +0800
Subject: [PATCH] drm/mediatek: restore MT6897 OVL fetch controls before
 enabling

MT6897 direct-link OVL loses request and buffer threshold controls when
its display domain powers off. Restore the stock direct-link values at
each startup before enabling either the local OVL or its dual-pipe twin.

Set BURST16 and output clamp while preserving their other register bits.
Initialize the complete GREQ and urgent-request words, as the vendor golden
settings do, rather than retaining reset fields in those words. The vendor
uses 0xffff for request nibbles; restrict this to the two physical layers
of this OVL variant (0xff). Restore zero low thresholds and the vendor
pre-ultra-high-disable bit for both physical ports.

Enable this behavior only for MT6897. Leave other OVL variants and the
already initialized FIFO/GMC controls unchanged. Add a production-callback
regression covering power loss, twins, masked and full-word writes, startup
ordering and the unchanged legacy MMIO trace.

Link: https://github.com/MiCode/MTK_kernel_device_modules/blob/3c4ccd07d5624879555ec710c11bb8818e5cb5c6/drivers/gpu/drm/mediatek/mediatek_v2/mtk_disp_ovl.c#L3440-L3595
Link: https://github.com/MiCode/MTK_kernel_device_modules/blob/3c4ccd07d5624879555ec710c11bb8818e5cb5c6/drivers/gpu/drm/mediatek/mediatek_v2/mtk_disp_ovl.c#L1087-L1103
Signed-off-by: dianqk <dianqk@dianqk.net>
---
 drivers/gpu/drm/mediatek/mtk_disp_ovl.c       |  36 +++
 tools/testing/selftests/mtk_clk/Makefile      |   4 +-
 .../selftests/mtk_clk/ovl_fetch_cases.c       | 223 ++++++++++++++++++
 .../selftests/mtk_clk/test_ovl_fetch.py       |  50 ++++
 4 files changed, 311 insertions(+), 2 deletions(-)
 create mode 100644 tools/testing/selftests/mtk_clk/ovl_fetch_cases.c
 create mode 100755 tools/testing/selftests/mtk_clk/test_ovl_fetch.py

diff --git a/drivers/gpu/drm/mediatek/mtk_disp_ovl.c b/drivers/gpu/drm/mediatek/mtk_disp_ovl.c
index 5c224114fa..c209e7d87d 100644
--- a/drivers/gpu/drm/mediatek/mtk_disp_ovl.c
+++ b/drivers/gpu/drm/mediatek/mtk_disp_ovl.c
@@ -33,6 +33,7 @@
 #define DISP_REG_OVL_ROI_SIZE			0x0020
 #define DISP_REG_OVL_DATAPATH_CON		0x0024
 #define OVL_LAYER_SMI_ID_EN				BIT(0)
+#define OVL_OUTPUT_CLAMP				BIT(26)
 #define OVL_BGCLR_SEL_IN				BIT(2)
 #define OVL_LAYER_AFBC_EN(n)				BIT(4+n)
 #define DISP_REG_OVL_ROI_BGCLR			0x0028
@@ -46,6 +47,13 @@
 #define OVL_CONST_BLEND					BIT(28)
 #define DISP_REG_OVL_RDMA_CTRL(n)		(0x00c0 + 0x20 * (n))
 #define DISP_REG_OVL_RDMA_GMC(n)		(0x00c8 + 0x20 * (n))
+#define DISP_REG_OVL_RDMA_BURST_CON1		0x01f4
+#define OVL_RDMA_BURST16_EN			BIT(28)
+#define DISP_REG_OVL_RDMA_GREQ_NUM		0x01f8
+#define DISP_REG_OVL_RDMA_GREQ_URG_NUM		0x01fc
+#define DISP_REG_OVL_RDMA_BUF_LOW(n)		(0x0210 + 4 * (n))
+#define DISP_REG_OVL_RDMA_BUF_HIGH(n)		(0x0220 + 4 * (n))
+#define OVL_RDMA_PRE_ULTRA_HIGH_DIS		BIT(31)
 #define DISP_REG_OVL_ADDR_MT2701		0x0040
 #define DISP_REG_OVL_CLRFMT_EXT			0x02d0
 #define OVL_CON_CLRFMT_BIT_DEPTH_MASK(n)		(GENMASK(1, 0) << (4 * (n)))
@@ -147,6 +155,8 @@ struct mtk_disp_ovl_data {
 	 * and clear shadow bypass so plane updates latch together at SOF.
 	 */
 	bool en_keep;
+	/* Restore direct-link fetch controls before enabling after power loss. */
+	bool restore_fetch_config;
 };
 
 /*
@@ -391,8 +401,33 @@ void mtk_ovl_stop(struct device *dev)
 	mtk_ovl_boot_handover(dev);
 }
 
+static void mtk_ovl_restore_fetch_config(struct mtk_disp_ovl *ovl)
+{
+	u32 greq = GENMASK(4 * ovl->data->layer_nr - 1, 0);
+	u32 reg;
+	unsigned int i;
+
+	reg = readl(ovl->regs + DISP_REG_OVL_RDMA_BURST_CON1);
+	writel_relaxed(reg | OVL_RDMA_BURST16_EN,
+		       ovl->regs + DISP_REG_OVL_RDMA_BURST_CON1);
+	reg = readl(ovl->regs + DISP_REG_OVL_DATAPATH_CON);
+	writel_relaxed(reg | OVL_OUTPUT_CLAMP,
+		       ovl->regs + DISP_REG_OVL_DATAPATH_CON);
+
+	/* Each physical layer owns one request nibble; initialize the full words. */
+	writel_relaxed(0xf1ff0000 | greq, ovl->regs + DISP_REG_OVL_RDMA_GREQ_NUM);
+	writel_relaxed(greq, ovl->regs + DISP_REG_OVL_RDMA_GREQ_URG_NUM);
+	for (i = 0; i < ovl->data->layer_nr; i++) {
+		writel_relaxed(0, ovl->regs + DISP_REG_OVL_RDMA_BUF_LOW(i));
+		writel_relaxed(OVL_RDMA_PRE_ULTRA_HIGH_DIS,
+			       ovl->regs + DISP_REG_OVL_RDMA_BUF_HIGH(i));
+	}
+}
+
 static void mtk_ovl_start_one(struct mtk_disp_ovl *ovl)
 {
+	if (ovl->data->restore_fetch_config)
+		mtk_ovl_restore_fetch_config(ovl);
 
 	if (ovl->data->smi_id_en) {
 		unsigned int reg;
@@ -1072,6 +1107,7 @@ static const struct mtk_disp_ovl_data mt6897_ovl_2l_driver_data = {
 	.num_formats = mt8173_ovl_formats_len,
 	.addr_msb = true,
 	.en_keep = true,
+	.restore_fetch_config = true,
 };
 
 static const struct mtk_disp_ovl_data mt8195_ovl_driver_data = {
