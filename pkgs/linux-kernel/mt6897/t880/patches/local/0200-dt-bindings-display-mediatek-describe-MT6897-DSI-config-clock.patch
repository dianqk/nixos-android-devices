From 230f5a7b547df9bd76e76d4e523991c27313a4c6 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Sat, 7 Nov 2026 03:55:53 +0800
Subject: [PATCH] dt-bindings: display: mediatek: describe MT6897 DSI config
 clock

Allow a fourth, named configuration clock for MT6897 DSI. C-PHY links use it to restore MMSYS lane routing after the display domain loses context; D-PHY and other SoCs retain their existing three-clock interface.

Signed-off-by: dianqk <dianqk@dianqk.net>
---
 .../display/mediatek/mediatek,dsi.yaml        | 23 +++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/Documentation/devicetree/bindings/display/mediatek/mediatek,dsi.yaml b/Documentation/devicetree/bindings/display/mediatek/mediatek,dsi.yaml
index b3bc6f710f..05806a4bcf 100644
--- a/Documentation/devicetree/bindings/display/mediatek/mediatek,dsi.yaml
+++ b/Documentation/devicetree/bindings/display/mediatek/mediatek,dsi.yaml
@@ -18,6 +18,25 @@ description: |
 
 allOf:
   - $ref: /schemas/display/dsi-controller.yaml#
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: mediatek,mt6897-dsi
+    then:
+      properties:
+        clocks:
+          minItems: 3
+          maxItems: 4
+        clock-names:
+          minItems: 3
+          maxItems: 4
+    else:
+      properties:
+        clocks:
+          maxItems: 3
+        clock-names:
+          maxItems: 3
 
 properties:
   compatible:
@@ -53,16 +72,20 @@ properties:
     maxItems: 1
 
   clocks:
+    minItems: 3
     items:
       - description: Engine Clock
       - description: Digital Clock
       - description: HS Clock
+      - description: MMSYS configuration clock, required for MT6897 C-PHY routing
 
   clock-names:
+    minItems: 3
     items:
       - const: engine
       - const: digital
       - const: hs
+      - const: config
 
   resets:
     maxItems: 1
-- 
2.56.0

