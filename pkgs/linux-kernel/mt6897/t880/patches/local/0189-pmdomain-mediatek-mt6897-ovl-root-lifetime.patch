diff --git a/tools/testing/selftests/mtk_clk/domain_cases.c b/tools/testing/selftests/mtk_clk/domain_cases.c
new file mode 100644
index 0000000000..5062910fc5
--- /dev/null
+++ b/tools/testing/selftests/mtk_clk/domain_cases.c
@@ -0,0 +1,239 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+static struct scpsys_hwv_domain_data data[2] = {
+    {.num_prepared_clks = 1,
+     .set = 1,
+     .clr = 2,
+     .done = 3,
+     .en = 4,
+     .set_sta = 5,
+     .clr_sta = 6,
+     .setclr_bit = 0},
+    {.num_prepared_clks = 2,
+     .prepared_clk_ids = {0, 1},
+     .set = 1,
+     .clr = 2,
+     .done = 3,
+     .en = 4,
+     .set_sta = 5,
+     .clr_sta = 6,
+     .setclr_bit = 1},
+};
+static struct scpsys_soc_data soc = {.num_hwv_domains = 2,
+				     .hwv_domains_data = data};
+static struct core shared, functional;
+static struct device_node ovl1 = {.id = 1,
+				  .count = 2,
+				  .names = {"ovl", "ovl1"},
+				  .clks = {&shared, &functional}};
+static struct device_node ovl0 = {
+    .id = 0, .count = 1, .names = {"ovl"}, .clks = {&shared}, .next = &ovl1};
+static struct device_node parent = {.child = &ovl0};
+static struct scpsys_root_clocks roots[2];
+static struct regmap map;
+static struct scpsys controller;
+static void reset(void)
+{
+	for (unsigned i = 0; i < num_allocations; i++)
+		free(allocations[i]);
+	num_allocations = 0;
+	shared = (struct core){0};
+	functional = (struct core){0};
+	memset(roots, 0, sizeof(roots));
+	map = (struct regmap){.done = 3, .en = 3};
+	controller = (struct scpsys){.base = &map,
+				     .hwv_node = &hwv_node,
+				     .soc_data = &soc,
+				     .roots = roots};
+	acquire_calls = prepare_calls = enable_calls = 0;
+	fail_acquire = fail_prepare = fail_enable = 0;
+	invalid_provider = invalid_clock_id = invalid_voter = 0;
+	ovl0.disabled = false;
+	parent.child = &ovl0;
+	ovl0.next = &ovl1;
+}
+static struct scpsys_domain domain(unsigned n)
+{
+	return (struct scpsys_domain){.genpd = {.name = "ovl"},
+				      .hwv_data = &data[n],
+				      .scpsys = &controller,
+				      .roots = &roots[n]};
+}
+static void test_preflight_failures(void)
+{
+	for (int kind = 0; kind < 2; kind++)
+		for (int nth = 1; nth <= 3; nth++) {
+			reset();
+			if (kind)
+				fail_prepare = nth;
+			else
+				fail_acquire = nth;
+			assert(scpsys_prepare_root_clocks(&controller,
+							  &parent) < 0);
+			scpsys_unprepare_root_clocks(&controller);
+			assert(!map.writes && !shared.prepared &&
+			       !functional.prepared && !shared.handles &&
+			       !functional.handles);
+		}
+}
+static void test_invalid_roots(void)
+{
+	for (int mode = 0; mode < 4; mode++) {
+		reset();
+		invalid_voter = mode == 3;
+		invalid_provider = mode == 0;
+		invalid_clock_id = mode == 1;
+		ovl0.disabled = mode == 2;
+		assert(scpsys_prepare_root_clocks(&controller, &parent) ==
+		       -EINVAL);
+		scpsys_unprepare_root_clocks(&controller);
+		assert(!map.writes && !shared.prepared);
+	}
+	reset();
+	assert(!scpsys_prepare_root_clocks(&controller, &parent));
+	struct scpsys_domain b = domain(1);
+	fail_enable = 2;
+	assert(scpsys_hwv_root_power_on(&b.genpd) == -EIO);
+	assert(roots[1].enabled_count == 1 && shared.enabled == 1 &&
+	       !functional.enabled);
+	assert(roots[1].failed && !map.writes && shared.prepared == 2);
+}
+static void test_missing_required_domains(void)
+{
+	for (int missing = 0; missing < 2; missing++) {
+		reset();
+		if (missing)
+			ovl0.next = NULL;
+		else
+			parent.child = &ovl1;
+		assert(scpsys_prepare_root_clocks(&controller, &parent) ==
+		       -EINVAL);
+		scpsys_unprepare_root_clocks(&controller);
+		assert(!map.writes && !shared.prepared && !functional.prepared);
+		assert(!shared.handles && !functional.handles);
+	}
+}
+
+static void test_shared_lifetime(void)
+{
+	reset();
+	assert(!scpsys_prepare_root_clocks(&controller, &parent));
+	assert(shared.prepared == 2 && functional.prepared == 1 &&
+	       shared.handles == 2);
+	struct scpsys_domain a = domain(0), b = domain(1);
+	int prepared = prepare_calls;
+	assert(!scpsys_hwv_root_power_on(&a.genpd));
+	assert(!scpsys_hwv_root_power_on(&b.genpd));
+	assert(shared.enabled == 2 && functional.enabled == 1 &&
+	       prepare_calls == prepared);
+	assert(!scpsys_hwv_root_power_off(&a.genpd));
+	assert(shared.enabled == 1 && functional.enabled == 1);
+	assert(!scpsys_hwv_root_power_off(&b.genpd));
+	assert(!shared.enabled && !functional.enabled && shared.prepared == 2);
+	scpsys_unprepare_root_clocks(&controller);
+	assert(!shared.prepared && !functional.prepared && !shared.handles);
+}
+static void test_transition_failures(void)
+{
+	for (int on = 0; on < 2; on++)
+		for (int nth = 1; nth <= 10; nth++) {
+			reset();
+			assert(
+			    !scpsys_prepare_root_clocks(&controller, &parent));
+			struct scpsys_domain a = domain(0);
+			if (!on)
+				assert(!scpsys_hwv_root_power_on(&a.genpd));
+			map.calls = 0;
+			map.fail = nth;
+			int ret = on ? scpsys_hwv_root_power_on(&a.genpd)
+				     : scpsys_hwv_root_power_off(&a.genpd);
+			if (ret) {
+				assert(ret == -EIO);
+				assert(roots[0].failed &&
+				       roots[0].enabled_count &&
+				       shared.enabled == 1 &&
+				       shared.prepared == 2);
+				int writes = map.writes;
+				assert(scpsys_hwv_root_power_on(&a.genpd) ==
+				       -EIO);
+				assert(scpsys_hwv_root_power_off(&a.genpd) ==
+				       -EIO);
+				assert(map.writes == writes);
+			}
+		}
+	for (int mode = 0; mode < 3; mode++) {
+		reset();
+		assert(!scpsys_prepare_root_clocks(&controller, &parent));
+		struct scpsys_domain a = domain(0);
+		if (mode == 0)
+			map.done = 0;
+		else if (mode == 1)
+			map.stuck = 1;
+		else
+			map.sta = 1;
+		assert(scpsys_hwv_root_power_on(&a.genpd) == -ETIMEDOUT);
+		assert(roots[0].failed && roots[0].enabled_count &&
+		       shared.enabled == 1);
+	}
+}
+static void test_initialization_quarantine(void)
+{
+	reset();
+	assert(!scpsys_prepare_root_clocks(&controller, &parent));
+	struct scpsys_domain a = domain(0), b = domain(1);
+	controller.initializing = true;
+	assert(scpsys_hwv_root_power_off(&a.genpd) == -EBUSY);
+	assert(!map.writes);
+	assert(!scpsys_hwv_root_power_on(&a.genpd));
+	map.fail = map.calls + 2;
+	assert(scpsys_hwv_root_power_on(&b.genpd) == -EIO);
+	assert(!scpsys_quarantine_initialization(&controller, -EIO));
+	int writes = map.writes;
+	controller.initializing = false;
+	assert(scpsys_hwv_root_power_off(&a.genpd) == -EIO);
+	assert(scpsys_hwv_root_power_on(&a.genpd) == -EIO);
+	/* All ordinary ancestor callbacks are guarded as well as OVL callbacks.
+	 */
+	struct scpsys_domain ancestor = {.scpsys = &controller,
+					 .hwv_data = &data[0]};
+	assert(scpsys_hwv_power_on(&ancestor.genpd) == -EIO);
+	assert(scpsys_hwv_power_off_internal(&ancestor) == -EIO);
+	assert(map.writes == writes && shared.prepared == 2 &&
+	       shared.enabled == 2 && functional.enabled == 1);
+}
+static void test_off_timeouts_and_ancestor_guard(void)
+{
+	for (int mode = 0; mode < 3; mode++) {
+		reset();
+		assert(!scpsys_prepare_root_clocks(&controller, &parent));
+		struct scpsys_domain a = domain(0);
+		assert(!scpsys_hwv_root_power_on(&a.genpd));
+		if (mode == 0)
+			map.done = 0;
+		else if (mode == 1)
+			map.stuck = 1;
+		else
+			map.drop_done = 1;
+		assert(scpsys_hwv_root_power_off(&a.genpd) == -ETIMEDOUT);
+		assert(controller.quarantined && roots[0].enabled_count == 1 &&
+		       shared.enabled == 1);
+		struct scpsys_domain ancestor = {.scpsys = &controller,
+						 .hwv_data = &data[0]};
+		int writes = map.writes;
+		assert(scpsys_hwv_power_off_internal(&ancestor) == -EIO);
+		assert(scpsys_hwv_power_on(&ancestor.genpd) == -EIO);
+		assert(map.writes == writes && shared.prepared == 2);
+	}
+}
+
+int main(void)
+{
+	test_preflight_failures();
+	test_invalid_roots();
+	test_missing_required_domains();
+	test_shared_lifetime();
+	test_transition_failures();
+	test_initialization_quarantine();
+	test_off_timeouts_and_ancestor_guard();
+	reset();
+	puts("domain preflight, shared roots and failure quarantine passed");
+}
diff --git a/tools/testing/selftests/mtk_clk/domain_stubs.h b/tools/testing/selftests/mtk_clk/domain_stubs.h
new file mode 100644
index 0000000000..28032fad09
--- /dev/null
+++ b/tools/testing/selftests/mtk_clk/domain_stubs.h
@@ -0,0 +1,306 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include <assert.h>
+#include <errno.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+typedef uint32_t u32;
+#define BIT(x) (1U << (x))
+#define EPROBE_DEFER 517
+#define GFP_KERNEL 0
+#define ERR_PTR(e) ((void *)(intptr_t)(e))
+#define PTR_ERR(p) ((int)(intptr_t)(p))
+#define IS_ERR(p) ((uintptr_t)(p) >= (uintptr_t)-4095)
+#define dev_err(...) ((void)0)
+#define MTK_SCPD_DOMAIN_SUPPLY 1
+#define MTK_SCPD_INFRA_PWR_CTL 2
+#define MTK_SCPD_KEEP_DEFAULT_OFF 4
+#define MTK_SCPD_CAPS(pd, cap) (0)
+#define MTK_HWV_POLL_DELAY_US 1
+#define MTK_HWV_POLL_TIMEOUT 3
+#define MTK_HWV_PREPARE_DELAY_US 1
+#define MTK_HWV_PREPARE_TIMEOUT 3
+#define udelay(x) ((void)0)
+#define container_of(p, t, m) ((t *)((char *)(p) - offsetof(t, m)))
+#include <stddef.h>
+struct core {
+	int prepared, enabled, handles;
+};
+struct clk {
+	struct core *core;
+};
+struct clk_bulk_data {
+	struct clk *clk;
+};
+struct device_node {
+	bool disabled;
+	u32 id;
+	int count;
+	const char *names[2];
+	struct core *clks[2];
+	struct device_node *child, *next;
+};
+struct scpsys_hwv_domain_data {
+	unsigned num_prepared_clks, caps;
+	u32 prepared_clk_ids[2];
+	u32 set, clr, done, en, set_sta, clr_sta, setclr_bit;
+};
+struct scpsys_soc_data {
+	unsigned num_hwv_domains;
+	const char *prepared_clk_compatible;
+	const struct scpsys_hwv_domain_data *hwv_domains_data;
+};
+struct generic_pm_domain {
+	const char *name;
+};
+struct regmap {
+	u32 vote, done, en, sta;
+	int calls, fail, stuck, writes, drop_done;
+	u32 pending_clr;
+};
+struct scpsys_root_clocks {
+	struct clk_bulk_data *clks;
+	int num_clks;
+	bool seen, prepared, failed;
+	unsigned enabled_count;
+};
+struct scpsys {
+	void *dev;
+	struct device_node *hwv_node;
+	struct regmap *base;
+	const struct scpsys_soc_data *soc_data;
+	struct scpsys_root_clocks *roots;
+	bool initializing, quarantined;
+};
+struct scpsys_domain {
+	struct generic_pm_domain genpd;
+	const struct scpsys_hwv_domain_data *hwv_data;
+	struct scpsys *scpsys;
+	struct scpsys_root_clocks *roots;
+	int num_clks, num_subsys_clks;
+	struct clk_bulk_data *clks, *subsys_clks;
+	void *supply;
+};
+#define to_scpsys_domain(g) container_of(g, struct scpsys_domain, genpd)
+static int acquire_calls, fail_acquire, prepare_calls, fail_prepare,
+    enable_calls, fail_enable;
+static void *allocations[128];
+static unsigned num_allocations;
+static void *allocate(size_t n)
+{
+	void *p = calloc(1, n);
+	assert(p);
+	allocations[num_allocations++] = p;
+	return p;
+}
+#define devm_kcalloc(d, n, s, f) allocate((n) * (s))
+#define for_each_available_child_of_node_scoped(n, c)                          \
+	for (struct device_node *c = (n)->child; c; c = c->next)
+static int of_property_read_u32(struct device_node *n, const char *k, u32 *v)
+{
+	*v = n->id;
+	return 0;
+}
+static int of_clk_get_parent_count(struct device_node *n) { return n->count; }
+static int of_property_count_strings(struct device_node *n, const char *k)
+{
+	return n->count;
+}
+static int of_property_read_string_index(struct device_node *n, const char *k,
+					 int i, const char **v)
+{
+	*v = n->names[i];
+	return 0;
+}
+static struct clk *of_clk_get(struct device_node *n, int i)
+{
+	if (++acquire_calls == fail_acquire)
+		return ERR_PTR(-EPROBE_DEFER);
+	struct clk *c = allocate(sizeof(*c));
+	c->core = n->clks[i];
+	c->core->handles++;
+	return c;
+}
+static void clk_bulk_put(int n, struct clk_bulk_data *c)
+{
+	for (int i = 0; i < n; i++)
+		c[i].clk->core->handles--;
+}
+static void clk_bulk_unprepare(int n, struct clk_bulk_data *c)
+{
+	for (int i = 0; i < n; i++) {
+		assert(c[i].clk->core->prepared > 0);
+		c[i].clk->core->prepared--;
+	}
+}
+static int clk_bulk_prepare(int n, struct clk_bulk_data *c)
+{
+	for (int i = 0; i < n; i++) {
+		if (++prepare_calls == fail_prepare) {
+			clk_bulk_unprepare(i, c);
+			return -EIO;
+		}
+		c[i].clk->core->prepared++;
+	}
+	return 0;
+}
+static void clk_bulk_disable(int n, struct clk_bulk_data *c)
+{
+	for (int i = 0; i < n; i++) {
+		assert(c[i].clk->core->enabled > 0);
+		c[i].clk->core->enabled--;
+	}
+}
+static int clk_bulk_enable(int n, struct clk_bulk_data *c)
+{
+	for (int i = 0; i < n; i++) {
+		assert(c[i].clk->core->prepared > 0);
+		if (++enable_calls == fail_enable) {
+			clk_bulk_disable(i, c);
+			return -EIO;
+		}
+		c[i].clk->core->enabled++;
+	}
+	return 0;
+}
+static int clk_bulk_prepare_enable(int n, struct clk_bulk_data *c)
+{
+	assert(n == 0);
+	return 0;
+}
+static void clk_bulk_disable_unprepare(int n, struct clk_bulk_data *c)
+{
+	assert(n == 0);
+}
+static int scpsys_regulator_enable(void *p) { return 0; }
+static void scpsys_regulator_disable(void *p) {}
+static int scpsys_sec_infra_power_on(bool b) { return 0; }
+static int regmap_read(struct regmap *m, u32 r, u32 *v)
+{
+	if (++m->calls == m->fail)
+		return -EIO;
+	*v = r == 1   ? m->vote
+	     : r == 2 ? m->pending_clr
+	     : r == 3 ? m->done
+	     : r == 4 ? m->en
+		      : m->sta;
+	return 0;
+}
+static int regmap_write(struct regmap *m, u32 r, u32 v)
+{
+	m->writes++;
+	if (m->drop_done)
+		m->done = 0;
+	if (m->stuck && r == 2)
+		m->pending_clr = v;
+	if (++m->calls == m->fail)
+		return -EIO;
+	if (!m->stuck) {
+		if (r == 1) {
+			m->vote |= v;
+			m->en |= v;
+		} else {
+			assert(r == 2);
+			m->vote &= ~v;
+			m->en &= ~v;
+		}
+	}
+	return 0;
+}
+static int regmap_multi_reg_read(struct regmap *m, u32 *r, u32 *v, int n)
+{
+	for (int i = 0; i < n; i++) {
+		int ret = regmap_read(m, r[i], v + i);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
