+/* Root readiness is established before genpd initialization or publication. */
+static int scpsys_collect_root_clocks(struct scpsys *scpsys, struct device_node *node)
+{
+	struct scpsys_root_clocks *roots;
+	struct of_phandle_args args;
+	struct device_node *expected, *voter;
+	const struct scpsys_hwv_domain_data *data;
+	u32 id;
+	int i, ret, count;
+
+	for_each_child_of_node_scoped(node, child) {
+		if (!of_device_is_available(child))
+			return -EINVAL;
+		ret = of_property_read_u32(child, "reg", &id);
+		if (ret || id >= scpsys->soc_data->num_hwv_domains)
+			return -EINVAL;
+		data = &scpsys->soc_data->hwv_domains_data[id];
+		roots = &scpsys->roots[id];
+		if (roots->seen)
+			return -EINVAL;
+		roots->seen = true;
+		if (data->num_prepared_clks) {
+			count = of_clk_get_parent_count(child);
+			if (count != data->num_prepared_clks ||
+			    count > ARRAY_SIZE(data->prepared_clk_ids) ||
+			    of_property_count_strings(child, "clock-names") != count ||
+			    data->caps & (MTK_SCPD_DOMAIN_SUPPLY | MTK_SCPD_INFRA_PWR_CTL |
+					  MTK_SCPD_KEEP_DEFAULT_OFF))
+				return -EINVAL;
+			roots->clks = devm_kcalloc(scpsys->dev, count,
+						 sizeof(*roots->clks), GFP_KERNEL);
+			if (!roots->clks)
+				return -ENOMEM;
+			for (i = 0; i < count; i++) {
+				const char *name;
+
+				ret = of_property_read_string_index(child, "clock-names", i, &name);
+				if (ret || strchr(name, '-'))
+					return -EINVAL;
+				ret = of_parse_phandle_with_args(child, "clocks", "#clock-cells", i, &args);
+				if (ret)
+					return ret;
+				expected = of_find_compatible_node(NULL, NULL,
+						 scpsys->soc_data->prepared_clk_compatible);
+				voter = of_parse_phandle(args.np, "mediatek,hardware-voter", 0);
+				ret = args.np == expected && voter && voter == scpsys->hwv_node &&
+					args.args_count == 1 &&
+					args.args[0] == data->prepared_clk_ids[i] ? 0 : -EINVAL;
+				of_node_put(voter);
+				of_node_put(expected);
+				of_node_put(args.np);
+				if (ret)
+					return ret;
+				roots->clks[i].clk = of_clk_get(child, i);
+				if (IS_ERR(roots->clks[i].clk))
+					return PTR_ERR(roots->clks[i].clk);
+				roots->num_clks++;
+			}
+			ret = clk_bulk_prepare(roots->num_clks, roots->clks);
+			if (ret)
+				return ret;
+			roots->prepared = true;
+		}
+		ret = scpsys_collect_root_clocks(scpsys, child);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int scpsys_prepare_root_clocks(struct scpsys *scpsys, struct device_node *node)
+{
+	int i, ret;
+
+	ret = scpsys_collect_root_clocks(scpsys, node);
+	if (ret)
+		return ret;
+	for (i = 0; i < scpsys->soc_data->num_hwv_domains; i++)
+		if (scpsys->soc_data->hwv_domains_data[i].num_prepared_clks &&
+		    (!scpsys->roots[i].seen || !scpsys->roots[i].prepared))
+			return -EINVAL;
+	return 0;
+}
+
+static void scpsys_unprepare_root_clocks(struct scpsys *scpsys)
+{
+	int i;
+
+	for (i = scpsys->soc_data->num_hwv_domains - 1; i >= 0; i--) {
+		struct scpsys_root_clocks *roots = &scpsys->roots[i];
+
+		if (roots->prepared)
+			clk_bulk_unprepare(roots->num_clks, roots->clks);
+		clk_bulk_put(roots->num_clks, roots->clks);
+	}
+}
+
+static int scpsys_hwv_root_done(struct scpsys_domain *pd, bool on)
+{
+	const struct scpsys_hwv_domain_data *hwv = pd->hwv_data;
+	u32 regs[3] = { hwv->done, on ? hwv->set_sta : hwv->clr_sta, hwv->en };
+	u32 val[3], mask = BIT(hwv->setclr_bit);
+	int ret;
+
+	ret = regmap_multi_reg_read(pd->scpsys->base, regs, val, on ? 3 : 2);
+	if (ret)
+		return ret;
+	return (val[0] & mask) && !(val[1] & mask) && (!on || (val[2] & mask));
+}
+
+static int scpsys_hwv_root_vote(struct scpsys_domain *pd, bool on)
+{
+	const struct scpsys_hwv_domain_data *hwv = pd->hwv_data;
+	struct regmap *map = pd->scpsys->base;
+	u32 val, ofs = on ? hwv->set : hwv->clr, mask = BIT(hwv->setclr_bit);
+	int ret, done;
+
+	ret = regmap_read_poll_timeout_atomic(map, hwv->done, val, val & mask,
+					      MTK_HWV_POLL_DELAY_US, MTK_HWV_POLL_TIMEOUT);
+	if (ret)
+		return ret;
+	ret = regmap_write(map, ofs, mask);
+	if (ret)
+		return ret;
+	ret = regmap_read_poll_timeout_atomic(map, ofs, val,
+					      on ? (val & mask) : !(val & mask),
+					      MTK_HWV_PREPARE_DELAY_US, MTK_HWV_PREPARE_TIMEOUT);
+	if (ret)
+		return ret;
+	if (!on)
+		udelay(100);
+	ret = read_poll_timeout_atomic(scpsys_hwv_root_done, done, done,
+				       MTK_HWV_POLL_DELAY_US, MTK_HWV_POLL_TIMEOUT,
+				       false, pd, on);
+	return ret ? ret : (done < 0 ? done : 0);
+}
+
+static int scpsys_hwv_root_power_on(struct generic_pm_domain *genpd)
+{
+	struct scpsys_domain *pd = to_scpsys_domain(genpd);
+	struct scpsys_root_clocks *roots = pd->roots;
+	int ret;
+
+	if (READ_ONCE(pd->scpsys->quarantined) || roots->failed)
+		return -EIO;
+	while (roots->enabled_count < roots->num_clks) {
+		ret = clk_enable(roots->clks[roots->enabled_count].clk);
+		if (ret)
+			goto quarantine;
+		roots->enabled_count++;
+	}
+	ret = scpsys_hwv_root_vote(pd, true);
+	if (!ret)
+		return 0;
+quarantine:
+	/* Unknown transition state: retain every successful enable and prepare. */
+	roots->failed = true;
+	WRITE_ONCE(pd->scpsys->quarantined, true);
+	dev_err(pd->scpsys->dev, "%s: power-on failed (%d), roots quarantined\n",
+		genpd->name, ret);
+	return ret;
+}
+
+static int scpsys_hwv_root_power_off(struct generic_pm_domain *genpd)
+{
+	struct scpsys_domain *pd = to_scpsys_domain(genpd);
+	struct scpsys_root_clocks *roots = pd->roots;
+	int ret;
+
+	if (READ_ONCE(pd->scpsys->initializing))
+		return -EBUSY;
+
+	if (READ_ONCE(pd->scpsys->quarantined) || roots->failed)
+		return -EIO;
+	ret = scpsys_hwv_root_vote(pd, false);
+	if (ret) {
+		roots->failed = true;
+		WRITE_ONCE(pd->scpsys->quarantined, true);
+		dev_err(pd->scpsys->dev, "%s: power-off failed (%d), roots quarantined\n",
+			genpd->name, ret);
+		return ret;
+	}
+	while (roots->enabled_count)
+		clk_disable(roots->clks[--roots->enabled_count].clk);
+	return 0;
+}
