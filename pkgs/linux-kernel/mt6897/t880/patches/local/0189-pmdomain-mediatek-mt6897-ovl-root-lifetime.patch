+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Exercise production root-preflight and HWV domain functions with host mocks."""
+from pathlib import Path
+import os
+import subprocess
+import tempfile
+
+assets = Path(__file__).resolve().parent
+repo = Path(os.environ.get('KERNEL_SRC', str(assets.parents[3])))
+source = (repo / 'drivers/pmdomain/mediatek/mtk-pm-domains.c').read_text()
+
+def function(name):
+    start = source.index('static int ' + name + '(')
+    brace = source.index('{', start)
+    end = brace + 1
+    depth = 1
+    while depth:
+        depth += (source[end] == '{') - (source[end] == '}')
+        end += 1
+    return source[start:end]
+
+start = source.index('/* Root readiness is established')
+end = source.index('static int scpsys_hwv_power_on', start)
+production = source[start:end]
+for name in ['scpsys_hwv_power_on', 'scpsys_hwv_power_off_internal',
+             'scpsys_quarantine_initialization']:
+    production += function(name)
+for name in ['scpsys_hwv_root_power_on', 'scpsys_hwv_root_power_off']:
+    assert 'clk_bulk_prepare' not in function(name)
+    assert 'clk_bulk_unprepare' not in function(name)
+probe = function('scpsys_probe')
+assert probe.index('scpsys_prepare_root_clocks') < probe.index('scpsys_add_one_domain')
+assert probe.index('scpsys_prepare_root_clocks') < probe.index('of_genpd_add_provider_onecell')
+assert 'return scpsys_quarantine_initialization(scpsys, ret)' in probe
+add_start = source.index('generic_pm_domain *scpsys_add_one_domain')
+add_end = source.index('static int scpsys_add_subdomain', add_start)
+add_domain = source[add_start:add_end]
+assert add_domain.count('ret = pm_genpd_init(') == 2
+assert add_domain.index('if (ret && scpsys->soc_data->quarantine_init_failure)') < add_domain.index('domains_idx[(*num_domains)++]')
+assert add_domain.index('if (ret && scpsys->soc_data->quarantine_init_failure)') < add_domain.index('scpsys->domains[id] =')
+
+with tempfile.TemporaryDirectory(prefix='mtk-domain-') as temporary:
+    out = Path(temporary)
+    (out / 'test.c').write_text((assets / 'domain_stubs.h').read_text() + production +
+                              (assets / 'domain_cases.c').read_text())
+    subprocess.run([os.environ.get('CC', 'cc'), '-g', '-fsanitize=address,undefined',
+                    '-o', str(out / 'test'), str(out / 'test.c')], check=True)
+    subprocess.run([str(out / 'test')], check=True)
