+		for (_i = 0; _i < 3; _i++) {                                   \
+			_r = regmap_read(m, r, &v);                            \
+			if (_r || (c))                                         \
+				break;                                         \
+		}                                                              \
+		if (!_r && _i == 3)                                            \
+			_r = -ETIMEDOUT;                                       \
+		_r;                                                            \
+	})
+#define read_poll_timeout_atomic(fn, v, c, d, t, s, ...)                       \
+	({                                                                     \
+		int _r = 0, _i;                                                \
+		for (_i = 0; _i < 3; _i++) {                                   \
+			v = fn(__VA_ARGS__);                                   \
+			if (c)                                                 \
+				break;                                         \
+		}                                                              \
+		if (_i == 3)                                                   \
+			_r = -ETIMEDOUT;                                       \
+		_r;                                                            \
+	})
+#define readx_poll_timeout_atomic(fn, a, v, c, d, t)                           \
+	read_poll_timeout_atomic(fn, v, c, d, t, false, a)
