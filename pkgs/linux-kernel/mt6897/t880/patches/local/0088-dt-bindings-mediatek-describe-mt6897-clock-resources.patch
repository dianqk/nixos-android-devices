diff --git a/Documentation/devicetree/bindings/clock/mediatek,mt6897-vcodec.yaml b/Documentation/devicetree/bindings/clock/mediatek,mt6897-vcodec.yaml
new file mode 100644
index 0000000000..98156d68fc
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/mediatek,mt6897-vcodec.yaml
@@ -0,0 +1,39 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/mediatek,mt6897-vcodec.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6897 video codec clock controllers
+
+maintainers:
+  - dianqk <dianqk@dianqk.net>
+
+properties:
+  compatible:
+    oneOf:
+      - enum:
+          - mediatek,mt6897-vencsys
+          - mediatek,mt6897-vencsys_c1
+      - items:
+          - enum:
+              - mediatek,mt6897-vdecsys
+              - mediatek,mt6897-vdecsys_soc
+          - const: syscon
+
+  reg:
+    maxItems: 1
+
+  '#clock-cells':
+    const: 1
+
+  power-domains:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - '#clock-cells'
+  - power-domains
+
+additionalProperties: false
