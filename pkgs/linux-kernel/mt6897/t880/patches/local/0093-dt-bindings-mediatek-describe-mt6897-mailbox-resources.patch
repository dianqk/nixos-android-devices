Signed-off-by: dianqk <dianqk@dianqk.net>
Link: https://github.com/MiCode/MTK_kernel_device_modules/blob/3c4ccd07d5624879555ec710c11bb8818e5cb5c6/drivers/misc/mediatek/cmdq/mailbox/mtk-cmdq-mailbox-ext.c
Link: https://github.com/MiCode/MTK_kernel_device_modules/blob/3c4ccd07d5624879555ec710c11bb8818e5cb5c6/arch/arm64/boot/dts/mediatek/mt6897.dts
Link: https://github.com/MiCode/MTK_kernel_device_modules/blob/3c4ccd07d5624879555ec710c11bb8818e5cb5c6/drivers/gpu/drm/mediatek/mediatek_v2/mtk_drm_crtc.c
---
 .../mailbox/mediatek,gce-mailbox.yaml         | 53 +++++++++++++++++++
 .../mailbox/mediatek,mt8196-gpueb-mbox.yaml   |  1 +
 2 files changed, 54 insertions(+)

diff --git a/Documentation/devicetree/bindings/mailbox/mediatek,gce-mailbox.yaml b/Documentation/devicetree/bindings/mailbox/mediatek,gce-mailbox.yaml
index 587126d03f..23e1a7f229 100644
--- a/Documentation/devicetree/bindings/mailbox/mediatek,gce-mailbox.yaml
+++ b/Documentation/devicetree/bindings/mailbox/mediatek,gce-mailbox.yaml
@@ -19,6 +19,7 @@ properties:
     oneOf:
       - enum:
           - mediatek,mt6779-gce
+          - mediatek,mt6897-gce
           - mediatek,mt8173-gce
           - mediatek,mt8183-gce
           - mediatek,mt8186-gce
@@ -43,16 +44,44 @@ properties:
     maxItems: 1
 
   clocks:
+    minItems: 1
+    maxItems: 2
     items:
       - description: Global Command Engine clock
+      - description: Global Command Engine timer clock
 
   clock-names:
+    minItems: 1
+    maxItems: 2
     items:
       - const: gce
+      - const: gce-timer
+
+  mediatek,default-tokens:
+    $ref: /schemas/types.yaml#/definitions/uint16-array
+    minItems: 1
+    maxItems: 32
+    items:
+      maximum: 1023
+    description: Initial firmware and software lock tokens to set before clients register.
 
   iommus:
     maxItems: 1
 
+  mediatek,smi:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    minItems: 2
+    maxItems: 2
+    items:
+      maxItems: 1
+    description: MDP and MMSRAM interconnect suppliers for firmware command fetch.
+
+  memory-region:
+    maxItems: 1
+    description: |
+      Boot framebuffer reservation shared by multimedia DMA clients. Matching
+      iommu-addresses reserve its identity IOVAs before the first allocation.
+
 required:
   - compatible
   - "#mbox-cells"
@@ -60,6 +89,30 @@ required:
   - interrupts
   - clocks
 
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: mediatek,mt6897-gce
+    then:
+      properties:
+        clocks:
+          minItems: 2
+        clock-names:
+          minItems: 2
+      required:
+        - clock-names
+        - mediatek,default-tokens
+        - mediatek,smi
+    else:
+      properties:
+        clocks:
+          maxItems: 1
+        clock-names:
+          maxItems: 1
+        mediatek,default-tokens: false
+
 additionalProperties: false
 
 examples:
diff --git a/Documentation/devicetree/bindings/mailbox/mediatek,mt8196-gpueb-mbox.yaml b/Documentation/devicetree/bindings/mailbox/mediatek,mt8196-gpueb-mbox.yaml
index ab5b780cb8..c014bb2c16 100644
--- a/Documentation/devicetree/bindings/mailbox/mediatek,mt8196-gpueb-mbox.yaml
+++ b/Documentation/devicetree/bindings/mailbox/mediatek,mt8196-gpueb-mbox.yaml
@@ -12,6 +12,7 @@ maintainers:
 properties:
   compatible:
     enum:
+      - mediatek,mt6897-gpueb-mbox
       - mediatek,mt8196-gpueb-mbox
 
   reg:
-- 
