+static void mtk_iommu_fw_irqs_disable(struct mtk_iommu_data *data)
+{
+	unsigned int i;
+
+	for (i = 0; i < MT6897_FW_BANKS; i++) {
+		struct mtk_iommu_fw_bank *bank = &data->fw_bank[i];
+
+		if (!bank->requested)
+			continue;
+		if (!bank->enabled) {
+			synchronize_irq(bank->irq);
+			continue;
+		}
+		disable_irq(bank->irq);
+		bank->enabled = false;
+		/* disable_irq synchronized the threaded query. Preserve the
+		 * lifecycle mask while balancing its failure mask once. */
+		if (bank->fault_disabled) {
+			bank->fault_disabled = false;
+			enable_irq(bank->irq);
+		}
+	}
+}
+
+static void mtk_iommu_fw_irqs_enable(struct mtk_iommu_data *data)
+{
+	unsigned int i;
+
+	for (i = 0; i < MT6897_FW_BANKS; i++) {
+		struct mtk_iommu_fw_bank *bank = &data->fw_bank[i];
+
+		if (bank->enabled || bank->failed)
+			continue;
+		bank->enabled = true;
+		enable_irq(bank->irq);
+	}
+}
+
+static int mtk_iommu_fw_irqs_prepare(struct platform_device *pdev,
+				    struct mtk_iommu_data *data)
+{
+	unsigned int i;
+	int ret;
+
+	if (!data->plat_data->firmware_banks)
+		return 0;
+	for (i = 0; i < MT6897_FW_BANKS; i++) {
+		struct mtk_iommu_fw_bank *bank = &data->fw_bank[i];
+
+		bank->data = data;
+		bank->bank = i + 1;
+		bank->irq = platform_get_irq(pdev, bank->bank);
+		if (bank->irq < 0)
+			return bank->irq;
+		snprintf(bank->name, sizeof(bank->name), "mt6897-%u-fw-bank%u",
+			 data->plat_data->firmware_id, bank->bank);
+		ret = devm_request_threaded_irq(data->dev, bank->irq, NULL,
+			mtk_iommu_fw_irq, IRQF_ONESHOT | IRQF_NO_AUTOEN, bank->name, bank);
+		if (ret)
+			return ret;
+		bank->requested = true;
+	}
+	return 0;
+}
