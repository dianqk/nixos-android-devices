+/* MediaTek MT6897 firmware-bank contract, MiCode device modules 3c4ccd07
+ * mtk_iommu.c and the platform ATF. Linux owns bank0 only. SMC514 op0/2/3
+ * initializes/backs up/restores firmware bank registers; ATF owns their TTBRs
+ * and tables. Op5 synchronously reads fault data and ACKs INT_CONTROL BIT12.
+ */
+static int mtk_iommu_fw_command(struct mtk_iommu_data *data, unsigned int op,
+			      unsigned int arg)
+{
+	struct arm_smccc_res res;
+	u32 command = data->plat_data->firmware_id << 16 | 4 << 8 | op;
+
+	arm_smccc_smc(MTK_SIP_KERNEL_IOMMU_CONTROL, command, arg, 0, 0, 0, 0, 0, &res);
+	if (res.a0) {
+		dev_err(data->dev, "firmware bank operation %u failed: raw=%#lx/%#lx/%#lx/%#lx\n",
+			op, res.a0, res.a1, res.a2, res.a3);
+		return -EIO;
+	}
+	return 0;
+}
+
+static irqreturn_t mtk_iommu_fw_irq(int irq, void *priv)
+{
+	struct mtk_iommu_fw_bank *bank = priv;
+	struct mtk_iommu_data *data = bank->data;
+	struct arm_smccc_res res;
+	u32 command = data->plat_data->firmware_id << 16 | bank->bank << 8 | 5;
+	u32 va, fault_id, comm, sub, port, larb = MTK_INVALID_LARBID;
+	u64 iova, pa;
