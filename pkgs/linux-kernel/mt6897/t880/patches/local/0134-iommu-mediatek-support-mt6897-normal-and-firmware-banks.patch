+	arm_smccc_smc(MTK_SIP_KERNEL_IOMMU_CONTROL, command, 0, 0, 0, 0, 0, 0, &res);
+	dev_err_ratelimited(data->dev,
+		"firmware bank%u fault raw=%#lx/%#lx/%#lx/%#lx\n",
+		bank->bank, res.a0, res.a1, res.a2, res.a3);
+	if (res.a0) {
+		/* A failed query may leave the level asserted. Keep this bank
+		 * masked until reboot; PM balances the extra disable exactly once. */
+		WRITE_ONCE(bank->failed, true);
+		WRITE_ONCE(bank->fault_disabled, true);
+		disable_irq_nosync(irq);
+		return IRQ_HANDLED;
+	}
+	if (!res.a1 && !res.a2 && !res.a3) {
+		dev_err_ratelimited(data->dev, "firmware bank%u returned an empty, ambiguous fault tuple\n",
+			bank->bank);
+		return IRQ_HANDLED;
+	}
+	/* Extract both high address fields and access flags before masking VA. */
+	va = lower_32_bits(res.a1);
+	fault_id = lower_32_bits(res.a3);
+	iova = (va & GENMASK(31, 12)) | (u64)((va >> 9) & 7) << 32;
+	pa = lower_32_bits(res.a2) | (u64)((va >> 6) & 7) << 32;
+	comm = (fault_id >> 10) & 7;
+	sub = (fault_id >> 7) & 7;
+	port = (fault_id >> 2) & 31;
+	if (comm < ARRAY_SIZE(data->plat_data->larbid_remap) &&
+	    sub < ARRAY_SIZE(data->plat_data->larbid_remap[0]))
+		larb = data->plat_data->larbid_remap[comm][sub];
+	dev_err_ratelimited(data->dev,
+		"firmware bank%u iova=%#llx pa=%#llx id=%#x comm=%u sub=%u larb=%u port=%u layer=%u %s\n",
+		bank->bank, iova, pa, fault_id, comm, sub, larb, port,
+		va & 1, str_write_read(va & 2));
+	return IRQ_HANDLED;
+}
