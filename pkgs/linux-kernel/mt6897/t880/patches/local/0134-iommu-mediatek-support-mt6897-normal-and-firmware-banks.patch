 			portid_msk, regionid, upper_32_bits(region->iova_base));
 
 		if (enable)
@@ -678,6 +846,14 @@ static int mtk_iommu_domain_finalise(struct mtk_iommu_domain *dom,
 	if (MTK_IOMMU_HAS_FLAG(data->plat_data, PGTABLE_PA_35_EN))
