+/*
+ * MT6897 GenieZone type2: the hypervisor keeps a shadow of the MM page table
+ * and the banks walk that shadow. The SMC ABI follows the vendor driver:
+ * query the mode once, and synchronise every changed IOVA range of table 0
+ * before the bank TLB invalidation.
+ */
+#define MTK_IOMMU_HYP_TYPE2_QUERY	0xbb00ffa4
+#define MTK_IOMMU_HYP_TYPE2_SYNC	0xbb00ffa7
+#define MTK_IOMMU_HYP_MM_TABLE		0
+
+static bool mtk_iommu_hyp_type2_query(struct mtk_iommu_data *data)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_smc(MTK_IOMMU_HYP_TYPE2_QUERY, 0, 0, 0, 0, 0, 0, 0, &res);
+	if (res.a0 > 1) {
+		/* Includes SMCCC_RET_NOT_SUPPORTED: no hypervisor shadow. */
+		dev_warn(data->dev, "Unexpected type2 query result %#lx, assume disabled\n",
+			 res.a0);
+		return false;
+	}
+	dev_info(data->dev, "Hypervisor type2 page table %s\n",
+		 str_enabled_disabled(res.a0));
+	return res.a0;
+}
+
+/* Synchronise [start, end] of the shadow table. Called with hyp_lock held. */
+static int mtk_iommu_hyp_sync_range(struct mtk_iommu_data *data,
+				    unsigned long start, unsigned long end)
+{
+	struct arm_smccc_res res;
+
+	/* The page table walk is coherent; complete the PTE writes first. */
+	dsb(sy);
+	arm_smccc_smc(MTK_IOMMU_HYP_TYPE2_SYNC, MTK_IOMMU_TLB_ADDR(start),
+		      MTK_IOMMU_TLB_ADDR(end), MTK_IOMMU_HYP_MM_TABLE,
+		      0, 0, 0, 0, &res);
+	/* Order the shadow updates before the bank TLB invalidation. */
+	dsb(sy);
+	if (res.a0) {
+		WARN_ONCE(1, "%s: type2 sync failed\n", dev_name(data->dev));
+		dev_err_ratelimited(data->dev, "type2 sync 0x%lx-0x%lx failed %#lx\n",
+				    start, end, res.a0);
+		return -EIO;
+	}
+	return 0;
+}
+
+static int mtk_iommu_hyp_sync(struct mtk_iommu_data *data,
+			      unsigned long iova, size_t size)
+{
+	unsigned long flags, end = iova + size - 1;
+	int ret = 0;
+
+	/* Also skips an empty gather. */
+	if (!data->hyp_type2 || !size || end < iova)
+		return 0;
+
+	spin_lock_irqsave(&data->hyp_lock, flags);
+	if (data->hyp_published) {
+		ret = mtk_iommu_hyp_sync_range(data, iova, end);
+	} else if (data->hyp_pending) {
+		data->hyp_pending_start = min(data->hyp_pending_start, iova);
+		data->hyp_pending_end = max(data->hyp_pending_end, end);
+	} else {
+		data->hyp_pending_start = iova;
+		data->hyp_pending_end = end;
+		data->hyp_pending = true;
+	}
+	spin_unlock_irqrestore(&data->hyp_lock, flags);
+	return ret;
+}
+
+static struct mtk_iommu_data *mtk_iommu_dom_pgtable_data(struct mtk_iommu_domain *dom)
+{
+	return mtk_iommu_get_frst_data(dom->bank->parent_data->hw_list);
+}
+
+/* A bank has started to walk the table: synchronise the earlier changes. */
+static void mtk_iommu_hyp_publish(struct mtk_iommu_domain *dom)
+{
+	struct mtk_iommu_data *data = mtk_iommu_dom_pgtable_data(dom);
+	unsigned long flags, start = 0, end = 0;
+	bool pending;
+
+	if (!data->hyp_type2)
+		return;
+
+	spin_lock_irqsave(&data->hyp_lock, flags);
+	pending = !data->hyp_published && data->hyp_pending;
+	if (pending) {
+		start = data->hyp_pending_start;
+		end = data->hyp_pending_end;
+		mtk_iommu_hyp_sync_range(data, start, end);
+	}
+	data->hyp_published = true;
+	data->hyp_pending = false;
+	spin_unlock_irqrestore(&data->hyp_lock, flags);
+
+	if (pending)
+		mtk_iommu_tlb_flush_range_sync(start, end - start + 1, dom->bank);
+}
+
+/*
+ * io-pgtable frees a retired lower-level table right after this callback,
+ * so the shadow and the TLBs must stop using it first. The cookie is the
+ * data owning the page table; invalidate bank 0 of every M4U sharing it.
+ */
+static void mtk_iommu_hyp_flush_walk(unsigned long iova, size_t size,
+				     size_t granule, void *cookie)
+{
+	struct mtk_iommu_data *data = cookie;
+
+	mtk_iommu_hyp_sync(data, iova, size);
+	mtk_iommu_tlb_flush_range_sync(iova, size, &data->bank[0]);
+}
+
+/* Leaf changes are gathered and synchronised once in iotlb_sync. */
+static const struct iommu_flush_ops mtk_iommu_hyp_flush_ops = {
+	.tlb_flush_walk	= mtk_iommu_hyp_flush_walk,
+};
