 // SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause
 /*
- * MediaTek MT6897 (MT8792) SoC — mainline bring-up, stage S1.
+ * MediaTek MT6897 SoC: minimal boot description.
  *
- * 每一个数值都取自设备 bootloader 实际传入的 FDT
- * (reports/20260910-recovery/board.dtb)，那是最可信的硬件事实源。
- * 不确定的（时钟树编号、引脚表、电源域编号）先不写，等驱动落地再补。
- *
- * 单元数：厂商 DTB 的 / 与 /soc 都是 #address-cells=2 / #size-cells=2
- * （MT6895 主线移植用 1/1，直接套到这颗 SoC 上会错），本文件跟随厂商。
- * 中断单元数同理是 4（末位是 0），不是主线的 3。
- *
- * ⚠️ GIC 基址有家族惯例与本机的冲突，见下方 gic 节点的注释。
+ * Addresses and interrupts were taken from a Lenovo TB375FC bootloader FDT
+ * by the tb375fc-linux project. Clock, pin and power-domain providers are
+ * not described yet: the nodes below rely on the state the stock bootloader
+ * leaves behind, with fixed 26 MHz placeholders where drivers need a clock.
+ * The vendor tree uses two address and size cells and four interrupt cells.
  */
 
+#include <dt-bindings/gce/mediatek,mt6897-gce.h>
+#include <dt-bindings/clock/mediatek,mt6685-clock.h>
+#include <dt-bindings/clock/mediatek,mt6897-clock.h>
+#include <dt-bindings/power/mediatek,mt6897-power.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
 #include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/interconnect/mediatek,mt8196.h>
 #include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/memory/mediatek,mt6897-memory-port.h>
 #include <dt-bindings/phy/phy.h>
-#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/spmi/spmi.h>
+#include <dt-bindings/thermal/mediatek,lvts-thermal.h>
+#include <dt-bindings/thermal/thermal.h>
 
 / {
 	compatible = "mediatek,mt6897";
@@ -25,30 +31,78 @@ / {
 
 	interrupt-parent = <&gic>;
 
-	/* 没有时钟驱动前的临时时钟源：给 UART 用，让早期控制台能出字 */
+	vdec_lat_dma: vdec-lat-dma {
+		compatible = "mediatek,mt6897-vdec-lat-dma";
+		iommus = <&disp_iommu MTK_M4U_ID(5, 0)>,
+			 <&disp_iommu MTK_M4U_ID(5, 1)>,
+			 <&disp_iommu MTK_M4U_ID(5, 2)>,
+			 <&disp_iommu MTK_M4U_ID(5, 3)>,
+			 <&disp_iommu MTK_M4U_ID(5, 4)>,
+			 <&disp_iommu MTK_M4U_ID(5, 5)>,
+			 <&disp_iommu MTK_M4U_ID(5, 6)>,
+			 <&disp_iommu MTK_M4U_ID(5, 7)>,
+			 <&disp_iommu MTK_M4U_ID(5, 8)>;
+		status = "disabled";
+	};
+
+	venc_core0_dma: venc-core0-dma {
+		compatible = "mediatek,mt6897-venc-core0-dma";
+		iommus = <&disp_iommu MTK_M4U_ID(7, 0)>,
+			 <&disp_iommu MTK_M4U_ID(7, 1)>,
+			 <&disp_iommu MTK_M4U_ID(7, 2)>,
+			 <&disp_iommu MTK_M4U_ID(7, 3)>,
+			 <&disp_iommu MTK_M4U_ID(7, 4)>,
+			 <&disp_iommu MTK_M4U_ID(7, 5)>,
+			 <&disp_iommu MTK_M4U_ID(7, 6)>,
+			 <&disp_iommu MTK_M4U_ID(7, 10)>,
+			 <&disp_iommu MTK_M4U_ID(7, 11)>,
+			 <&disp_iommu MTK_M4U_ID(7, 12)>,
+			 <&disp_iommu MTK_M4U_ID(7, 13)>,
+			 <&disp_iommu MTK_M4U_ID(7, 14)>,
+			 <&disp_iommu MTK_M4U_ID(7, 15)>,
+			 <&disp_iommu MTK_M4U_ID(7, 19)>,
+			 <&disp_iommu MTK_M4U_ID(7, 20)>,
+			 <&disp_iommu MTK_M4U_ID(7, 21)>,
+			 <&disp_iommu MTK_M4U_ID(7, 22)>,
+			 <&disp_iommu MTK_M4U_ID(7, 23)>,
+			 <&disp_iommu MTK_M4U_ID(7, 24)>,
+			 <&disp_iommu MTK_M4U_ID(7, 25)>,
+			 <&disp_iommu MTK_M4U_ID(7, 26)>,
+			 <&disp_iommu MTK_M4U_ID(7, 31)>;
+		status = "disabled";
+	};
+
+	aliases {
+		spmi0 = &spmi_m;
+		spmi1 = &spmi_p;
+	};
+
+	clk13m: clock-13m {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <13000000>;
+		clock-output-names = "clk13m";
+	};
+
 	clk26m: clock-26m {
 		compatible = "fixed-clock";
 		#clock-cells = <0>;
 		clock-frequency = <26000000>;
+		clock-output-names = "clk26m";
 	};
 
-	/*
-	 * I2C 模块时钟占位（主线暂无 MT6897 topckgen 驱动）。
-	 * i2c-mt65xx 用 clk_get_rate("main") 算分频：SCL = f_real / (2 * div)，
-	 * 而 div 是按 f_assumed 算出来的 ⇒ SCL_actual = 目标频率 × f_real / f_assumed。
-	 * 故意把 f_assumed 取大：真实模块时钟若比它低，实际 SCL 只会更慢（安全方向）。
-	 * 真实频率待 recovery 侧 /sys/kernel/debug/clk/clk_summary 实测后修正。
-	 */
-	i2c_mclk: i2c-mclk {
+
+	clk32k: clock-32k {
 		compatible = "fixed-clock";
 		#clock-cells = <0>;
-		clock-frequency = <26000000>;
+		clock-frequency = <32768>;
 	};
 
 	cpus {
 		#address-cells = <1>;
 		#size-cells = <0>;
 
+
 		cpu-map {
 			cluster0 {
 				core0 { cpu = <&cpu0>; };
@@ -66,56 +120,123 @@ cluster2 {
 			};
 		};
 
-		/* 4x Cortex-A510（厂商 DTB 里每个核各占一个 cluster 位） */
+		/*
+		 * Core-off states of the stock DT (PSCI platform-coordinated
+		 * parameters). Every state stops the local timer, so the system
+		 * timer serves as the broadcast timer. The firmware accepts them
+		 * once the MCUPM boot contact is made. The cluster and MCUSYS off
+		 * states are not enabled yet.
+		 */
+		idle-states {
+			entry-method = "psci";
+
+			cpuoff_l: cpu-off-l {
+				compatible = "arm,idle-state";
+				arm,psci-suspend-param = <0x10000>;
+				local-timer-stop;
+				entry-latency-us = <126>;
+				exit-latency-us = <251>;
+				min-residency-us = <5700>;
+			};
+
+			cpuoff_m: cpu-off-m {
+				compatible = "arm,idle-state";
+				arm,psci-suspend-param = <0x10000>;
+				local-timer-stop;
+				entry-latency-us = <77>;
+				exit-latency-us = <179>;
+				min-residency-us = <2520>;
+			};
+
+			cpuoff_b: cpu-off-b {
+				compatible = "arm,idle-state";
+				arm,psci-suspend-param = <0x10000>;
+				local-timer-stop;
+				entry-latency-us = <52>;
+				exit-latency-us = <129>;
+				min-residency-us = <1890>;
+			};
+		};
+
 		cpu0: cpu@0 {
 			device_type = "cpu";
 			compatible = "arm,cortex-a510";
 			reg = <0x0>;
 			enable-method = "psci";
+			capacity-dmips-mhz = <338>;
+			performance-domains = <&performance 0>;
+			#cooling-cells = <2>;
+			cpu-idle-states = <&cpuoff_l>;
 		};
-		cpu1: cpu@1 {
+		cpu1: cpu@100 {
 			device_type = "cpu";
 			compatible = "arm,cortex-a510";
 			reg = <0x100>;
 			enable-method = "psci";
+			capacity-dmips-mhz = <338>;
+			performance-domains = <&performance 0>;
+			#cooling-cells = <2>;
+			cpu-idle-states = <&cpuoff_l>;
 		};
-		cpu2: cpu@2 {
+		cpu2: cpu@200 {
 			device_type = "cpu";
 			compatible = "arm,cortex-a510";
 			reg = <0x200>;
 			enable-method = "psci";
+			capacity-dmips-mhz = <338>;
+			performance-domains = <&performance 0>;
+			#cooling-cells = <2>;
+			cpu-idle-states = <&cpuoff_l>;
 		};
-		cpu3: cpu@3 {
+		cpu3: cpu@300 {
 			device_type = "cpu";
 			compatible = "arm,cortex-a510";
 			reg = <0x300>;
 			enable-method = "psci";
+			capacity-dmips-mhz = <338>;
+			performance-domains = <&performance 0>;
+			#cooling-cells = <2>;
+			cpu-idle-states = <&cpuoff_l>;
 		};
-
-		/* 3x + 1x Cortex-A715 */
-		cpu4: cpu@100 {
+		cpu4: cpu@400 {
 			device_type = "cpu";
 			compatible = "arm,cortex-a715";
 			reg = <0x400>;
 			enable-method = "psci";
+			capacity-dmips-mhz = <1080>;
+			performance-domains = <&performance 1>;
+			#cooling-cells = <2>;
+			cpu-idle-states = <&cpuoff_m>;
 		};
-		cpu5: cpu@101 {
+		cpu5: cpu@500 {
 			device_type = "cpu";
 			compatible = "arm,cortex-a715";
 			reg = <0x500>;
 			enable-method = "psci";
+			capacity-dmips-mhz = <1080>;
+			performance-domains = <&performance 1>;
+			#cooling-cells = <2>;
+			cpu-idle-states = <&cpuoff_m>;
 		};
-		cpu6: cpu@102 {
+		cpu6: cpu@600 {
 			device_type = "cpu";
 			compatible = "arm,cortex-a715";
 			reg = <0x600>;
 			enable-method = "psci";
+			capacity-dmips-mhz = <1080>;
+			performance-domains = <&performance 1>;
+			#cooling-cells = <2>;
+			cpu-idle-states = <&cpuoff_m>;
 		};
-		cpu7: cpu@200 {
+		cpu7: cpu@700 {
 			device_type = "cpu";
 			compatible = "arm,cortex-a715";
 			reg = <0x700>;
 			enable-method = "psci";
+			capacity-dmips-mhz = <1024>;
+			performance-domains = <&performance 2>;
+			#cooling-cells = <2>;
+			cpu-idle-states = <&cpuoff_b>;
 		};
 	};
 
@@ -135,16 +256,8 @@ timer {
 	};
 
 	/*
-	 * ⚠️ GIC 基址：厂商 DTB 的 /interrupt-controller 是
-	 *      0x0c400000 (dist, 0x40000) + 0x0c440000 (redist, 0x200000)
-	 *    而主线 MTK 全家族（mt6895 / mt8195 / mt8192 / mt8183）都在 0x0c000000，
-	 *    本机另有一个 mediatek,gic500 节点占着 0x0c000000+0x400000。
-	 *
-	 *    这里以厂商 DTB 为准（那是设备真在跑的配置）。
-	 *    若内核起不来（卡在 Calibrating / no timer），把下面两行换成：
-	 *        <0x0 0x0c000000 0x0 0x40000>,
-	 *        <0x0 0x0c040000 0x0 0x200000>;
-	 *    这两种各出一个 dtb 去试，是最经济的排查方式。
+	 * The vendor FDT places the distributor at 0x0c400000, unlike the
+	 * 0x0c000000 used by earlier MediaTek SoCs.
 	 */
 	gic: interrupt-controller@c400000 {
 		compatible = "arm,gic-v3";
@@ -156,273 +269,929 @@ gic: interrupt-controller@c400000 {
 		#redistributor-regions = <1>;
 		interrupt-controller;
 		interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH 0>;
+
