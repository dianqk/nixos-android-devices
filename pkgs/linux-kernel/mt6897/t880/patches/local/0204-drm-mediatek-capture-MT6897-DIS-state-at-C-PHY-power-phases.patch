@@ -258,6 +258,43 @@ int mtk_mmsys_dsi_cphy_config(struct device *dev, bool configure)
 }
 EXPORT_SYMBOL_GPL(mtk_mmsys_dsi_cphy_config);
 
+/**
+ * mtk_mmsys_dsi_cphy_get_state - read MT6897 C-PHY routing and gate state
+ * @dev: DSI controller's parent MMSYS device
+ * @state: receives the routing, configuration-gate and merge-interrupt words
+ *
+ * The caller must hold the DIS parent runtime-PM and configuration-clock
+ * references, as for mtk_mmsys_dsi_cphy_config(). This is a read-only helper
+ * for bounded trial evidence; it does not change hardware state.
+ *
+ * Return: zero on success, or a negative error for an unsupported/unready parent.
+ */
+int mtk_mmsys_dsi_cphy_get_state(struct device *dev,
+				 struct mtk_mmsys_dsi_cphy_state *state)
+{
+	struct mtk_mmsys *mmsys;
+	unsigned long flags;
+
+	if (!state)
+		return -EINVAL;
+	if (!dev || !dev->of_node ||
+	    (!of_device_is_compatible(dev->of_node, "mediatek,mt6897-dispsys0") &&
+	     !of_device_is_compatible(dev->of_node, "mediatek,mt6897-dispsys1")))
+		return -EINVAL;
+	mmsys = dev_get_drvdata(dev);
+	if (!mmsys || !mmsys->data->dsi_cphy_config)
+		return -EPROBE_DEFER;
+
+	spin_lock_irqsave(&mmsys->lock, flags);
+	state->routing_lsb = readl_relaxed(mmsys->regs + MT6897_DSI_SEL_CONFIG_LSB);
+	state->routing_msb = readl_relaxed(mmsys->regs + MT6897_DSI_SEL_CONFIG_MSB);
+	state->cg2 = readl_relaxed(mmsys->regs + MT6897_DISPSYS_CG2);
+	state->intmerge = readl_relaxed(mmsys->regs + MT6897_DISPSYS_INTMERGE);
+	spin_unlock_irqrestore(&mmsys->lock, flags);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_mmsys_dsi_cphy_get_state);
+
 /**
  * mtk_mmsys_hw_connect - Connect MultiMedia Subsystem (MMSYS) Hardware IPs
  * @dev:            Device pointer
diff --git a/include/linux/soc/mediatek/mtk-mmsys.h b/include/linux/soc/mediatek/mtk-mmsys.h
index fe2934f1d1..614eff6799 100644
--- a/include/linux/soc/mediatek/mtk-mmsys.h
+++ b/include/linux/soc/mediatek/mtk-mmsys.h
@@ -9,11 +9,28 @@
 #include <linux/mailbox_controller.h>
 #include <linux/mailbox/mtk-cmdq-mailbox.h>
 #include <linux/soc/mediatek/mtk-cmdq.h>
+#include <linux/types.h>
 
 enum mtk_ddp_comp_id;
 struct device;
 
+/**
+ * struct mtk_mmsys_dsi_cphy_state - MT6897 C-PHY routing and gate evidence
+ * @routing_lsb: DSI lane routing LSB register
+ * @routing_msb: DSI lane routing MSB register
+ * @cg2: configuration gate bank 2 status; the 26M gate is bit 10, active-low
+ * @intmerge: DIS merge-interrupt register
+ */
+struct mtk_mmsys_dsi_cphy_state {
+	u32 routing_lsb;
+	u32 routing_msb;
+	u32 cg2;
+	u32 intmerge;
+};
+
 int mtk_mmsys_dsi_cphy_config(struct device *dev, bool configure);
+int mtk_mmsys_dsi_cphy_get_state(struct device *dev,
+				 struct mtk_mmsys_dsi_cphy_state *state);
 
 enum mtk_dpi_out_format_con {
 	MTK_DPI_RGB888_SDR_CON,
