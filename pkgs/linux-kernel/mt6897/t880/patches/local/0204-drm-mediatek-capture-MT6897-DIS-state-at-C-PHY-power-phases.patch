@@ -1270,6 +1274,36 @@ static void mtk_dsi_irq_data_clear(struct mtk_dsi *dsi, u32 irq_bit)
 	dsi->irq_data &= ~irq_bit;
 }
 
+static void mtk_dsi_dump_mmsys_state(struct mtk_dsi *dsi, const char *phase)
+{
+	struct mtk_mmsys_dsi_cphy_state state;
+	int ret;
+
+	ret = mtk_mmsys_dsi_cphy_get_state(dsi->mmsys_dev, &state);
+	if (ret) {
+		dev_info(dsi->host.dev, "C-PHY state %s: read failed (%d)\n",
+			 phase, ret);
+		return;
+	}
+
+	dev_info(dsi->host.dev,
+		 "C-PHY state %s: route=%08x/%08x cg2=%08x intmerge=%08x\n",
+		 phase, state.routing_lsb, state.routing_msb, state.cg2,
+		 state.intmerge);
+}
+
+static void mtk_dsi_dump_regs(struct mtk_dsi *dsi, const char *phase)
+{
+	const struct mtk_dsi_driver_data *data = dsi->driver_data;
+
+	dev_info(dsi->host.dev,
+		 "C-PHY regs %s: inten=%08x intsta=%08x con=%08x mode=%08x\n",
+		 phase, readl(dsi->regs + data->reg_main[DSI_INTEN]),
+		 readl(dsi->regs + data->reg_main[DSI_INTSTA]),
+		 readl(dsi->regs + data->reg_main[DSI_CON_CTRL]),
+		 readl(dsi->regs + data->reg_main[DSI_MODE_CTRL]));
+}
+
 static s32 mtk_dsi_wait_for_irq_done(struct mtk_dsi *dsi, u32 irq_flag,
 				     unsigned int timeout)
 {
@@ -1283,6 +1317,12 @@ static s32 mtk_dsi_wait_for_irq_done(struct mtk_dsi *dsi, u32 irq_flag,
 	if (ret == 0) {
 		drm_warn(drm, "Wait DSI IRQ(0x%08x) Timeout\n", irq_flag);
 
+		if (dsi->config_clk && !READ_ONCE(dsi->diag_timeout)) {
+			WRITE_ONCE(dsi->diag_timeout, true);
+			mtk_dsi_dump_regs(dsi, "irq-timeout");
+			mtk_dsi_dump_mmsys_state(dsi, "irq-timeout");
+		}
+
 		mtk_dsi_enable(dsi);
 		mtk_dsi_reset_engine(dsi);
 	}
@@ -1352,6 +1392,11 @@ static int mtk_dsi_poweron(struct mtk_dsi *dsi)
 	if (++dsi->refcount != 1)
 		return 0;
 
+	WRITE_ONCE(dsi->diag_pre_26m, false);
+	WRITE_ONCE(dsi->diag_post_route, false);
+	WRITE_ONCE(dsi->diag_first_cmd, false);
+	WRITE_ONCE(dsi->diag_timeout, false);
+
 	ret = mipi_dsi_pixel_format_to_bpp(dsi->format);
 	if (ret < 0) {
 		dev_err(dev, "Unknown MIPI DSI format %d\n", dsi->format);
@@ -1380,12 +1425,20 @@ static int mtk_dsi_poweron(struct mtk_dsi *dsi)
 		ret = clk_prepare_enable(dsi->config_clk);
 		if (ret)
 			goto err_put_mmsys;
+		if (!READ_ONCE(dsi->diag_pre_26m)) {
+			WRITE_ONCE(dsi->diag_pre_26m, true);
+			mtk_dsi_dump_mmsys_state(dsi, "pre-26m");
+		}
 		ret = clk_prepare_enable(dsi->clk26m);
 		if (ret)
 			goto err_disable_config_clk;
 		ret = mtk_mmsys_dsi_cphy_config(dsi->mmsys_dev, true);
 		if (ret)
 			goto err_disable_clk26m;
+		if (!READ_ONCE(dsi->diag_post_route)) {
+			WRITE_ONCE(dsi->diag_post_route, true);
+			mtk_dsi_dump_mmsys_state(dsi, "post-route");
+		}
 	}
 
 	ret = clk_set_rate(dsi->hs_clk, dsi->cphy ? dsi->symbol_rate : dsi->data_rate);
@@ -2079,6 +2132,12 @@ static ssize_t mtk_dsi_host_transfer(struct mipi_dsi_host *host,
 	    (!READ_ONCE(dsi->power_ready) || !READ_ONCE(lead->power_ready)))
 		return -EIO;
 
+	if (dsi->config_clk && !READ_ONCE(dsi->diag_first_cmd)) {
+		WRITE_ONCE(dsi->diag_first_cmd, true);
+		mtk_dsi_dump_regs(dsi, "first-command");
+		mtk_dsi_dump_mmsys_state(dsi, "first-command");
+	}
+
 	dsi_mode = readl(lead->regs + lead->driver_data->reg_main[DSI_MODE_CTRL]);
 	/* Once the bridge is disabled, video stays off (panel off commands) */
 	restore = (dsi_mode & MODE) && lead->enabled;
