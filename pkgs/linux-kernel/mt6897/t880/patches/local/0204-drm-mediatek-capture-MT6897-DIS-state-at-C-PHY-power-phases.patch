 };
 static int writes, offsets[4];
 static bool of_device_is_compatible(const char *node, const char *compatible)
@@ -31,12 +34,18 @@ static void *dev_get_drvdata(struct device *dev)
 }
 #define spin_lock_irqsave(lock, flags) ((void)(lock), (flags) = 0)
 #define spin_unlock_irqrestore(lock, flags) ((void)(lock), (void)(flags))
+static uint32_t readl_relaxed(const void *p)
+{
+	return *(const uint32_t *)p;
+}
 static void mtk_mmsys_update_bits(struct mtk_mmsys *m, unsigned int offset,
 				  unsigned int mask, unsigned int value,
 				  void *packet)
 {
+	uint32_t *word = (uint32_t *)(m->regs + offset);
+
 	offsets[writes++] = offset;
-	m->regs[offset / 4] = (m->regs[offset / 4] & ~mask) | (value & mask);
+	*word = (*word & ~mask) | (value & mask);
 }
 /* PRODUCTION */
 int main(void)
@@ -62,16 +71,49 @@ int main(void)
 		writes = 0;
 		assert(!mtk_mmsys_dsi_cphy_config(&d, false) && !writes);
 		for (int cycle = 0; cycle < 2; cycle++) {
-			m.regs[0x170 / 4] = 0xa5ffffff;
-			m.regs[0x174 / 4] = 0xfff8888e;
+			uint32_t *lsb = (uint32_t *)(m.regs + 0x170);
+			uint32_t *msb = (uint32_t *)(m.regs + 0x174);
+
+			*lsb = 0xa5ffffff;
+			*msb = 0xfff8888e;
 			writes = 0;
 			assert(!mtk_mmsys_dsi_cphy_config(&d, true));
 			assert(writes == 2 && offsets[0] == 0x174 &&
 			       offsets[1] == 0x170);
-			assert(m.regs[0x170 / 4] == 0xa5f00000);
-			assert(m.regs[0x174 / 4] == (0xfff8888e | 0x62101));
+			assert(*lsb == 0xa5f00000);
+			assert(*msb == (0xfff8888e | 0x62101));
 			/* Repeat after simulated context loss, preserving new reserved bits. */
 		}
 	}
-	puts("MMSYS routing: both banks, validation purity, reserved bits and restore order passed");
+	struct mtk_mmsys_dsi_cphy_state st;
+	int state_writes = writes;
+
+	assert(mtk_mmsys_dsi_cphy_get_state(NULL, &st) == -EINVAL);
+	d.of_node = NULL;
+	assert(mtk_mmsys_dsi_cphy_get_state(&d, &st) == -EINVAL);
+	d.of_node = "mediatek,mt6897-ovlsys0";
+	assert(mtk_mmsys_dsi_cphy_get_state(&d, &st) == -EINVAL);
+	assert(mtk_mmsys_dsi_cphy_get_state(&d, NULL) == -EINVAL);
+	for (int bank = 0; bank < 2; bank++) {
+		d.of_node = bank ? "mediatek,mt6897-dispsys1" :
+				   "mediatek,mt6897-dispsys0";
+		d.data = NULL;
+		assert(mtk_mmsys_dsi_cphy_get_state(&d, &st) == -EPROBE_DEFER);
+		d.data = &m;
+		m.data = &unsupported;
+		assert(mtk_mmsys_dsi_cphy_get_state(&d, &st) == -EPROBE_DEFER);
+		m.data = &supported;
+		*(uint32_t *)(m.regs + 0x170) = 0x12345678;
+		*(uint32_t *)(m.regs + 0x174) = 0x9abcdef0;
+		*(uint32_t *)(m.regs + 0x1a0) = 0xfffffbff;
+		*(uint32_t *)(m.regs + 0x008) = 0x00000000;
+		state_writes = writes;
+		assert(!mtk_mmsys_dsi_cphy_get_state(&d, &st));
+		assert(st.routing_lsb == 0x12345678);
+		assert(st.routing_msb == 0x9abcdef0);
+		assert(st.cg2 == 0xfffffbff);
+		assert(st.intmerge == 0x00000000);
+		assert(writes == state_writes);
+	}
+	puts("MMSYS routing: both banks, validation purity, reserved bits, restore order and state reads passed");
 }
