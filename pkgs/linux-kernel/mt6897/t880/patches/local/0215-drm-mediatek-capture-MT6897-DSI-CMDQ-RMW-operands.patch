From 119c7058ef4b5d76b5673e896ee0cdc58f2a3656 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Sat, 7 Nov 2026 21:41:52 +0800
Subject: [PATCH 216/216] drm/mediatek: capture MT6897 DSI CMDQ RMW operands

Record the value returned by the existing command RMW read and the full word passed to writel. Preserve data/header/size ordering and one read/write per operation, and use the existing bounded timeout ring without success logging. Limit operand capture to the config-clock diagnostic path; other controllers keep the original mask helper.

Exercise production helpers against a mock bus for read, short and long messages, size selection, stale reads, outside-mask bits, ring wrap and reset. The observer adds CPU work and does not establish hardware acceptance.
---
 drivers/gpu/drm/mediatek/mtk_dsi.c            |  44 ++++--
 .../selftests/mtk_clk/dsi_routing_cases.c     | 129 +++++++++++++++++-
 .../selftests/mtk_clk/test_dsi_routing.py     |  15 +-
 3 files changed, 165 insertions(+), 23 deletions(-)

diff --git a/drivers/gpu/drm/mediatek/mtk_dsi.c b/drivers/gpu/drm/mediatek/mtk_dsi.c
index cef1472146..ba7fca7fae 100644
--- a/drivers/gpu/drm/mediatek/mtk_dsi.c
+++ b/drivers/gpu/drm/mediatek/mtk_dsi.c
@@ -342,7 +342,9 @@ enum mtk_dsi_cmdq_write_kind {
  * @kind: data, config, size or size-select write
  * @offset: target register offset
  * @mask: write mask
- * @value: write value
+ * @value: masked write argument
+ * @old: value returned by the existing RMW read
+ * @new: full word passed to writel
  */
 struct mtk_dsi_cmdq_write {
 	u32 cmd;
@@ -352,6 +354,8 @@ struct mtk_dsi_cmdq_write {
 	u16 offset;
 	u32 mask;
 	u32 value;
+	u32 old;
+	u32 new;
 };
 
 struct mtk_dsi_driver_data {
@@ -1440,7 +1444,7 @@ static u8 mtk_dsi_msg_tx(const struct mipi_dsi_msg *msg, size_t index)
 static void mtk_dsi_record_cmdq_write(struct mtk_dsi *dsi,
 				      const struct mipi_dsi_msg *msg,
 				      u16 offset, u32 mask, u32 value,
-				      u8 kind)
+				      u8 kind, u32 old, u32 new)
 {
 	struct mtk_dsi_cmdq_write *rec =
 		&dsi->cmdq_write_ring[dsi->cmdq_write_head];
@@ -1452,12 +1456,32 @@ static void mtk_dsi_record_cmdq_write(struct mtk_dsi *dsi,
 	rec->offset = offset;
 	rec->mask = mask;
 	rec->value = value;
+	rec->old = old;
+	rec->new = new;
 	dsi->cmdq_write_head = (dsi->cmdq_write_head + 1) %
 			       MTK_DSI_CMDQ_WRITE_RING_SIZE;
 	if (dsi->cmdq_write_count < MTK_DSI_CMDQ_WRITE_RING_SIZE)
 		dsi->cmdq_write_count++;
 }
 
+/* Keep the command RMW bus accesses identical; retain their actual operands. */
+static void mtk_dsi_cmdq_mask(struct mtk_dsi *dsi,
+			      const struct mipi_dsi_msg *msg,
+			      u16 offset, u32 mask, u32 value, u8 kind)
+{
+	u32 old, new;
+
+	if (!dsi->config_clk) {
+		mtk_dsi_mask(dsi, offset, mask, value);
+		return;
+	}
+
+	old = readl(dsi->regs + offset);
+	new = (old & ~mask) | (value & mask);
+	writel(new, dsi->regs + offset);
+	mtk_dsi_record_cmdq_write(dsi, msg, offset, mask, value, kind, old, new);
+}
+
 static void mtk_dsi_record_cmd(struct mtk_dsi *dsi,
 			       const struct mipi_dsi_msg *msg, u32 pre_intsta,
 			       u32 post_start_intsta, u32 post_done_intsta,
@@ -1529,10 +1553,10 @@ static void mtk_dsi_dump_cmdq_writes(struct mtk_dsi *dsi, const char *phase)
 		rec = &dsi->cmdq_write_ring[(start + i) %
 					    MTK_DSI_CMDQ_WRITE_RING_SIZE];
 		dev_info(dsi->host.dev,
-			 "C-PHY cmdq-write %s[%u]: cmd=%u type=%u tx_len=%zu kind=%s offset=%04x mask=%08x value=%08x\n",
+			 "C-PHY cmdq-write %s[%u]: cmd=%u type=%u tx_len=%zu kind=%s offset=%04x mask=%08x value=%08x old=%08x new=%08x\n",
 			 phase, i, rec->cmd, rec->type, rec->tx_len,
 			 kind_name[rec->kind], rec->offset, rec->mask,
-			 rec->value);
+			 rec->value, rec->old, rec->new);
 	}
 }
 
@@ -2384,25 +2408,21 @@ static void mtk_dsi_cmdq(struct mtk_dsi *dsi, const struct mipi_dsi_msg *msg)
 		offset = (data->reg_adv[DSI_CMDQ] + cmdq_off + i) & (~0x3U);
 		mask = 0xffUL << (((i + cmdq_off) & 3U) * 8U);
 		value = tx_buf[i] << (((i + cmdq_off) & 3U) * 8U);
-		mtk_dsi_record_cmdq_write(dsi, msg, offset, mask, value,
+		mtk_dsi_cmdq_mask(dsi, msg, offset, mask, value,
 					  MTK_DSI_CMDQ_WRITE_DATA);
-		mtk_dsi_mask(dsi, offset, mask, value);
 	}
 
-	mtk_dsi_record_cmdq_write(dsi, msg, data->reg_adv[DSI_CMDQ], cmdq_mask,
+	mtk_dsi_cmdq_mask(dsi, msg, data->reg_adv[DSI_CMDQ], cmdq_mask,
 				  reg_val, MTK_DSI_CMDQ_WRITE_CONFIG);
-	mtk_dsi_mask(dsi, data->reg_adv[DSI_CMDQ], cmdq_mask, reg_val);
-	mtk_dsi_record_cmdq_write(dsi, msg, data->reg_main[DSI_CMDQ_SIZE],
+	mtk_dsi_cmdq_mask(dsi, msg, data->reg_main[DSI_CMDQ_SIZE],
 				  CMDQ_SIZE, cmdq_size,
 				  MTK_DSI_CMDQ_WRITE_SIZE);
-	mtk_dsi_mask(dsi, data->reg_main[DSI_CMDQ_SIZE], CMDQ_SIZE, cmdq_size);
 	if (data->cmdq_long_packet_ctl) {
 		/* Disable setting cmdq_size automatically for long packets */
-		mtk_dsi_record_cmdq_write(dsi, msg,
+		mtk_dsi_cmdq_mask(dsi, msg,
 					  data->reg_main[DSI_CMDQ_SIZE],
 					  CMDQ_SIZE_SEL, CMDQ_SIZE_SEL,
 					  MTK_DSI_CMDQ_WRITE_SIZE_SEL);
-		mtk_dsi_mask(dsi, data->reg_main[DSI_CMDQ_SIZE], CMDQ_SIZE_SEL, CMDQ_SIZE_SEL);
 	}
 }
 
