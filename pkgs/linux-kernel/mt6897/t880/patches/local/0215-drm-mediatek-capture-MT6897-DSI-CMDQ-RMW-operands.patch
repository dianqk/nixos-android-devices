+static u32 *stale_address;
+static u32 stale_value;
+static int bus_count;
+static struct { u32 *address; u32 old, value; } bus[512];
+static u32 last_read;
 static u32 readl(u32 *p)
 {
 	reg_reads++;
-	return *p;
+	last_read = p == stale_address ? stale_value : *p;
+	return last_read;
 }
 #define msecs_to_jiffies(x) (x)
 #define wait_event_interruptible_timeout(q, cond, timeout) \
@@ -333,6 +334,11 @@ static u32 readl(u32 *p)
 	   (cond) ? 0 : -ETIME; })
 static void writel(u32 v, u32 *p)
 {
+	if (bus_count < (int)ARRAY_SIZE(bus)) {
+		bus[bus_count].address = p;
+		bus[bus_count].old = last_read;
+		bus[bus_count++].value = v;
+	}
 	*p = v;
 	writes++;
 }
@@ -358,8 +364,26 @@ static u8 readb(void *p)
 {
 	return *(u8 *)p;
 }
+static void production_mask(struct mtk_dsi *, u32, u32, u32);
+static void production_cmdq_mask(struct mtk_dsi *, const struct mipi_dsi_msg *,
+				 u16, u32, u32, u8);
+static void mtk_dsi_mask(struct mtk_dsi *d, u32 reg, u32 mask, u32 value)
+{
+	if (mask_count < (int)ARRAY_SIZE(mask_calls))
+		mask_calls[mask_count++] = (struct mask_call){ reg, mask, value };
+	production_mask(d, reg, mask, value);
+}
+static void mtk_dsi_cmdq_mask(struct mtk_dsi *d, const struct mipi_dsi_msg *msg,
+			    u16 reg, u32 mask, u32 value, u8 kind)
+{
+	if (d->config_clk && mask_count < (int)ARRAY_SIZE(mask_calls))
+		mask_calls[mask_count++] = (struct mask_call){ reg, mask, value };
+	production_cmdq_mask(d, msg, reg, mask, value, kind);
+}
+
 /* PRODUCTION */
 
+
 static struct mtk_dsi d[2];
 static struct device dev[2];
 static const u8 tx_payload[] = { 0xfb, 0x01, 0x33, 0x03 };
@@ -387,6 +411,8 @@ static void setup(bool dual)
 	state_reads = reg_reads = timeout_ret = 0;
 	poll_calls = idle_waits = irq_waits = 0;
 	mask_count = 0;
+	bus_count = 0;
+	stale_address = NULL;
 	reset_engine_calls = 0;
 	log_count = dump_log_count = clk_rate_calls = 0;
 	poll_intsta = 0;
@@ -424,8 +450,86 @@ static void balanced(void)
 			assert(!clocks[i][j].refs);
 	}
 }
+/* Compare trace operands to real mock bus writes, including stale RMW reads. */
+static void test_cmdq_operands(void)
+{
+	for (int ctl = 0; ctl < 2; ctl++) {
+		for (int form = 0; form < 4; form++) {
+			struct mipi_dsi_msg msg = {
+				.type = form == 3 ? 1 : 0x29, /* host read in this mock */
+				.tx_len = form == 3 ? 1 : form == 2 ? 4 : form,
+				.tx_buf = tx_payload,
+			};
+			u32 expected[16], offsets[16];
+			int count = 0;
+
+			/* No diagnostic: the production RMW helper is the control. */
+			setup(false);
+			d[0].driver_data = ctl ? &poll_data : &data;
+			d[0].config_clk = NULL;
+			for (int i = 0; i < (int)ARRAY_SIZE(regs[0]); i++)
+				regs[0][i] = 0xa5a55a5a;
+			mtk_dsi_cmdq(&d[0], &msg);
+			count = bus_count;
+			assert(count == (int)msg.tx_len + 2 + ctl);
+			assert(reg_reads == count && writes == count);
+			assert(!d[0].cmdq_write_count && !log_count);
+			for (int i = 0; i < count; i++) {
+				expected[i] = bus[i].value;
+				offsets[i] = bus[i].address - regs[0];
+			}
+
+			setup(false);
+			d[0].driver_data = ctl ? &poll_data : &data;
+			for (int i = 0; i < (int)ARRAY_SIZE(regs[0]); i++)
+				regs[0][i] = 0xa5a55a5a;
+			mtk_dsi_cmdq(&d[0], &msg);
+			assert(bus_count == count && reg_reads == count && writes == count);
+			assert(d[0].cmdq_write_count == count && !log_count);
+			for (int i = 0; i < count; i++) {
+				struct mtk_dsi_cmdq_write *w = &d[0].cmdq_write_ring[i];
+				assert(bus[i].value == expected[i]);
+				assert(bus[i].address == regs[0] + offsets[i]);
+				assert(w->old == bus[i].old && w->new == bus[i].value);
+			}
+		}
+	}
+
+	setup(false);
+	struct mipi_dsi_msg msg = { .type = 0x29 };
+	stale_address = regs[0] + 0x14;
+	stale_value = 0xdeadbeef;
+	*stale_address = 0x11223344;
+	/* Bits outside mask must not enter the full bus word. */
+	mtk_dsi_cmdq_mask(&d[0], &msg, 0x14, 0xff00, 0x12345678,
+			  MTK_DSI_CMDQ_WRITE_DATA);
+	assert(reg_reads == 1 && writes == 1 && bus_count == 1);
+	assert(d[0].cmdq_write_ring[0].old == 0xdeadbeef);
+	assert(d[0].cmdq_write_ring[0].new == 0xdead56ef);
+	assert(bus[0].value == 0xdead56ef && *stale_address == 0xdead56ef);
+	/* A later mutation is not misrepresented as the word actually written. */
+	*stale_address = 0xbc;
+	assert(d[0].cmdq_write_ring[0].new != *stale_address);
+	stale_address = NULL;
+	for (int i = 0; i < 80; i++)
+		mtk_dsi_cmdq_mask(&d[0], &msg, 0x14, 0xff, i,
+				  MTK_DSI_CMDQ_WRITE_DATA);
+	assert(d[0].cmdq_write_count == 64 && d[0].cmdq_write_head == 17);
+	assert(!log_count && reg_reads == 81 && writes == 81);
+	setup(false);
+	d[0].cmdq_write_count = 64;
+	d[0].cmdq_write_head = 17;
+	d[0].cmdq_write_seq = 99;
+	assert(!mtk_dsi_poweron(&d[0]));
+	assert(!d[0].cmdq_write_count && !d[0].cmdq_write_head &&
+	       !d[0].cmdq_write_seq);
+	mtk_dsi_poweroff(&d[0]);
+	balanced();
+}
+
 int main(void)
 {
+	test_cmdq_operands();
 	setup(true);
 	assert(!mtk_dsi_poweron(&d[0]));
 	int operations = calls;
@@ -564,6 +668,7 @@ int main(void)
 	struct mipi_dsi_msg short_msg = { .type = 0x23, .tx_len = 2,
 					  .tx_buf = tx_payload };
 	mask_count = 0;
+	bus_count = 0;
 	mtk_dsi_cmdq(&d[0], &short_msg);
 	int saw_size = 0;
 	for (int i = 0; i < mask_count; i++)
@@ -578,6 +683,7 @@ int main(void)
 	struct mipi_dsi_msg long_msg = { .type = 0x29, .tx_len = 3,
 					 .tx_buf = tx_payload };
 	mask_count = 0;
+	bus_count = 0;
 	mtk_dsi_cmdq(&d[0], &long_msg);
 	assert(mask_calls[mask_count - 1].reg ==
 	       poll_data.reg_main[DSI_CMDQ_SIZE]);
@@ -593,6 +699,7 @@ int main(void)
 	d[0].cmdq_write_head = d[0].cmdq_write_count = 0;
 	d[0].cmdq_write_seq = 0;
 	mask_count = 0;
+	bus_count = 0;
 	mtk_dsi_cmdq(&d[0], &short_msg);
 	struct mtk_dsi_cmdq_write *w = d[0].cmdq_write_ring;
 	assert(d[0].cmdq_write_count == 5 && mask_count == 5);
@@ -613,12 +720,16 @@ int main(void)
 		assert(mask_calls[i].reg == w[i].offset &&
 		       (u32)mask_calls[i].mask == w[i].mask &&
 		       (u32)mask_calls[i].value == w[i].value);
+		assert(bus[i].old == w[i].old && bus[i].value == w[i].new);
+		assert(w[i].new == ((w[i].old & ~w[i].mask) |
+				    (w[i].value & w[i].mask)));
 	}
 	setup(false);
 	d[0].driver_data = &poll_data;
 	d[0].cmdq_write_head = d[0].cmdq_write_count = 0;
 	d[0].cmdq_write_seq = 0;
 	mask_count = 0;
+	bus_count = 0;
 	mtk_dsi_cmdq(&d[0], &long_msg);
 	w = d[0].cmdq_write_ring;
 	assert(d[0].cmdq_write_count == 6 && mask_count == 6);
@@ -640,6 +751,9 @@ int main(void)
 		assert(mask_calls[i].reg == w[i].offset &&
 		       (u32)mask_calls[i].mask == w[i].mask &&
 		       (u32)mask_calls[i].value == w[i].value);
+		assert(bus[i].old == w[i].old && bus[i].value == w[i].new);
+		assert(w[i].new == ((w[i].old & ~w[i].mask) |
+				    (w[i].value & w[i].mask)));
 	}
 	setup(false);
 	d[0].driver_data = &v1_data;
@@ -658,6 +772,7 @@ int main(void)
 	assert(d[0].cmd_ring_count == 1 && d[0].cmd_ring[0].cmdq1 == 0);
 	setup(false);
 	mask_count = 0;
+	bus_count = 0;
 	mtk_dsi_cmdq(&d[0], &short_msg);
 	for (int i = 0; i < mask_count; i++)
 		assert(mask_calls[i].mask != CMDQ_SIZE_SEL);
