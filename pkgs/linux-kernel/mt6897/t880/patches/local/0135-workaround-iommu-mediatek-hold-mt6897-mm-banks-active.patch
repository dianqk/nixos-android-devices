From 3758d49a03e68b0a6840c484f5ea346ba771fa05 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Fri, 6 Nov 2026 10:00:00 +0800
Subject: [PATCH] workaround: iommu: mediatek: hold MT6897 MM banks active

Keep the display MM IOMMUs runtime-active from probe because physical
scanout still traverses them without a translated master PM dependency.

Original-Commit: local development history
Original-Author: dianqk <dianqk@dianqk.net>
Original-Date: 2026-10-18T17:47:53+08:00
Signed-off-by: dianqk <dianqk@dianqk.net>
---
 drivers/iommu/mtk_iommu.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/iommu/mtk_iommu.c b/drivers/iommu/mtk_iommu.c
index 5fbbbf8bdf..b804720410 100644
--- a/drivers/iommu/mtk_iommu.c
+++ b/drivers/iommu/mtk_iommu.c
@@ -2273,7 +2273,7 @@ static const struct mtk_iommu_plat_data mt6897_data_disp = {
 	.flags		= HAS_BCLK | HAS_SUB_COMM_3BITS | OUT_ORDER_WR_EN |
 			  IOVA_34_EN | SHARE_PGTABLE | PGTABLE_PA_35_EN |
 			  DL_WITH_MULTI_LARB | HYP_PGTABLE_TYPE2 |
-			  MTK_IOMMU_TYPE_MM,
+			  PM_HOLD_FROM_PROBE | MTK_IOMMU_TYPE_MM,
 	.hw_list	= &m4ulist,
 	.inv_sel_reg	= REG_MMU_INV_SEL_GEN2,
 	.banks_num	= 1,
@@ -2291,7 +2291,7 @@ static const struct mtk_iommu_plat_data mt6897_data_mdp = {
 	.flags		= HAS_BCLK | HAS_SUB_COMM_3BITS | OUT_ORDER_WR_EN |
 			  IOVA_34_EN | SHARE_PGTABLE | PGTABLE_PA_35_EN |
 			  DL_WITH_MULTI_LARB | HYP_PGTABLE_TYPE2 |
-			  MTK_IOMMU_TYPE_MM,
+			  PM_HOLD_FROM_PROBE | MTK_IOMMU_TYPE_MM,
 	.hw_list	= &m4ulist,
 	.inv_sel_reg	= REG_MMU_INV_SEL_GEN2,
 	.banks_num	= 1,
-- 
2.56.0

