From daa44e3a968711e5fe623f04fcbec2b29739ba88 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Fri, 6 Nov 2026 10:00:00 +0800
Subject: [PATCH] dt-bindings: mediatek: describe MT6897 pinctrl resources

Describe the MT6897 pinctrl compatibles, resource limits and constants
used by the corresponding controllers and device trees.

Original-Commit: local development history
Original-Author: dianqk <dianqk@dianqk.net>
Original-Date: 2026-10-15T18:07:15+08:00
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: dianqk <dianqk@dianqk.net>
---
 .../pinctrl/mediatek,mt6897-pinctrl.yaml      | 83 +++++++++++++++++++
 1 file changed, 83 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/pinctrl/mediatek,mt6897-pinctrl.yaml

diff --git a/Documentation/devicetree/bindings/pinctrl/mediatek,mt6897-pinctrl.yaml b/Documentation/devicetree/bindings/pinctrl/mediatek,mt6897-pinctrl.yaml
new file mode 100644
index 0000000000..cd9e5eeee6
--- /dev/null
+++ b/Documentation/devicetree/bindings/pinctrl/mediatek,mt6897-pinctrl.yaml
@@ -0,0 +1,83 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/pinctrl/mediatek,mt6897-pinctrl.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6897 Pin Controller
+
+maintainers:
+  - dianqk <dianqk@dianqk.net>
+
+description:
+  GPIO and external interrupt (EINT) controller of the MediaTek MT6897. The
+  EINT block has five instances (e, s, w, n, c).
+
+properties:
+  compatible:
+    const: mediatek,mt6897-pinctrl
+
+  reg:
+    items:
+      - description: gpio base
+      - description: rt group IO
+      - description: rm group IO
+      - description: bl group IO
+      - description: bm group IO
+      - description: br group IO
+      - description: lb group IO
+      - description: lt group IO
+      - description: tm group IO
+      - description: tl group IO
+      - description: eint-e
+      - description: eint-s
+      - description: eint-w
+      - description: eint-n
+      - description: eint-c
+
+  reg-names:
+    items:
+      - const: gpio
+      - const: iocfg_rt
+      - const: iocfg_rm
+      - const: iocfg_bl
+      - const: iocfg_bm
+      - const: iocfg_br
+      - const: iocfg_lb
+      - const: iocfg_lt
+      - const: iocfg_tm
+      - const: iocfg_tl
+      - const: eint-e
+      - const: eint-s
+      - const: eint-w
+      - const: eint-n
+      - const: eint-c
+
+  interrupts:
+    maxItems: 1
+
+  interrupt-controller: true
+
+  '#interrupt-cells':
+    const: 2
+
+  gpio-controller: true
+
+  '#gpio-cells':
+    const: 2
+
+  gpio-ranges:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - interrupt-controller
+  - '#interrupt-cells'
+  - gpio-controller
+  - '#gpio-cells'
+  - gpio-ranges
+
+additionalProperties: false
-- 
2.56.0

