From a44ef6a70f082ded908c965aa9ef4c2c602bb6a4 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Fri, 6 Nov 2026 16:21:30 +0800
Subject: [PATCH] dt-bindings: display: mediatek: describe MT6897 boot DMA
 ownership

Describe the independent inherited-display owner, its complete OVL register
coverage and physical SMI suppliers. Allow MT6897 OVL power dependencies
without requiring translated IOMMU attachment.

Link: https://github.com/MiCode/MTK_kernel_device_modules/tree/3c4ccd07d5624879555ec710c11bb8818e5cb5c6
Signed-off-by: dianqk <dianqk@dianqk.net>
---
 .../mediatek,mt6897-display-boot-state.yaml   | 80 +++++++++++++++++++
 .../display/mediatek/mediatek,ovl-2l.yaml     | 25 +++++-
 2 files changed, 104 insertions(+), 1 deletion(-)
 create mode 100644 Documentation/devicetree/bindings/display/mediatek/mediatek,mt6897-display-boot-state.yaml

diff --git a/Documentation/devicetree/bindings/display/mediatek/mediatek,mt6897-display-boot-state.yaml b/Documentation/devicetree/bindings/display/mediatek/mediatek,mt6897-display-boot-state.yaml
new file mode 100644
index 0000000000..90663f5a64
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/mediatek/mediatek,mt6897-display-boot-state.yaml
@@ -0,0 +1,80 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/mediatek/mediatek,mt6897-display-boot-state.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6897 inherited display DMA owner
+
+maintainers:
+  - dianqk <dianqk@dianqk.net>
+
+description: |
+  An independent, built-in owner protects inherited display DMA through DRM
+  component probe and binding. It covers all seven represented OVL engines,
+  both physical SMI paths per engine and the source-verified non-fetching state
+  of unrepresented OVL7 and POSTMASKs. It does not select address translation.
+  Unknown active state retains the acquired resources until reboot.
+
+properties:
+  compatible:
+    const: mediatek,mt6897-display-boot-state
+
+  reg:
+    minItems: 3
+    maxItems: 3
+
+  reg-names:
+    items:
+      - const: unowned-ovl
+      - const: postmask0
+      - const: postmask1
+
+  clocks:
+    minItems: 3
+    maxItems: 3
+
+  clock-names:
+    items:
+      - const: ovl7
+      - const: postmask0
+      - const: postmask1
+
+  power-domains:
+    maxItems: 1
+
+  mediatek,iommus:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    minItems: 2
+    maxItems: 2
+    items:
+      maxItems: 1
+    description: Display and MDP IOMMU providers whose initial guards transfer.
+
+  mediatek,gce:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: GCE_D whose inherited firmware DMA ownership must be qualified.
+
+  mediatek,engines:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    minItems: 7
+    maxItems: 7
+    items:
+      maxItems: 1
+    description: |
+      The seven OVL nodes, in register order 14402000, 14403000, 14404000,
+      14405000, 14602000, 14603000 and 14604000. Each has two distinct
+      mediatek,smi physical larb suppliers independent of its IOMMU ports.
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - clocks
+  - clock-names
+  - power-domains
+  - mediatek,iommus
+  - mediatek,gce
+  - mediatek,engines
+
+additionalProperties: false
diff --git a/Documentation/devicetree/bindings/display/mediatek/mediatek,ovl-2l.yaml b/Documentation/devicetree/bindings/display/mediatek/mediatek,ovl-2l.yaml
index 792769f31e..46c6831d3f 100644
--- a/Documentation/devicetree/bindings/display/mediatek/mediatek,ovl-2l.yaml
+++ b/Documentation/devicetree/bindings/display/mediatek/mediatek,ovl-2l.yaml
@@ -94,13 +94,24 @@ properties:
       Boot framebuffer reservation shared by multimedia DMA clients. Matching
       iommu-addresses reserve its identity IOVAs before the first allocation.
 
+  mediatek,boot-handover:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Independent inherited DMA owner for this engine.
+
+  mediatek,smi:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    minItems: 2
+    maxItems: 2
+    items:
+      maxItems: 1
+    description: Both physical SMI larbs, independent of address translation.
+
 required:
   - compatible
   - reg
   - interrupts
   - power-domains
   - clocks
-  - iommus
 
 allOf:
   - if:
@@ -110,12 +121,24 @@ allOf:
             contains:
               const: mediatek,mt6897-disp-ovl-2l
     then:
+      required:
+        - iommus
       properties:
         iommus:
           maxItems: 2
 
 additionalProperties: false
 
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: mediatek,mt6897-disp-ovl-2l
+    then:
+      anyOf:
+        - required: [iommus]
+        - required: ["mediatek,boot-handover", "mediatek,smi"]
+
 examples:
   - |
     #include <dt-bindings/interrupt-controller/arm-gic.h>
-- 
2.56.0

