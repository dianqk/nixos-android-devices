From deab9e18b24098757d3476b96ccf21616e5568c0 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Sat, 7 Nov 2026 04:45:51 +0800
Subject: [PATCH] dt-bindings: display: mediatek: describe MT6897 DSI 26M clock

Allow a fifth, named DIS common 26 MHz gate for MT6897 DSI. C-PHY links own it across the link power session; D-PHY and other SoCs retain their existing three-clock interface.

Signed-off-by: dianqk <dianqk@dianqk.net>
---
 .../devicetree/bindings/display/mediatek/mediatek,dsi.yaml  | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/Documentation/devicetree/bindings/display/mediatek/mediatek,dsi.yaml b/Documentation/devicetree/bindings/display/mediatek/mediatek,dsi.yaml
index 05806a4bcf..d391e0af9a 100644
--- a/Documentation/devicetree/bindings/display/mediatek/mediatek,dsi.yaml
+++ b/Documentation/devicetree/bindings/display/mediatek/mediatek,dsi.yaml
@@ -27,10 +27,10 @@ allOf:
       properties:
         clocks:
           minItems: 3
-          maxItems: 4
+          maxItems: 5
         clock-names:
           minItems: 3
-          maxItems: 4
+          maxItems: 5
     else:
       properties:
         clocks:
@@ -78,6 +78,7 @@ properties:
       - description: Digital Clock
       - description: HS Clock
       - description: MMSYS configuration clock, required for MT6897 C-PHY routing
+      - description: DIS common 26 MHz gate, owned across the MT6897 C-PHY link power session
 
   clock-names:
     minItems: 3
@@ -86,6 +87,7 @@ properties:
       - const: digital
       - const: hs
       - const: config
+      - const: 26m
 
   resets:
     maxItems: 1
-- 
2.56.0

