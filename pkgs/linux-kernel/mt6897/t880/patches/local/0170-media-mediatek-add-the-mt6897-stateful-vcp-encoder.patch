diff --git a/drivers/media/platform/mediatek/vcodec/vcp/mtk_vcp_venc_mt6897_abi.h b/drivers/media/platform/mediatek/vcodec/vcp/mtk_vcp_venc_mt6897_abi.h
new file mode 100644
index 0000000000..233927a16c
--- /dev/null
+++ b/drivers/media/platform/mediatek/vcodec/vcp/mtk_vcp_venc_mt6897_abi.h
@@ -0,0 +1,212 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Copyright (c) 2016 MediaTek Inc.
+ * Authors: Jungchang Tsao <jungchang.tsao@mediatek.com>,
+ * Daniel Hsiao <daniel.hsiao@mediatek.com>, Tiffany Lin <tiffany.lin@mediatek.com>,
+ * PC Chen <pc.chen@mediatek.com>
+ * Source: https://github.com/MiCode/MTK_kernel_device_modules/tree/3c4ccd07d5624879555ec710c11bb8818e5cb5c6/drivers/media/platform/mtk-vcodec
+ * Local adaptation: explicit encoder QUERY/INIT/CONFIG wire views, verified against the
+ * shipping MT6897 encoder module. Encoder cookie/status offsets differ from
+ * the decoder protocol. CONFIG writes only individually mapped fields; gaps
+ * and firmware-owned state are preserved.
+ */
+#ifndef __MTK_VCP_VENC_MT6897_ABI_H
+#define __MTK_VCP_VENC_MT6897_ABI_H
+#include <linux/build_bug.h>
+#include <linux/byteorder/generic.h>
+#include <linux/stddef.h>
+#include <linux/types.h>
+#define MT6897_VENC_CAPS 64
+#define MT6897_VENC_INIT 0x1000
+#define MT6897_VENC_CONFIG 0x1001
+#define MT6897_VENC_CONFIG_DONE 0x2001
+#define MT6897_VENC_CONFIG_EXTENT 2732
+#define MT6897_VENC_DEINIT 0x1003
+#define MT6897_VENC_INIT_DONE 0x2000
+#define MT6897_VENC_DEINIT_DONE 0x2003
+#define MT6897_VENC_QUERY 0x1004
+#define MT6897_VENC_QUERY_DONE 0x2004
+#define MT6897_VENC_MEM_ALLOC 0x3003
+#define MT6897_VENC_MEM_FREE 0x3004
+struct mt6897_venc_prefix {
+	__le32 id, ctx;
+	__le64 cookie;
+	__le32 status, reserved;
+};
+/* INIT uses host cookie at byte 8; DEINIT replaces it with the firmware
+ * instance token. The remaining eight request bytes are reserved. */
+struct mt6897_venc_command {
+	__le32 id, ctx;
+	__le64 instance, reserved;
+};
+struct mt6897_venc_config {
+	__le32 id, ctx;
+	__le64 instance;
+	__le32 parameter, count, data[8], reserved[2];
+};
+static_assert(sizeof(struct mt6897_venc_config) == 64);
+static_assert(offsetof(struct mt6897_venc_config, parameter) == 16);
+static_assert(offsetof(struct mt6897_venc_config, data) == 24);
+struct mt6897_venc_init_ack {
+	struct mt6897_venc_prefix header;
+	__le64 instance;
+};
+struct mt6897_venc_callback {
+	struct mt6897_venc_prefix header;
+	__le32 data[2];
+};
+static_assert(sizeof(struct mt6897_venc_command) == 24);
+static_assert(offsetof(struct mt6897_venc_command, instance) == 8);
+static_assert(sizeof(struct mt6897_venc_init_ack) == 32);
+static_assert(offsetof(struct mt6897_venc_init_ack, instance) == 24);
+static_assert(sizeof(struct mt6897_venc_callback) == 32);
+struct mt6897_venc_query {
+	struct mt6897_venc_prefix header;
+	__le64 data_cookie;
+	__le32 query, reserved;
+};
+struct mt6897_venc_query_ack {
+	struct mt6897_venc_prefix header;
+	__le64 data_cookie, address;
+	__le32 query, reserved;
+};
+struct mt6897_venc_memory {
+	struct mt6897_venc_prefix header;
+	__le32 type, size;
+	__le64 iova, pa, token;
+	__le32 vcp_addr[2];
+};
+struct mt6897_venc_format {
+	__le32 fourcc, type, planes, reserved;
+};
+struct mt6897_venc_framesize {
+	__le32 fourcc, profile, level, reserved;
+	__le32 min_width, max_width, step_width;
+	__le32 min_height, max_height, step_height;
+};
+static_assert(sizeof(struct mt6897_venc_prefix) == 24);
+static_assert(offsetof(struct mt6897_venc_prefix, cookie) == 8);
+static_assert(offsetof(struct mt6897_venc_prefix, status) == 16);
+static_assert(sizeof(struct mt6897_venc_query) == 40);
+static_assert(offsetof(struct mt6897_venc_query, data_cookie) == 24);
+static_assert(offsetof(struct mt6897_venc_query, query) == 32);
+static_assert(sizeof(struct mt6897_venc_query_ack) == 48);
+static_assert(offsetof(struct mt6897_venc_query_ack, address) == 32);
+static_assert(offsetof(struct mt6897_venc_query_ack, query) == 40);
+static_assert(sizeof(struct mt6897_venc_memory) == 64);
+static_assert(offsetof(struct mt6897_venc_memory, type) == 24);
+static_assert(offsetof(struct mt6897_venc_memory, size) == 28);
+static_assert(offsetof(struct mt6897_venc_memory, iova) == 32);
+static_assert(offsetof(struct mt6897_venc_memory, token) == 48);
+static_assert(offsetof(struct mt6897_venc_memory, vcp_addr) == 56);
+static_assert(sizeof(struct mt6897_venc_format) == 16);
+static_assert(sizeof(struct mt6897_venc_framesize) == 40);
+static inline bool
+mt6897_venc_query_ack_valid(const struct mt6897_venc_query_ack *ack,
+			    size_t bytes, bool pending, u64 cookie,
+			    u64 data_cookie, u32 query)
+{
+	/* Shipping QUERY replies use ctx 0 even for a nonzero request context.
+	 * The vendor dispatches these replies by instance/data cookies and id. */
+	return bytes == sizeof(*ack) && pending &&
+	       le32_to_cpu(ack->header.id) == MT6897_VENC_QUERY_DONE &&
+	       le64_to_cpu(ack->header.cookie) == cookie &&
+	       le64_to_cpu(ack->data_cookie) == data_cookie &&
+	       le32_to_cpu(ack->query) == query;
+}
+/* Firmware virtual 32-bit pointers use low-28-bit translation, distinct
+ * from PACK_IOVA. Full IOVAs must point directly inside reserved VENC SHM. */
+static inline bool mt6897_venc_table_offset(u64 address, u64 base,
+					    size_t region, size_t bytes,
+					    size_t *offset)
+{
+	u64 start = base & 0xfffffff, low = address & 0xfffffff;
+	if (address > U32_MAX && (address < base || address - base >= region))
+		return false;
+	if (low < start || ((low - start) & 3) || low - start > region ||
+	    bytes > region - (low - start))
+		return false;
+	*offset = low - start;
+	return true;
+}
+static inline bool mt6897_venc_format_valid(const struct mt6897_venc_format *f)
+{
+	return !f->fourcc ||
+	       ((le32_to_cpu(f->type) == 1 || le32_to_cpu(f->type) == 2) &&
+		le32_to_cpu(f->planes) >= 1 && le32_to_cpu(f->planes) <= 8);
+}
+static inline bool
+mt6897_venc_framesize_valid(const struct mt6897_venc_framesize *f)
+{
+	u32 min_w = le32_to_cpu(f->min_width),
+	    max_w = le32_to_cpu(f->max_width);
+	u32 min_h = le32_to_cpu(f->min_height),
+	    max_h = le32_to_cpu(f->max_height);
+	u32 step_w = le32_to_cpu(f->step_width),
+	    step_h = le32_to_cpu(f->step_height);
+	return !f->fourcc ||
+	       (min_w && min_h && min_w <= max_w && min_h <= max_h && step_w &&
+		step_h && step_w <= max_w && step_h <= max_h);
+}
+
+/* A source-declared CONFIG ACK is 56 bytes, but the shipping consumer uses
+ * only its common prefix. Tail fields are diagnostic, not identity. */
+static inline bool
+mt6897_venc_config_ack_valid(const struct mt6897_venc_prefix *h, size_t bytes,
+			     bool pending, u32 expected, u64 cookie)
+{
+	return bytes >= sizeof(*h) && bytes <= 56 && !(bytes & 3) && pending &&
+	       expected == MT6897_VENC_CONFIG_DONE &&
+	       le32_to_cpu(h->id) == expected &&
+	       le64_to_cpu(h->cookie) == cookie;
+}
+/* Explicit small NV12M diagnostic configuration. Only shipping-mapped words
+ * are written; offset 120 and all firmware-owned gaps remain untouched.
+ * Control defaults are distinct from test choices such as bitrate/GOP/FPS. */
+static inline bool mt6897_venc_config_defaults(void *vsi, size_t bytes,
+					       u32 codec, u32 context)
+{
+	static const struct {
+		unsigned int offset;
+		u32 value;
+	} fields[] = {
+		{ 0, 6 },	  { 4, 256000 },    { 8, 160 },
+		{ 12, 128 },	  { 16, 160 },	    { 20, 128 },
+		{ 24, 30 },	  { 28, 30 },	    { 32, 30 },
+		{ 44, 0 },	  { 48, 0 },	    { 52, 0 },
+		{ 56, 0 },	  { 60, 0 },	    { 64, 0 },
+		{ 72, 0 },	  { 76, 0 },	    { 84, 0 },
+		{ 88, 0 },	  { 92, 0 },	    { 96, 0 },
+		{ 100, 51 },	  { 104, 51 },	    { 108, 51 },
+		{ 112, 0 },	  { 116, 0 },	    { 124, U32_MAX },
+		{ 128, U32_MAX }, { 132, U32_MAX }, { 136, 0 },
+		{ 140, U32_MAX }, { 144, 0 },	    { 148, 0 },
+		{ 152, 0 },	  { 164, 1 },	    { 168, 0 },
+		{ 172, 0 },	  { 176, 0 },	    { 180, 0 },
+		{ 184, 0 },	  { 188, 0 },	    { 200, 0 },
+		{ 344, U32_MAX }, { 348, U32_MAX }, { 352, U32_MAX },
+		{ 356, 99 },	  { 360, 99 },	    { 364, U32_MAX },
+		{ 368, U32_MAX }, { 372, U32_MAX }, { 376, U32_MAX },
+		{ 380, U32_MAX }, { 384, U32_MAX }, { 388, U32_MAX },
+		{ 392, U32_MAX }, { 396, U32_MAX }, { 400, U32_MAX },
+		{ 404, U32_MAX }, { 408, U32_MAX }, { 412, U32_MAX },
+	};
+	unsigned int i;
+	__le32 *words = vsi;
+	if (!vsi || ((unsigned long)vsi & 3) ||
+	    bytes < MT6897_VENC_CONFIG_EXTENT || (codec != 13 && codec != 14))
+		return false;
+	for (i = 0; i < sizeof(fields) / sizeof(fields[0]); i++)
+		words[fields[i].offset / 4] = cpu_to_le32(fields[i].value);
+	words[36 / 4] = cpu_to_le32(codec == 13 ? 0 : 1);
+	words[40 / 4] = cpu_to_le32(codec == 13 ? 8 : 13);
+	words[196 / 4] = cpu_to_le32(context);
+	/* The vendor's HEVC format is H265, not the external V4L2 HEVC FourCC. */
+	words[204 / 4] = cpu_to_le32(codec == 13 ? 0x34363248 : 0x35363248);
+	/* Inline color description, multi-reference and VUI source defaults. */
+	for (i = 224 / 4; i < 344 / 4; i++)
+		words[i] = 0;
+	return true;
+}
+
+#endif
diff --git a/drivers/media/platform/mediatek/vcodec/vcp/mtk_vcp_venc_v4l2.c b/drivers/media/platform/mediatek/vcodec/vcp/mtk_vcp_venc_v4l2.c
new file mode 100644
index 0000000000..f66437651e
--- /dev/null
+++ b/drivers/media/platform/mediatek/vcodec/vcp/mtk_vcp_venc_v4l2.c
@@ -0,0 +1,822 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Stateful encoder with CPU-owned vb2 queues and private firmware DMA. */
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/sizes.h>
+#include <linux/workqueue.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-event.h>
+#include <media/v4l2-fh.h>
+#include <media/v4l2-ioctl.h>
+#include <media/v4l2-mem2mem.h>
+#include <media/videobuf2-vmalloc.h>
+#include "mtk_vcp_venc.h"
+#include "mtk_vcp_venc_v4l2.h"
+
+/* Intersection of firmware geometry and the implemented private DMA budget.
+ * QUERY's 7680x4320 limit is not a frontend or throughput claim. */
+#define VENC_MAX_WIDTH 4096
+#define VENC_MAX_HEIGHT 4096
+#define VENC_MAX_PIXELS (4096 * 2176)
+struct mtk_vcp_venc_video {
+	struct device *dev;
+	struct mtk_vcp_venc *client;
+	struct mtk_vcp_venc_hw *hw;
+	struct v4l2_device v4l2;
+	struct video_device video;
+	struct v4l2_m2m_dev *m2m;
+	struct workqueue_struct *workqueue;
+	struct mutex lock;
+};
+struct venc_ctx {
+	struct mtk_vcp_venc_video *dev;
+	struct v4l2_fh fh;
+	struct v4l2_ctrl_handler controls;
+	struct v4l2_ctrl *bitrate, *gop, *h264_profile, *h264_level, *hevc_level;
+	struct v4l2_pix_format_mplane raw, coded;
+	struct v4l2_rect crop;
+	struct work_struct work;
+	/* No worker takes video/vb2 lock. Ioctls may flush work while holding it;
+	 * RX completion uses only the transport's independent receive mutex. */
+	spinlock_t state_lock;
+	u64 queued, completed, barrier;
+	u32 src_sequence, dst_sequence, fps;
+	bool session, stopping, failed, draining, drained, last_pending;
+	atomic_t force;
+};
+struct venc_buffer {
+	struct v4l2_m2m_buffer m2m;
+	u64 ticket;
+	bool force;
+};
+static struct venc_ctx *file_ctx(struct file *file)
+{
+	return container_of(file->private_data, struct venc_ctx, fh);
+}
+static bool is_output(u32 type)
+{
+	return type == V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+}
+static bool valid_type(u32 type)
+{
+	return is_output(type) || type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+}
+static struct venc_buffer *to_buffer(struct vb2_v4l2_buffer *vb)
+{
+	return container_of(vb, struct venc_buffer, m2m.vb);
+}
+static u32 coded_capacity(u32 width, u32 height)
+{
+	/* An oversized AU is returned as an error, never truncated. This budget
+	 * includes parameter sets and exceeds the vendor's width*height default. */
+	return PAGE_ALIGN(width * height * 3 / 2 + SZ_64K);
+}
+static bool queues_busy(struct venc_ctx *c)
+{
+	return vb2_is_busy(v4l2_m2m_get_src_vq(c->fh.m2m_ctx)) ||
+	       vb2_is_busy(v4l2_m2m_get_dst_vq(c->fh.m2m_ctx));
+}
+static void raw_format(struct v4l2_pix_format_mplane *p)
+{
+	u32 width = clamp_t(u32, ALIGN(clamp_t(u32, p->width, 160,
+					      VENC_MAX_WIDTH), 16), 160,
+			    VENC_MAX_WIDTH);
+	u32 height = clamp_t(u32, ALIGN(clamp_t(u32, p->height, 128,
+					       VENC_MAX_HEIGHT), 8), 128,
+			     VENC_MAX_HEIGHT);
+
+	/* Keep portrait orientations within the same private DMA pixel budget. */
+	if (width * height > VENC_MAX_PIXELS)
+		height = (VENC_MAX_PIXELS / width) & ~7U;
+	memset(p, 0, sizeof(*p));
+	p->width = width;
+	p->height = height;
+	p->pixelformat = V4L2_PIX_FMT_NV12;
+	p->field = V4L2_FIELD_NONE;
+	p->colorspace = V4L2_COLORSPACE_REC709;
+	p->num_planes = 1;
+	p->plane_fmt[0].bytesperline = width;
+	p->plane_fmt[0].sizeimage = width * height * 3 / 2;
+}
+static void coded_format(struct venc_ctx *c, struct v4l2_pix_format_mplane *p)
+{
+	u32 fourcc = p->pixelformat == V4L2_PIX_FMT_HEVC ?
+		V4L2_PIX_FMT_HEVC : V4L2_PIX_FMT_H264;
+
+	memset(p, 0, sizeof(*p));
+	p->width = c->crop.width;
+	p->height = c->crop.height;
+	p->pixelformat = fourcc;
+	p->field = V4L2_FIELD_NONE;
+	p->colorspace = c->raw.colorspace;
+	p->num_planes = 1;
+	p->plane_fmt[0].sizeimage = coded_capacity(c->raw.width, c->raw.height);
+}
+static int querycap(struct file *file, void *priv, struct v4l2_capability *cap)
+{
+	strscpy(cap->driver, "mtk-vcp-enc", sizeof(cap->driver));
+	strscpy(cap->card, "MT6897 VCP encoder", sizeof(cap->card));
+	strscpy(cap->bus_info, "platform:mt6897-vcp-enc", sizeof(cap->bus_info));
+	return 0;
+}
+static int enum_format(struct file *file, void *priv, struct v4l2_fmtdesc *f)
+{
+	if (!valid_type(f->type) || f->index >= (is_output(f->type) ? 1 : 2))
+		return -EINVAL;
+	f->pixelformat = is_output(f->type) ? V4L2_PIX_FMT_NV12 :
+		(f->index ? V4L2_PIX_FMT_HEVC : V4L2_PIX_FMT_H264);
+	return 0;
+}
+static int try_format(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct venc_ctx *c = file_ctx(file);
+
+	if (!valid_type(f->type))
+		return -EINVAL;
+	if (is_output(f->type))
+		raw_format(&f->fmt.pix_mp);
+	else
+		coded_format(c, &f->fmt.pix_mp);
+	return 0;
+}
+static int get_format(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct venc_ctx *c = file_ctx(file);
+
+	if (!valid_type(f->type))
+		return -EINVAL;
+	f->fmt.pix_mp = is_output(f->type) ? c->raw : c->coded;
+	return 0;
+}
+static int set_format(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct venc_ctx *c = file_ctx(file);
+	int ret;
+
+	if (!valid_type(f->type))
+		return -EINVAL;
+	if (queues_busy(c) || c->session)
+		return -EBUSY;
+	ret = try_format(file, priv, f);
+	if (ret)
+		return ret;
+	if (is_output(f->type)) {
+		c->raw = f->fmt.pix_mp;
+		c->crop = (struct v4l2_rect){0, 0, c->raw.width, c->raw.height};
+		coded_format(c, &c->coded);
+	} else {
+		c->coded = f->fmt.pix_mp;
+	}
+	return 0;
+}
+static int enum_framesizes(struct file *file, void *priv,
+			   struct v4l2_frmsizeenum *f)
+{
+	if (f->index || (f->pixel_format != V4L2_PIX_FMT_NV12 &&
+	    f->pixel_format != V4L2_PIX_FMT_H264 &&
+	    f->pixel_format != V4L2_PIX_FMT_HEVC))
+		return -EINVAL;
+	f->type = V4L2_FRMSIZE_TYPE_STEPWISE;
+	f->stepwise = (struct v4l2_frmsize_stepwise){160, VENC_MAX_WIDTH, 16,
+		128, VENC_MAX_HEIGHT, 8};
+	if (f->pixel_format == V4L2_PIX_FMT_HEVC) {
+		f->stepwise.max_width = 1920;
+		f->stepwise.max_height = 1920;
+	}
+	return 0;
+}
+static int get_selection(struct file *file, void *priv, struct v4l2_selection *s)
+{
+	struct venc_ctx *c = file_ctx(file);
+
+	if ((s->type != V4L2_BUF_TYPE_VIDEO_OUTPUT && !is_output(s->type)) ||
+	    (s->target != V4L2_SEL_TGT_CROP &&
+	    s->target != V4L2_SEL_TGT_CROP_BOUNDS &&
+	    s->target != V4L2_SEL_TGT_CROP_DEFAULT))
+		return -EINVAL;
+	s->r = s->target == V4L2_SEL_TGT_CROP ? c->crop :
+		(struct v4l2_rect){0, 0, c->raw.width, c->raw.height};
+	return 0;
+}
+static int set_selection(struct file *file, void *priv, struct v4l2_selection *s)
+{
+	struct venc_ctx *c = file_ctx(file);
+
+	if (queues_busy(c) || c->session)
+		return -EBUSY;
+	/* Firmware exposes a top-left visible rectangle inside coded storage. */
+	if ((s->type != V4L2_BUF_TYPE_VIDEO_OUTPUT && !is_output(s->type)) ||
+	    s->target != V4L2_SEL_TGT_CROP || s->r.left || s->r.top ||
+	    s->r.width < 160 || s->r.height < 128 ||
+	    s->r.width > c->raw.width || s->r.height > c->raw.height ||
+	    (s->r.width & 1) || (s->r.height & 1))
+		return -EINVAL;
+	c->crop = s->r;
+	coded_format(c, &c->coded);
+	return 0;
+}
+static int get_parm(struct file *file, void *priv, struct v4l2_streamparm *p)
+{
+	struct venc_ctx *c = file_ctx(file);
+
+	if (!is_output(p->type))
+		return -EINVAL;
+	memset(&p->parm, 0, sizeof(p->parm));
+	p->parm.output.capability = V4L2_CAP_TIMEPERFRAME;
+	p->parm.output.timeperframe = (struct v4l2_fract){1, c->fps};
+	return 0;
+}
+static int set_parm(struct file *file, void *priv, struct v4l2_streamparm *p)
+{
+	struct venc_ctx *c = file_ctx(file);
+	struct v4l2_fract t = p->parm.output.timeperframe;
+	u32 fps;
+
+	if (!is_output(p->type) || !t.numerator || !t.denominator)
+		return -EINVAL;
+	if (queues_busy(c) || c->session)
+		return -EBUSY;
+	/* CONFIG has integer fps. Accept equivalent integers; reject fractional
+	 * requests rather than silently changing their time base. */
+	if (t.denominator % t.numerator)
+		return -EINVAL;
+	fps = t.denominator / t.numerator;
+	if (!fps || fps > 240)
+		return -ERANGE;
+	c->fps = fps;
+	return get_parm(file, priv, p);
+}
+static int set_control(struct v4l2_ctrl *ctrl)
+{
+	struct venc_ctx *c = container_of(ctrl->handler, struct venc_ctx, controls);
+
+	if (ctrl->id == V4L2_CID_MPEG_VIDEO_FORCE_KEY_FRAME) {
+		atomic_set(&c->force, 1); /* A button value of zero also requests. */
+		return 0;
+	}
+	/* Controls have a separate lock: ioctl video lock is held by the caller,
+	 * worker never reads mutable controls after its session starts. */
+	if (c->fh.m2m_ctx && (queues_busy(c) || c->session))
+		return -EBUSY;
+	return 0;
+}
+static const struct v4l2_ctrl_ops control_ops = { .s_ctrl = set_control };
+static int queue_setup(struct vb2_queue *q, unsigned int *count,
+		       unsigned int *planes, unsigned int sizes[],
+		       struct device *alloc_devs[])
+{
+	struct venc_ctx *c = vb2_get_drv_priv(q);
+	u32 size = is_output(q->type) ? c->raw.plane_fmt[0].sizeimage :
+		c->coded.plane_fmt[0].sizeimage;
+
+	if (*planes)
+		return *planes == 1 && sizes[0] >= size ? 0 : -EINVAL;
+	*planes = 1;
+	sizes[0] = size;
+	return 0;
+}
+static int buffer_prepare(struct vb2_buffer *vb)
+{
+	struct venc_ctx *c = vb2_get_drv_priv(vb->vb2_queue);
+	u32 size = is_output(vb->type) ? c->raw.plane_fmt[0].sizeimage :
+		c->coded.plane_fmt[0].sizeimage;
+
+	if (vb2_plane_size(vb, 0) < size)
+		return -EINVAL;
+	if (is_output(vb->type)) {
+		if (vb2_get_plane_payload(vb, 0) > vb2_plane_size(vb, 0) ||
+		    vb->planes[0].data_offset > vb2_get_plane_payload(vb, 0) ||
+		    vb2_get_plane_payload(vb, 0) - vb->planes[0].data_offset < size)
+			return -EINVAL;
+	} else {
+		vb->planes[0].data_offset = 0;
+		vb2_set_plane_payload(vb, 0, 0);
+	}
+	return 0;
+}
+static void emit_last(struct venc_ctx *c, struct vb2_v4l2_buffer *dst);
+static void buffer_queue(struct vb2_buffer *vb)
+{
+	struct venc_ctx *c = vb2_get_drv_priv(vb->vb2_queue);
+	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
+	unsigned long flags;
+
+
+	if (!is_output(vb->type)) {
+		bool last;
+
+		spin_lock_irqsave(&c->state_lock, flags);
+		last = c->last_pending;
+		c->last_pending = false;
+		spin_unlock_irqrestore(&c->state_lock, flags);
+		if (last) {
+			emit_last(c, vbuf);
+			return;
+		}
+	}
+	v4l2_m2m_buf_queue(c->fh.m2m_ctx, vbuf);
+}
+/* Associate requests at the successful QBUF boundary, not buf_queue: vb2
+ * defers buf_queue until STREAMON for buffers queued while the queue is off.
+ * PREPARE_BUF never consumes a force request. The video lock serializes this
+ * reservation and rollback against controls and other queue ioctls. */
+static int queue_buffer(struct file *file, void *priv, struct v4l2_buffer *buffer)
+{
+	struct venc_ctx *c = file_ctx(file);
+	struct vb2_buffer *vb;
+	struct venc_buffer *b;
+	unsigned long flags;
+	u64 previous_ticket;
+	bool previous_force;
+	int ret;
+
+	if (!is_output(buffer->type))
+		return v4l2_m2m_ioctl_qbuf(file, priv, buffer);
+	vb = vb2_get_buffer(v4l2_m2m_get_src_vq(c->fh.m2m_ctx), buffer->index);
+	if (!vb || vb->state != VB2_BUF_STATE_DEQUEUED ||
+	    buffer->flags & V4L2_BUF_FLAG_REQUEST_FD)
+		return -EINVAL;
+	b = to_buffer(to_vb2_v4l2_buffer(vb));
+	spin_lock_irqsave(&c->state_lock, flags);
+	if (c->queued == U64_MAX) {
+		spin_unlock_irqrestore(&c->state_lock, flags);
+		return -EOVERFLOW;
+	}
+	previous_ticket = b->ticket;
+	previous_force = b->force;
+	b->ticket = ++c->queued;
+	b->force = atomic_xchg(&c->force, 0);
+	spin_unlock_irqrestore(&c->state_lock, flags);
+	ret = v4l2_m2m_ioctl_qbuf(file, priv, buffer);
+	if (ret) {
+		spin_lock_irqsave(&c->state_lock, flags);
+		c->queued--;
+		if (b->force)
+			atomic_set(&c->force, 1);
+		b->ticket = previous_ticket;
+		b->force = previous_force;
+		spin_unlock_irqrestore(&c->state_lock, flags);
+	}
+	return ret;
+}
+/* Source-backed Main-tier level translation, matching venc_h265_get_level. */
+static u32 hevc_wire_level(u32 level)
+{
+	static const u32 levels[] = {2, 8, 10, 13, 15, 18, 20, 23, 25,
+		27, 29, 31, 33};
+
+	return levels[level];
+}
+/* Snapshot committed controls: a rejected S_CTRL can leave its proposed
+ * value in val without changing the successfully committed cur.val. */
+static struct mtk_vcp_venc_config stream_config(struct venc_ctx *c)
+{
+	struct mtk_vcp_venc_config cfg = {
+		.codec = c->coded.pixelformat == V4L2_PIX_FMT_H264 ? 13 : 14,
+		.width = c->crop.width, .height = c->crop.height,
+		.stride = c->raw.width, .storage_height = c->raw.height,
+		.bitrate = c->bitrate->cur.val, .gop = c->gop->cur.val, .fps = c->fps,
+		.capacity = c->coded.plane_fmt[0].sizeimage,
+		.profile = c->coded.pixelformat == V4L2_PIX_FMT_H264 ?
+			c->h264_profile->cur.val : 1,
+	};
+
+	cfg.level = cfg.codec == 13 ? c->h264_level->cur.val :
+		hevc_wire_level(c->hevc_level->cur.val);
+	return cfg;
+}
+static int start_streaming(struct vb2_queue *q, unsigned int count)
+{
+	struct venc_ctx *c = vb2_get_drv_priv(q);
+	struct vb2_queue *other = is_output(q->type) ?
+		v4l2_m2m_get_dst_vq(c->fh.m2m_ctx) :
+		v4l2_m2m_get_src_vq(c->fh.m2m_ctx);
+	struct mtk_vcp_venc_config cfg = stream_config(c);
+	struct vb2_v4l2_buffer *vb;
+	int ret = 0;
+
+	if (vb2_is_streaming(other) && !c->session) {
+		ret = mtk_vcp_venc_stream_start(c->dev->client, c->dev->hw, c, &cfg);
+		if (ret)
+			goto return_buffers;
+		c->session = true;
+		c->failed = false;
+	}
+	if (is_output(q->type)) {
+		unsigned long flags;
+
+		c->src_sequence = 0;
+
+		spin_lock_irqsave(&c->state_lock, flags);
+		c->draining = c->drained = c->last_pending = false;
+		v4l2_m2m_clear_state(c->fh.m2m_ctx);
+		spin_unlock_irqrestore(&c->state_lock, flags);
+		vb2_clear_last_buffer_dequeued(v4l2_m2m_get_dst_vq(c->fh.m2m_ctx));
+	}
+	if (!is_output(q->type))
+		c->dst_sequence = 0;
+	WRITE_ONCE(c->stopping, false);
+	return 0;
+return_buffers:
+	while ((vb = is_output(q->type) ?
+		v4l2_m2m_src_buf_remove(c->fh.m2m_ctx) :
+		v4l2_m2m_dst_buf_remove(c->fh.m2m_ctx)))
+		v4l2_m2m_buf_done(vb, VB2_BUF_STATE_QUEUED);
+	return ret;
+}
+static void mark_last(struct venc_ctx *c, struct vb2_v4l2_buffer *dst)
+{
+	const struct v4l2_event event = { .type = V4L2_EVENT_EOS };
+
+	v4l2_m2m_last_buffer_done(c->fh.m2m_ctx, dst);
+	v4l2_event_queue_fh(&c->fh, &event);
+}
+static void emit_last(struct venc_ctx *c, struct vb2_v4l2_buffer *dst)
+{
+	vb2_set_plane_payload(&dst->vb2_buf, 0, 0);
+	dst->sequence = c->dst_sequence++;
+	mark_last(c, dst);
+}
+static void stop_streaming(struct vb2_queue *q)
+{
+	struct venc_ctx *c = vb2_get_drv_priv(q);
+	struct vb2_v4l2_buffer *vb;
+	unsigned long flags;
+	bool finish_drain;
+
+	WRITE_ONCE(c->stopping, true);
+	flush_work(&c->work);
+	spin_lock_irqsave(&c->state_lock, flags);
+	finish_drain = is_output(q->type) && c->draining && !c->drained;
+	if (!is_output(q->type)) {
+		c->draining = c->drained = c->last_pending = false;
+		v4l2_m2m_clear_state(c->fh.m2m_ctx);
+	}
+	if (is_output(q->type)) {
+		c->completed = c->queued;
+		atomic_set(&c->force, 0);
+	}
+	if (finish_drain) {
+		c->drained = true;
+		c->last_pending = true;
+	}
+	spin_unlock_irqrestore(&c->state_lock, flags);
+	if (!is_output(q->type) ||
+	    !vb2_is_streaming(v4l2_m2m_get_dst_vq(c->fh.m2m_ctx))) {
+		mtk_vcp_venc_stream_end(c->dev->client, c);
+		c->session = false;
+	}
+	while ((vb = is_output(q->type) ?
+		v4l2_m2m_src_buf_remove(c->fh.m2m_ctx) :
+		v4l2_m2m_dst_buf_remove(c->fh.m2m_ctx)))
+		v4l2_m2m_buf_done(vb, VB2_BUF_STATE_ERROR);
+	if (finish_drain && (vb = v4l2_m2m_dst_buf_remove(c->fh.m2m_ctx))) {
+		c->last_pending = false;
+		emit_last(c, vb);
+	}
+	/* Pending empty LAST survives OUTPUT-off if no capture buffer exists. */
+}
+static const struct vb2_ops queue_ops = {
+	.queue_setup = queue_setup, .buf_prepare = buffer_prepare,
+	.buf_queue = buffer_queue, .start_streaming = start_streaming,
+	.stop_streaming = stop_streaming,
+};
+static int queue_init(void *priv, struct vb2_queue *src, struct vb2_queue *dst)
+{
+	struct venc_ctx *c = priv;
+	struct vb2_queue *q;
+	int i, ret;
+
+	for (i = 0; i < 2; i++) {
+		q = i ? dst : src;
+		q->type = i ? V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE :
+			V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+		q->io_modes = VB2_MMAP;
+		q->drv_priv = c;
+		q->buf_struct_size = sizeof(struct venc_buffer);
+		q->ops = &queue_ops;
+		q->mem_ops = &vb2_vmalloc_memops;
+		q->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+		q->lock = &c->dev->lock;
+		q->dev = c->dev->dev;
+		q->allow_zero_bytesused = 1;
+		ret = vb2_queue_init(q);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+static int job_ready(void *priv)
+{
+	struct venc_ctx *c = priv;
+	struct vb2_v4l2_buffer *src;
+	unsigned long flags;
+	bool ready;
+
+	spin_lock_irqsave(&c->state_lock, flags);
+	ready = !c->stopping && !c->failed && c->session && !c->drained;
+	if (ready && !(c->draining && c->completed >= c->barrier)) {
+		src = v4l2_m2m_next_src_buf(c->fh.m2m_ctx);
+		ready = src && (!c->draining || to_buffer(src)->ticket <= c->barrier);
+	}
+	spin_unlock_irqrestore(&c->state_lock, flags);
+	return ready;
+}
+static void encode_work(struct work_struct *work)
+{
+	struct venc_ctx *c = container_of(work, struct venc_ctx, work);
+	struct vb2_v4l2_buffer *src = NULL, *dst;
+	unsigned long flags;
+	size_t bytes = 0;
+	bool last, key = false;
+	int ret = 0;
+
+	dst = v4l2_m2m_dst_buf_remove(c->fh.m2m_ctx);
+	if (!dst)
+		goto finish;
+	spin_lock_irqsave(&c->state_lock, flags);
+	last = c->draining && c->completed >= c->barrier;
+	if (last)
+		c->drained = true;
+	spin_unlock_irqrestore(&c->state_lock, flags);
+	if (last) {
+		emit_last(c, dst);
+		goto finish;
+	}
+	src = v4l2_m2m_src_buf_remove(c->fh.m2m_ctx);
+	if (!src) {
+		v4l2_m2m_buf_done(dst, VB2_BUF_STATE_ERROR);
+		goto finish;
+	}
+	if (READ_ONCE(c->stopping))
+		ret = -ECANCELED;
+	else
+		ret = mtk_vcp_venc_stream_submit(c->dev->client, c,
+			vb2_plane_vaddr(&src->vb2_buf, 0) + src->vb2_buf.planes[0].data_offset,
+			vb2_get_plane_payload(&src->vb2_buf, 0) - src->vb2_buf.planes[0].data_offset,
+			src->vb2_buf.timestamp, to_buffer(src)->force,
+			vb2_plane_vaddr(&dst->vb2_buf, 0),
+			vb2_plane_size(&dst->vb2_buf, 0), &bytes, &key);
+	dst->vb2_buf.timestamp = src->vb2_buf.timestamp;
+	dst->timecode = src->timecode;
+	dst->flags &= ~(V4L2_BUF_FLAG_KEYFRAME | V4L2_BUF_FLAG_PFRAME |
+		V4L2_BUF_FLAG_BFRAME | V4L2_BUF_FLAG_LAST);
+	if (!ret)
+		dst->flags |= key ? V4L2_BUF_FLAG_KEYFRAME : V4L2_BUF_FLAG_PFRAME;
+	src->sequence = c->src_sequence++;
+	dst->sequence = c->dst_sequence++;
+	vb2_set_plane_payload(&dst->vb2_buf, 0, ret ? 0 : bytes);
+	spin_lock_irqsave(&c->state_lock, flags);
+	c->completed = to_buffer(src)->ticket;
+	last = !ret && c->draining && c->completed >= c->barrier;
+	if (last)
+		c->drained = true;
+	if (ret && ret != -ECANCELED)
+		c->failed = true;
+	spin_unlock_irqrestore(&c->state_lock, flags);
+	v4l2_m2m_buf_done(src, ret ? VB2_BUF_STATE_ERROR : VB2_BUF_STATE_DONE);
+	if (last)
+		mark_last(c, dst);
+	else
+		v4l2_m2m_buf_done(dst, ret ? VB2_BUF_STATE_ERROR : VB2_BUF_STATE_DONE);
+	if (ret && ret != -ECANCELED) {
+		vb2_queue_error(v4l2_m2m_get_src_vq(c->fh.m2m_ctx));
+		vb2_queue_error(v4l2_m2m_get_dst_vq(c->fh.m2m_ctx));
+	}
+finish:
+	v4l2_m2m_job_finish(c->dev->m2m, c->fh.m2m_ctx);
+}
+static void device_run(void *priv)
+{
+	struct venc_ctx *c = priv;
+
+	queue_work(c->dev->workqueue, &c->work);
+}
+static void job_abort(void *priv)
+{
+	struct venc_ctx *c = priv;
+
+	WRITE_ONCE(c->stopping, true);
+	/* The bounded worker completes the outstanding job; it never needs the
+	 * caller's video lock. Do not reset firmware while RX still owns DMA. */
+}
+static const struct v4l2_m2m_ops m2m_ops = {
+	.device_run = device_run, .job_ready = job_ready, .job_abort = job_abort,
+};
+static int encoder_cmd(struct file *file, void *priv, struct v4l2_encoder_cmd *cmd)
+{
+	struct venc_ctx *c = file_ctx(file);
+	unsigned long flags;
+	int ret;
+
+	ret = v4l2_m2m_ioctl_try_encoder_cmd(file, priv, cmd);
+	if (ret)
+		return ret;
+	if (!vb2_is_streaming(v4l2_m2m_get_src_vq(c->fh.m2m_ctx)) ||
+	    !vb2_is_streaming(v4l2_m2m_get_dst_vq(c->fh.m2m_ctx)))
+		return 0;
+	spin_lock_irqsave(&c->state_lock, flags);
+	if (c->draining && !c->drained) {
+		ret = -EBUSY;
+	} else if (cmd->cmd == V4L2_ENC_CMD_STOP) {
+		if (!c->drained) {
+			c->draining = true;
+			c->barrier = c->queued;
+		}
+	} else if (cmd->cmd == V4L2_ENC_CMD_START) {
+		c->draining = c->drained = c->last_pending = false;
+		v4l2_m2m_clear_state(c->fh.m2m_ctx);
+		vb2_clear_last_buffer_dequeued(v4l2_m2m_get_dst_vq(c->fh.m2m_ctx));
+	} else {
+		ret = -EINVAL;
+	}
+	spin_unlock_irqrestore(&c->state_lock, flags);
+	if (!ret)
+		v4l2_m2m_try_schedule(c->fh.m2m_ctx);
+	return ret;
+}
+static int subscribe_event(struct v4l2_fh *fh,
+			   const struct v4l2_event_subscription *sub)
+{
+	if (sub->type == V4L2_EVENT_EOS)
+		return v4l2_event_subscribe(fh, sub, 1, NULL);
+	return v4l2_ctrl_subscribe_event(fh, sub);
+}
+static const struct v4l2_ioctl_ops ioctl_ops = {
+	.vidioc_querycap = querycap,
+	.vidioc_enum_fmt_vid_cap = enum_format, .vidioc_enum_fmt_vid_out = enum_format,
+	.vidioc_g_fmt_vid_cap_mplane = get_format, .vidioc_g_fmt_vid_out_mplane = get_format,
+	.vidioc_s_fmt_vid_cap_mplane = set_format, .vidioc_s_fmt_vid_out_mplane = set_format,
+	.vidioc_try_fmt_vid_cap_mplane = try_format, .vidioc_try_fmt_vid_out_mplane = try_format,
+	.vidioc_enum_framesizes = enum_framesizes,
+	.vidioc_g_selection = get_selection, .vidioc_s_selection = set_selection,
+	.vidioc_g_parm = get_parm, .vidioc_s_parm = set_parm,
+	.vidioc_reqbufs = v4l2_m2m_ioctl_reqbufs,
+	.vidioc_querybuf = v4l2_m2m_ioctl_querybuf,
+	.vidioc_prepare_buf = v4l2_m2m_ioctl_prepare_buf,
+	.vidioc_qbuf = queue_buffer, .vidioc_dqbuf = v4l2_m2m_ioctl_dqbuf,
+	.vidioc_streamon = v4l2_m2m_ioctl_streamon,
+	.vidioc_streamoff = v4l2_m2m_ioctl_streamoff,
+	.vidioc_encoder_cmd = encoder_cmd,
+	.vidioc_try_encoder_cmd = v4l2_m2m_ioctl_try_encoder_cmd,
+	.vidioc_subscribe_event = subscribe_event,
+	.vidioc_unsubscribe_event = v4l2_event_unsubscribe,
+};
+static int venc_open(struct file *file)
+{
+	struct mtk_vcp_venc_video *d = video_drvdata(file);
+	struct venc_ctx *c;
+	int ret;
+
+	if (mutex_lock_interruptible(&d->lock))
+		return -ERESTARTSYS;
+	c = kzalloc(sizeof(*c), GFP_KERNEL);
+	if (!c) {
+		ret = -ENOMEM;
+		goto unlock;
+	}
+	c->dev = d;
+	c->fps = 30;
+	spin_lock_init(&c->state_lock);
+	atomic_set(&c->force, 0);
+	INIT_WORK(&c->work, encode_work);
+	v4l2_fh_init(&c->fh, &d->video);
+	file->private_data = &c->fh;
+	v4l2_ctrl_handler_init(&c->controls, 12);
+	c->bitrate = v4l2_ctrl_new_std(&c->controls, &control_ops,
+		V4L2_CID_MPEG_VIDEO_BITRATE, 1, 400000000, 1, 256000);
+	c->gop = v4l2_ctrl_new_std(&c->controls, &control_ops,
+		V4L2_CID_MPEG_VIDEO_GOP_SIZE, 1, 65535, 1, 30);
+	v4l2_ctrl_new_std(&c->controls, &control_ops,
+		V4L2_CID_MPEG_VIDEO_B_FRAMES, 0, 0, 1, 0);
+	v4l2_ctrl_new_std(&c->controls, &control_ops,
+		V4L2_CID_MPEG_VIDEO_FORCE_KEY_FRAME, 0, 0, 0, 0);
+	v4l2_ctrl_new_std_menu(&c->controls, &control_ops,
+		V4L2_CID_MPEG_VIDEO_BITRATE_MODE, V4L2_MPEG_VIDEO_BITRATE_MODE_VBR,
+		0, V4L2_MPEG_VIDEO_BITRATE_MODE_VBR);
+	c->h264_profile = v4l2_ctrl_new_std_menu(&c->controls, &control_ops,
+		V4L2_CID_MPEG_VIDEO_H264_PROFILE, V4L2_MPEG_VIDEO_H264_PROFILE_MAIN,
+		1ULL << V4L2_MPEG_VIDEO_H264_PROFILE_CONSTRAINED_BASELINE,
+		V4L2_MPEG_VIDEO_H264_PROFILE_BASELINE);
+	v4l2_ctrl_new_std_menu(&c->controls, &control_ops,
+		V4L2_CID_MPEG_VIDEO_HEVC_PROFILE, V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN,
+		0, V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN);
+	c->h264_level = v4l2_ctrl_new_std_menu(&c->controls, &control_ops,
+		V4L2_CID_MPEG_VIDEO_H264_LEVEL, V4L2_MPEG_VIDEO_H264_LEVEL_5_2,
+		0, V4L2_MPEG_VIDEO_H264_LEVEL_3_0);
+	c->hevc_level = v4l2_ctrl_new_std_menu(&c->controls, &control_ops,
+		V4L2_CID_MPEG_VIDEO_HEVC_LEVEL, V4L2_MPEG_VIDEO_HEVC_LEVEL_5_2,
+		0, V4L2_MPEG_VIDEO_HEVC_LEVEL_3);
+	v4l2_ctrl_new_std_menu(&c->controls, &control_ops,
+		V4L2_CID_MPEG_VIDEO_HEVC_TIER, V4L2_MPEG_VIDEO_HEVC_TIER_MAIN,
+		0, V4L2_MPEG_VIDEO_HEVC_TIER_MAIN);
+	v4l2_ctrl_new_std_menu(&c->controls, &control_ops,
+		V4L2_CID_MPEG_VIDEO_HEADER_MODE,
+		V4L2_MPEG_VIDEO_HEADER_MODE_JOINED_WITH_1ST_FRAME,
+		1ULL << V4L2_MPEG_VIDEO_HEADER_MODE_SEPARATE,
+		V4L2_MPEG_VIDEO_HEADER_MODE_JOINED_WITH_1ST_FRAME);
+	if (c->controls.error) {
+		ret = c->controls.error;
+		goto free;
+	}
+	c->fh.ctrl_handler = &c->controls;
+	c->raw.width = 160;
+	c->raw.height = 128;
+	raw_format(&c->raw);
+	c->crop = (struct v4l2_rect){0, 0, c->raw.width, c->raw.height};
+	coded_format(c, &c->coded);
+	c->fh.m2m_ctx = v4l2_m2m_ctx_init(d->m2m, c, queue_init);
+	if (IS_ERR(c->fh.m2m_ctx)) {
+		ret = PTR_ERR(c->fh.m2m_ctx);
+		c->fh.m2m_ctx = NULL;
+		goto free;
+	}
+	v4l2_m2m_set_src_buffered(c->fh.m2m_ctx, true);
+	v4l2_fh_add(&c->fh, file);
+	mutex_unlock(&d->lock);
+	return 0;
+free:
+	v4l2_ctrl_handler_free(&c->controls);
+	v4l2_fh_exit(&c->fh);
+	kfree(c);
+unlock:
+	mutex_unlock(&d->lock);
+	return ret;
+}
+static int venc_release(struct file *file)
+{
+	struct venc_ctx *c = file_ctx(file);
+	struct mtk_vcp_venc_video *d = c->dev;
+
+	mutex_lock(&d->lock);
+	WRITE_ONCE(c->stopping, true);
+	v4l2_m2m_ctx_release(c->fh.m2m_ctx);
+	flush_work(&c->work);
+	mtk_vcp_venc_stream_end(d->client, c);
+	v4l2_ctrl_handler_free(&c->controls);
+	v4l2_fh_del(&c->fh, file);
+	v4l2_fh_exit(&c->fh);
+	/* Retained transport state never references this frontend allocation. */
+	kfree(c);
+	mutex_unlock(&d->lock);
+	return 0;
+}
+static const struct v4l2_file_operations file_ops = {
+	.owner = THIS_MODULE, .open = venc_open, .release = venc_release,
+	.poll = v4l2_m2m_fop_poll, .mmap = v4l2_m2m_fop_mmap,
+	.unlocked_ioctl = video_ioctl2,
+};
+struct mtk_vcp_venc_video *mtk_vcp_venc_video_register(struct device *dev,
+		struct mtk_vcp_venc *client, struct mtk_vcp_venc_hw *hw)
+{
+	struct mtk_vcp_venc_video *d;
+	int ret;
+
+	d = devm_kzalloc(dev, sizeof(*d), GFP_KERNEL);
+	if (!d)
+		return ERR_PTR(-ENOMEM);
+	d->dev = dev;
+	d->client = client;
+	d->hw = hw;
+	mutex_init(&d->lock);
+	d->workqueue = alloc_ordered_workqueue("mtk-vcp-enc", WQ_MEM_RECLAIM);
+	if (!d->workqueue)
+		return ERR_PTR(-ENOMEM);
+	ret = v4l2_device_register(dev, &d->v4l2);
+	if (ret)
+		goto destroy_workqueue;
+	d->m2m = v4l2_m2m_init(&m2m_ops);
+	if (IS_ERR(d->m2m)) {
+		ret = PTR_ERR(d->m2m);
+		goto unregister_v4l2;
+	}
+	strscpy(d->video.name, "mtk-vcp-enc", sizeof(d->video.name));
+	d->video.fops = &file_ops;
+	d->video.ioctl_ops = &ioctl_ops;
+	d->video.v4l2_dev = &d->v4l2;
+	d->video.lock = &d->lock;
+	d->video.release = video_device_release_empty;
+	d->video.device_caps = V4L2_CAP_VIDEO_M2M_MPLANE | V4L2_CAP_STREAMING;
+	d->video.vfl_dir = VFL_DIR_M2M;
+	video_set_drvdata(&d->video, d);
+	ret = video_register_device(&d->video, VFL_TYPE_VIDEO, -1);
+	if (ret)
+		goto release_m2m;
+	return d;
+release_m2m:
+	v4l2_m2m_release(d->m2m);
+unregister_v4l2:
+	v4l2_device_unregister(&d->v4l2);
+destroy_workqueue:
+	destroy_workqueue(d->workqueue);
+	return ERR_PTR(ret);
+}
+void mtk_vcp_venc_video_unregister(struct mtk_vcp_venc_video *d)
+{
+	video_unregister_device(&d->video);
+	v4l2_m2m_release(d->m2m);
+	v4l2_device_unregister(&d->v4l2);
+	destroy_workqueue(d->workqueue);
+}
