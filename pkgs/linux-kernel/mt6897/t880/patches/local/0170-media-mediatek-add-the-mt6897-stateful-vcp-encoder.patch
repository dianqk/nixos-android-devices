+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __MTK_VCP_VENC_HW_H
+#define __MTK_VCP_VENC_HW_H
+#include <linux/types.h>
+struct platform_device;
+struct device;
+struct mtk_vcp;
+struct mtk_vcp_venc_hw;
+struct mtk_vcp_venc_hw *mtk_vcp_venc_hw_create(struct platform_device *pdev,
+					       struct device *core0_dma,
+					       struct mtk_vcp *vcp);
+int mtk_vcp_venc_hw_power(struct mtk_vcp_venc_hw *hw, unsigned int core,
+			  bool on);
+/* Caller must first establish that the VCP is offline. Failure retains all
+ * remaining clocks, PM references and DMA ownership. */
+int mtk_vcp_venc_hw_stop(struct mtk_vcp_venc_hw *hw);
