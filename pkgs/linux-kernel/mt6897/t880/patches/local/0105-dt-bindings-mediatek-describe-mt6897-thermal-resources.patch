From 4ccf8d6b1526408c0036a6d08afe5c9a3c210bc4 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Fri, 6 Nov 2026 10:00:00 +0800
Subject: [PATCH] dt-bindings: mediatek: describe MT6897 thermal resources

Describe the MT6897 thermal compatibles, resource limits and constants
used by the corresponding controllers and device trees.

Original-Commit: local development history
Original-Author: dianqk <dianqk@dianqk.net>
Original-Date: 2026-10-15T23:42:10+08:00
Signed-off-by: dianqk <dianqk@dianqk.net>
---
 .../thermal/mediatek,lvts-thermal.yaml        |  4 +++
 .../thermal/mediatek,lvts-thermal.h           | 30 +++++++++++++++++++
 2 files changed, 34 insertions(+)

diff --git a/Documentation/devicetree/bindings/thermal/mediatek,lvts-thermal.yaml b/Documentation/devicetree/bindings/thermal/mediatek,lvts-thermal.yaml
index 29f431fcdc..72417896fb 100644
--- a/Documentation/devicetree/bindings/thermal/mediatek,lvts-thermal.yaml
+++ b/Documentation/devicetree/bindings/thermal/mediatek,lvts-thermal.yaml
@@ -18,6 +18,8 @@ description: |
 properties:
   compatible:
     enum:
+      - mediatek,mt6897-lvts-ap
+      - mediatek,mt6897-lvts-mcu
       - mediatek,mt7987-lvts-ap
       - mediatek,mt7988-lvts-ap
       - mediatek,mt8186-lvts
@@ -100,6 +102,8 @@ allOf:
           not:
             contains:
               enum:
+                - mediatek,mt6897-lvts-ap
+                - mediatek,mt6897-lvts-mcu
                 - mediatek,mt8196-lvts-ap
                 - mediatek,mt8196-lvts-mcu
     then:
diff --git a/include/dt-bindings/thermal/mediatek,lvts-thermal.h b/include/dt-bindings/thermal/mediatek,lvts-thermal.h
index 350f98178b..52697e05c3 100644
--- a/include/dt-bindings/thermal/mediatek,lvts-thermal.h
+++ b/include/dt-bindings/thermal/mediatek,lvts-thermal.h
@@ -109,4 +109,34 @@
 #define MT8196_AP_BOT2                  6
 #define MT8196_AP_BOT3                  7
 
+#define MT6897_MCU_MEDIUM_CPU4_0        0
+#define MT6897_MCU_MEDIUM_CPU4_1        1
+#define MT6897_MCU_MEDIUM_CPU5_0        2
+#define MT6897_MCU_MEDIUM_CPU5_1        3
+#define MT6897_MCU_LITTLE_CPU2          4
+#define MT6897_MCU_LITTLE_CPU3          5
+#define MT6897_MCU_MEDIUM_CPU6_0        6
+#define MT6897_MCU_MEDIUM_CPU6_1        7
+#define MT6897_MCU_DSU0                 8
+#define MT6897_MCU_LITTLE_CPU0          9
+#define MT6897_MCU_LITTLE_CPU1          10
+#define MT6897_MCU_DSU1                 11
+#define MT6897_MCU_BIG_CPU7_0           12
+#define MT6897_MCU_BIG_CPU7_1           13
+#define MT6897_MCU_DSU2                 14
+#define MT6897_MCU_DSU3                 15
+
+#define MT6897_AP_TOP0                  0
+#define MT6897_AP_TOP1                  1
+#define MT6897_AP_TOP2                  2
+#define MT6897_AP_TOP3                  3
+#define MT6897_AP_BOT0                  4
+#define MT6897_AP_BOT1                  5
+#define MT6897_AP_BOT2                  6
+#define MT6897_AP_BOT3                  7
+#define MT6897_AP_MD0                   8
+#define MT6897_AP_MD1                   9
+#define MT6897_AP_MD2                   10
+#define MT6897_AP_MD3                   11
+
 #endif /* __MEDIATEK_LVTS_DT_H */
-- 
2.56.0

