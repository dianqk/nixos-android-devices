From: dianqk <dianqk@dianqk.net>
Date: Fri, 6 Nov 2026 10:00:00 +0800
Subject: [PATCH] i2c: mediatek: select the MT6897 controller data

i2c: mediatek: select the MT6897 controller data.

Original-Commit: local development history
Original-Author: dianqk <dianqk@dianqk.net>
Original-Date: 2026-10-15T17:02:30+08:00
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: dianqk <dianqk@dianqk.net>
---
 drivers/i2c/busses/i2c-mt65xx.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/i2c/busses/i2c-mt65xx.c b/drivers/i2c/busses/i2c-mt65xx.c
index ec8056beb5..36caa24934 100644
--- a/drivers/i2c/busses/i2c-mt65xx.c
+++ b/drivers/i2c/busses/i2c-mt65xx.c
@@ -561,6 +561,7 @@ static const struct of_device_id mtk_i2c_of_match[] = {
 	{ .compatible = "mediatek,mt8188-i2c", .data = &mt8188_compat },
 	{ .compatible = "mediatek,mt8192-i2c", .data = &mt8192_compat },
 	{ .compatible = "mediatek,mt6895-i2c", .data = &mt6895_compat },
+	{ .compatible = "mediatek,mt6897-i2c", .data = &mt6895_compat },
 	{}
 };
 MODULE_DEVICE_TABLE(of, mtk_i2c_of_match);
