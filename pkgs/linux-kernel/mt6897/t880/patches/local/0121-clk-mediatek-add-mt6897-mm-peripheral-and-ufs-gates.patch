+	GATE_UFSCFG(CLK_UFSCFG_UFSHCI_AES, "ufscfg_ufshci_aes", "aes_ufsfde_ck", 1),
+};
+
+static const struct mtk_clk_desc ufscfg_pdn_mcd = {
+	.clks = ufscfg_pdn_clks,
+	.num_clks = ARRAY_SIZE(ufscfg_pdn_clks),
+};
+
+static const struct of_device_id of_match_clk_mt6897_peri[] = {
+	{ .compatible = "mediatek,mt6897-pericfg-ao", .data = &perao_mcd },
+	{ .compatible = "mediatek,mt6897-ufscfg-ao", .data = &ufscfg_ao_mcd },
+	{ .compatible = "mediatek,mt6897-ufscfg-pdn", .data = &ufscfg_pdn_mcd },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, of_match_clk_mt6897_peri);
+
+static struct platform_driver clk_mt6897_peri_drv = {
+	.probe = mtk_clk_simple_probe,
+	.remove = mtk_clk_simple_remove,
+	.driver = {
+		.name = "clk-mt6897-peri",
+		.of_match_table = of_match_clk_mt6897_peri,
+	},
+};
+module_platform_driver(clk_mt6897_peri_drv);
+
+MODULE_DESCRIPTION("MediaTek MT6897 pericfg_ao and ufscfg clock gates");
+MODULE_LICENSE("GPL");
