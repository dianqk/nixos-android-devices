+		    "ufs_ck", 3),
+};
+
+static const struct mtk_clk_desc ufscfg_ao_mcd = {
+	.clks = ufscfg_ao_clks,
+	.num_clks = ARRAY_SIZE(ufscfg_ao_clks),
