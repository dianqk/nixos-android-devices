diff --git a/drivers/clk/mediatek/clk-mt6897-infra-ao.c b/drivers/clk/mediatek/clk-mt6897-infra-ao.c
new file mode 100644
index 0000000000..a133d53c56
--- /dev/null
+++ b/drivers/clk/mediatek/clk-mt6897-infra-ao.c
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6897 infracfg_ao clock gates: the modem interfaces (CCIF,
+ * CLDMA, DPMAIF) and the CQ DMA.
+ *
+ * Data from the MediaTek vendor driver (MiCode MTK_kernel_device_modules
+ * 3c4ccd07, drivers/clk/mediatek/clk-mt6897-bus.c).
+ */
+
+#include <dt-bindings/clock/mediatek,mt6897-clock.h>
+#include <linux/clk-provider.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#include "clk-gate.h"
+#include "clk-mtk.h"
+
+static const struct mtk_gate_regs ifrao_cg_regs = {
+	.set_ofs = 0x80,
+	.clr_ofs = 0x84,
+	.sta_ofs = 0x90,
+};
+
+#define GATE_IFRAO(_id, _name, _parent, _shift)				\
+	GATE_MTK(_id, _name, _parent, &ifrao_cg_regs, _shift,		\
+		 &mtk_clk_gate_ops_setclr)
+
+static const struct mtk_gate ifrao_clks[] = {
+	GATE_IFRAO(CLK_IFRAO_CQ_DMA_FPC, "ifrao_dma", "f26m_ck", 1),
+	GATE_IFRAO(CLK_IFRAO_CCIF1_AP, "ifrao_ccif1_ap", "axi_ck", 4),
+	GATE_IFRAO(CLK_IFRAO_CCIF1_MD, "ifrao_ccif1_md", "axi_ck", 5),
+	GATE_IFRAO(CLK_IFRAO_CCIF_AP, "ifrao_ccif_ap", "axi_ck", 6),
+	GATE_IFRAO(CLK_IFRAO_CCIF_MD, "ifrao_ccif_md", "axi_ck", 8),
+	GATE_IFRAO(CLK_IFRAO_CLDMA_BCLK, "ifrao_cldmabclk", "axi_ck", 12),
+	GATE_IFRAO(CLK_IFRAO_CQ_DMA, "ifrao_cq_dma", "axi_ck", 13),
+	GATE_IFRAO(CLK_IFRAO_CCIF5_MD, "ifrao_ccif5_md", "axi_ck", 15),
+	GATE_IFRAO(CLK_IFRAO_CCIF2_AP, "ifrao_ccif2_ap", "axi_ck", 16),
+	GATE_IFRAO(CLK_IFRAO_CCIF2_MD, "ifrao_ccif2_md", "axi_ck", 17),
+	GATE_IFRAO(CLK_IFRAO_DPMAIF_MAIN, "ifrao_dpmaif_main", "dpmaif_main_ck", 22),
+	GATE_IFRAO(CLK_IFRAO_CCIF4_MD, "ifrao_ccif4_md", "axi_ck", 24),
+	GATE_IFRAO(CLK_IFRAO_RG_MMW_DPMAIF26M_CK, "ifrao_dpmaif_26m", "f26m_ck", 25),
+};
+
+static const struct mtk_clk_desc ifrao_mcd = {
+	.clks = ifrao_clks,
+	.num_clks = ARRAY_SIZE(ifrao_clks),
+};
+
+static const struct of_device_id of_match_clk_mt6897_infra_ao[] = {
+	{ .compatible = "mediatek,mt6897-infracfg-ao", .data = &ifrao_mcd },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, of_match_clk_mt6897_infra_ao);
+
+static struct platform_driver clk_mt6897_infra_ao_drv = {
+	.probe = mtk_clk_simple_probe,
+	.remove = mtk_clk_simple_remove,
+	.driver = {
+		.name = "clk-mt6897-infra-ao",
+		.of_match_table = of_match_clk_mt6897_infra_ao,
+	},
+};
+module_platform_driver(clk_mt6897_infra_ao_drv);
+
+MODULE_DESCRIPTION("MediaTek MT6897 infracfg_ao clock gates");
+MODULE_LICENSE("GPL");
