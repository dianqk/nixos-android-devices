@@ -0,0 +1,154 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6897 pericfg_ao clock gates.
+ *
+ * Data from the MediaTek vendor driver (MiCode MTK_kernel_device_modules
+ * 3c4ccd07, drivers/clk/mediatek/clk-mt6897-peri.c). The gates that go
+ * through the hardware voter (disp_pwm0/1, spi0) are only passed through
+ * here: they are never written, so the voter's state is left alone.
+ */
+
+#include <dt-bindings/clock/mediatek,mt6897-clock.h>
+#include <linux/clk-provider.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#include "clk-gate.h"
+#include "clk-mtk.h"
+
+static const struct mtk_gate_regs perao0_cg_regs = {
+	.set_ofs = 0x24,
+	.clr_ofs = 0x28,
+	.sta_ofs = 0x10,
+};
+
+static const struct mtk_gate_regs perao1_cg_regs = {
+	.set_ofs = 0x2c,
+	.clr_ofs = 0x30,
+	.sta_ofs = 0x14,
+};
+
+static const struct mtk_gate_regs perao2_cg_regs = {
+	.set_ofs = 0x34,
+	.clr_ofs = 0x38,
+	.sta_ofs = 0x18,
+};
+
+#define GATE_PERAO0(_id, _name, _parent, _shift)			\
+	GATE_MTK(_id, _name, _parent, &perao0_cg_regs, _shift,		\
+		 &mtk_clk_gate_ops_setclr)
+#define GATE_PERAO1(_id, _name, _parent, _shift)			\
+	GATE_MTK(_id, _name, _parent, &perao1_cg_regs, _shift,		\
+		 &mtk_clk_gate_ops_setclr)
+#define GATE_PERAO2(_id, _name, _parent, _shift)			\
+	GATE_MTK(_id, _name, _parent, &perao2_cg_regs, _shift,		\
+		 &mtk_clk_gate_ops_setclr)
+
+static const struct mtk_gate perao_clks[] = {
+	/* PERAO0 */
+	GATE_PERAO0(CLK_PERAOP_UART0, "peraop_uart0", "uart_ck", 0),
+	GATE_PERAO0(CLK_PERAOP_UART1, "peraop_uart1", "uart_ck", 1),
+	GATE_PERAO0(CLK_PERAOP_UART2, "peraop_uart2", "uart_ck", 2),
+	GATE_PERAO0(CLK_PERAOP_UART3, "peraop_uart3", "uart_ck", 3),
+	GATE_PERAO0(CLK_PERAOP_PWM_HCLK, "peraop_pwm_hclk", "peri_faxi_ck", 4),
+	GATE_PERAO0(CLK_PERAOP_PWM_BCLK, "peraop_pwm_bclk", "pwm_ck", 5),
+	GATE_PERAO0(CLK_PERAOP_PWM_FBCLK1, "peraop_pwm_fbclk1", "pwm_ck", 6),
+	GATE_PERAO0(CLK_PERAOP_PWM_FBCLK2, "peraop_pwm_fbclk2", "pwm_ck", 7),
+	GATE_PERAO0(CLK_PERAOP_PWM_FBCLK3, "peraop_pwm_fbclk3", "pwm_ck", 8),
+	GATE_PERAO0(CLK_PERAOP_PWM_FBCLK4, "peraop_pwm_fbclk4", "pwm_ck", 9),
+	GATE_PERAO0(CLK_PERAOP_SPI1_BCLK, "peraop_spi1_bclk", "spi1_ck", 13),
+	GATE_PERAO0(CLK_PERAOP_SPI2_BCLK, "peraop_spi2_bclk", "spi2_ck", 14),
+	GATE_PERAO0(CLK_PERAOP_SPI3_BCLK, "peraop_spi3_bclk", "spi3_ck", 15),
+	GATE_PERAO0(CLK_PERAOP_SPI4_BCLK, "peraop_spi4_bclk", "spi4_ck", 16),
+	GATE_PERAO0(CLK_PERAOP_SPI5_BCLK, "peraop_spi5_bclk", "spi5_ck", 17),
+	GATE_PERAO0(CLK_PERAOP_SPI6_BCLK, "peraop_spi6_bclk", "spi6_ck", 18),
+	GATE_PERAO0(CLK_PERAOP_SPI7_BCLK, "peraop_spi7_bclk", "spi7_ck", 19),
+	/* PERAO1 */
+	GATE_PERAO1(CLK_PERAOP_DMA_BCLK, "peraop_dma_bclk", "peri_faxi_ck", 1),
+	GATE_PERAO1(CLK_PERAOP_SSUSB0_FRMCNT, "peraop_ssusb0_frmcnt",
+		    "ssusb_fmcnt_ck", 4),
+	GATE_PERAO1(CLK_PERAOP_MSDC1, "peraop_msdc1", "msdc30_1_ck", 10),
+	GATE_PERAO1(CLK_PERAOP_MSDC1_FCLK, "peraop_msdc1_fclk", "peri_faxi_ck", 11),
+	GATE_PERAO1(CLK_PERAOP_MSDC1_HCLK, "peraop_msdc1_hclk", "peri_faxi_ck", 12),
+	GATE_PERAO1(CLK_PERAOP_MSDC2, "peraop_msdc2", "msdc30_2_ck", 13),
+	GATE_PERAO1(CLK_PERAOP_MSDC2_FCLK, "peraop_msdc2_fclk", "peri_faxi_ck", 14),
+	GATE_PERAO1(CLK_PERAOP_MSDC2_HCLK, "peraop_msdc2_hclk", "peri_faxi_ck", 15),
+	/* PERAO2 */
+	GATE_PERAO2(CLK_PERAOP_AUDIO_SLV_CK, "peraop_audio_slv_ck", "peri_faxi_ck", 0),
+	GATE_PERAO2(CLK_PERAOP_AUDIO_MST_CK, "peraop_audio_mst_ck", "peri_faxi_ck", 1),
+	GATE_PERAO2(CLK_PERAOP_AUDIO_INTBUS_CK, "peraop_aud_intbusck",
+		    "aud_intbus_ck", 2),
+};
+
+/* Voter-owned gates: pass-through only, never written */
+static const struct mtk_fixed_factor perao_hwv_passthrough[] = {
+	FACTOR(CLK_PERAOP_DISP_PWM0, "peraop_disp_pwm0", "disp_pwm_ck", 1, 1),
+	FACTOR(CLK_PERAOP_DISP_PWM1, "peraop_disp_pwm1", "disp_pwm_ck", 1, 1),
+	FACTOR(CLK_PERAOP_SPI0_BCLK, "peraop_spi0_bclk", "spi0_ck", 1, 1),
+};
+
+static const struct mtk_clk_desc perao_mcd = {
+	.clks = perao_clks,
+	.num_clks = ARRAY_SIZE(perao_clks),
+	.factor_clks = perao_hwv_passthrough,
+	.num_factor_clks = ARRAY_SIZE(perao_hwv_passthrough),
+};
+
+/* UFSCFG_AO and UFSCFG_PDN: the UFS UniPro and host controller gates. */
+static const struct mtk_gate_regs ufscfg_cg_regs = {
+	.set_ofs = 0x8,
+	.clr_ofs = 0xc,
+	.sta_ofs = 0x4,
+};
+
+#define GATE_UFSCFG(_id, _name, _parent, _shift)			\
+	GATE_MTK(_id, _name, _parent, &ufscfg_cg_regs, _shift,		\
+		 &mtk_clk_gate_ops_setclr)
+
+static const struct mtk_gate ufscfg_ao_clks[] = {
+	GATE_UFSCFG(CLK_UFSCFG_AO_UNIPRO_TX_SYMBOLCLK, "ufscfg_ao_unipro_tx_sym",
+		    "f26m_ck", 0),
+	GATE_UFSCFG(CLK_UFSCFG_AO_UNIPRO_RX_SYMBOLCLK0, "ufscfg_ao_unipro_rx_sym0",
+		    "f26m_ck", 1),
+	GATE_UFSCFG(CLK_UFSCFG_AO_UNIPRO_RX_SYMBOLCLK1, "ufscfg_ao_unipro_rx_sym1",
+		    "f26m_ck", 2),
