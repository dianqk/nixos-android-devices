From c20736919acae61b2c61989f14b97a56af48f388 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Mon, 9 Nov 2026 06:40:12 +0800
Subject: [PATCH] drm/mediatek: recover MT6897 Type-C sink interrupts

Preserve HPD IRQ Attention when the sink keeps HPD high and service only
supported DPCD requests. Check the trained lane lock and alignment before
retraining. Keep healthy streams untouched, retrain active links once at
their exact rate/lane count, and report failed recovery to DRM.

Serialize recovery with stream, AUX-power, diagnostic and sleep paths.
Track active video separately from a trained link, stop publication before
IRQ teardown, and keep the DRM device alive until the IRQ drains. Propagate
AUX failures through training and reject invalid lane counts. Failed
recovery stays muted until a fresh attachment or explicit idle retrain.

The MT6897 OEM selector forwards HPD IRQ separately, and its sink checker
validates the trained lanes/alignment before restarting training. This is
a local implementation using the DRM DP helpers and existing MTK training
sequence, not an imported vendor commit.

Link: https://github.com/MiCode/MTK_kernel_device_modules/blob/3c4ccd07d5624879555ec710c11bb8818e5cb5c6/drivers/misc/mediatek/typec/mux/usb_dp_selector.c
Link: https://github.com/MiCode/MTK_kernel_device_modules/blob/3c4ccd07d5624879555ec710c11bb8818e5cb5c6/drivers/gpu/drm/mediatek/mediatek_v2/mtk_dp.c
Signed-off-by: dianqk <dianqk@dianqk.net>
---
 drivers/gpu/drm/mediatek/mtk_dp.c | 394 ++++++++++++++++++++++++++----
 1 file changed, 342 insertions(+), 52 deletions(-)

diff --git a/drivers/gpu/drm/mediatek/mtk_dp.c b/drivers/gpu/drm/mediatek/mtk_dp.c
index c322f27bc7..c11d2b2f18 100644
--- a/drivers/gpu/drm/mediatek/mtk_dp.c
+++ b/drivers/gpu/drm/mediatek/mtk_dp.c
@@ -11,6 +11,7 @@
 #include <drm/drm_bridge.h>
 #include <drm/drm_crtc.h>
 #include <drm/drm_edid.h>
+#include <drm/drm_drv.h>
 #include <drm/drm_of.h>
 #include <drm/drm_panel.h>
 #include <drm/drm_print.h>
@@ -104,6 +105,13 @@ struct mtk_dp_efuse_fmt {
 
 struct mtk_dp {
 	bool enabled;
+	/* Serialize training/stream changes, AUX power and system sleep. */
+	struct mutex link_lock;
+	bool stream_active;
+	bool suspended;
+	bool stopping;
+	bool irq_recovery_failed;
+	u32 hpd_generation;
 	bool need_debounce;
 	int irq;
 	u8 max_lanes;
@@ -1719,13 +1727,20 @@ static int mtk_dp_train_setting(struct mtk_dp *mtk_dp, u8 target_link_rate,
 {
 	int ret;
 
-	drm_dp_dpcd_writeb(&mtk_dp->aux, DP_LINK_BW_SET, target_link_rate);
-	drm_dp_dpcd_writeb(&mtk_dp->aux, DP_LANE_COUNT_SET,
+	ret = drm_dp_dpcd_writeb(&mtk_dp->aux, DP_LINK_BW_SET, target_link_rate);
+	if (ret != 1)
+		return ret < 0 ? ret : -EIO;
+	ret = drm_dp_dpcd_writeb(&mtk_dp->aux, DP_LANE_COUNT_SET,
 			   target_lane_count | DP_LANE_COUNT_ENHANCED_FRAME_EN);
+	if (ret != 1)
+		return ret < 0 ? ret : -EIO;
 
-	if (mtk_dp->train_info.sink_ssc)
-		drm_dp_dpcd_writeb(&mtk_dp->aux, DP_DOWNSPREAD_CTRL,
+	if (mtk_dp->train_info.sink_ssc) {
+		ret = drm_dp_dpcd_writeb(&mtk_dp->aux, DP_DOWNSPREAD_CTRL,
 				   DP_SPREAD_AMP_0_5);
+		if (ret != 1)
+			return ret < 0 ? ret : -EIO;
+	}
 
 	mtk_dp_set_lanes(mtk_dp, target_lane_count / 2);
 	ret = mtk_dp_phy_configure(mtk_dp, target_link_rate, target_lane_count);
@@ -1745,6 +1760,7 @@ static int mtk_dp_train_cr(struct mtk_dp *mtk_dp, u8 target_lane_count)
 	u8 link_status[DP_LINK_STATUS_SIZE] = {};
 	u8 prev_lane_adjust = 0xff;
 	int train_retries = 0;
+	int ret;
 	int voltage_retries = 0;
 
 	mtk_dp_pattern(mtk_dp, true);
@@ -1757,8 +1773,10 @@ static int mtk_dp_train_cr(struct mtk_dp *mtk_dp, u8 target_lane_count)
 			return -ENODEV;
 		}
 
-		drm_dp_dpcd_read(&mtk_dp->aux, DP_ADJUST_REQUEST_LANE0_1,
+		ret = drm_dp_dpcd_read(&mtk_dp->aux, DP_ADJUST_REQUEST_LANE0_1,
 				 lane_adjust, sizeof(lane_adjust));
+		if (ret != sizeof(lane_adjust))
+			return ret < 0 ? ret : -EIO;
 		mtk_dp_train_update_swing_pre(mtk_dp, target_lane_count,
 					      lane_adjust);
 
@@ -1766,7 +1784,9 @@ static int mtk_dp_train_cr(struct mtk_dp *mtk_dp, u8 target_lane_count)
 						       mtk_dp->rx_cap);
 
 		/* check link status from sink device */
-		drm_dp_dpcd_read_link_status(&mtk_dp->aux, link_status);
+		ret = drm_dp_dpcd_read_link_status(&mtk_dp->aux, link_status);
+		if (ret)
+			return ret;
 		memcpy(mtk_dp->last_link_status, link_status, sizeof(link_status));
 		if (drm_dp_clock_recovery_ok(link_status,
 					     target_lane_count)) {
@@ -1816,6 +1836,7 @@ static int mtk_dp_train_eq(struct mtk_dp *mtk_dp, u8 target_lane_count)
 	u8 lane_adjust[2] = {};
 	u8 link_status[DP_LINK_STATUS_SIZE] = {};
 	int train_retries = 0;
+	int ret;
 
 	mtk_dp_pattern(mtk_dp, false);
 
@@ -1826,8 +1847,10 @@ static int mtk_dp_train_eq(struct mtk_dp *mtk_dp, u8 target_lane_count)
 			return -ENODEV;
 		}
 
-		drm_dp_dpcd_read(&mtk_dp->aux, DP_ADJUST_REQUEST_LANE0_1,
+		ret = drm_dp_dpcd_read(&mtk_dp->aux, DP_ADJUST_REQUEST_LANE0_1,
 				 lane_adjust, sizeof(lane_adjust));
+		if (ret != sizeof(lane_adjust))
+			return ret < 0 ? ret : -EIO;
 		mtk_dp_train_update_swing_pre(mtk_dp, target_lane_count,
 					      lane_adjust);
 
@@ -1835,16 +1858,18 @@ static int mtk_dp_train_eq(struct mtk_dp *mtk_dp, u8 target_lane_count)
 						   mtk_dp->rx_cap);
 
 		/* check link status from sink device */
-		drm_dp_dpcd_read_link_status(&mtk_dp->aux, link_status);
+		ret = drm_dp_dpcd_read_link_status(&mtk_dp->aux, link_status);
+		if (ret)
+			return ret;
 		memcpy(mtk_dp->last_link_status, link_status, sizeof(link_status));
 		if (drm_dp_channel_eq_ok(link_status, target_lane_count)) {
 			dev_dbg(mtk_dp->dev, "Link train EQ pass\n");
 
 			/* Training done, and disable pattern. */
-			drm_dp_dpcd_writeb(&mtk_dp->aux, DP_TRAINING_PATTERN_SET,
+			ret = drm_dp_dpcd_writeb(&mtk_dp->aux, DP_TRAINING_PATTERN_SET,
 					   DP_TRAINING_PATTERN_DISABLE);
 			mtk_dp_train_set_pattern(mtk_dp, 0);
-			return 0;
+			return ret == 1 ? 0 : (ret < 0 ? ret : -EIO);
 		}
 		dev_dbg(mtk_dp->dev, "Link train EQ fail\n");
 	} while (train_retries < MTK_DP_TRAIN_DOWNSCALE_RETRY);
@@ -1891,7 +1916,8 @@ static int mtk_dp_parse_capabilities(struct mtk_dp *mtk_dp)
 		return ret == 0 ? -EIO : ret;
 	}
 
-	if (val & DP_MST_CAP) {
+	/* MT6897 uses SST: do not acknowledge unserviced MST messages. */
+	if ((val & DP_MST_CAP) && !mtk_dp->data->mt6897_phya) {
 		/* Clear DP_DEVICE_SERVICE_IRQ_VECTOR_ESI0 */
 		ret = drm_dp_dpcd_readb(&mtk_dp->aux,
 					DP_DEVICE_SERVICE_IRQ_VECTOR_ESI0,
@@ -1948,6 +1974,9 @@ static int mtk_dp_training(struct mtk_dp *mtk_dp)
 	if (mtk_dp->dbg_max_lanes)
 		lane_count = min_t(u8, lane_count, mtk_dp->dbg_max_lanes);
 
+	if ((lane_count != 1 && lane_count != 2 && lane_count != 4) || !link_rate)
+		return -EINVAL;
+
 	/*
 	 * TPS are generated by the hardware pattern generator. From the
 	 * hardware setting we need to disable this scramble setting before
@@ -1960,22 +1989,24 @@ static int mtk_dp_training(struct mtk_dp *mtk_dp)
 
 		ret = mtk_dp_train_setting(mtk_dp, link_rate, lane_count);
 		if (ret)
-			return ret;
+			goto failed;
 
 		dev_dbg(mtk_dp->dev, "training: rate 0x%02x, %u lanes\n",
 			link_rate, lane_count);
 
 		ret = mtk_dp_train_cr(mtk_dp, lane_count);
-		if (ret == -ENODEV) {
-			return ret;
+		if (ret && ret != -ETIMEDOUT) {
+			goto failed;
 		} else if (ret) {
 			/* reduce link rate */
 			switch (link_rate) {
 			case DP_LINK_BW_1_62:
 				lane_count = lane_count / 2;
 				link_rate = max_link_rate;
-				if (lane_count == 0)
-					return -EIO;
+				if (lane_count == 0) {
+					ret = -EIO;
+					goto failed;
+				}
 				break;
 			case DP_LINK_BW_2_7:
 				link_rate = DP_LINK_BW_1_62;
@@ -1987,18 +2018,21 @@ static int mtk_dp_training(struct mtk_dp *mtk_dp)
 				link_rate = DP_LINK_BW_5_4;
 				break;
 			default:
-				return -EINVAL;
+				ret = -EINVAL;
+				goto failed;
 			}
 			continue;
 		}
 
 		ret = mtk_dp_train_eq(mtk_dp, lane_count);
-		if (ret == -ENODEV) {
-			return ret;
+		if (ret && ret != -ETIMEDOUT) {
+			goto failed;
 		} else if (ret) {
 			/* reduce lane count */
-			if (lane_count == 0)
-				return -EIO;
+			if (lane_count <= 1) {
+				ret = -EIO;
+				goto failed;
+			}
 			lane_count /= 2;
 			continue;
 		}
@@ -2007,8 +2041,10 @@ static int mtk_dp_training(struct mtk_dp *mtk_dp)
 		break;
 	}
 
-	if (train_limit == 0)
-		return -ETIMEDOUT;
+	if (train_limit == 0) {
+		ret = -ETIMEDOUT;
+		goto failed;
+	}
 
 	mtk_dp->train_info.link_rate = link_rate;
 	mtk_dp->train_info.lane_count = lane_count;
@@ -2021,6 +2057,12 @@ static int mtk_dp_training(struct mtk_dp *mtk_dp)
 	mtk_dp_set_enhanced_frame_mode(mtk_dp);
 
 	return 0;
+
+failed:
+	drm_dp_dpcd_writeb(&mtk_dp->aux, DP_TRAINING_PATTERN_SET,
+			   DP_TRAINING_PATTERN_DISABLE);
+	mtk_dp_train_set_pattern(mtk_dp, 0);
+	return ret;
 }
 
 static void mtk_dp_video_enable(struct mtk_dp *mtk_dp, bool enable)
@@ -2108,28 +2150,188 @@ static void mtk_dp_set_oob_hpd(struct mtk_dp *mtk_dp)
  * state change as the HPD interrupt would. Before the bridge is attached
  * only the level is kept.
  */
-static void mtk_dp_oob_hpd_update(struct mtk_dp *mtk_dp, bool level)
+static void mtk_dp_oob_hpd_update(struct mtk_dp *mtk_dp, bool level, bool irq)
 {
 	unsigned long flags;
 
 	spin_lock_irqsave(&mtk_dp->irq_thread_lock, flags);
-	if (level == mtk_dp->oob_hpd_level) {
+	if (mtk_dp->stopping) {
+		spin_unlock_irqrestore(&mtk_dp->irq_thread_lock, flags);
+		return;
+	}
+	if (level != mtk_dp->oob_hpd_level) {
+		mtk_dp->oob_hpd_level = level;
+		WRITE_ONCE(mtk_dp->hpd_generation, mtk_dp->hpd_generation + 1);
+		WRITE_ONCE(mtk_dp->train_info.cable_plugged_in, level);
+		if (mtk_dp->drm_dev)
+			mtk_dp->irq_thread_handle |= MTK_DP_THREAD_CABLE_STATE_CHG;
+	} else if (irq && level && mtk_dp->train_info.cable_plugged_in &&
+		   mtk_dp->drm_dev) {
+		mtk_dp->irq_thread_handle |= MTK_DP_THREAD_HPD_EVENT;
+	} else {
 		spin_unlock_irqrestore(&mtk_dp->irq_thread_lock, flags);
 		return;
 	}
-	mtk_dp->oob_hpd_level = level;
 	if (!mtk_dp->drm_dev) {
 		spin_unlock_irqrestore(&mtk_dp->irq_thread_lock, flags);
 		return;
 	}
-	mtk_dp->irq_thread_handle |= MTK_DP_THREAD_CABLE_STATE_CHG;
-	mtk_dp->train_info.cable_plugged_in = level;
 	spin_unlock_irqrestore(&mtk_dp->irq_thread_lock, flags);
 
-	mtk_dp_set_oob_hpd(mtk_dp);
+	mutex_lock(&mtk_dp->link_lock);
+	if (!mtk_dp->suspended && !mtk_dp->stopping && mtk_dp->drm_dev)
+		mtk_dp_set_oob_hpd(mtk_dp);
+	mutex_unlock(&mtk_dp->link_lock);
 	irq_wake_thread(mtk_dp->irq, mtk_dp);
 }
 
+/* link_lock held; keep the active mode's bandwidth and transport parameters. */
+static int mtk_dp_retrain_active(struct mtk_dp *mtk_dp)
+{
+	int ret, cleanup;
+	u8 lanes = mtk_dp->train_info.lane_count;
+	u8 rate = mtk_dp->train_info.link_rate;
+
+	mtk_dp_training_set_scramble(mtk_dp, false);
+	mtk_dp_train_change_mode(mtk_dp);
+	ret = mtk_dp_train_setting(mtk_dp, rate, lanes);
+	if (!ret)
+		ret = mtk_dp_train_cr(mtk_dp, lanes);
+	if (!ret)
+		ret = mtk_dp_train_eq(mtk_dp, lanes);
+
+	/* Also clean up a failed setting/CR path, not just successful EQ. */
+	cleanup = drm_dp_dpcd_writeb(&mtk_dp->aux, DP_TRAINING_PATTERN_SET,
+			   DP_TRAINING_PATTERN_DISABLE);
+	if (!ret && cleanup != 1)
+		ret = cleanup < 0 ? cleanup : -EIO;
+	mtk_dp_train_set_pattern(mtk_dp, 0);
+	mtk_dp_training_set_scramble(mtk_dp, true);
+	if (!ret)
+		mtk_dp_set_enhanced_frame_mode(mtk_dp);
+	return ret;
+}
+
+/*
+ * MT6897's Type-C Attention carries a sink interrupt even when HPD stays high.
+ * Service supported requests only; an unknown service bit must remain pending.
+ * Return whether DRM needs to reprobe, with no DRM callbacks under link_lock.
+ */
+static bool mtk_dp_service_irq(struct mtk_dp *mtk_dp)
+{
+	u8 status[DP_LINK_STATUS_SIZE], service, ack = 0;
+	u32 generation = READ_ONCE(mtk_dp->hpd_generation);
+	int lanes = mtk_dp->train_info.lane_count;
+	bool active = mtk_dp->stream_active;
+	int ret;
+
+	if (!mtk_dp->data->mt6897_phya || !mtk_dp->typec_mux ||
+	    mtk_dp->suspended || READ_ONCE(mtk_dp->stopping) || !mtk_dp->drm_dev ||
+	    !READ_ONCE(mtk_dp->train_info.cable_plugged_in) ||
+	    !READ_ONCE(mtk_dp->typec_lanes) || mtk_dp->irq_recovery_failed)
+		return false;
+
+	if (!active && mtk_dp->link_failed)
+		mtk_dp_aux_panel_poweron(mtk_dp, true);
+
+	ret = drm_dp_dpcd_readb(&mtk_dp->aux, DP_DEVICE_SERVICE_IRQ_VECTOR,
+				&service);
+	if (ret != 1) {
+		ret = ret < 0 ? ret : -EIO;
+		goto failed;
+	}
+	if (service & DP_AUTOMATED_TEST_REQUEST) {
+		/* Compliance tests are unsupported: explicitly reject, then ack. */
+		ret = drm_dp_dpcd_writeb(&mtk_dp->aux, DP_TEST_RESPONSE, DP_TEST_NAK);
+		if (ret != 1) {
+			ret = ret < 0 ? ret : -EIO;
+			goto failed;
+		}
+		ack = DP_AUTOMATED_TEST_REQUEST;
+	}
+	if (ack) {
+		ret = drm_dp_dpcd_writeb(&mtk_dp->aux, DP_DEVICE_SERVICE_IRQ_VECTOR, ack);
+		if (ret != 1) {
+			ret = ret < 0 ? ret : -EIO;
+			goto failed;
+		}
+	}
+	if (service & ~ack)
+		dev_dbg(mtk_dp->dev, "Unhandled sink service IRQ %#x\n", service & ~ack);
+
+	/* A failed initial plug has no valid trained parameters or active mode. */
+	if (!active && mtk_dp->link_failed) {
+		ret = mtk_dp_parse_capabilities(mtk_dp);
+		if (!ret)
+			ret = mtk_dp_training(mtk_dp);
+		goto recovered;
+	}
+	if (lanes != 1 && lanes != 2 && lanes != 4) {
+		ret = -EINVAL;
+		goto failed;
+	}
+	ret = drm_dp_dpcd_read_link_status(&mtk_dp->aux, status);
+	if (ret)
+		goto failed;
+	memcpy(mtk_dp->last_link_status, status, sizeof(status));
+	if (drm_dp_clock_recovery_ok(status, lanes) &&
+	    drm_dp_channel_eq_ok(status, lanes))
+		return false;
+
+	if (lanes > READ_ONCE(mtk_dp->typec_lanes)) {
+		ret = -ENOLINK;
+		goto failed;
+	}
+	dev_info(mtk_dp->dev, "Sink lost link lock, retraining %#x x%u\n",
+		 mtk_dp->train_info.link_rate, lanes);
+	if (active)
+		mtk_dp_video_mute(mtk_dp, true);
+	ret = mtk_dp_retrain_active(mtk_dp);
+recovered:
+	if (READ_ONCE(mtk_dp->stopping) ||
+	    !READ_ONCE(mtk_dp->train_info.cable_plugged_in) ||
+	    generation != READ_ONCE(mtk_dp->hpd_generation))
+		return false;
+	if (ret)
+		goto failed;
+	ret = drm_dp_dpcd_read_link_status(&mtk_dp->aux, status);
+	if (ret)
+		goto failed;
+	lanes = mtk_dp->train_info.lane_count;
+	if ((lanes != 1 && lanes != 2 && lanes != 4) ||
+	    lanes > READ_ONCE(mtk_dp->typec_lanes) ||
+	    !drm_dp_clock_recovery_ok(status, lanes) ||
+	    !drm_dp_channel_eq_ok(status, lanes)) {
+		ret = -ENOLINK;
+		goto failed;
+	}
+	memcpy(mtk_dp->last_link_status, status, sizeof(status));
+	if (READ_ONCE(mtk_dp->stopping) ||
+	    !READ_ONCE(mtk_dp->train_info.cable_plugged_in) ||
+	    generation != READ_ONCE(mtk_dp->hpd_generation))
+		return false;
+	mtk_dp->link_failed = false;
+	mtk_dp->enabled = true;
+	/* Exact retraining leaves the live MSA/TU intact; atomic_check may stage info. */
+	if (active)
+		mtk_dp_video_mute(mtk_dp, false);
+	dev_info(mtk_dp->dev, "Sink link recovered\n");
+	return !active;
+
+failed:
+	/* Latch failure until a new attachment; repeated IRQs cannot train forever. */
+	if (READ_ONCE(mtk_dp->stopping) ||
+	    !READ_ONCE(mtk_dp->train_info.cable_plugged_in) ||
+	    generation != READ_ONCE(mtk_dp->hpd_generation))
+		return false;
+	if (active)
+		mtk_dp_video_mute(mtk_dp, true);
+	mtk_dp->link_failed = true;
+	mtk_dp->irq_recovery_failed = true;
+	dev_warn(mtk_dp->dev, "Sink link recovery failed: %d\n", ret);
+	return true;
+}
+
 static void mtk_dp_init_port(struct mtk_dp *mtk_dp)
 {
 	mtk_dp_set_idle_pattern(mtk_dp, true);
@@ -2153,7 +2355,8 @@ static irqreturn_t mtk_dp_hpd_event_thread(int hpd, void *dev)
 	struct mtk_dp *mtk_dp = dev;
 	unsigned long flags;
 	u32 status;
-	int ret;
+	bool notify = false;
+	int ret = -ENODEV;
 
 	if (mtk_dp->need_debounce && mtk_dp->train_info.cable_plugged_in)
 		msleep(100);
@@ -2163,17 +2366,23 @@ static irqreturn_t mtk_dp_hpd_event_thread(int hpd, void *dev)
 	mtk_dp->irq_thread_handle = 0;
 	spin_unlock_irqrestore(&mtk_dp->irq_thread_lock, flags);
 
+	mutex_lock(&mtk_dp->link_lock);
+	if (mtk_dp->suspended || mtk_dp->stopping || !mtk_dp->drm_dev)
+		goto unlock;
+
 	if (status & MTK_DP_THREAD_CABLE_STATE_CHG) {
+		mtk_dp->irq_recovery_failed = false;
 		/*
 		 * Without an HPD pin, train first: a sink whose link does not
 		 * train is reported disconnected instead of offering modes.
 		 */
 		if (mtk_dp->bridge.dev &&
 		    !(mtk_dp->oob_hpd && mtk_dp->train_info.cable_plugged_in))
-			drm_helper_hpd_irq_event(mtk_dp->bridge.dev);
+			notify = true;
 
 		if (!mtk_dp->train_info.cable_plugged_in) {
 			mtk_dp->link_failed = false;
+			mtk_dp->stream_active = false;
 			mtk_dp_disable_sdp_aui(mtk_dp);
 			memset(&mtk_dp->info.audio_cur_cfg, 0,
 			       sizeof(mtk_dp->info.audio_cur_cfg));
@@ -2230,12 +2439,19 @@ static irqreturn_t mtk_dp_hpd_event_thread(int hpd, void *dev)
 			mtk_dp->enabled = true;
 
 			if (mtk_dp->oob_hpd && mtk_dp->bridge.dev)
-				drm_helper_hpd_irq_event(mtk_dp->bridge.dev);
+				notify = true;
 		}
 	}
 
-	if (status & MTK_DP_THREAD_HPD_EVENT)
-		dev_dbg(mtk_dp->dev, "Receive IRQ from sink devices\n");
+	/* A cable change already trained the new link; do not train it twice. */
+	if ((status & MTK_DP_THREAD_HPD_EVENT) &&
+	    !(status & MTK_DP_THREAD_CABLE_STATE_CHG))
+		notify |= mtk_dp_service_irq(mtk_dp);
+
+unlock:
+	mutex_unlock(&mtk_dp->link_lock);
+	if (notify && mtk_dp->bridge.dev)
+		drm_helper_hpd_irq_event(mtk_dp->bridge.dev);
 
 	return IRQ_HANDLED;
 }
@@ -2374,6 +2590,12 @@ mtk_dp_bdg_detect(struct drm_bridge *bridge, struct drm_connector *connector)
 	if (!mtk_dp->train_info.cable_plugged_in)
 		return ret;
 
