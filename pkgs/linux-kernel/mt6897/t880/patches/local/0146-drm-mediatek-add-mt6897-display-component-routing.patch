Date: Fri, 6 Nov 2026 10:00:00 +0800
Subject: [PATCH] drm/mediatek: add MT6897 display component routing

Register MT6897 relays and component paths and correct DirectLink
endpoint, port and direction selection.

Original-Commit: local development history
Original-Author: dianqk <dianqk@dianqk.net>
Original-Date: 2026-10-17T05:51:24+08:00
Original-Commit: local development history
Original-Author: dianqk <dianqk@dianqk.net>
Original-Date: 2026-10-17T14:13:46+08:00
Original-Commit: local development history
Original-Author: dianqk <dianqk@dianqk.net>
Original-Date: 2026-10-18T10:26:26+08:00
Signed-off-by: dianqk <dianqk@dianqk.net>
---
 drivers/gpu/drm/mediatek/mtk_ddp_comp.c       | 237 ++++++++++++++++--
 .../gpu/drm/mediatek/mtk_disp_directlink.c    |  44 +++-
 2 files changed, 241 insertions(+), 40 deletions(-)

diff --git a/drivers/gpu/drm/mediatek/mtk_ddp_comp.c b/drivers/gpu/drm/mediatek/mtk_ddp_comp.c
index 453a4a9ad5..fe37902cfd 100644
--- a/drivers/gpu/drm/mediatek/mtk_ddp_comp.c
+++ b/drivers/gpu/drm/mediatek/mtk_ddp_comp.c
@@ -67,18 +67,82 @@ struct mtk_ddp_comp_dev {
 	struct clk *clk;
 	void __iomem *regs;
 	struct cmdq_client_reg cmdq_reg;
+	const void *data;
 };
 
+/**
+ * struct mtk_pq_relay_data - a picture-quality block used only as a relay
+ * @no_regs: the block has no registers (clock gate and mutex bit only)
+ * @en: enable register
+ * @cfg: configuration register taking @relay (within @relay_mask)
+ * @relay: relay value written to @cfg
+ * @relay_mask: bits of @cfg owned by @relay
+ * @size: input size register
+ * @size_out: optional output size register
+ * @size_hw: size registers take height << 16 | width (else width << 16 | height)
+ * @shadow: shadow control register
+ * @shadow_bypass: bits of @shadow that make register writes take effect at once
+ * @crop_w: optional crop width register, taking the size in bits 28:16
+ * @crop_h: optional crop height register, taking the size in bits 28:16
+ */
+struct mtk_pq_relay_data {
+	bool no_regs;
+	u16 en;
+	u16 cfg;
+	u32 relay;
+	u32 relay_mask;
+	u16 size;
+	u16 size_out;
+	bool size_hw;
+	u16 shadow;
+	u32 shadow_bypass;
+	u16 crop_w;
+	u16 crop_h;
+};
+
+#if IS_REACHABLE(CONFIG_MTK_CMDQ)
+/*
+ * Append a register write to a GCE packet, through a GCE subsys when the
+ * component has one, else by physical address (for example the MT6897
+ * OVLSYS blocks). The physical-address helpers take the high half of the
+ * address from @pa_base and the low 16 bits from @offset, so both get the
+ * full register address there.
+ */
+static bool mtk_ddp_cmdq_write(struct cmdq_pkt *cmdq_pkt, struct cmdq_client_reg *cmdq_reg,
+			       unsigned int offset, u32 value, u32 mask)
+{
+	u32 pa = cmdq_reg->pa_base + offset;
+	u16 reg_offset;
+
+	if (!cmdq_pkt || !cmdq_reg->pkt_write || !cmdq_reg->pkt_write_mask)
+		return false;
+
+	if (cmdq_reg->subsys == CMDQ_SUBSYS_INVALID)
+		reg_offset = pa;
+	else
+		reg_offset = cmdq_reg->offset + offset;
+
+	if (mask == GENMASK(31, 0))
+		cmdq_reg->pkt_write(cmdq_pkt, cmdq_reg->subsys, pa, reg_offset, value);
+	else
+		cmdq_reg->pkt_write_mask(cmdq_pkt, cmdq_reg->subsys, pa, reg_offset,
+					 value, mask);
+
+	return true;
+}
+#else
+static bool mtk_ddp_cmdq_write(struct cmdq_pkt *cmdq_pkt, struct cmdq_client_reg *cmdq_reg,
+			       unsigned int offset, u32 value, u32 mask)
+{
+	return false;
+}
+#endif
+
 void mtk_ddp_write(struct cmdq_pkt *cmdq_pkt, unsigned int value,
 		   struct cmdq_client_reg *cmdq_reg, void __iomem *regs,
 		   unsigned int offset)
 {
-#if IS_REACHABLE(CONFIG_MTK_CMDQ)
-	if (cmdq_pkt)
-		cmdq_pkt_write(cmdq_pkt, cmdq_reg->subsys,
-			       cmdq_reg->offset + offset, value);
-	else
-#endif
+	if (!mtk_ddp_cmdq_write(cmdq_pkt, cmdq_reg, offset, value, GENMASK(31, 0)))
 		writel(value, regs + offset);
 }
 
@@ -86,12 +150,7 @@ void mtk_ddp_write_relaxed(struct cmdq_pkt *cmdq_pkt, unsigned int value,
 			   struct cmdq_client_reg *cmdq_reg, void __iomem *regs,
 			   unsigned int offset)
 {
-#if IS_REACHABLE(CONFIG_MTK_CMDQ)
-	if (cmdq_pkt)
-		cmdq_pkt_write(cmdq_pkt, cmdq_reg->subsys,
-			       cmdq_reg->offset + offset, value);
-	else
-#endif
+	if (!mtk_ddp_cmdq_write(cmdq_pkt, cmdq_reg, offset, value, GENMASK(31, 0)))
 		writel_relaxed(value, regs + offset);
 }
 
@@ -99,19 +158,14 @@ void mtk_ddp_write_mask(struct cmdq_pkt *cmdq_pkt, unsigned int value,
 			struct cmdq_client_reg *cmdq_reg, void __iomem *regs,
 			unsigned int offset, unsigned int mask)
 {
-#if IS_REACHABLE(CONFIG_MTK_CMDQ)
-	if (cmdq_pkt) {
-		cmdq_pkt_write_mask(cmdq_pkt, cmdq_reg->subsys,
-				    cmdq_reg->offset + offset, value, mask);
-	} else {
-#endif
-		u32 tmp = readl(regs + offset);
+	u32 tmp;
 
-		tmp = (tmp & ~mask) | (value & mask);
-		writel(tmp, regs + offset);
-#if IS_REACHABLE(CONFIG_MTK_CMDQ)
-	}
-#endif
+	if (mtk_ddp_cmdq_write(cmdq_pkt, cmdq_reg, offset, value, mask))
+		return;
+
+	tmp = readl(regs + offset);
+	tmp = (tmp & ~mask) | (value & mask);
+	writel(tmp, regs + offset);
 }
 
 static int mtk_ddp_clk_enable(struct mtk_ddp_comp *comp)
@@ -234,6 +288,118 @@ static void mtk_postmask_stop(struct device *dev)
 	writel_relaxed(0x0, priv->regs + DISP_REG_POSTMASK_EN);
 }
 
+static void mtk_pq_relay_config(struct mtk_ddp_comp *comp, unsigned int w,
+				unsigned int h, unsigned int vrefresh,
+				unsigned int bpc, struct cmdq_pkt *cmdq_pkt)
+{
+	struct mtk_ddp_comp_dev *priv = dev_get_drvdata(comp->dev);
+	const struct mtk_pq_relay_data *data = priv->data;
+	u32 size = data->size_hw ? h << 16 | w : w << 16 | h;
+
+	if (data->no_regs)
+		return;
+
+	if (data->shadow_bypass)
+		mtk_ddp_write_mask(cmdq_pkt, data->shadow_bypass, &priv->cmdq_reg,
+				   priv->regs, data->shadow, data->shadow_bypass);
+	mtk_ddp_write(cmdq_pkt, size, &priv->cmdq_reg, priv->regs, data->size);
+	if (data->size_out)
+		mtk_ddp_write(cmdq_pkt, size, &priv->cmdq_reg, priv->regs, data->size_out);
+	if (data->crop_w)
+		mtk_ddp_write_mask(cmdq_pkt, w << 16, &priv->cmdq_reg, priv->regs,
+				   data->crop_w, GENMASK(28, 16));
+	if (data->crop_h)
+		mtk_ddp_write_mask(cmdq_pkt, h << 16, &priv->cmdq_reg, priv->regs,
+				   data->crop_h, GENMASK(28, 16));
+	mtk_ddp_write_mask(cmdq_pkt, data->relay, &priv->cmdq_reg, priv->regs,
+			   data->cfg, data->relay_mask);
+}
+
+static void mtk_pq_relay_start(struct device *dev)
+{
+	struct mtk_ddp_comp_dev *priv = dev_get_drvdata(dev);
+	const struct mtk_pq_relay_data *data = priv->data;
+
+	if (!data->no_regs && data->en != data->cfg)
+		writel(BIT(0), priv->regs + data->en);
+}
+
+static void mtk_pq_relay_stop(struct device *dev)
+{
+	struct mtk_ddp_comp_dev *priv = dev_get_drvdata(dev);
+	const struct mtk_pq_relay_data *data = priv->data;
+
+	if (!data->no_regs && data->en != data->cfg)
+		writel(0, priv->regs + data->en);
+}
+
+/* MT6897 picture-quality blocks without drivers, used as relays */
+static const struct mtk_pq_relay_data mt6897_c3d_relay = {
+	.en = 0x000, .cfg = 0x004, .relay = 0x3, .relay_mask = 0x3,
+	.size = 0x024, .shadow = 0x030, .shadow_bypass = BIT(0),
+};
+
+static const struct mtk_pq_relay_data mt6897_mdp_aal_relay = {
+	.en = 0x000, .cfg = 0x020, .relay = 0x00400003, .relay_mask = ~0U,
+	.size = 0x030, .size_out = 0x034, .shadow = 0x0f0, .shadow_bypass = BIT(0),
+};
+
+/* SPR V2: enable, LUT enable and relay bits all live in 0x00c */
+static const struct mtk_pq_relay_data mt6897_spr_relay = {
+	.en = 0x00c, .cfg = 0x00c,
+	.relay = BIT(0) | BIT(1) | BIT(4), .relay_mask = BIT(0) | BIT(1) | BIT(4),
+	.size = 0x030, .size_hw = true, .crop_w = 0x03c, .crop_h = 0x040,
+	.shadow = 0x00c, .shadow_bypass = BIT(21) | BIT(22),
+};
+
+static const struct mtk_pq_relay_data mt6897_chist_relay = {
+	.en = 0x000, .cfg = 0x020, .relay = 0x1, .relay_mask = ~0U,
+	.size = 0x030, .shadow = 0x0f0, .shadow_bypass = BIT(0),
+};
+
+/*
+ * Blocks that have upstream drivers but are only needed as relays for the
+ * first MT6897 bring-up (the upstream drivers would enable processing).
+ */
+static const struct mtk_pq_relay_data mt6897_ccorr_relay = {
+	.en = 0x000, .cfg = 0x020, .relay = BIT(0), .relay_mask = 0x3,
+	.size = 0x030, .shadow = 0x0a0, .shadow_bypass = BIT(2),
+};
+
+static const struct mtk_pq_relay_data mt6897_aal_relay = {
+	.en = 0x000, .cfg = 0x020, .relay = BIT(0), .relay_mask = BIT(0),
+	.size = 0x030, .size_out = 0x4d8, .shadow = 0x0f0, .shadow_bypass = BIT(0),
+};
+
+static const struct mtk_pq_relay_data mt6897_gamma_relay = {
+	.en = 0x000, .cfg = 0x020, .relay = BIT(0), .relay_mask = 0x3,
+	.size = 0x030,
+};
+
+static const struct mtk_pq_relay_data mt6897_dither_relay = {
+	.en = 0x000, .cfg = 0x020, .relay = BIT(0), .relay_mask = 0x3,
+	.size = 0x030, .shadow = 0x100, .shadow_bypass = BIT(0),
+};
+
+/* ODDMR with OD/DMR unused and POSTALIGN: clock and mutex bit only */
+static const struct mtk_pq_relay_data mt6897_no_regs_relay = {
+	.no_regs = true,
+};
+
+static const struct of_device_id mtk_pq_relay_match[] = {
+	{ .compatible = "mediatek,mt6897-disp-aal", .data = &mt6897_aal_relay },
+	{ .compatible = "mediatek,mt6897-disp-c3d", .data = &mt6897_c3d_relay },
+	{ .compatible = "mediatek,mt6897-disp-ccorr", .data = &mt6897_ccorr_relay },
+	{ .compatible = "mediatek,mt6897-disp-dither", .data = &mt6897_dither_relay },
+	{ .compatible = "mediatek,mt6897-disp-gamma", .data = &mt6897_gamma_relay },
+	{ .compatible = "mediatek,mt6897-disp-mdp-aal", .data = &mt6897_mdp_aal_relay },
+	{ .compatible = "mediatek,mt6897-disp-spr", .data = &mt6897_spr_relay },
+	{ .compatible = "mediatek,mt6897-disp-chist", .data = &mt6897_chist_relay },
+	{ .compatible = "mediatek,mt6897-disp-oddmr", .data = &mt6897_no_regs_relay },
+	{ .compatible = "mediatek,mt6897-disp-postalign", .data = &mt6897_no_regs_relay },
+	{ }
+};
+
 static void mtk_rsz_config(struct mtk_ddp_comp *comp, unsigned int w,
 			   unsigned int h, unsigned int vrefresh,
 			   unsigned int bpc, struct cmdq_pkt *cmdq_pkt)
@@ -412,6 +578,14 @@ static const struct mtk_ddp_comp_funcs ddp_postmask = {
 	.stop = mtk_postmask_stop,
 };
 
+static const struct mtk_ddp_comp_funcs ddp_pq_relay = {
+	.clk_enable = mtk_ddp_clk_enable,
+	.clk_disable = mtk_ddp_clk_disable,
+	.config = mtk_pq_relay_config,
+	.start = mtk_pq_relay_start,
+	.stop = mtk_pq_relay_stop,
+};
+
 static const struct mtk_ddp_comp_funcs ddp_rdma = {
 	.clk_enable = mtk_rdma_clk_enable,
 	.clk_disable = mtk_rdma_clk_disable,
@@ -507,6 +681,7 @@ static const char * const mtk_ddp_comp_stem[MTK_DDP_COMP_TYPE_MAX] = {
 	[MTK_DISP_OVL_2L] = "ovl-2l",
 	[MTK_DISP_OVL_ADAPTOR] = "ovl_adaptor",
 	[MTK_DISP_POSTMASK] = "postmask",
+	[MTK_DISP_PQ_RELAY] = "pq-relay",
 	[MTK_DISP_PWM] = "pwm",
 	[MTK_DISP_RDMA] = "rdma",
 	[MTK_DISP_RSZ] = "resizer",
@@ -536,6 +711,7 @@ static const struct mtk_ddp_comp_funcs *mtk_ddp_funcs[MTK_DDP_COMP_TYPE_MAX] = {
 	[MTK_DISP_OVL_2L]		= &ddp_ovl,
 	[MTK_DISP_OVL_ADAPTOR]		= &ddp_ovl_adaptor,
 	[MTK_DISP_POSTMASK]		= &ddp_postmask,
+	[MTK_DISP_PQ_RELAY]		= &ddp_pq_relay,
 	[MTK_DISP_PWM]			= NULL,
 	[MTK_DISP_RDMA]			= &ddp_rdma,
 	[MTK_DISP_RSZ]			= &ddp_rsz,
@@ -699,6 +875,7 @@ bool mtk_ddp_comp_is_internal_comp(enum mtk_ddp_comp_type type)
 	case MTK_DISP_DITHER:
 	case MTK_DISP_OD:
 	case MTK_DISP_POSTMASK:
+	case MTK_DISP_PQ_RELAY:
 	case MTK_DISP_RSZ:
 	case MTK_DISP_UFOE:
 		return true;
@@ -719,9 +896,15 @@ static int mtk_ddp_comp_init_internal_comp(struct device *dev, struct device *co
 	if (!priv)
 		return -ENOMEM;
 
-	priv->regs = devm_of_iomap(dev, comp_node, 0, NULL);
-	if (IS_ERR(priv->regs))
-		return PTR_ERR(priv->regs);
+	if (of_match_node(mtk_pq_relay_match, comp_node))
+		priv->data = of_match_node(mtk_pq_relay_match, comp_node)->data;
+
+	/* Some relay-only blocks have no registers at all */
+	if (!priv->data || !((const struct mtk_pq_relay_data *)priv->data)->no_regs) {
+		priv->regs = devm_of_iomap(dev, comp_node, 0, NULL);
+		if (IS_ERR(priv->regs))
+			return PTR_ERR(priv->regs);
+	}
 
 	priv->clk = of_clk_get(comp_node, 0);
 	if (IS_ERR(priv->clk))
diff --git a/drivers/gpu/drm/mediatek/mtk_disp_directlink.c b/drivers/gpu/drm/mediatek/mtk_disp_directlink.c
index a473939dab..83bf57ab04 100644
--- a/drivers/gpu/drm/mediatek/mtk_disp_directlink.c
+++ b/drivers/gpu/drm/mediatek/mtk_disp_directlink.c
@@ -41,11 +41,14 @@
  * @dli0_size_reg:   Register offset of DL_IN_ASYNC0_SIZE
  * @dlo0_size_reg:   Register offset of DL_OUT_ASYNC0_SIZE
  * @pixels_per_iter: Number of pixels per iteration
+ * @no_size_regs:    The links carry no size registers (MT6897: the relays
+ *                   pass any size; the vendor never programs them)
  */
 struct mtk_direct_link_data {
 	u16 dli0_size_reg;
 	u16 dlo0_size_reg;
 	u8 pixels_per_iter;
+	bool no_size_regs;
 };
 
 /**
@@ -178,6 +181,9 @@ void mtk_direct_link_config(struct mtk_ddp_comp *comp,
 	u32 mask;
 	u32 val;
 
+	if (dl_async->data->no_size_regs)
+		return;
+
 	dl_port = mtk_direct_link_get_port(comp);
 	if (!dl_port) {
 		dev_err(comp->dev, "Could not get DirectLink port.\n");
@@ -255,8 +261,16 @@ static int mtk_direct_link_port_probe(struct device *dev, struct mtk_disp_dl_por
 	if (!of_port)
 		return -ENOENT;
 
-	for_each_of_graph_port_endpoint(of_port, ep)
-		num_links++;
+	/*
+	 * Components look links up by their endpoint number (the path), so
+	 * index the tables by it: paths need not be numbered densely.
+	 */
+	for_each_of_graph_port_endpoint(of_port, ep) {
+		struct of_endpoint endpoint;
+
+		if (!of_graph_parse_endpoint(ep, &endpoint))
+			num_links = max_t(u8, num_links, endpoint.id + 1);
+	}
 
 	clks = devm_kcalloc(dev, num_links, sizeof(*clks), GFP_KERNEL);
 	if (!clks)
@@ -266,7 +280,6 @@ static int mtk_direct_link_port_probe(struct device *dev, struct mtk_disp_dl_por
 	if (!link_ids)
 		return -ENOMEM;
 
-	i = 0;
 	for_each_of_graph_port_endpoint(of_port, ep) {
 		struct of_endpoint endpoint;
 		u32 hw_port_id;
@@ -275,6 +288,7 @@ static int mtk_direct_link_port_probe(struct device *dev, struct mtk_disp_dl_por
 		ret = of_graph_parse_endpoint(ep, &endpoint);
 		if (ret)
 			continue;
+		i = endpoint.id;
 
 		ret = of_property_read_u32(ep, "mediatek,port-id", &hw_port_id);
 		link_ids[i] = ret ? endpoint.id : hw_port_id;
@@ -283,7 +297,6 @@ static int mtk_direct_link_port_probe(struct device *dev, struct mtk_disp_dl_por
 			return dev_err_probe(dev, PTR_ERR(clks[i]),
 					     "Could not get clock\n");
 		}
-		i++;
 	}
 	dl_port->clks = clks;
 	dl_port->link_ids = link_ids;
@@ -299,7 +312,7 @@ static int mtk_direct_link_probe(struct platform_device *pdev)
 	struct mtk_direct_link *dl_async;
 	int in_mtx_id, out_mtx_id;
 	unsigned int num_ports;
-	int i, ret;
+	int ret;
 
 	dl_async = devm_kzalloc(dev, sizeof(*dl_async), GFP_KERNEL);
 	if (!dl_async)
@@ -307,10 +320,11 @@ static int mtk_direct_link_probe(struct platform_device *pdev)
 
 	dl_async->data = device_get_match_data(dev);
 
-	dl_async->regs = of_iomap(dev->of_node, 0);
-	if (IS_ERR(dl_async->regs))
-		return dev_err_probe(&pdev->dev, PTR_ERR(dl_async->regs),
-				     "Could not get regs\n");
+	if (!dl_async->data->no_size_regs) {
+		dl_async->regs = of_iomap(dev->of_node, 0);
+		if (!dl_async->regs)
+			return dev_err_probe(&pdev->dev, -ENOMEM, "Could not get regs\n");
+	}
 
 	num_ports = of_graph_get_port_count(main_node);
 	if (num_ports == 0)
@@ -359,7 +373,6 @@ static int mtk_direct_link_probe(struct platform_device *pdev)
 	dl_async->dl_port[MTK_DISP_DL_IN].p0_mtx_trig_id = in_mtx_id;
 	dl_async->dl_port[MTK_DISP_DL_OUT].p0_mtx_trig_id = out_mtx_id;
 
-	i = 0;
 	for_each_of_graph_port(main_node, port_node) {
 		u32 port_id;
 
@@ -367,11 +380,10 @@ static int mtk_direct_link_probe(struct platform_device *pdev)
 		if (port_id > 1)
 			continue;
 
-		ret = mtk_direct_link_port_probe(dev, &dl_async->dl_port[i], port_id);
+		/* Port 0 holds the inputs, port 1 the outputs */
+		ret = mtk_direct_link_port_probe(dev, &dl_async->dl_port[port_id], port_id);
 		if (ret)
 			return ret;
-
-		i++;
 	}
 
 	dl_async->clk = devm_clk_get(dev, 0);
@@ -413,7 +425,13 @@ static const struct mtk_direct_link_data mt8196_ovl_dl_async_data = {
 	.dlo0_size_reg = MTK_OVL_REG_DL_OUT_RELAY0_SIZE_MT8196,
 };
 
+static const struct mtk_direct_link_data mt6897_dl_async_data = {
+	.no_size_regs = true,
+};
+
 static const struct of_device_id mtk_direct_link_driver_dt_match[] = {
+	{ .compatible = "mediatek,mt6897-disp-direct-link", .data = &mt6897_dl_async_data },
+	{ .compatible = "mediatek,mt6897-ovl-direct-link", .data = &mt6897_dl_async_data },
 	{ .compatible = "mediatek,mt8196-disp-direct-link", .data = &mt8196_disp_dl_async_data },
 	{ .compatible = "mediatek,mt8196-ovl-direct-link", .data = &mt8196_ovl_dl_async_data },
 	{ /* sentinel */ }
