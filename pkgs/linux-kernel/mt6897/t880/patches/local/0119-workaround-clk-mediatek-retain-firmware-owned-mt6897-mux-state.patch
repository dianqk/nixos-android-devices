+	RO_MUX(CLK_TOP_OVL0_SEL, "ovl0_sel", ovl0_parents, CLK_CFG_1, 16, 4),
+	RO_MUX(CLK_TOP_OVL1_SEL, "ovl1_sel", ovl1_parents, CLK_CFG_1, 24, 4),
+	RO_MUX(CLK_TOP_MMINFRA_SEL, "mminfra_sel", mminfra_parents, CLK_CFG_2, 16, 4),
+	RO_MUX(CLK_TOP_DISP_PWM_SEL, "disp_pwm_sel", disp_pwm_parents, CLK_CFG_7, 8, 3),
+	RO_MUX(CLK_TOP_I2C_SEL, "i2c_sel", i2c_parents, CLK_CFG_8, 0, 2),
