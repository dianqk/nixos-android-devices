+	RO_MUX(CLK_TOP_CAM_SEL, "cam_sel", cam_parents, CLK_CFG_21, 0, 4),
+};
+
+static int clk_mt6897_top_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct clk_hw_onecell_data *clk_data;
+	void __iomem *base;
+	int i, ret;
+
+	base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(base))
+		return PTR_ERR(base);
+
+	clk_data = mtk_devm_alloc_clk_data(dev, CLK_TOP_NR_CLK);
+	if (!clk_data)
+		return -ENOMEM;
+
+	ret = mtk_clk_register_factors(top_divs, ARRAY_SIZE(top_divs),
+				       clk_data);
+	if (ret)
+		return ret;
+
+	ret = mtk_clk_register_muxes(dev, top_muxes,
+				     ARRAY_SIZE(top_muxes), dev->of_node,
+				     &mt6897_top_lock, clk_data);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < ARRAY_SIZE(top_ro_muxes); i++) {
+		const struct mt6897_ro_mux *m = &top_ro_muxes[i];
+		struct clk_hw *hw;
+
+		hw = devm_clk_hw_register_mux(dev, m->name, m->parents,
+					      m->num_parents, 0,
+					      base + m->reg, m->shift,
+					      m->width, CLK_MUX_READ_ONLY,
+					      &mt6897_top_lock);
+		if (IS_ERR(hw))
+			return PTR_ERR(hw);
+		clk_data->hws[m->id] = hw;
+	}
+
+	return devm_of_clk_add_hw_provider(dev, of_clk_hw_onecell_get, clk_data);
+}
+
+static const struct of_device_id of_match_clk_mt6897_top[] = {
+	{ .compatible = "mediatek,mt6897-topckgen" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, of_match_clk_mt6897_top);
+
+static struct platform_driver clk_mt6897_top_drv = {
+	.probe = clk_mt6897_top_probe,
+	.driver = {
+		.name = "clk-mt6897-top",
+		.of_match_table = of_match_clk_mt6897_top,
+	},
+};
+module_platform_driver(clk_mt6897_top_drv);
+
+MODULE_DESCRIPTION("MediaTek MT6897 topckgen clocks");
+MODULE_LICENSE("GPL");
