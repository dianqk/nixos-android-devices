+struct mt6897_ro_mux {
+	int id;
+	const char *name;
+	const char * const *parents;
+	u8 num_parents;
+	u32 reg;
+	u8 shift;
+	u8 width;
+};
+
+#define RO_MUX(_id, _name, _parents, _reg, _shift, _width) {		\
+		.id = _id, .name = _name, .parents = _parents,		\
+		.num_parents = ARRAY_SIZE(_parents), .reg = _reg,	\
+		.shift = _shift, .width = _width }
+
+static const struct mt6897_ro_mux vlp_ro_muxes[] = {
+
+};
+
+static int clk_mt6897_vlp_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct clk_hw_onecell_data *clk_data;
+	void __iomem *base;
+	int i, ret;
+
+	base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(base))
+		return PTR_ERR(base);
+
+	clk_data = mtk_devm_alloc_clk_data(dev, CLK_VLP_CK_NR_CLK);
+	if (!clk_data)
+		return -ENOMEM;
+
+	ret = mtk_clk_register_factors(vlp_divs, ARRAY_SIZE(vlp_divs),
+				       clk_data);
+	if (ret)
+		return ret;
+
+	ret = mtk_clk_register_muxes(dev, vlp_muxes,
+				     ARRAY_SIZE(vlp_muxes), dev->of_node,
+				     &mt6897_vlp_lock, clk_data);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < ARRAY_SIZE(vlp_ro_muxes); i++) {
+		const struct mt6897_ro_mux *m = &vlp_ro_muxes[i];
+		struct clk_hw *hw;
+
+		hw = devm_clk_hw_register_mux(dev, m->name, m->parents,
+					      m->num_parents, 0,
+					      base + m->reg, m->shift,
+					      m->width, CLK_MUX_READ_ONLY,
+					      &mt6897_vlp_lock);
+		if (IS_ERR(hw))
+			return PTR_ERR(hw);
+		clk_data->hws[m->id] = hw;
+	}
+
+	return devm_of_clk_add_hw_provider(dev, of_clk_hw_onecell_get, clk_data);
+}
