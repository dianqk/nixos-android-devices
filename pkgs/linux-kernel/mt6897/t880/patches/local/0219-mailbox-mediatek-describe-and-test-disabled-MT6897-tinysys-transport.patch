+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mailbox/mediatek,mt6897-tinysys-mailbox.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6897 tinysys mailbox
+
+maintainers:
+  - dianqk <dianqk@dianqk.net>
+
+description:
+  Two bidirectional doorbells connect the application processor to the SSPM.
+  Each channel has an interrupt SET register at offset 0 and a pending/clear
+  register at offset 4. SCMI payloads live in separate shared-memory regions.
+
+properties:
+  compatible:
+    const: mediatek,mt6897-tinysys-mailbox
+
+  reg:
+    items:
+      - description: Channel 0 doorbell registers
+      - description: Channel 1 doorbell registers
+
+  reg-names:
+    items:
+      - const: channel0
+      - const: channel1
+
+  interrupts:
+    items:
+      - description: Channel 0 receive interrupt
+      - description: Channel 1 receive interrupt
+
+  "#mbox-cells":
+    const: 1
+    description: Channel index, 0 or 1.
+
+  mediatek,secure-clear:
+    type: boolean
+    description:
+      Receive interrupts must be acknowledged through the SSPM SiP mailbox
+      clear operation instead of writing the clear register. This is a
+      platform firmware contract, not an optional runtime fallback.
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - "#mbox-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    mailbox@1c351000 {
+        compatible = "mediatek,mt6897-tinysys-mailbox";
+        reg = <0x1c351000 0x1000>, <0x1c361000 0x1000>;
+        reg-names = "channel0", "channel1";
+        interrupts = <GIC_SPI 341 IRQ_TYPE_LEVEL_HIGH>,
+                     <GIC_SPI 342 IRQ_TYPE_LEVEL_HIGH>;
+        #mbox-cells = <1>;
+        mediatek,secure-clear;
+    };
