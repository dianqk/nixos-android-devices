From 78297909839d0547e55156206091d53de314dc5d Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Fri, 6 Nov 2026 20:36:30 +0800
Subject: [PATCH 184/187] dt-bindings: clock: describe MT6897 topckgen AP voter

---
 .../bindings/clock/mediatek,topckgen.yaml        | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/Documentation/devicetree/bindings/clock/mediatek,topckgen.yaml b/Documentation/devicetree/bindings/clock/mediatek,topckgen.yaml
index c080fb0a16..da4fdedaa5 100644
--- a/Documentation/devicetree/bindings/clock/mediatek,topckgen.yaml
+++ b/Documentation/devicetree/bindings/clock/mediatek,topckgen.yaml
@@ -36,6 +36,7 @@ properties:
               - mediatek,mt6765-topckgen
               - mediatek,mt6779-topckgen
               - mediatek,mt6795-topckgen
+              - mediatek,mt6897-topckgen
               - mediatek,mt7629-topckgen
               - mediatek,mt7981-topckgen
               - mediatek,mt7986-topckgen
@@ -48,6 +49,10 @@ properties:
   reg:
     maxItems: 1
 
+  mediatek,hardware-voter:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: MT6897 hardware voter used to acquire the AP mux clock votes.
+
   '#clock-cells':
     const: 1
 
@@ -56,6 +61,17 @@ required:
   - reg
   - '#clock-cells'
 
+allOf:
+  - if:
+      not:
+        properties:
+          compatible:
+            contains:
+              const: mediatek,mt6897-topckgen
+    then:
+      properties:
+        mediatek,hardware-voter: false
+
 additionalProperties: false
 
 examples:
-- 
2.56.0

