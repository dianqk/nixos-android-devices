+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Check production MT6897 DP_INTF power, owner and debug serialization."""
+from pathlib import Path
+import os
+import re
+import subprocess
+import tempfile
+
+assets = Path(__file__).resolve().parent
+repo = Path(os.environ.get('KERNEL_SRC', str(assets.parents[3])))
+common = (repo / 'drivers/gpu/drm/mediatek/mtk_dpi_common.c').read_text()
+dpi = (repo / 'drivers/gpu/drm/mediatek/mtk_dpi.c').read_text()
+
+
+def function(source, name):
+    match = re.search(r'^(?:static )?(?:int|void) ' + name + r'\(', source, re.M)
+    start = match.start()
+    end = source.index('{', start) + 1
+    depth = 1
+    while depth:
+        depth += (source[end] == '{') - (source[end] == '}')
+        end += 1
+    return source[start:end]
+
+
+assert dpi.count('.runtime_pm = true') == 1
+assert '.runtime_pm = true' in dpi.split('mt6897_dpintf_conf = {', 1)[1].split('};', 1)[0]
+probe = common[common.index('struct mtk_dpi *mtk_dpi_common_probe'):]
+assert probe.index('mutex_init') < probe.index('devm_pm_runtime_enable') < probe.index('devm_drm_bridge_add')
+unbind = function(common, 'mtk_dpi_common_unbind')
+assert unbind.index('power_dead = true') < unbind.index('mutex_unlock') < unbind.index('debugfs_remove')
+assert 'runtime_put' not in unbind
+assert 'drm_bridge_get' in function(dpi, 'mtk_dpi_debug_tp_open')
+assert 'drm_bridge_put' in function(dpi, 'mtk_dpi_debug_tp_release')
+for name, mmio in [('mtk_dpi_debug_tp_show', 'readl('),
+                   ('mtk_dpi_debug_tp_write', 'mtk_dpi_test_pattern_en(')]:
+    start = dpi.index('static ' + ('int ' if name.endswith('show') else 'ssize_t ') + name)
+    body = dpi[start:dpi.index('\n}\n', start)]
+    assert body.index('mtk_dpi_debug_begin') < body.index(mmio) < body.index('mtk_dpi_debug_end')
+production = '\n'.join(function(common, name) for name in [
+    'mtk_dpi_runtime_get_locked', 'mtk_dpi_runtime_put_locked',
+    'mtk_dpi_power_on', 'mtk_dpi_power_off', 'mtk_dpi_runtime_bind_check',
+    'mtk_dpi_runtime_bound', 'mtk_dpi_common_unbind'])
+production += '\n' + '\n'.join(function(dpi, name) for name in [
+    'mtk_dpi_bridge_enable', 'mtk_dpi_bridge_disable', 'mtk_dpi_start',
+    'mtk_dpi_stop', 'mtk_dpi_debug_begin', 'mtk_dpi_debug_end',
+    'mtk_dpi_debug_tp_open', 'mtk_dpi_debug_tp_release'])
+with tempfile.TemporaryDirectory(prefix='mtk-dpintf-pm-') as tmp:
+    tmp = Path(tmp)
+    c = tmp / 'test.c'
+    c.write_text((assets / 'dpintf_pm_cases.c').read_text().replace('/* PRODUCTION */', production))
+    binary = tmp / 'test'
+    subprocess.run([os.environ.get('CC', 'cc'), '-std=gnu11', '-Wall', '-Wextra',
+                    '-Wno-unused-parameter', '-Werror', '-g', '-pthread',
+                    '-fsanitize=address,undefined', str(c), '-o', str(binary)], check=True)
+    subprocess.run([str(binary)], check=True)
