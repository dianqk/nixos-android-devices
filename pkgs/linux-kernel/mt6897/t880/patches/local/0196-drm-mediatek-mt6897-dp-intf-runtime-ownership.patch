From c8a8833315b51bc52a26b1aecc6d0706c515391c Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Sat, 7 Nov 2026 02:43:18 +0800
Subject: [PATCH] drm/mediatek: serialize MT6897 DP_INTF runtime ownership

Opt MT6897 DP_INTF into managed runtime PM before bridge publication. Serialize full PM and engine/TVD/pixel clock references, with separate successful component and bridge owners. Failed enable cannot disable or release another owner, and dirty unbind state cannot be revived by rebind.

Debug register transactions may borrow a full reference only while an output is already active. Serialize their hardware access with last-off and unbind, mark the device dead before removing its debug file, and pin the bridge allocation across open files. Copy and parse user input before taking the power transition lock. Unbind does not force-drain retained power references.

Keep non-MT6897 DPI and DVO clock behavior unchanged. Add extracted-function tests for PM/clock failures, dual owners, reference balance, debug concurrency and bridge lifetime. These tests do not establish hardware-fault DMA or framebuffer lifetime safety.
---
 drivers/gpu/drm/mediatek/mtk_dpi.c            | 160 ++++++++++-
 drivers/gpu/drm/mediatek/mtk_dpi_common.c     | 114 ++++++++
 drivers/gpu/drm/mediatek/mtk_dpi_common.h     |  12 +
 tools/testing/selftests/mtk_clk/Makefile      |   4 +-
 .../selftests/mtk_clk/dpintf_pm_cases.c       | 262 ++++++++++++++++++
 .../selftests/mtk_clk/test_dpintf_pm.py       |  57 ++++
 6 files changed, 597 insertions(+), 12 deletions(-)
 create mode 100644 tools/testing/selftests/mtk_clk/dpintf_pm_cases.c
 create mode 100755 tools/testing/selftests/mtk_clk/test_dpintf_pm.py

diff --git a/drivers/gpu/drm/mediatek/mtk_dpi.c b/drivers/gpu/drm/mediatek/mtk_dpi.c
index d38cf5d7e9..3c587da04a 100644
--- a/drivers/gpu/drm/mediatek/mtk_dpi.c
+++ b/drivers/gpu/drm/mediatek/mtk_dpi.c
@@ -387,11 +387,25 @@ static void mtk_dpi_bridge_disable(struct drm_bridge *bridge,
 {
 	struct mtk_dpi *dpi = bridge_to_dpi(bridge);
 
+	if (dpi->conf->runtime_pm) {
+		mutex_lock(&dpi->power_lock);
+		if (dpi->power_dead || !dpi->bridge_powered)
+			goto out;
+	}
+
 	mtk_dpi_disable(dpi);
-	mtk_dpi_power_off(dpi);
+	if (dpi->conf->runtime_pm) {
+		dpi->bridge_powered = false;
+		mtk_dpi_runtime_put_locked(dpi);
+	} else {
+		mtk_dpi_power_off(dpi);
+	}
 
 	if (dpi->pinctrl && dpi->pins_gpio)
 		pinctrl_select_state(dpi->pinctrl, dpi->pins_gpio);
+out:
+	if (dpi->conf->runtime_pm)
+		mutex_unlock(&dpi->power_lock);
 }
 
 static void mtk_dpi_bridge_enable(struct drm_bridge *bridge,
@@ -402,11 +416,25 @@ static void mtk_dpi_bridge_enable(struct drm_bridge *bridge,
 	struct mtk_dpi_sync sync = { 0 };
 	struct mtk_dpi_yc_limit limit;
 	struct videomode vm;
+	int ret;
+
+	if (dpi->conf->runtime_pm) {
+		mutex_lock(&dpi->power_lock);
+		if (dpi->power_dead || dpi->bridge_powered)
+			goto out;
+		ret = mtk_dpi_runtime_get_locked(dpi);
+		if (ret) {
+			dev_err(dpi->dev, "Failed to power DP_INTF bridge: %d\n", ret);
+			goto out;
+		}
+		dpi->bridge_powered = true;
+	}
 
 	if (dpi->pinctrl && dpi->pins_dpi)
 		pinctrl_select_state(dpi->pinctrl, dpi->pins_dpi);
 
-	mtk_dpi_power_on(dpi);
+	if (!dpi->conf->runtime_pm)
+		mtk_dpi_power_on(dpi);
 
 	/* Set pixel clock and initialize parameters to send to the HW */
 	mtk_dpi_set_display_mode(dpi, &vm, &sync, &dpi_pol, &limit);
@@ -415,6 +443,9 @@ static void mtk_dpi_bridge_enable(struct drm_bridge *bridge,
 	mtk_dpi_config_hw(dpi, &vm, &sync, &dpi_pol, &limit);
 
 	mtk_dpi_enable(dpi);
+out:
+	if (dpi->conf->runtime_pm)
+		mutex_unlock(&dpi->power_lock);
 }
 
 static enum drm_mode_status
@@ -430,41 +461,113 @@ mtk_dpi_bridge_mode_valid(struct drm_bridge *bridge,
 	return MODE_OK;
 }
 
+static int mtk_dpi_debug_begin(struct mtk_dpi *dpi)
+{
+	int ret;
+
+	if (!dpi->conf->runtime_pm)
+		return 0;
+	mutex_lock(&dpi->power_lock);
+	if (dpi->power_dead) {
+		ret = -ENODEV;
+		goto err_unlock;
+	}
+	/* Diagnostics must not wake an otherwise inactive external output. */
+	if (!dpi->refcount) {
+		ret = -EAGAIN;
+		goto err_unlock;
+	}
+	ret = mtk_dpi_runtime_get_locked(dpi);
+	if (ret)
+		goto err_unlock;
+	return 0;
+err_unlock:
+	mutex_unlock(&dpi->power_lock);
+	return ret;
+}
+
+static void mtk_dpi_debug_end(struct mtk_dpi *dpi)
+{
+	if (!dpi->conf->runtime_pm)
+		return;
+	mtk_dpi_runtime_put_locked(dpi);
+	mutex_unlock(&dpi->power_lock);
+}
+
 static int mtk_dpi_debug_tp_show(struct seq_file *m, void *arg)
 {
 	struct mtk_dpi *dpi = m->private;
 	bool en;
 	u32 val;
+	int ret;
 
 	if (!dpi)
 		return -EINVAL;
-
+	ret = mtk_dpi_debug_begin(dpi);
+	if (ret)
+		return ret;
 	val = readl(dpi->regs + DPI_PATTERN0);
 	en = val & DPI_PAT_EN;
 	val = FIELD_GET(DPI_PAT_SEL, val);
-
-	return mtk_dpi_common_debug_tp_show(m, en, val);
+	ret = mtk_dpi_common_debug_tp_show(m, en, val);
+	mtk_dpi_debug_end(dpi);
+	return ret;
 }
 
 static ssize_t mtk_dpi_debug_tp_write(struct file *file, const char __user *ubuf,
 				      size_t len, loff_t *offp)
 {
 	struct seq_file *m = file->private_data;
+	struct mtk_dpi *dpi;
 	u32 en, type;
 	ssize_t ret;
+	int power_ret;
 
-	/* seq_file and dpi pointers are checked by mtk_dpi_common_debug_tp_write() */
+	if (!m || !m->private)
+		return -EINVAL;
 	ret = mtk_dpi_common_debug_tp_write(file, ubuf, len, offp, &en, &type);
 	if (ret < 0)
 		return ret;
-
-	mtk_dpi_test_pattern_en((struct mtk_dpi *)m->private, type, en);
+	dpi = m->private;
+	power_ret = mtk_dpi_debug_begin(dpi);
+	if (power_ret)
+		return power_ret;
+	mtk_dpi_test_pattern_en(dpi, type, en);
+	mtk_dpi_debug_end(dpi);
 	return ret;
 }
 
 static int mtk_dpi_debug_tp_open(struct inode *inode, struct file *file)
 {
-	return single_open(file, mtk_dpi_debug_tp_show, inode->i_private);
+	struct mtk_dpi *dpi = inode->i_private;
+	int ret;
+
+	if (!dpi->conf->runtime_pm)
+		return single_open(file, mtk_dpi_debug_tp_show, dpi);
+	mutex_lock(&dpi->power_lock);
+	if (dpi->power_dead) {
+		mutex_unlock(&dpi->power_lock);
+		return -ENODEV;
+	}
+	drm_bridge_get(&dpi->bridge);
+	mutex_unlock(&dpi->power_lock);
+	ret = single_open(file, mtk_dpi_debug_tp_show, dpi);
+	if (ret)
+		drm_bridge_put(&dpi->bridge);
+	return ret;
+}
+
+static int mtk_dpi_debug_tp_release(struct inode *inode, struct file *file)
+{
+	struct seq_file *m = file->private_data;
+	struct mtk_dpi *dpi = m->private;
+	bool runtime_pm = dpi->conf->runtime_pm;
+	int ret;
+
+	ret = single_release(inode, file);
+	if (runtime_pm)
+		drm_bridge_put(&dpi->bridge);
+	return ret;
 }
 
 static const struct file_operations mtk_dpi_debug_tp_fops = {
@@ -476,11 +579,24 @@ static const struct file_operations mtk_dpi_debug_tp_fops = {
 	.release = single_release,
 };
 
+static const struct file_operations mtk_dpi_runtime_debug_tp_fops = {
+	.owner = THIS_MODULE,
+	.open = mtk_dpi_debug_tp_open,
+	.read = seq_read,
+	.write = mtk_dpi_debug_tp_write,
+	.llseek = seq_lseek,
+	.release = mtk_dpi_debug_tp_release,
+};
+
 static void mtk_dpi_debugfs_init(struct drm_bridge *bridge, struct dentry *root)
 {
 	struct mtk_dpi *dpi = bridge_to_dpi(bridge);
 
-	debugfs_create_file("dpi_test_pattern", 0640, root, dpi, &mtk_dpi_debug_tp_fops);
+	if (dpi->conf->runtime_pm)
+		dpi->debugfs_tp = debugfs_create_file("dpi_test_pattern", 0640, root, dpi,
+						 &mtk_dpi_runtime_debug_tp_fops);
+	else
+		debugfs_create_file("dpi_test_pattern", 0640, root, dpi, &mtk_dpi_debug_tp_fops);
 }
 
 static const struct drm_bridge_funcs mtk_dpi_bridge_funcs = {
@@ -501,9 +617,22 @@ static const struct drm_bridge_funcs mtk_dpi_bridge_funcs = {
 void mtk_dpi_start(struct device *dev)
 {
 	struct mtk_dpi *dpi = dev_get_drvdata(dev);
+	int ret;
 
 	if (dpi->conf->clocked_by_hdmi)
 		return;
+	if (dpi->conf->runtime_pm) {
+		mutex_lock(&dpi->power_lock);
+		if (!dpi->power_dead && !dpi->component_powered) {
+			ret = mtk_dpi_runtime_get_locked(dpi);
+			if (!ret)
+				dpi->component_powered = true;
+			else
+				dev_err(dev, "Failed to power DP_INTF component: %d\n", ret);
+		}
+		mutex_unlock(&dpi->power_lock);
+		return;
+	}
 
 	mtk_dpi_power_on(dpi);
 }
@@ -514,6 +643,16 @@ void mtk_dpi_stop(struct device *dev)
 
 	if (dpi->conf->clocked_by_hdmi)
 		return;
+	if (dpi->conf->runtime_pm) {
+		mutex_lock(&dpi->power_lock);
+		if (!dpi->power_dead && dpi->component_powered) {
+			mtk_dpi_disable(dpi);
+			dpi->component_powered = false;
+			mtk_dpi_runtime_put_locked(dpi);
+		}
+		mutex_unlock(&dpi->power_lock);
+		return;
+	}
 
 	mtk_dpi_disable(dpi);
 	mtk_dpi_power_off(dpi);
@@ -714,6 +853,7 @@ static const struct mtk_dpi_conf mt8195_dpintf_conf = {
  * mt6897_dp_intf_driver_data: np_sel 0).
  */
 static const struct mtk_dpi_conf mt6897_dpintf_conf = {
+	.runtime_pm = true,
 	.dpi_factor = dpi_factor_mt8195_dp_intf,
 	.num_dpi_factor = ARRAY_SIZE(dpi_factor_mt8195_dp_intf),
 	.max_clock_khz = 600000,
diff --git a/drivers/gpu/drm/mediatek/mtk_dpi_common.c b/drivers/gpu/drm/mediatek/mtk_dpi_common.c
index cd56cc61ad..eedb46db9b 100644
--- a/drivers/gpu/drm/mediatek/mtk_dpi_common.c
+++ b/drivers/gpu/drm/mediatek/mtk_dpi_common.c
@@ -13,6 +13,7 @@
 #include <linux/of_graph.h>
 #include <linux/pinctrl/consumer.h>
 #include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
 
 #include <drm/drm_bridge.h>
 #include <drm/drm_bridge_connector.h>
@@ -27,6 +28,13 @@
 
 void mtk_dpi_power_off(struct mtk_dpi *dpi)
 {
+	if (dpi->conf->runtime_pm) {
+		mutex_lock(&dpi->power_lock);
+		mtk_dpi_runtime_put_locked(dpi);
+		mutex_unlock(&dpi->power_lock);
+		return;
+	}
+
 	if (WARN_ON(dpi->refcount == 0))
 		return;
 
@@ -43,6 +51,13 @@ int mtk_dpi_power_on(struct mtk_dpi *dpi)
 {
 	int ret;
 
+	if (dpi->conf->runtime_pm) {
+		mutex_lock(&dpi->power_lock);
+		ret = mtk_dpi_runtime_get_locked(dpi);
+		mutex_unlock(&dpi->power_lock);
+		return ret;
+	}
+
 	if (++dpi->refcount != 1)
 		return 0;
 
@@ -76,6 +91,58 @@ int mtk_dpi_power_on(struct mtk_dpi *dpi)
 }
 EXPORT_SYMBOL_NS_GPL(mtk_dpi_power_on, "DRM_MTK_DPI");
 
+int mtk_dpi_runtime_get_locked(struct mtk_dpi *dpi)
+{
+	int ret;
+
+	lockdep_assert_held(&dpi->power_lock);
+	if (dpi->power_dead)
+		return -ENODEV;
+	if (dpi->refcount) {
+		dpi->refcount++;
+		return 0;
+	}
+
+	ret = pm_runtime_resume_and_get(dpi->dev);
+	if (ret < 0)
+		return ret;
+	ret = clk_prepare_enable(dpi->engine_clk);
+	if (ret)
+		goto err_pm;
+	ret = clk_prepare_enable(dpi->tvd_clk);
+	if (ret)
+		goto err_engine;
+	ret = clk_prepare_enable(dpi->pixel_clk);
+	if (ret)
+		goto err_tvd;
+
+	dpi->refcount = 1;
+	return 0;
+err_tvd:
+	clk_disable_unprepare(dpi->tvd_clk);
+err_engine:
+	clk_disable_unprepare(dpi->engine_clk);
+err_pm:
+	pm_runtime_put(dpi->dev);
+	return ret;
+}
+EXPORT_SYMBOL_NS_GPL(mtk_dpi_runtime_get_locked, "DRM_MTK_DPI");
+
+void mtk_dpi_runtime_put_locked(struct mtk_dpi *dpi)
+{
+	lockdep_assert_held(&dpi->power_lock);
+	if (WARN_ON(!dpi->refcount))
+		return;
+	if (--dpi->refcount)
+		return;
+
+	clk_disable_unprepare(dpi->pixel_clk);
+	clk_disable_unprepare(dpi->tvd_clk);
+	clk_disable_unprepare(dpi->engine_clk);
+	pm_runtime_put(dpi->dev);
+}
+EXPORT_SYMBOL_NS_GPL(mtk_dpi_runtime_put_locked, "DRM_MTK_DPI");
+
 static unsigned int mtk_dpi_calculate_factor(struct mtk_dpi *dpi, int mode_clk)
 {
 	const struct mtk_dpi_factor *dpi_factor = dpi->conf->dpi_factor;
@@ -281,6 +348,28 @@ static const struct drm_encoder_funcs mtk_dpi_encoder_funcs = {
 	.destroy = drm_encoder_cleanup,
 };
 
+static int mtk_dpi_runtime_bind_check(struct mtk_dpi *dpi)
+{
+	int ret;
+
+	if (!dpi->conf->runtime_pm)
+		return 0;
+	mutex_lock(&dpi->power_lock);
+	ret = (!dpi->power_dead || dpi->refcount || dpi->component_powered ||
+	       dpi->bridge_powered) ? -EBUSY : 0;
+	mutex_unlock(&dpi->power_lock);
+	return ret;
+}
+
+static void mtk_dpi_runtime_bound(struct mtk_dpi *dpi)
+{
+	if (!dpi->conf->runtime_pm)
+		return;
+	mutex_lock(&dpi->power_lock);
+	dpi->power_dead = false;
+	mutex_unlock(&dpi->power_lock);
+}
+
 int mtk_dpi_common_bind(struct device *dev, struct device *master, void *data)
 {
 	struct mtk_dpi *dpi = dev_get_drvdata(dev);
@@ -288,6 +377,10 @@ int mtk_dpi_common_bind(struct device *dev, struct device *master, void *data)
 	struct mtk_drm_private *priv = drm_dev->dev_private;
 	int ret;
 
+	ret = mtk_dpi_runtime_bind_check(dpi);
+	if (ret)
+		return ret;
+
 	dpi->mmsys_dev = priv->mmsys_dev;
 	ret = drm_encoder_init(drm_dev, &dpi->encoder, &mtk_dpi_encoder_funcs,
 			       DRM_MODE_ENCODER_TMDS, NULL);
@@ -313,6 +406,7 @@ int mtk_dpi_common_bind(struct device *dev, struct device *master, void *data)
 		goto err_output;
 	}
 
+	mtk_dpi_runtime_bound(dpi);
 	return 0;
 
 err_output:
@@ -322,6 +416,7 @@ int mtk_dpi_common_bind(struct device *dev, struct device *master, void *data)
 	 */
 	if (dpi->conf->output_optional) {
 		dev_warn(dev, "output unavailable: %d\n", ret);
+		mtk_dpi_runtime_bound(dpi);
 		return 0;
 	}
 err_cleanup:
@@ -334,6 +429,17 @@ void mtk_dpi_common_unbind(struct device *dev, struct device *master, void *data
 {
 	struct mtk_dpi *dpi = dev_get_drvdata(dev);
 
+	if (dpi->conf->runtime_pm) {
+		mutex_lock(&dpi->power_lock);
+		dpi->power_dead = true;
+		if (dpi->refcount)
+			dev_warn(dev, "unbinding with %d retained power references\n", dpi->refcount);
+		mutex_unlock(&dpi->power_lock);
+		/* Never wait for debugfs callbacks while holding power_lock. */
+		debugfs_remove(dpi->debugfs_tp);
+		dpi->debugfs_tp = NULL;
+	}
+
 	drm_encoder_cleanup(&dpi->encoder);
 }
 EXPORT_SYMBOL_NS_GPL(mtk_dpi_common_unbind, "DRM_MTK_DPI");
@@ -414,6 +520,8 @@ struct mtk_dpi *mtk_dpi_common_probe(struct platform_device *pdev,
 	dpi->dev = dev;
 	dpi->conf = (struct mtk_dpi_conf *)of_device_get_match_data(dev);
 	dpi->output_fmt = MEDIA_BUS_FMT_RGB888_1X24;
+	mutex_init(&dpi->power_lock);
+	dpi->power_dead = true;
 
 	dpi->pinctrl = devm_pinctrl_get(dev);
 	if (IS_ERR_OR_NULL(dpi->pinctrl)) {
@@ -470,6 +578,12 @@ struct mtk_dpi *mtk_dpi_common_probe(struct platform_device *pdev,
 
 	platform_set_drvdata(pdev, dpi);
 
+	if (dpi->conf->runtime_pm) {
+		ret = devm_pm_runtime_enable(dev);
+		if (ret)
+			return ERR_PTR(ret);
+	}
+
 	dpi->bridge.of_node = dev->of_node;
 	dpi->bridge.type = DRM_MODE_CONNECTOR_DPI;
 
