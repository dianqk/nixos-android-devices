--- /dev/null
+++ b/tools/testing/selftests/mtk_clk/dpintf_pm_cases.c
@@ -0,0 +1,262 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <errno.h>
+#define mutex pthread_mutex_t
+#define mutex_lock(p) assert(pthread_mutex_lock(p) == 0)
+#define mutex_unlock(p) assert(pthread_mutex_unlock(p) == 0)
+#define lockdep_assert_held(p) assert(pthread_mutex_trylock(p) == EBUSY)
+#define WARN_ON(x) (assert(!(x)), 0)
+#define dev_err(...) ((void)0)
+#define dev_warn(...) ((void)0)
+struct device { void *data; int refs, error; };
+struct clk { int refs, error; };
+struct drm_bridge { int refs; };
+struct drm_atomic_commit { int unused; };
+struct videomode { int unused; };
+struct mtk_dpi_polarities { int unused; };
+struct mtk_dpi_sync { int unused; };
+struct mtk_dpi_yc_limit { int unused; };
+struct mtk_dpi_conf { bool runtime_pm, clocked_by_hdmi; };
+struct mtk_dpi {
+	struct drm_bridge bridge;
+	struct device *dev;
+	struct clk *engine_clk, *tvd_clk, *pixel_clk;
+	const struct mtk_dpi_conf *conf;
+	pthread_mutex_t power_lock;
+	int8_t refcount;
+	bool power_dead, component_powered, bridge_powered;
+	void *pinctrl, *pins_gpio, *pins_dpi, *debugfs_tp;
+	int encoder;
+};
+struct seq_file { void *private; };
+struct inode { void *i_private; };
+struct file { void *private_data; };
+static struct mtk_dpi dpi;
+static struct device device;
+static struct clk clocks[3];
+static struct mtk_dpi_conf selected = { true, false }, other = { false, false };
+static int mmio, events[64], count, single_error, removed, encoder_cleaned;
+static void *dev_get_drvdata(struct device *dev) { return dev->data; }
+static struct mtk_dpi *bridge_to_dpi(struct drm_bridge *bridge)
+{
+	return (struct mtk_dpi *)((char *)bridge - offsetof(struct mtk_dpi, bridge));
+}
+static int pm_runtime_resume_and_get(struct device *dev)
+{
+	events[count++] = 1;
+	if (dev->error)
+		return dev->error;
+	dev->refs++;
+	return 0;
+}
+static void pm_runtime_put(struct device *dev)
+{
+	events[count++] = -1;
+	assert(dev->refs > 0);
+	dev->refs--;
+}
+static int clk_prepare_enable(struct clk *clk)
+{
+	events[count++] = 2 + (int)(clk - clocks);
+	if (clk->error)
+		return clk->error;
+	clk->refs++;
+	return 0;
+}
+static void clk_disable_unprepare(struct clk *clk)
+{
+	events[count++] = -2 - (int)(clk - clocks);
+	assert(clk->refs > 0);
+	clk->refs--;
+}
+static void check_power(void)
+{
+	assert(!dpi.conf->runtime_pm || device.refs == 1);
+	for (int i = 0; i < 3; i++)
+		assert(clocks[i].refs == 1);
+	mmio++;
+}
+static void mtk_dpi_disable(struct mtk_dpi *p) { assert(p == &dpi); check_power(); }
+static void mtk_dpi_enable(struct mtk_dpi *p) { assert(p == &dpi); check_power(); }
+static int mtk_dpi_set_display_mode(struct mtk_dpi *p, struct videomode *v,
+	struct mtk_dpi_sync *s, struct mtk_dpi_polarities *pol, struct mtk_dpi_yc_limit *l)
+{
+	check_power();
+	return 0;
+}
+static void mtk_dpi_config_hw(struct mtk_dpi *p, struct videomode *v,
+	struct mtk_dpi_sync *s, struct mtk_dpi_polarities *pol, struct mtk_dpi_yc_limit *l)
+{
+	check_power();
+}
+static void pinctrl_select_state(void *p, void *s) { }
+static void drm_encoder_cleanup(int *encoder) { encoder_cleaned++; }
+static void debugfs_remove(void *entry) { removed++; }
+static void drm_bridge_get(struct drm_bridge *bridge) { bridge->refs++; }
+static void drm_bridge_put(struct drm_bridge *bridge) { assert(bridge->refs > 0); bridge->refs--; }
+static int mtk_dpi_debug_tp_show(struct seq_file *m, void *arg) { return 0; }
+static int single_open(struct file *file, int (*show)(struct seq_file *, void *), void *p)
+{
+	static struct seq_file seq;
+	if (single_error)
+		return single_error;
+	seq.private = p;
+	file->private_data = &seq;
+	return 0;
+}
+static int single_release(struct inode *inode, struct file *file) { return 0; }
+int mtk_dpi_runtime_get_locked(struct mtk_dpi *p);
+void mtk_dpi_runtime_put_locked(struct mtk_dpi *p);
+/* PRODUCTION */
+
+static void idle(void)
+{
+	assert(dpi.refcount == 0 && device.refs == 0);
+	for (int i = 0; i < 3; i++)
+		assert(clocks[i].refs == 0);
+}
+static void reset(void)
+{
+	idle();
+	count = mmio = removed = encoder_cleaned = 0;
+	dpi.power_dead = false;
+	dpi.component_powered = dpi.bridge_powered = false;
+	device.error = single_error = 0;
+	for (int i = 0; i < 3; i++)
+		clocks[i].error = 0;
+}
+static atomic_bool worker_started, worker_done;
+static void *stop_worker(void *arg)
+{
+	atomic_store(&worker_started, true);
+	mtk_dpi_stop(&device);
+	atomic_store(&worker_done, true);
+	return NULL;
+}
+static void *unbind_worker(void *arg)
+{
+	atomic_store(&worker_started, true);
+	mtk_dpi_common_unbind(&device, NULL, NULL);
+	atomic_store(&worker_done, true);
+	return NULL;
+}
+static void race(void *(*worker)(void *))
+{
+	pthread_t thread;
+	assert(mtk_dpi_debug_begin(&dpi) == 0);
+	assert(dpi.refcount == 2);
+	atomic_store(&worker_started, false);
+	atomic_store(&worker_done, false);
+	assert(pthread_create(&thread, NULL, worker, NULL) == 0);
+	while (!atomic_load(&worker_started)) { }
+	assert(!atomic_load(&worker_done));
+	check_power();
+	mtk_dpi_debug_end(&dpi);
+	assert(pthread_join(thread, NULL) == 0);
+	assert(atomic_load(&worker_done));
+}
+int main(void)
+{
+	device.data = &dpi;
+	dpi.dev = &device;
+	dpi.conf = &selected;
+	dpi.engine_clk = &clocks[0]; dpi.tvd_clk = &clocks[1]; dpi.pixel_clk = &clocks[2];
+	assert(pthread_mutex_init(&dpi.power_lock, NULL) == 0);
+	for (int bridge_owner = 0; bridge_owner < 2; bridge_owner++) {
+		for (int fail = 0; fail < 4; fail++) {
+			reset();
+			if (fail == 0)
+				device.error = -EIO;
+			else
+				clocks[fail - 1].error = -EIO;
+			if (bridge_owner)
+				mtk_dpi_bridge_enable(&dpi.bridge, NULL);
+			else
+				mtk_dpi_start(&device);
+			assert(!dpi.component_powered && !dpi.bridge_powered);
+			idle();
+			int before = mmio;
+			if (bridge_owner)
+				mtk_dpi_bridge_disable(&dpi.bridge, NULL);
+			else
+				mtk_dpi_stop(&device);
+			assert(mmio == before);
+			assert(events[0] == 1);
+			if (fail)
+				assert(events[count - 1] == -1);
+		}
+	}
+	reset();
+	device.error = -EIO;
+	mtk_dpi_bridge_enable(&dpi.bridge, NULL);
+	idle();
+	assert(!dpi.bridge_powered && mmio == 0);
+	device.error = 0;
+	mtk_dpi_start(&device);
+	mtk_dpi_bridge_disable(&dpi.bridge, NULL);
+	assert(dpi.component_powered && dpi.refcount == 1 && mmio == 0);
+	mtk_dpi_stop(&device);
+	reset();
+	device.error = -EIO;
+	mtk_dpi_start(&device);
+	device.error = 0;
+	mtk_dpi_bridge_enable(&dpi.bridge, NULL);
+	int before = mmio;
+	mtk_dpi_stop(&device);
+	assert(dpi.bridge_powered && dpi.refcount == 1 && mmio == before);
+	mtk_dpi_bridge_disable(&dpi.bridge, NULL);
+	reset();
+	mtk_dpi_start(&device);
+	mtk_dpi_bridge_enable(&dpi.bridge, NULL);
+	assert(dpi.refcount == 2 && device.refs == 1 && count == 4);
+	mtk_dpi_start(&device);
+	mtk_dpi_bridge_enable(&dpi.bridge, NULL);
+	assert(dpi.refcount == 2);
+	mtk_dpi_stop(&device);
+	assert(dpi.refcount == 1 && dpi.bridge_powered);
+	mtk_dpi_bridge_disable(&dpi.bridge, NULL);
+	idle();
+	assert(events[count - 4] == -4 && events[count - 3] == -3 && events[count - 2] == -2 && events[count - 1] == -1);
+	reset();
+	assert(mtk_dpi_debug_begin(&dpi) == -EAGAIN && count == 0);
+	mtk_dpi_start(&device);
+	race(stop_worker);
+	idle();
+	reset();
+	mtk_dpi_start(&device);
+	race(unbind_worker);
+	assert(dpi.power_dead && dpi.refcount == 1 && removed == 1 && encoder_cleaned == 1);
+	assert(mtk_dpi_debug_begin(&dpi) == -ENODEV);
+	assert(mtk_dpi_runtime_bind_check(&dpi) == -EBUSY);
+	mtk_dpi_bridge_enable(&dpi.bridge, NULL);
+	assert(!dpi.bridge_powered && dpi.refcount == 1);
+	/* Test-only disposal of the retained mock lease, never production unbind. */
+	mtk_dpi_power_off(&dpi);
+	dpi.component_powered = false;
+	assert(mtk_dpi_runtime_bind_check(&dpi) == 0);
+	mtk_dpi_runtime_bound(&dpi);
+	assert(!dpi.power_dead);
+	struct inode inode = { .i_private = &dpi };
+	struct file file = { 0 };
+	single_error = -ENOMEM;
+	assert(mtk_dpi_debug_tp_open(&inode, &file) == -ENOMEM && dpi.bridge.refs == 0);
+	single_error = 0;
+	assert(mtk_dpi_debug_tp_open(&inode, &file) == 0 && dpi.bridge.refs == 1);
+	mtk_dpi_common_unbind(&device, NULL, NULL);
+	assert(mtk_dpi_debug_tp_release(&inode, &file) == 0 && dpi.bridge.refs == 0);
+	reset();
+	dpi.conf = &other;
+	assert(mtk_dpi_power_on(&dpi) == 0);
+	assert(device.refs == 0 && count == 3);
+	mtk_dpi_power_off(&dpi);
+	idle();
+	assert(pthread_mutex_destroy(&dpi.power_lock) == 0);
+	puts("MT6897 DP_INTF power failures, dual owners, debug/stop/unbind ordering and bridge lifetime passed");
+	return 0;
+}
