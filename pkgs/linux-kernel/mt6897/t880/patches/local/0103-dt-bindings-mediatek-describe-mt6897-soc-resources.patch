Subject: [PATCH] dt-bindings: mediatek: describe MT6897 soc resources

Describe the MT6897 soc compatibles, resource limits and constants
used by the corresponding controllers and device trees.

Original-Commit: local development history
Original-Author: dianqk <dianqk@dianqk.net>
Original-Date: 2026-10-16T22:46:24+08:00
Original-Commit: local development history
Original-Author: dianqk <dianqk@dianqk.net>
Original-Date: 2026-10-17T14:13:44+08:00
Signed-off-by: dianqk <dianqk@dianqk.net>
---
 .../soc/mediatek/mediatek,mt6897-mcupm.yaml   | 42 +++++++++++++++++++
 .../bindings/soc/mediatek/mediatek,mutex.yaml |  6 +++
 2 files changed, 48 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6897-mcupm.yaml

diff --git a/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6897-mcupm.yaml b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6897-mcupm.yaml
new file mode 100644
index 0000000000..5d529d61f1
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6897-mcupm.yaml
@@ -0,0 +1,42 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/mediatek/mediatek,mt6897-mcupm.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MCUPM boot contact
+
+maintainers:
+  - dianqk <dianqk@dianqk.net>
+
+description:
+  The MCUPM is the CPU power-management coprocessor of the MT6897. Its
+  firmware accepts CPU idle requests only after the AP has sent it the
+  alive command and its time base through the MCUPM mailboxes.
+
+properties:
+  compatible:
+    const: mediatek,mt6897-mcupm
+
+  reg:
+    items:
+      - description: shared SRAM of mailboxes 0 to 4
+      - description: mailbox 0 interrupt registers
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        mcupm@c0bf600 {
+            compatible = "mediatek,mt6897-mcupm";
+            reg = <0 0x0c0bf600 0 0x320>, <0 0x0c072000 0 0x20>;
+        };
+    };
diff --git a/Documentation/devicetree/bindings/soc/mediatek/mediatek,mutex.yaml b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mutex.yaml
index 429ea14906..c491d5738e 100644
--- a/Documentation/devicetree/bindings/soc/mediatek/mediatek,mutex.yaml
+++ b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mutex.yaml
@@ -30,6 +30,9 @@ properties:
       - mediatek,mt2701-disp-mutex
       - mediatek,mt2712-disp-mutex
       - mediatek,mt6795-disp-mutex
+      - mediatek,mt6897-dispsys0-mutex
+      - mediatek,mt6897-dispsys1-mutex
+      - mediatek,mt6897-ovlsys-mutex
       - mediatek,mt8167-disp-mutex
       - mediatek,mt8173-disp-mutex
       - mediatek,mt8183-disp-mutex
@@ -88,6 +91,9 @@ allOf:
               - mediatek,mt2701-disp-mutex
               - mediatek,mt2712-disp-mutex
               - mediatek,mt6795-disp-mutex
+              - mediatek,mt6897-dispsys0-mutex
+              - mediatek,mt6897-dispsys1-mutex
+              - mediatek,mt6897-ovlsys-mutex
               - mediatek,mt8173-disp-mutex
               - mediatek,mt8186-disp-mutex
               - mediatek,mt8186-mdp3-mutex
