From fcd8dd4bb979fd4f2f5477b99bd8e2c578ad33d5 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Fri, 6 Nov 2026 10:00:00 +0800
Subject: [PATCH] phy: mediatek: support MT6897 USB PHY initialization

phy: mediatek: support MT6897 USB PHY initialization.

Original-Commit: local development history
Original-Author: dianqk <dianqk@dianqk.net>
Original-Date: 2026-10-15T10:34:01+08:00
Original-Commit: local development history
Original-Author: dianqk <dianqk@dianqk.net>
Original-Date: 2026-10-17T19:11:56+08:00
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: dianqk <dianqk@dianqk.net>
---
 drivers/phy/mediatek/phy-mtk-xsphy.c | 78 ++++++++++++++++++++++++++++
 1 file changed, 78 insertions(+)

diff --git a/drivers/phy/mediatek/phy-mtk-xsphy.c b/drivers/phy/mediatek/phy-mtk-xsphy.c
index cc1d669542..f50571e8ba 100644
--- a/drivers/phy/mediatek/phy-mtk-xsphy.c
+++ b/drivers/phy/mediatek/phy-mtk-xsphy.c
@@ -62,7 +62,27 @@
 #define P2A6_RG_BC11_SW_EN	BIT(23)
 #define P2A6_RG_OTG_VBUSCMP_EN	BIT(20)
 
+#define XSP_U2PHYDTM0		((SSUSB_SIFSLV_U2PHY_COM) + 0x068)
+#define P2D_FORCE_UART_EN	BIT(26)
+#define P2D_FORCE_USB_CLKEN	BIT(25)
+#define P2D_FORCE_DATAIN	BIT(23)
+#define P2D_FORCE_DM_PULLDOWN	BIT(21)
+#define P2D_FORCE_DP_PULLDOWN	BIT(20)
+#define P2D_FORCE_XCVRSEL	BIT(19)
+#define P2D_FORCE_SUSPENDM	BIT(18)
+#define P2D_FORCE_TERMSEL	BIT(17)
+#define P2D_RG_DATAIN		GENMASK(13, 10)
+#define P2D_RG_DMPULLDOWN	BIT(7)
+#define P2D_RG_DPPULLDOWN	BIT(6)
+#define P2D_RG_XCVRSEL		GENMASK(5, 4)
+#define P2D_RG_TERMSEL		BIT(2)
+#define P2D_DTM0_FORCE_MASK	(P2D_FORCE_UART_EN | P2D_FORCE_USB_CLKEN | \
+				 P2D_FORCE_DATAIN | P2D_FORCE_DM_PULLDOWN | \
+				 P2D_FORCE_DP_PULLDOWN | P2D_FORCE_XCVRSEL | \
+				 P2D_FORCE_SUSPENDM | P2D_FORCE_TERMSEL)
+
 #define XSP_U2PHYDTM1		((SSUSB_SIFSLV_U2PHY_COM) + 0x06C)
+#define P2D_RG_UART_EN		BIT(16)
 #define P2D_FORCE_IDDIG		BIT(9)
 #define P2D_RG_VBUSVALID	BIT(5)
 #define P2D_RG_SESSEND		BIT(4)
@@ -112,6 +132,7 @@ struct xsphy_instance {
 struct mtk_xsphy {
 	struct device *dev;
 	void __iomem *glb_base;	/* only shared u3 sif */
+	bool u3_vendor_power;	/* MT6897: U3 analog power-on settings */
 	int src_ref_clk; /* MHZ, reference clock for slew rate calibrate */
 	int src_coef;    /* coefficient for slew rate calibrate */
 	int nphys;
@@ -181,6 +202,17 @@ static void u2_phy_instance_init(struct mtk_xsphy *xsphy,
 {
 	void __iomem *pbase = inst->port_base;
 
+	/*
+	 * A previous bootloader may leave the port in its low-power state:
+	 * UTMI signals forced (suspend, pull-downs, termination, data) or the
+	 * UART function selected. Return them to the controller, as the t-phy
+	 * driver does, otherwise the PLL stays off and no pull-up appears.
+	 */
+	mtk_phy_clear_bits(pbase + XSP_U2PHYDTM0, P2D_DTM0_FORCE_MASK |
+			   P2D_RG_DATAIN | P2D_RG_DMPULLDOWN |
+			   P2D_RG_DPPULLDOWN | P2D_RG_XCVRSEL | P2D_RG_TERMSEL);
+	mtk_phy_clear_bits(pbase + XSP_U2PHYDTM1, P2D_RG_UART_EN);
+
 	/* DP/DM BC1.1 path Disable */
 	mtk_phy_clear_bits(pbase + XSP_USBPHYACR6, P2A6_RG_BC11_SW_EN);
 
@@ -410,6 +442,45 @@ static int mtk_phy_init(struct phy *phy)
 	return 0;
 }
 
+/* U3 analog settings of the MediaTek vendor driver (MT6897) */
+#define XSP_U3_DAIF_04			((SSPXTP_SIFSLV_DIG_LN_DAIF) + 0x04)
+#define XSP_U3_RX_AEQ_ATT		BIT(17)
+#define XSP_U3_DAIF_14			((SSPXTP_SIFSLV_DIG_LN_DAIF) + 0x14)
+#define XSP_U3_RX_SEL_20_18		GENMASK(20, 18)
+#define XSP_U3_DAIF_20			((SSPXTP_SIFSLV_DIG_LN_DAIF) + 0x20)
+#define XSP_U3_DAIF_2C			((SSPXTP_SIFSLV_DIG_LN_DAIF) + 0x2c)
+#define XSP_U3_RX_SGDT_HF		GENMASK(23, 22)
+#define XSP_U3_PHYA_LN_08		((SSPXTP_SIFSLV_PHYA_LN) + 0x08)
+#define XSP_U3_RX_CDR_RESERVE		GENMASK(23, 16)
+#define XSP_U3_TX_RXDET_HZ		BIT(13)
+#define XSP_U3_PHYA_LN_30		((SSPXTP_SIFSLV_PHYA_LN) + 0x30)
+#define XSP_U3_LN30_BIT14		BIT(14)
+#define XSP_U3_GLB_28			0x028	/* shared bank, TXPLL */
+#define XSP_U3_GLB_38			0x038	/* shared bank, SPLL */
+#define XSP_U3_PLL_IR			GENMASK(17, 13)
+
+static void u3_phy_vendor_power_on(struct mtk_xsphy *xsphy,
+				   struct xsphy_instance *inst)
+{
+	void __iomem *pbase = inst->port_base;
+
+	if (xsphy->glb_base) {
+		mtk_phy_update_field(xsphy->glb_base + XSP_U3_GLB_28,
+				     XSP_U3_PLL_IR, 4);
+		mtk_phy_update_field(xsphy->glb_base + XSP_U3_GLB_38,
+				     XSP_U3_PLL_IR, 4);
+	}
+	mtk_phy_update_field(pbase + XSP_U3_DAIF_20, XSP_U3_RX_SGDT_HF, 2);
+	mtk_phy_update_field(pbase + XSP_U3_DAIF_2C, XSP_U3_RX_SGDT_HF, 2);
+	mtk_phy_set_bits(pbase + XSP_U3_PHYA_LN_30, XSP_U3_LN30_BIT14);
+	mtk_phy_update_field(pbase + XSP_U3_DAIF_14, XSP_U3_RX_SEL_20_18, 7);
+	mtk_phy_set_bits(pbase + XSP_U3_DAIF_04, XSP_U3_RX_AEQ_ATT);
+	mtk_phy_update_field(pbase + XSP_U3_PHYA_LN_08, XSP_U3_RX_CDR_RESERVE,
+			     0x08);
+	/* Receiver detection out of Hi-Z last */
+	mtk_phy_clear_bits(pbase + XSP_U3_PHYA_LN_08, XSP_U3_TX_RXDET_HZ);
+}
+
 static int mtk_phy_power_on(struct phy *phy)
 {
 	struct xsphy_instance *inst = phy_get_drvdata(phy);
@@ -418,6 +489,8 @@ static int mtk_phy_power_on(struct phy *phy)
 	if (inst->type == PHY_TYPE_USB2) {
 		u2_phy_instance_power_on(xsphy, inst);
 		u2_phy_slew_rate_calibrate(xsphy, inst);
+	} else if (inst->type == PHY_TYPE_USB3 && xsphy->u3_vendor_power) {
+		u3_phy_vendor_power_on(xsphy, inst);
 	}
 
 	return 0;
@@ -430,6 +503,9 @@ static int mtk_phy_power_off(struct phy *phy)
 
 	if (inst->type == PHY_TYPE_USB2)
 		u2_phy_instance_power_off(xsphy, inst);
+	else if (inst->type == PHY_TYPE_USB3 && xsphy->u3_vendor_power)
+		mtk_phy_set_bits(inst->port_base + XSP_U3_PHYA_LN_08,
+				 XSP_U3_TX_RXDET_HZ);
 
 	return 0;
 }
@@ -502,6 +578,7 @@ static const struct phy_ops mtk_xsphy_ops = {
 };
 
 static const struct of_device_id mtk_xsphy_id_table[] = {
+	{ .compatible = "mediatek,mt6897-xsphy", .data = (void *)true },
 	{ .compatible = "mediatek,xsphy", },
 	{ },
 };
@@ -525,6 +602,7 @@ static int mtk_xsphy_probe(struct platform_device *pdev)
 
 	xsphy->nphys = nphys;
 	xsphy->dev = dev;
+	xsphy->u3_vendor_power = !!device_get_match_data(dev);
 	platform_set_drvdata(pdev, xsphy);
 
 	glb_res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
-- 
2.56.0

