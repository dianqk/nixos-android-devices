-#
-
-ifeq ($(CONFIG_MTK_ECCCI_DRIVER), y)
-
-ccflags-y += -I$(DEVICE_MODULES_PATH)/drivers/misc/mediatek/eccci/udc/udc_lib_inc
-ccflags-y += -I$(DEVICE_MODULES_PATH)/drivers/misc/mediatek/include/
-
-obj-$(CONFIG_MTK_ECCCI_DRIVER) += udc.o
-
-
-
-endif
\ No newline at end of file
diff --git a/drivers/misc/mediatek/eccci/udc/udc.c b/drivers/misc/mediatek/eccci/udc/udc.c
index 0e746d0c23..d583066ad0 100644
--- a/drivers/misc/mediatek/eccci/udc/udc.c
+++ b/drivers/misc/mediatek/eccci/udc/udc.c
@@ -7,7 +7,7 @@
 struct udc_func_info udc_func_table;
 
 /* Register UDC API */
-int register_udc_func_deflateInit2(deflateInit2_cb_func_t func)
+static int register_udc_func_deflateInit2(deflateInit2_cb_func_t func)
 {
 	int ret = 0;
 
@@ -41,7 +41,7 @@ int deflateInit2_cb(struct z_stream_s *strm,
 	return ret;
 }
 
-int register_udc_func_deflateSetDict(
+static int register_udc_func_deflateSetDict(
 	deflateSetDict_cb_func_t func)
 {
 	int ret = 0;
@@ -73,7 +73,7 @@ int deflateSetDictionary_cb(struct z_stream_s *strm,
 	return ret;
 }
 
-int register_udc_func_deflate(deflate_cb_func_t func)
