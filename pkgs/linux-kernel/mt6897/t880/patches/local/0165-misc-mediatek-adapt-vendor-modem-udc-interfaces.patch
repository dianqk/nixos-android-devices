---
 drivers/misc/mediatek/eccci/udc/Makefile | 23 -----------------------
 drivers/misc/mediatek/eccci/udc/udc.c    | 23 ++++++++++++-----------
 2 files changed, 12 insertions(+), 34 deletions(-)
 delete mode 100644 drivers/misc/mediatek/eccci/udc/Makefile

diff --git a/drivers/misc/mediatek/eccci/udc/Makefile b/drivers/misc/mediatek/eccci/udc/Makefile
deleted file mode 100644
index 111080a913..0000000000
--- a/drivers/misc/mediatek/eccci/udc/Makefile
+++ /dev/null
@@ -1,23 +0,0 @@
