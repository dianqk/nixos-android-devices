 {
 	int ret = 0;
 
@@ -103,7 +103,7 @@ int deflate_cb(struct z_stream_s *strm, int flush)
 	return ret;
 }
 
-int register_udc_func_deflateEnd(deflateEnd_cb_func_t func)
+static int register_udc_func_deflateEnd(deflateEnd_cb_func_t func)
 {
 	int ret = 0;
 
@@ -133,7 +133,7 @@ int deflateEnd_cb(struct z_stream_s *strm)
 	return ret;
 }
 
-int register_udc_func_deflateReset(deflateReset_cb_func_t func)
+static int register_udc_func_deflateReset(deflateReset_cb_func_t func)
 {
 	int ret = 0;
 
@@ -163,7 +163,7 @@ int deflateReset_cb(struct z_stream_s *strm)
 	return ret;
 }
 
-int register_udc_func_deflateBound(deflateBound_cb_func_t func)
+static int register_udc_func_deflateBound(deflateBound_cb_func_t func)
 {
 	int ret = 0;
 
@@ -193,7 +193,7 @@ int deflateBound_cb(struct z_stream_s *strm, unsigned long sourceLen)
 	return ret;
 }
 
-int register_udc_func_udc_chksum(udc_chksum_cb_func_t func)
+static int register_udc_func_udc_chksum(udc_chksum_cb_func_t func)
 {
 	int ret = 0;
 
@@ -223,7 +223,7 @@ int udc_chksum_cb(struct z_stream_s *strm)
 	return ret;
 }
 
-int register_udc_func_udc_QueryPara(udc_QueryPara_cb_func_t func)
+static int register_udc_func_udc_QueryPara(udc_QueryPara_cb_func_t func)
 {
 	int ret = 0;
 
@@ -253,7 +253,7 @@ int udc_QueryPara_cb(struct z_stream_s *strm, int id, void *param)
 	return ret;
 }
 
-int register_udc_func_udc_GetCmpLen(udc_GetCmpLen_cb_func_t func)
+static int register_udc_func_udc_GetCmpLen(udc_GetCmpLen_cb_func_t func)
 {
 	int ret = 0;
 
@@ -284,6 +284,7 @@ int udc_GetCmpLen_cb(struct z_stream_s *strm,
 	return ret;
 }
 
+int register_udc_functions(unsigned int id, void *f);
 int register_udc_functions(unsigned int id, void *f)
 {
 	switch (id) {
@@ -357,7 +358,7 @@ int register_udc_functions(unsigned int id, void *f)
 }
 EXPORT_SYMBOL(register_udc_functions);
 
-void my_free(void *my_param, void *ptr)
+static void my_free(void *my_param, void *ptr)
 {
 	struct udc_private_data *p = (struct udc_private_data *)my_param;
 
@@ -369,7 +370,7 @@ void my_free(void *my_param, void *ptr)
 	}
 }
 
-void *my_malloc(void *my_param, unsigned int size, unsigned int count)
+static void *my_malloc(void *my_param, unsigned int size, unsigned int count)
 {
 	struct udc_private_data *p = (struct udc_private_data *)my_param;
 	unsigned char *ptr;
