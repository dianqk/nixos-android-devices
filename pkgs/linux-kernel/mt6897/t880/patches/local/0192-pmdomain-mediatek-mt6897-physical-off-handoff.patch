+static void scpsys_record_boot_off(struct scpsys_domain *pd)
+{
+	struct scpsys *scpsys = pd->scpsys;
+	struct scpsys_root_clocks *roots = pd->roots;
+	u32 status = 0;
+	int ret;
+
+	if (!scpsys->boot_owner)
+		return;
+	/* Keep the complete ordinary-root reference set through observation and
+	 * transfer. Incomplete ownership must not record even a sticky epoch.
+	 */
+	if (roots->enabled_count != roots->num_clks)
+		ret = -EINVAL;
+	else {
+		ret = regmap_read(scpsys->spm, pd->hwv_data->spm_pwr_con, &status);
+		if (!ret)
+			ret = mt6897_clk_boot_record_off(scpsys->boot_owner,
+						       pd->hwv_data->boot_bank, status);
+	}
+	/* A busy first sample must not hide a later verified off observation. */
+	if ((!ret && !roots->off_reported) || (ret && !roots->ineligible_reported)) {
+		dev_info(scpsys->dev, "%s: physical-off observation %#x, epoch result %d\n",
+			 pd->genpd.name, status, ret);
+		if (ret)
+			roots->ineligible_reported = true;
+		else
+			roots->off_reported = true;
+	}
+}
+
 static void scpsys_unprepare_root_clocks(struct scpsys *scpsys)
 {
 	int i;
 
+	if (scpsys->boot_owner) {
+		mt6897_clk_boot_put(scpsys->boot_owner);
+		scpsys->boot_owner = NULL;
+	}
+
 	for (i = scpsys->soc_data->num_hwv_domains - 1; i >= 0; i--) {
 		struct scpsys_root_clocks *roots = &scpsys->roots[i];
 
@@ -511,6 +608,7 @@ static int scpsys_hwv_root_power_off(struct generic_pm_domain *genpd)
 			genpd->name, ret);
 		return ret;
 	}
+	scpsys_record_boot_off(pd);
 	while (roots->enabled_count)
 		clk_disable(roots->clks[--roots->enabled_count].clk);
 	return 0;
@@ -1680,6 +1778,8 @@ static int scpsys_probe(struct platform_device *pdev)
 		if (!scpsys->roots)
 			return -ENOMEM;
 		ret = scpsys_prepare_root_clocks(scpsys, np);
+		if (!ret)
+			ret = scpsys_get_boot_owner(scpsys);
 		if (ret) {
 			scpsys_unprepare_root_clocks(scpsys);
 			return dev_err_probe(dev, ret, "failed to prepare domain roots\n");
