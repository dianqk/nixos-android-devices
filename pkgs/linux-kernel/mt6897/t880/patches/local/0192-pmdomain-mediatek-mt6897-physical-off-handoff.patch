+static void test_spm_preflight_and_observation(void)
+{
+	reset();
+	assert(!scpsys_prepare_root_clocks(&controller, &parent));
+	assert(!scpsys_get_boot_owner(&controller));
+	assert(!controller.boot_owner);
+	parent.spm = true;
+	for (int bad = 0; bad < 5; bad++) {
+		struct scpsys_hwv_domain_data saved = data[1];
+		if (bad == 0)
+			data[1].spm_pwr_con = 0;
+		if (bad == 1)
+			data[1].spm_pwr_con = 0xea5;
+		if (bad == 2)
+			data[1].boot_bank = 2;
+		if (bad == 3)
+			data[1].boot_bank = 0;
+		if (bad == 4)
+			data[1].spm_pwr_con = data[0].spm_pwr_con;
+		assert(scpsys_get_boot_owner(&controller) == -EINVAL);
+		assert(!map_creations && !map.writes);
+		data[1] = saved;
+	}
+	reset_spm = 1;
+	assert(scpsys_get_boot_owner(&controller) == -EINVAL);
+	assert(!map_creations);
+	reset_spm = 0;
+	unsafe_spm = 1;
+	assert(scpsys_get_boot_owner(&controller) == -EINVAL);
+	unsafe_spm = 0;
+	sleeping_spm = 1;
+	assert(scpsys_get_boot_owner(&controller) == -EINVAL);
+	sleeping_spm = 0;
+	owner_get_error = -EPROBE_DEFER;
+	assert(scpsys_get_boot_owner(&controller) == -EPROBE_DEFER);
+	assert(!map.writes);
+	owner_get_error = 0;
+	assert(!scpsys_get_boot_owner(&controller));
+	assert(controller.boot_owner == &boot_handle);
+	scpsys_unprepare_root_clocks(&controller);
+	assert(owner_put_calls == 1 && !controller.boot_owner &&
+	       !shared.prepared);
+	assert(put_sequence && unprepare_sequence > put_sequence);
+	reset();
+	parent.spm = true;
+	assert(!scpsys_prepare_root_clocks(&controller, &parent));
+	assert(!scpsys_get_boot_owner(&controller));
+	assert(!scpsys_quarantine_initialization(&controller, -EIO));
+	assert(controller.boot_owner == &boot_handle && !owner_put_calls &&
+	       shared.prepared == 2);
+	for (int mode = 0; mode < 4; mode++) {
+		reset();
+		parent.spm = true;
+		assert(!scpsys_prepare_root_clocks(&controller, &parent));
+		assert(!scpsys_get_boot_owner(&controller));
+		struct scpsys_domain a = domain(0);
+		assert(!scpsys_hwv_root_power_on(&a.genpd));
+		spm_map.physical = mode == 0 ? 18 : mode == 1 ? BIT(30) : 0;
+		spm_map.fail = mode == 3 ? 1 : 0;
+		assert(!scpsys_hwv_root_power_off(&a.genpd));
+		assert(!shared.enabled && !controller.quarantined);
+		assert(boot_handle.calls == (mode == 3 ? 0 : 1));
+		assert(roots[0].off_reported == (mode == 0));
+		assert(roots[0].ineligible_reported == (mode != 0));
+		/* A first ineligible sample does not suppress eventual success.
+		 */
+		spm_map.fail = 0;
+		spm_map.physical = 18;
+		assert(!scpsys_hwv_root_power_on(&a.genpd));
+		assert(!scpsys_hwv_root_power_off(&a.genpd));
+		assert(roots[0].off_reported);
+	}
+}
