+static int scpsys_get_boot_owner(struct scpsys *scpsys)
+{
+	struct device_node *node, *top;
+	struct mt6897_clk_boot_owner *owner;
+	struct regmap *map;
+	u16 offsets[2] = { 0 };
+	unsigned int i;
+	int ret = 0;
+
+	if (!of_property_present(scpsys->dev->of_node, "mediatek,spm"))
+		return 0;
+	for (i = 0; i < scpsys->soc_data->num_hwv_domains; i++) {
+		const struct scpsys_hwv_domain_data *data = &scpsys->soc_data->hwv_domains_data[i];
+
+		if (!data->num_prepared_clks)
+			continue;
+		if (!data->spm_pwr_con || (data->spm_pwr_con & 3) ||
+		    data->boot_bank > 1 || offsets[data->boot_bank])
+			return -EINVAL;
+		offsets[data->boot_bank] = data->spm_pwr_con;
+	}
+	if (!offsets[0] || !offsets[1] || offsets[0] == offsets[1])
+		return -EINVAL;
+	node = of_parse_phandle(scpsys->dev->of_node, "mediatek,spm", 0);
+	if (!node)
+		return -EINVAL;
+	if (!of_device_is_compatible(node, "mediatek,mt6897-scpsys") ||
+	    of_property_present(node, "clocks") || of_property_present(node, "hwlocks") ||
+	    of_property_present(node, "resets") ||
+	    of_property_present(node, "power-domains")) {
+		ret = -EINVAL;
+		goto out;
+	}
+	map = syscon_node_to_regmap(node);
+	if (IS_ERR(map)) {
+		ret = PTR_ERR(map);
+		goto out;
+	}
+	if (regmap_might_sleep(map)) {
+		ret = -EINVAL;
+		goto out;
+	}
+	top = of_find_compatible_node(NULL, NULL, scpsys->soc_data->prepared_clk_compatible);
+	owner = mt6897_clk_boot_get(top, scpsys->dev);
+	of_node_put(top);
+	if (IS_ERR(owner)) {
+		ret = PTR_ERR(owner);
+		goto out;
+	}
+	scpsys->spm = map;
+	scpsys->boot_owner = owner;
+out:
+	of_node_put(node);
+	return ret;
+}
