Source commit: 3c4ccd07d562 "Kernel: Xiaomi kernel_device_modules changes for
Redmi K70E Android U" by 何发云 <hefayun@xiaomi.com>, 2024-01-12.
Signed-off-by: dianqk <dianqk@dianqk.net>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/misc/mediatek/include/mt-plat/mtk_ccci_common.h | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/drivers/misc/mediatek/include/mt-plat/mtk_ccci_common.h b/drivers/misc/mediatek/include/mt-plat/mtk_ccci_common.h
index 9d059442cd..a863d3f06c 100644
--- a/drivers/misc/mediatek/include/mt-plat/mtk_ccci_common.h
+++ b/drivers/misc/mediatek/include/mt-plat/mtk_ccci_common.h
@@ -702,12 +702,12 @@ enum {
 void ccci_util_mem_dump(int buf_type, void *start_addr, int len);
 void ccci_util_cmpt_mem_dump(int buf_type, void *start_addr,
 	int len);
-int ccci_dump_write(unsigned int buf_type, unsigned int flag,
+__printf(3, 4) int ccci_dump_write(unsigned int buf_type, unsigned int flag,
 	const char *fmt, ...);
-int ccci_log_write(const char *fmt, ...);
-int ccci_log_write_raw(unsigned int flags, const char *fmt, ...);
+__printf(1, 2) int ccci_log_write(const char *fmt, ...);
+__printf(2, 3) int ccci_log_write_raw(unsigned int flags, const char *fmt, ...);
 int ccci_event_log_cpy(char buf[], int size);
-int ccci_event_log(const char *fmt, ...);
+__printf(1, 2) int ccci_event_log(const char *fmt, ...);
 
 /* MPU setting */
 struct _mpu_cfg {
