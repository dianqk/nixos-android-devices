index 0000000000..c1101c83b9
--- /dev/null
+++ b/include/linux/remoteproc/mtk_vcp_memory.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __LINUX_MTK_VCP_MEMORY_H
+#define __LINUX_MTK_VCP_MEMORY_H
+#include <linux/types.h>
+
+/* MT6897 VIDEO_UP1 software DMA aperture, distinct from decoder hardware. */
+#define MTK_VCP_SW_IOVA_START 0x140000000ULL
+#define MTK_VCP_SW_IOVA_END   0x1a0000000ULL
+static inline bool mtk_vcp_sw_dma_valid(u64 address, u64 size)
+{
+	return size && address >= MTK_VCP_SW_IOVA_START &&
+		address < MTK_VCP_SW_IOVA_END && !(address & 0xf) &&
+		size <= MTK_VCP_SW_IOVA_END - address;
+}
+#endif
diff --git a/tools/testing/selftests/mtk_vcp/test_mt6897.py b/tools/testing/selftests/mtk_vcp/test_mt6897.py
new file mode 100644
index 0000000000..a61878616e
--- /dev/null
+++ b/tools/testing/selftests/mtk_vcp/test_mt6897.py
@@ -0,0 +1,319 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Compile the actual MT6897 wire helpers and test them without hardware."""
+import os
+from pathlib import Path
+import re
+import shlex
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[4]
+headers = [
+    root / "drivers/media/platform/mediatek/vcodec/vcp/mtk_vcp_vdec_pixels.h",
+    root / "include/linux/remoteproc/mtk_vcp_memory.h",
+    root / "drivers/soc/mediatek/mtk-vcp-platform.h",
+    root / "drivers/media/platform/mediatek/vcodec/vcp/mtk_vcp_vdec_mt6897_abi.h",
+]
+preamble = r"""
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+#include <errno.h>
+#include <endian.h>
+#define static_assert _Static_assert
+typedef uint64_t u64;
+typedef uint32_t u32;
+typedef uint8_t u8;
+typedef uint64_t __le64;
+typedef uint32_t __le32;
+typedef uint16_t __le16;
+#define cpu_to_le32 htole32
+#define cpu_to_le64 htole64
+#define le32_to_cpu le32toh
+"""
+checks = r"""
+/* Generate tiles sequentially from coordinate-labelled pixels, then compare
+ * actual detiling against the independent linear coordinate oracle. Tails and
+ * destination guards stay outside the defined footprint.
+ */
+static unsigned char pixel(unsigned x, unsigned y) { return (x * 7 + y * 13) % 251; }
+static void test_mm21_pixels(void)
+{
+    for (unsigned tile_h=16; tile_h<=32; tile_h*=2) {
+        enum { stride=32, height=64, footprint=stride*height, guard=16, tail=37 };
+        unsigned char src[footprint+tail], dst[guard+footprint+guard];
+        size_t cursor=0;
+        memset(src,0xed,sizeof(src)); memset(dst,0xa7,sizeof(dst));
+        for (unsigned block_y=0; block_y<height; block_y+=tile_h)
+            for (unsigned block_x=0; block_x<stride; block_x+=16)
+                for (unsigned row=0; row<tile_h; row++)
+                    for (unsigned col=0; col<16; col++)
+                        src[cursor++]=pixel(block_x+col,block_y+row);
+        assert(cursor==footprint);
+        mtk_vcp_mm21_detile(dst+guard,src,stride,height,tile_h);
+        for (unsigned y=0; y<height; y++) for (unsigned x=0; x<stride; x++)
+            assert(dst[guard+y*stride+x]==pixel(x,y));
+        for (unsigned i=0; i<guard; i++) assert(dst[i]==0xa7 && dst[guard+footprint+i]==0xa7);
+        for (unsigned i=0; i<tail; i++) assert(src[footprint+i]==0xed);
+        /* An odd visible rectangle must remain a subset of the coded frame. */
+        assert(mtk_vcp_crop_valid(stride,height,3,5,17,19));
+        for (unsigned y=5; y<24; y++) for (unsigned x=3; x<20; x++)
+            assert(dst[guard+y*stride+x]==pixel(x,y));
+    }
+    assert(!mtk_vcp_mm21_valid(1920,1088,2121728,1060864,8));
+    assert(mtk_vcp_mm21_valid(1920,1088,2121728,1060864,0));
+    assert(mtk_vcp_mm21_valid(1920,1088,2088960,1044480,0));
+    assert(!mtk_vcp_mm21_valid(1920,1088,2088959,1044480,0));
+    assert(!mtk_vcp_mm21_valid(1920,1088,2088960,1044479,0));
+    assert(!mtk_vcp_mm21_valid(1920,1088,2121728,1060864,9));
+    assert(!mtk_vcp_mm21_valid(1921,1088,2121728,1060864,0));
+    assert(!mtk_vcp_mm21_valid(1920,1089,2121728,1060864,0));
+    assert(!mtk_vcp_mm21_valid(1920,1088,UINT32_MAX,UINT32_MAX,0));
+    assert(!mtk_vcp_mm21_valid(0,1088,2121728,1060864,0));
+    assert(!mtk_vcp_crop_valid(1920,1088,0,0,0,1080));
+    assert(!mtk_vcp_crop_valid(1920,1088,1,0,1920,1080));
+    assert(!mtk_vcp_crop_valid(1920,1088,0,9,1920,1080));
+    assert(!mtk_vcp_crop_valid(1920,1088,UINT32_MAX,0,1920,1080));
+}
+
+static void test_header_params(void)
+{
+    struct mt6897_vdec_params p, expected;
+    memset(&p, 0xa5, sizeof(p));
+    expected = p;
+    expected.width = 0;
+    expected.height = 0;
+    expected.changed = cpu_to_le32(0xa5a5a5a7);
+    mt6897_vdec_header_params(&p);
+    assert(!memcmp(&p, &expected, sizeof(p)));
+    mt6897_vdec_header_params(&p);
+    assert(!memcmp(&p, &expected, sizeof(p)));
+}
+
+static void test_logger(void)
+{
+    struct mtk_vcp_logger_info info = {
+        .dram=cpu_to_le32(0x3fffc), .buf=cpu_to_le32(0x3fffb),
+        .start=cpu_to_le32(0x3fff8), .end=cpu_to_le32(0x3fff4),
+        .len=cpu_to_le32(5),
+    }, copy = info;
+    assert(mtk_vcp_logger_valid(&info, 0x2000));
+    assert(mtk_vcp_logger_same(&info, &copy));
+    copy.len=cpu_to_le32(4);
+    assert(!mtk_vcp_logger_same(&info, &copy));
+    info.len=cpu_to_le32(6);
+    assert(!mtk_vcp_logger_valid(&info, 0x2000));
+    info.len=cpu_to_le32(UINT32_MAX);
+    assert(!mtk_vcp_logger_valid(&info, 0x2000));
+    info.len=0;
+    assert(!mtk_vcp_logger_valid(&info, 0x2000));
+    info.len=cpu_to_le32(5);
+    info.buf=cpu_to_le32(UINT32_MAX);
+    assert(!mtk_vcp_logger_valid(&info, 0x2000));
+    info=copy;
+    info.buf=cpu_to_le32(0x1fff);
+    assert(!mtk_vcp_logger_valid(&info, 0x2000));
+    info=copy;
+    info.dram=cpu_to_le32(0x1ffc);
+    assert(!mtk_vcp_logger_valid(&info, 0x2000));
+    info=copy;
+    info.end=cpu_to_le32(0x1ffc);
+    assert(!mtk_vcp_logger_valid(&info, 0x2000));
+    for (unsigned i=0; i<3; i++) {
+        info=copy;
+        if (i==0) info.dram=cpu_to_le32(0x3fffd);
+        if (i==1) info.start=cpu_to_le32(0x3fffa);
+        if (i==2) info.end=cpu_to_le32(0x3fff5);
+        assert(!mtk_vcp_logger_valid(&info, 0x2000));
+    }
+    assert(!mtk_vcp_logger_valid(&copy, 0));
+    assert(!mtk_vcp_logger_valid(&copy, 0x40001));
+}
+
+static void test_metadata(void)
+{
+    struct mtk_vcp_region_info r = {
+        .loader_start = cpu_to_le32(0x06000001),
+        .loader_size = cpu_to_le32(0x2000),
+        .firmware_start = cpu_to_le32(0x06002001),
+        .firmware_size = cpu_to_le32(0x40000),
+        .dram_start = cpu_to_le32(0x06100001),
+        .dram_size = cpu_to_le32(0x100000),
+        .dram_backup_start = cpu_to_le32(0x06200001),
+        .struct_size = cpu_to_le32(0x50),
+    };
+    const u64 lower = 0x106000000ULL, upper = 0x108000000ULL;
+    assert(mtk_vcp_unpack_iova(0x06000001) == lower);
+    assert(!mtk_vcp_validate_region(&r, sizeof(r), 0x50, lower, upper));
+    assert(mtk_vcp_validate_region(&r, sizeof(r), 0x54, lower, upper) == -EPROTONOSUPPORT);
+    for (size_t i = 0; i < sizeof(r); i++)
+        assert(mtk_vcp_validate_region(&r, i, 0x50, lower, upper) == -EMSGSIZE);
+    assert(mtk_vcp_validate_region(&r, sizeof(r), 0x38, lower, upper) == -EPROTO);
+    r.struct_size = cpu_to_le32(0x38);
+    assert(!mtk_vcp_validate_region(&r, 0x38, 0x38, lower, upper));
+    r.loader_size = 0;
+    assert(mtk_vcp_validate_region(&r, sizeof(r), 0x38, lower, upper) == -EPROTO);
+    r.loader_size = cpu_to_le32(0x2000);
+    r.dram_size = cpu_to_le32(UINT32_MAX);
+    assert(mtk_vcp_validate_region(&r, sizeof(r), 0x38, lower, upper) == -ERANGE);
+    r.dram_size = cpu_to_le32(0x100000);
+    r.dram_backup_start = cpu_to_le32(0x08000001);
+    assert(mtk_vcp_validate_region(&r, sizeof(r), 0x38, lower, upper) == -ERANGE);
+    assert(!mtk_vcp_range_valid(0x06000001, 0, lower, upper));
+    assert(!mtk_vcp_range_valid(0x06000001, 1, upper, lower));
+    assert(!mtk_vcp_range_valid(0x06000001, 1, lower + 16, upper));
+    assert(!mtk_vcp_range_valid(0xffffffff, UINT32_MAX, 0, 1ULL << 36));
+}
+
+static void test_serialization(void)
+{
+    struct mt6897_vdec_init init;
+    struct mt6897_vdec_query query;
+    struct mt6897_vdec_start start;
+    const u64 cookie = 0x1122334455667788ULL;
+    const u64 data_cookie = 0x8877665544332211ULL;
+    const u32 data[] = { 1, 2, 3, 4, 5, 0xabcdef01 };
+    const unsigned char init_expected[24] = {
+        0, 0xa0, 0, 0, 0x78, 0x56, 0x34, 0x12,
+        0, 0, 0, 0, 0, 0, 0, 0,
+        0x88, 0x77, 0x66, 0x55, 0x44, 0x33, 0x22, 0x11,
+    };
+    const unsigned char query_expected[40] = {
+        5, 0xa0, 0, 0, 0x78, 0x56, 0x34, 0x12,
+        0, 0, 0, 0, 0, 0, 0, 0,
+        0x88, 0x77, 0x66, 0x55, 0x44, 0x33, 0x22, 0x11,
+        0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88,
+        8, 0, 0, 0, 0, 0, 0, 0,
+    };
+    memset(&init, 0xa5, sizeof(init));
+    memset(&query, 0xa5, sizeof(query));
+    memset(&start, 0xa5, sizeof(start));
+    mt6897_vdec_make_init(&init, 0x12345678, cookie);
+    mt6897_vdec_make_query(&query, 0x12345678, cookie, data_cookie, 8);
+    mt6897_vdec_make_start(&start, 0x12345678, data_cookie, data);
+    assert(!memcmp(&init, init_expected, sizeof(init)));
+    assert(!memcmp(&query, query_expected, sizeof(query)));
+    assert(start.instance == cpu_to_le64(data_cookie));
+    assert(start.id == cpu_to_le32(0xa001));
+    assert(start.ctx == cpu_to_le32(0x12345678));
+    for (unsigned i = 0; i < 6; i++)
+        assert(start.data[i] == cpu_to_le32(data[i]));
+}
+
+static void test_bootstrap(void)
+{
+    struct mt6897_venc_boot_mem reply;
+    const unsigned char expected[64] = {
+        3,0x40,0,0, 0x78,0x56,0x34,0x12,
+        0x88,0x77,0x66,0x55,0x44,0x33,0x22,0x11,
+        0,0,0,0, 0,0,0,0, 6,0,0,0, 0,0x20,1,0,
+        0,0x10,0,0x90,1,0,0,0, 0,0x10,0,0x90,1,0,0,0,
+        0x10,0x32,0x54,0x76,0x98,0xba,0xdc,0xfe,
+        0x21,0x43,0x65,0x87, 0x98,0xba,0xdc,0xfe,
+    };
+    memset(&reply, 0xa5, sizeof(reply));
+    reply.ctx = cpu_to_le32(0x12345678);
+    reply.cookie = cpu_to_le64(0x1122334455667788ULL);
+    mt6897_venc_shm_reply(&reply, 0x12000, 0x190001000ULL,
+                         0xfedcba9876543210ULL, 0x87654321, 0xfedcba98);
+    assert(!memcmp(&reply, expected, sizeof(reply)));
+    assert(mt6897_vcp_dma_valid(0x140000000ULL, 0x10000000));
+    assert(mt6897_vcp_dma_valid(0x19ffffff0ULL, 16));
+    assert(!mt6897_vcp_dma_valid(0x140000000ULL, 0));
+    assert(!mt6897_vcp_dma_valid(0x13ffffff0ULL, 16));
+    assert(!mt6897_vcp_dma_valid(0x1a0000000ULL, 16));
+    assert(!mt6897_vcp_dma_valid(0x140000001ULL, 16));
+    assert(!mt6897_vcp_dma_valid(0x14ffffff0ULL, 17));
+    assert(!mt6897_vcp_dma_valid(0x19ffffff0ULL, 17));
+    assert(!mt6897_vcp_dma_valid(0x140000000ULL, UINT64_MAX));
+    assert(!mt6897_vcp_dma_valid(UINT64_MAX - 15, 32));
+}
+
+/* Independent table allocator, directly from the MT6897 DTS send/recv
+ * ordering and vendor two-word rounding rule; compare production pins.
+ */
+struct table_pin { unsigned channel, mailbox, words; };
+static const struct table_pin sends[] = {
+    {0,0,18}, {2,1,2}, {3,1,2}, {9,1,2}, {11,1,2}, {13,1,2},
+    {15,1,4}, {16,2,18}, {18,2,4}, {20,3,2}, {21,3,2},
+    {22,3,6}, {23,3,2}, {28,4,4},
+};
+static const struct table_pin receives[] = {
+    {1,0,18}, {2,1,1}, {4,1,10}, {5,1,1}, {6,1,2}, {10,1,2},
+    {12,1,2}, {14,1,2}, {15,1,4}, {17,2,18}, {19,2,4},
+    {20,3,1}, {24,3,10}, {25,3,6}, {26,3,1}, {27,3,2}, {29,4,4},
+};
+static void check_pin(const struct mtk_vcp_pin *p, bool tx)
+{
+    unsigned offset = 0;
+    for (unsigned direction = 0; direction < 2; direction++) {
+        const struct table_pin *table = direction ? receives : sends;
+        size_t count = direction ? sizeof(receives)/sizeof(*table) : sizeof(sends)/sizeof(*table);
+        for (size_t i = 0; i < count; i++) {
+            if (table[i].mailbox != p->mailbox)
+                continue;
+            if (direction == !tx && table[i].channel == p->channel) {
+                assert(p->word == offset);
+                assert(p->bit == offset / 2);
+                assert(p->words == table[i].words);
+                return;
+            }
+            offset += (table[i].words + 1) / 2 * 2;
+        }
+    }
+    assert(!"missing pin");
+}
+int main(void)
+{
+    assert(mt6897_vdec_normal_aperture_valid(0, 0xff7fffffULL, true));
+    assert(mt6897_vdec_normal_aperture_valid(0, 0xffffffffULL, true));
+    assert(!mt6897_vdec_normal_aperture_valid(1, 0xff7fffffULL, true));
+    assert(!mt6897_vdec_normal_aperture_valid(0, 0x100000000ULL, true));
+    assert(!mt6897_vdec_normal_aperture_valid(0, 0xff7fffffULL, false));
+    assert(!mt6897_vdec_normal_aperture_valid(0, 0, true));
+    assert(mtk_vcp_sw_dma_valid(0x140000000ULL, 16));
+    assert(mtk_vcp_sw_dma_valid(0x19ffffff0ULL, 16));
+    assert(!mtk_vcp_sw_dma_valid(0x13ffffff0ULL, 16));
+    assert(!mtk_vcp_sw_dma_valid(0x1a0000000ULL, 16));
+    assert(!mtk_vcp_sw_dma_valid(0x19ffffff0ULL, 17));
+    assert(!mtk_vcp_sw_dma_valid(0x140000000ULL, UINT64_MAX));
+    assert(!mtk_vcp_sw_dma_valid(0xfffffffffffffff0ULL, 32));
+    assert(!mtk_vcp_sw_dma_valid(0x140000001ULL, 16));
+    assert(!mtk_vcp_sw_dma_valid(0x140000000ULL, 0));
+    test_mm21_pixels();
+    test_header_params();
+    test_logger();
+    test_metadata();
+    test_bootstrap();
+    assert(mtk_vcp_shadow_pa(0xf1234567U) == 0x7f1234000ULL);
+    assert(mtk_vcp_shadow_pa(0) == 0);
+    test_serialization();
+    check_pin(&mt6897_vcp_platform.dec_tx, true);
+    check_pin(&mt6897_vcp_platform.dec_rx, false);
+    check_pin(&mt6897_vcp_platform.enc_tx, true);
+    check_pin(&mt6897_vcp_platform.enc_rx, false);
+    check_pin(&mt6897_vcp_platform.ready0, false);
+    check_pin(&mt6897_vcp_platform.ready1, false);
+    check_pin(&mt6897_vcp_platform.logger_tx, true);
+    check_pin(&mt6897_vcp_platform.logger_rx, false);
+    return 0;
+}
