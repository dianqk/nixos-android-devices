diff --git a/drivers/soc/mediatek/mtk-vcp-platform.h b/drivers/soc/mediatek/mtk-vcp-platform.h
new file mode 100644
index 0000000000..a7a0b1461f
--- /dev/null
+++ b/drivers/soc/mediatek/mtk-vcp-platform.h
@@ -0,0 +1,165 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* VCP bootloader metadata and mailbox layouts; no hardware access here. */
+#ifndef __MTK_VCP_PLATFORM_H
+#define __MTK_VCP_PLATFORM_H
+#include <linux/build_bug.h>
+#include <linux/errno.h>
+#include <linux/stddef.h>
+#include <linux/types.h>
+#include <linux/byteorder/generic.h>
+
+/* Shared pointers encode only a 28-bit offset within one window. */
+static inline bool mt6897_vcp_dma_valid(u64 dma, u64 size)
+{
+	const u64 lower = 0x140000000ULL, upper = 0x1a0000000ULL;
+
+	return size && dma >= lower && dma < upper &&
+		size <= upper - dma && !(dma & 0xf) &&
+		(dma >> 28) == ((dma + size - 1) >> 28);
+}
+
+#define MTK_VCP_REGION_OFFSET 4
+#define MTK_VCP_LOADER_SIZE 0x2000
+#define MTK_VCP_TCM_SIZE 0x40000
+
+/* MediaTek vcp_helper.h, MiCode/MTK_kernel_device_modules
+ * 3c4ccd07d5624879555ec710c11bb8818e5cb5c6. The first 0x38 bytes are
+ * shared with MT6895; MT6897 adds the following six words.
+ */
+struct mtk_vcp_region_info {
+	__le32 loader_start, loader_size, firmware_start, firmware_size;
+	__le32 dram_start, dram_size, dram_backup_start, struct_size;
+	__le32 log_uart, task_context, vcpctl, regdump_start, regdump_size;
+	__le32 params_start, sramlog_buf_offset, sramlog_end_idx_offset;
+	__le32 sramlog_buf_maxlen, loader_start_pa, coredump_offset;
+	__le32 coredump_dram_offset;
+};
+static_assert(sizeof(struct mtk_vcp_region_info) == 0x50);
+static_assert(offsetof(struct mtk_vcp_region_info, struct_size) == 0x1c);
+
+/* vcp_logger.c: end is a u32 write-index slot, not the buffer end. */
+struct mtk_vcp_logger_info {
+	__le32 dram, buf, start, end, len;
+};
+struct mtk_vcp_logger_message {
+	__le32 cmd;
+	struct mtk_vcp_logger_info info;
+};
+struct mtk_vcp_logger_header {
+	__le32 magic, size, enable, info_offset, buffer_offset, buffer_size;
+	__le32 read_pos, write_pos;
+};
+static_assert(sizeof(struct mtk_vcp_logger_message) == 24);
+static_assert(sizeof(struct mtk_vcp_logger_header) == 32);
+#define MTK_VCP_LOGGER_RING_SIZE 0x100000
+
+static inline bool mtk_vcp_tcm_word_valid(u32 offset)
+{
+	return !(offset & 3) && offset <= MTK_VCP_TCM_SIZE - sizeof(u32);
+}
+
+static inline bool mtk_vcp_logger_valid(const struct mtk_vcp_logger_info *info,
+				      u32 loader_size)
+{
+	u32 buf = le32_to_cpu(info->buf), len = le32_to_cpu(info->len);
+	u32 end = le32_to_cpu(info->end);
+
+	return loader_size && loader_size <= MTK_VCP_TCM_SIZE &&
+		mtk_vcp_tcm_word_valid(le32_to_cpu(info->dram)) &&
+		le32_to_cpu(info->dram) >= loader_size &&
+		mtk_vcp_tcm_word_valid(le32_to_cpu(info->start)) &&
+		mtk_vcp_tcm_word_valid(end) && end >= loader_size &&
+		buf >= loader_size && buf < MTK_VCP_TCM_SIZE &&
+		len && len <= MTK_VCP_TCM_SIZE - buf;
+}
+
+/* Repeated identical INIT is idempotent; changed pointers are not accepted. */
+static inline bool mtk_vcp_logger_same(const struct mtk_vcp_logger_info *a,
+				     const struct mtk_vcp_logger_info *b)
+{
+	return a->dram == b->dram && a->buf == b->buf && a->start == b->start &&
+		a->end == b->end && a->len == b->len;
+}
+
+struct mtk_vcp_pin {
+	u8 mailbox, word, bit, words, channel;
+};
+struct mtk_vcp_platform {
+	u32 region_size;
+	u64 code_start, code_end;
+	struct mtk_vcp_pin dec_tx, dec_rx, enc_tx, enc_rx, ready0, ready1, logger_tx, logger_rx;
+	u32 reserved_sizes[10];
+};
+
+/* Pin offsets follow the vendor 64-bit mailbox allocator: all TX pins,
+ * then RX pins, each rounded up to two words. These are word offsets,
+ * never byte offsets. READY channel IDs alone do not identify a pin.
+ */
+static const struct mtk_vcp_platform mt6897_vcp_platform = {
+	.region_size = 0x50,
+	.code_start = 0x106000000ULL,
+	.code_end = 0x108000000ULL,
+	.dec_tx = { 0, 0, 0, 18, 0 },
+	.dec_rx = { 0, 18, 9, 18, 1 },
+	.enc_tx = { 2, 0, 0, 18, 16 },
+	.enc_rx = { 2, 22, 11, 18, 17 },
+	.ready0 = { 1, 26, 13, 1, 5 },
+	.ready1 = { 3, 30, 15, 1, 26 },
+	.logger_tx = { 3, 4, 2, 6, 22 },
+	.logger_rx = { 3, 24, 12, 6, 25 },
+	.reserved_sizes = {
+		0x78000, 0x12000, 0x180000, 0x400, 0x400,
+		0x400, 0x400, 0x100000, 0x1000, 0x1000,
+	},
+};
+
+static inline u64 mtk_vcp_unpack_iova(u32 packed)
+{
+	return (packed & ~0xfULL) | ((u64)(packed & 0xf) << 32);
+}
+
+static inline bool mtk_vcp_range_valid(u32 packed, u32 size, u64 lower, u64 upper)
+{
+	u64 start = mtk_vcp_unpack_iova(packed);
+
+	return lower < upper && size && start >= lower && start < upper &&
+	       size <= upper - start;
+}
+
+/* Call only on a CPU snapshot copied while the SRAM domain is powered.
+ * The caller supplies a separately verified IOVA aperture. The metadata
+ * cannot enlarge its own permitted address window. No reserved RAM is read.
+ */
+static inline int mtk_vcp_validate_region(const struct mtk_vcp_region_info *info,
+					size_t bytes, u32 expected_size,
+					u64 lower, u64 upper)
+{
+	u32 size;
+
+	if (expected_size != 0x38 && expected_size != 0x50)
+		return -EPROTONOSUPPORT;
+	if (bytes < expected_size)
+		return -EMSGSIZE;
+	size = le32_to_cpu(info->struct_size);
+	if (size != expected_size ||
+	    le32_to_cpu(info->loader_size) != MTK_VCP_LOADER_SIZE)
+		return -EPROTO;
+	if (!mtk_vcp_range_valid(le32_to_cpu(info->loader_start),
+				le32_to_cpu(info->loader_size), lower, upper) ||
+	    !mtk_vcp_range_valid(le32_to_cpu(info->firmware_start),
+				le32_to_cpu(info->firmware_size), lower, upper) ||
+	    !mtk_vcp_range_valid(le32_to_cpu(info->dram_start),
+				le32_to_cpu(info->dram_size), lower, upper) ||
+	    !mtk_vcp_range_valid(le32_to_cpu(info->dram_backup_start),
+				le32_to_cpu(info->dram_size), lower, upper))
+		return -ERANGE;
+	return 0;
+}
+/* Vendor hypervisor IOVA_TO_PHYS result, one NS/protected 32-bit half.
+ * Preserve the 35-bit physical address before shifting into the high word.
+ */
+static inline u64 mtk_vcp_shadow_pa(u32 value)
+{
+	return ((u64)(value & 7) << 32) | (value & 0xfffff000U);
+}
+#endif
diff --git a/drivers/soc/mediatek/mtk-vcp.c b/drivers/soc/mediatek/mtk-vcp.c
new file mode 100644
index 0000000000..61f15ba396
--- /dev/null
+++ b/drivers/soc/mediatek/mtk-vcp.c
@@ -0,0 +1,1503 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Bootloader-owned MediaTek VCP transport.
+ *
+ * Register and clock ordering from MediaTek vcp_helper.c, MiCode
+ * MTK_kernel_device_modules 3c4ccd07d5624879555ec710c11bb8818e5cb5c6.
+ * Mailbox and coherent-memory helpers adapted from Silvia's MT6895 VCP
+ * driver, https://github.com/MT6895-Mainline/linux/commit/f1c0c8245d163fece46699612b8322d11e26348d
+ * Local changes: bootloader-owned lifecycle outside remoteproc, exclusive
+ * sessions, MT6897 mailbox/ABI, explicit two-domain PM, retained failure state.
+ * Inspection never releases reset or replaces firmware.
+ */
+#include <linux/arm-smccc.h>
+#include <linux/clk.h>
+#include <linux/completion.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/iommu.h>
+#include <linux/iopoll.h>
+#include <linux/remoteproc/mtk_vcp.h>
+#include <linux/soc/mediatek/mtk_sip_svc.h>
+#include <linux/device.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/pm_domain.h>
+#include <linux/slab.h>
+#include <linux/sizes.h>
+#include <linux/sched/clock.h>
+
+#include "mtk-vcp-platform.h"
+#include "../../media/platform/mediatek/vcodec/vcp/mtk_vcp_vdec_mt6897_abi.h"
+
+#define VCP_CONTROL             MTK_SIP_SMC_CMD(0x52c)
+#define VCP_DAPC_CONTROL        MTK_SIP_SMC_CMD(0x52e)
+#define VCP_RESET_SET           2
+#define VCP_RESET_RELEASE       3
+#define VCP_TCM_SIZE            0x40000
+#define VCP_LOADER_SIZE         0x2000
+#define VCP_REGION_OFFSET       4
+#define VCP_REGION_SIZE         0x38
+#define VCP_MBOX_COUNT          5
+#define VCP_MBOX_SET            0x100
+#define VCP_MBOX_CLR            0x10c
+#define VCP_GIPC_SET            0x98
+#define VCP_SPM_CLR             0x94
+#define VCP_CORE_WDT            0x30
+#define VCP_CORE_SHM_ADDR       0x44
+#define VCP_CORE_SHM_SIZE       0x48
+#define VCP_CORE_REBOOT         0x54
+#define VCP_CORE_STATUS         0x70
+#define VCP_SHM_BASE MTK_VCP_SW_IOVA_START
+#define VCP_SHM_END MTK_VCP_SW_IOVA_END
+#define VCP_ENC_MEM_ALLOC 0x3003
+#define VCP_ENC_MEM_ALLOC_DONE 0x4003
+#define VCP_DEC_MEM_ALLOC 0xc005
+#define VCP_DEC_MEM_ALLOC_DONE 0xd005
+#define VCP_MEM_SHARED 6
+#define VCPDBG(fmt, ...) dev_dbg(vcp->dev, fmt, ##__VA_ARGS__)
+
+struct vcp_message {
+	__le32 id, len;
+	u8 data[MTK_VCP_IPI_MAX_PAYLOAD];
+};
+static_assert(sizeof(struct vcp_message) == 72);
+struct vcp_mbox {
+	struct mtk_vcp *vcp;
+	void __iomem *base;
+	unsigned int index;
+	int irq;
+	bool fault_disabled;
+};
+enum vcp_state { VCP_COLD, VCP_STARTING, VCP_RUNNING, VCP_STOPPING, VCP_PINNED };
+
+
+struct mtk_vcp {
+	struct device *dev;
+	const struct mtk_vcp_platform *platform;
+	void __iomem *sram, *cfg, *core;
+	struct vcp_mbox mbox[VCP_MBOX_COUNT];
+	struct mtk_vcp_mem mem[MTK_VCP_MEM_COUNT], codec_mem;
+	phys_addr_t code_pa_start, code_pa_end;
+	bool metadata_pinned;
+	struct completion ready, logger_ready;
+	struct mtk_vcp_logger_info logger_info;
+	bool logger_initialized;
+	/* Lock order: lifecycle lock, send_lock. IRQ callbacks use handler_lock
+	 * and may send; they must never acquire the lifecycle lock.
+	 */
+	struct mutex send_lock, handler_lock;
+	mtk_vcp_ipi_handler_t handler[MTK_VCP_CODEC_COUNT];
+	void *handler_priv[MTK_VCP_CODEC_COUNT];
+	const void *owner;
+	enum vcp_state state;
+	dma_addr_t shm_lower, shm_upper;
+	int wdt_irq, reserved_irq, boot_error;
+	int last_halt_error, trial_start, trial_stop;
+	unsigned long ready_seen;
+	bool powered, tx_enabled, reset_confirmed, security_enabled, irqs_enabled;
+	bool transport_available, wdt_fault_disabled, reserved_fault_disabled;
+	struct clk_bulk_data clocks[3];
+	struct dev_pm_domain_list *domains;
+	struct device *smi[2];
+	bool smi_active[2];
+	struct mutex lock;
+	int power_error;
+	struct mtk_vcp_region_info metadata;
+	bool metadata_valid;
+};
+
+/* The vendor reads this metadata before the first secure reset, while the
+ * bootloader-owned SRAM image is accessible. Never read protected DRAM or
+ * follow any address contained in the snapshot.
+ */
+static int mtk_vcp_snapshot(struct mtk_vcp *vcp, struct mtk_vcp_region_info *info)
+{
+	int ret, power_ret;
+
+	if (vcp->power_error)
+		return vcp->power_error;
+	ret = pm_runtime_resume_and_get(vcp->domains->pd_devs[0]);
+	if (ret < 0)
+		return ret;
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(vcp->clocks), vcp->clocks);
+	if (ret)
+		goto infra_off;
+	ret = pm_runtime_resume_and_get(vcp->domains->pd_devs[1]);
+	if (ret < 0)
+		goto clocks_off;
+	memcpy_fromio(info, vcp->sram + MTK_VCP_REGION_OFFSET, sizeof(*info));
+	power_ret = pm_runtime_put_sync(vcp->domains->pd_devs[1]);
+	if (power_ret < 0) {
+		/* Restore our ownership reference, retaining clocks and MM_INFRA
+		 * until reboot rather than retrying an uncertain power transition.
+		 */
+		pm_runtime_get_noresume(vcp->domains->pd_devs[1]);
+		ret = power_ret;
+		goto pinned;
+	}
+	ret = 0;
+clocks_off:
+	clk_bulk_disable_unprepare(ARRAY_SIZE(vcp->clocks), vcp->clocks);
+infra_off:
+	power_ret = pm_runtime_put_sync(vcp->domains->pd_devs[0]);
+	if (power_ret < 0) {
+		pm_runtime_get_noresume(vcp->domains->pd_devs[0]);
+		ret = power_ret;
+		goto pinned;
+	}
+	return ret;
+pinned:
+	vcp->power_error = ret;
+	__module_get(THIS_MODULE);
+	dev_err(vcp->dev,
+		"power release failed (%d); retain resources until reboot\n", ret);
+	return ret;
+}
+
+/* The secure reset can close SRAM access. Cache the validated bootloader
+ * snapshot before any lifecycle operation; never re-read it behind a reset.
+ */
+static int mtk_vcp_metadata(struct mtk_vcp *vcp, struct mtk_vcp_region_info *info)
+{
+	int ret;
+
+	if (vcp->metadata_valid) {
+		*info = vcp->metadata;
+		return 0;
+	}
+	ret = mtk_vcp_snapshot(vcp, info);
+	if (ret)
+		return ret;
+	ret = mtk_vcp_validate_region(info, sizeof(*info),
+				      vcp->platform->region_size,
+				      vcp->platform->code_start,
+				      vcp->platform->code_end);
+	if (ret)
+		return ret;
+	vcp->metadata = *info;
+	vcp->metadata_valid = true;
+	return 0;
+}
+
+static ssize_t metadata_show(struct device *dev, struct device_attribute *attr,
+			     char *buf)
+{
+	struct mtk_vcp *vcp = dev_get_drvdata(dev);
+	struct mtk_vcp_region_info info;
+	int ret;
+
+	mutex_lock(&vcp->lock);
+	ret = mtk_vcp_metadata(vcp, &info);
+	mutex_unlock(&vcp->lock);
+	if (ret)
+		return ret;
+	return sysfs_emit(buf,
+		"region_size=%#x\nloader=%#x size=%#x\nfirmware=%#x size=%#x\n"
+		"dram=%#x size=%#x backup=%#x\nloader_pa=%#x\n",
+		le32_to_cpu(info.struct_size), le32_to_cpu(info.loader_start),
+		le32_to_cpu(info.loader_size), le32_to_cpu(info.firmware_start),
+		le32_to_cpu(info.firmware_size), le32_to_cpu(info.dram_start),
+		le32_to_cpu(info.dram_size), le32_to_cpu(info.dram_backup_start),
+		le32_to_cpu(info.loader_start_pa));
+}
+static DEVICE_ATTR_ADMIN_RO(metadata);
+
+/* Read-only GenieZone shadow-table query, from vendor mtk_iommu.c
+ * mtee_iova_to_phys(), MiCode 3c4ccd07. Arguments are IOVA low/high and
+ * table ID 0; this neither installs mappings nor reads the pointed-to RAM.
+ */
+#define MTK_VCP_IOVA_TO_PHYS 0xbb00ffa6
+static ssize_t code_mappings_show(struct device *dev,
+				 struct device_attribute *attr, char *buf)
+{
+	struct mtk_vcp *vcp = dev_get_drvdata(dev);
+	struct mtk_vcp_region_info info;
+	struct arm_smccc_res res;
+	u64 start[4], size[4], iova, raw;
+	ssize_t written = 0;
+	unsigned int region, edge;
+	int ret;
+
+	mutex_lock(&vcp->lock);
+	ret = mtk_vcp_metadata(vcp, &info);
+	if (ret) {
+		written = ret;
+		goto out;
+	}
+	start[0] = mtk_vcp_unpack_iova(le32_to_cpu(info.loader_start));
+	start[1] = mtk_vcp_unpack_iova(le32_to_cpu(info.firmware_start));
+	start[2] = mtk_vcp_unpack_iova(le32_to_cpu(info.dram_start));
+	start[3] = mtk_vcp_unpack_iova(le32_to_cpu(info.dram_backup_start));
+	size[0] = le32_to_cpu(info.loader_size);
+	size[1] = le32_to_cpu(info.firmware_size);
+	size[2] = size[3] = le32_to_cpu(info.dram_size);
+	for (region = 0; region < 4; region++) {
+		for (edge = 0; edge < 2; edge++) {
+			u32 ns, protected;
+
+			/* Exactly eight validated first/last-page queries. */
+			iova = (start[region] + (edge ? size[region] - 1 : 0)) & ~0xfffULL;
+			arm_smccc_smc(MTK_VCP_IOVA_TO_PHYS, lower_32_bits(iova),
+				      upper_32_bits(iova), 0, 0, 0, 0, 0, &res);
+			raw = res.a0;
+			if ((long)res.a0 == SMCCC_RET_NOT_SUPPORTED ||
+			    raw == 0xffffffffULL) {
+				dev_err(dev, "shadow query unsupported: iova=%#llx raw=%#llx\n",
+					iova, raw);
+				written = -EOPNOTSUPP;
+				goto out;
+			}
+			ns = lower_32_bits(raw);
+			protected = upper_32_bits(raw);
+			written += sysfs_emit_at(buf, written,
+				"region=%u edge=%u iova=%#llx raw=%#llx "
+				"ns_pa=%#llx ns_type=%u ns_level=%u ns_sr=%u "
+				"prot_pa=%#llx prot_type=%u prot_level=%u prot_sr=%u\n",
+				region, edge, iova, raw, mtk_vcp_shadow_pa(ns),
+				(ns >> 8) & 3, (ns >> 10) & 3, (ns >> 3) & 31,
+				mtk_vcp_shadow_pa(protected), (protected >> 8) & 3,
+				(protected >> 10) & 3, (protected >> 3) & 31);
+		}
+	}
+out:
+	mutex_unlock(&vcp->lock);
+	return written;
+}
+static DEVICE_ATTR_ADMIN_RO(code_mappings);
+
+static ssize_t ready_trial_store(struct device *dev,
+	struct device_attribute *attr, const char *buf, size_t count);
+static DEVICE_ATTR(ready_trial, 0200, NULL, ready_trial_store);
+static ssize_t trial_result_show(struct device *dev,
+	struct device_attribute *attr, char *buf)
+{
+	struct mtk_vcp *vcp = dev_get_drvdata(dev);
+	ssize_t ret;
+
+	mutex_lock(&vcp->lock);
+	ret = sysfs_emit(buf, "start=%d stop=%d halt=%d state=%u ready_mask=%#lx\n",
+		vcp->trial_start, vcp->trial_stop, vcp->last_halt_error,
+		vcp->state, READ_ONCE(vcp->ready_seen));
+	mutex_unlock(&vcp->lock);
