+	mtk_crtc_finish_page_flip(&context);
+	return NULL;
+}
+int main(void)
+{
+	assert(pthread_mutex_init(&context.hw_lock, NULL) == 0);
+	assert(pthread_mutex_init(&context.config_lock, NULL) == 0);
+	assert(pthread_mutex_init(&drm.event_lock, NULL) == 0);
+	private.data = (void *)&data;
+	drm.dev_private = &private;
+	context.base.dev = &drm;
+	context.base.base.id = 63;
+	context.hwlayers = layers;
+	context.hwlayer_nr = 2;
+	context.ddp_comp_nr = 1;
+	for (int i = 0; i < 2; i++)
+		layers[i].plane =
+			(struct drm_plane){ .state = &planes[i], .index = i };
+	comp.dev = &engine;
+	components[0] = &comp;
+	context.ddp_comp = components;
+	controller.dev = &gce;
+	channel.mbox = (void *)&controller;
+	context.cmdq_client.chan = &channel;
+	struct drm_atomic_commit commit = { .new_state = &state.base };
+	struct drm_pending_vblank_event owned = { .id = 0 },
+					incoming = { .id = 1 };
+
+	reset();
+	fail_flush = 1;
+	state.base.color_mgmt_changed = true;
+	mtk_crtc_atomic_flush(&context.base, &commit);
+	assert(packet_writes == 0 && config_calls == 0 && gamma_calls == 0 &&
+	       ctm_calls == 0);
+	assert(context.cmdq_handle.cmd_buf_size == 128 &&
+	       planes[0].pending.dirty);
+	retained();
+	for (int fail = 1; fail <= 2; fail++) {
+		reset();
+		fail_flush = fail;
+		events(&owned, &incoming);
+		mtk_crtc_atomic_disable(&context.base, &commit);
+		assert(atomic_load(&sent[0]) == 1 &&
+		       atomic_load(&sent[1]) == 1);
+		assert(vblank_refs == 0 && vblank_puts == 1);
+		assert(context.cmdq_vblank_cnt == 3);
+		retained();
+	}
+	reset();
+	zero_wait = true;
+	mtk_crtc_atomic_disable(&context.base, &commit);
+	assert(flush_calls == 2 && fini_calls == 1 && !context.enabled);
+	assert(target_refs == 0 && root_refs == 0 && gce.refs == 0 &&
+	       !context.config_updating);
+	assert(gets == vblank_puts && vblank_refs == 0);
+	mtk_crtc_atomic_enable(&context.base, &commit);
+	assert(context.enabled && target_refs == 3 && root_refs == 1 &&
+	       init_calls == 1);
+	reset();
+	callback_on_flush = true;
+	planes[0].pending.dirty = false;
+	planes[0].pending.config = true;
+	context.pending_planes = true;
+	mtk_crtc_atomic_flush(&context.base, &commit);
+	assert(pending_observed && state.pending_config &&
+	       planes[0].pending.config && !context.config_updating);
+	assert(packet_active && gce.refs == 1);
+	reset();
+	pm_error = -EIO;
+	mtk_crtc_atomic_flush(&context.base, &commit);
+	retained();
+	reset();
+	submit_error = -ENOBUFS;
+	mtk_crtc_atomic_flush(&context.base, &commit);
+	assert(gce.refs == 0);
+	retained();
+	reset();
+	events(&owned, &owned);
+	mutex_lock(&context.hw_lock);
+	mtk_crtc_cmdq_fault_locked(&context, "test", -EIO, NULL);
+	mutex_unlock(&context.hw_lock);
+	assert(sent[0] == 1 && vblank_puts == 1 && vblank_refs == 0);
+	state.base.event = &incoming;
+	mtk_crtc_atomic_begin(&context.base, &commit);
+	assert(sent[1] == 1 && gets == 0 && vblank_puts == 1);
+	reset();
+	state.base.event = &incoming;
+	mtk_crtc_atomic_begin(&context.base, &commit);
+	assert(gets == 1 && context.event == &incoming &&
+	       state.base.event == NULL);
+	mutex_lock(&context.hw_lock);
+	mtk_crtc_cmdq_fault_locked(&context, "test", -EIO, NULL);
+	mutex_unlock(&context.hw_lock);
+	assert(sent[1] == 1 && vblank_puts == 1 && vblank_refs == 0);
+	reset();
+	events(&owned, &incoming);
+	pthread_t first, second;
+	assert(pthread_barrier_init(&barrier, NULL, 2) == 0);
+	assert(pthread_create(&first, NULL, fault_worker, NULL) == 0);
+	assert(pthread_create(&second, NULL, event_worker, NULL) == 0);
+	assert(pthread_join(first, NULL) == 0 &&
+	       pthread_join(second, NULL) == 0);
+	assert(sent[0] == 1 && sent[1] == 1 && vblank_puts == 1 &&
+	       vblank_refs == 0);
+	assert(pthread_barrier_destroy(&barrier) == 0);
+	/* Already-checked commits can carry a state different from crtc->state. */
+	for (int alias = 0; alias < 2; alias++) {
+		for (int operation = 0; operation < 4; operation++) {
+			reset();
+			struct drm_pending_vblank_event queued = { .id = 2 };
+			struct mtk_crtc_state swapped = {
+				.base.event = alias ? &owned : &queued
+			};
+			events(&owned, &incoming);
+			atomic_store(&context.cmdq_faulted, true);
+			commit.new_state = &swapped.base;
+			if (operation == 0)
+				mtk_crtc_atomic_begin(&context.base, &commit);
+			if (operation == 1)
+				mtk_crtc_atomic_enable(&context.base, &commit);
+			if (operation == 2)
+				mtk_crtc_atomic_disable(&context.base, &commit);
+			if (operation == 3)
+				mtk_crtc_atomic_flush(&context.base, &commit);
+			assert(sent[0] == 1 && sent[1] == 1 &&
+			       sent[2] == !alias);
+			assert(vblank_puts == 1 && vblank_refs == 0 &&
+			       gets == 0);
+			assert(!context.event && !state.base.event &&
+			       !swapped.base.event);
+			assert(flush_calls == 0 && fini_calls == 0 &&
+			       power_calls == 0);
+		}
+		reset();
+		fail_flush = 1;
+		struct drm_pending_vblank_event queued = { .id = 2 };
+		struct mtk_crtc_state swapped = {
+			.base.event = alias ? &owned : &queued
+		};
+		events(&owned, &incoming);
+		commit.new_state = &swapped.base;
+		mtk_crtc_atomic_disable(&context.base, &commit);
+		assert(sent[0] == 1 && sent[1] == 1 && sent[2] == !alias);
+		assert(vblank_puts == 1 && vblank_refs == 0 &&
+		       !swapped.base.event);
+		assert(context.enabled && target_refs == 3 && root_refs == 1);
+	}
+	commit.new_state = &state.base;
+	reset();
+	context.cmdq_checked_stop = false;
+	zero_wait = true;
+	mtk_crtc_atomic_disable(&context.base, &commit);
+	assert(!atomic_load(&context.cmdq_faulted) && !context.enabled &&
+	       fini_calls == 1);
+	assert(flush_calls == 1 && target_refs == 0 && root_refs == 0);
+	assert(pthread_mutex_destroy(&context.hw_lock) == 0);
+	assert(pthread_mutex_destroy(&context.config_lock) == 0);
+	assert(pthread_mutex_destroy(&drm.event_lock) == 0);
+	puts("CRTC stop ordering, target retention, callback coordination, event balance and future guards passed");
+	return 0;
+}
