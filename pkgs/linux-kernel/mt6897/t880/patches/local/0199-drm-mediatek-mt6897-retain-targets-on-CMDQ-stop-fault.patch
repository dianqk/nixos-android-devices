+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Exercise production CRTC checked-stop power retention with host mocks."""
+from pathlib import Path
+import os
+import re
+import subprocess
+import tempfile
+
+assets = Path(__file__).resolve().parent
+repo = Path(os.environ.get('KERNEL_SRC', str(assets.parents[3])))
+source = (repo / 'drivers/gpu/drm/mediatek/mtk_crtc.c').read_text()
+
+
+def function(name):
+    match = re.search(r'^(?:static )?(?:int|void|bool) ' + name + r'\(', source, re.M)
+    start = match.start()
+    end = source.index('{', start) + 1
+    depth = 1
+    while depth:
+        depth += (source[end] == '{') - (source[end] == '}')
+        end += 1
+    return source[start:end]
+
+
+soc = (repo / 'drivers/gpu/drm/mediatek/mtk_drm_drv.c').read_text()
+assert soc.count('.cmdq_checked_stop = true') == 4
+stop = function('mtk_crtc_cmdq_stop_locked')
+assert stop.index('mtk_crtc_set_config_updating') < stop.index('mbox_flush')
+worker = function('mtk_crtc_update_config_locked')
+assert worker.index('mtk_crtc_cmdq_stop_locked') < worker.index('mtk_ddp_gamma_set') < worker.index('pending.config = true') < worker.index('cmd_buf_size = 0')
+shutdown = function('mtk_crtc_atomic_disable')
+checked = shutdown.split('if (mtk_crtc->cmdq_checked_stop && mtk_crtc->cmdq_client.chan)', 1)[1].split('} else if', 1)[0]
+assert checked.index('mtk_crtc_cmdq_stop_locked') < checked.index('cmdq_vblank_cnt = 0')
+assert shutdown.index('mtk_crtc_cmdq_stop_locked') < shutdown.index('mtk_crtc_ddp_hw_fini')
+callback = source[source.index('static void ddp_cmdq_cb('):source.index('\n#endif', source.index('static void ddp_cmdq_cb('))]
+assert callback.index('mtk_crtc_faulted') < callback.index('state = to_mtk_crtc_state')
+production = '\n'.join(function(name) for name in [
+    'mtk_crtc_faulted', 'mtk_crtc_finish_page_flip', 'mtk_crtc_fault_events',
+    'mtk_crtc_set_config_updating', 'mtk_crtc_cmdq_fault_locked',
+    'mtk_crtc_cmdq_stop_locked', 'mtk_crtc_update_config_locked',
+    'mtk_crtc_update_config', 'mtk_crtc_atomic_enable', 'mtk_crtc_atomic_disable',
+    'mtk_crtc_send_unowned_event', 'mtk_crtc_atomic_begin', 'mtk_crtc_atomic_flush',
+    'mtk_crtc_atomic_check', 'mtk_crtc_plane_check', 'mtk_crtc_plane_disable',
+    'mtk_crtc_async_update', 'mtk_crtc_ddp_irq'])
+with tempfile.TemporaryDirectory(prefix='mtk-crtc-stop-') as tmp:
+    tmp = Path(tmp)
+    c = tmp / 'test.c'
+    c.write_text((assets / 'crtc_stop_cases.c').read_text().replace('/* PRODUCTION */', production))
+    binary = tmp / 'test'
+    subprocess.run([os.environ.get('CC', 'cc'), '-std=gnu11', '-Wall', '-Wextra',
+                    '-Wno-unused-parameter', '-Wno-sign-compare', '-Werror', '-g', '-pthread',
+                    '-fsanitize=address,undefined', str(c), '-o', str(binary)], check=True)
+    subprocess.run([str(binary)], check=True)
