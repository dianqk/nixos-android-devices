From 76ad3076c50e04aaae34ab439ec6640ed480e552 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Sat, 7 Nov 2026 03:13:56 +0800
Subject: [PATCH] drm/mediatek: retain MT6897 target ownership on unverified
 CMDQ stop

Check MT6897 CMDQ stop before pending-state changes, gamma/CTM writes and packet reuse, and unconditionally before target teardown even when the vblank countdown has expired. Coordinate old callbacks across flush so they cannot clear newly swapped pending state.

An uncertain stop or submission latches a CRTC fault under hardware serialization. Keep component/mutex/PM ownership and enabled state, reject future atomic checks, and block CRTC-owned queued MMIO, reacquisition, teardown and packet reuse. Complete owned and incoming current/passed-state events exactly once, returning only the vblank reference actually acquired.

Keep healthy non-MT6897 behavior. Add extracted-function sanitizer tests for stop ordering, target reference retention, callback coordination, event aliases/nonblocking swapped states and host event races. This is target-power retention, not cancellation of independent bridge callbacks or repair of framebuffer retirement/manual unbind after hardware faults.
---
 drivers/gpu/drm/mediatek/mtk_crtc.c           | 305 ++++++++-
 drivers/gpu/drm/mediatek/mtk_drm_drv.c        |   4 +
 drivers/gpu/drm/mediatek/mtk_drm_drv.h        |   1 +
 tools/testing/selftests/mtk_clk/Makefile      |   4 +-
 .../selftests/mtk_clk/crtc_stop_cases.c       | 595 ++++++++++++++++++
 .../selftests/mtk_clk/test_crtc_stop.py       |  54 ++
 6 files changed, 930 insertions(+), 33 deletions(-)
 create mode 100644 tools/testing/selftests/mtk_clk/crtc_stop_cases.c
 create mode 100755 tools/testing/selftests/mtk_clk/test_crtc_stop.py

diff --git a/drivers/gpu/drm/mediatek/mtk_crtc.c b/drivers/gpu/drm/mediatek/mtk_crtc.c
index cf3b0b6ae1..fee36ff643 100644
--- a/drivers/gpu/drm/mediatek/mtk_crtc.c
+++ b/drivers/gpu/drm/mediatek/mtk_crtc.c
@@ -83,6 +83,9 @@ struct mtk_crtc_hw_layer {
 struct mtk_crtc {
 	struct drm_crtc			base;
 	bool				enabled;
+	bool				cmdq_checked_stop;
+	bool				cmdq_faulted;
+	bool				event_vblank_ref;
 	u8				*controller_idmap;
 	u8				num_controllers;
 
@@ -141,18 +144,109 @@ static inline struct mtk_crtc_state *to_mtk_crtc_state(struct drm_crtc_state *s)
 	return container_of(s, struct mtk_crtc_state, base);
 }
 
+static bool mtk_crtc_faulted(struct mtk_crtc *mtk_crtc)
+{
+	return READ_ONCE(mtk_crtc->cmdq_faulted);
+}
+
 static void mtk_crtc_finish_page_flip(struct mtk_crtc *mtk_crtc)
 {
 	struct drm_crtc *crtc = &mtk_crtc->base;
 	unsigned long flags;
+	bool put = false;
 
+	spin_lock_irqsave(&crtc->dev->event_lock, flags);
 	if (mtk_crtc->event) {
-		spin_lock_irqsave(&crtc->dev->event_lock, flags);
 		drm_crtc_send_vblank_event(crtc, mtk_crtc->event);
-		drm_crtc_vblank_put(crtc);
+		put = !mtk_crtc->cmdq_checked_stop || mtk_crtc->event_vblank_ref;
 		mtk_crtc->event = NULL;
-		spin_unlock_irqrestore(&crtc->dev->event_lock, flags);
+		mtk_crtc->event_vblank_ref = false;
+	}
+	spin_unlock_irqrestore(&crtc->dev->event_lock, flags);
+	if (put)
+		drm_crtc_vblank_put(crtc);
+}
+
+/* Fault completion only: it does not prove pending scanout/FB retirement. */
+static void mtk_crtc_fault_events(struct mtk_crtc *mtk_crtc,
+				  struct drm_crtc_state *passed)
+{
+	struct drm_crtc *crtc = &mtk_crtc->base;
+	struct drm_pending_vblank_event *owned, *incoming, *queued;
+	unsigned long flags;
+	bool put;
+
+	spin_lock_irqsave(&crtc->dev->event_lock, flags);
+	owned = mtk_crtc->event;
+	incoming = crtc->state ? crtc->state->event : NULL;
+	queued = passed && passed != crtc->state ? passed->event : NULL;
+	put = owned && mtk_crtc->event_vblank_ref;
+	mtk_crtc->event = NULL;
+	mtk_crtc->event_vblank_ref = false;
+	if (crtc->state)
+		crtc->state->event = NULL;
+	if (passed)
+		passed->event = NULL;
+	if (owned)
+		drm_crtc_send_vblank_event(crtc, owned);
+	if (incoming && incoming != owned)
+		drm_crtc_send_vblank_event(crtc, incoming);
+	if (queued && queued != owned && queued != incoming)
+		drm_crtc_send_vblank_event(crtc, queued);
+	spin_unlock_irqrestore(&crtc->dev->event_lock, flags);
+	if (put)
+		drm_crtc_vblank_put(crtc);
+}
+
+static void mtk_crtc_set_config_updating(struct mtk_crtc *mtk_crtc, bool updating)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&mtk_crtc->config_lock, flags);
+	mtk_crtc->config_updating = updating;
+	spin_unlock_irqrestore(&mtk_crtc->config_lock, flags);
+}
+
+#if IS_REACHABLE(CONFIG_MTK_CMDQ)
+static void mtk_crtc_cmdq_fault_locked(struct mtk_crtc *mtk_crtc,
+				      const char *operation, int error,
+				      struct drm_crtc_state *passed)
+{
+	unsigned long flags;
+
+	lockdep_assert_held(&mtk_crtc->hw_lock);
+	WRITE_ONCE(mtk_crtc->cmdq_faulted, true);
+	spin_lock_irqsave(&mtk_crtc->config_lock, flags);
+	mtk_crtc->config_updating = false;
+	mtk_crtc->pending_needs_vblank = false;
+	spin_unlock_irqrestore(&mtk_crtc->config_lock, flags);
+	/* Never hold config_lock across callbacks or event/vblank completion. */
+	mtk_crtc_fault_events(mtk_crtc, passed);
+	drm_err(mtk_crtc->base.dev,
+		"[CRTC:%d] CMDQ %s failed: %d; target ownership retained, reboot required\n",
+		mtk_crtc->base.base.id, operation, error);
+}
+
+#endif
+
+static int mtk_crtc_cmdq_stop_locked(struct mtk_crtc *mtk_crtc,
+				     struct drm_crtc_state *passed)
+{
+	int ret = 0;
+
+	lockdep_assert_held(&mtk_crtc->hw_lock);
+	if (mtk_crtc_faulted(mtk_crtc))
+		return -EIO;
+#if IS_REACHABLE(CONFIG_MTK_CMDQ)
+	if (mtk_crtc->cmdq_checked_stop && mtk_crtc->cmdq_client.chan) {
+		/* Suppress old callbacks clearing the newly swapped pending state. */
+		mtk_crtc_set_config_updating(mtk_crtc, true);
+		ret = mbox_flush(mtk_crtc->cmdq_client.chan, 2000);
+		if (ret < 0)
+			mtk_crtc_cmdq_fault_locked(mtk_crtc, "stop", ret, passed);
 	}
+#endif
+	return ret;
 }
 
 static void mtk_drm_finish_page_flip(struct mtk_crtc *mtk_crtc)
@@ -265,6 +359,9 @@ static void mtk_crtc_mode_set_nofb(struct drm_crtc *crtc)
 {
 	struct mtk_crtc_state *state = to_mtk_crtc_state(crtc->state);
 
+	if (mtk_crtc_faulted(to_mtk_crtc(crtc)))
+		return;
+
 	state->pending_width = crtc->mode.hdisplay;
 	state->pending_height = crtc->mode.vdisplay;
 	state->pending_vrefresh = drm_mode_vrefresh(&crtc->mode);
@@ -330,7 +427,7 @@ static void ddp_cmdq_cb(struct mbox_client *cl, void *mssg)
 	pm_runtime_mark_last_busy(cmdq_cl->chan->mbox->dev);
 	pm_runtime_put_autosuspend(cmdq_cl->chan->mbox->dev);
 
-	if (data->sta < 0)
+	if (data->sta < 0 || mtk_crtc_faulted(mtk_crtc))
 		return;
 
 	state = to_mtk_crtc_state(mtk_crtc->base.state);
@@ -896,22 +993,35 @@ static void mtk_crtc_ddp_config(struct drm_crtc *crtc,
 	}
 }
 
-static void mtk_crtc_update_config(struct mtk_crtc *mtk_crtc, bool needs_vblank)
+static void mtk_crtc_update_config_locked(struct mtk_crtc *mtk_crtc, bool needs_vblank,
+					  bool color_mgmt, bool stopped,
+					  struct drm_crtc_state *passed)
 {
 #if IS_REACHABLE(CONFIG_MTK_CMDQ)
 	struct cmdq_pkt *cmdq_handle = &mtk_crtc->cmdq_handle;
+	int ret;
 #endif
 	struct drm_crtc *crtc = &mtk_crtc->base;
 	struct mtk_drm_private *priv = crtc->dev->dev_private;
 	unsigned int pending_planes = 0, pending_async_planes = 0;
 	int i;
-	unsigned long flags;
 
-	mutex_lock(&mtk_crtc->hw_lock);
+	lockdep_assert_held(&mtk_crtc->hw_lock);
+	if (mtk_crtc_faulted(mtk_crtc)) {
+		mtk_crtc_fault_events(mtk_crtc, passed);
+		return;
+	}
+	/* Checked stop precedes pending-state mutation, MMIO and packet reuse. */
+	if (mtk_crtc->cmdq_checked_stop && !stopped &&
+	    mtk_crtc_cmdq_stop_locked(mtk_crtc, passed))
+		return;
+	if (color_mgmt && crtc->state->color_mgmt_changed)
+		for (i = 0; i < mtk_crtc->ddp_comp_nr; i++) {
+			mtk_ddp_gamma_set(mtk_crtc->ddp_comp[i], crtc->state);
+			mtk_ddp_ctm_set(mtk_crtc->ddp_comp[i], crtc->state);
+		}
 
-	spin_lock_irqsave(&mtk_crtc->config_lock, flags);
-	mtk_crtc->config_updating = true;
-	spin_unlock_irqrestore(&mtk_crtc->config_lock, flags);
+	mtk_crtc_set_config_updating(mtk_crtc, true);
 
 	if (needs_vblank)
 		mtk_crtc->pending_needs_vblank = true;
@@ -947,7 +1057,8 @@ static void mtk_crtc_update_config(struct mtk_crtc *mtk_crtc, bool needs_vblank)
 	}
 #if IS_REACHABLE(CONFIG_MTK_CMDQ)
 	if (mtk_crtc->cmdq_client.chan) {
-		mbox_flush(mtk_crtc->cmdq_client.chan, 2000);
+		if (!mtk_crtc->cmdq_checked_stop)
+			mbox_flush(mtk_crtc->cmdq_client.chan, 2000);
 		cmdq_handle->cmd_buf_size = 0;
 		cmdq_pkt_clear_event(cmdq_handle, mtk_crtc->cmdq_event);
 		cmdq_pkt_wfe(cmdq_handle, mtk_crtc->cmdq_event, false);
@@ -966,25 +1077,38 @@ static void mtk_crtc_update_config(struct mtk_crtc *mtk_crtc, bool needs_vblank)
 		 */
 		mtk_crtc->cmdq_vblank_cnt = 3;
 
-		spin_lock_irqsave(&mtk_crtc->config_lock, flags);
-		mtk_crtc->config_updating = false;
-		spin_unlock_irqrestore(&mtk_crtc->config_lock, flags);
+		mtk_crtc_set_config_updating(mtk_crtc, false);
 
-		if (pm_runtime_resume_and_get(mtk_crtc->cmdq_client.chan->mbox->dev) < 0)
+		ret = pm_runtime_resume_and_get(mtk_crtc->cmdq_client.chan->mbox->dev);
+		if (ret < 0) {
+			if (mtk_crtc->cmdq_checked_stop)
+				mtk_crtc_cmdq_fault_locked(mtk_crtc, "submit PM", ret, passed);
 			goto update_config_out;
+		}
 
-		mbox_send_message(mtk_crtc->cmdq_client.chan, cmdq_handle);
+		ret = mbox_send_message(mtk_crtc->cmdq_client.chan, cmdq_handle);
+		if (ret < 0 && mtk_crtc->cmdq_checked_stop) {
+			pm_runtime_mark_last_busy(mtk_crtc->cmdq_client.chan->mbox->dev);
+			pm_runtime_put_autosuspend(mtk_crtc->cmdq_client.chan->mbox->dev);
+			mtk_crtc_cmdq_fault_locked(mtk_crtc, "submit", ret, passed);
+			goto update_config_out;
+		}
 		mbox_client_txdone(mtk_crtc->cmdq_client.chan, 0);
 		goto update_config_out;
 	}
 #endif
-	spin_lock_irqsave(&mtk_crtc->config_lock, flags);
-	mtk_crtc->config_updating = false;
-	spin_unlock_irqrestore(&mtk_crtc->config_lock, flags);
+	mtk_crtc_set_config_updating(mtk_crtc, false);
 
 #if IS_REACHABLE(CONFIG_MTK_CMDQ)
 update_config_out:
+	return;
 #endif
+}
+
+static void mtk_crtc_update_config(struct mtk_crtc *mtk_crtc, bool needs_vblank)
+{
+	mutex_lock(&mtk_crtc->hw_lock);
+	mtk_crtc_update_config_locked(mtk_crtc, needs_vblank, false, false, NULL);
 	mutex_unlock(&mtk_crtc->hw_lock);
 }
 
@@ -994,6 +1118,9 @@ static void mtk_crtc_ddp_irq(void *data)
 	struct mtk_crtc *mtk_crtc = to_mtk_crtc(crtc);
 	struct mtk_drm_private *priv = crtc->dev->dev_private;
 
+	if (mtk_crtc_faulted(mtk_crtc))
+		return;
+
 #if IS_REACHABLE(CONFIG_MTK_CMDQ)
 	struct drm_device *dev = mtk_crtc->base.dev;
 	if (!priv->data->shadow_register && !mtk_crtc->cmdq_client.chan)
@@ -1013,6 +1140,9 @@ static int mtk_crtc_enable_vblank(struct drm_crtc *crtc)
 	struct mtk_crtc *mtk_crtc = to_mtk_crtc(crtc);
 	struct mtk_ddp_comp *comp = mtk_crtc->ddp_comp[mtk_crtc->vblank_comp_idx];
 
+	if (mtk_crtc_faulted(mtk_crtc))
+		return -EIO;
+
 	mtk_ddp_comp_enable_vblank(comp);
 
 	return 0;
@@ -1023,6 +1153,9 @@ static void mtk_crtc_disable_vblank(struct drm_crtc *crtc)
 	struct mtk_crtc *mtk_crtc = to_mtk_crtc(crtc);
 	struct mtk_ddp_comp *comp = mtk_crtc->ddp_comp[mtk_crtc->vblank_comp_idx];
 
+	if (mtk_crtc_faulted(mtk_crtc))
+		return;
+
 	mtk_ddp_comp_disable_vblank(comp);
 }
 
@@ -1076,6 +1209,9 @@ int mtk_crtc_plane_check(struct drm_crtc *crtc, struct drm_plane *plane,
 	u8 *layer_stages = hwlayer->layer_stages;
 	int i, ret;
 
+	if (mtk_crtc_faulted(mtk_crtc))
+		return -EIO;
+
 	for (i = 0; i < hwlayer->layer_stages_nr; i++) {
 		struct mtk_ddp_comp *comp = mtk_crtc->ddp_comp[layer_stages[i]];
 
@@ -1098,8 +1234,16 @@ void mtk_crtc_plane_disable(struct drm_crtc *crtc, struct drm_plane *plane)
 	if (!mtk_crtc->cmdq_client.chan)
 		return;
 
-	if (!mtk_crtc->enabled)
+	mutex_lock(&mtk_crtc->hw_lock);
+	if (!mtk_crtc->enabled || mtk_crtc_faulted(mtk_crtc)) {
+		mutex_unlock(&mtk_crtc->hw_lock);
+		return;
+	}
+
+	if (mtk_crtc->cmdq_checked_stop && mtk_crtc_cmdq_stop_locked(mtk_crtc, NULL)) {
+		mutex_unlock(&mtk_crtc->hw_lock);
 		return;
+	}
 
 	/* set pending plane state to disabled */
 	for (i = 0; i < mtk_crtc->hwlayer_nr; i++) {
@@ -1111,7 +1255,11 @@ void mtk_crtc_plane_disable(struct drm_crtc *crtc, struct drm_plane *plane)
 			break;
 		}
 	}
-	mtk_crtc_update_config(mtk_crtc, false);
+	mtk_crtc_update_config_locked(mtk_crtc, false, false,
+				      mtk_crtc->cmdq_checked_stop, NULL);
+	mutex_unlock(&mtk_crtc->hw_lock);
+	if (mtk_crtc_faulted(mtk_crtc))
+		return;
 
 	/* wait for planes to be disabled by CMDQ */
 	wait_event_timeout(mtk_crtc->cb_blocking_queue,
@@ -1124,27 +1272,39 @@ void mtk_crtc_async_update(struct drm_crtc *crtc, struct drm_plane *plane,
 			   struct drm_atomic_commit *state)
 {
 	struct mtk_crtc *mtk_crtc = to_mtk_crtc(crtc);
+	struct drm_crtc_state *passed = drm_atomic_get_new_crtc_state(state, crtc);
 
-	if (!mtk_crtc->enabled)
-		return;
-
-	mtk_crtc_update_config(mtk_crtc, false);
+	mutex_lock(&mtk_crtc->hw_lock);
+	if (mtk_crtc->enabled && !mtk_crtc_faulted(mtk_crtc))
+		mtk_crtc_update_config_locked(mtk_crtc, false, false, false,
+				      passed);
+	mutex_unlock(&mtk_crtc->hw_lock);
 }
 
 static void mtk_crtc_atomic_enable(struct drm_crtc *crtc,
 				   struct drm_atomic_commit *state)
 {
 	struct mtk_crtc *mtk_crtc = to_mtk_crtc(crtc);
+	struct drm_crtc_state *passed = drm_atomic_get_new_crtc_state(state, crtc);
 	struct mtk_ddp_comp *comp = mtk_crtc->ddp_comp[mtk_crtc->config_comp_idx];
 	struct drm_device *dev = mtk_crtc->base.dev;
 	int ret;
 
 	drm_dbg_driver(dev, "%s %d\n", __func__, crtc->base.id);
+	if (mtk_crtc->cmdq_checked_stop) {
+		mutex_lock(&mtk_crtc->hw_lock);
+		if (mtk_crtc_faulted(mtk_crtc)) {
+			mtk_crtc_fault_events(mtk_crtc, passed);
+			goto out_unlock;
+		}
+		if (mtk_crtc->enabled)
+			goto out_unlock;
+	}
 
 	ret = mtk_ddp_comp_power_on(comp);
 	if (ret < 0) {
 		DRM_DEV_ERROR(comp->dev, "Failed to enable power domain: %d\n", ret);
-		return;
+		goto out_unlock;
 	}
 
 	mtk_crtc_update_output(crtc, state);
@@ -1152,24 +1312,38 @@ static void mtk_crtc_atomic_enable(struct drm_crtc *crtc,
 	ret = mtk_crtc_ddp_hw_init(mtk_crtc);
 	if (ret) {
 		mtk_ddp_comp_power_off(comp);
-		return;
+		goto out_unlock;
 	}
 
 	drm_crtc_vblank_on(crtc);
 	mtk_crtc->enabled = true;
+out_unlock:
+	if (mtk_crtc->cmdq_checked_stop)
+		mutex_unlock(&mtk_crtc->hw_lock);
 }
 
 static void mtk_crtc_atomic_disable(struct drm_crtc *crtc,
 				    struct drm_atomic_commit *state)
 {
 	struct mtk_crtc *mtk_crtc = to_mtk_crtc(crtc);
+	struct drm_crtc_state *passed = drm_atomic_get_new_crtc_state(state, crtc);
 	struct mtk_ddp_comp *comp = mtk_crtc->ddp_comp[mtk_crtc->config_comp_idx];
 	struct drm_device *dev = mtk_crtc->base.dev;
 	int i;
 
 	drm_dbg_driver(dev, "%s %d\n", __func__, crtc->base.id);
+	if (mtk_crtc->cmdq_checked_stop)
+		mutex_lock(&mtk_crtc->hw_lock);
+	if (mtk_crtc_faulted(mtk_crtc)) {
+		mtk_crtc_fault_events(mtk_crtc, passed);
+		goto out_unlock;
+	}
 	if (!mtk_crtc->enabled)
-		return;
+		goto out_unlock;
+
+	if (mtk_crtc->cmdq_checked_stop &&
+	    mtk_crtc_cmdq_stop_locked(mtk_crtc, passed))
+		goto out_unlock;
 
 	/* Set all pending plane state to disabled */
 	for (i = 0; i < mtk_crtc->hwlayer_nr; i++) {
@@ -1182,10 +1356,25 @@ static void mtk_crtc_atomic_disable(struct drm_crtc *crtc,
 	}
 	mtk_crtc->pending_planes = true;
 
-	mtk_crtc_update_config(mtk_crtc, false);
+	if (mtk_crtc->cmdq_checked_stop)
+		mtk_crtc_update_config_locked(mtk_crtc, false, false, true,
+				      passed);
+	else
+		mtk_crtc_update_config(mtk_crtc, false);
+	if (mtk_crtc_faulted(mtk_crtc))
+		goto out_unlock;
 #if IS_REACHABLE(CONFIG_MTK_CMDQ)
-	/* Wait for planes to be disabled by cmdq */
-	if (mtk_crtc->cmdq_client.chan &&
+	if (mtk_crtc->cmdq_checked_stop && mtk_crtc->cmdq_client.chan) {
+		wait_event_timeout(mtk_crtc->cb_blocking_queue,
+				   mtk_crtc->cmdq_vblank_cnt == 0, msecs_to_jiffies(500));
+		/* A zero vblank counter is not proof of thread stop. */
+		if (mtk_crtc_cmdq_stop_locked(mtk_crtc, passed))
+			goto out_unlock;
+		mtk_crtc_set_config_updating(mtk_crtc, false);
+		mtk_crtc->cmdq_vblank_cnt = 0;
+		mtk_crtc->pending_needs_vblank = false;
+		mtk_crtc_finish_page_flip(mtk_crtc);
+	} else if (mtk_crtc->cmdq_client.chan &&
 	    !wait_event_timeout(mtk_crtc->cb_blocking_queue,
 				mtk_crtc->cmdq_vblank_cnt == 0,
 				msecs_to_jiffies(500))) {
@@ -1224,6 +1413,22 @@ static void mtk_crtc_atomic_disable(struct drm_crtc *crtc,
 	mtk_ddp_comp_power_off(comp);
 
 	mtk_crtc->enabled = false;
+out_unlock:
+	if (mtk_crtc->cmdq_checked_stop)
+		mutex_unlock(&mtk_crtc->hw_lock);
+}
+
+static void mtk_crtc_send_unowned_event(struct drm_crtc *crtc,
+				       struct drm_crtc_state *state)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&crtc->dev->event_lock, flags);
+	if (state->event) {
+		drm_crtc_send_vblank_event(crtc, state->event);
+		state->event = NULL;
+	}
+	spin_unlock_irqrestore(&crtc->dev->event_lock, flags);
 }
 
 static void mtk_crtc_atomic_begin(struct drm_crtc *crtc,
@@ -1236,6 +1441,27 @@ static void mtk_crtc_atomic_begin(struct drm_crtc *crtc,
 	struct drm_device *dev = mtk_crtc->base.dev;
 	unsigned long flags;
 
+	if (mtk_crtc->cmdq_checked_stop) {
+		mutex_lock(&mtk_crtc->hw_lock);
+		if (mtk_crtc_faulted(mtk_crtc)) {
+			mtk_crtc_fault_events(mtk_crtc, crtc_state);
+		} else if (crtc_state->event) {
+			if (mtk_crtc->event || drm_crtc_vblank_get(crtc)) {
+				/* Do not overwrite an event/reference already owned. */
+				mtk_crtc_send_unowned_event(crtc, crtc_state);
+			} else {
+				crtc_state->event->pipe = drm_crtc_index(crtc);
+				spin_lock_irqsave(&crtc->dev->event_lock, flags);
+				mtk_crtc->event = crtc_state->event;
