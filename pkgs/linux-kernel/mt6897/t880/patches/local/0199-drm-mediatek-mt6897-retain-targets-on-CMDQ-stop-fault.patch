+					 .pending_config = true };
+	context.base.state = &state.base;
+	context.cmdq_handle.cmd_buf_size = 128;
+	context.cmdq_vblank_cnt = 3;
+	for (int i = 0; i < 2; i++)
+		planes[i] = (struct mtk_plane_state){
+			.pending = { .dirty = true, .enable = true }
+		};
+	gce.refs = 0;
+	target_refs = 3;
+	root_refs = 1;
+	flush_calls = fail_flush = submit_error = pm_error = packet_writes =
+		config_calls = gamma_calls = ctm_calls = irq_calls =
+			fini_calls = init_calls = power_calls = 0;
