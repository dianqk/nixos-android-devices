+static pthread_barrier_t barrier;
+static void *fault_worker(void *arg)
+{
+	pthread_barrier_wait(&barrier);
+	mutex_lock(&context.hw_lock);
+	mtk_crtc_cmdq_fault_locked(&context, "test", -EIO, NULL);
+	mutex_unlock(&context.hw_lock);
+	return NULL;
+}
+static void *event_worker(void *arg)
+{
