From c8dbae55e81d351bfc3efbfaa9c3ad078a15ce8b Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Fri, 6 Nov 2026 19:25:25 +0800
Subject: [PATCH] arm64: dts: mediatek: use forwarded T880 LK modem metadata

U-Boot now copies the actual runtime LK descriptor after validating its
backing reservation. Remove the captured pointer/size/version/tag-count
property so missing firmware metadata cannot masquerade as a live handoff.
Keep the modem platform resources and properties unchanged.

Signed-off-by: dianqk <dianqk@dianqk.net>
---
 arch/arm64/boot/dts/mediatek/mt6897-alldocube-t880.dts | 9 +--------
 1 file changed, 1 insertion(+), 8 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6897-alldocube-t880.dts b/arch/arm64/boot/dts/mediatek/mt6897-alldocube-t880.dts
index a9ff6a3e06..43e3ff822f 100644
--- a/arch/arm64/boot/dts/mediatek/mt6897-alldocube-t880.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6897-alldocube-t880.dts
@@ -198,16 +198,9 @@ memory@40000000 {
 		reg = <0x0 0x40000000 0x0 0x80000000>;
 	};
 
-	/*
-	 * The modem boot information LK writes into the kernel DT (a pointer
-	 * to its tag list at 0xbf2f0000, 0x1840 bytes, version 3, 28 tags).
-	 * U-Boot does not forward it yet; this is the value LK wrote on every
-	 * captured Android boot. Read only by the CCCI LK information module.
-	 */
+	/* U-Boot supplies the runtime LK modem descriptor at OS handover. */
 	mddriver {
 		compatible = "mediatek,mt6897-mddriver", "mediatek,mddriver";
-		ccci,modem_info_v2 = <0x2fbf 0x00 0x40180000 0x00 0x3000000
-				      0x1c000000 0x1000000 0x00 0x00 0x00 0x00 0x00>;
 		/*
 		 * The vendor modem driver's platform data, as the Android
 		 * DT. The driver power-cycles the modem through its power
-- 
2.56.0

