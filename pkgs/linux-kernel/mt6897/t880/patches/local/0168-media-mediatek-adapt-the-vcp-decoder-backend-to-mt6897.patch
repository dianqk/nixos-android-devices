@@ -84,7 +92,20 @@ static void dec_fail(struct mtk_vcp_vdec *d, int error)
 	d->ops->notify(d->priv);
 }
 
-static void *dec_shared(struct mtk_vcp_vdec *d, u32 address, size_t size)
+static void dec_hardware_fail(struct mtk_vcp_vdec *d, u32 id, int error)
+{
+	if (d->hw_error)
+		return;
+	/* Do not complete the RPC: consume its bounded ACK before cleanup
+	 * changes expected, even when firmware acknowledges START with 0.
+	 */
+	d->hw_error = error;
+	dev_err(d->dev, "hardware callback %#x failed: %d; session poisoned\n",
+		id, error);
+	d->ops->notify(d->priv);
+}
+
+static void *dec_shared(struct mtk_vcp_vdec *d, u64 address, size_t size)
 {
 	struct mtk_vcp_mem mem;
 	u32 start, offset;
@@ -92,6 +113,11 @@ static void *dec_shared(struct mtk_vcp_vdec *d, u32 address, size_t size)
 	if (mtk_vcp_get_mem(d->vcp, MTK_VCP_MEM_VDEC, &mem))
 		return ERR_PTR(-EHOSTDOWN);
 	start = mem.dma & 0xfffffff;
+	/* Firmware instances may use a packed 32-bit or full IOVA address.
+	 * Validate the representation before selecting its low-28 SHM window. */
+	if (address > U32_MAX &&
+	    (address < mem.dma || address - mem.dma >= mem.size))
+		return ERR_PTR(-ERANGE);
 	address &= 0xfffffff;
 	if (address < start)
 		return ERR_PTR(-ERANGE);
@@ -104,17 +130,27 @@ static void *dec_shared(struct mtk_vcp_vdec *d, u32 address, size_t size)
 static int dec_memory(struct mtk_vcp_vdec *d, struct vcp_vdec_mem_op *m)
 {
 	struct dec_memory *a;
-	u32 type = le32_to_cpu(m->mem_type), size = le32_to_cpu(m->mem_len);
+	u32 type = le32_to_cpu(m->type), size = le32_to_cpu(m->size);
 	int ret;
 
-	if (le32_to_cpu(m->msg_id) == VCP_VDEC_MEM_FREE) {
+	if (le32_to_cpu(m->id) == VCP_VDEC_MEM_FREE) {
 		list_for_each_entry(a, &d->allocations, list) {
-			if (a->cookie != le64_to_cpu(m->mem_va))
+			if (a->cookie != le64_to_cpu(m->va))
 				continue;
 			if (a->type != type || a->mem.size != size ||
-			    a->mem.dma != le64_to_cpu(m->mem_iova) ||
-			    a->mem.dma != le64_to_cpu(m->mem_pa))
+			    a->mem.dma != le64_to_cpu(m->iova) ||
+			    a->mem.dma != le64_to_cpu(m->pa))
 				return -EINVAL;
+			if (d->hw_error) {
+				/* DEINIT is not proof that a timed-out engine is idle.
+				 * Keep mappings/bookkeeping until confirmed offline
+				 * hardware cleanup permits destroy. Identical repeats
+				 * remain validated and idempotent.
+				 */
+				return 0;
+			}
+			VCPDBG("mem: free type=%u requested=%u dma=%pad cookie=%#llx\n",
+			       type, size, &a->mem.dma, a->cookie);
 			d->ops->free(d->priv, type, &a->mem);
 			d->work_bytes -= size;
 			d->allocation_count--;
@@ -135,11 +171,10 @@ static int dec_memory(struct mtk_vcp_vdec *d, struct vcp_vdec_mem_op *m)
 		goto fail;
 	if (!a->mem.cpu || a->mem.size != size || !a->mem.dma ||
 	    a->mem.dma + size < a->mem.dma ||
-	    (type == 0 && (a->mem.dma < 0x150000000ULL ||
-			 a->mem.dma + size > 0x160000000ULL)) ||
-	    (type == 1 && a->mem.dma + size > 0x400000000ULL) ||
-	    (type == 2 && (a->mem.dma < 0x20000000ULL ||
-			 a->mem.dma + size > 0x32c00000ULL))) {
+	    (type == 0 && (a->mem.dma < 0x140000000ULL ||
+			 a->mem.dma + size > 0x1a0000000ULL)) ||
+	    (type == 1 && a->mem.dma + size > 0x100000000ULL) ||
+	    (type == 2 && a->mem.dma + size > 0x100000000ULL)) {
 		ret = -ERANGE;
 		d->ops->free(d->priv, type, &a->mem);
 		goto fail;
@@ -150,9 +185,11 @@ static int dec_memory(struct mtk_vcp_vdec *d, struct vcp_vdec_mem_op *m)
 	list_add_tail(&a->list, &d->allocations);
 	d->work_bytes += size;
 	d->allocation_count++;
-	m->mem_iova = cpu_to_le64(a->mem.dma);
-	m->mem_pa = m->mem_iova;
-	m->mem_va = cpu_to_le64(a->cookie);
+	m->iova = cpu_to_le64(a->mem.dma);
+	m->pa = m->iova;
+	m->va = cpu_to_le64(a->cookie);
+	VCPDBG("mem: alloc type=%u requested=%u dma=%pad cookie=%#llx\n",
+	       type, size, &a->mem.dma, a->cookie);
 	return 0;
 fail:
 	kfree(a);
@@ -170,20 +207,85 @@ static int dec_push_event(struct mtk_vcp_vdec *d, enum vcp_vdec_event_type type,
 	e->type = type;
 	e->cookie = cookie;
 	e->timestamp = timestamp;
+	e->no_generated = false;
 	return 0;
 }
 
+/* Failure-only metadata: take the first snapshot while VSI is live and the
+ * caller owns rx_lock. Keep every rejection and ownership transition intact.
+ */
+static bool dec_first_ring_fault(struct mtk_vcp_vdec *d)
+{
+	lockdep_assert_held(&d->rx_lock);
+	if (d->ring_fault_reported)
+		return false;
+	d->ring_fault_reported = true;
+	return true;
+}
+
+struct dec_ring_snapshot {
+	u32 read, write, count;
+};
+
+/* Firmware publishes a tuple through separate stores. Accept two consecutive
+ * matching coherent samples, with bounded retry under rx_lock; a range error
+ * or persistently inconsistent tuple remains a protocol failure. This does
+ * not establish atomic shared-count ownership during nonempty consumption.
+ */
+static int dec_ring_snapshot(const __le32 *wire_read, const __le32 *wire_write,
+			     const __le32 *wire_count, struct dec_ring_snapshot *out)
+{
+	struct dec_ring_snapshot previous = {};
+	bool have_previous = false;
+	unsigned int attempt;
+
+	for (attempt = 0; attempt < 32; attempt++) {
+		dma_rmb();
+		out->read = le32_to_cpu(READ_ONCE(*wire_read));
+		out->write = le32_to_cpu(READ_ONCE(*wire_write));
+		out->count = le32_to_cpu(READ_ONCE(*wire_count));
+		if (out->read >= 64 || out->write >= 64 || out->count > 64)
+			return -EPROTO;
+		if ((out->read + out->count) % 64 == out->write) {
+			if (have_previous && previous.read == out->read &&
+			    previous.write == out->write && previous.count == out->count) {
+				dma_rmb();
+				return 0;
+			}
+			previous = *out;
+			have_previous = true;
+		} else {
+			have_previous = false;
+		}
+		cpu_relax();
+	}
+	return -EPROTO;
+}
+
 /* Consume at PUT_FRAME_BUFFER, or after START/RESET for synchronous codecs. */
 static int dec_frames(struct mtk_vcp_vdec *d, struct vcp_vdec_fb_ring *r, bool display)
 {
-	u32 read = le32_to_cpu(READ_ONCE(r->read));
-	u32 write = le32_to_cpu(READ_ONCE(r->write));
-	u32 count = le32_to_cpu(READ_ONCE(r->count));
+	struct dec_ring_snapshot snapshot;
+	u32 read, write, count;
 	unsigned int i;
 	int ret;
 
-	if (read >= 64 || write >= 64 || count > 64 || (read + count) % 64 != write)
+	ret = dec_ring_snapshot(&r->read, &r->write, &r->count, &snapshot);
+	read = snapshot.read;
+	write = snapshot.write;
+	count = snapshot.count;
+	if (ret) {
+		if (dec_first_ring_fault(d))
+			VCPDBG("ring-fault: %s tuple r=%u w=%u n=%u now=%u/%u/%u expected=%#x events=%u\n",
+			       display ? "display" : "free-fb", read, write, count,
+			       le32_to_cpu(READ_ONCE(r->read)),
+			       le32_to_cpu(READ_ONCE(r->write)),
+			       le32_to_cpu(READ_ONCE(r->count)), d->expected, d->event_count);
 		return -EPROTO;
+	}
+	/* An empty poll must not clear a newly arriving firmware publication. */
+	if (!count)
+		return 0;
 	while (count--) {
 		struct vcp_vdec_fb *f = &r->frame[read];
 		u64 cookie = le64_to_cpu(f->cookie);
@@ -194,22 +296,35 @@ static int dec_frames(struct mtk_vcp_vdec *d, struct vcp_vdec_fb_ring *r, bool d
 				s = &d->surfaces[i];
 				break;
 			}
-		/* xaga firmware returns cookies/timestamps but zeroes the DMA
-		 * fields in display/free entries. Never interpret a cookie as
-		 * a pointer; any supplied address must match our submitted record.
-		 */
-		if (!s || s->pending || (f->y && s->y != le64_to_cpu(f->y)) ||
-		    (f->c && s->c != le64_to_cpu(f->c)) ||
-		    (display && s->displayed))
+		/* MT6897 rings contain cookies/timestamps, never AP pointers. */
+		if (!s || s->pending || (display && s->displayed)) {
+			if (dec_first_ring_fault(d))
+				VCPDBG("ring-fault: %s frame r=%u w=%u remaining=%u cookie=%#llx ts=%llu slot=%u pending=%d displayed=%d expected=%#x events=%u\n",
+				       display ? "display" : "free-fb", read, write, count,
+				       cookie, le64_to_cpu(f->timestamp), s ? i : 64,
+				       s ? s->pending : 0, s ? s->displayed : 0,
+				       d->expected, d->event_count);
 			return -EPROTO;
+		}
+		/* Vendor INPUT_DRIVEN_PUT_FRM keeps an early FREE advisory when
+		 * the frame has not been displayed. It is not a DMA release: a
+		 * later DISPLAY and final FREE still name this same cookie.
+		 */
+		if (!display && d->vsi->input_driven == 2 && !d->flushing &&
+		    !s->displayed && !le32_to_cpu(f->reserved))
+			goto next_frame;
 		ret = dec_push_event(d, display ? VCP_VDEC_DISPLAY : VCP_VDEC_FREE_FRAME,
 				     cookie, le64_to_cpu(f->timestamp));
 		if (ret)
 			return ret;
-		if (display)
+		if (display) {
+			d->events[(d->event_read + d->event_count - 1) % DEC_EVENTS].no_generated =
+				!!le32_to_cpu(f->reserved);
 			s->displayed = true;
-		else
+		} else {
 			memset(s, 0, sizeof(*s));
+		}
+next_frame:
 		read = (read + 1) % 64;
 	}
 	WRITE_ONCE(r->read, cpu_to_le32(read));
@@ -217,43 +332,101 @@ static int dec_frames(struct mtk_vcp_vdec *d, struct vcp_vdec_fb_ring *r, bool d
 	return 0;
 }
 
+/* Async frame rings belong to PUT_FRAME_BUFFER: firmware waits for our reply
+ * before publishing again. Polling them from a worker is outside that ownership
+ * window. FREE_BS remains worker-owned, including same-input continuations.
+ */
+static int dec_collect_frames(struct mtk_vcp_vdec *d)
+{
+	int ret;
+
+	dma_rmb();
+	ret = dec_frames(d, &d->vsi->display, true);
+	if (!ret)
+		ret = dec_frames(d, &d->vsi->free_fb, false);
+	/* Publish consumed frame entries before the callback ACK. */
+	dma_wmb();
+	return ret;
+}
+
+static int dec_collect_callback(struct mtk_vcp_vdec *d, bool no_need_put)
+{
+	if (d->hw_error)
+		return d->hw_error;
+	if (no_need_put)
+		return 0;
+	if (!d->vsi)
+		return -EPROTO;
+	/* Synchronous output is deferred to the decoder worker. */
+	if (!READ_ONCE(d->vsi->output_async))
+		return 0;
+	return dec_collect_frames(d);
+}
+
 static int dec_collect(struct mtk_vcp_vdec *d)
 {
 	struct vcp_vdec_bs_ring *r;
+	struct dec_ring_snapshot snapshot;
 	u32 read, write, count;
 	unsigned int i;
 	int ret;
 
+	if (d->hw_error)
+		return d->hw_error;
 	if (!d->vsi)
 		return -EPROTO;
+	if (!READ_ONCE(d->vsi->output_async)) {
+		ret = dec_collect_frames(d);
+		if (ret)
+			return ret;
+	}
 	dma_rmb();
-	ret = dec_frames(d, &d->vsi->display, true);
-	if (!ret)
-		ret = dec_frames(d, &d->vsi->free_fb, false);
-	if (ret)
-		return ret;
 	r = &d->vsi->free_bs;
-	read = le32_to_cpu(READ_ONCE(r->read));
-	write = le32_to_cpu(READ_ONCE(r->write));
-	count = le32_to_cpu(READ_ONCE(r->count));
-	if (read >= 64 || write >= 64 || count > 64 || (read + count) % 64 != write)
+	ret = dec_ring_snapshot(&r->read, &r->write, &r->count, &snapshot);
+	read = snapshot.read;
+	write = snapshot.write;
+	count = snapshot.count;
+	if (ret) {
+		if (dec_first_ring_fault(d))
+			VCPDBG("ring-fault: free-bs tuple r=%u w=%u n=%u now=%u/%u/%u expected=%#x events=%u\n",
+			       read, write, count, le32_to_cpu(READ_ONCE(r->read)),
+			       le32_to_cpu(READ_ONCE(r->write)),
+			       le32_to_cpu(READ_ONCE(r->count)), d->expected, d->event_count);
 		return -EPROTO;
+	}
+	if (!count)
+		goto publish;
 	while (count--) {
 		u64 cookie = le64_to_cpu(r->cookie[read]);
 
 		for (i = 0; i < 64; i++)
 			if (cookie && d->bitstreams[i] == cookie)
 				break;
-		if (i == 64)
+		if (i == 64) {
+			if (dec_first_ring_fault(d))
+				VCPDBG("ring-fault: free-bs cookie r=%u w=%u remaining=%u cookie=%#llx expected=%#x events=%u\n",
+				       read, write, count, cookie, d->expected, d->event_count);
 			return -EPROTO;
+		}
+		if (d->input.cookie == cookie) {
+			ret = vcp_vdec_input_release(&d->input, cookie);
+			if (ret < 0)
+				return ret;
+			if (!ret)
+				goto next_bs;
+		}
 		ret = dec_push_event(d, VCP_VDEC_FREE_BITSTREAM, cookie, 0);
 		if (ret)
 			return ret;
 		d->bitstreams[i] = 0;
+		if (d->input.cookie == cookie)
+			memset(&d->input, 0, sizeof(d->input));
+next_bs:
 		read = (read + 1) % 64;
 	}
 	WRITE_ONCE(r->read, cpu_to_le32(read));
 	WRITE_ONCE(r->count, 0);
+publish:
 	dma_wmb();
 	return 0;
 }
@@ -261,23 +434,24 @@ static int dec_collect(struct mtk_vcp_vdec *d)
 static void dec_receive_session(struct mtk_vcp_vdec *d, const void *data,
 				size_t size)
 {
-	u8 buf[64] __aligned(8);
+	u8 buf[64] __aligned(8) = {};
 	struct vcp_vdec_ack *a = (void *)buf;
 	u32 id, reply_id;
-	int ret = 0;
+	int ret = 0, callback_error;
+	bool hardware_callback = false;
 
 	VCPDBG("rx: %zu bytes\n", size);
-	if (size < sizeof(*a) || size > sizeof(buf)) {
+	if (size < offsetof(struct vcp_vdec_ack, codec_id) || size > sizeof(buf)) {
 		VCPDBG("rx: unexpected size %zu (ack is %zu)\n", size, sizeof(*a));
 		return;
 	}
 	memcpy(buf, data, size);
