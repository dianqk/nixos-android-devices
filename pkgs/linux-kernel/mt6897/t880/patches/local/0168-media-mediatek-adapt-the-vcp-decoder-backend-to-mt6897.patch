diff --git a/drivers/media/platform/mediatek/vcodec/vcp/mtk_vcp_vdec_input.h b/drivers/media/platform/mediatek/vcodec/vcp/mtk_vcp_vdec_input.h
new file mode 100644
index 0000000000..13140521a9
--- /dev/null
+++ b/drivers/media/platform/mediatek/vcodec/vcp/mtk_vcp_vdec_input.h
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MTK_VCP_VDEC_INPUT_H
+#define MTK_VCP_VDEC_INPUT_H
+
+/* One logical AU keeps its DMA lease across vendor NEED_MORE_OUTPUT replies.
+ * The vendor AP contract reuses the same BS identity after draining its FREE
+ * record; these are continuations, not independent bitstream generations.
+ */
+struct vcp_vdec_input {
+	u64 cookie, dma, timestamp, deadline;
+	u32 bytes, capacity, attempts;
+	bool flight, more, released;
+};
+
+static inline int vcp_vdec_input_begin(struct vcp_vdec_input *s, u64 cookie,
+		 u64 dma, u32 bytes, u32 capacity, u64 timestamp, u64 deadline)
+{
+	if (s->cookie && (s->cookie != cookie || s->dma != dma ||
+	    s->bytes != bytes || s->capacity != capacity ||
+	    s->timestamp != timestamp || s->deadline != deadline || !s->more || s->flight))
+		return -EINVAL;
+	if (s->attempts >= 32)
+		return -ELOOP;
+	s->cookie = cookie;
+	s->dma = dma;
+	s->bytes = bytes;
+	s->capacity = capacity;
+	s->timestamp = timestamp;
+	s->deadline = deadline;
+	s->attempts++;
+	s->flight = true;
+	s->more = false;
+	s->released = false;
+	return 0;
+}
+
+/* 1 permits one final completion; 0 retains the logical AU's DMA lease. */
+static inline int vcp_vdec_input_release(struct vcp_vdec_input *s, u64 cookie)
+{
+	if (!s->cookie || s->cookie != cookie || s->released)
+		return -EPROTO;
+	s->released = true;
+	return !s->flight && !s->more;
+}
+
+static inline int vcp_vdec_input_ack(struct vcp_vdec_input *s, bool more)
+{
+	if (!s->cookie || !s->flight)
+		return -EPROTO;
+	s->flight = false;
+	s->more = more;
+	return !more && s->released;
+}
+/* Only a successful firmware reset can terminate continuation eligibility.
+ * It does not fabricate a release: the DMA owner still waits for FREE.
+ */
+static inline bool vcp_vdec_input_reset_ack(struct vcp_vdec_input *s)
+{
+	s->flight = false;
+	s->more = false;
+	return s->cookie && s->released;
+}
+#endif
