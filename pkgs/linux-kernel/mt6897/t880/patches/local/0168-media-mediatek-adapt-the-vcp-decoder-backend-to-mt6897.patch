+ * Local adaptation: explicit little-endian wire types, no AP pointers, and
+ * assertions against the shipping MT6897 decoder's serialized offsets.
+ * This is deliberately separate from the incompatible MT6895 firmware ABI.
+ */
+#ifndef __MTK_VCP_VDEC_MT6897_ABI_H
+#define __MTK_VCP_VDEC_MT6897_ABI_H
+
+#include <linux/build_bug.h>
+#include <linux/stddef.h>
+#include <linux/types.h>
+#include <linux/byteorder/generic.h>
+#include <linux/string.h>
