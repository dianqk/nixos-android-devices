@@ -0,0 +1,299 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * MT6897 VCP wire ABI. Derived from MediaTek vdec_ipi_msg.h/vcodec_ipi_msg.h
+ * Copyright (c) 2016 MediaTek Inc.
+ * Authors: PC Chen <pc.chen@mediatek.com>, Tiffany Lin <tiffany.lin@mediatek.com>
