@@ -1,5 +1,6 @@
 // SPDX-License-Identifier: GPL-2.0-only
-/* MT6895 firmware protocol for the stateful decoder frontend. */
+/* MT6897 firmware protocol for the stateful decoder frontend. */
+#include <linux/remoteproc/mtk_vcp_memory.h>
 #include <linux/atomic.h>
 #include <linux/completion.h>
 #include <linux/dma-mapping.h>
@@ -10,8 +11,10 @@
 #include <linux/sizes.h>
 #include <linux/unaligned.h>
 
+#include "mtk_vcp_vdec_pixels.h"
 #include "mtk_vcp_vdec.h"
 #include "mtk_vcp_vdec_bitstream.h"
