+#define MT6897_VDEC_BUFFERS 64
+#define MT6897_VDEC_PLANES 8
+#define MT6897_VDEC_CAPS 128
+
+enum mt6897_vdec_msg_id {
+	MT6897_VDEC_INIT = 0xa000,
+	MT6897_VDEC_START,
+	MT6897_VDEC_DEINIT,
+	MT6897_VDEC_RESET,
+	MT6897_VDEC_SET_PARAM,
+	MT6897_VDEC_QUERY_CAP,
+	MT6897_VDEC_FRAME_BUFFER,
+	MT6897_VDEC_BACKUP,
+	MT6897_VDEC_RESUME,
+	MT6897_VDEC_INIT_DONE = 0xb000,
+	MT6897_VDEC_START_DONE,
+	MT6897_VDEC_DEINIT_DONE,
+	MT6897_VDEC_RESET_DONE,
+	MT6897_VDEC_SET_PARAM_DONE,
+	MT6897_VDEC_QUERY_CAP_DONE,
+	MT6897_VDEC_DONE,
+	MT6897_VDEC_BACKUP_DONE,
+	MT6897_VDEC_RESUME_DONE,
+	MT6897_VDEC_PUT_FRAME_BUFFER = 0xc000,
+	MT6897_VDEC_LOCK_CORE,
+	MT6897_VDEC_UNLOCK_CORE,
+	MT6897_VDEC_LOCK_LAT,
+	MT6897_VDEC_UNLOCK_LAT,
+	MT6897_VDEC_MEM_ALLOC,
+	MT6897_VDEC_MEM_FREE,
+	MT6897_VDEC_WAITISR,
+	MT6897_VDEC_GET_FRAME_BUFFER,
+	MT6897_VDEC_CHECK_CODEC_ID,
+	MT6897_VDEC_SLICE_DONE_ISR,
