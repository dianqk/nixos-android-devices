+static_assert(offsetof(struct mt6897_vdec_vsi, formats) == 4080);
+
+static_assert(offsetof(struct mt6897_vdec_vsi, input_driven) == 11268);
+static_assert(offsetof(struct mt6897_vdec_vsi, output_async) == 11269);
+static_assert(offsetof(struct mt6897_vdec_vsi, low_pw_mode) == 11270);
+static_assert(offsetof(struct mt6897_vdec_vsi, general_dma) == 11792);
+static_assert(offsetof(struct mt6897_vdec_vsi, general_fd) == 11800);
+static_assert(offsetof(struct mt6897_vdec_vsi, general_size) == 11804);
+static_assert(offsetof(struct mt6897_vdec_vsi, ipi_blocked) == 11824);
+#define MT6897_VDEC_VSI_EXTENT (offsetof(struct mt6897_vdec_vsi, ipi_blocked) + 4)
+static_assert(MT6897_VDEC_VSI_EXTENT == 11828);
+
+/* Firmware may request this shared-memory bootstrap even without an encoder
+ * frontend. Its prefix differs from decoder messages: cookie precedes status.
+ * MediaTek venc_ipi_msg.h at the same pinned source revision above.
+ */
+struct mt6897_venc_boot_mem {
+	__le32 id, ctx;
+	__le64 cookie;
+	__le32 status, reserved, type, size;
+	__le64 iova, pa, va;
+	__le32 property, log;
+};
+static_assert(sizeof(struct mt6897_venc_boot_mem) == 64);
+static_assert(offsetof(struct mt6897_venc_boot_mem, cookie) == 8);
+static_assert(offsetof(struct mt6897_venc_boot_mem, status) == 16);
+static_assert(offsetof(struct mt6897_venc_boot_mem, type) == 24);
+static_assert(offsetof(struct mt6897_venc_boot_mem, property) == 56);
+
+/* Preserve the firmware context and cookie; replace all reply-owned fields. */
+static inline void mt6897_venc_shm_reply(struct mt6897_venc_boot_mem *msg,
+				       u32 size, u64 dma, u64 va,
+				       u32 property, u32 log)
+{
+	msg->id = cpu_to_le32(0x4003);
+	msg->status = msg->reserved = 0;
+	msg->type = cpu_to_le32(6);
+	msg->size = cpu_to_le32(size);
+	msg->iova = msg->pa = cpu_to_le64(dma);
+	msg->va = cpu_to_le64(va);
+	msg->property = cpu_to_le32(property);
+	msg->log = cpu_to_le32(log);
+}
+
+/* Zero the complete wire object, including alignment and tail padding. */
+static inline void mt6897_vdec_make_init(struct mt6897_vdec_init *msg,
+				       u32 context, u64 cookie)
+{
+	memset(msg, 0, sizeof(*msg));
+	msg->id = cpu_to_le32(MT6897_VDEC_INIT);
+	msg->ctx = cpu_to_le32(context);
+	msg->cookie = cpu_to_le64(cookie);
+}
+
+static inline void mt6897_vdec_make_query(struct mt6897_vdec_query *msg,
+					u32 context, u64 cookie, u64 data_cookie,
+					u32 query)
+{
+	memset(msg, 0, sizeof(*msg));
+	msg->id = cpu_to_le32(MT6897_VDEC_QUERY_CAP);
+	msg->ctx = cpu_to_le32(context);
+	msg->cookie = cpu_to_le64(cookie);
+	msg->data_cookie = cpu_to_le64(data_cookie);
+	msg->query = cpu_to_le32(query);
+}
+
+static inline void mt6897_vdec_make_start(struct mt6897_vdec_start *msg,
+					u32 context, u64 instance, const u32 data[6])
+{
+	unsigned int i;
+
+	memset(msg, 0, sizeof(*msg));
+	msg->id = cpu_to_le32(MT6897_VDEC_START);
+	msg->ctx = cpu_to_le32(context);
+	msg->instance = cpu_to_le64(instance);
+	for (i = 0; i < 6; i++)
+		msg->data[i] = cpu_to_le32(data[i]);
+}
+/* Vendor's optional container-size control defaults to zero. The first
+ * header pass still publishes those defaults and the FRAME_SIZE change bit.
+ * Preserve every other firmware-owned parameter byte.
+ */
+static inline void mt6897_vdec_header_params(struct mt6897_vdec_params *params)
+{
+	params->width = 0;
+	params->height = 0;
+	params->changed = cpu_to_le32(le32_to_cpu(params->changed) | (1U << 1));
+}
+static_assert(offsetof(struct mt6897_vdec_vsi, params.changed) == 3632);
+static_assert(offsetof(struct mt6897_vdec_vsi, params.width) == 3640);
+static_assert(offsetof(struct mt6897_vdec_vsi, params.height) == 3644);
+
+/* Firmware normal decoder buffers are 32-bit; the shared domain may keep
+ * an unmapped gap below that address limit. No full-4-GiB extent is needed.
+ */
+static inline bool mt6897_vdec_normal_aperture_valid(u64 start, u64 end,
+						  bool forced)
+{
+	return forced && !start && end > start && end <= 0xffffffffULL;
+}
+
+#endif
