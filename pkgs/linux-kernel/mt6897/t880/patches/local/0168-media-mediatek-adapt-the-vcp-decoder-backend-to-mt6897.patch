+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __MTK_VCP_VDEC_PIXELS_H
+#define __MTK_VCP_VDEC_PIXELS_H
+#include <linux/types.h>
+#include <linux/string.h>
+
+/* MM21 identifies the tile format. Layout 8 is admitted only for the
+ * eight-bit MM21 format, not interpreted as a compression flag.
+ * Firmware allocation tails are opaque and never read by the CPU detiler.
+ */
+static inline bool mtk_vcp_mm21_valid(u32 stride, u32 height, u32 y_size,
+				    u32 c_size, u32 layout)
+{
+	u64 luma = (u64)stride * height;
+
+	return stride && stride <= 4096 && !(stride & 15) &&
+		height && height <= 2176 && !(height & 31) &&
+		!layout && y_size >= luma &&
+		c_size >= luma / 2 && (u64)y_size + c_size <= 16ULL * 1024 * 1024;
+}
+
+static inline bool mtk_vcp_crop_valid(u32 width, u32 height, u32 left,
+				     u32 top, u32 crop_width, u32 crop_height)
+{
+	return crop_width && crop_height && left < width && top < height &&
+		crop_width <= width - left && crop_height <= height - top;
+}
+
+/* Caller validates the tiled source footprint and linear destination size.
+ * Luma uses 16x32 tiles, interleaved chroma uses 16x16 tiles.
+ */
+static inline void mtk_vcp_mm21_detile(void *destination, const void *source,
+				     u32 stride, u32 height, u32 tile_h)
+{
+	u8 *dst = destination;
+	const u8 *src = source;
+	u32 x, y;
+
+	for (y = 0; y < height; y++)
+		for (x = 0; x < stride; x += 16) {
+			u32 offset = (y / tile_h * (stride / 16) + x / 16) * tile_h * 16;
+
+			memcpy(dst + y * stride + x, src + offset + y % tile_h * 16, 16);
+		}
+}
+#endif
