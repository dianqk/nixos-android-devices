+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Test production MT6897 checked mailbox stop with deterministic MMIO/PM mocks."""
+from pathlib import Path
+import os
+import re
+import subprocess
+import tempfile
+
+assets = Path(__file__).resolve().parent
+repo = Path(os.environ.get('KERNEL_SRC', str(assets.parents[3])))
+source = (repo / 'drivers/mailbox/mtk-cmdq-mailbox.c').read_text()
+
+
+def function(name):
+    match = re.search(r'^static (?:int|void|bool) ' + name + r'\(', source, re.M)
+    start = match.start()
+    end = source.index('{', start) + 1
+    depth = 1
+    while depth:
+        depth += (source[end] == '{') - (source[end] == '}')
+        end += 1
+    return source[start:end]
+
+
+assert source.count('.checked_flush = true') == 1
+assert '.checked_flush = true' in source.split('gce_plat_mt6897 = {', 1)[1].split('};', 1)[0]
+irq = function('cmdq_thread_irq_handler')
+assert irq.index('writel(~irq_flag') < irq.index('thread->stop_faulted') < irq.index('cmdq_task_exec_done')
+send = function('cmdq_mbox_send_data')
+assert send.index('thread->stop_faulted') < send.index('kzalloc_obj') < send.index('writel(')
+production = '\n'.join(function(name) for name in [
+    'cmdq_thread_suspend', 'cmdq_thread_reset', 'cmdq_thread_disable',
+    'cmdq_thread_is_in_wfe', 'cmdq_thread_stop_fault', 'cmdq_mbox_flush_checked',
+    'cmdq_thread_irq_handler', 'cmdq_mbox_send_data', 'cmdq_mbox_shutdown'])
+# Resume is an inline function in the driver.
+a = source.index('static void cmdq_thread_resume(')
+b = source.index('\n}\n', a) + 3
+production = source[a:b] + '\n' + production
+with tempfile.TemporaryDirectory(prefix='mtk-cmdq-stop-') as tmp:
+    tmp = Path(tmp)
+    c = tmp / 'test.c'
+    c.write_text((assets / 'cmdq_stop_cases.c').read_text().replace('/* PRODUCTION */', production))
+    binary = tmp / 'test'
+    subprocess.run([os.environ.get('CC', 'cc'), '-std=gnu11', '-Wall', '-Wextra',
+                    '-Wno-unused-parameter', '-Werror', '-g', '-pthread', '-fsanitize=address,undefined',
+                    str(c), '-o', str(binary)], check=True)
+    subprocess.run([str(binary)], check=True)
