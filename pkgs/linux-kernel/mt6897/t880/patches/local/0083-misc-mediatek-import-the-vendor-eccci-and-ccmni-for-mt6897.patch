+static int ccci_md_in_ee_dump(void)
+{
+	struct ccci_per_md *per_md_data;
+
+	per_md_data = ccci_get_per_md_data();
+
+	if (!per_md_data)
+		return -CCCI_ERR_MD_INDEX_NOT_FOUND;
+
+	return per_md_data->is_in_ee_dump;
+}
