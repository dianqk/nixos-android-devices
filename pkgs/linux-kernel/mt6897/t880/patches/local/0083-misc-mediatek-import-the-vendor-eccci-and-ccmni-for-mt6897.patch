+void ccci_drv2_rxq_hw_int_apit(struct dpmaif_rx_queue *rxq)
+{
+	drv2_dl_set_apit_idx(DPMAIF_DUMMY_PIT_AIDX);
+
+	rxq->pit_dummy_idx = DPMAIF_DUMMY_PIT_AIDX;
+	rxq->pit_dummy_cnt = 0;
+}
