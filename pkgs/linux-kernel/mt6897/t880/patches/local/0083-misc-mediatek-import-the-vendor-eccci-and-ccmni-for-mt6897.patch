+static inline void dpmaif_set_cpu_mask(struct cpumask *cpu_mask,
+		u32 cpus, int cpu_nr)
+{
+	int i;
+
+	cpumask_clear(cpu_mask);
+
+	for (i = 0; i < cpu_nr; i++) {
+		if (cpus & (1 << i))
+			cpumask_set_cpu(i, cpu_mask);
+	}
+}
