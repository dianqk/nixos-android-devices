+static int ccci_md_send_ccb_tx_notify(int core_id)
+{
+	/* CCCI_NORMAL_LOG(0, TAG,
+	 * "ccb tx notify to core %d\n", core_id);
+	 */
+	switch (core_id) {
+	case P_CORE:
+		ccci_hif_send_data(CCIF_HIF_ID, AP_MD_CCB_WAKEUP);
+		break;
+	case VOLTE_CORE:
+	default:
+		break;
+	}
+	return 0;
+}
