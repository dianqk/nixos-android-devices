+void ccci_drv2_rxq_handle_ig(struct dpmaif_rx_queue *rxq,
+	struct dpmaif_normal_pit_v2 *nml_pit_v2)
+{
+	/*resv PIT IG=1 bit*/
+	if (nml_pit_v2->reserved2 & (1<<6))
+		rxq->pit_reload_en = 1;
+	else
+		rxq->pit_reload_en = 0;
+
+	rxq->pit_dummy_cnt++;
+}
