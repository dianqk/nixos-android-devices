+static void drv2_ul_arb_en(unsigned char q_num, bool enable)
+{
+	unsigned int ul_arb_en;
+
+	ul_arb_en = DPMA_READ_AO_UL(NRL2_DPMAIF_AO_UL_CHNL_ARB0);
+
+	if (enable == true)
+		ul_arb_en |= (1<<(q_num+8));
+	else
+		ul_arb_en &= ~(1<<(q_num+8));
+
+	DPMA_WRITE_AO_UL(NRL2_DPMAIF_AO_UL_CHNL_ARB0, ul_arb_en);
+}
