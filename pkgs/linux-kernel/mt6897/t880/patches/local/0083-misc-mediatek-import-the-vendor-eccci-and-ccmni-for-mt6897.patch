+static ssize_t md_cd_dump_show(struct ccci_modem *md, char *buf)
+{
+	int count = 0;
+
+	count = scnprintf(buf, 256,
+		"support: ccif cldma register smem fsm_1 layout\n");
+	return count;
+}
