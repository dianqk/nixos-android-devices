+	value = DPMA_READ_AO_DL(DPMAIF_AO_DL_RDY_CHK_THRES);
+
+	value &= ~(DPMAIF_AO_DL_ISR_MSK);
+	value |= ((mask) & DPMAIF_AO_DL_ISR_MSK);
+
+	DPMA_WRITE_AO_DL(DPMAIF_AO_DL_RDY_CHK_THRES, value);
+}
