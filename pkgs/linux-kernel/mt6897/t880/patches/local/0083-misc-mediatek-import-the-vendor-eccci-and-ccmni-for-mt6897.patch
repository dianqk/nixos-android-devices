+
+	cfg = ((DPMAIF_LRO_HASH_BIT_CHOOSE_DF & 0x7) << 0);
+
+	DPMA_WRITE_AO_DL(NRL2_DPMAIF_AO_DL_LROPIT_INIT_CON5, cfg);
