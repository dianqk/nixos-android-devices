+	DPMA_WRITE_AO_UL(NRL2_DPMAIF_AO_UL_AP_L2TIMSR0, ui_que_done_mask);
+
+	/* check mask sts */
+	/* while ((DPMA_READ_PD_MISC(DPMAIF_PD_AP_UL_L2TIMR0) &
+	 * ui_que_done_mask)
+	 * != ui_que_done_mask);
+	 */
