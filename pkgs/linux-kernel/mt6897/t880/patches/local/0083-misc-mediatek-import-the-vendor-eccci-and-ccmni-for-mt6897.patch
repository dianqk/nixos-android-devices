+static void tx_force_md_assert(char buf[])
+{
+	if (atomic_inc_return(&g_tx_busy_assert_on) <= 1) {
+		CCCI_NORMAL_LOG(0, TAG,
+			"[%s] error: force assert md, because: %s\n",
+			__func__, buf);
+		ccci_md_force_assert(MD_FORCE_ASSERT_BY_AP_Q0_BLOCKED, "TX", 3);
+	}
+}
