+int ccci_md_register(struct ccci_modem *md)
+{
+	int ret;
+
+	/* init per-modem sub-system */
+	CCCI_INIT_LOG(0, TAG, "register modem\n");
+	/* init modem */
+	ret = md->ops->init(md);
+	if (ret < 0)
