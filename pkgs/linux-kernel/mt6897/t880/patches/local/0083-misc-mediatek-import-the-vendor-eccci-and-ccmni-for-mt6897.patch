+	value = DPMA_READ_AO_DL(DPMAIF_AO_DL_PKTINFO_CON2);
+
+	value &= ~(DPMAIF_BAT_RSV_LEN_MSK);
+	value |= (length & DPMAIF_BAT_RSV_LEN_MSK);
+
+	DPMA_WRITE_AO_DL(DPMAIF_AO_DL_PKTINFO_CON2, value);
