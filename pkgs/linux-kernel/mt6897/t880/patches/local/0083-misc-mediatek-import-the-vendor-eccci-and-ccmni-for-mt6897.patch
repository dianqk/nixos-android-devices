+	val &= 0x0F;
+	val |= (((next_ptr >> 32) & 0xF) << 4);
+	cldma_write8(&tbd->msb.msb_byte, 0, val);
+#endif
+	CCCI_DEBUG_LOG(MD_SYS1, TAG, "%s:%pa, 0x%x, val=0x%x\n",
+		__func__, &next_ptr, tbd->msb.msb_byte, val);
