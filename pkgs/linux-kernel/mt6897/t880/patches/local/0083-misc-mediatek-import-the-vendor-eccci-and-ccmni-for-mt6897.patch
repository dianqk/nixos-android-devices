+static unsigned int drv1_ul_idle_check(void)
+{
+	unsigned long idle_sts;
+
+	idle_sts = ((DPMA_READ_PD_UL(NRL2_DPMAIF_UL_DBG_STA2) >> DPMAIF_UL_STS_CUR_SHIFT)
+		& DPMAIF_UL_IDLE_STS_MSK);
+
+	if (idle_sts == DPMAIF_UL_IDLE_STS)
+		return 0;
+	else
+		return 1;
+}
