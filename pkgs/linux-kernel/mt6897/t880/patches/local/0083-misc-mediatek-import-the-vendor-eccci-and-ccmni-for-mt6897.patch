+		return;
+
+	for (i = 0; i < ctlb->ccci_ops->ccmni_num; i++)
+		if (ctlb->ccmni_inst[i] && ctlb->ccmni_inst[i]->dev &&
+		    (ctlb->ccmni_inst[i]->dev->flags & IFF_UP))
+			ktime_get_real_ts64(&ctlb->ccmni_inst[i]->flush_time);
+
+}
