+static void drv1_ul_all_queue_en(bool enable)
+{
+	unsigned long ul_arb_en;
+
+	ul_arb_en = DPMA_READ_PD_UL(DPMAIF_PD_UL_CHNL_ARB0);
+
+	if (enable == true)
+		ul_arb_en |= DPMAIF_UL_ALL_QUE_ARB_EN;
+	else
+		ul_arb_en &= ~DPMAIF_UL_ALL_QUE_ARB_EN;
