From c121536cf9dbbbd75ff84263e8928e162d780581 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Fri, 6 Nov 2026 10:00:00 +0800
Subject: [PATCH] workaround: arm64: dts: avoid duplicate MT6897 CPU throttling

Place the Linux CPU passive trips above the firmware temperature target
while firmware remains responsible for ordinary CPU throttling.

Original-Commit: local development history
Original-Author: dianqk <dianqk@dianqk.net>
Original-Date: 2026-10-16T20:13:35+08:00
Signed-off-by: dianqk <dianqk@dianqk.net>
---
 arch/arm64/boot/dts/mediatek/mt6897.dtsi | 54 +++++++++++++-----------
 1 file changed, 30 insertions(+), 24 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6897.dtsi b/arch/arm64/boot/dts/mediatek/mt6897.dtsi
index 347a9946d9..782b2a8a02 100644
--- a/arch/arm64/boot/dts/mediatek/mt6897.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6897.dtsi
@@ -1447,6 +1447,12 @@ watchdog: watchdog@1c00a000 {
 		};
 	};
 
+	/*
+	 * The MCUPM firmware regulates the CPU junction temperature itself
+	 * (about 95 C by default; the vendor writes a 103.1 C target).
+	 * The CPU passive trips are a backstop above that target, so the
+	 * kernel does not throttle on top of the firmware.
+	 */
 	thermal-zones {
 		cpu0-thermal {
 			polling-delay = <1000>;
@@ -1455,13 +1461,13 @@ cpu0-thermal {
 
 			trips {
 				cpu0_alert: trip-alert {
-					temperature = <95000>;
+					temperature = <103000>;
 					hysteresis = <2000>;
 					type = "passive";
 				};
 
 				cpu0_hot: trip-hot {
-					temperature = <103000>;
+					temperature = <108000>;
 					hysteresis = <2000>;
 					type = "passive";
 				};
@@ -1499,13 +1505,13 @@ cpu1-thermal {
 
 			trips {
 				cpu1_alert: trip-alert {
-					temperature = <95000>;
+					temperature = <103000>;
