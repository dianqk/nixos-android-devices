diff --git a/drivers/misc/mediatek/eccci/fsm/mt6897_ccci_scp.c b/drivers/misc/mediatek/eccci/fsm/mt6897_ccci_scp.c
new file mode 100644
index 0000000000..ab05c671ab
--- /dev/null
+++ b/drivers/misc/mediatek/eccci/fsm/mt6897_ccci_scp.c
@@ -0,0 +1,381 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* MT6897 APCCCI transport for the vendor CCCI/SCP state protocol.
+ * Protocol source: MediaTek ccci_fsm_scp_c.c, imported with this driver.
+ * The bridge shares the non-unloadable CCCI core lifetime; unbind is disabled.
+ */
+#include <linux/arm-smccc.h>
+#include <linux/clk.h>
+#include <linux/completion.h>
+#include <linux/io.h>
+#include <linux/mt6897-scp-ccci.h>
+#include <linux/of_address.h>
+#include <linux/overflow.h>
+#include <linux/platform_device.h>
+#include <linux/workqueue.h>
+#include "ccci_config.h"
+#include "ccci_common_config.h"
+#include "ccci_fsm_internal.h"
+#include "modem_secure_base.h"
+#include "md_sys1_platform.h"
+#include "mt6897_ccci_scp.h"
+#include "ccci_util_md_mem.h"
+
+#define BRIDGE_EVENTS 32
+#define STOP_TIMEOUT_MS 3000
+/* An event is copied before the IRQ or FSM callback returns. */
+enum bridge_event_type { BR_READY, BR_MD, BR_ACK, BR_RX, BR_BARRIER };
+struct bridge_event {
+	enum bridge_event_type type;
+	u32 a, b;
+};
+struct scp_bridge {
+	struct device *dev;
+	struct mt6897_scp_ccci_client client;
+	struct clk_bulk_data clocks[2];
+	void __iomem *ap, *md;
+	struct work_struct work;
+	spinlock_t lock;
+	struct bridge_event events[BRIDGE_EVENTS];
+	unsigned int head, count;
+	bool failed, clocks_on, init_sent, shm_sent, active;
+	atomic_t stop_pending;
+	struct completion stopped, ready, barrier;
+	unsigned int scp_state;
+};
+static struct scp_bridge *bridge;
+
+static void bridge_fail(struct scp_bridge *b, int err, const char *stage)
+{
+	WRITE_ONCE(b->failed, true);
+	dev_err(b->dev, "%s failed: %d; retain CCIF2 ownership until reboot\n",
+		stage, err);
+	complete_all(&b->stopped);
+}
+
+static void bridge_enqueue(struct scp_bridge *b, enum bridge_event_type type,
+			   u32 a, u32 c)
+{
+	unsigned long flags;
+	spin_lock_irqsave(&b->lock, flags);
+	if (b->count == BRIDGE_EVENTS) {
+		WRITE_ONCE(b->failed, true);
+		dev_err_ratelimited(
+			b->dev,
+			"APCCCI event overflow; STOP not acknowledged\n");
+		complete_all(&b->stopped);
+	} else {
+		b->events[(b->head + b->count) % BRIDGE_EVENTS] =
+			(struct bridge_event){ type, a, c };
+		b->count++;
+	}
+	if (smp_load_acquire(&b->active))
+		schedule_work(&b->work);
+	spin_unlock_irqrestore(&b->lock, flags);
+}
+
+static int bridge_send(struct scp_bridge *b, u16 op, u32 data)
+{
+	struct ccci_ipi_msg_out msg = {
+		.md_id = 0,
+		.op_id = op,
+		.data = { data, SCP_MSG_CHECK_A, SCP_MSG_CHECK_B },
+	};
+	u32 words[4];
+	int ret;
+	memcpy(words, &msg, sizeof(words));
+	ret = mt6897_scp_ccci_send(words);
+	dev_info(b->dev, "APCCCI TX op=%u data=%#x ret=%d\n", op, data, ret);
+	return ret;
+}
+
+static int bridge_ready_md(struct scp_bridge *b)
+{
+	struct arm_smccc_res res;
+	int ret;
+	if (!b->scp_state || b->init_sent)
+		return 0;
+	if (!b->clocks_on) {
+		ret = clk_bulk_prepare_enable(ARRAY_SIZE(b->clocks), b->clocks);
+		if (ret)
+			return ret;
+		b->clocks_on = true;
+	}
+	arm_smccc_smc(MTK_SIP_KERNEL_CCCI_CONTROL, SCP_CLK_SET_DONE, 0, 0, 0, 0,
+		      0, 0, &res);
+	/* Vendor logs this raw result rather than interpreting it as errno. */
+	dev_info(b->dev, "SCP_CLK_SET_DONE raw=%#lx\n", res.a0);
+	ret = ccci_port_send_msg_to_md(CCCI_SYSTEM_TX, CCISM_SHM_INIT, 0, 1);
+	if (ret >= 0)
+		b->init_sent = true;
+	dev_info(b->dev, "CCISM_SHM_INIT ret=%d\n", ret);
+	return ret;
+}
+
+static struct ccci_smem_region *bridge_region(void)
+{
+	struct ccci_smem_region *r =
+		ccci_md_get_smem_by_user_id(SMEM_USER_CCISM_SCP);
+	void __iomem *parent_v = NULL;
+	phys_addr_t parent = 0, end, parent_end;
+	u32 md, parent_size, original_size, original_md;
+	phys_addr_t original_pa = 0;
+	void __iomem *original_v = NULL;
+	if (!r || !r->base_ap_view_vir || !r->size)
+		return ERR_PTR(-EPROTO);
+	original_size = mtk_ccci_get_smem_by_id(
+		SMEM_USER_CCISM_SCP, &original_v, &original_pa, &original_md);
+	if (r->base_ap_view_phy != original_pa || r->size != original_size ||
+	    r->base_ap_view_vir != original_v ||
+	    r->base_md_view_phy != original_md)
+		return ERR_PTR(-ERANGE);
+	parent_size = mtk_ccci_get_md_nc_smem_inf(&parent_v, &parent, &md);
+	if (!parent_v || !parent_size ||
+	    check_add_overflow(r->base_ap_view_phy, (phys_addr_t)r->size,
+			       &end) ||
+	    check_add_overflow(parent, (phys_addr_t)parent_size, &parent_end) ||
+	    r->base_ap_view_phy < parent || end > parent_end ||
+	    end > (1ULL << 32))
+		return ERR_PTR(-ERANGE);
+	return r;
+}
+
+static int bridge_init_shm(struct scp_bridge *b)
+{
+	struct ccci_smem_region *r = bridge_region();
+	if (IS_ERR(r))
+		return PTR_ERR(r);
+	if (b->shm_sent || !b->init_sent)
+		return -EPROTO;
+	memset_io(r->base_ap_view_vir, 0, r->size);
+	wmb();
+	dev_info(b->dev, "CCISM ACK region=%pa+%#x\n", &r->base_ap_view_phy,
+		 r->size);
+	b->shm_sent = true;
+	return bridge_send(b, CCCI_OP_SHM_INIT, (u32)r->base_ap_view_phy);
+}
+
+static void bridge_work(struct work_struct *work)
+{
+	struct scp_bridge *b = container_of(work, struct scp_bridge, work);
+	struct bridge_event e;
+	struct ccci_fsm_ctl *ctl;
+	unsigned long flags;
+	int ret;
+	for (;;) {
+		spin_lock_irqsave(&b->lock, flags);
+		if (!b->count || b->failed) {
+			spin_unlock_irqrestore(&b->lock, flags);
+			return;
+		}
+		e = b->events[b->head];
+		b->head = (b->head + 1) % BRIDGE_EVENTS;
+		b->count--;
+		spin_unlock_irqrestore(&b->lock, flags);
+		ctl = fsm_get_entity();
+		if (!ctl) {
+			bridge_fail(b, -ENODEV, "FSM readiness");
+			return;
+		}
+		if (READ_ONCE(b->failed))
+			return;
+		ret = 0;
+		switch (e.type) {
+		case BR_BARRIER:
+			complete(&b->barrier);
+			break;
+		case BR_READY:
+			b->scp_state = SCP_CCCI_STATE_BOOTING;
+			complete_all(&b->ready);
+			dev_info(b->dev, "READY22 -> local BOOTING\n");
+			if (READ_ONCE(ctl->md_state) == READY)
+				ret = bridge_ready_md(b);
+			break;
+		case BR_MD:
+			if (e.a == READY)
+				ret = bridge_ready_md(b);
+			else if ((e.a == GATED || e.a == INVALID) &&
+				 b->init_sent &&
+				 !atomic_read(&b->stop_pending)) {
+				reinit_completion(&b->stopped);
+				atomic_set(&b->stop_pending, 1);
+				ret = bridge_send(b, CCCI_OP_MD_STATE,
+						  MD_STATE_INVALID);
+			} else if (e.a == EXCEPTION && b->scp_state)
+				ret = bridge_send(b, CCCI_OP_MD_STATE,
+						  MD_STATE_EXCEPTION);
+			break;
+		case BR_ACK:
+			ret = bridge_init_shm(b);
+			break;
+		case BR_RX:
+			if ((e.a & 0xffff) ||
+			    (e.a >> 16) != CCCI_OP_SCP_STATE ||
+			    e.b < SCP_CCCI_STATE_BOOTING ||
+			    e.b > SCP_CCCI_STATE_STOP) {
+				ret = -EPROTO;
+				break;
+			}
+			dev_info(b->dev, "APCCCI RX state=%u\n", e.b);
+			if (e.b == SCP_CCCI_STATE_RBREADY) {
+				if (!b->shm_sent) {
+					ret = -EPROTO;
+					break;
+				}
+				ret = ccci_port_send_msg_to_md(
+					CCCI_SYSTEM_TX, CCISM_SHM_INIT_DONE, 0,
+					1);
+				if (ret >= 0)
+					ret = bridge_send(
+						b, CCCI_OP_MD_STATE,
+						ccci_fsm_get_md_state_for_user());
+			} else if (e.b == SCP_CCCI_STATE_STOP) {
+				if (atomic_cmpxchg(&b->stop_pending, 1, 3) !=
+					    1 ||
+				    READ_ONCE(ctl->md_state) == READY) {
+					ret = -EPROTO;
+					break;
+				}
+				if (b->clocks_on) {
+					writel(0xffff, b->ap + APCCIF_ACK);
+					writel(0xffff, b->md + APCCIF_ACK);
+					clk_bulk_disable_unprepare(
+						ARRAY_SIZE(b->clocks),
+						b->clocks);
+					b->clocks_on = false;
+				}
+				b->init_sent = false;
+				b->shm_sent = false;
+				atomic_set(&b->stop_pending, 0);
+				complete_all(&b->stopped);
+				dev_info(
+					b->dev,
+					"STOP acknowledged; CCIF2 clocks released\n");
+			} else if (b->scp_state == SCP_CCCI_STATE_RBREADY) {
+				b->init_sent = false;
+				b->shm_sent = false;
+				if (READ_ONCE(ctl->md_state) == READY)
+					ret = bridge_ready_md(b);
+			}
+			b->scp_state = e.b;
+			break;
+		}
+		if (ret < 0)
+			bridge_fail(b, ret, "state transaction");
+		if (ret < 0)
+			return;
+	}
+}
+
+static void bridge_ready(void *data)
+{
+	bridge_enqueue(data, BR_READY, 0, 0);
+}
+static void bridge_receive(void *data, const u32 words[2])
+{
+	bridge_enqueue(data, BR_RX, words[0], words[1]);
+}
+
+void mt6897_ccci_scp_md_state(int state)
+{
+	struct scp_bridge *b = smp_load_acquire(&bridge);
+	if (!b)
+		return;
+	bridge_enqueue(b, BR_MD, state, 0);
+}
+void mt6897_ccci_scp_init_ack(void)
+{
+	struct scp_bridge *b = smp_load_acquire(&bridge);
+	if (b)
+		bridge_enqueue(b, BR_ACK, 0, 0);
+}
+static unsigned long bridge_remaining(unsigned long deadline)
+{
+	return time_before(jiffies, deadline) ? deadline - jiffies : 0;
+}
+int mt6897_ccci_scp_prepare_start(void)
+{
+	struct scp_bridge *b = smp_load_acquire(&bridge);
+	unsigned long deadline = jiffies + msecs_to_jiffies(STOP_TIMEOUT_MS);
+	if (!b)
+		return -ENODEV;
+	if (!wait_for_completion_timeout(&b->ready, bridge_remaining(deadline)))
+		return -ETIMEDOUT;
+	/* A FIFO barrier observes earlier GATED events without unbounded flush_work. */
+	reinit_completion(&b->barrier);
+	bridge_enqueue(b, BR_BARRIER, 0, 0);
+	if (!wait_for_completion_timeout(&b->barrier,
+					 bridge_remaining(deadline)))
+		goto timeout;
+	if (atomic_read(&b->stop_pending) &&
+	    !wait_for_completion_timeout(&b->stopped,
+					 bridge_remaining(deadline)))
+		goto timeout;
+	return READ_ONCE(b->failed) ? -EIO : 0;
+timeout:
+	/*
+	 * A STOP already claimed by the worker is known, not an uncertain late ACK.
+	 * Otherwise forbid future retirement and retain clock references.
+	 */
+	atomic_cmpxchg(&b->stop_pending, 1, 2);
+	bridge_fail(b, -ETIMEDOUT, "start synchronization deadline");
+	return -ETIMEDOUT;
+}
+
+static int bridge_probe(struct platform_device *pdev)
+{
+	struct scp_bridge *b;
+	bool ready;
+	int ret;
+	if (!fsm_get_entity())
+		return -EPROBE_DEFER;
+	if (IS_ERR(bridge_region()))
+		return -ENODEV;
+	if (smp_load_acquire(&bridge))
+		return -EBUSY;
+	b = devm_kzalloc(&pdev->dev, sizeof(*b), GFP_KERNEL);
+	if (!b)
+		return -ENOMEM;
+	b->dev = &pdev->dev;
+	b->ap = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(b->ap))
+		return PTR_ERR(b->ap);
+	b->md = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(b->md))
+		return PTR_ERR(b->md);
+	b->clocks[0].id = "infra-ccif2-ap";
+	b->clocks[1].id = "infra-ccif2-md";
+	ret = devm_clk_bulk_get(&pdev->dev, ARRAY_SIZE(b->clocks), b->clocks);
+	if (ret)
+		return ret;
+	spin_lock_init(&b->lock);
+	INIT_WORK(&b->work, bridge_work);
+	init_completion(&b->stopped);
+	init_completion(&b->ready);
+	init_completion(&b->barrier);
+	b->client = (struct mt6897_scp_ccci_client){ bridge_ready,
+						     bridge_receive, b };
+	/* Callbacks only queue work, and all state is initialized before registration. */
+	ret = mt6897_scp_ccci_register(&b->client, &ready);
+	if (ret)
+		return ret;
+	smp_store_release(&bridge, b);
+	smp_store_release(&b->active, true);
+	schedule_work(&b->work);
+	if (ready)
+		bridge_ready(b);
+	return 0;
+}
+static const struct of_device_id bridge_of_match[] = {
+	{ .compatible = "mediatek,mt6897-ccci-scp" },
+	{}
+};
+static struct platform_driver bridge_driver = {
+	.probe = bridge_probe,
+	.driver = { .name = "mt6897-ccci-scp",
+		    .of_match_table = bridge_of_match,
+		    .suppress_bind_attrs = true },
+};
+int mt6897_ccci_scp_register(void)
+{
+	return platform_driver_register(&bridge_driver);
+}
