+/**
+ * mtk_mmsys_dsi_cphy_config - validate or restore MT6897 C-PHY lane routing
+ * @dev: DSI controller's parent MMSYS device
+ * @configure: false validates the provider without MMIO or power references;
+ *             true restores routing with caller-owned runtime-PM and config
+ *             clock references, held until the DSI link has powered down
+ *
+ * Return: zero on success, or a negative error for an unsupported/unready parent.
+ */
+int mtk_mmsys_dsi_cphy_config(struct device *dev, bool configure)
+{
+	struct mtk_mmsys *mmsys;
+	unsigned long flags;
+
+	if (!dev || !dev->of_node ||
+	    (!of_device_is_compatible(dev->of_node, "mediatek,mt6897-dispsys0") &&
+	     !of_device_is_compatible(dev->of_node, "mediatek,mt6897-dispsys1")))
+		return -EINVAL;
+	mmsys = dev_get_drvdata(dev);
+	if (!mmsys || !mmsys->data->dsi_cphy_config)
+		return -EPROBE_DEFER;
+	if (!configure)
+		return 0;
+
+	/*
+	 * MT6897 no-swap C-PHY routing, restored after each DIS power loss.
+	 * MiCode/MTK_kernel_device_modules, 3c4ccd07d5624879555ec710c11bb8818e5cb5c6,
+	 * https://github.com/MiCode/MTK_kernel_device_modules/blob/
+	 * 3c4ccd07d5624879555ec710c11bb8818e5cb5c6/drivers/gpu/drm/mediatek/
+	 * mediatek_v2/mtk_mipi_tx.c (mtk_mipi_tx.c:759).
+	 * Keep reserved fields intact; MSB precedes LSB as in the vendor sequence.
+	 */
+	spin_lock_irqsave(&mmsys->lock, flags);
+	mtk_mmsys_update_bits(mmsys, MT6897_DSI_SEL_CONFIG_MSB,
+			     MT6897_DSI_SEL_CONFIG_MSB_MASK,
+			     MT6897_DSI_CPHY_NO_SWAP, NULL);
+	mtk_mmsys_update_bits(mmsys, MT6897_DSI_SEL_CONFIG_LSB,
+			     MT6897_DSI_SEL_CONFIG_LSB_MASK, 0, NULL);
+	spin_unlock_irqrestore(&mmsys->lock, flags);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_mmsys_dsi_cphy_config);
+
 /**
  * mtk_mmsys_hw_connect - Connect MultiMedia Subsystem (MMSYS) Hardware IPs
