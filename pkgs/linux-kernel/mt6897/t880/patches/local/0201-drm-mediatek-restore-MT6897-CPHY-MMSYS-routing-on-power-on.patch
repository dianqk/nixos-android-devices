index 0000000000..2d7725c5ac
--- /dev/null
+++ b/tools/testing/selftests/mtk_clk/dsi_mmsys_cases.c
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <errno.h>
+#define EPROBE_DEFER 517
+#define BIT(n) (1U << (n))
+#define GENMASK(h, l) ((~0U << (l)) & (~0U >> (31 - (h))))
+struct device {
+	const char *of_node;
+	void *data;
+};
+struct mtk_mmsys_driver_data {
+	bool dsi_cphy_config;
+};
+struct mtk_mmsys {
+	const struct mtk_mmsys_driver_data *data;
+	int lock;
+	uint32_t regs[128];
+};
+static int writes, offsets[4];
+static bool of_device_is_compatible(const char *node, const char *compatible)
+{
+	return !strcmp(node, compatible);
+}
+static void *dev_get_drvdata(struct device *dev)
+{
+	return dev->data;
+}
+#define spin_lock_irqsave(lock, flags) ((void)(lock), (flags) = 0)
+#define spin_unlock_irqrestore(lock, flags) ((void)(lock), (void)(flags))
+static void mtk_mmsys_update_bits(struct mtk_mmsys *m, unsigned int offset,
+				  unsigned int mask, unsigned int value,
+				  void *packet)
+{
+	offsets[writes++] = offset;
+	m->regs[offset / 4] = (m->regs[offset / 4] & ~mask) | (value & mask);
+}
+/* PRODUCTION */
+int main(void)
+{
+	const struct mtk_mmsys_driver_data supported = { .dsi_cphy_config =
+								 true };
+	const struct mtk_mmsys_driver_data unsupported = { 0 };
+	struct mtk_mmsys m = { .data = &supported };
+	struct device d = { .data = &m };
+	assert(mtk_mmsys_dsi_cphy_config(NULL, false) == -EINVAL);
+	assert(mtk_mmsys_dsi_cphy_config(&d, false) == -EINVAL);
+	d.of_node = "mediatek,mt6897-ovlsys0";
+	assert(mtk_mmsys_dsi_cphy_config(&d, true) == -EINVAL && !writes);
+	for (int bank = 0; bank < 2; bank++) {
+		d.of_node = bank ? "mediatek,mt6897-dispsys1" :
+				   "mediatek,mt6897-dispsys0";
+		d.data = NULL;
+		assert(mtk_mmsys_dsi_cphy_config(&d, true) == -EPROBE_DEFER);
+		d.data = &m;
+		m.data = &unsupported;
+		assert(mtk_mmsys_dsi_cphy_config(&d, true) == -EPROBE_DEFER);
+		m.data = &supported;
+		writes = 0;
+		assert(!mtk_mmsys_dsi_cphy_config(&d, false) && !writes);
+		for (int cycle = 0; cycle < 2; cycle++) {
+			m.regs[0x170 / 4] = 0xa5ffffff;
+			m.regs[0x174 / 4] = 0xfff8888e;
+			writes = 0;
+			assert(!mtk_mmsys_dsi_cphy_config(&d, true));
+			assert(writes == 2 && offsets[0] == 0x174 &&
+			       offsets[1] == 0x170);
+			assert(m.regs[0x170 / 4] == 0xa5f00000);
+			assert(m.regs[0x174 / 4] == (0xfff8888e | 0x62101));
+			/* Repeat after simulated context loss, preserving new reserved bits. */
+		}
+	}
+	puts("MMSYS routing: both banks, validation purity, reserved bits and restore order passed");
+}
