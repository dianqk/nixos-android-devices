+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Exercise actual DSI first/last power and owner callbacks with host mocks."""
+from pathlib import Path
+import os
+import re
+import subprocess
+import tempfile
+
+assets = Path(__file__).resolve().parent
+repo = Path(os.environ.get('KERNEL_SRC', str(assets.parents[3])))
+source = (repo / 'drivers/gpu/drm/mediatek/mtk_dsi.c').read_text()
+
+
+def function(name, text=source):
+    match = re.search(r'^(?:static )?(?:int|void|ssize_t)\s*' + name + r'\(', text, re.M)
+    start = match.start()
+    end = text.index('{', start) + 1
+    depth = 1
+    while depth:
+        depth += (text[end] == '{') - (text[end] == '}')
+        end += 1
+    return text[start:end]
+
+
+production = '\n'.join(function(name) for name in [
+    'mtk_dsi_poweron', 'mtk_dsi_poweroff', 'mtk_dsi_bridge_atomic_disable',
+    'mtk_dsi_bridge_atomic_enable', 'mtk_dsi_bridge_atomic_pre_enable',
+    'mtk_dsi_bridge_atomic_post_disable', 'mtk_dsi_ddp_start', 'mtk_dsi_ddp_stop',
+    'mtk_dsi_host_transfer'])
+transfer = function('mtk_dsi_host_transfer')
+assert transfer.index('!READ_ONCE(dsi->power_ready)') < transfer.index('readl(')
+assert transfer.index('!READ_ONCE(lead->power_ready)') < transfer.index('readl(')
+mmsys = (repo / 'drivers/soc/mediatek/mtk-mmsys.c').read_text()
+routing = function('mtk_mmsys_dsi_cphy_config', mmsys)
+header = (repo / 'drivers/soc/mediatek/mt6897-mmsys.h').read_text()
+constants = header[header.index('#define MT6897_DSI_SEL_CONFIG_LSB'):
+                   header.index('/* OVLSYS */')]
+with tempfile.TemporaryDirectory(prefix='mtk-dsi-routing-') as tmp:
+    tmp = Path(tmp)
+    for filename, body in [
+        ('dsi', (assets / 'dsi_routing_cases.c').read_text().replace(
+            '/* PRODUCTION */', production)),
+        ('mmsys', (assets / 'dsi_mmsys_cases.c').read_text().replace(
+            '/* PRODUCTION */', constants + routing)),
+    ]:
+        c = tmp / (filename + '.c')
+        c.write_text(body)
+        binary = tmp / filename
+        subprocess.run([os.environ.get('CC', 'cc'), '-std=gnu11', '-Wall', '-Wextra',
+                        '-Wno-unused-parameter', '-Werror', '-g',
+                        '-fsanitize=address,undefined', str(c), '-o', str(binary)],
+                       check=True)
+        subprocess.run([str(binary)], check=True)
