+// SPDX-License-Identifier: GPL-2.0-only
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <errno.h>
+#include <sys/types.h>
+#include <string.h>
+
+typedef uint8_t u8;
+typedef uint32_t u32;
+typedef uint64_t u64;
+#define READ_ONCE(x) (x)
+#define CMD_DONE_INT_FLAG 1
+#define LPRX_RD_RDY_INT_FLAG 2
+#define DSI_RX_DATA0 0
+#define MTK_DSI_HOST_IS_READ(type) ((type) == 1)
+#define drm_info(dev, ...) ((void)(dev))
+#define WRITE_ONCE(x, v) ((x) = (v))
+#define WARN_ON(x) (assert(!(x)), false)
+#define DIV_ROUND_UP_ULL(a, b) (((a) + (b) - 1) / (b))
+#define DIV_ROUND_CLOSEST_ULL(a, b) (((a) + (b) / 2) / (b))
+#define dev_err(dev, ...) ((void)(dev))
+#define drm_err(dev, ...) ((void)(dev))
+#define FORCE_COMMIT 1
+#define BYPASS_SHADOW 2
+#define DSI_DUAL_EN 4
+#define MODE 1
+#define VM_DONE_INT_FLAG 2
+#define DSI_SHADOW_DEBUG 0
+#define DSI_CON_CTRL 1
+#define DSI_MODE_CTRL 2
+#define DSI_TXRX_CTRL 3
+struct clk {
+	int refs, id;
+};
+struct device {
+	void *data;
+	int pm, id;
+};
+struct phy {
+	int refs, id;
+};
+struct drm_device {
+	int unused;
+};
+struct drm_bridge {
+	struct drm_device *dev;
+};
+struct drm_atomic_commit {
+	int unused;
+};
+struct mtk_dsi_driver_data {
+	int reg_adv[4], reg_main[4];
+	bool tx_buf;
+	int dsi_sram_bytes;
+	bool reg_qos;
+};
+struct mipi_dsi_host {
+	struct device *dev;
+};
+struct mipi_dsi_msg {
+	int type;
+	void *rx_buf;
+	const void *tx_buf;
+	ssize_t rx_len;
+};
+struct mtk_dsi {
+	bool enabled;
+	const struct mtk_dsi_driver_data *driver_data;
+	struct mipi_dsi_host host;
+	struct drm_bridge bridge;
+	struct {
+		int bits_per_pixel;
+	} *dsc;
+	struct {
+		int pixelclock;
+	} vm;
+	struct clk *config_clk, *engine_clk, *digital_clk, *hs_clk;
+	struct device *mmsys_dev;
+	struct phy *phy;
+	struct mtk_dsi *slave, *master;
+	int refcount, format, lanes;
+	unsigned long hs_rate;
+	u32 data_rate, symbol_rate;
+	bool cphy, is_slave, power_ready, bridge_powered, ddp_powered,
+		lanes_ready;
+	u32 *regs;
+};
+static int fail_at, calls, writes, route[2], event[256], n;
+static bool legacy;
+static int step(int id)
+{
+	event[n++] = id;
+	return ++calls == fail_at ? -EIO : 0;
+}
+static int mipi_dsi_pixel_format_to_bpp(int f)
+{
+	return f ? f : -EINVAL;
+}
+static int clk_set_rate(struct clk *c, unsigned long rate)
+{
+	return step(10 + c->id);
+}
+static int pm_runtime_resume_and_get(struct device *d)
+{
+	int ret = step(20 + d->id);
+	if (!ret)
+		d->pm++;
+	return ret;
+}
+static void pm_runtime_put(struct device *d)
+{
+	assert(d->pm-- > 0);
+	event[n++] = -20 - d->id;
+}
+static int clk_prepare_enable(struct clk *c)
+{
+	int ret = step(30 + c->id);
+	if (!ret)
+		c->refs++;
+	return ret;
+}
+static void clk_disable_unprepare(struct clk *c)
+{
+	assert(c->refs-- > 0);
+	event[n++] = -30 - c->id;
+}
+static int mtk_mmsys_dsi_cphy_config(struct device *d, bool configure)
+{
+	assert(configure && d->pm > 0);
+	int ret = step(40 + d->id);
+	if (!ret)
+		route[d->id] = 0x62101;
+	return ret;
+}
+static int phy_power_on(struct phy *p)
+{
+	assert(legacy || route[p->id] == 0x62101);
+	int ret = step(50 + p->id);
+	if (!ret)
+		p->refs++;
+	return ret;
+}
+static void phy_power_off(struct phy *p)
+{
+	assert(p->refs-- > 0);
+	event[n++] = -50 - p->id;
+}
+static void *dev_get_drvdata(struct device *d)
+{
+	return d->data;
+}
+static struct mtk_dsi *bridge_to_dsi(struct drm_bridge *b)
+{
+	return (struct mtk_dsi *)((char *)b -
+				  __builtin_offsetof(struct mtk_dsi, bridge));
+}
+#define NOOP(name)                                      \
+	static void name(struct mtk_dsi *d)             \
+	{                                               \
+		assert(legacy || d->mmsys_dev->pm > 0); \
+		writes++;                               \
+	}
+NOOP(mtk_dsi_set_mode)
+NOOP(mtk_dsi_start)
+NOOP(mtk_dsi_enable)
+NOOP(mtk_dsi_disable)
+NOOP(mtk_dsi_reset_engine)
+NOOP(mtk_dsi_stop)
+NOOP(mtk_dsi_set_cmd_mode)
+NOOP(mtk_dsi_phy_timconfig)
+NOOP(mtk_dsi_config_tx_buf_v1)
+NOOP(mtk_dsi_config_hw_buffers)
+NOOP(mtk_dsi_set_vm_cmd)
+NOOP(mtk_dsi_set_interrupt_enable)
+NOOP(mtk_dsi_lane0_ulp_mode_enter)
+NOOP(mtk_dsi_clk_ulp_mode_enter)
+NOOP(mtk_dsi_lane_ready)
+NOOP(mtk_output_dsi_enable)
+NOOP(mtk_output_dsi_disable)
+static void mtk_dsi_ps_control(struct mtk_dsi *d, bool enable)
+{
+	writes++;
+}
+static void mtk_dsi_clk_hs_mode(struct mtk_dsi *d, int mode)
+{
+	writes++;
+}
+static void mtk_dsi_mask(struct mtk_dsi *d, int reg, int mask, int value)
+{
+	writes++;
+}
+static int mtk_dsi_config_vdo_timing(struct mtk_dsi *d)
+{
+	return step(60 + d->mmsys_dev->id);
+}
+static int mtk_dsi_switch_to_cmd_mode(struct mtk_dsi *d, int flag, int timeout)
+{
+	return 0;
+}
+static u32 readl(u32 *p)
+{
+	return *p;
+}
+static void writel(u32 v, u32 *p)
+{
+	*p = v;
+	writes++;
+}
+#define msleep(x) ((void)0)
+static struct mtk_dsi *host_to_dsi(struct mipi_dsi_host *host)
+{
+	return (struct mtk_dsi *)((char *)host -
+				  __builtin_offsetof(struct mtk_dsi, host));
+}
+static int mtk_dsi_host_send_cmd(struct mtk_dsi *d,
+				 const struct mipi_dsi_msg *msg, u8 irq)
+{
+	writes++;
+	return 0;
+}
+static ssize_t mtk_dsi_recv_cnt(u8 type, u8 *data)
+{
+	return 0;
+}
+static u8 readb(void *p)
+{
+	return *(u8 *)p;
+}
+/* PRODUCTION */
+
+static struct mtk_dsi d[2];
+static struct device dev[2];
+static struct clk clocks[2][4];
+static struct phy phys[2];
+static u32 regs[2][4];
+static const struct mtk_dsi_driver_data data = { .reg_main = { 0, 1, 2, 3 } };
+static void setup(bool dual)
+{
+	calls = writes = n = fail_at = 0;
+	legacy = false;
+	for (int i = 0; i < 2; i++) {
+		dev[i] = (struct device){ .id = i, .data = &d[i] };
+		phys[i] = (struct phy){ .id = i };
+		for (int j = 0; j < 4; j++)
+			clocks[i][j] = (struct clk){ .id = i * 4 + j };
+		d[i] = (struct mtk_dsi){ .driver_data = &data,
+					 .host.dev = &dev[i],
+					 .mmsys_dev = &dev[i],
+					 .phy = &phys[i],
+					 .regs = regs[i],
+					 .config_clk = &clocks[i][0],
+					 .engine_clk = &clocks[i][1],
+					 .digital_clk = &clocks[i][2],
+					 .hs_clk = &clocks[i][3],
+					 .cphy = true,
+					 .format = 24,
+					 .lanes = 3,
+					 .hs_rate = 100 };
+		route[i] = 0;
+	}
+	if (dual)
+		d[0].slave = &d[1];
+}
+static void balanced(void)
+{
+	for (int i = 0; i < 2; i++) {
+		assert(!dev[i].pm && !phys[i].refs && !d[i].refcount &&
+		       !d[i].power_ready);
+		for (int j = 0; j < 4; j++)
+			assert(!clocks[i][j].refs);
+	}
+}
+int main(void)
+{
+	setup(true);
+	assert(!mtk_dsi_poweron(&d[0]));
+	int operations = calls;
+	assert(d[0].power_ready && d[1].power_ready);
+	mtk_dsi_poweroff(&d[0]);
+	balanced();
+	for (int f = 1; f <= operations; f++) {
+		setup(true);
+		fail_at = f;
+		assert(mtk_dsi_poweron(&d[0]) == -EIO);
+		assert(calls == f);
+		balanced();
+	}
+	setup(false);
+	d[0].format = 0;
+	assert(mtk_dsi_poweron(&d[0]) == -EINVAL && !calls && !writes);
+	balanced();
+	setup(true);
+	for (int cycle = 0; cycle < 2; cycle++) {
+		route[0] = route[1] = 0; /* DIS context loss */
+		mtk_dsi_bridge_atomic_pre_enable(&d[0].bridge, NULL);
+		mtk_dsi_ddp_start(&dev[0]);
+		assert(d[0].refcount == 2 && d[1].refcount == 1);
+		mtk_dsi_bridge_atomic_enable(&d[0].bridge, NULL);
+		mtk_dsi_bridge_atomic_disable(&d[0].bridge, NULL);
+		mtk_dsi_bridge_atomic_post_disable(&d[0].bridge, NULL);
+		assert(d[0].power_ready && dev[0].pm == 1);
+		mtk_dsi_ddp_stop(&dev[0]);
+		balanced();
+	}
+	setup(false);
+	mtk_dsi_ddp_start(&dev[0]);
+	/* Duplicate owner callbacks cannot stack references. */
+	mtk_dsi_ddp_start(&dev[0]);
+	assert(d[0].refcount == 1);
+	mtk_dsi_ddp_stop(&dev[0]);
+	mtk_dsi_ddp_stop(&dev[0]);
+	balanced();
+	setup(false);
+	fail_at = 2; /* Config gate, before route/PHY/DSI MMIO. */
+	mtk_dsi_bridge_atomic_pre_enable(&d[0].bridge, NULL);
+	assert(!writes && !d[0].bridge_powered);
+	assert(mtk_dsi_host_transfer(&d[0].host, &(struct mipi_dsi_msg){ 0 }) ==
+	       -EIO);
+	/* A ready slave still cannot transfer while its master is incomplete. */
+	d[1].master = &d[0];
+	d[1].power_ready = true;
+	assert(mtk_dsi_host_transfer(&d[1].host, &(struct mipi_dsi_msg){ 0 }) ==
+	       -EIO);
+	d[1].power_ready = false;
+	mtk_dsi_bridge_atomic_enable(&d[0].bridge, NULL);
+	mtk_dsi_bridge_atomic_disable(&d[0].bridge, NULL);
+	mtk_dsi_bridge_atomic_post_disable(&d[0].bridge, NULL);
+	assert(!writes);
+	balanced();
+	setup(true);
+	/* A shadow DDP owner survives a failed independent master acquisition. */
+	mtk_dsi_ddp_start(&dev[1]);
+	fail_at = calls + 2;
+	mtk_dsi_bridge_atomic_pre_enable(&d[0].bridge, NULL);
+	assert(!d[0].refcount && d[1].refcount == 1 && d[1].ddp_powered);
+	mtk_dsi_bridge_atomic_post_disable(&d[0].bridge, NULL);
+	mtk_dsi_ddp_stop(&dev[1]);
+	balanced();
+	setup(false);
+	legacy = true;
+	d[0].config_clk = NULL;
+	mtk_dsi_bridge_atomic_pre_enable(&d[0].bridge, NULL);
+	mtk_dsi_ddp_start(&dev[0]);
+	assert(d[0].refcount == 2 && !dev[0].pm && !route[0]);
+	mtk_dsi_bridge_atomic_post_disable(&d[0].bridge, NULL);
+	mtk_dsi_ddp_stop(&dev[0]);
+	balanced();
+	puts("DSI routing: dual-link acquisition failure sweep, ownership and context-loss replay passed");
+}
