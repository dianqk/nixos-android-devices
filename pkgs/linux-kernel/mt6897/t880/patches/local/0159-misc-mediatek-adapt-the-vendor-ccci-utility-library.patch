diff --git a/drivers/misc/mediatek/ccci_util/ccci_util_lib_reserved_mem.c b/drivers/misc/mediatek/ccci_util/ccci_util_lib_reserved_mem.c
index f55a03ff38..9170e490c3 100644
--- a/drivers/misc/mediatek/ccci_util/ccci_util_lib_reserved_mem.c
+++ b/drivers/misc/mediatek/ccci_util/ccci_util_lib_reserved_mem.c
@@ -74,6 +74,18 @@ EXPORT_SYMBOL(vmap_reserved_mem);
 int free_reserved_memory(phys_addr_t start_phys,
 				phys_addr_t end_phys)
 {
+	/*
+	 * The modem regions are LK's no-map reservations: giving them to the
+	 * page allocator corrupts memory (the MT6895 port saw UFS DMA oopses).
+	 * Never free them.
+	 */
+	pr_notice("%s: refusing to free %pa-%pa\n", __func__, &start_phys, &end_phys);
+	return -EPERM;
+}
+
+static int __maybe_unused free_reserved_memory_vendor(phys_addr_t start_phys,
+						      phys_addr_t end_phys)
+{
 
 	phys_addr_t pos;
 	unsigned long pages = 0;
