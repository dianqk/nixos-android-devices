diff --git a/drivers/misc/mediatek/ccci_util/ccci_util_decls.h b/drivers/misc/mediatek/ccci_util/ccci_util_decls.h
new file mode 100644
index 0000000000..42aaccffed
--- /dev/null
+++ b/drivers/misc/mediatek/ccci_util/ccci_util_decls.h
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Declarations of the vendor ccci_util functions that are shared between
+ * its files (or with the modem driver) without a header, included in every
+ * file of the library through the Makefile.
+ */
+#ifndef __CCCI_UTIL_DECLS_H__
+#define __CCCI_UTIL_DECLS_H__
+
+#include <linux/poll.h>
+#include <linux/types.h>
+#include <linux/pgtable.h>
+#include "mt-plat/mtk_ccci_common.h"
+#include "ccci_util_lib_main.h"
+#include "ccci_util_lib_reserved_mem.h"
+#include "ccci_util_lib_sys.h"
+#include "ccci_util_md_mem.h"
+#include "ccci_util_sib.h"
+
+struct file;
+
+int lk_tag_inf_parsing_to_args_table(void);
+unsigned int get_md_smem_align(void);
+char *ccci_get_ap_platform(void);
+int ccci_get_plat_ft_inf(char buf[], int size);
+unsigned int ccci_log_poll(struct file *fp, struct poll_table_struct *poll);
+unsigned int ccci_dump_fops_poll(struct file *fp, struct poll_table_struct *poll);
+void inject_md_status_event(int event_type, char reason[]);
+int get_lock_rst_user_list(char list_buff[], int size);
+long ccci_util_bc_compat_ioctl(struct file *filp, unsigned int cmd, unsigned long arg);
+unsigned int ccci_sib_poll(struct file *fp, struct poll_table_struct *poll);
+unsigned int mtk_ccci_get_md_img_cap(void);
+void set_soc_md_rt_rat(unsigned int bitmap, unsigned int id);
+bool spm_is_md1_sleep(void);
+void spm_ap_mdsrc_req(u8 lock);
+unsigned int mt_irq_get_pending(unsigned int irq);
+bool is_clk_buf_from_pmic(void);
+void clk_buf_get_swctrl_status(void *swctrl_status);
+void clk_buf_get_rf_drv_curr(void *rf_drv_curr);
+void clk_buf_save_afc_val(unsigned int afcdac);
+int rawbulk_push_upstream_buffer(int transfer_id, const void *buffer, unsigned int length);
+int free_reserved_memory(phys_addr_t start_phys, phys_addr_t end_phys);
+void *vmap_reserved_mem(phys_addr_t start, phys_addr_t size, pgprot_t prot);
+
+#endif
