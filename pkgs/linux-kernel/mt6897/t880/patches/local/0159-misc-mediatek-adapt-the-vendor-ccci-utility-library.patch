+ccflags-y += -I$(srctree)/drivers/misc/mediatek/include
+ccflags-y += -I$(srctree)/drivers/misc/mediatek/ccci_util
+ccflags-y += -include $(srctree)/drivers/misc/mediatek/ccci_util/ccci_util_decls.h
