 .../ccci_util/ccci_util_lib_reserved_mem.c    | 12 +++
 .../mediatek/ccci_util/ccci_util_lib_sys.h    |  2 +-
 .../ccci_util/ccci_util_pin_broadcast.c       |  2 +-
