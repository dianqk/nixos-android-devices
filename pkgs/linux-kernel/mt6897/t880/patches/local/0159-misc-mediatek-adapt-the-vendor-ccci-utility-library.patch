diff --git a/drivers/misc/mediatek/ccci_util/Kconfig b/drivers/misc/mediatek/ccci_util/Kconfig
index 9805aff6d0..05843da3b7 100644
--- a/drivers/misc/mediatek/ccci_util/Kconfig
+++ b/drivers/misc/mediatek/ccci_util/Kconfig
@@ -1,38 +1,13 @@
-menuconfig MTK_CCCI_DEVICES
-	bool "CCCI Devices"
+# SPDX-License-Identifier: GPL-2.0-only
+config MTK_CCCI_UTIL
+	tristate "MediaTek CCCI utility library"
+	depends on OF && ARM64
 	help
-	  Cross Core Communication Interface:
-	  Say Y here to enable CCCI basic
-	  support. If you say N,
-	  all CCCI related code
-	  (including dummy API) will be disable.
-
-config MTK_MD1_SUPPORT
-	int "configure modem 1 boot up capability"
-	depends on MTK_CCCI_DRIVER || MTK_CCCI_EXT || MTK_ECCCI_DRIVER
-	default 0
-	help
-	  modem 1 mode:
-	  0=>invalid,
-	  1=>2g,
-	  2=>3g,
-	  3=>wg,
-	  4=>tg,
-	  5=>lwg,
-	  6=>ltg,
-	  7=>sglte,
-	  8=>ultg,
-	  9=>ulwg,
-	  10=>ulwtg,
-	  11=>ulwcg,
-	  12=>ulwctg,
-	  13=>ulttg,
-	  14=>ulfwg,
-	  15=>ulfwcg,
-	  16=>ulctg,
-	  17=>ultctg,
-	  18=>ultwg,
-	  19=>ultwcg,
-	  20=>ulftg,
-	  21=>ulfctg
+	  The MediaTek Cross Core Communication Interface utility library:
+	  the modem boot information LK leaves (the tag list behind
+	  "ccci,modem_info_v2"), the reserved and shared memory layout of the
+	  modem, its image header checks and the CCCI logs. It neither powers
+	  nor starts the modem.
 
+	  Build it as a module and load it by hand while the modem driver is
+	  brought up.
