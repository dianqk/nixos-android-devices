--- /dev/null
+++ b/drivers/gpu/drm/mediatek/mtk_disp_va.h
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __MTK_DISP_VA_H
+#define __MTK_DISP_VA_H
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/kconfig.h>
+#include <linux/of.h>
+#if IS_ENABLED(CONFIG_DRM_MEDIATEK_MT6897_VA_BOOTSTRAP)
+int mtk_disp_va_bootstrap_gate(struct device *consumer);
+int mtk_disp_va_runtime_gate(struct device *consumer);
+#else
+static inline int mtk_disp_va_bootstrap_gate(struct device *consumer)
+{
+	if (consumer->parent &&
+	    of_property_present(consumer->parent->of_node,
+				"mediatek,display-va-bootstrap"))
+		return -EOPNOTSUPP;
+	return 0;
+}
+static inline int mtk_disp_va_runtime_gate(struct device *consumer)
+{
+	return mtk_disp_va_bootstrap_gate(consumer);
+}
+#endif
+#endif
