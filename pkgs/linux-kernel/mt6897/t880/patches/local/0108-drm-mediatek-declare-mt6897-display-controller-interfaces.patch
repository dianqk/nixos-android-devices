diff --git a/drivers/soc/mediatek/mt6897-mmsys.h b/drivers/soc/mediatek/mt6897-mmsys.h
new file mode 100644
index 0000000000..3b054d0320
--- /dev/null
+++ b/drivers/soc/mediatek/mt6897-mmsys.h
@@ -0,0 +1,221 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#ifndef __SOC_MEDIATEK_MT6897_MMSYS_H
+#define __SOC_MEDIATEK_MT6897_MMSYS_H
+
+/*
+ * MT6897 display: two OVLSYS and two DISPSYS controllers. Each OVLSYS
+ * blends its layers in a chain of OVL_2L engines and hands the result
+ * to its DISPSYS through an asynchronous direct link (DLO -> DLI relay,
+ * no mux of its own). In the DISPSYS the PQ chain sits between the PQ
+ * input and output crossbars; these routes take the PQ bypass (PQ input
+ * crossbar 0 straight to PQ output crossbar 3) and go on to the DSC
+ * cores and the DSI, which is what a panel needs before the PQ engines
+ * are supported. For a dual-port panel the second pipe goes from
+ * DISPSYS1 to DSC core 1 in DISPSYS0 and back to DSI1 in DISPSYS1.
+ *
+ * Crossbar registers (bit assignments as in the vendor driver, which
+ * shares them with MT6985).
+ */
+
+/* OVLSYS */
+#define MT6897_OVL_CON				0xf08
+#define MT6897_OVL_CON_OVL0_TO_BG		BIT(1)
+#define MT6897_OVL_CON_OVL1_TO_BG		BIT(3)
+#define MT6897_OVL_CON_OVL2_TO_BLEND		BIT(4)
+#define MT6897_OVL_BG_CROSSBAR0_MOUT_EN		0xf10
+#define MT6897_OVL_BG0_TO_OVL1			BIT(1)
+#define MT6897_OVL_BG_CROSSBAR1_MOUT_EN		0xf14
+#define MT6897_OVL_BG1_TO_OVL2			BIT(2)
+#define MT6897_OVL_BLEND_CROSSBAR2_MOUT_EN	0xf40
+#define MT6897_OVL_BLEND2_TO_DLO_RELAY3		BIT(0)
+#define MT6897_OVL_CON_OVL3_TO_BLEND		BIT(6)
+#define MT6897_OVL_BLEND_CROSSBAR3_MOUT_EN	0xf44
+#define MT6897_OVL_BLEND3_TO_DLO_RELAY5		BIT(2)
+
+/* DISPSYS */
+#define MT6897_COMP_OUT_CROSSBAR1_MOUT_EN	0xea4
+#define MT6897_DSC0_TO_MERGE_OUT_CROSSBAR0	BIT(0)
+#define MT6897_COMP_OUT_CROSSBAR2_MOUT_EN	0xea8
+#define MT6897_DSC1_TO_MERGE_OUT_CROSSBAR1	BIT(1)
+#define MT6897_COMP_OUT_CROSSBAR3_MOUT_EN	0xeac
+#define MT6897_PANEL_COMP_OUT3_TO_MERGE_OUT_CROSSBAR0	BIT(0)
+#define MT6897_COMP_OUT_CROSSBAR6_MOUT_EN	0xeb8
+#define MT6897_DLI_RELAY5_TO_MERGE_OUT_CROSSBAR1	BIT(1)
+#define MT6897_MERGE_OUT_CROSSBAR0_MOUT_EN	0xf0c
+#define MT6897_MERGE_OUT0_TO_DSI0		BIT(0)
+#define MT6897_MERGE_OUT0_TO_DLO_RELAY0		BIT(4)
+#define MT6897_MERGE_OUT_CROSSBAR1_MOUT_EN	0xf10
+#define MT6897_MERGE_OUT1_TO_DSI0		BIT(0)
+#define MT6897_MERGE_OUT1_TO_DLO_RELAY1		BIT(5)
+/* Crossbar shadow control: bypass bit 0 plus bits 23:16 (stock 0xff0001) */
+#define MT6897_DISPSYS_BYPASS_MUX_SHADOW	0xc30
+#define MT6897_OVLSYS_BYPASS_MUX_SHADOW		0xf00
+#define MT6897_BYPASS_MUX_SHADOW_ALL		(GENMASK(23, 16) | BIT(0))
+#define MT6897_PANEL_COMP_OUT_CROSSBAR0_MOUT_EN	0xf48
+#define MT6897_PANEL_COMP_OUT_CROSSBAR1_MOUT_EN	0xf4c
+#define MT6897_CROSSBAR_ALL			GENMASK(15, 0)
+#define MT6897_PQ_OUT1_TO_DSC0			BIT(1)
+#define MT6897_PQ_OUT1_TO_COMP_OUT_CROSSBAR3	BIT(3)
+#define MT6897_PANEL_COMP_OUT_CROSSBAR4_MOUT_EN	0xf58
+#define MT6897_DLI_RELAY4_TO_DSC1		BIT(2)
+#define MT6897_PANEL_COMP_OUT_CROSSBAR1_SEL_IN	0xf60
+#define MT6897_PANEL_COMP_OUT_CROSSBAR2_SEL_IN	0xf64
+#define MT6897_PANEL_COMP_OUT_CROSSBAR3_SEL_IN	0xf68
+#define MT6897_PANEL_COMP_OUT_SEL_IN_MASK	GENMASK(2, 0)
+#define MT6897_SEL_IN_FROM_PQ_OUT1		1
+#define MT6897_SEL_IN_FROM_DLI_RELAY4		4
+#define MT6897_PQ_IN_CROSSBAR0_MOUT_EN		0xf74
+#define MT6897_DLI_RELAY0_TO_PQ_OUT_CROSSBAR3	BIT(2)
+#define MT6897_PQ_OUT_CROSSBAR3_MOUT_EN		0xfa4
+#define MT6897_PQ_OUT3_TO_PANEL_COMP_OUT1	BIT(1)
+/*
+ * DisplayPort: DLI relay 2 -> PQ output crossbar 4 -> panel/comp output
+ * crossbar 2 -> comp output crossbar 4 -> merge output crossbar 2 ->
+ * DP_INTF0. The vendor goes through merge output crossbar 1, whose input
+ * lane the right half of the internal panel already uses; crossbar 2
+ * reaches DP_INTF0 as well.
+ */
+#define MT6897_PQ_IN_CROSSBAR2_MOUT_EN		0xf7c
+#define MT6897_DLI_RELAY2_TO_PQ_OUT_CROSSBAR4	BIT(3)
+#define MT6897_PQ_OUT_CROSSBAR4_MOUT_EN		0xfa8
+#define MT6897_PQ_OUT4_TO_PANEL_COMP_OUT2	BIT(2)
+#define MT6897_PANEL_COMP_OUT_CROSSBAR2_MOUT_EN	0xf50
+#define MT6897_PQ_OUT2_TO_COMP_OUT_CROSSBAR4	BIT(4)
+#define MT6897_COMP_OUT_CROSSBAR4_MOUT_EN	0xeb0
+#define MT6897_PANEL_COMP_OUT4_TO_MERGE_OUT_CROSSBAR2	BIT(2)
+#define MT6897_MERGE_OUT_CROSSBAR2_MOUT_EN	0xf14
+#define MT6897_MERGE_OUT2_TO_DP_INTF0		BIT(1)
+
+static const struct mtk_mmsys_routes mmsys_mt6897_ovlsys_routing_table[] = {
+	/* OVLSYS0: OVL0 -> OVL1 -> OVL2 -> DLO relay 3 */
+	MMSYS_ROUTE(OVL_2L, 0, OVL_2L, 1,
+		    MT6897_OVL_CON, MT6897_OVL_CON_OVL0_TO_BG, MT6897_OVL_CON_OVL0_TO_BG),
+	MMSYS_ROUTE(OVL_2L, 0, OVL_2L, 1,
+		    MT6897_OVL_BG_CROSSBAR0_MOUT_EN, MT6897_OVL_BG0_TO_OVL1,
+		    MT6897_OVL_BG0_TO_OVL1),
+	MMSYS_ROUTE(OVL_2L, 1, OVL_2L, 2,
+		    MT6897_OVL_CON, MT6897_OVL_CON_OVL1_TO_BG, MT6897_OVL_CON_OVL1_TO_BG),
+	MMSYS_ROUTE(OVL_2L, 1, OVL_2L, 2,
+		    MT6897_OVL_BG_CROSSBAR1_MOUT_EN, MT6897_OVL_BG1_TO_OVL2,
+		    MT6897_OVL_BG1_TO_OVL2),
+	MMSYS_ROUTE(OVL_2L, 2, DIRECT_LINK_OUT, 3,
+		    MT6897_OVL_CON, MT6897_OVL_CON_OVL2_TO_BLEND,
+		    MT6897_OVL_CON_OVL2_TO_BLEND),
+	MMSYS_ROUTE(OVL_2L, 2, DIRECT_LINK_OUT, 3,
+		    MT6897_OVL_BLEND_CROSSBAR2_MOUT_EN, MT6897_OVL_BLEND2_TO_DLO_RELAY3,
+		    MT6897_OVL_BLEND2_TO_DLO_RELAY3),
+	/* OVLSYS0, DisplayPort: OVL3 -> DLO relay 5 */
+	MMSYS_ROUTE(OVL_2L, 3, DIRECT_LINK_OUT, 5,
+		    MT6897_OVL_CON, MT6897_OVL_CON_OVL3_TO_BLEND,
+		    MT6897_OVL_CON_OVL3_TO_BLEND),
+	MMSYS_ROUTE(OVL_2L, 3, DIRECT_LINK_OUT, 5,
+		    MT6897_OVL_BLEND_CROSSBAR3_MOUT_EN, MT6897_OVL_BLEND3_TO_DLO_RELAY5,
+		    MT6897_OVL_BLEND3_TO_DLO_RELAY5),
+	/* OVLSYS1: OVL4 -> OVL5 -> OVL6 -> DLO relay 3, same registers */
+	MMSYS_ROUTE(OVL_2L, 4, OVL_2L, 5,
+		    MT6897_OVL_CON, MT6897_OVL_CON_OVL0_TO_BG, MT6897_OVL_CON_OVL0_TO_BG),
+	MMSYS_ROUTE(OVL_2L, 4, OVL_2L, 5,
+		    MT6897_OVL_BG_CROSSBAR0_MOUT_EN, MT6897_OVL_BG0_TO_OVL1,
+		    MT6897_OVL_BG0_TO_OVL1),
+	MMSYS_ROUTE(OVL_2L, 5, OVL_2L, 6,
+		    MT6897_OVL_CON, MT6897_OVL_CON_OVL1_TO_BG, MT6897_OVL_CON_OVL1_TO_BG),
+	MMSYS_ROUTE(OVL_2L, 5, OVL_2L, 6,
+		    MT6897_OVL_BG_CROSSBAR1_MOUT_EN, MT6897_OVL_BG1_TO_OVL2,
+		    MT6897_OVL_BG1_TO_OVL2),
+	MMSYS_ROUTE(OVL_2L, 6, DIRECT_LINK_OUT, 3,
+		    MT6897_OVL_CON, MT6897_OVL_CON_OVL2_TO_BLEND,
+		    MT6897_OVL_CON_OVL2_TO_BLEND),
+	MMSYS_ROUTE(OVL_2L, 6, DIRECT_LINK_OUT, 3,
+		    MT6897_OVL_BLEND_CROSSBAR2_MOUT_EN, MT6897_OVL_BLEND2_TO_DLO_RELAY3,
+		    MT6897_OVL_BLEND2_TO_DLO_RELAY3),
+};
+
+static const struct mtk_mmsys_routes mmsys_mt6897_dispsys0_routing_table[] = {
+	/* Pipe 0: DLI relay 0 -> PQ bypass -> DSC core 0 */
+	MMSYS_ROUTE(DIRECT_LINK_IN, 0, DSC, 0,
+		    MT6897_PQ_IN_CROSSBAR0_MOUT_EN, MT6897_CROSSBAR_ALL,
+		    MT6897_DLI_RELAY0_TO_PQ_OUT_CROSSBAR3),
+	MMSYS_ROUTE(DIRECT_LINK_IN, 0, DSC, 0,
+		    MT6897_PQ_OUT_CROSSBAR3_MOUT_EN, MT6897_CROSSBAR_ALL,
+		    MT6897_PQ_OUT3_TO_PANEL_COMP_OUT1),
+	/* the bootloader's PQ chain must not keep feeding the panel crossbar */
+	MMSYS_ROUTE(DIRECT_LINK_IN, 0, DSC, 0,
+		    MT6897_PANEL_COMP_OUT_CROSSBAR0_MOUT_EN, MT6897_CROSSBAR_ALL, 0),
+	MMSYS_ROUTE(DIRECT_LINK_IN, 0, DSC, 0,
+		    MT6897_PANEL_COMP_OUT_CROSSBAR1_SEL_IN, MT6897_PANEL_COMP_OUT_SEL_IN_MASK,
+		    MT6897_SEL_IN_FROM_PQ_OUT1),
+	MMSYS_ROUTE(DIRECT_LINK_IN, 0, DSC, 0,
+		    MT6897_PANEL_COMP_OUT_CROSSBAR1_MOUT_EN, MT6897_PQ_OUT1_TO_DSC0,
+		    MT6897_PQ_OUT1_TO_DSC0),
+	/* DSC core 0 -> DSI0 */
+	MMSYS_ROUTE(DSC, 0, DSI, 0,
+		    MT6897_COMP_OUT_CROSSBAR1_MOUT_EN, MT6897_DSC0_TO_MERGE_OUT_CROSSBAR0,
+		    MT6897_DSC0_TO_MERGE_OUT_CROSSBAR0),
+	MMSYS_ROUTE(DSC, 0, DSI, 0,
+		    MT6897_MERGE_OUT_CROSSBAR0_MOUT_EN, MT6897_MERGE_OUT0_TO_DSI0,
+		    MT6897_MERGE_OUT0_TO_DSI0),
