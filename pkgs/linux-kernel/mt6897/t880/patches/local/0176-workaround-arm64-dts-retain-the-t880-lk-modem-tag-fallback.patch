From 1038f4e67a4e75d2c016a28110ca279bafff0526 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Fri, 6 Nov 2026 10:00:00 +0800
Subject: [PATCH] workaround: arm64: dts: retain the T880 LK modem tag fallback

Carry the captured LK modem_info_v2 tag location until U-Boot forwards
the bootloader metadata. Preserve the read-only parser interface.

Original-Commit: local development history
Original-Author: dianqk <dianqk@dianqk.net>
Original-Date: 2026-10-20T04:15:32+08:00
Signed-off-by: dianqk <dianqk@dianqk.net>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/mediatek/mt6897-alldocube-t880.dts | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6897-alldocube-t880.dts b/arch/arm64/boot/dts/mediatek/mt6897-alldocube-t880.dts
index f4868f6730..7cfbc63a9c 100644
--- a/arch/arm64/boot/dts/mediatek/mt6897-alldocube-t880.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6897-alldocube-t880.dts
@@ -206,6 +206,8 @@ memory@40000000 {
 	 */
 	mddriver {
 		compatible = "mediatek,mt6897-mddriver", "mediatek,mddriver";
+		ccci,modem_info_v2 = <0x2fbf 0x00 0x40180000 0x00 0x3000000
+				      0x1c000000 0x1000000 0x00 0x00 0x00 0x00 0x00>;
 		/*
 		 * The vendor modem driver's platform data, as the Android
 		 * DT. The driver power-cycles the modem through its power
-- 
2.56.0

