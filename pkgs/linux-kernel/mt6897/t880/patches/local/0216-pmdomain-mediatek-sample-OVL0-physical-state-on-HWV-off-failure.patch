@@ -139,7 +139,7 @@ struct regmap {
 	bool controlled, bus, drop_first_ack, keep_first_ack, keep_second_ack,
 	    reappear_first_ack, stuck_sram;
 	int calls, fail, stuck, writes, drop_done;
-	u32 pending_clr;
+	u32 pending_clr, last_read;
 };
 struct scpsys_root_clocks {
 	const struct scpsys_root_data *data;
@@ -315,6 +315,7 @@ static int regmap_access(struct regmap *m, bool write)
 }
