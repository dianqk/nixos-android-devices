 static const struct vdec_codec *vdec_codec_by_fourcc(u32 fourcc)
@@ -95,9 +84,7 @@ static const struct v4l2_frmsize_stepwise vdec_capture_size = {
 	16, 4096, 16, 16, 2176, 16,
 };
 
-/* Round a requested dimension down to a step the firmware accepts, inside the
- * range the codec publishes.
- */
+/* Align a CAPTURE allocation dimension within its published range. */
 static u32 vdec_dimension(u32 v, u32 min, u32 max, u32 step)
 {
 	v = clamp_t(u32, v, min, max);
@@ -106,7 +93,7 @@ static u32 vdec_dimension(u32 v, u32 min, u32 max, u32 step)
 
 struct vdec_ctx;
 struct vdec_dev {
-	struct device *dev, *bs_dev, *ube_dev;
+	struct device *dev, *ube_dev, *lat_dev;
 	struct mtk_vcp *vcp;
 	struct mtk_vcp_vdec_hw *hw;
 	struct video_device video;
@@ -117,14 +104,35 @@ struct vdec_dev {
 	struct list_head ctx_list;
 	struct mtk_vcp_vdec_engine *engine;
 };
+struct vdec_buffer {
+	struct v4l2_m2m_buffer m2m;
+	u64 generation;
+};
+struct vdec_direct_plane {
+	struct dma_buf *dbuf;
+	struct dma_buf_attachment *attachment;
+	struct sg_table *mapping;
+	bool shared_mapping;
+	void *mem_priv; /* opaque MMAP identity, never dereferenced after DONE */
+};
+struct vdec_direct_backing {
+	struct vdec_direct_plane plane[2];
+	u64 generation;
+	u32 index;
+	enum vb2_memory memory;
+	u32 offset[2];
+	size_t bytes;
+	bool accounted;
+};
 struct vdec_surface {
 	/* plane[0] owns the entire allocation; plane[1] is a chroma view.
-	 * In direct mode there is no allocation at all: the slot is only a
-	 * handle on the CAPTURE buffer the firmware writes that frame into,
-	 * so sgt stays NULL and vb names the client's buffer.
+	 * Direct mode instead pins the client's DMA-BUF backing independently
+	 * of vb2 metadata. vb is non-NULL only while the driver holds that
+	 * ACTIVE buffer; firmware ownership can outlive a DISPLAY/DQBUF.
 	 */
 	struct mtk_vcp_mem plane[2];
 	struct sg_table *sgt;
+	struct vdec_direct_backing backing;
 	struct vb2_v4l2_buffer *vb; /* direct mode: buffer held in this slot */
 	u64 cookie;
 	bool queued; /* direct mode: recorded, awaiting the START that names it */
@@ -134,6 +142,7 @@ struct vdec_pending {
 	u32 surface;
 	u64 timestamp;
 	u64 fw_done_ns;
+	bool no_generated;
 };
 /* perf_frames arms ktime staging splits for the next N delivered frames
  * (0 = off). Re-arm by writing the count again through sysfs; each write
@@ -168,6 +177,9 @@ struct vdec_ctx {
 	struct v4l2_fh fh;
 	struct v4l2_ctrl_handler controls;
 	struct vdec_dev *dev;
+	struct mutex direct_lock; /* QBUF identity checks versus worker ownership */
+	u64 next_buffer_generation;
+	size_t direct_bytes;
 	struct mtk_vcp_vdec *decoder;
 	struct v4l2_pix_format_mplane src_fmt, dst_fmt;
 	u32 codec_id;
@@ -178,15 +190,23 @@ struct vdec_ctx {
 	struct vdec_pending pending[DEC_SURFACES];
 	u32 pool_count, pending_read, pending_count, sequence, source_sequence;
 	u64 next_cookie, source_cookie;
+	u32 source_changed;
+	unsigned long source_deadline;
 	u32 header_changed; /* saved across an interrupted header release wait */
 	u32 operation_rate; /* client's declared decode rate, 0 = no hint */
+	bool direct_ready; /* eligible queued backing plus a free firmware slot */
 	bool direct_capture; /* CAPTURE holds the firmware's tiled frame buffer */
 	bool direct_logged; /* frame-buffer mapping reported once per session */
-	struct work_struct work;
+	struct work_struct work, schedule_work;
+	spinlock_t schedule_lock;
+	bool schedule_enabled;
 	wait_queue_head_t wait;
 	atomic_t notification;
+	int collected_notification;
 	bool booted, initialized, header, stopping, failed, orphan, released;
 	bool source_done, draining, drained;
+	bool sequence_announced; /* current OUTPUT stream, survives CAPTURE restart */
+	struct v4l2_rect announced_crop;
 	bool eos_sent; /* end-of-stream published for the current drain */
 	bool submitted;   /* head OUTPUT buffer handed to firmware, release pending */
 	bool last_pending; /* previous capture sequence still needs its LAST marker */
@@ -214,6 +234,8 @@ struct vdec_ctx {
 	u32 prev_dst_size[2], prev_dst_planes; /* CAPTURE geometry before the change */
 };
 
+static void update_direct_ready(struct vdec_ctx *c);
+
 static struct vdec_ctx *file_ctx(struct file *file)
 {
 	return container_of(file_to_v4l2_fh(file), struct vdec_ctx, fh);
@@ -252,6 +274,13 @@ static struct v4l2_pix_format_mplane *queue_format(struct vdec_ctx *c, enum v4l2
 	return is_output(type) ? &c->src_fmt : &c->dst_fmt;
 }
 
+static int codec_power_ao(void *priv, bool on)
+{
+	struct vdec_ctx *c = priv;
+
+	return mtk_vcp_vdec_hw_power_ao(c->dev->hw, on);
+}
+
 static int codec_power(void *priv, unsigned int core, bool on)
 {
 	struct vdec_ctx *c = priv;
@@ -276,15 +305,41 @@ static void codec_free(void *priv, u32 type, struct mtk_vcp_mem *mem)
 
 	mtk_vcp_vdec_hw_free(c->dev->hw, type, mem);
 }
+/* RX callbacks hold the decoder's rx_lock. Only kick the mem2mem scheduler
+ * here: collection must stay in its serialized decode job, never in RX.
+ * The lifetime gate is closed and this work joined before m2m_ctx is freed.
+ */
+static void schedule_kick(struct work_struct *work)
+{
+	struct vdec_ctx *c = container_of(work, struct vdec_ctx, schedule_work);
+
+	v4l2_m2m_try_schedule(c->fh.m2m_ctx);
+}
+
+static void stop_scheduling(struct vdec_ctx *c)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&c->schedule_lock, flags);
+	c->schedule_enabled = false;
+	spin_unlock_irqrestore(&c->schedule_lock, flags);
+	cancel_work_sync(&c->schedule_work);
+}
+
 static void codec_notify(void *priv)
 {
 	struct vdec_ctx *c = priv;
+	unsigned long flags;
 
 	atomic_inc(&c->notification);
 	wake_up(&c->wait);
+	spin_lock_irqsave(&c->schedule_lock, flags);
+	if (c->schedule_enabled)
+		queue_work(c->dev->queue, &c->schedule_work);
+	spin_unlock_irqrestore(&c->schedule_lock, flags);
 }
 static const struct mtk_vcp_vdec_ops codec_ops = {
-	.power = codec_power, .wait_irq = codec_wait,
+	.power = codec_power, .power_ao = codec_power_ao, .wait_irq = codec_wait,
 	.alloc = codec_alloc, .free = codec_free, .notify = codec_notify,
 };
 
@@ -325,7 +380,7 @@ static int vdec_check_caps(struct vdec_ctx *c)
 			dev_info(c->dev->dev,
 				 "VDEC cap fmt[%d]: fourcc=%p4cc type=%u planes=%u\n", i,
 				 &fourcc, le32_to_cpu(fmts[i].type),
-				 le32_to_cpu(fmts[i].num_planes));
+				 le32_to_cpu(fmts[i].planes));
 		if (fourcc == k->vcp_fourcc)
 			found = true;
 	}
@@ -348,12 +403,12 @@ static int vdec_check_caps(struct vdec_ctx *c)
 			 "VDEC cap size[%d]: fourcc=%p4cc profile=%u level=%u %ux%u..%ux%u step %ux%u\n",
 			 i, &sizes[i].fourcc, le32_to_cpu(sizes[i].profile),
 			 le32_to_cpu(sizes[i].level),
-			 le32_to_cpu(sizes[i].stepwise.min_width),
-			 le32_to_cpu(sizes[i].stepwise.min_height),
-			 le32_to_cpu(sizes[i].stepwise.max_width),
-			 le32_to_cpu(sizes[i].stepwise.max_height),
-			 le32_to_cpu(sizes[i].stepwise.step_width),
-			 le32_to_cpu(sizes[i].stepwise.step_height));
+			 le32_to_cpu(sizes[i].min_width),
+			 le32_to_cpu(sizes[i].min_height),
+			 le32_to_cpu(sizes[i].max_width),
+			 le32_to_cpu(sizes[i].max_height),
+			 le32_to_cpu(sizes[i].step_width),
+			 le32_to_cpu(sizes[i].step_height));
 out:
 	kfree(fmts);
 	kfree(sizes);
@@ -440,14 +495,13 @@ static int session_boot(struct vdec_ctx *c)
 		ret = -ENOMEM;
 		goto rollback;
 	}
-	c->bs.cpu = dma_alloc_coherent(c->dev->bs_dev, c->bs.size, &c->bs.dma, GFP_KERNEL);
+	ret = mtk_vcp_alloc_workmem(c->dev->vcp, c->bs.size, &c->bs);
 	VCPDBG("boot: bitstream mapping size=%zu cpu=%px dma=%pad\n",
 	       c->bs.size, c->bs.cpu, &c->bs.dma);
-	if (c->bs.cpu) {
+	if (!ret) {
 		vdec_state(c, "booted");
 		return 0;
 	}
-	ret = -ENOMEM;
 rollback:
 	/* A session without a usable bitstream mapping, or with a format the
 	 * firmware does not decode, must not be left half initialized: a later
@@ -486,16 +540,106 @@ static int session_start(struct vdec_ctx *c)
 	return session_boot(c);
 }
 
+static void direct_backing_release(struct vdec_direct_backing *b)
+{
+	unsigned int p;
+
+	for (p = 0; p < 2; p++) {
+		struct vdec_direct_plane *v = &b->plane[p];
+
+		if (v->shared_mapping) {
+			if (v->dbuf)
+				dma_buf_put(v->dbuf);
+			continue;
+		}
+		if (v->mapping) {
+			dma_addr_t dma = sg_dma_address(v->mapping->sgl);
+
+			VCPDBG("unpin: vb=%u generation=%llu plane=%u dma=%pad size=%zu\n",
+			       b->index, b->generation, p, &dma, v->dbuf->size);
+		}
+		if (v->mapping)
+			dma_buf_unmap_attachment(v->attachment, v->mapping, DMA_BIDIRECTIONAL);
+		if (v->attachment)
+			dma_buf_detach(v->dbuf, v->attachment);
+		if (v->dbuf)
+			dma_buf_put(v->dbuf);
+	}
+	memset(b, 0, sizeof(*b));
+}
+
+/* direct_lock protects accounting; physical unmap may follow outside it. */
+static void direct_backing_forget(struct vdec_ctx *c, struct vdec_direct_backing *b)
+{
+	if (b->accounted) {
+		WARN_ON(b->bytes > c->direct_bytes);
+		c->direct_bytes -= b->bytes;
+		b->accounted = false;
+	}
+}
+
+static u64 direct_generation(struct vb2_buffer *vb)
+{
+	struct vdec_buffer *b = container_of(to_vb2_v4l2_buffer(vb),
+					    struct vdec_buffer, m2m.vb);
+
+	return b->generation;
+}
+
+static bool direct_backing_matches(const struct vdec_direct_backing *b,
+				   struct vb2_buffer *vb)
+{
+	unsigned int p;
+
+	if (!b->generation || b->memory != vb->memory)
+		return false;
+	for (p = 0; p < 2; p++) {
+		if (b->offset[p] != vb->planes[p].data_offset)
+			return false;
+		if (vb->memory == VB2_MEMORY_DMABUF) {
+			if (b->plane[p].dbuf != vb->planes[p].dbuf)
+				return false;
+		} else if (b->generation != direct_generation(vb) ||
+			   b->plane[p].mem_priv != vb->planes[p].mem_priv) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static bool direct_same_dmabuf(struct dma_buf *a, struct dma_buf *b)
+{
+	return a && b && (a == b || (a->ops == b->ops && a->priv == b->priv));
+}
+
+static bool direct_backing_aliases(const struct vdec_direct_backing *b,
+				  struct vb2_buffer *vb)
+{
+	unsigned int p, q;
+
+	if (!b->generation)
+		return false;
+	if (vb->memory == VB2_MEMORY_MMAP)
+		return b->memory == VB2_MEMORY_MMAP &&
+		       b->generation == direct_generation(vb);
+	for (p = 0; p < 2; p++)
+		for (q = 0; q < 2; q++)
+			if (direct_same_dmabuf(b->plane[p].dbuf, vb->planes[q].dbuf))
+				return true;
+	return false;
+}
+
 /* Direct capture keeps CAPTURE buffers that are no longer on the m2m ready
  * list, because they are the firmware's frame buffers. Any path that ends the
  * session has to take them back or vb2 refuses to release the queue.
  */
-static unsigned int release_direct_slots(struct vdec_ctx *c)
+static unsigned int return_direct_buffers(struct vdec_ctx *c, bool quiesced)
 {
 	unsigned int i, dropped = 0;
 
 	if (!c->direct_capture)
 		return 0;
+	mutex_lock(&c->direct_lock);
 	for (i = 0; i < c->pool_count; i++) {
 		struct vdec_surface *s = &c->surfaces[i];
 
@@ -505,16 +649,15 @@ static unsigned int release_direct_slots(struct vdec_ctx *c)
 		s->vb = NULL;
 		s->queued = false;
 		s->pending = false;
-		/* The slot is free again for the next stream to fill. A firmware
-		 * session that outlives the capture restart still holds the old
-		 * cookie; its release is dropped when it arrives.
-		 */
-		s->cookie = 0;
-		s->free = true;
+		if (quiesced) {
+			s->cookie = 0;
+			s->free = true;
+		}
 		dropped++;
 	}
 	c->pending_count = 0;
 	c->pending_read = 0;
+	mutex_unlock(&c->direct_lock);
 	return dropped;
 }
 
@@ -525,7 +668,6 @@ static int session_teardown(struct vdec_ctx *c)
 {
 	int ret = 0, stopped, i;
 
-	release_direct_slots(c);
 	if (!c->decoder)
 		return 0;
 	VCPDBG("teardown: init=%d boot=%d orphan=%d\n", c->initialized,
@@ -557,16 +699,33 @@ static int session_teardown(struct vdec_ctx *c)
 		       ret, stopped, mtk_vcp_is_offline(c->dev->vcp));
 		goto retain;
 	}
-	stopped = mtk_vcp_vdec_destroy(c->decoder, !!ret);
+	/* Firmware has deinitialized or the VCP reset is confirmed above.
+	 * Keep the owning context if the allocator cannot confirm safe release.
+	 */
+	if (c->bs.cpu) {
+		mtk_vcp_free_workmem(c->dev->vcp, &c->bs);
+		if (c->bs.cpu)
+			goto retain;
+	}
+	stopped = mtk_vcp_vdec_destroy(c->decoder, !!ret || mtk_vcp_is_offline(c->dev->vcp));
 	if (stopped) {
 		VCPDBG("teardown: destroy failed: %d\n", stopped);
 		goto retain;
 	}
+	return_direct_buffers(c, true);
+	for (i = 0; i < DEC_SURFACES; i++) {
+		struct vdec_direct_backing backing;
+
+		mutex_lock(&c->direct_lock);
+		backing = c->surfaces[i].backing;
+		direct_backing_forget(c, &backing);
+		memset(&c->surfaces[i].backing, 0, sizeof(backing));
+		mutex_unlock(&c->direct_lock);
+		direct_backing_release(&backing);
+	}
 	c->decoder = NULL;
 	c->booted = false;
 	c->initialized = false;
-	if (c->bs.cpu)
-		dma_free_coherent(c->dev->bs_dev, c->bs.size, c->bs.cpu, c->bs.dma);
 	memset(&c->bs, 0, sizeof(c->bs));
 	kvfree(c->bs_snapshot);
 	c->bs_snapshot = NULL;
@@ -586,10 +745,13 @@ static int session_teardown(struct vdec_ctx *c)
 	}
 	c->probe_cookie = 0;
 	c->probe_done = false;
+	mutex_lock(&c->direct_lock);
 	memset(c->surfaces, 0, sizeof(c->surfaces));
 	c->pool_count = 0;
