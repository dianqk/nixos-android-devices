-	struct mtk_dsi_driver_data selected = poll_data;
+	struct mtk_dsi_driver_data selected = *completion;
 	int previous_writes;
 
 	/* Actual target mapping omits c00; existing mt8186 mapping retains it. */
@@ -626,7 +663,7 @@ static void test_polled_completion(void)
 	balanced();
 
