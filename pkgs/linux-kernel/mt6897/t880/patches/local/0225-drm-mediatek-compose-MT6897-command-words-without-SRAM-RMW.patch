+			/* Every SRAM read would return stale data, including header. */
+			sram_begin = regs[0] + pack_data.reg_adv[DSI_CMDQ];
+			sram_end = sram_begin + 4 * 63;
+			stale_address = sram_begin;
+			stale_value = 0x230020fb;
