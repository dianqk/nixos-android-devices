+			assert(!sram_reads && reg_reads == 2 && !log_count);
+			assert(bus_count == (int)words + 3 && mask_count == 2);
+			for (size_t i = 0; i < words; i++) {
+				u32 expected = 0;
+
+				for (size_t j = 0; j < 4 && i * 4 + j < msg.tx_len; j++)
+					expected |= (u32)payload[i * 4 + j] << (8 * j);
+				assert(bus[i].address == sram_begin + 4 + i * 4);
+				assert(bus[i].value == expected);
+			}
+			if (msg.tx_len > 2)
+				header |= (u32)msg.tx_len << 16 | LONG_PACKET;
+			else
+				for (size_t i = 0; i < msg.tx_len; i++)
+					header |= (u32)payload[i] << (16 + 8 * i);
+			assert(bus[words].address == sram_begin);
+			assert(bus[words].value == header);
+			assert(bus[words + 1].address == regs[0] +
+			       pack_data.reg_main[DSI_CMDQ_SIZE]);
+			assert((bus[words + 1].value & CMDQ_SIZE) == words + 1);
+			assert(bus[words + 2].value ==
