+				assert(w->old_valid == rmw);
+			}
+		}
+	}
+
+	/* Reproduce the actual d04 stale reads, then remove that dependency. */
+	const u8 long_payload[] = { 0xbc, 0x33, 0x03 };
+	struct mipi_dsi_msg msg = { .type = 0x29, .tx_len = 3,
+		.tx_buf = long_payload, .flags = MIPI_DSI_MSG_USE_LPM };
+	for (int packed = 0; packed < 2; packed++) {
+		setup(false);
+		d[0].driver_data = packed ? &pack_data : &poll_data;
+		stale_address = regs[0] + 0x14;
+		stale_sequence[0] = 0;
+		stale_sequence[1] = 0xbc;
+		stale_sequence[2] = 0xbc;
+		stale_count = 3;
+		assert(!mtk_dsi_cmdq(&d[0], &msg));
+		if (packed) {
+			assert(!stale_next && bus[0].value == 0x000333bc);
+			assert(bus[1].value == 0x00032902);
+		} else {
+			assert(stale_next == 3 && bus[1].value == 0x000033bc);
+			assert(bus[2].value == 0x000300bc);
+		}
+	}
+	const u8 short_payload[] = { 0xfb, 0x01 };
+
+	msg = (struct mipi_dsi_msg){ .type = 0x23, .tx_len = 2,
+		.tx_buf = short_payload, .flags = MIPI_DSI_MSG_USE_LPM };
+	for (int packed = 0; packed < 2; packed++) {
+		setup(false);
+		d[0].driver_data = packed ? &pack_data : &poll_data;
+		stale_address = regs[0] + 0x10;
+		stale_sequence[0] = 0x20ff2902;
+		stale_sequence[1] = 0x20ff2300;
+		stale_sequence[2] = 0x230020fb;
+		stale_count = 3;
+		assert(!mtk_dsi_cmdq(&d[0], &msg));
+		if (packed) {
+			assert(!stale_next && bus[0].value == 0x01fb2300);
+			assert(!d[0].cmdq_write_ring[0].old_valid);
+			mtk_dsi_dump_cmdq_writes(&d[0], "test");
+			assert(unavailable_log_count == 1);
+		} else {
+			assert(stale_next == 3 && bus[0].value == 0x20fb2902);
+			assert(bus[1].value == 0x01ff2300 && bus[2].value == 0x23002300);
+			assert(d[0].cmdq_write_ring[0].old_valid);
+		}
+	}
