From 7f45c7b303e6c0d9a9600998470f7fc205678a8d Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Mon, 9 Nov 2026 21:13:07 +0800
Subject: [PATCH] drm/mediatek: compose MT6897 command words without SRAM RMW

After display-domain power loss, MT6897 command SRAM reads can return
stale bytes: a bc 33 03 payload loses the middle byte between the
existing RMW stores, and the following short command retains a long-
packet header. The resulting words passed to writel are already wrong
before completion stalls.

Compose MT6897 queue words from the message in software, without using
SRAM readbacks as inputs. Preserve the OEM CPU path's payload-before-
header order, then the existing size, SIZE_SEL and start sequence. Pack
short commands into one header and zero-pad a partial last payload word,
as the OEM packed-queue representation does. Enable this through an
explicit MT6897 capability; legacy and other polled layouts retain their
existing RMW path.

Reject missing payload buffers and lengths exceeding the six-bit count
before mode changes or hardware writes. Keep the existing bounded
completion and first-error latch. Direct-write trace entries explicitly
mark the old value unavailable rather than adding an SRAM read or
reporting a synthetic zero.

Exercise actual production functions with the observed stale read
sequences, known emitted words/order, partial and maximum lengths,
invalid requests, legacy RMW, and both packed and legacy-polled
read/error/latch behavior.

Link: https://github.com/MiCode/MTK_kernel_device_modules/blob/3c4ccd07d5624879555ec710c11bb8818e5cb5c6/drivers/gpu/drm/mediatek/mediatek_v2/mtk_dsi.c#L5548
Link: https://github.com/MiCode/MTK_kernel_device_modules/blob/3c4ccd07d5624879555ec710c11bb8818e5cb5c6/drivers/gpu/drm/mediatek/mediatek_v2/mtk_dsi.c#L5766
Signed-off-by: dianqk <dianqk@dianqk.net>
---
 drivers/gpu/drm/mediatek/mtk_dsi.c            | 103 ++++++--
 .../selftests/mtk_clk/dsi_routing_cases.c     | 220 +++++++++++++++---
 .../selftests/mtk_clk/test_dsi_routing.py     |   6 +
 3 files changed, 287 insertions(+), 42 deletions(-)

diff --git a/drivers/gpu/drm/mediatek/mtk_dsi.c b/drivers/gpu/drm/mediatek/mtk_dsi.c
index e787f9fecc..6870b5ac85 100644
--- a/drivers/gpu/drm/mediatek/mtk_dsi.c
+++ b/drivers/gpu/drm/mediatek/mtk_dsi.c
@@ -343,7 +343,8 @@ enum mtk_dsi_cmdq_write_kind {
  * @offset: target register offset
  * @mask: write mask
  * @value: masked write argument
- * @old: value returned by the existing RMW read
+ * @old_valid: whether old was read from the register
+ * @old: value returned by the existing RMW read, if valid
  * @new: full word passed to writel
  */
 struct mtk_dsi_cmdq_write {
@@ -354,6 +355,7 @@ struct mtk_dsi_cmdq_write {
 	u16 offset;
 	u32 mask;
 	u32 value;
+	bool old_valid;
 	u32 old;
 	u32 new;
 };
@@ -370,6 +372,7 @@ struct mtk_dsi_driver_data {
 
 	bool has_size_ctl;
 	bool cmdq_long_packet_ctl;
+	bool cmdq_software_pack;
 	bool support_per_frame_lp;
 	bool has_cphy;
 	bool restore_cphy_config;
@@ -1453,7 +1456,7 @@ static u8 mtk_dsi_msg_tx(const struct mipi_dsi_msg *msg, size_t index)
 static void mtk_dsi_record_cmdq_write(struct mtk_dsi *dsi,
 				      const struct mipi_dsi_msg *msg,
 				      u16 offset, u32 mask, u32 value,
-				      u8 kind, u32 old, u32 new)
+				      u8 kind, bool old_valid, u32 old, u32 new)
 {
 	struct mtk_dsi_cmdq_write *rec =
 		&dsi->cmdq_write_ring[dsi->cmdq_write_head];
@@ -1465,6 +1468,7 @@ static void mtk_dsi_record_cmdq_write(struct mtk_dsi *dsi,
 	rec->offset = offset;
 	rec->mask = mask;
 	rec->value = value;
+	rec->old_valid = old_valid;
 	rec->old = old;
 	rec->new = new;
 	dsi->cmdq_write_head = (dsi->cmdq_write_head + 1) %
@@ -1488,7 +1492,18 @@ static void mtk_dsi_cmdq_mask(struct mtk_dsi *dsi,
 	old = readl(dsi->regs + offset);
 	new = (old & ~mask) | (value & mask);
 	writel(new, dsi->regs + offset);
-	mtk_dsi_record_cmdq_write(dsi, msg, offset, mask, value, kind, old, new);
+	mtk_dsi_record_cmdq_write(dsi, msg, offset, mask, value, kind, true, old, new);
+}
+
+/* A direct queue write has no observed old value and needs no SRAM read. */
+static void mtk_dsi_cmdq_write(struct mtk_dsi *dsi,
+			       const struct mipi_dsi_msg *msg,
+			       u16 offset, u32 value, u8 kind)
+{
+	writel(value, dsi->regs + offset);
+	if (dsi->config_clk)
+		mtk_dsi_record_cmdq_write(dsi, msg, offset, ~0U, value,
+					  kind, false, 0, value);
 }
 
 static void mtk_dsi_record_cmd(struct mtk_dsi *dsi,
@@ -1550,6 +1565,7 @@ static void mtk_dsi_dump_cmdq_writes(struct mtk_dsi *dsi, const char *phase)
 	};
 	const struct mtk_dsi_cmdq_write *rec;
 	u8 start, count, i;
+	char old[sizeof("unavailable")];
 
 	if (!dsi->cmdq_write_count)
 		return;
@@ -1561,11 +1577,15 @@ static void mtk_dsi_dump_cmdq_writes(struct mtk_dsi *dsi, const char *phase)
 	for (i = 0; i < count; i++) {
 		rec = &dsi->cmdq_write_ring[(start + i) %
 					    MTK_DSI_CMDQ_WRITE_RING_SIZE];
+		if (rec->old_valid)
+			snprintf(old, sizeof(old), "%08x", rec->old);
+		else
+			memcpy(old, "unavailable", sizeof(old));
 		dev_info(dsi->host.dev,
-			 "C-PHY cmdq-write %s[%u]: cmd=%u type=%u tx_len=%zu kind=%s offset=%04x mask=%08x value=%08x old=%08x new=%08x\n",
+			 "C-PHY cmdq-write %s[%u]: cmd=%u type=%u tx_len=%zu kind=%s offset=%04x mask=%08x value=%08x old=%s new=%08x\n",
 			 phase, i, rec->cmd, rec->type, rec->tx_len,
 			 kind_name[rec->kind], rec->offset, rec->mask,
-			 rec->value, rec->old, rec->new);
+			 rec->value, old, rec->new);
 	}
 }
 
@@ -2423,15 +2443,31 @@ static u32 mtk_dsi_recv_cnt(u8 type, u8 *read_data)
 	return 0;
 }
 
-static void mtk_dsi_cmdq(struct mtk_dsi *dsi, const struct mipi_dsi_msg *msg)
+static int mtk_dsi_cmdq_check_msg(const struct mipi_dsi_msg *msg)
+{
+	if (msg->tx_len && !msg->tx_buf)
+		return -EINVAL;
+	/* The six-bit count includes the long packet's header word. */
+	if (msg->tx_len > (CMDQ_SIZE - 1) * 4)
+		return -EMSGSIZE;
+	return 0;
+}
+
+static int mtk_dsi_cmdq(struct mtk_dsi *dsi, const struct mipi_dsi_msg *msg)
 {
 	const struct mtk_dsi_driver_data *data = dsi->driver_data;
 	const char *tx_buf = msg->tx_buf;
-	u32 reg_val, cmdq_mask, i, offset, mask, value;
+	u32 reg_val, cmdq_mask, i, j, offset, mask, value;
+	int ret;
 	u8 cmdq_size, cmdq_off;
 	u8 type = msg->type;
 	u8 config;
 
+	if (data->cmdq_software_pack) {
+		ret = mtk_dsi_cmdq_check_msg(msg);
+		if (ret)
+			return ret;
+	}
 	dsi->cmdq_write_seq++;
 
 	if (MTK_DSI_HOST_IS_READ(type))
@@ -2454,16 +2490,36 @@ static void mtk_dsi_cmdq(struct mtk_dsi *dsi, const struct mipi_dsi_msg *msg)
 		reg_val = (type << 8) | config;
 	}
 
-	for (i = 0; i < msg->tx_len; i++) {
-		offset = (data->reg_adv[DSI_CMDQ] + cmdq_off + i) & (~0x3U);
-		mask = 0xffUL << (((i + cmdq_off) & 3U) * 8U);
-		value = tx_buf[i] << (((i + cmdq_off) & 3U) * 8U);
-		mtk_dsi_cmdq_mask(dsi, msg, offset, mask, value,
-					  MTK_DSI_CMDQ_WRITE_DATA);
-	}
+	if (data->cmdq_software_pack) {
+		const u8 *payload = msg->tx_buf;
 
-	mtk_dsi_cmdq_mask(dsi, msg, data->reg_adv[DSI_CMDQ], cmdq_mask,
+		/* Preserve the CPU path's payload-before-header order. */
+		if (msg->tx_len > 2) {
+			for (i = 0; i < msg->tx_len; i += 4) {
+				value = 0;
+				for (j = 0; j < 4 && i + j < msg->tx_len; j++)
+					value |= (u32)payload[i + j] << (j * 8);
+				mtk_dsi_cmdq_write(dsi, msg,
+						   data->reg_adv[DSI_CMDQ] + 4 + i,
+						   value, MTK_DSI_CMDQ_WRITE_DATA);
+			}
+		} else {
+			for (i = 0; i < msg->tx_len; i++)
+				reg_val |= (u32)payload[i] << (16 + i * 8);
+		}
+		mtk_dsi_cmdq_write(dsi, msg, data->reg_adv[DSI_CMDQ],
+				   reg_val, MTK_DSI_CMDQ_WRITE_CONFIG);
+	} else {
+		for (i = 0; i < msg->tx_len; i++) {
+			offset = (data->reg_adv[DSI_CMDQ] + cmdq_off + i) & (~0x3U);
+			mask = 0xffUL << (((i + cmdq_off) & 3U) * 8U);
+			value = tx_buf[i] << (((i + cmdq_off) & 3U) * 8U);
+			mtk_dsi_cmdq_mask(dsi, msg, offset, mask, value,
+					  MTK_DSI_CMDQ_WRITE_DATA);
+		}
+		mtk_dsi_cmdq_mask(dsi, msg, data->reg_adv[DSI_CMDQ], cmdq_mask,
 				  reg_val, MTK_DSI_CMDQ_WRITE_CONFIG);
+	}
 	mtk_dsi_cmdq_mask(dsi, msg, data->reg_main[DSI_CMDQ_SIZE],
 				  CMDQ_SIZE, cmdq_size,
 				  MTK_DSI_CMDQ_WRITE_SIZE);
@@ -2474,6 +2530,7 @@ static void mtk_dsi_cmdq(struct mtk_dsi *dsi, const struct mipi_dsi_msg *msg)
 					  CMDQ_SIZE_SEL, CMDQ_SIZE_SEL,
 					  MTK_DSI_CMDQ_WRITE_SIZE_SEL);
 	}
+	return 0;
 }
 
 static void mtk_dsi_latch_cmd_error(struct mtk_dsi *dsi, int error)
@@ -2499,6 +2556,11 @@ static ssize_t mtk_dsi_host_send_cmd(struct mtk_dsi *dsi,
 	bool poll_failed = false, irq_failed = false;
 	int ret;
 
+	if (dsi->driver_data->cmdq_software_pack) {
+		ret = mtk_dsi_cmdq_check_msg(msg);
+		if (ret)
+			return ret;
+	}
 	if (dsi->driver_data->poll_command_done) {
 		ret = mtk_dsi_poll_for_idle(dsi);
 		if (ret) {
@@ -2517,7 +2579,9 @@ static ssize_t mtk_dsi_host_send_cmd(struct mtk_dsi *dsi,
 	mtk_dsi_irq_data_clear(dsi, flag);
 	pre_intsta = readl(dsi->regs +
 			   dsi->driver_data->reg_main[DSI_INTSTA]);
-	mtk_dsi_cmdq(dsi, msg);
+	ret = mtk_dsi_cmdq(dsi, msg);
+	if (ret)
+		return ret;
 	mtk_dsi_start(dsi);
 	post_start_intsta = readl(dsi->regs +
 				  dsi->driver_data->reg_main[DSI_INTSTA]);
@@ -2583,6 +2647,12 @@ static ssize_t mtk_dsi_host_transfer(struct mipi_dsi_host *host,
 			return -EINVAL;
 	}
 
+	if (dsi->driver_data->cmdq_software_pack) {
+		ret = mtk_dsi_cmdq_check_msg(msg);
+		if (ret)
+			return ret;
+	}
+
 	if (dsi->config_clk && !READ_ONCE(dsi->diag_first_cmd)) {
 		WRITE_ONCE(dsi->diag_first_cmd, true);
 		mtk_dsi_dump_regs(dsi, "first-command");
@@ -2821,6 +2891,7 @@ static const struct mtk_dsi_driver_data mt6897_dsi_driver_data = {
 	.restore_cphy_config = true,
 	.poll_command_done = true,
 	.cmdq_long_packet_ctl = true,
+	.cmdq_software_pack = true,
 	.reg_qos = mtk_dsi_regs_qos_v1,
 	.tx_buf = &mt6897_dsi_tx_buf,
 };
diff --git a/tools/testing/selftests/mtk_clk/dsi_routing_cases.c b/tools/testing/selftests/mtk_clk/dsi_routing_cases.c
