+				.tx_buf = lengths[n] ? payload : NULL,
+				.flags = hs ? 0 : MIPI_DSI_MSG_USE_LPM,
+			};
+			size_t words = msg.tx_len > 2 ? (msg.tx_len + 3) / 4 : 0;
+			u32 header = (0x29 << 8) | (hs ? HSTX : 0);
