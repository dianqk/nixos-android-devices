+		d[0].cmd_error = -ETIMEDOUT;
+		assert(mtk_dsi_host_transfer(&d[0].host, &msg) == -ETIMEDOUT);
+		assert(d[0].cmd_error == -ETIMEDOUT && !writes);
+	}
