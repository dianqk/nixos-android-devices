From 1a3c1d8bb39b16031a4efae0a11108e77ece3ce2 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Fri, 6 Nov 2026 10:00:00 +0800
Subject: [PATCH] workaround: soc: mediatek: proxy MT6897 DRAM bandwidth votes

Use load-based CPU/devfreq proxy votes and static multimedia floors until
the multimedia firmware bandwidth ownership is available.

Original-Commit: local development history
Original-Author: dianqk <dianqk@dianqk.net>
Original-Date: 2026-11-03T03:24:27+08:00
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: dianqk <dianqk@dianqk.net>
---
 drivers/soc/mediatek/Kconfig       |  10 +
 drivers/soc/mediatek/Makefile      |   1 +
 drivers/soc/mediatek/mtk-dram-bw.c | 347 +++++++++++++++++++++++++++++
 3 files changed, 358 insertions(+)
 create mode 100644 drivers/soc/mediatek/mtk-dram-bw.c

diff --git a/drivers/soc/mediatek/Kconfig b/drivers/soc/mediatek/Kconfig
index 4146457e92..23b5bb4a51 100644
--- a/drivers/soc/mediatek/Kconfig
+++ b/drivers/soc/mediatek/Kconfig
@@ -37,6 +37,16 @@ config MTK_DVFSRC
 	  software, and performing bandwidth scaling to provide the
 	  best achievable performance-per-watt.
 
+config MTK_DRAM_BW
+	tristate "MediaTek DVFSRC floors and load-based DRAM bandwidth vote"
+	depends on MTK_DVFSRC && INTERCONNECT && CPU_FREQ && PM_DEVFREQ
+	depends on REGULATOR_MTK_DVFSRC
+	help
+	  Board-level DVFSRC requests for SoCs whose DVFSRC starts only once
+	  they are set (MT6897): a vcore floor, an HRT bandwidth floor and a
+	  DRAM peak bandwidth vote that follows CPU and devfreq load. The
+	  driver starts the DVFSRC after setting them.
+
 config MTK_INFRACFG
 	bool "MediaTek INFRACFG Support"
 	select REGMAP
diff --git a/drivers/soc/mediatek/Makefile b/drivers/soc/mediatek/Makefile
index 4101b7ebf5..cb69725712 100644
--- a/drivers/soc/mediatek/Makefile
+++ b/drivers/soc/mediatek/Makefile
@@ -2,6 +2,7 @@
 obj-$(CONFIG_MTK_CMDQ) += mtk-cmdq-helper.o
 obj-$(CONFIG_MTK_DEVAPC) += mtk-devapc.o
 obj-$(CONFIG_MTK_DVFSRC) += mtk-dvfsrc.o
+obj-$(CONFIG_MTK_DRAM_BW) += mtk-dram-bw.o
 obj-$(CONFIG_MTK_INFRACFG) += mtk-infracfg.o
 obj-$(CONFIG_MTK_PMIC_WRAP) += mtk-pmic-wrap.o
 obj-$(CONFIG_MTK_REGULATOR_COUPLER) += mtk-regulator-coupler.o
diff --git a/drivers/soc/mediatek/mtk-dram-bw.c b/drivers/soc/mediatek/mtk-dram-bw.c
new file mode 100644
index 0000000000..8a9dfed00c
--- /dev/null
+++ b/drivers/soc/mediatek/mtk-dram-bw.c
@@ -0,0 +1,347 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek DVFSRC floors and load-based DRAM bandwidth vote.
+ *
+ * On SoCs whose DVFSRC starts only once the board's requests are in place
+ * (MT6897), this driver owns the board-level requests the stock kernel's
+ * mmdvfs, display and cm_mgr drivers would make:
+ *
+ *  - a vcore floor (dvfsrc-vcore, "mediatek,vcore-floor-microvolt") that
+ *    covers the multimedia clocks the bootloader leaves running;
+ *  - an HRT bandwidth floor ("hrt" path, "mediatek,hrt-floor-kBps") for
+ *    display scanout;
+ *  - a peak bandwidth vote on the "cpu" path that follows load: every
+ *    poll period it takes the highest relative frequency of the CPU
+ *    policies (cur / max, scaled by CPU capacity) and of the listed devfreq devices
+ *    ("mediatek,devfreq"; position between their minimum and maximum) and
+ *    picks the bandwidth of the first "mediatek,load-steps" entry
+ *    (<percent kBps>, descending) the load reaches.  Lower votes are held
+ *    for "mediatek,hold-ms" before they apply.
+ *
+ * It then starts the DVFSRC.  Without this driver the DVFSRC stays at the
+ * top level INIT leaves.
+ */
+
+#include <linux/cpufreq.h>
+#include <linux/devfreq.h>
+#include <linux/devm-helpers.h>
+#include <linux/interconnect.h>
+#include <linux/jiffies.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/regulator/consumer.h>
+#include <linux/sched/topology.h>
+#include <linux/soc/mediatek/dvfsrc.h>
+#include <linux/workqueue.h>
+
+#define MTK_DRAM_BW_MAX_STEPS		8
+#define MTK_DRAM_BW_MAX_DEVFREQ		4
+
+struct mtk_dram_bw_step {
+	u32 percent;
+	u32 kbps;
+};
+
+struct mtk_dram_bw {
+	struct device *dev;
+	struct icc_path *cpu_path;
+	struct icc_path *hrt_path;
+	struct regulator *vcore;
+	struct delayed_work work;
+	unsigned int period_ms;
+	unsigned long hold;
+	unsigned long lower_since;
+	struct mtk_dram_bw_step steps[MTK_DRAM_BW_MAX_STEPS];
+	unsigned int num_steps;
+	struct device_node *devfreq_np[MTK_DRAM_BW_MAX_DEVFREQ];
+	struct devfreq *devfreq[MTK_DRAM_BW_MAX_DEVFREQ];
+	unsigned int num_devfreq;
+	u32 cur_kbps;
+	u32 override_kbps;
+	u32 last_load;
+	unsigned long changes;
+};
+
+static unsigned int mtk_dram_bw_cpu_load(void)
+{
+	unsigned int cpu, load = 0;
+
+	for_each_online_cpu(cpu) {
+		struct cpufreq_policy *policy = cpufreq_cpu_get(cpu);
+		unsigned int l;
+
+		if (!policy)
+			continue;
+		/*
+		 * Scale by CPU capacity: a busy big core moves much more
+		 * memory than a little one, and the little cluster's
+		 * frequency follows background work.
+		 */
+		if (cpu == policy->cpu && policy->cpuinfo.max_freq) {
+			l = div_u64((u64)policy->cur * 100 *
+				    arch_scale_cpu_capacity(cpu),
+				    (u64)policy->cpuinfo.max_freq *
+				    SCHED_CAPACITY_SCALE);
+			load = max(load, l);
+		}
+		cpufreq_cpu_put(policy);
+	}
+
+	return load;
+}
+
+static unsigned int mtk_dram_bw_devfreq_load(struct mtk_dram_bw *db)
+{
+	unsigned int i, load = 0;
+
+	for (i = 0; i < db->num_devfreq; i++) {
+		struct devfreq *df = db->devfreq[i];
+		unsigned long min, max, cur;
+
+		if (!df) {
+			df = devfreq_get_devfreq_by_node(db->devfreq_np[i]);
+			if (IS_ERR(df))
+				continue;
+			db->devfreq[i] = df;
+		}
+		/* Position within the device's range: idle at its minimum is 0. */
+		min = READ_ONCE(df->scaling_min_freq);
+		max = READ_ONCE(df->scaling_max_freq);
+		cur = READ_ONCE(df->previous_freq);
+		if (max > min && max != ULONG_MAX && cur >= min)
+			load = max_t(unsigned int, load,
+				     (cur - min) * 100 / (max - min));
+	}
+
+	return load;
+}
+
+static void mtk_dram_bw_work(struct work_struct *work)
+{
+	struct mtk_dram_bw *db = container_of(to_delayed_work(work),
+					      struct mtk_dram_bw, work);
+	unsigned int load, i;
+	u32 kbps = 0;
+
+	load = max(mtk_dram_bw_cpu_load(), mtk_dram_bw_devfreq_load(db));
+	db->last_load = load;
+	for (i = 0; i < db->num_steps; i++) {
+		if (load >= db->steps[i].percent) {
+			kbps = db->steps[i].kbps;
+			break;
+		}
+	}
+	if (db->override_kbps)
+		kbps = db->override_kbps;
+
+	if (kbps < db->cur_kbps) {
+		if (!db->lower_since)
+			db->lower_since = jiffies ? jiffies : 1;
+		if (time_before(jiffies, db->lower_since + db->hold))
+			goto out;
+	}
+	db->lower_since = 0;
+	if (kbps != db->cur_kbps) {
+		int ret = icc_set_bw(db->cpu_path, 0, kbps);
+
+		if (ret)
+			dev_warn_ratelimited(db->dev, "bandwidth %u kBps: %d\n",
+					     kbps, ret);
+		else {
+			db->cur_kbps = kbps;
+			db->changes++;
+		}
+	}
+out:
+	queue_delayed_work(system_freezable_power_efficient_wq, &db->work,
+			   msecs_to_jiffies(db->period_ms));
+}
+
+static ssize_t state_show(struct device *dev, struct device_attribute *attr,
+			  char *buf)
+{
+	struct mtk_dram_bw *db = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "load %u peak %u kBps override %u kBps changes %lu\n",
+			  db->last_load, db->cur_kbps, db->override_kbps,
+			  db->changes);
+}
+static DEVICE_ATTR_RO(state);
+
+static ssize_t hold_ms_show(struct device *dev, struct device_attribute *attr,
+			    char *buf)
+{
+	struct mtk_dram_bw *db = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%u\n", jiffies_to_msecs(READ_ONCE(db->hold)));
+}
+
+static ssize_t hold_ms_store(struct device *dev, struct device_attribute *attr,
+			     const char *buf, size_t count)
+{
+	struct mtk_dram_bw *db = dev_get_drvdata(dev);
+	u32 ms;
+	int ret;
+
+	ret = kstrtou32(buf, 0, &ms);
+	if (ret)
+		return ret;
+	WRITE_ONCE(db->hold, msecs_to_jiffies(ms));
+	return count;
+}
+static DEVICE_ATTR_RW(hold_ms);
+
+/* Write a peak bandwidth in kBps to hold it (measurements), 0 to follow load. */
+static ssize_t override_store(struct device *dev, struct device_attribute *attr,
+			      const char *buf, size_t count)
+{
+	struct mtk_dram_bw *db = dev_get_drvdata(dev);
+	u32 kbps;
+	int ret;
+
+	ret = kstrtou32(buf, 0, &kbps);
+	if (ret)
+		return ret;
+	WRITE_ONCE(db->override_kbps, kbps);
+	return count;
+}
+static DEVICE_ATTR_WO(override);
+
+static struct attribute *mtk_dram_bw_attrs[] = {
+	&dev_attr_state.attr,
+	&dev_attr_override.attr,
+	&dev_attr_hold_ms.attr,
+	NULL
+};
+ATTRIBUTE_GROUPS(mtk_dram_bw);
+
+static int mtk_dram_bw_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *np = dev->of_node, *dvfsrc_np;
+	struct platform_device *dvfsrc;
+	struct mtk_dram_bw *db;
+	u32 floor_uv = 0, hrt_kbps = 0;
+	int n, i, ret;
+
+	db = devm_kzalloc(dev, sizeof(*db), GFP_KERNEL);
+	if (!db)
+		return -ENOMEM;
+	db->dev = dev;
+
+	n = of_property_count_u32_elems(np, "mediatek,load-steps");
+	if (n < 2 || n % 2 || n / 2 > MTK_DRAM_BW_MAX_STEPS)
+		return dev_err_probe(dev, -EINVAL, "invalid mediatek,load-steps\n");
+	db->num_steps = n / 2;
+	ret = of_property_read_u32_array(np, "mediatek,load-steps",
+					 (u32 *)db->steps, n);
+	if (ret)
+		return ret;
+	for (i = 1; i < db->num_steps; i++)
+		if (db->steps[i].percent >= db->steps[i - 1].percent)
+			return dev_err_probe(dev, -EINVAL,
+					     "load steps must descend\n");
+
+	db->period_ms = 50;
+	of_property_read_u32(np, "mediatek,poll-ms", &db->period_ms);
+	i = 200;
+	of_property_read_u32(np, "mediatek,hold-ms", &i);
+	db->hold = msecs_to_jiffies(i);
+	of_property_read_u32(np, "mediatek,vcore-floor-microvolt", &floor_uv);
+	of_property_read_u32(np, "mediatek,hrt-floor-kBps", &hrt_kbps);
+
+	for (i = 0; i < MTK_DRAM_BW_MAX_DEVFREQ; i++) {
+		db->devfreq_np[i] = of_parse_phandle(np, "mediatek,devfreq", i);
+		if (!db->devfreq_np[i])
+			break;
+	}
+	db->num_devfreq = i;
+
+	dvfsrc_np = of_parse_phandle(np, "mediatek,dvfsrc", 0);
+	if (!dvfsrc_np)
+		return dev_err_probe(dev, -EINVAL, "no mediatek,dvfsrc\n");
+	dvfsrc = of_find_device_by_node(dvfsrc_np);
+	of_node_put(dvfsrc_np);
+	if (!dvfsrc)
+		return -EPROBE_DEFER;
+	ret = devm_add_action_or_reset(dev, (void (*)(void *))put_device,
+				       &dvfsrc->dev);
+	if (ret)
+		return ret;
+	if (!platform_get_drvdata(dvfsrc))
+		return -EPROBE_DEFER;
+
+	db->cpu_path = devm_of_icc_get(dev, "cpu");
+	if (IS_ERR(db->cpu_path))
+		return dev_err_probe(dev, PTR_ERR(db->cpu_path), "cpu path\n");
+	db->hrt_path = devm_of_icc_get(dev, "hrt");
+	if (IS_ERR(db->hrt_path))
+		return dev_err_probe(dev, PTR_ERR(db->hrt_path), "hrt path\n");
+	db->vcore = devm_regulator_get(dev, "dvfsrc-vcore");
+	if (IS_ERR(db->vcore))
+		return dev_err_probe(dev, PTR_ERR(db->vcore), "dvfsrc-vcore\n");
+
+	/* Floors first, then the boot vote at the top step, then START. */
+	if (floor_uv) {
+		ret = regulator_set_voltage(db->vcore, floor_uv, INT_MAX);
+		if (ret)
+			return dev_err_probe(dev, ret, "vcore floor %u uV\n",
+					     floor_uv);
+	}
+	if (hrt_kbps) {
+		ret = icc_set_bw(db->hrt_path, hrt_kbps, 0);
+		if (ret)
+			return dev_err_probe(dev, ret, "HRT floor\n");
+	}
+	db->cur_kbps = db->steps[0].kbps;
+	ret = icc_set_bw(db->cpu_path, 0, db->cur_kbps);
+	if (ret)
+		return dev_err_probe(dev, ret, "initial vote\n");
+
+	platform_set_drvdata(pdev, db);
+	ret = mtk_dvfsrc_start(&dvfsrc->dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "DVFSRC start\n");
+
+	ret = devm_delayed_work_autocancel(dev, &db->work, mtk_dram_bw_work);
+	if (ret)
+		return ret;
+	queue_delayed_work(system_freezable_power_efficient_wq, &db->work,
+			   msecs_to_jiffies(db->period_ms));
+
+	dev_info(dev, "vcore floor %u uV, HRT floor %u kBps, %u steps, %u devfreq\n",
+		 floor_uv, hrt_kbps, db->num_steps, db->num_devfreq);
+	return 0;
+}
+
+static void mtk_dram_bw_remove(struct platform_device *pdev)
+{
+	struct mtk_dram_bw *db = platform_get_drvdata(pdev);
+	unsigned int i;
+
+	for (i = 0; i < db->num_devfreq; i++)
+		of_node_put(db->devfreq_np[i]);
+}
+
+static const struct of_device_id mtk_dram_bw_of_match[] = {
+	{ .compatible = "mediatek,mt6897-dram-bw" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mtk_dram_bw_of_match);
+
+static struct platform_driver mtk_dram_bw_driver = {
+	.probe = mtk_dram_bw_probe,
+	.remove = mtk_dram_bw_remove,
+	.driver = {
+		.name = "mtk-dram-bw",
+		.of_match_table = mtk_dram_bw_of_match,
+		.dev_groups = mtk_dram_bw_groups,
+		.suppress_bind_attrs = true,
+	},
+};
+module_platform_driver(mtk_dram_bw_driver);
+
+MODULE_DESCRIPTION("MediaTek DVFSRC floors and load-based DRAM bandwidth vote");
+MODULE_LICENSE("GPL");
-- 
2.56.0

