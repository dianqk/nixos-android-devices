diff --git a/drivers/misc/mediatek/eccci/hif/ccci_hif_ccif.c b/drivers/misc/mediatek/eccci/hif/ccci_hif_ccif.c
index 79b5d42b3c..52b3d5a026 100644
--- a/drivers/misc/mediatek/eccci/hif/ccci_hif_ccif.c
+++ b/drivers/misc/mediatek/eccci/hif/ccci_hif_ccif.c
@@ -786,13 +786,10 @@ static void md_ccif_launch_work(struct md_ccif_ctrl *ccif_ctrl)
 }
 
 /* CCIF interrupt 1 handler: mainly for communication notification */
-static irqreturn_t md_ccif_isr0(int irq, void *data)
+static void md_ccif_process_data0(struct md_ccif_ctrl *ccif_ctrl,
+				  unsigned int ch_id)
 {
-	struct md_ccif_ctrl *ccif_ctrl = (struct md_ccif_ctrl *)data;
-	unsigned int ch_id, i;
-
-	/*must ack first, otherwise IRQ will rush in */
-	ch_id = ccif_read32(ccif_ctrl->ccif_ap_base, APCCIF_RCHNUM);
+	unsigned int i;
 
 	for (i = 0; i < CCIF_CH_NUM; i++)
 		if (ch_id & 0x1 << i) {
@@ -815,6 +812,67 @@ static irqreturn_t md_ccif_isr0(int irq, void *data)
 		md_ccif_launch_work(ccif_ctrl);
 	} else // before 6293, maybe can be phased-out
 		md_ccif_handle_exception(ccif_ctrl);
+}
+
+#define CCIF_EMPTY_IRQ_POLL_MS 20
+
+/*
+ * The level DATA0 interrupt can be pending with no channel in RCHNUM (or
+ * with the CCIF gated, when every read returns 0): acknowledging 0 cannot
+ * clear it and the handler would re-enter until the watchdog resets the
+ * board. Mask it then and poll RCHNUM until a channel shows up, or leave it
+ * masked until the next start when the CCIF is off.
+ */
+static void md_ccif_data0_poll(struct work_struct *work)
+{
+	struct md_ccif_ctrl *ccif_ctrl = container_of(to_delayed_work(work),
+		struct md_ccif_ctrl, data0_poll_work);
+	unsigned int ch_id;
+
+	if (READ_ONCE(ccif_ctrl->ccif_state) != HIFCCIF_STATE_PWRON)
+		return;
+
+	ch_id = ccif_read32(ccif_ctrl->ccif_ap_base, APCCIF_RCHNUM);
+	if (!ch_id) {
+		ccif_ctrl->data0_empty_polls++;
+		if (ccif_ctrl->data0_empty_polls == 1 ||
+		    !(ccif_ctrl->data0_empty_polls % 50))
+			CCCI_NOTICE_LOG(0, TAG,
+				"DATA0 masked after an empty interrupt, poll %u\n",
+				ccif_ctrl->data0_empty_polls);
+		mod_delayed_work(system_wq, &ccif_ctrl->data0_poll_work,
+			msecs_to_jiffies(CCIF_EMPTY_IRQ_POLL_MS));
+		return;
+	}
+
+	md_ccif_process_data0(ccif_ctrl, ch_id);
+	CCCI_NOTICE_LOG(0, TAG, "DATA0 polling found ch 0x%x after %u polls\n",
+		ch_id, ccif_ctrl->data0_empty_polls);
+	if (READ_ONCE(ccif_ctrl->ccif_state) == HIFCCIF_STATE_PWRON &&
+	    atomic_cmpxchg(&ccif_ctrl->data0_irq_masked, 1, 0) == 1)
+		enable_irq(ccif_ctrl->ap_ccif_irq0_id);
+}
+
+static irqreturn_t md_ccif_isr0(int irq, void *data)
+{
+	struct md_ccif_ctrl *ccif_ctrl = (struct md_ccif_ctrl *)data;
+	unsigned int ch_id;
+
+	/*must ack first, otherwise IRQ will rush in */
+	ch_id = ccif_read32(ccif_ctrl->ccif_ap_base, APCCIF_RCHNUM);
+	if (!ch_id) {
+		if (atomic_cmpxchg(&ccif_ctrl->data0_irq_masked, 0, 1) == 0) {
+			ccif_ctrl->data0_empty_polls = 0;
+			disable_irq_nosync(irq);
+			mod_delayed_work(system_wq, &ccif_ctrl->data0_poll_work,
+				msecs_to_jiffies(CCIF_EMPTY_IRQ_POLL_MS));
+			CCCI_NOTICE_LOG(0, TAG,
+				"DATA0 interrupt without a channel: masked\n");
+		}
+		return IRQ_HANDLED;
+	}
+
+	md_ccif_process_data0(ccif_ctrl, ch_id);
 
 	return IRQ_HANDLED;
 }
