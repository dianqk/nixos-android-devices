@@ -360,6 +458,7 @@ static irqreturn_t cmdq_irq_handler(int irq, void *dev)
 {
 	struct cmdq *cmdq = dev;
 	unsigned long irq_status, flags = 0L;
+	bool handled = false;
 	int bit;
 
 	irq_status = readl(cmdq->base + CMDQ_CURR_IRQ_STATUS) & cmdq->irq_mask;
@@ -369,35 +468,129 @@ static irqreturn_t cmdq_irq_handler(int irq, void *dev)
 	for_each_clear_bit(bit, &irq_status, cmdq->pdata->thread_nr) {
 		struct cmdq_thread *thread = &cmdq->thread[bit];
 
+		/*
+		 * A thread no client has requested belongs to someone else
+		 * (e.g. the secure world on a shared GCE): leave its state
+		 * alone and let its owner handle the interrupt.
+		 */
+		if (!thread->chan)
+			continue;
+
 		spin_lock_irqsave(&thread->chan->lock, flags);
 		cmdq_thread_irq_handler(cmdq, thread);
 		spin_unlock_irqrestore(&thread->chan->lock, flags);
+		handled = true;
 	}
 
 	pm_runtime_mark_last_busy(cmdq->mbox.dev);
 
-	return IRQ_HANDLED;
+	return handled ? IRQ_HANDLED : IRQ_NONE;
+}
