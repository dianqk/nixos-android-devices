+/* The caller holds runtime PM until packet retirement and serializes display
+ * requests. Firmware lifetime is owned by runtime resume/suspend, not this API.
+ */
+int cmdq_mbox_disp_va_enable(struct mbox_chan *chan)
+{
+	struct cmdq *cmdq = container_of(chan->mbox, struct cmdq, mbox);
+	struct arm_smccc_res res;
+	int i, ret = 0;
+
+	if (!cmdq->pdata->default_tokens)
+		return -EOPNOTSUPP;
+	/* Never wait for runtime resume while holding firmware_lock. */
+	if (!pm_runtime_active(cmdq->mbox.dev))
+		return -EHOSTDOWN;
+	mutex_lock(&cmdq->firmware_lock);
+	if (cmdq->firmware_failed || !cmdq->firmware_enabled) {
+		ret = -EIO;
+		goto unlock;
+	}
+	writel(692, cmdq->base + CMDQ_SYNC_TOKEN_UPDATE);
+	writel(693, cmdq->base + CMDQ_SYNC_TOKEN_UPDATE);
+	for (i = 692; i <= 693; i++) {
+		writel(i, cmdq->base + CMDQ_SYNC_TOKEN_ID);
+		if (readl(cmdq->base + CMDQ_SYNC_TOKEN_VALUE)) {
+			ret = -EIO;
+			goto unlock;
+		}
+	}
+	arm_smccc_smc(MTK_SIP_SMC_CMD(0x518), 1, 0, 0, 0, 0, 0, 0, &res);
+	dev_dbg(cmdq->mbox.dev, "display VA request raw=%#lx/%#lx/%#lx/%#lx\n",
+		res.a0, res.a1, res.a2, res.a3);
+unlock:
+	mutex_unlock(&cmdq->firmware_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(cmdq_mbox_disp_va_enable);
+
+/* Synchronize with the IRQ's callback -> unlink -> disable sequence. Merely
+ * observing callback completion does not retire the packet backing storage.
+ * The caller must keep runtime PM and the channel alive across this query.
+ */
+bool cmdq_mbox_channel_idle(struct mbox_chan *chan)
+{
+	struct cmdq_thread *thread = chan->con_priv;
+	unsigned long flags;
+	bool idle;
+
+	spin_lock_irqsave(&chan->lock, flags);
+	idle = list_empty(&thread->task_busy_list) &&
+		!(readl(thread->base + CMDQ_THR_ENABLE_TASK) & CMDQ_THR_ENABLED);
+	spin_unlock_irqrestore(&chan->lock, flags);
+	return idle;
+}
+EXPORT_SYMBOL_GPL(cmdq_mbox_channel_idle);
