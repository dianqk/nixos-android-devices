+	if (cmdq->num_init_tokens) {
+		for (i = 0; i < cmdq->pdata->thread_nr; i++) {
+			if (!(readl(cmdq->thread[i].base + CMDQ_THR_ENABLE_TASK) &
+			      CMDQ_THR_ENABLED))
+				continue;
+			dev_err(cmdq->mbox.dev, "GCE thread %d active; initialization refused\n", i);
+			clk_bulk_disable(cmdq->num_clocks, cmdq->clocks);
+			return -EBUSY;
+		}
+	}
 	cmdq_vm_init(cmdq);
 	cmdq_gctl_value_toggle(cmdq, true);
+	if (cmdq->pdata->default_tokens) {
+		writel(readl(cmdq->base + CMDQ_GCE_BUS_GCTL) | BIT(0),
+		       cmdq->base + CMDQ_GCE_BUS_GCTL);
+		writel(readl(cmdq->base + CMDQ_GCE_TPR_MASK) | BIT(31),
+		       cmdq->base + CMDQ_GCE_TPR_MASK);
+	}
 
 	writel(CMDQ_THR_ACTIVE_SLOT_CYCLES, cmdq->base + CMDQ_THR_SLOT_CYCLES);
 	for (i = 0; i <= CMDQ_MAX_EVENT; i++)
 		writel(i, cmdq->base + CMDQ_SYNC_TOKEN_UPDATE);
-	clk_bulk_disable(cmdq->pdata->gce_num, cmdq->clocks);
+	for (i = 0; i < cmdq->num_init_tokens; i++)
+		writel(BIT(16) | cmdq->init_tokens[i],
+		       cmdq->base + CMDQ_SYNC_TOKEN_UPDATE);
+	clk_bulk_disable(cmdq->num_clocks, cmdq->clocks);
+	return 0;
 }
 
