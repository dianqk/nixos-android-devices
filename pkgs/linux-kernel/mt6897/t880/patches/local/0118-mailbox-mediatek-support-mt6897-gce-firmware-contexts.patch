+static bool cmdq_normal_channels_idle(struct cmdq *cmdq)
+{
+	unsigned int i;
+
+	for (i = 0; i < cmdq->pdata->thread_nr; i++) {
+		if (cmdq->pdata->reserved_threads & BIT(i))
+			continue;
+		if (!cmdq_mbox_channel_idle(&cmdq->mbox.chans[i]))
+			return false;
+	}
+	return true;
+}
+
+static void cmdq_prebuilt_request(struct cmdq *cmdq, unsigned int request)
+{
+	struct arm_smccc_res res;
+
+	/* MT6897's currently supported engine is GCE_D (firmware instance 0). */
+	arm_smccc_smc(MTK_SIP_SMC_CMD(0x518), request, 0, 0, 0, 0, 0, 0, &res);
+	dev_dbg(cmdq->mbox.dev, "prebuilt request %u raw=%#lx/%#lx/%#lx/%#lx\n",
+		request, res.a0, res.a1, res.a2, res.a3);
 }
 
 static int cmdq_runtime_resume(struct device *dev)
 {
 	struct cmdq *cmdq = dev_get_drvdata(dev);
+	unsigned int i;
 	int ret;
 
-	ret = clk_bulk_enable(cmdq->pdata->gce_num, cmdq->clocks);
+	if (READ_ONCE(cmdq->firmware_failed))
+		return -EIO;
+	ret = clk_bulk_enable(cmdq->num_clocks, cmdq->clocks);
 	if (ret)
 		return ret;
-
-	cmdq_gctl_value_toggle(cmdq, true);
+	if (cmdq->pdata->default_tokens) {
+		/* PM core serializes first/last use. No client holds a channel
+		 * spinlock while waiting for this sleepable callback.
+		 */
+		ret = cmdq_init(cmdq);
+		if (ret)
+			goto disable_clocks;
+		for (i = 0; i < cmdq->num_init_tokens; i++) {
+			writel(cmdq->init_tokens[i], cmdq->base + CMDQ_SYNC_TOKEN_ID);
+			if (readl(cmdq->base + CMDQ_SYNC_TOKEN_VALUE) != 1) {
+				ret = -EIO;
+				goto disable_clocks;
+			}
+		}
+		dev_dbg(dev, "prebuilt initialized tokens=%u SLOT=%#x BUS=%#x TPR=%#x\n",
+			cmdq->num_init_tokens, readl(cmdq->base + CMDQ_THR_SLOT_CYCLES),
+			readl(cmdq->base + CMDQ_GCE_BUS_GCTL),
+			readl(cmdq->base + CMDQ_GCE_TPR_MASK));
+		mutex_lock(&cmdq->firmware_lock);
+		cmdq_prebuilt_request(cmdq, 3);
+		cmdq->firmware_enabled = true;
+		mutex_unlock(&cmdq->firmware_lock);
+	} else {
+		cmdq_gctl_value_toggle(cmdq, true);
+	}
 	return 0;
+disable_clocks:
+	clk_bulk_disable(cmdq->num_clocks, cmdq->clocks);
+	return ret;
 }
 
 static int cmdq_runtime_suspend(struct device *dev)
 {
 	struct cmdq *cmdq = dev_get_drvdata(dev);
-
