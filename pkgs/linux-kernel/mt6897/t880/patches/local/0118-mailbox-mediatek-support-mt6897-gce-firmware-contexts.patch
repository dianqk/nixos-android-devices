+static int cmdq_link_smi(struct device *dev)
+{
+	struct device_node *node;
+	struct platform_device *supplier;
+	unsigned int i;
+
+	if (of_count_phandle_with_args(dev->of_node, "mediatek,smi", NULL) != 2)
+		return -EINVAL;
+	for (i = 0; i < 2; i++) {
+		node = of_parse_phandle(dev->of_node, "mediatek,smi", i);
+		if (!node)
+			return -EINVAL;
+		supplier = of_find_device_by_node(node);
+		of_node_put(node);
+		if (!supplier)
+			return -EPROBE_DEFER;
+		if (!device_is_bound(&supplier->dev)) {
+			put_device(&supplier->dev);
+			return -EPROBE_DEFER;
+		}
+		if (!device_link_add(dev, &supplier->dev,
+				     DL_FLAG_PM_RUNTIME | DL_FLAG_AUTOREMOVE_CONSUMER)) {
+			put_device(&supplier->dev);
+			return -ENOMEM;
+		}
+		put_device(&supplier->dev);
+	}
+	return 0;
+}
