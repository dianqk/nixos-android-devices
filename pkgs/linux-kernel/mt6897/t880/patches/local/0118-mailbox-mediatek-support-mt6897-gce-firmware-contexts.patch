+static int cmdq_get_init_tokens(struct device *dev, struct cmdq *cmdq)
+{
+	int count, ret, i, j;
+
+	if (!cmdq->pdata->default_tokens)
+		return 0;
+	count = of_property_count_u16_elems(dev->of_node, "mediatek,default-tokens");
+	if (count <= 0 || count > 32)
+		return dev_err_probe(dev, -EINVAL, "invalid initial token count\n");
+	cmdq->init_tokens = devm_kcalloc(dev, count, sizeof(*cmdq->init_tokens), GFP_KERNEL);
+	if (!cmdq->init_tokens)
+		return -ENOMEM;
+	ret = of_property_read_u16_array(dev->of_node, "mediatek,default-tokens",
+					cmdq->init_tokens, count);
+	if (ret)
+		return ret;
+	for (i = 0; i < count; i++) {
+		if (cmdq->init_tokens[i] > CMDQ_MAX_EVENT)
+			return -EINVAL;
+		for (j = 0; j < i; j++)
+			if (cmdq->init_tokens[i] == cmdq->init_tokens[j])
+				return -EINVAL;
+	}
+	cmdq->num_init_tokens = count;
+	return 0;
+}
