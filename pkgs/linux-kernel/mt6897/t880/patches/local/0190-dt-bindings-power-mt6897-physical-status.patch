From 065337d516f246eba26fa29162ed043c06d9e595 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Sat, 7 Nov 2026 00:23:07 +0800
Subject: [PATCH 190/192] dt-bindings: power: mediatek: describe MT6897
 physical status syscon

---
 .../power/mediatek,power-controller.yaml        | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/Documentation/devicetree/bindings/power/mediatek,power-controller.yaml b/Documentation/devicetree/bindings/power/mediatek,power-controller.yaml
index d318b900e7..6571ff054e 100644
--- a/Documentation/devicetree/bindings/power/mediatek,power-controller.yaml
+++ b/Documentation/devicetree/bindings/power/mediatek,power-controller.yaml
@@ -62,6 +62,13 @@ properties:
     maxItems: 1
     description: Domain ID whose external parent is specified by power-domains.
 
+  mediatek,spm:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      Always-on MT6897 SPM syscon containing physical domain power status.
+      Allows the HWV controller to verify OVL off epochs before transferring
+      inherited clock ownership. Omission retains inherited clock votes.
+
   access-controllers:
     description:
       A number of phandles to external blocks to set and clear the required
@@ -175,6 +182,16 @@ dependentRequired:
     - power-domains
 
 allOf:
+  - if:
+      not:
+        properties:
+          compatible:
+            contains:
+              const: mediatek,mt6897-hwv-power-controller
+    then:
+      properties:
+        mediatek,spm: false
+
   - if:
       properties:
         compatible:
