diff --git a/drivers/gpu/drm/mediatek/mtk_drm_pm.c b/drivers/gpu/drm/mediatek/mtk_drm_pm.c
new file mode 100644
index 0000000000..026adaaa52
--- /dev/null
+++ b/drivers/gpu/drm/mediatek/mtk_drm_pm.c
@@ -0,0 +1,397 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/list.h>
+#include <linux/pm_runtime.h>
+#include <linux/slab.h>
+
+#include "mtk_drm_pm.h"
+
+struct mtk_drm_pm_node {
+	struct list_head node;
+	struct list_head order;
+	struct device *dev;
+	struct mtk_drm_pm_node **suppliers;
+	unsigned int num_suppliers;
+	unsigned int consumers;
+	bool pinned;
+};
+
+struct mtk_drm_pm_graph {
+	struct list_head nodes;
+	struct list_head ordered;
+	unsigned int count;
+};
+
+struct mtk_drm_pm_group {
+	struct mtk_drm_pm_graph *graph;
+	unsigned int count;
+	unsigned int acquired;
+	bool faulted;
+	struct device *controllers[];
+};
+
+struct mtk_drm_pm_group *
+mtk_drm_pm_group_create(struct device * const *controllers, unsigned int count)
+{
+	struct mtk_drm_pm_group *group;
+	unsigned int i;
+
+	if (!count)
+		return ERR_PTR(-EINVAL);
+	group = kzalloc(struct_size(group, controllers, count), GFP_KERNEL);
+	if (!group)
+		return ERR_PTR(-ENOMEM);
+
+	group->count = count;
+	for (i = 0; i < count; i++)
+		group->controllers[i] = get_device(controllers[i]);
+
+	return group;
+}
+
+void mtk_drm_pm_group_destroy(struct mtk_drm_pm_group *group)
+{
+	unsigned int i;
+
+	if (!group)
+		return;
+
+	/* A failed stop can leave hardware live. Don't drop its resources on
+	 * unbind. This record and its device references outlive the CRTC.
+	 */
+	if (group->acquired || group->graph) {
+		dev_err(group->controllers[0],
+			"Retaining display PM resources after failed teardown\n");
+		return;
+	}
+
+	for (i = 0; i < group->count; i++)
+		put_device(group->controllers[i]);
+	kfree(group);
+}
+
+/* An unsuccessful get leaves only its successfully acquired prefix owned. */
+int mtk_drm_pm_group_get(struct mtk_drm_pm_group *group)
+{
+	int ret;
+
+	if (group->faulted || group->acquired || group->graph)
+		return -EIO;
+
+	while (group->acquired < group->count) {
+		ret = pm_runtime_resume_and_get(group->controllers[group->acquired]);
+		if (ret < 0)
+			return ret;
+		group->acquired++;
+	}
+
+	return 0;
+}
+
+static void mtk_drm_pm_graph_free(struct mtk_drm_pm_graph *graph)
+{
+	struct mtk_drm_pm_node *node, *next;
+
+	list_for_each_entry_safe(node, next, &graph->nodes, node) {
+		put_device(node->dev);
+		kfree(node->suppliers);
+		kfree(node);
+	}
+	kfree(graph);
+}
+
+static struct mtk_drm_pm_node *
+mtk_drm_pm_graph_add(struct mtk_drm_pm_graph *graph, struct device *dev)
+{
+	struct mtk_drm_pm_node *node;
+
+	list_for_each_entry(node, &graph->nodes, node)
+		if (node->dev == dev)
+			return node;
+
+	node = kzalloc(sizeof(*node), GFP_KERNEL);
+	if (!node)
+		return ERR_PTR(-ENOMEM);
+
+	node->dev = get_device(dev);
+	list_add_tail(&node->node, &graph->nodes);
+	graph->count++;
+	return node;
+}
+
+static int mtk_drm_pm_graph_edge(struct mtk_drm_pm_graph *graph,
+				 struct mtk_drm_pm_node *consumer, struct device *dev)
+{
+	struct mtk_drm_pm_node *supplier;
+	unsigned int i;
+
+	supplier = mtk_drm_pm_graph_add(graph, dev);
+	if (IS_ERR(supplier))
+		return PTR_ERR(supplier);
+
+	for (i = 0; i < consumer->num_suppliers; i++)
+		if (consumer->suppliers[i] == supplier)
+			return 0;
+
+	consumer->suppliers[consumer->num_suppliers++] = supplier;
+	supplier->consumers++;
+	return 0;
+}
+
+static int mtk_drm_pm_graph_expand(struct mtk_drm_pm_graph *graph,
+				   struct mtk_drm_pm_node *node)
+{
+	struct device **suppliers;
+	struct device *parent = node->dev->parent;
+	unsigned int count, i;
+	int ret;
+
+	ret = device_links_get_runtime_suppliers(node->dev, &suppliers, &count);
+	if (ret)
+		return ret;
+
+	if (count || parent) {
+		node->suppliers = kcalloc((size_t)count + !!parent,
+					  sizeof(*node->suppliers), GFP_KERNEL);
+		if (!node->suppliers) {
+			ret = -ENOMEM;
+			goto out;
+		}
+	}
+
+	for (i = 0; i < count; i++) {
+		ret = mtk_drm_pm_graph_edge(graph, node, suppliers[i]);
+		if (ret)
+			goto out;
+	}
+	if (parent)
+		ret = mtk_drm_pm_graph_edge(graph, node, parent);
+
+out:
+	device_links_put_suppliers(suppliers, count);
+	return ret;
+}
+
+static int mtk_drm_pm_graph_sort(struct mtk_drm_pm_graph *graph)
+{
+	struct mtk_drm_pm_node *node;
+	unsigned int count = 0, i;
+
+	list_for_each_entry(node, &graph->nodes, node)
+		if (!node->consumers)
+			list_add_tail(&node->order, &graph->ordered);
+
+	/* Newly ready suppliers go after all their consumers. */
+	list_for_each_entry(node, &graph->ordered, order) {
+		count++;
+		for (i = 0; i < node->num_suppliers; i++) {
+			struct mtk_drm_pm_node *supplier = node->suppliers[i];
+
+			if (!--supplier->consumers)
+				list_add_tail(&supplier->order, &graph->ordered);
+		}
+	}
+
+	return count == graph->count ? 0 : -ELOOP;
+}
+
+static bool mtk_drm_pm_controller_held(struct mtk_drm_pm_group *group,
+				       struct device *dev)
+{
+	unsigned int i;
+
+	for (i = 0; i < group->acquired; i++)
+		if (group->controllers[i] == dev)
+			return true;
+	return false;
+}
+
+struct mtk_drm_pm_state {
+	enum rpm_status status;
+	bool enabled;
+	bool in_use;
+	bool unsettled;
+};
+
+static struct mtk_drm_pm_state mtk_drm_pm_read_state(struct device *dev)
+{
+	struct mtk_drm_pm_state state = { };
+#ifdef CONFIG_PM
+	unsigned long flags;
+
+	spin_lock_irqsave(&dev->power.lock, flags);
+	state.status = dev->power.runtime_status;
+	state.enabled = !dev->power.disable_depth;
+	state.in_use = atomic_read(&dev->power.usage_count) > 0 ||
+		       (!dev->power.ignore_children &&
+			atomic_read(&dev->power.child_count) > 0);
+	state.unsettled = state.status == RPM_SUSPENDING ||
+			  state.status == RPM_RESUMING ||
+			  dev->power.idle_notification ||
+			  (dev->power.request_pending &&
+			   dev->power.request == RPM_REQ_RESUME);
+	spin_unlock_irqrestore(&dev->power.lock, flags);
+#endif
+	return state;
+}
+
+static int mtk_drm_pm_pin(struct mtk_drm_pm_node *node)
+{
+	struct device *dev = node->dev;
+	struct mtk_drm_pm_state state = mtk_drm_pm_read_state(dev);
+	int ret;
+
+	if (!state.enabled)
+		return 0;
+
+	ret = pm_runtime_get_if_active(dev);
+	if (!ret) {
+		state = mtk_drm_pm_read_state(dev);
+		if (state.unsettled)
+			pm_runtime_barrier(dev);
+		else if (state.enabled && state.status == RPM_SUSPENDED)
+			return 0;
+
+		ret = pm_runtime_get_if_active(dev);
+		if (!ret) {
+			state = mtk_drm_pm_read_state(dev);
+			if (!state.enabled || state.unsettled ||
+			    state.status != RPM_SUSPENDED)
+				return -EAGAIN;
+		}
+	}
+
+	if (ret > 0) {
+		node->pinned = true;
+		return 0;
+	}
+
+	return ret;
+}
+
+int mtk_drm_pm_prepare_put(struct mtk_drm_pm_group *group,
+			   struct device * const *participants, unsigned int count)
+{
+	struct mtk_drm_pm_graph *graph;
+	struct mtk_drm_pm_node *node;
+	unsigned int i;
+	int ret;
+
+	if (group->faulted || group->graph)
+		return -EIO;
+	if (!group->acquired)
+		return 0;
+
+	graph = kzalloc(sizeof(*graph), GFP_KERNEL);
+	if (!graph)
+		return -ENOMEM;
+	INIT_LIST_HEAD(&graph->nodes);
+	INIT_LIST_HEAD(&graph->ordered);
+
+	for (i = 0; i < group->acquired; i++) {
+		node = mtk_drm_pm_graph_add(graph, group->controllers[i]);
+		if (IS_ERR(node)) {
+			ret = PTR_ERR(node);
+			goto err_graph;
+		}
+	}
+	for (i = 0; i < count; i++) {
+		node = mtk_drm_pm_graph_add(graph, participants[i]);
+		if (IS_ERR(node)) {
+			ret = PTR_ERR(node);
+			goto err_graph;
+		}
+	}
+
+	/* Expansion appends actual runtime suppliers and physical parents. */
+	list_for_each_entry(node, &graph->nodes, node) {
+		ret = mtk_drm_pm_graph_expand(graph, node);
+		if (ret)
+			goto err_graph;
+	}
+	ret = mtk_drm_pm_graph_sort(graph);
+	if (ret)
+		goto err_graph;
+
+	/* Pin suppliers first, before settling any in-flight consumer put. */
+	list_for_each_entry_reverse(node, &graph->ordered, order) {
+		if (mtk_drm_pm_controller_held(group, node->dev))
+			continue;
+		ret = mtk_drm_pm_pin(node);
+		if (ret)
+			goto err_pins;
+	}
+	group->graph = graph;
+	return 0;
+
+err_pins:
+	/* No participant put by the caller has happened. Undo only our pins. */
+	list_for_each_entry(node, &graph->ordered, order)
+		if (node->pinned)
+			pm_runtime_put_noidle(node->dev);
+err_graph:
+	mtk_drm_pm_graph_free(graph);
+	return ret;
+}
+
+static int mtk_drm_pm_put(struct device *dev)
+{
+	struct mtk_drm_pm_state state;
+	int ret = pm_runtime_put_sync_suspend(dev);
+
+	/* The put consumed our ref, even if the suspend was rejected. */
+	if (ret < 0 && ret != -EBUSY && ret != -EAGAIN)
+		return ret;
+
+	state = mtk_drm_pm_read_state(dev);
+	if (state.unsettled) {
+		pm_runtime_barrier(dev);
+		state = mtk_drm_pm_read_state(dev);
+	}
+	if (!state.enabled || state.unsettled)
+		return -EAGAIN;
+
+	/* A stable external user or child may legitimately keep it active. */
+	if (state.status == RPM_SUSPENDED ||
+	    (state.status == RPM_ACTIVE && state.in_use))
+		return 0;
+
+	return ret < 0 ? ret : -EBUSY;
+}
+
+int mtk_drm_pm_group_put(struct mtk_drm_pm_group *group)
+{
+	struct mtk_drm_pm_graph *graph = group->graph;
+	struct mtk_drm_pm_node *node;
+	int ret;
+
+	if (group->faulted)
+		return -EIO;
+	if (!graph)
+		return group->acquired ? -EIO : 0;
+
+	list_for_each_entry(node, &graph->ordered, order) {
+		if (!node->pinned)
+			continue;
+		node->pinned = false;
+		ret = mtk_drm_pm_put(node->dev);
+		if (ret)
+			goto fault;
+	}
+	group->graph = NULL;
+	mtk_drm_pm_graph_free(graph);
+
+	while (group->acquired) {
+		ret = mtk_drm_pm_put(group->controllers[--group->acquired]);
+		if (ret)
+			goto fault;
+	}
+
+	return 0;
+
+fault:
+	/* Retain the still-owned pins and group refs, without retrying puts. */
+	group->faulted = true;
+	return ret;
+}
