@@ -144,9 +147,22 @@ static inline struct mtk_crtc_state *to_mtk_crtc_state(struct drm_crtc_state *s)
 	return container_of(s, struct mtk_crtc_state, base);
 }
 
+static bool mtk_crtc_uses_ordered_pm(const struct mtk_drm_private *priv)
+{
+	return IS_ENABLED(CONFIG_PM) && priv->data->ordered_runtime_pm;
+}
+
 static bool mtk_crtc_faulted(struct mtk_crtc *mtk_crtc)
 {
-	return READ_ONCE(mtk_crtc->cmdq_faulted);
+	struct mtk_drm_private *priv;
+
+	if (READ_ONCE(mtk_crtc->cmdq_faulted))
+		return true;
+	if (!mtk_crtc->pm_group)
+		return false;
+
+	priv = mtk_crtc->base.dev->dev_private;
+	return READ_ONCE(priv->pm_transition_failed);
 }
 
 static void mtk_crtc_finish_page_flip(struct mtk_crtc *mtk_crtc)
@@ -290,6 +306,7 @@ static void mtk_crtc_destroy(struct drm_crtc *crtc)
 		mtk_ddp_comp_unregister_vblank_cb(comp);
 	}
 
+	mtk_drm_pm_group_destroy(mtk_crtc->pm_group);
 	drm_crtc_cleanup(crtc);
 }
 
@@ -1281,6 +1298,64 @@ void mtk_crtc_async_update(struct drm_crtc *crtc, struct drm_plane *plane,
 	mutex_unlock(&mtk_crtc->hw_lock);
 }
 
+static int mtk_crtc_prepare_pm_put(struct mtk_crtc *mtk_crtc)
+{
+	struct drm_device *drm = mtk_crtc->base.dev;
+	struct mtk_drm_private *priv = drm->dev_private;
+	unsigned int comps = mtk_crtc->ddp_comp_nr + mtk_crtc->shadow_comp_nr;
+	struct device **participants;
+	unsigned int i, count = 0;
+	int ret;
+
+	lockdep_assert_held(&priv->pm_transition_lock);
+	participants = kcalloc(2 * comps + mtk_crtc->num_controllers + 1,
+			       sizeof(*participants), GFP_KERNEL);
+	if (!participants)
+		return -ENOMEM;
+
+	participants[count++] = drm->dev;
+	for (i = 0; i < mtk_crtc->num_controllers; i++) {
+		struct mtk_drm_private *controller;
+
+		controller = mtk_crtc_get_controller_priv(mtk_crtc,
+							  mtk_crtc->controller_idmap[i]);
+		participants[count++] = controller->mutex_dev;
+	}
+	for (i = 0; i < comps; i++) {
+		struct mtk_ddp_comp *comp;
+		struct device *twin;
+
+		if (i < mtk_crtc->ddp_comp_nr)
+			comp = mtk_crtc->ddp_comp[i];
+		else
+			comp = mtk_crtc->shadow_comp[i - mtk_crtc->ddp_comp_nr];
+		if (!comp || !comp->dev)
+			continue;
+		participants[count++] = comp->dev;
+		if (comp->type == MTK_DISP_OVL || comp->type == MTK_DISP_OVL_2L) {
+			twin = mtk_ovl_get_twin(comp->dev);
+			if (twin)
+				participants[count++] = twin;
+		}
+	}
+	ret = mtk_drm_pm_prepare_put(mtk_crtc->pm_group, participants, count);
+	kfree(participants);
+	return ret;
+}
+
+static void mtk_crtc_pm_fault(struct mtk_crtc *mtk_crtc,
+			     struct drm_crtc_state *passed, int ret)
+{
+	struct drm_device *drm = mtk_crtc->base.dev;
+	struct mtk_drm_private *priv = drm->dev_private;
+
+	lockdep_assert_held(&priv->pm_transition_lock);
+	drm_err(drm, "[CRTC:%d] Ordered runtime PM failed: %d; retaining resources\n",
+		mtk_crtc->base.base.id, ret);
+	WRITE_ONCE(priv->pm_transition_failed, true);
+	mtk_crtc_fault_events(mtk_crtc, passed);
+}
+
 static void mtk_crtc_atomic_enable(struct drm_crtc *crtc,
 				   struct drm_atomic_commit *state)
 {
@@ -1288,7 +1363,9 @@ static void mtk_crtc_atomic_enable(struct drm_crtc *crtc,
 	struct drm_crtc_state *passed = drm_atomic_get_new_crtc_state(state, crtc);
 	struct mtk_ddp_comp *comp = mtk_crtc->ddp_comp[mtk_crtc->config_comp_idx];
 	struct drm_device *dev = mtk_crtc->base.dev;
-	int ret;
+	struct mtk_drm_private *priv = dev->dev_private;
+	bool powered = false;
+	int ret, put_ret;
 
 	drm_dbg_driver(dev, "%s %d\n", __func__, crtc->base.id);
 	if (mtk_crtc->cmdq_checked_stop) {
@@ -1301,22 +1378,59 @@ static void mtk_crtc_atomic_enable(struct drm_crtc *crtc,
 			goto out_unlock;
 	}
 
+	if (mtk_crtc->pm_group) {
+		mutex_lock(&priv->pm_transition_lock);
+		if (mtk_crtc_faulted(mtk_crtc)) {
+			mtk_crtc_fault_events(mtk_crtc, passed);
+			goto out_pm_unlock;
+		}
+		ret = mtk_drm_pm_group_get(mtk_crtc->pm_group);
+		if (ret)
+			goto err_ordered;
+	}
+
 	ret = mtk_ddp_comp_power_on(comp);
 	if (ret < 0) {
 		DRM_DEV_ERROR(comp->dev, "Failed to enable power domain: %d\n", ret);
+		if (mtk_crtc->pm_group)
+			goto err_ordered;
 		goto out_unlock;
 	}
 
+	powered = true;
 	mtk_crtc_update_output(crtc, state);
 
 	ret = mtk_crtc_ddp_hw_init(mtk_crtc);
 	if (ret) {
+		if (mtk_crtc->pm_group)
+			goto err_ordered;
 		mtk_ddp_comp_power_off(comp);
 		goto out_unlock;
 	}
 
 	drm_crtc_vblank_on(crtc);
 	mtk_crtc->enabled = true;
+	goto out_pm_unlock;
+
+err_ordered:
+	/* hw_init may have queued its own unwind puts. Hold the group while
+	 * settling that closure, and pin it before the config component's put.
+	 */
+	put_ret = mtk_crtc_prepare_pm_put(mtk_crtc);
+	if (!put_ret) {
+		if (powered)
+			mtk_ddp_comp_power_off(comp);
+		put_ret = mtk_drm_pm_group_put(mtk_crtc->pm_group);
+	}
+	if (put_ret)
+		mtk_crtc_pm_fault(mtk_crtc, passed, put_ret);
+	else
+		mtk_crtc_fault_events(mtk_crtc, passed);
+	drm_err(dev, "[CRTC:%d] Ordered enable failed: %d\n", crtc->base.id, ret);
+
+out_pm_unlock:
+	if (mtk_crtc->pm_group)
+		mutex_unlock(&priv->pm_transition_lock);
 out_unlock:
 	if (mtk_crtc->cmdq_checked_stop)
 		mutex_unlock(&mtk_crtc->hw_lock);
@@ -1329,7 +1443,8 @@ static void mtk_crtc_atomic_disable(struct drm_crtc *crtc,
 	struct drm_crtc_state *passed = drm_atomic_get_new_crtc_state(state, crtc);
 	struct mtk_ddp_comp *comp = mtk_crtc->ddp_comp[mtk_crtc->config_comp_idx];
 	struct drm_device *dev = mtk_crtc->base.dev;
-	int i;
+	struct mtk_drm_private *priv = dev->dev_private;
+	int i, ret;
 
 	drm_dbg_driver(dev, "%s %d\n", __func__, crtc->base.id);
 	if (mtk_crtc->cmdq_checked_stop)
@@ -1408,11 +1523,32 @@ static void mtk_crtc_atomic_disable(struct drm_crtc *crtc,
 		drm_crtc_vblank_put(crtc);
 	}
 
+	if (mtk_crtc->pm_group) {
+		mutex_lock(&priv->pm_transition_lock);
+		if (mtk_crtc_faulted(mtk_crtc)) {
+			mtk_crtc_fault_events(mtk_crtc, passed);
+			goto out_pm_unlock;
+		}
+		ret = mtk_crtc_prepare_pm_put(mtk_crtc);
+		if (ret) {
+			mtk_crtc_pm_fault(mtk_crtc, passed, ret);
+			goto out_pm_unlock;
+		}
+	}
+
 	drm_crtc_vblank_off(crtc);
 	mtk_crtc_ddp_hw_fini(mtk_crtc);
 	mtk_ddp_comp_power_off(comp);
 
 	mtk_crtc->enabled = false;
+	if (mtk_crtc->pm_group) {
+		ret = mtk_drm_pm_group_put(mtk_crtc->pm_group);
+		if (ret)
+			mtk_crtc_pm_fault(mtk_crtc, passed, ret);
+	}
+out_pm_unlock:
+	if (mtk_crtc->pm_group)
+		mutex_unlock(&priv->pm_transition_lock);
 out_unlock:
 	if (mtk_crtc->cmdq_checked_stop)
 		mutex_unlock(&mtk_crtc->hw_lock);
@@ -1824,6 +1960,9 @@ static int mtk_crtc_init_multi_controller_properties(struct device *dev,
 			mtk_crtc->controller_idmap[z] = comp->controller_id;
 			z++;
 
+			if (mtk_crtc_uses_ordered_pm(priv))
+				break;
+
 			/*
 			 * If this is a multi-controller path, link the follower
 			 * with the leader controller to make sure that any call
@@ -1845,6 +1984,58 @@ static int mtk_crtc_init_multi_controller_properties(struct device *dev,
 	return 0;
 }
 
+static int mtk_crtc_init_pm_group(struct mtk_crtc *mtk_crtc)
+{
+	struct drm_device *drm = mtk_crtc->base.dev;
+	struct mtk_drm_private *priv = drm->dev_private;
+	struct device *controllers[MTK_DISP_CONTROLLER_MAX_CONTROLLERS_NUM];
+	unsigned long mask = 0;
+	unsigned int count = 0, i, j;
+	bool found_parent = false;
+
+	if (!mtk_crtc_uses_ordered_pm(priv))
+		return 0;
+
+	for (i = 0; i < mtk_crtc->num_controllers; i++)
+		mask |= BIT(mtk_crtc->controller_idmap[i]);
+
+	/* The DRM device itself is also a runtime consumer. Its MMSYS parent
+	 * depends on bind order and need not be part of this CRTC's routes.
+	 */
+	for (i = 0; i < priv->data->mmsys_dev_num; i++) {
+		struct mtk_drm_private *controller = priv->all_drm_private[i];
+
+		if (controller->mmsys_dev == drm->dev->parent) {
+			mask |= BIT(controller->data->mmsys_id);
+			found_parent = true;
+		}
+	}
+	if (!found_parent)
+		return -ENODEV;
+
+	for_each_set_bit(i, &mask, MTK_DISP_CONTROLLER_MAX_CONTROLLERS_NUM) {
+		for (j = 0; j < priv->data->mmsys_dev_num; j++) {
+			struct mtk_drm_private *controller = priv->all_drm_private[j];
+
+			if (controller->data->mmsys_id != i)
+				continue;
+			controllers[count++] = controller->mmsys_dev;
+			break;
+		}
+		if (j == priv->data->mmsys_dev_num)
+			return -ENODEV;
+	}
+
+	mtk_crtc->pm_group = mtk_drm_pm_group_create(controllers, count);
+	if (IS_ERR(mtk_crtc->pm_group)) {
+		int ret = PTR_ERR(mtk_crtc->pm_group);
+
+		mtk_crtc->pm_group = NULL;
+		return ret;
+	}
+	return 0;
+}
+
 static int mtk_crtc_init_mutex(struct device *dev, struct mtk_crtc *mtk_crtc)
 {
 	unsigned int i;
@@ -1859,18 +2050,26 @@ static int mtk_crtc_init_mutex(struct device *dev, struct mtk_crtc *mtk_crtc)
 		u8 controller_num = mtk_crtc->controller_idmap[i];
 		struct mtk_drm_private *priv = mtk_crtc_get_controller_priv(mtk_crtc, controller_num);
 
-		if (!priv)
-			return -ENODEV;
+		if (!priv) {
+			ret = -ENODEV;
+			goto err_mutex_put;
+		}
 
 		mtk_crtc->mutex[i] = mtk_mutex_get(priv->mutex_dev);
 		if (IS_ERR(mtk_crtc->mutex[i])) {
 			ret = PTR_ERR(mtk_crtc->mutex[i]);
 			dev_err(dev, "Failed to get Controller %u MuteX: %d\n", i, ret);
-			return ret;
+			goto err_mutex_put;
 		}
 	}
 
 	return 0;
+
+err_mutex_put:
+	if (mtk_crtc->pm_group)
+		while (i--)
+			mtk_mutex_put(mtk_crtc->mutex[i]);
+	return ret;
 }
 
 /* Collect a CRTC path's components across all controllers, in order */
@@ -2226,12 +2425,16 @@ int mtk_crtc_create(struct drm_device *drm_dev,
 
 	ret = mtk_crtc_init_multi_controller_properties(dev, mtk_crtc);
 	if (ret)
-		goto err_free_layer_stages;
+		goto err_cleanup_ordered_crtc;
 
-	ret = mtk_crtc_init_mutex(dev, mtk_crtc);
+	ret = mtk_crtc_init_pm_group(mtk_crtc);
 	if (ret)
 		goto err_free_idmap;
 
+	ret = mtk_crtc_init_mutex(dev, mtk_crtc);
+	if (ret)
+		goto err_free_pm_group;
+
 	if (gamma_lut_size)
 		drm_mode_crtc_set_gamma_size(&mtk_crtc->base, gamma_lut_size);
 	drm_crtc_enable_color_mgmt(&mtk_crtc->base, 0, has_ctm, gamma_lut_size);
@@ -2308,8 +2511,14 @@ int mtk_crtc_create(struct drm_device *drm_dev,
 
 	return 0;
 
+err_free_pm_group:
+	mtk_drm_pm_group_destroy(mtk_crtc->pm_group);
+	mtk_crtc->pm_group = NULL;
 err_free_idmap:
 	devm_kfree(dev, mtk_crtc->controller_idmap);
+err_cleanup_ordered_crtc:
+	if (mtk_crtc_uses_ordered_pm(priv))
+		drm_crtc_cleanup(&mtk_crtc->base);
 err_free_layer_stages:
 	for (i = 0; i < num_comp_planes; i++) {
 		struct mtk_crtc_hw_layer *comp_plane = &mtk_crtc->hwlayers[i];
