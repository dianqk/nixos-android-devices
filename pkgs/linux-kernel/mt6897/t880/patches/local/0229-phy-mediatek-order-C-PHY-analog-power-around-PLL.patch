diff --git a/tools/testing/selftests/mtk_clk/mipi_tx_order_cases.c b/tools/testing/selftests/mtk_clk/mipi_tx_order_cases.c
new file mode 100644
index 0000000000..a631edd49b
--- /dev/null
+++ b/tools/testing/selftests/mtk_clk/mipi_tx_order_cases.c
@@ -0,0 +1,248 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+#include <errno.h>
+typedef uint32_t u32;
+typedef uint64_t u64;
+#define __iomem
+#define BIT(n) (1U << (n))
+#define GENMASK(h, l) ((~0U << (l)) & (~0U >> (31 - (h))))
+#define U32_MAX UINT32_MAX
+#define ARRAY_SIZE(array) (sizeof(array) / sizeof((array)[0]))
+#define FIELD_PREP(mask, value) (((u32)(value) << __builtin_ctz(mask)) & (mask))
+#define BUILD_BUG_ON_MSG(condition, message) static_assert(!(condition), message)
+#define container_of(ptr, type, member) ((type *)((char *)(ptr) - offsetof(type, member)))
+#define dev_dbg(...) ((void)0)
+#define dev_err(...) ((void)0)
+struct device { int id; };
+struct clk;
+struct clk_hw { struct clk *clk; };
+struct clk { struct clk_hw *hw; int refs, fail; };
+struct phy { struct mtk_mipi_tx *data; int refs; };
+/* DECLARATIONS */
+static struct mtk_mipi_tx links[2];
+static u32 registers[2][0x600 / 4];
+static struct clk clocks[2];
+static struct phy phys[2];
+static int active_id, enable_calls[2], disable_calls[2];
+static bool atomic_enable, check_order;
+struct event { char kind; int id; u32 offset, value; };
+static struct event events[4096];
+static unsigned int nr;
+static void event(char kind, int id, u32 offset, u32 value)
+{
+	assert(nr < ARRAY_SIZE(events));
+	events[nr++] = (struct event){kind, id, offset, value};
+}
+
+static int bank(const void *p)
+{
+	uintptr_t a = (uintptr_t)p;
+
+	for (int i = 0; i < 2; i++)
+		if (a >= (uintptr_t)registers[i] && a < (uintptr_t)(registers[i] + 0x600 / 4))
+			return i;
+	assert(false);
+	return -1;
+}
+
+static u32 readl(const void *p)
+{
+	return *(const u32 *)p;
+}
+
+static void writel(u32 value, void *p)
+{
+	int i = bank(p);
+	u32 offset = (uintptr_t)p - (uintptr_t)registers[i];
+	u32 old = *(u32 *)p;
+
+	if (check_order && links[i].cphy) {
+		if (offset == MIPITX_PLL_PWR && !(old & AD_DSI_PLL_SDM_PWR_ON) &&
+		    (value & AD_DSI_PLL_SDM_PWR_ON))
+			assert((registers[i][MIPITX_LANE_CON / 4] &
+				(RG_DSI_BG_CORE_EN | RG_DSI_BG_LPF_EN)) ==
+			       (RG_DSI_BG_CORE_EN | RG_DSI_BG_LPF_EN));
+		if (offset == MIPITX_LANE_CON &&
+		    ((old & (RG_DSI_BG_CORE_EN | RG_DSI_BG_LPF_EN)) & ~value)) {
+			assert(!(registers[i][MIPITX_PLL_CON1 / 4] & RG_DSI_PLL_EN));
+			assert(!(registers[i][MIPITX_PLL_PWR / 4] & AD_DSI_PLL_SDM_PWR_ON));
+			assert(registers[i][MIPITX_PLL_PWR / 4] & AD_DSI_PLL_SDM_ISO_EN);
+		}
+	}
+	*(u32 *)p = value;
+	event('W', i, offset, value);
+}
+
+static void udelay(unsigned int n)
+{
+	event('D', active_id, n, 0);
+}
+
+static void usleep_range(unsigned int low, unsigned int high)
+{
+	assert(!atomic_enable);
+	event('S', active_id, low, high);
+}
+
+static u64 div_u64(u64 a, u32 b)
+{
+	return a / b;
+}
+
+/* IO_HELPERS */
+static int mtk_mipi_tx_pll_enable(struct clk_hw *hw);
+static void mtk_mipi_tx_pll_disable(struct clk_hw *hw);
+static void *phy_get_drvdata(struct phy *phy)
+{
+	active_id = phy->data == &links[1];
+	return phy->data;
+}
+
+static int clk_prepare_enable(struct clk *clk)
+{
+	int i = clk == &clocks[1], error;
+
+	active_id = i;
+	if (clk->fail)
+		return clk->fail;
+	if (clk->refs) {
+		clk->refs++;
+		return 0;
+	}
+	atomic_enable = true;
+	enable_calls[i]++;
+	error = mtk_mipi_tx_pll_enable(clk->hw);
+	atomic_enable = false;
+	if (!error)
+		clk->refs++;
+	return error;
+}
+
+static void clk_disable_unprepare(struct clk *clk)
+{
+	int i = clk == &clocks[1];
+
+	active_id = i;
+	assert(clk->refs > 0);
+	if (!--clk->refs) {
+		disable_calls[i]++;
+		mtk_mipi_tx_pll_disable(clk->hw);
+	}
+}
+
+/* PRODUCTION */
+static const struct mtk_mipitx_data data = {
+	.mipi_tx_enable_signal = mtk_mipi_tx_power_on_signal,
+	.mipi_tx_disable_signal = mtk_mipi_tx_power_off_signal,
+};
+
+static void setup(bool cphy, u32 rate)
+{
+	memset(links, 0, sizeof(links));
+	memset(registers, 0, sizeof(registers));
+	memset(clocks, 0, sizeof(clocks));
+	memset(phys, 0, sizeof(phys));
+	memset(enable_calls, 0, sizeof(enable_calls));
+	memset(disable_calls, 0, sizeof(disable_calls));
+	nr = 0;
+	for (int i = 0; i < 2; i++) {
+		links[i].regs = registers[i];
+		links[i].cphy = cphy;
+		links[i].data_rate = rate;
+		links[i].mipitx_drive = 4600;
+		links[i].driver_data = &data;
+		links[i].pll_hw.clk = &clocks[i];
+		clocks[i].hw = &links[i].pll_hw;
+		phys[i].data = &links[i];
+		registers[i][MIPITX_PLL_PWR / 4] = AD_DSI_PLL_SDM_ISO_EN;
+		registers[i][MIPITX_LANE_CON / 4] = RG_DSI_PAD_TIEL_SEL;
+	}
+}
+
+/* Model only the first/last ownership rules of generic PHY and CCF. */
+static int phy_get(struct phy *phy)
+{
+	int error = phy->refs ? 0 : mtk_mipi_tx_power_on(phy);
+
+	if (!error)
+		phy->refs++;
+	return error;
+}
+
+static void phy_put(struct phy *phy)
+{
+	assert(phy->refs > 0);
+	if (!--phy->refs)
+		assert(!mtk_mipi_tx_power_off(phy));
+}
+
+static void cycle(void)
+{
+	for (int i = 0; i < 2; i++) {
+		assert(!phy_get(&phys[i]));
+		assert(registers[i][MIPITX_PLL_CON1 / 4] & RG_DSI_PLL_EN);
+		assert(registers[i][MIPITX_LANE_CON / 4] ==
+		       (RG_DSI_BG_CORE_EN | RG_DSI_BG_LPF_EN |
+			(links[i].cphy ? RG_DSI_CPHY_EN : 0)));
+		phy_put(&phys[i]);
+		assert(registers[i][MIPITX_LANE_CON / 4] == RG_DSI_PAD_TIEL_SEL);
+	}
+}
+
+int main(int argc, char **argv)
+{
+	const u32 rates[] = {125000000, 250000000, 250000001, 500000000,
+		1000000000, 2000000000, 2499999999U, 2500000000U, 2750000000U, UINT32_MAX};
+
+	if (argc == 2 && !strcmp(argv[1], "--dump-dphy")) {
+		check_order = false;
+		for (unsigned int r = 0; r < ARRAY_SIZE(rates); r++) {
+			setup(false, rates[r]);
+			cycle();
+			for (unsigned int e = 0; e < nr; e++)
+				printf("%u %c %d %x %x\n", rates[r], events[e].kind,
+				       events[e].id, events[e].offset, events[e].value);
+		}
+		return 0;
+	}
+	check_order = true;
+	for (unsigned int r = 0; r < ARRAY_SIZE(rates); r++) {
+		setup(true, rates[r]);
+		cycle();
+		cycle(); /* Both PHYs and real off/on epochs. */
+		if (rates[r] == UINT32_MAX)
+			assert(registers[0][MIPITX_PLL_CON0 / 4] == 1385722961);
+	}
+	setup(true, 124999999);
+	assert(phy_get(&phys[0]) == -EINVAL && !nr && !phys[0].refs && !clocks[0].refs);
+	setup(true, 2000000000);
+	clocks[0].fail = -EIO;
+	assert(phy_get(&phys[0]) == -EIO && !nr && !phys[0].refs);
+	/* Existing external clock owner: nested PHY users must not pulse/drop BG. */
+	setup(true, 2000000000);
+	for (int i = 0; i < 2; i++) {
+		unsigned int before;
+
+		assert(!clk_prepare_enable(&clocks[i]));
+		before = nr;
+		assert(!phy_get(&phys[i]));
+		for (unsigned int e = before; e < nr; e++)
+			assert(events[e].offset != MIPITX_LANE_CON || events[e].kind != 'W');
+		before = nr;
+		assert(!phy_get(&phys[i]) && nr == before);
+		phy_put(&phys[i]);
+		assert(nr == before);
+		phy_put(&phys[i]);
+		assert(clocks[i].refs == 1 && !disable_calls[i]);
+		assert((registers[i][MIPITX_LANE_CON / 4] & 0xc0) == 0xc0);
+		clk_disable_unprepare(&clocks[i]);
+		assert(enable_calls[i] == 1 && disable_calls[i] == 1);
+		assert(registers[i][MIPITX_LANE_CON / 4] == RG_DSI_PAD_TIEL_SEL);
+	}
+	puts("Production MIPI-TX: ordering, ownership, delays and error exits PASS");
+}
diff --git a/tools/testing/selftests/mtk_clk/test_mipi_tx_order.py b/tools/testing/selftests/mtk_clk/test_mipi_tx_order.py
new file mode 100755
index 0000000000..6c22a02593
--- /dev/null
+++ b/tools/testing/selftests/mtk_clk/test_mipi_tx_order.py
@@ -0,0 +1,58 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Exercise production MIPI-TX power/clock callbacks with MMIO and owner mocks."""
+from pathlib import Path
+import os
+import re
+import subprocess
+import sys
+import tempfile
+
+assets = Path(__file__).resolve().parent
+repo = Path(os.environ.get('KERNEL_SRC', str(assets.parents[3])))
+directory = repo / 'drivers/phy/mediatek'
+source = (directory / 'phy-mtk-mipi-dsi-mt8196.c').read_text()
+common = (directory / 'phy-mtk-mipi-dsi.c').read_text()
+header = (directory / 'phy-mtk-mipi-dsi.h').read_text()
+io = (directory / 'phy-mtk-io.h').read_text()
+
+
+def function(name, text):
+    match = re.search(r'^(?:(?:static|inline)\s+)*(?:int|void|struct mtk_mipi_tx\s*\*)\s*' +
+                      name + r'\(', text, re.M)
+    start = match.start()
+    end = text.index('{', start) + 1
+    depth = 1
+    while depth:
+        depth += (text[end] == '{') - (text[end] == '}')
+        end += 1
+    return text[start:end]
+
+
+constants = source[source.index('#define MIPITX_LANE_CON'):
+                   source.index('static int mtk_mipi_tx_pll_enable')]
+structures = '\n'.join(re.search(r'^struct ' + name + r' \{.*?^};', header,
+                                  re.M | re.S)[0] for name in ['mtk_mipitx_data', 'mtk_mipi_tx'])
+production = '\n'.join(function(name, source) for name in [
+    'mtk_mipi_tx_pll_enable', 'mtk_mipi_tx_pll_disable',
+    'mtk_mipi_tx_power_on_signal', 'mtk_mipi_tx_power_off_signal'])
+production += '\n' + '\n'.join(function(name, common) for name in [
+    'mtk_mipi_tx_power_on', 'mtk_mipi_tx_power_off'])
+production = function('mtk_mipi_tx_from_clk_hw', common).replace(
+    'inline struct', 'static inline struct') + '\n' + production
+helpers = io[io.index('static inline void mtk_phy_clear_bits'):io.rindex('#endif')]
+# With actual u32 data_rate/divider intervals the PCW maximum is 1385722961,
+# below U32_MAX. Exercise actual rate boundaries; do not widen production types
+# or change constants to manufacture an otherwise unreachable overflow branch.
+cases = (assets / 'mipi_tx_order_cases.c').read_text()
+with tempfile.TemporaryDirectory(prefix='mtk-mipi-tx-order-') as tmp:
+    tmp = Path(tmp)
+    c = tmp / 'test.c'
+    c.write_text(cases.replace('/* DECLARATIONS */', constants + '\n' + structures)
+                 .replace('/* IO_HELPERS */', helpers)
+                 .replace('/* PRODUCTION */', production))
+    binary = tmp / 'test'
+    subprocess.run([os.environ.get('CC', 'cc'), '-std=gnu11', '-Wall', '-Wextra',
+                    '-Wno-unused-parameter', '-Werror', '-g', '-fsanitize=address,undefined',
+                    str(c), '-o', str(binary)], check=True)
+    subprocess.run([str(binary), *sys.argv[1:]], check=True)
-- 
