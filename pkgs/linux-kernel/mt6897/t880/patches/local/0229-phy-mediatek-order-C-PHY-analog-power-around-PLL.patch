From 390608debe1664e0a438e11c650667b95edc7429 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Tue, 10 Nov 2026 12:07:44 +0800
Subject: [PATCH] phy: mediatek: order C-PHY analog power around the PLL clock

MT6897 stock C-PHY setup enables the analog core before SDM/PLL power
and shuts it down after the PLL is disabled, isolated and powered off.
The shared PHY currently enables the PLL first, then pulses the analog
core from its signal callback; shutdown similarly drops that core before
disabling the PLL clock.

Move the existing C-PHY analog sequence into the PLL clock callbacks.
Keep its current register values and minimum delay, using udelay in the
atomic enable callback. The signal callbacks retain lane forcing and
PHY selection, while the analog core stays on until the last PLL clock
owner releases it. Rate and PCW validation still precede any analog
change. D-PHY behavior is unchanged.

Add production-callback regressions for both PHYs, repeated power epochs,
rate boundaries, errors and nested/external clock owners. The same
fixture detects the old order; complete D-PHY MMIO/delay traces agree.

Link: https://github.com/MiCode/MTK_kernel_device_modules/blob/3c4ccd07d5624879555ec710c11bb8818e5cb5c6/drivers/gpu/drm/mediatek/mediatek_v2/mtk_mipi_tx.c#L3405
Link: https://github.com/MiCode/MTK_kernel_device_modules/blob/3c4ccd07d5624879555ec710c11bb8818e5cb5c6/drivers/gpu/drm/mediatek/mediatek_v2/mtk_mipi_tx.c#L4338
Signed-off-by: dianqk <dianqk@dianqk.net>
---
 .../phy/mediatek/phy-mtk-mipi-dsi-mt8196.c    |  31 ++-
 tools/testing/selftests/mtk_clk/Makefile      |   4 +-
 .../selftests/mtk_clk/mipi_tx_order_cases.c   | 248 ++++++++++++++++++
 .../selftests/mtk_clk/test_mipi_tx_order.py   |  58 ++++
 4 files changed, 331 insertions(+), 10 deletions(-)
 create mode 100644 tools/testing/selftests/mtk_clk/mipi_tx_order_cases.c
 create mode 100755 tools/testing/selftests/mtk_clk/test_mipi_tx_order.py

diff --git a/drivers/phy/mediatek/phy-mtk-mipi-dsi-mt8196.c b/drivers/phy/mediatek/phy-mtk-mipi-dsi-mt8196.c
index aa84edc9b0..62eaa22751 100644
--- a/drivers/phy/mediatek/phy-mtk-mipi-dsi-mt8196.c
+++ b/drivers/phy/mediatek/phy-mtk-mipi-dsi-mt8196.c
@@ -122,6 +122,12 @@ static int mtk_mipi_tx_pll_enable(struct clk_hw *hw)
 		mtk_phy_update_field(base + MIPITX_VOLTAGE_SEL, RG_DSI_HSTX_LDO_REF_SEL,
 				     DSI_PHY_CPHY_HSTX_LDO_REF);
 		writel(MIPITX_PLL_CON4_CPHY, base + MIPITX_PLL_CON4);
+		/* Start the C-PHY analog core before SDM/PLL, matching the vendor order. */
+		writel(RG_DSI_PAD_TIEL_SEL | RG_DSI_BG_CORE_EN | RG_DSI_CPHY_EN,
+		       base + MIPITX_LANE_CON);
+		udelay(30);
+		writel(RG_DSI_BG_CORE_EN | RG_DSI_BG_LPF_EN | RG_DSI_CPHY_EN,
+		       base + MIPITX_LANE_CON);
 		mtk_phy_clear_bits(base + MIPITX_PLL_CON1, RG_DSI_PLL_FBSEL | RG_DSI_PLL_DIV3_EN);
 	}
 
@@ -154,6 +160,12 @@ static void mtk_mipi_tx_pll_disable(struct clk_hw *hw)
 
 	mtk_phy_set_bits(base + MIPITX_PLL_PWR, AD_DSI_PLL_SDM_ISO_EN);
 	mtk_phy_clear_bits(base + MIPITX_PLL_PWR, AD_DSI_PLL_SDM_PWR_ON);
+
+	/* Keep the analog core until the last PLL clock owner has disabled it. */
+	if (mipi_tx->cphy) {
+		writel(RG_DSI_PAD_TIEL_SEL | RG_DSI_BG_CORE_EN, base + MIPITX_LANE_CON);
+		writel(RG_DSI_PAD_TIEL_SEL, base + MIPITX_LANE_CON);
+	}
 }
 
 static int mtk_mipi_tx_pll_determine_rate(struct clk_hw *hw,
@@ -177,13 +189,14 @@ static void mtk_mipi_tx_power_on_signal(struct phy *phy)
 {
 	struct mtk_mipi_tx *mipi_tx = phy_get_drvdata(phy);
 	void __iomem *base = mipi_tx->regs;
-	u32 cphy = mipi_tx->cphy ? RG_DSI_CPHY_EN : 0;
 
-	/* BG_LPF_EN / BG_CORE_EN */
-	writel(RG_DSI_PAD_TIEL_SEL | RG_DSI_BG_CORE_EN | cphy, base + MIPITX_LANE_CON);
-	/* Wait for MIPI core to enable */
-	usleep_range(30, 100);
-	writel(RG_DSI_BG_CORE_EN | RG_DSI_BG_LPF_EN | cphy, base + MIPITX_LANE_CON);
+	/* C-PHY's analog core is already held by the PLL clock. */
+	if (!mipi_tx->cphy) {
+		writel(RG_DSI_PAD_TIEL_SEL | RG_DSI_BG_CORE_EN, base + MIPITX_LANE_CON);
+		/* Wait for MIPI core to enable */
+		usleep_range(30, 100);
+		writel(RG_DSI_BG_CORE_EN | RG_DSI_BG_LPF_EN, base + MIPITX_LANE_CON);
+	}
 
 	/* Switch OFF each Lane */
 	mtk_phy_clear_bits(base + MIPITX_D0_SW_CTL_EN, DSI_SW_CTL_EN);
@@ -228,8 +241,10 @@ static void mtk_mipi_tx_power_off_signal(struct phy *phy)
 	mtk_phy_set_bits(base + MIPITX_D3_SW_CTL_EN, DSI_SW_CTL_EN);
 	mtk_phy_set_bits(base + MIPITX_CK_SW_CTL_EN, DSI_SW_CTL_EN);
 
-	writel(RG_DSI_PAD_TIEL_SEL | RG_DSI_BG_CORE_EN, base + MIPITX_LANE_CON);
-	writel(RG_DSI_PAD_TIEL_SEL, base + MIPITX_LANE_CON);
+	if (!mipi_tx->cphy) {
+		writel(RG_DSI_PAD_TIEL_SEL | RG_DSI_BG_CORE_EN, base + MIPITX_LANE_CON);
+		writel(RG_DSI_PAD_TIEL_SEL, base + MIPITX_LANE_CON);
+	}
 
 	if (mipi_tx->cphy)
 		mtk_phy_clear_bits(base + MIPITX_PHY_SEL0, RG_MIPI_TX_CPHY_EN);
