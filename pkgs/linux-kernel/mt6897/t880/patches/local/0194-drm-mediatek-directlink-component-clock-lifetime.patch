From 2a18311a1b8edff64d5e33f371e306c8a3e35b5a Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Sat, 7 Nov 2026 01:59:48 +0800
Subject: [PATCH] drm/mediatek: scope DirectLink config clocks to active
 components

The bind-lifetime config clock hold keeps multimedia clock providers and their domains active even when every DirectLink component is stopped. Acquire a configuration reference before each component port and release it after that port. Roll back the local configuration reference when the port fails to enable.

Ordinary CCF references balance shared and shadow components independently. CRTC routing/configuration and teardown already run within this component clock lifetime. Keep boot ownership and domain-root protocols unchanged.

Add extracted-production-function sanitizer tests for ordered enable/disable, configuration and port failures, shared roots and shadow gate aliases.
---
 .../gpu/drm/mediatek/mtk_disp_directlink.c    |  26 ++---
 tools/testing/selftests/mtk_clk/Makefile      |   4 +-
 .../selftests/mtk_clk/directlink_cases.c      | 101 ++++++++++++++++++
 .../selftests/mtk_clk/test_directlink.py      |  40 +++++++
 4 files changed, 157 insertions(+), 14 deletions(-)
 create mode 100644 tools/testing/selftests/mtk_clk/directlink_cases.c
 create mode 100755 tools/testing/selftests/mtk_clk/test_directlink.py

diff --git a/drivers/gpu/drm/mediatek/mtk_disp_directlink.c b/drivers/gpu/drm/mediatek/mtk_disp_directlink.c
index 83bf57ab04..26caad8b97 100644
--- a/drivers/gpu/drm/mediatek/mtk_disp_directlink.c
+++ b/drivers/gpu/drm/mediatek/mtk_disp_directlink.c
@@ -158,16 +158,28 @@ void mtk_direct_link_disconnect(struct mtk_ddp_comp *comp, struct device *mmsys_
 
 int mtk_direct_link_clk_enable(struct mtk_ddp_comp *comp)
 {
+	struct mtk_direct_link *dl_async = dev_get_drvdata(comp->dev);
 	struct mtk_disp_dl_port *dl_port = mtk_direct_link_get_port(comp);
+	int ret;
+
+	ret = clk_prepare_enable(dl_async->clk);
+	if (ret)
+		return ret;
 
-	return clk_prepare_enable(dl_port->clks[comp->inst_id]);
+	ret = clk_prepare_enable(dl_port->clks[comp->inst_id]);
+	if (ret)
+		clk_disable_unprepare(dl_async->clk);
+
+	return ret;
 }
 
 void mtk_direct_link_clk_disable(struct mtk_ddp_comp *comp)
 {
+	struct mtk_direct_link *dl_async = dev_get_drvdata(comp->dev);
 	struct mtk_disp_dl_port *dl_port = mtk_direct_link_get_port(comp);
 
 	clk_disable_unprepare(dl_port->clks[comp->inst_id]);
+	clk_disable_unprepare(dl_async->clk);
 }
 
 void mtk_direct_link_config(struct mtk_ddp_comp *comp,
@@ -216,21 +228,11 @@ void mtk_direct_link_config(struct mtk_ddp_comp *comp,
 
 static int mtk_direct_link_bind(struct device *dev, struct device *master, void *data)
 {
-	struct mtk_direct_link *dl_async = dev_get_drvdata(dev);
-
-	return clk_prepare_enable(dl_async->clk);
-}
-
-static void mtk_direct_link_unbind(struct device *dev, struct device *master, void *data)
-{
-	struct mtk_direct_link *dl_async = dev_get_drvdata(dev);
-
-	clk_disable_unprepare(dl_async->clk);
+	return 0;
 }
 
 static const struct component_ops mtk_direct_link_component_ops = {
 	.bind	= mtk_direct_link_bind,
-	.unbind = mtk_direct_link_unbind,
 };
 
 static int mtk_direct_link_port_probe(struct device *dev, struct mtk_disp_dl_port *dl_port, u32 of_port_id)
diff --git a/tools/testing/selftests/mtk_clk/Makefile b/tools/testing/selftests/mtk_clk/Makefile
index a8f810fe37..3ce43476bd 100644
--- a/tools/testing/selftests/mtk_clk/Makefile
