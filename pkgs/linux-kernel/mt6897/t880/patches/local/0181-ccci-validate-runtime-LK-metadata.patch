 {
-	unsigned int i;
-
-	/* For strcmp/strncmp should not be used on device memory,
-	 * so prepare a temp buffer.
-	 */
-	char tag_name[64];
-	unsigned int data_offset = 0;
-	unsigned int data_size = 0;
-	unsigned int next_tag_offset = 0;
-	unsigned char *tmp_buf = NULL;
-	char *curr = NULL;
-	union u_tag {
-		struct _ccci_tag v1;
-		struct _ccci_tag_v2 v2;
-	} tag = {0};
-
-	if (s_g_lk_inf_base == NULL) {
-		CCCI_UTIL_INF_MSG("%s: s_g_lk_inf_base NULL\n", __func__);
-		return -1;
+	struct ccci_checked_tag *checked;
+	unsigned int i, j, offset = 0, needed = 0;
+	unsigned int checkpoint = mtk_ccci_args_count();
+	unsigned int name_size, header_size;
+	u8 header[sizeof(struct _ccci_tag_v2)];
+	int ret = -EINVAL;
+
+	name_size = s_g_lk_info_tag_version >= CCCI_LK_INFO_VER_V2 ?
+		CCCI_TAG_NAME_LEN_V2 : CCCI_TAG_NAME_LEN;
+	header_size = name_size + 3 * sizeof(u32);
+	if (checkpoint > CCCI_ARGS_MAX_KEYS || !s_g_lk_inf_base || !s_g_tag_cnt ||
+	    s_g_tag_cnt > s_g_tag_inf_size / header_size)
+		return -EINVAL;
+	checked = kcalloc(s_g_tag_cnt, sizeof(*checked), GFP_KERNEL);
+	if (!checked)
+		return -ENOMEM;
+
+	/* Validate the complete bounded chain before publishing any LK pointer. */
+	for (i = 0; i < s_g_tag_cnt; i++) {
+		u32 next;
+		size_t len;
+		bool duplicate = false;
+
+		if (offset > s_g_tag_inf_size ||
+		    header_size > s_g_tag_inf_size - offset)
+			goto out;
+		for (j = 0; j < i; j++)
+			if (checked[j].offset == offset)
+				goto out;
+		memcpy_fromio(header, s_g_lk_inf_base + offset, header_size);
+		len = strnlen((const char *)header, name_size);
+		if (!len || len == name_size || len >= CCCI_ARGS_KEY_SIZE)
+			goto out;
+		memcpy(checked[i].name, header, len + 1);
+		checked[i].offset = offset;
+		checked[i].data_offset = get_unaligned_le32(header + name_size);
+		checked[i].data_size = get_unaligned_le32(header + name_size + 4);
+		next = get_unaligned_le32(header + name_size + 8);
+		if (checked[i].data_offset > s_g_tag_inf_size ||
+		    checked[i].data_size > s_g_tag_inf_size - checked[i].data_offset)
+			goto out;
+		/* The final next field is unused by the count-delimited LK format. */
+		if (i + 1 < s_g_tag_cnt &&
+		    (next > s_g_tag_inf_size || header_size > s_g_tag_inf_size - next))
+			goto out;
+		offset = next;
+		/* Preserve DT priority and the first occurrence of each LK key. */
+		duplicate = mtk_ccci_args_has_key(checked[i].name);
+		for (j = 0; !duplicate && j < i; j++)
+			duplicate = !strcmp(checked[j].name, checked[i].name);
+		if (!duplicate)
+			needed++;
+	}
+	if (checkpoint > CCCI_ARGS_MAX_KEYS ||
+	    needed > CCCI_ARGS_MAX_KEYS - checkpoint) {
+		ret = -ENOSPC;
+		goto out;
 	}
-
-	curr = (char *)s_g_lk_inf_base;
 	for (i = 0; i < s_g_tag_cnt; i++) {
-		memcpy_fromio(&tag, curr, sizeof(union u_tag));
-		if (s_g_lk_info_tag_version >= CCCI_LK_INFO_VER_V2) {
-			scnprintf(tag_name, 64, "%s", tag.v2.tag_name);
-			data_offset = tag.v2.data_offset;
-			data_size = tag.v2.data_size;
-			next_tag_offset = tag.v2.next_tag_offset;
-		} else {
-			scnprintf(tag_name, 64, "%s", tag.v1.tag_name);
-			data_offset = tag.v1.data_offset;
-			data_size = tag.v1.data_size;
-			next_tag_offset = tag.v1.next_tag_offset;
+		if (mtk_ccci_args_has_key(checked[i].name))
