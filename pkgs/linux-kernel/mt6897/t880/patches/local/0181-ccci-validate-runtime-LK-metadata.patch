-		mtk_ccci_add_new_args((const char *)tag_name, tmp_buf, data_size, FROM_LK_TAG);
-
-		curr = (char *)(s_g_lk_inf_base + next_tag_offset);
 	}
-
-	return 0;
+	ret = 0;
+out:
+	kfree(checked);
+	return ret;
