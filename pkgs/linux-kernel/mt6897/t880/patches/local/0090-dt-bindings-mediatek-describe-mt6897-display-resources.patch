diff --git a/Documentation/devicetree/bindings/display/mediatek/mediatek,mt6897-display-va-bootstrap.yaml b/Documentation/devicetree/bindings/display/mediatek/mediatek,mt6897-display-va-bootstrap.yaml
new file mode 100644
index 0000000000..139b5177e8
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/mediatek/mediatek,mt6897-display-va-bootstrap.yaml
@@ -0,0 +1,102 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/mediatek/mediatek,mt6897-display-va-bootstrap.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6897 firmware display address translation handover
+
+maintainers:
+  - dianqk <dianqk@dianqk.net>
+
+description: |
+  Firmware switches display fetchers from physical to translated addresses
+  using a firmware-owned GCE program. This device validates boot framebuffer
+  identity mappings and submits one normal-world mailbox packet for the
+  handshake. The mailbox controller owns token initialization and the firmware
+  interface. Explicit dependencies and reservations preserve boot scanout;
+  this device does not allocate or modify the firmware-owned program.
+
+properties:
+  compatible:
+    const: mediatek,mt6897-display-va-bootstrap
+
+  reg:
+    items:
+      - description: Unrepresented OVL3 read-only register window
+      - description: Unrepresented OVL7 read-only register window
+      - description: DISPSYS0 POSTMASK read-only register window
+      - description: DISPSYS1 POSTMASK read-only register window
+
+  reg-names:
+    items:
+      - const: ovl3
+      - const: ovl7
+      - const: postmask0
+      - const: postmask1
+
+  mboxes:
+    maxItems: 1
+    description: Dedicated normal-world channel for the one-shot handshake.
+
+  clocks:
+    minItems: 12
+    maxItems: 12
+
+  clock-names:
+    items:
+      - const: gce
+      - const: gce-timer
+      - const: ovl0
+      - const: ovl1
+      - const: ovl2
+      - const: ovl3
+      - const: ovl4
+      - const: ovl5
+      - const: ovl6
+      - const: ovl7
+      - const: postmask0
+      - const: postmask1
+
+  power-domains:
+    maxItems: 1
+
+  memory-region:
+    items:
+      - description: Complete boot framebuffer identity reservation
+      - description: Firmware-owned GCE packet reservation
+
+  memory-region-names:
+    items:
+      - const: framebuffer
+      - const: cmdq
+
+  mediatek,ovls:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    minItems: 6
+    maxItems: 6
+    description: OVL0, OVL1, OVL2, OVL4, OVL5 and OVL6 register owners
+
+  mediatek,suppliers:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    minItems: 12
+    maxItems: 12
+    description: |
+      Both IOMMUs, six display larbs and four SMI commons. Their runtime power
+      is held during the address-mode switch. OVL references are separate
+      because component binding can run inside the final OVL probe.
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - mboxes
+  - clocks
+  - clock-names
+  - power-domains
+  - memory-region
+  - memory-region-names
+  - mediatek,ovls
+  - mediatek,suppliers
+
+additionalProperties: false
diff --git a/Documentation/devicetree/bindings/display/mediatek/mediatek,mt6897-pq-relay.yaml b/Documentation/devicetree/bindings/display/mediatek/mediatek,mt6897-pq-relay.yaml
new file mode 100644
index 0000000000..8c977b324b
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/mediatek/mediatek,mt6897-pq-relay.yaml
@@ -0,0 +1,87 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/mediatek/mediatek,mt6897-pq-relay.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6897 picture-quality blocks used as relays
+
+maintainers:
+  - dianqk <dianqk@dianqk.net>
+
+description:
+  Picture-quality blocks of the MT6897 display path that sit in the fixed PQ
+  chain and are driven in relay (pass-through) mode only - colour
+  transform (C3D), display AAL in the MDP style (MDP-AAL), sub-pixel
+  rendering (SPR), colour histogram (CHIST), overdrive/demura (ODDMR) and the
+  post-alignment stage (POSTALIGN), and, for now, AAL, CCORR, DITHER and GAMMA. ODDMR and POSTALIGN have no registers of
+  their own here. The nodes must be siblings of the MMSYS controller nodes.
+
+properties:
+  compatible:
+    enum:
+      - mediatek,mt6897-disp-aal
+      - mediatek,mt6897-disp-c3d
+      - mediatek,mt6897-disp-ccorr
+      - mediatek,mt6897-disp-dither
+      - mediatek,mt6897-disp-gamma
+      - mediatek,mt6897-disp-chist
+      - mediatek,mt6897-disp-mdp-aal
+      - mediatek,mt6897-disp-oddmr
+      - mediatek,mt6897-disp-postalign
+      - mediatek,mt6897-disp-spr
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  power-domains:
+    maxItems: 1
+
+  trigger-sources:
+    maxItems: 1
+
+  ports:
+    $ref: /schemas/graph.yaml#/properties/ports
+    properties:
+      port@0:
+        $ref: /schemas/graph.yaml#/properties/port
+        description: Input from the previous block of the path
+      port@1:
+        $ref: /schemas/graph.yaml#/properties/port
+        description: Output to the next block of the path
+
+required:
+  - compatible
+  - clocks
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          enum:
+            - mediatek,mt6897-disp-oddmr
+            - mediatek,mt6897-disp-postalign
+    then:
+      properties:
+        reg: false
+    else:
+      required:
+        - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        c3d@14003000 {
+            compatible = "mediatek,mt6897-disp-c3d";
+            reg = <0 0x14003000 0 0x1000>;
+            clocks = <&dispsys0 3>;
+        };
+    };
diff --git a/Documentation/devicetree/bindings/display/mediatek/mediatek,ovl-2l.yaml b/Documentation/devicetree/bindings/display/mediatek/mediatek,ovl-2l.yaml
index 326223b361..792769f31e 100644
--- a/Documentation/devicetree/bindings/display/mediatek/mediatek,ovl-2l.yaml
