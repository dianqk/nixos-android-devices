@@ -22,6 +22,7 @@ properties:
   compatible:
     oneOf:
       - enum:
+          - mediatek,mt6897-disp-ovl-2l
           - mediatek,mt8183-disp-ovl-2l
           - mediatek,mt8192-disp-ovl-2l
       - items:
@@ -48,8 +49,14 @@ properties:
       - description: OVL-2L Clock
 
   iommus:
+    description:
+      On MT6897 the layer ports of each OVL-2L sit on larbs behind both
+      multimedia IOMMUs, which share one page table and IOVA space. A device
+      uses a single IOMMU, so each OVL-2L lists only ports behind one IOMMU,
+      and a port behind the other IOMMU is listed on a sibling OVL-2L of the
+      same OVLSYS that uses that IOMMU.
     minItems: 1
-    maxItems: 2
+    maxItems: 4
 
   mediatek,gce-client-reg:
     description: The register of client driver can be configured by gce with
@@ -81,6 +88,12 @@ properties:
       - port@0
       - port@1
 
+  memory-region:
+    maxItems: 1
+    description: |
+      Boot framebuffer reservation shared by multimedia DMA clients. Matching
+      iommu-addresses reserve its identity IOVAs before the first allocation.
+
 required:
   - compatible
   - reg
@@ -89,6 +102,18 @@ required:
   - clocks
   - iommus
 
+allOf:
+  - if:
+      not:
+        properties:
+          compatible:
+            contains:
+              const: mediatek,mt6897-disp-ovl-2l
+    then:
+      properties:
+        iommus:
+          maxItems: 2
+
 additionalProperties: false
 
