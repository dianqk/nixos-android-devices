From: dianqk <dianqk@dianqk.net>
Date: Fri, 6 Nov 2026 10:00:00 +0800
Subject: [PATCH] soc: mediatek: enable MT6897 firmware interface builds

Enable the implemented MT6897 sources through their Kconfig and
Makefile entries after the component implementations are present.

Original-Commit: local development history
Original-Author: dianqk <dianqk@dianqk.net>
Original-Date: 2026-10-17T00:02:59+08:00
Original-Commit: local development history
Original-Author: dianqk <dianqk@dianqk.net>
Original-Date: 2026-10-20T04:15:32+08:00
Original-Commit: local development history
Original-Author: dianqk <dianqk@dianqk.net>
Original-Date: 2026-11-03T03:24:27+08:00
Original-Commit: local development history
Original-Author: dianqk <dianqk@dianqk.net>
Original-Date: 2026-11-03T13:17:01+08:00
Link: https://github.com/MiCode/MTK_kernel_device_modules/tree/bsp-duchamp-u-oss/drivers/misc/mediatek/mcupm/v2
Signed-off-by: dianqk <dianqk@dianqk.net>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Link: https://github.com/MiCode/MTK_kernel_device_modules/tree/3c4ccd07d5624879555ec710c11bb8818e5cb5c6
---
 drivers/soc/mediatek/Kconfig  | 28 ++++++++++++++++++++++++++++
 drivers/soc/mediatek/Makefile |  3 +++
 2 files changed, 31 insertions(+)

diff --git a/drivers/soc/mediatek/Kconfig b/drivers/soc/mediatek/Kconfig
index d7293977f0..4146457e92 100644
--- a/drivers/soc/mediatek/Kconfig
+++ b/drivers/soc/mediatek/Kconfig
@@ -60,6 +60,25 @@ config MTK_REGULATOR_COUPLER
 	default ARCH_MEDIATEK
 	depends on REGULATOR
 
+config MTK_CCCI_LK_INFO
+	tristate "MediaTek CCCI modem boot information from LK"
+	depends on ARCH_MEDIATEK || COMPILE_TEST
+	depends on OF && DEBUG_FS
+	help
+	  Report, read-only, the list of tags in which the MediaTek LK
+	  bootloader describes the modem images it loaded (MT6897
+	  "ccci,modem_info_v2"). The modem is neither powered nor started.
+
+config MTK_MCUPM
+	tristate "MediaTek MCUPM boot contact"
+	depends on ARCH_MEDIATEK || COMPILE_TEST
+	depends on ARM_ARCH_TIMER
+	help
+	  Say yes here to make the boot contact with the MCUPM, the CPU
+	  power-management coprocessor of MediaTek SoCs such as the MT6897:
+	  the alive command and the AP time base. Its firmware rejects CPU
+	  idle requests until this has happened.
+
 config MTK_MMSYS
 	tristate "MediaTek MMSYS Support"
 	default ARCH_MEDIATEK
@@ -89,4 +108,13 @@ config MTK_SOCINFO
 	  information about the SoC to the userspace including the
 	  manufacturer name, marketing name and soc name.
 
+config MTK_VCP
+	tristate "MediaTek bootloader-owned VCP support"
+	depends on ARCH_MEDIATEK || COMPILE_TEST
+	depends on PM && COMMON_CLK
+	help
+	  Support MediaTek VCP firmware already loaded by the bootloader.
+	  The driver does not replace the firmware image. Hardware access is
+	  initiated explicitly by a client; probing does not start the VCP.
+
 endmenu
diff --git a/drivers/soc/mediatek/Makefile b/drivers/soc/mediatek/Makefile
index 0665573e3c..4101b7ebf5 100644
--- a/drivers/soc/mediatek/Makefile
+++ b/drivers/soc/mediatek/Makefile
@@ -5,7 +5,10 @@ obj-$(CONFIG_MTK_DVFSRC) += mtk-dvfsrc.o
 obj-$(CONFIG_MTK_INFRACFG) += mtk-infracfg.o
 obj-$(CONFIG_MTK_PMIC_WRAP) += mtk-pmic-wrap.o
 obj-$(CONFIG_MTK_REGULATOR_COUPLER) += mtk-regulator-coupler.o
+obj-$(CONFIG_MTK_CCCI_LK_INFO) += mtk-ccci-lk-info.o
+obj-$(CONFIG_MTK_MCUPM) += mtk-mcupm.o
 obj-$(CONFIG_MTK_MMSYS) += mtk-mmsys.o
 obj-$(CONFIG_MTK_MMSYS) += mtk-mutex.o
 obj-$(CONFIG_MTK_SVS) += mtk-svs.o
 obj-$(CONFIG_MTK_SOCINFO) += mtk-socinfo.o
+obj-$(CONFIG_MTK_VCP) += mtk-vcp.o
-- 
2.56.0

