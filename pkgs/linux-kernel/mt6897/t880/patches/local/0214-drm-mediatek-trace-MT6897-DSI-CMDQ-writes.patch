+	regs[0][poll_data.reg_adv[DSI_CMDQ] + 4] = 0x55667788;
+	mtk_dsi_record_cmd(&d[0], &record_msg, 0, 0, 0, 0);
+	assert(d[0].cmd_ring_count == 1 && d[0].cmd_ring[0].cmdq1 == 0);
