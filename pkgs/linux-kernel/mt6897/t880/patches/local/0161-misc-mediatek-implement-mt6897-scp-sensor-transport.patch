+static int mt6897_scp_read_raw(struct iio_dev *indio,
+			       struct iio_chan_spec const *chan, int *val,
+			       int *val2, long mask)
+{
+	struct mt6897_scp *scp = iio_priv(indio);
+	unsigned long flags;
+	int ret = IIO_VAL_INT;
+
+	switch (mask) {
+	case IIO_CHAN_INFO_RAW:
+		spin_lock_irqsave(&scp->accel_lock, flags);
+		if (scp->accel_valid)
+			*val = scp->accel[chan->address];
+		else
+			ret = -EAGAIN;
+		spin_unlock_irqrestore(&scp->accel_lock, flags);
+		return ret;
+	case IIO_CHAN_INFO_SCALE:
+		if (!scp->accel_gain)
+			return -EAGAIN;
+		*val = 1;
+		*val2 = scp->accel_gain;
+		return IIO_VAL_FRACTIONAL;
+	}
+	return -EINVAL;
+}
+
+static const struct iio_info mt6897_scp_iio_info = {
+	.read_raw = mt6897_scp_read_raw,
+};
+
+struct mt6897_scp_als {
+	struct mt6897_scp *scp;
+};
+
+static int mt6897_scp_als_read_raw(struct iio_dev *indio,
+				   struct iio_chan_spec const *chan, int *val,
+				   int *val2, long mask)
+{
+	struct mt6897_scp *scp = ((struct mt6897_scp_als *)iio_priv(indio))->scp;
+	unsigned long flags;
+	int ret = IIO_VAL_FRACTIONAL;
+
+	if (mask != IIO_CHAN_INFO_PROCESSED)
+		return -EINVAL;
+	spin_lock_irqsave(&scp->accel_lock, flags);
+	if (scp->light_valid && scp->light_gain) {
+		*val = scp->light;
+		*val2 = scp->light_gain;
+	} else {
+		ret = -EAGAIN;
+	}
+	spin_unlock_irqrestore(&scp->accel_lock, flags);
+	return ret;
+}
+
+static const struct iio_info mt6897_scp_als_info = {
+	.read_raw = mt6897_scp_als_read_raw,
+};
+
+static const struct iio_chan_spec mt6897_scp_als_channels[] = {
+	{
+		.type = IIO_LIGHT,
+		.info_mask_separate = BIT(IIO_CHAN_INFO_PROCESSED),
+	},
+};
+
+static const struct iio_mount_matrix *
+mt6897_scp_get_mount_matrix(const struct iio_dev *indio,
+			    const struct iio_chan_spec *chan)
+{
+	struct mt6897_scp *scp = iio_priv(indio);
+
+	return &scp->orientation;
+}
+
+static const struct iio_chan_spec_ext_info mt6897_scp_accel_ext_info[] = {
+	IIO_MOUNT_MATRIX(IIO_SHARED_BY_DIR, mt6897_scp_get_mount_matrix),
+	{ }
+};
+
+#define SCP_ACCEL_CHANNEL(axis, idx) {					\
+	.type = IIO_ACCEL,						\
+	.modified = 1,							\
+	.channel2 = IIO_MOD_##axis,					\
+	.address = idx,							\
+	.info_mask_separate = BIT(IIO_CHAN_INFO_RAW),			\
+	.info_mask_shared_by_type = BIT(IIO_CHAN_INFO_SCALE),		\
+	.ext_info = mt6897_scp_accel_ext_info,				\
+}
+
+static const struct iio_chan_spec mt6897_scp_accel_channels[] = {
+	SCP_ACCEL_CHANNEL(X, 0),
+	SCP_ACCEL_CHANNEL(Y, 1),
+	SCP_ACCEL_CHANNEL(Z, 2),
+};
+
+struct mt6897_scp_vec_priv {
+	struct mt6897_scp *scp;
+	struct mt6897_scp_vec *vec;
+};
+
+static int mt6897_scp_vec_read_raw(struct iio_dev *indio,
+				   struct iio_chan_spec const *chan, int *val,
+				   int *val2, long mask)
+{
+	struct mt6897_scp_vec_priv *priv = iio_priv(indio);
+	struct mt6897_scp_vec *v = priv->vec;
+	unsigned long flags;
+	int ret = IIO_VAL_INT;
+
+	switch (mask) {
+	case IIO_CHAN_INFO_RAW:
+		spin_lock_irqsave(&priv->scp->accel_lock, flags);
+		if (v->valid)
+			*val = v->value[chan->address];
+		else
+			ret = -EAGAIN;
+		spin_unlock_irqrestore(&priv->scp->accel_lock, flags);
+		return ret;
+	case IIO_CHAN_INFO_SCALE:
+		if (!v->gain)
+			return -EAGAIN;
+		*val = 1;
+		/* rad/s for the gyroscope; uT -> Gauss for the magnetometer */
+		*val2 = chan->type == IIO_MAGN ? v->gain * 100 : v->gain;
+		return IIO_VAL_FRACTIONAL;
+	}
+	return -EINVAL;
+}
+
+static const struct iio_info mt6897_scp_vec_info = {
+	.read_raw = mt6897_scp_vec_read_raw,
+};
+
+static const struct iio_mount_matrix *
+mt6897_scp_vec_get_mount_matrix(const struct iio_dev *indio,
+				const struct iio_chan_spec *chan)
+{
+	struct mt6897_scp_vec_priv *priv = iio_priv(indio);
+
+	return &priv->scp->orientation;
+}
+
+static const struct iio_chan_spec_ext_info mt6897_scp_vec_ext_info[] = {
+	IIO_MOUNT_MATRIX(IIO_SHARED_BY_DIR, mt6897_scp_vec_get_mount_matrix),
+	{ }
+};
+
+#define SCP_VEC_CHANNEL(t, axis, idx) {					\
+	.type = t,							\
+	.modified = 1,							\
+	.channel2 = IIO_MOD_##axis,					\
+	.address = idx,							\
+	.info_mask_separate = BIT(IIO_CHAN_INFO_RAW),			\
+	.info_mask_shared_by_type = BIT(IIO_CHAN_INFO_SCALE),		\
+	.ext_info = mt6897_scp_vec_ext_info,				\
+}
+
+static const struct iio_chan_spec mt6897_scp_gyro_channels[] = {
+	SCP_VEC_CHANNEL(IIO_ANGL_VEL, X, 0),
+	SCP_VEC_CHANNEL(IIO_ANGL_VEL, Y, 1),
+	SCP_VEC_CHANNEL(IIO_ANGL_VEL, Z, 2),
+};
+
+static const struct iio_chan_spec mt6897_scp_magn_channels[] = {
+	SCP_VEC_CHANNEL(IIO_MAGN, X, 0),
+	SCP_VEC_CHANNEL(IIO_MAGN, Y, 1),
+	SCP_VEC_CHANNEL(IIO_MAGN, Z, 2),
+};
+
+static int mt6897_scp_vec_register(struct device *dev, struct mt6897_scp *scp,
+				   struct mt6897_scp_vec *v, const char *name,
+				   const struct iio_chan_spec *channels)
+{
+	struct mt6897_scp_vec_priv *priv;
+
+	v->indio = devm_iio_device_alloc(dev, sizeof(*priv));
+	if (!v->indio)
+		return -ENOMEM;
+	priv = iio_priv(v->indio);
+	priv->scp = scp;
+	priv->vec = v;
+	v->indio->name = name;
+	v->indio->info = &mt6897_scp_vec_info;
+	v->indio->modes = INDIO_DIRECT_MODE;
+	v->indio->channels = channels;
+	v->indio->num_channels = 3;
+	return devm_iio_device_register(dev, v->indio);
+}
+
+static int mt6897_scp_probe(struct platform_device *pdev)
+{
+	struct mt6897_scp *scp;
+	struct iio_dev *indio;
+	struct resource *res;
+	u32 info[8];
+	int i, ret;
+
+	indio = devm_iio_device_alloc(&pdev->dev, sizeof(*scp));
+	if (!indio)
+		return -ENOMEM;
+	scp = iio_priv(indio);
+	scp->indio = indio;
+	scp->dev = &pdev->dev;
+	spin_lock_init(&scp->accel_lock);
+	mutex_init(&scp->lock);
+	mutex_init(&scp->comm_lock);
+	mutex_init(&scp->transport_lock);
+	spin_lock_init(&scp->client_lock);
+	spin_lock_init(&scp->send_lock);
+	init_completion(&scp->ack_done);
+	init_completion(&scp->notify_done);
+
+	/* The SCP reports Android device axes; the board maps them to Linux */
+	ret = iio_read_mount_matrix(&pdev->dev, &scp->orientation);
+	if (ret)
+		return ret;
+	INIT_WORK(&scp->hub_work, mt6897_scp_hub_work);
+
+	scp->sram = devm_platform_ioremap_resource_byname(pdev, "sram");
+	if (IS_ERR(scp->sram))
+		return PTR_ERR(scp->sram);
+	scp->core0 = devm_platform_ioremap_resource_byname(pdev, "cfg-core0");
+	if (IS_ERR(scp->core0))
+		return PTR_ERR(scp->core0);
+	scp->cfg = devm_platform_ioremap_resource_byname(pdev, "cfg");
+	if (IS_ERR(scp->cfg))
+		return PTR_ERR(scp->cfg);
+	/* Shared with the infracfg_ao clock controller: map, do not claim. */
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "infra-irq");
+	if (!res)
+		return -EINVAL;
+	scp->infra = devm_ioremap(&pdev->dev, res->start - INFRA_IRQ_SET,
+				  INFRA_IRQ_CLEAR + 4);
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "share");
+	if (!scp->infra || !res)
+		return -ENOMEM;
+	scp->shm_phys = res->start;
+	scp->shm = devm_ioremap_wc(&pdev->dev, res->start, resource_size(res));
+	if (!scp->shm)
+		return -ENOMEM;
+	platform_set_drvdata(pdev, scp);
+
+	ret = mt6897_scp_mailboxes(pdev, scp);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret, "mailboxes\n");
+
+	for (i = 0; i < ARRAY_SIZE(info); i++)
+		info[i] = readl(scp->sram + SCP_REGION_INFO_OFFSET + 4 * i);
+	dev_info(&pdev->dev,
+		 "region info: loader %#x+%#x firmware %#x+%#x dram %#x+%#x backup %#x size %u\n",
+		 info[0], info[1], info[2], info[3], info[4], info[5], info[6],
+		 info[7]);
+	mt6897_scp_report(scp, "probe");
+
+	/* The accelerometer reads -EAGAIN until the SCP runs and reports. */
+	indio->name = "scp-accel";
+	indio->info = &mt6897_scp_iio_info;
+	indio->modes = INDIO_DIRECT_MODE;
+	indio->channels = mt6897_scp_accel_channels;
+	indio->num_channels = ARRAY_SIZE(mt6897_scp_accel_channels);
+	ret = devm_iio_device_register(&pdev->dev, indio);
+	if (ret)
+		return ret;
+
+	scp->als = devm_iio_device_alloc(&pdev->dev, sizeof(struct mt6897_scp_als));
+	if (!scp->als)
+		return -ENOMEM;
+	((struct mt6897_scp_als *)iio_priv(scp->als))->scp = scp;
+	scp->als->name = "scp-als";
+	scp->als->info = &mt6897_scp_als_info;
+	scp->als->modes = INDIO_DIRECT_MODE;
+	scp->als->channels = mt6897_scp_als_channels;
+	scp->als->num_channels = ARRAY_SIZE(mt6897_scp_als_channels);
+	ret = devm_iio_device_register(&pdev->dev, scp->als);
+	if (ret)
+		return ret;
+
+	ret = mt6897_scp_vec_register(&pdev->dev, scp, &scp->gyro, "scp-gyro",
+				      mt6897_scp_gyro_channels);
+	if (ret)
+		return ret;
+	ret = mt6897_scp_vec_register(&pdev->dev, scp, &scp->magn, "scp-magn",
+				      mt6897_scp_magn_channels);
+	if (ret)
+		return ret;
+	mutex_lock(&mt6897_scp_registry_lock);
+	if (mt6897_scp_instance)
+		ret = -EBUSY;
+	else
+		mt6897_scp_instance = scp;
+	mutex_unlock(&mt6897_scp_registry_lock);
+	return ret;
+}
+
+static const struct of_device_id mt6897_scp_of_match[] = {
+	{ .compatible = "mediatek,mt6897-scp-bringup" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6897_scp_of_match);
+
+static struct platform_driver mt6897_scp_driver = {
+	.probe = mt6897_scp_probe,
+	.driver = {
+		.name = "mt6897-scp-bringup",
+		.of_match_table = mt6897_scp_of_match,
+		.dev_groups = mt6897_scp_groups,
+		.suppress_bind_attrs = true,
+	},
+};
+module_platform_driver(mt6897_scp_driver);
+
+MODULE_DESCRIPTION("MT6897 SCP bring-up helper (reset release, mailboxes, sensor hub)");
+MODULE_LICENSE("GPL");
