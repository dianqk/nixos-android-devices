+#ifndef _LINUX_MT6897_SCP_CCCI_H
+#define _LINUX_MT6897_SCP_CCCI_H
+#include <linux/types.h>
+/* Callbacks run under the transport spinlock: copy/queue only; never send. */
+struct mt6897_scp_ccci_client {
+	void (*ready)(void *data);
+	void (*receive)(void *data, const u32 words[2]);
+	void *data;
+};
+int mt6897_scp_ccci_register(const struct mt6897_scp_ccci_client *client,
+			     bool *ready);
+void mt6897_scp_ccci_unregister(const struct mt6897_scp_ccci_client *client);
+int mt6897_scp_ccci_send(const u32 words[4]);
+#endif
