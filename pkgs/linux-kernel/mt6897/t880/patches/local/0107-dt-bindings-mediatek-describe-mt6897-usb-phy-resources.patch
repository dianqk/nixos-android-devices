---
 .../bindings/phy/mediatek,dsi-phy.yaml        | 19 +++++++
 .../bindings/phy/mediatek,xsphy.yaml          |  1 +
 .../bindings/usb/mediatek,mt6375-tcpc.yaml    | 40 +++++++++++++
 .../usb/mediatek,mt6897-usb-dp-selector.yaml  | 47 +++++++++++++++
 .../bindings/usb/mediatek,mtu3.yaml           |  7 +++
 .../bindings/usb/willsemi,whs3844.yaml        | 57 +++++++++++++++++++
 6 files changed, 171 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/usb/mediatek,mt6375-tcpc.yaml
