+++ b/Documentation/devicetree/bindings/phy/mediatek,xsphy.yaml
@@ -49,6 +49,7 @@ properties:
       - enum:
           - mediatek,mt3611-xsphy
           - mediatek,mt3612-xsphy
+          - mediatek,mt6897-xsphy
           - mediatek,mt7988-xsphy
       - const: mediatek,xsphy
 
diff --git a/Documentation/devicetree/bindings/usb/mediatek,mt6375-tcpc.yaml b/Documentation/devicetree/bindings/usb/mediatek,mt6375-tcpc.yaml
new file mode 100644
index 0000000000..6a7df4a7df
--- /dev/null
+++ b/Documentation/devicetree/bindings/usb/mediatek,mt6375-tcpc.yaml
@@ -0,0 +1,40 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/usb/mediatek,mt6375-tcpc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6375 Type-C Port Controller
+
+maintainers:
+  - dianqk <dianqk@dianqk.net>
+
+description:
+  The TCPCI-compatible Type-C port and USB Power Delivery controller of the
+  MT6375 sub-PMIC, a child of the MT6375 node.
+
+properties:
+  compatible:
+    const: mediatek,mt6375-tcpc
+
+  interrupts:
+    maxItems: 1
+
+  interrupt-names:
+    items:
+      - const: PD_IRQB
+
+  vbus-supply:
+    description: Regulator sourcing VBUS in the source power role.
+
+  connector:
+    type: object
+    $ref: /schemas/connector/usb-connector.yaml#
+    unevaluatedProperties: false
+
+required:
+  - compatible
+  - interrupts
+  - interrupt-names
+
+additionalProperties: false
diff --git a/Documentation/devicetree/bindings/usb/mediatek,mt6897-usb-dp-selector.yaml b/Documentation/devicetree/bindings/usb/mediatek,mt6897-usb-dp-selector.yaml
new file mode 100644
index 0000000000..38636d4f7b
--- /dev/null
+++ b/Documentation/devicetree/bindings/usb/mediatek,mt6897-usb-dp-selector.yaml
@@ -0,0 +1,47 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/usb/mediatek,mt6897-usb-dp-selector.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6897 USB/DP lane selector
+
+maintainers:
+  - dianqk <dianqk@dianqk.net>
+
+description:
+  A single SoC register that routes the USB3 and DisplayPort TX lanes
+  for the two plug orientations of a USB Type-C connector.
+
+allOf:
+  - $ref: usb-switch.yaml#
+  - $ref: usb-switch-ports.yaml#
+
+properties:
+  compatible:
+    const: mediatek,mt6897-usb-dp-selector
+
+  reg:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    usb-dp-selector@10005600 {
+        compatible = "mediatek,mt6897-usb-dp-selector";
+        reg = <0x10005600 0x4>;
+        orientation-switch;
+
+        port {
+            endpoint {
+                remote-endpoint = <&usb_c_ss_selector>;
+            };
+        };
+    };
+...
diff --git a/Documentation/devicetree/bindings/usb/mediatek,mtu3.yaml b/Documentation/devicetree/bindings/usb/mediatek,mtu3.yaml
index d148e938d6..ecca0ba0fd 100644
--- a/Documentation/devicetree/bindings/usb/mediatek,mtu3.yaml
+++ b/Documentation/devicetree/bindings/usb/mediatek,mtu3.yaml
@@ -143,6 +143,13 @@ properties:
     enum: [host, peripheral]
     default: host
 
+  mode-switch:
+    $ref: /schemas/types.yaml#/definitions/flag
+    description:
+      The controller follows the USB Type-C alternate mode, its SuperSpeed
+      host ports staying off while a 4-lane DisplayPort pin assignment takes
+      the SuperSpeed lanes.
+
   connector:
     $ref: /schemas/connector/usb-connector.yaml#
     description:
diff --git a/Documentation/devicetree/bindings/usb/willsemi,whs3844.yaml b/Documentation/devicetree/bindings/usb/willsemi,whs3844.yaml
new file mode 100644
index 0000000000..bb1d776984
--- /dev/null
+++ b/Documentation/devicetree/bindings/usb/willsemi,whs3844.yaml
@@ -0,0 +1,57 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/usb/willsemi,whs3844.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Willsemi WHS3844 USB3/DisplayPort lane switch
+
+maintainers:
+  - dianqk <dianqk@dianqk.net>
+
+description:
+  I2C-controlled lane switch between a USB Type-C connector's SuperSpeed
+  pairs and the SoC's USB3 and DisplayPort lanes.
+
+allOf:
+  - $ref: usb-switch.yaml#
+  - $ref: usb-switch-ports.yaml#
+
+properties:
+  compatible:
+    const: willsemi,whs3844
+
+  reg:
+    maxItems: 1
+
+  vcc-supply:
+    description: 1.8 V supply.
+
+required:
+  - compatible
+  - reg
+  - vcc-supply
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        typec-mux@44 {
+            compatible = "willsemi,whs3844";
+            reg = <0x44>;
+            vcc-supply = <&whs3844_vcc>;
+            orientation-switch;
+
+            port {
+                endpoint {
+                    remote-endpoint = <&usb_c_ss>;
+                };
+            };
+        };
+    };
+...
