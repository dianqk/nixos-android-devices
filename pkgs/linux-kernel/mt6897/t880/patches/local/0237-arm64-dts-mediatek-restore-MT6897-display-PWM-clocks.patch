From 1002eb908d911dbbec8a2ca82c1463f0b7e2099e Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Wed, 11 Nov 2026 04:31:29 +0800
Subject: [PATCH] arm64: dts: mediatek: restore MT6897 display PWM clock inputs

Use DISP_PWM_SEL as the main PWM source and PERAO_DISP_PWM0 as its mm
input, matching the stock clock list. The PWM driver derives the period
from main and enables both inputs. Keep the source rate and backlight
policy unchanged.

Link: https://github.com/MiCode/MTK_kernel_device_modules/blob/3c4ccd07d5624879555ec710c11bb8818e5cb5c6/drivers/clk/mediatek/clk-mt6897-peri.c
Signed-off-by: dianqk <dianqk@dianqk.net>
---
 arch/arm64/boot/dts/mediatek/mt6897.dtsi | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6897.dtsi b/arch/arm64/boot/dts/mediatek/mt6897.dtsi
index 5b2ef95da9..c5fd109aaa 100644
--- a/arch/arm64/boot/dts/mediatek/mt6897.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6897.dtsi
@@ -1394,8 +1394,9 @@ disp_pwm0: pwm@1100e000 {
 				     "mediatek,mt8183-disp-pwm";
 			reg = <0x0 0x1100e000 0x0 0x1000>;
 			interrupts = <GIC_SPI 254 IRQ_TYPE_LEVEL_HIGH 0>;
-			/* disp_pwm_sel (26 MHz) through the voter-owned pericfg gate */
-			clocks = <&pericfg_ao CLK_PERAOP_DISP_PWM0>, <&clk26m>;
+			/* Separate PWM source and peripheral gate, as in stock wiring. */
+			clocks = <&topckgen CLK_TOP_DISP_PWM_SEL>,
+				 <&pericfg_ao CLK_PERAOP_DISP_PWM0>;
 			clock-names = "main", "mm";
 			#pwm-cells = <2>;
 			status = "disabled";
-- 
2.56.0

