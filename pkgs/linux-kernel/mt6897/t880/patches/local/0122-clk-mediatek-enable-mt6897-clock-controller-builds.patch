From 08daf88d93569b5a4881b1de6cd53bb001d9571c Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Fri, 6 Nov 2026 10:00:00 +0800
Subject: [PATCH] clk: mediatek: enable MT6897 clock controller builds

Enable the implemented MT6897 sources through their Kconfig and
Makefile entries after the component implementations are present.

Original-Commit: local development history
Original-Author: dianqk <dianqk@dianqk.net>
Original-Date: 2026-10-15T19:13:13+08:00
Original-Commit: local development history
Original-Author: dianqk <dianqk@dianqk.net>
Original-Date: 2026-10-16T16:22:00+08:00
Original-Commit: local development history
Original-Author: dianqk <dianqk@dianqk.net>
Original-Date: 2026-10-16T17:16:18+08:00
Original-Commit: local development history
Original-Author: dianqk <dianqk@dianqk.net>
Original-Date: 2026-10-16T18:36:54+08:00
Original-Commit: local development history
Original-Author: dianqk <dianqk@dianqk.net>
Original-Date: 2026-10-20T07:08:26+08:00
Link: https://lore.kernel.org/all/20251027111343.21723-8-angelogioacchino.delregno@collabora.com/
Signed-off-by: dianqk <dianqk@dianqk.net>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/clk/mediatek/Kconfig  | 10 ++++++++++
 drivers/clk/mediatek/Makefile |  3 +++
 2 files changed, 13 insertions(+)

diff --git a/drivers/clk/mediatek/Kconfig b/drivers/clk/mediatek/Kconfig
index 94c7f9e684..d100c4cac7 100644
--- a/drivers/clk/mediatek/Kconfig
+++ b/drivers/clk/mediatek/Kconfig
@@ -135,6 +135,7 @@ config COMMON_CLK_MT2712_VENCSYS
 config COMMON_CLK_MT6685
 	tristate "Clock driver for MediaTek MT6685 Clock IC"
 	depends on ARCH_MEDIATEK
+	select COMMON_CLK_MEDIATEK
 	select COMMON_CLK_MEDIATEK_SPMI
 	help
 	  This driver supports clocks provided by the MT6685 Clock IC.
@@ -1027,6 +1028,15 @@ config COMMON_CLK_MT8195_VENCSYS
 	help
 	  This driver supports MediaTek MT8195 vencsys clocks.
 
+config COMMON_CLK_MT6897
+	bool "Clock driver for MediaTek MT6897"
+	depends on ARM64 || COMPILE_TEST
+	select COMMON_CLK_MEDIATEK
+	default ARCH_MEDIATEK
+	help
+	  This driver supports the MediaTek MT6897 topckgen, VLP and
+	  apmixedsys clocks. The PLLs are read-only.
+
 config COMMON_CLK_MT8196
 	tristate "Clock driver for MediaTek MT8196"
 	depends on ARM64 || COMPILE_TEST
diff --git a/drivers/clk/mediatek/Makefile b/drivers/clk/mediatek/Makefile
index d6a4c40095..ea4b20efca 100644
--- a/drivers/clk/mediatek/Makefile
+++ b/drivers/clk/mediatek/Makefile
@@ -156,6 +156,9 @@ obj-$(CONFIG_COMMON_CLK_MT8195_VDOSYS) += clk-mt8195-vdo0.o clk-mt8195-vdo1.o
 obj-$(CONFIG_COMMON_CLK_MT8195_VENCSYS) += clk-mt8195-venc.o
 obj-$(CONFIG_COMMON_CLK_MT8195_VPPSYS) += clk-mt8195-vpp0.o clk-mt8195-vpp1.o
 obj-$(CONFIG_COMMON_CLK_MT8195_WPESYS) += clk-mt8195-wpe.o
+obj-$(CONFIG_COMMON_CLK_MT6897) += clk-mt6897-apmixedsys.o clk-mt6897-topckgen.o \
+				   clk-mt6897-vlpckgen.o clk-mt6897-peri.o \
+				   clk-mt6897-mm.o clk-mt6897-infra-ao.o
 obj-$(CONFIG_COMMON_CLK_MT8196) += clk-mt8196-apmixedsys.o clk-mt8196-topckgen.o \
 				   clk-mt8196-topckgen2.o clk-mt8196-vlpckgen.o \
 				   clk-mt8196-peri_ao.o
-- 
