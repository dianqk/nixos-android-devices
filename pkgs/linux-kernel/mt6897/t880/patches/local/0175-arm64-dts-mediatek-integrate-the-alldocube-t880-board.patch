@@ -6,6 +6,7 @@ dtb-$(CONFIG_ARCH_MEDIATEK) += mt6795-evb.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6795-sony-xperia-m5.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6797-evb.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6797-x20-dev.dtb
+dtb-$(CONFIG_ARCH_MEDIATEK) += mt6897-alldocube-t880.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt7622-rfb1.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt7622-bananapi-bpi-r64.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt7981b-cudy-wr3000-v1.dtb
diff --git a/arch/arm64/boot/dts/mediatek/mt6897-alldocube-t880.dts b/arch/arm64/boot/dts/mediatek/mt6897-alldocube-t880.dts
new file mode 100644
index 0000000000..f4868f6730
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt6897-alldocube-t880.dts
@@ -0,0 +1,1054 @@
+// SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause
+/*
+ * Alldocube iPlay 80 mini Ultra (T880; MediaTek MT8883, MT6897 class)
+ *
+ * Values read from a T880 (its runtime device tree and LK log). U-Boot
+ * replaces /memory with the banks reported by the stock LK and adds LK's
+ * fixed reserved-memory regions before booting this tree; clocks, pins and
+ * power domains stay as the bootloaders leave them.
+ */
+
+/dts-v1/;
+#include "mt6897.dtsi"
+#include <dt-bindings/mfd/mt6375.h>
+#include <dt-bindings/pinctrl/mt65xx.h>
+#include <dt-bindings/usb/pd.h>
+
+/ {
+	model = "Alldocube iPlay 80 mini Ultra (T880)";
+	compatible = "alldocube,t880", "mediatek,mt6897";
+	chassis-type = "tablet";
+
+	aliases {
+		serial0 = &uart0;
+	};
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+		stdout-path = "serial0:921600n8";
+
+		/*
+		 * The panel LK initialises; U-Boot keeps drawing on it, and
+		 * simpledrm uses it as the boot console until mediatek-drm takes
+		 * over. The physical size comes from the DSI panel, which the
+		 * framebuffer does not wait for.
+		 */
+		framebuffer@fd11f000 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0xfd11f000 0x0 0xfa0000>;
+			width = <1600>;
+			height = <2560>;
+			stride = <6400>;
+			format = "a8r8g8b8";
+			panel = <&dsi_panel>;
+			post-init-providers = <&dsi_panel>;
+		};
+	};
+
+	/*
+	 * The display PWM feeds the backlight driver IC that LK sets up
+	 * (rt4831a). As the stock kernel: a 39385 ns period (1024 cycles of
+	 * 26 MHz) and a linear scale, here one level per PWM step. Start at
+	 * a quarter, the level U-Boot uses.
+	 */
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		pwms = <&disp_pwm0 0 39385>;
+		brightness-levels = <0 1023>;
+		num-interpolated-steps = <1023>;
+		default-brightness-level = <256>;
+	};
+
+	/*
+	 * Hall sensor for the magnetic cover on GPIO 47, low with the magnet
+	 * present (the stock "mhall" uses it as a level-low interrupt).
+	 */
+	/* WHS3844 1.8 V switch; LK leaves it on */
+	whs3844_vcc: regulator-whs3844-vcc {
+		compatible = "regulator-fixed";
+		regulator-name = "whs3844-vcc";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&pio 100 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		lid {
+			label = "Hall sensor";
+			gpios = <&pio 47 GPIO_ACTIVE_LOW>;
+			linux,input-type = <EV_SW>;
+			linux,code = <SW_LID>;
+			debounce-interval = <20>;
+			wakeup-source;
+		};
+	};
+
+	/* Vibration motor on MT6368 VIBR, at the stock 3.0 V only */
+	vibrator {
+		compatible = "regulator-haptic";
+		haptic-supply = <&mt6368_vibr>;
+		min-microvolt = <3000000>;
+		max-microvolt = <3000000>;
+	};
+
+	/*
+	 * 3.85 V nominal, 7200 mAh (spec); the stock gauge profile at 25 C
+	 * (Qmax about 7.33 Ah), charged to the stock 4.40 V.
+	 */
+	battery: battery {
+		compatible = "simple-battery";
+		device-chemistry = "lithium-ion";
+		charge-full-design-microamp-hours = <7200000>;
+		voltage-max-design-microvolt = <4400000>;
+		voltage-min-design-microvolt = <3400000>;
+		constant-charge-voltage-max-microvolt = <4400000>;
+		charge-term-current-microamp = <150000>;
+		/* cell 45 mOhm plus the 70 mOhm board path the vendor gauge adds */
+		factory-internal-resistance-micro-ohms = <115000>;
+		ocv-capacity-celsius = <25>;
+		ocv-capacity-table-0 = <4369800 100>, <4308632 95>, <4248947 90>,
+			<4190486 85>, <4134066 80>, <4080278 75>, <4030837 70>,
+			<3985775 65>, <3940965 60>, <3886894 55>, <3851568 50>,
+			<3827030 45>, <3807436 40>, <3791675 35>, <3778388 30>,
+			<3759747 25>, <3740838 20>, <3717107 15>, <3688609 10>,
+			<3685870 8>, <3681858 6>, <3677829 5>, <3659194 4>,
+			<3628368 3>, <3571453 2>, <3509126 1>, <3422900 0>;
+	};
+
+	/*
+	 * Connectivity (Wi-Fi/BT/GNSS/FM) subsystem for the out-of-tree vendor
+	 * drivers. The bootloader loads the connsys firmware into
+	 * consys_emi and protects it; Linux must never map or touch it.
+	 */
+	consys: consys@18000000 {
+		compatible = "mediatek,mt6897-consys-atf";
+		reg = <0x0 0x10001000 0x0 0xf64>, <0x0 0x10005000 0x0 0xa6c>,
+		      <0x0 0x11ec0000 0x0 0xa04>, <0x0 0x18000000 0x0 0x480>,
+		      <0x0 0x18001000 0x0 0x658>, <0x0 0x18003000 0x0 0x204>,
+		      <0x0 0x1800e000 0x0 0x124>, <0x0 0x18011000 0x0 0x138>,
+		      <0x0 0x18012000 0x0 0xbc>, <0x0 0x18020000 0x0 0x4c>,
+		      <0x0 0x18023000 0x0 0x1000>, <0x0 0x1803b000 0x0 0x18>,
+		      <0x0 0x18040000 0x0 0x2c>, <0x0 0x18041000 0x0 0x164>,
+		      <0x0 0x18042000 0x0 0x324>, <0x0 0x1804b000 0x0 0x414>,
+		      <0x0 0x1804d000 0x0 0x41c>, <0x0 0x1804f000 0x0 0x148>,
+		      <0x0 0x18053800 0x0 0x1000>, <0x0 0x18060000 0x0 0xbf8>,
+		      <0x0 0x18070000 0x0 0x8004>, <0x0 0x1c001000 0x0 0x1000>,
+		      <0x0 0x1c00a000 0x0 0x51c>, <0x0 0x1803c000 0x0 0x4>,
+		      <0x0 0x1803e000 0x0 0x4>;
+		emi-addr = <0x0 0x89e00000>;
+		emi-size = <0xc00000>;
+		ro-bt-emi-size = <0x2e0000>;
+		ro-gps-emi-size = <0xa0000>;
+		ro-wifi-emi-size = <0x300000>;
+		ro-emi-size = <0x680000>;
+		rw-emi-size = <0x480000>;
+		emi-alignment = <0x100000>;
+		emi-max-addr = <0x90000000>;
+		mt6363_vcn13-supply = <&mt6363_vcn13>;
+		mt6363_vrfio18-supply = <&mt6363_vrfio18>;
+		mt6368_vcn33_1-supply = <&mt6368_vcn33_1>;
+		mt6368_vcn33_2-supply = <&mt6368_vcn33_2>;
+		mt6368_vant18-supply = <&mt6368_vant18>;
+	};
+
+	wifi: wifi@18000000 {
+		compatible = "mediatek,wifi";
+		reg = <0x0 0x18000000 0x0 0x700000>;
+		interrupts = <GIC_SPI 889 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 613 IRQ_TYPE_LEVEL_HIGH 0>;
+		memory-region = <&wifi_reserved>;
+		emi-addr = <0x0>;
+		emi-size = <0x1400000>;
+		emi-alignment = <0x1000000>;
+		emi-max-addr = <0xc0000000>;
+	};
+
+	/*
+	 * Bluetooth (BGF) for the vendor bt_drv: the connsys windows it maps
+	 * by index and its interrupts (BGF2AP BTIF wakeup, BGF2AP software,
+	 * CONN2AP software), as in the stock device tree. HCI traffic uses the
+	 * BEIF ring in the connsys EMI area, so there is no BTIF node.
+	 */
+	bt@18000000 {
+		compatible = "mediatek,bt";
+		reg = <0x0 0x18000000 0x0 0x1000>, <0x0 0x18001000 0x0 0x1000>,
+		      <0x0 0x18051000 0x0 0x1000>, <0x0 0x18060000 0x0 0x1000>,
+		      <0x0 0x18800000 0x0 0x1000>, <0x0 0x18812000 0x0 0x1000>,
+		      <0x0 0x10001000 0x0 0x1000>,
+		      <0x0 0x18830000 0x0 0x2000>,
+		      <0x0 0x18840000 0x0 0x20000>;
+		reg-names = "conn-infra", "host-csr", "conn-cfg", "conn-clk",
+			    "bgf-cfg", "bgf-info", "infracfg", "sco-pkv", "sco-sram";
+		interrupts = <GIC_SPI 892 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 614 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 891 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 897 IRQ_TYPE_LEVEL_HIGH 0>;
+		interrupt-names = "wakeup", "watchdog", "software", "sco";
+	};
+
+	/* Rewritten by U-Boot from LK's FDT (0x40000000 + 12 GiB). */
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0x0 0x40000000 0x0 0x80000000>;
+	};
+
+	/*
+	 * The modem boot information LK writes into the kernel DT (a pointer
+	 * to its tag list at 0xbf2f0000, 0x1840 bytes, version 3, 28 tags).
+	 * U-Boot does not forward it yet; this is the value LK wrote on every
+	 * captured Android boot. Read only by the CCCI LK information module.
+	 */
+	mddriver {
+		compatible = "mediatek,mt6897-mddriver", "mediatek,mddriver";
+		/*
+		 * The vendor modem driver's platform data, as the Android
+		 * DT. The driver power-cycles the modem through its power
+		 * domain when it starts it. Not described here: the modem
+		 * supplies (the driver would set their voltages; LK's values
+		 * stay) and the L2SRAM window.
+		 */
+		ccci-infracfg = <&infracfg_ao>;
+		ccci-spmsleep = <&scpsys>;
+		ccci-topckgen = <&topckgen>;
+		interrupts = <GIC_SPI 304 IRQ_TYPE_LEVEL_HIGH 0>;	/* MD WDT */
+		md1_ccb_cap_gear = <1>;
+		md1_ccb_gear_list = "1(2,20);2(2,10);3(0,0);4(2,30);11(2,2);12(2,62)";
+		md_dbm_addr = <0x0 0x8e01fe00>;
+		md_low_power_addr = <0x0 0x8e01fc00>;
+		mediatek,ap-plat-info = <6897>;
+		mediatek,cldma-capability = <0xe>;
+		mediatek,md-generation = <6299>;
+		mediatek,mdhif-type = <0x6>;	/* CCIF and DPMAIF */
+		mediatek,offset-epon-md1 = <0x64>;
+		mediatek,power-flow-config = <0x2>;
+		mediatek,srclken-o1 = <0x1000>;
+		power-domains = <&spm MT6897_POWER_DOMAIN_MD>;
+	};
+
+	/* Modem attributes and properties LK writes (values as on Android) */
+	md_attr_node {
+		compatible = "mediatek,md_attr_node";
+		mediatek,md_drdi_rf_set_idx = <0x0f0f0f0f>;
+		mediatek,md_product_name_model_id = <0x0f0f0f0f>;
+	};
+
+	mdproperties {
+		md1_ccb_cap_gear = <1>;
+		md1_ccb_gear_list = "1(2,20);2(2,10);3(0,0);4(2,30);11(2,2);12(2,62)";
+	};
+};
+
+&{/soc} {
+	/*
+	 * The modem reads these board GPIOs through the AP (vendor property
+	 * names, as the Android DT): the RF band detection pins that select
+	 * its RF configuration and the SIM pins.
+	 */
+	gpio-usage-mapping {
+		compatible = "mediatek,gpio_usage_mapping";
+		GPIO-FDD-BAND-SUPPORT-DETECT-1ST-PIN = <&pio 99 0>;
+		GPIO-FDD-BAND-SUPPORT-DETECT-2ND-PIN = <&pio 98 0>;
+		GPIO-FDD-BAND-SUPPORT-DETECT-3RD-PIN = <&pio 97 0>;
+		GPIO-SIM1-HOT-PLUG = <&pio 58 0>;
+		GPIO-SIM1-SCLK = <&pio 66 0>;
+		GPIO-SIM1-SIO = <&pio 68 0>;
+		GPIO-SIM1-SRST = <&pio 67 0>;
+		GPIO-SIM2-SCLK = <&pio 69 0>;
+		GPIO-SIM2-SIO = <&pio 71 0>;
+		GPIO-SIM2-SRST = <&pio 70 0>;
+	};
+
+	/* Infrastructure configuration: modem CCIF and DPMAIF resets */
+	infracfg@1020e000 {
+		compatible = "mediatek,mt6897-infracfg", "mediatek,infracfg";
+		reg = <0x0 0x1020e000 0x0 0x1000>;
+	};
+
+	ccci-scp@1023c000 {
+		compatible = "mediatek,mt6897-ccci-scp";
+		reg = <0 0x1023c000 0 0x1000>, <0 0x1023d000 0 0x1000>;
+		clocks = <&infracfg_ao CLK_IFRAO_CCIF2_AP>,
+			 <&infracfg_ao CLK_IFRAO_CCIF2_MD>;
+		clock-names = "infra-ccif2-ap", "infra-ccif2-md";
+	};
+
+	/*
+	 * SCP (sensor hub): SRAM with the region info LK writes, and the core0
+	 * configuration block; bring-up helper only (reset release on request).
+	 */
+	scp@1c400000 {
+		compatible = "mediatek,mt6897-scp-bringup";
+		reg = <0x0 0x1c400000 0x0 0x200000>, <0x0 0x1cb30000 0x0 0x1000>,
+		      <0x0 0x1cb24000 0x0 0x1000>,
+		      <0x0 0x1cbfb000 0x0 0x100>, <0x0 0x1cbfb100 0x0 0x4>, <0x0 0x1cbfb10c 0x0 0x4>,
+		      <0x0 0x1cbfc000 0x0 0x100>, <0x0 0x1cbfc100 0x0 0x4>, <0x0 0x1cbfc10c 0x0 0x4>,
+		      <0x0 0x1cbfd000 0x0 0x100>, <0x0 0x1cbfd100 0x0 0x4>, <0x0 0x1cbfd10c 0x0 0x4>,
+		      <0x0 0x1cbfe000 0x0 0x100>, <0x0 0x1cbfe100 0x0 0x4>, <0x0 0x1cbfe10c 0x0 0x4>,
+		      <0x0 0x10001b14 0x0 0x8>, <0x0 0x8f000000 0x0 0x898000>;
+		reg-names = "sram", "cfg-core0", "cfg",
+			    "mbox0-base", "mbox0-set", "mbox0-clr",
+			    "mbox1-base", "mbox1-set", "mbox1-clr",
+			    "mbox2-base", "mbox2-set", "mbox2-clr",
+			    "mbox3-base", "mbox3-set", "mbox3-clr",
+			    "infra-irq", "share";
+		interrupts = <GIC_SPI 715 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 716 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 717 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 718 IRQ_TYPE_LEVEL_HIGH 0>;
+		interrupt-names = "mbox0", "mbox1", "mbox2", "mbox3";
+		/* stock mailbox pin tables: send <ipi mbox slots>, recv <ipi mbox slots opt lock full ctx> */
+		mbox-count = <4>;
+		/*
+		 * The sensor hub reports the accelerometer in Android device
+		 * axes (+1 g on the upward axis, the chip placement already
+		 * applied by the SCP firmware); Linux expects -1 g on the
+		 * upward axis in the screen plane: rotate by 180 degrees
+		 * about Z.
+		 */
+		mount-matrix = "-1", "0", "0",
+			       "0", "-1", "0",
+			       "0", "0", "1";
+		send-table = <0 0 11>,
+			     <14 0 1>,
+			     <15 0 2>,
+			     <16 0 1>,
+			     <17 1 6>,
+			     <18 1 2>,
+			     <46 1 1>,
+			     <29 1 16>,
+			     <31 1 7>,
+			     <4 2 1>,
+			     <5 2 2>,
+			     <6 2 1>,
+			     <33 2 16>,
+			     <3 3 4>,
+			     <37 3 1>,
+			     <26 3 9>,
+			     <35 3 2>,
+			     <39 3 4>,
+			     <43 3 4>,
+			     <45 3 1>,
+			     <47 3 2>,
+			     <48 3 2>;
+		recv-table = <1 0 2 0 0 0 0>,
+			     <2 0 26 0 0 0 0>,
+			     <36 0 1 0 0 0 0>,
+			     <15 0 1 1 0 0 0>,
+			     <20 1 10 0 0 0 0>,
+			     <21 1 6 0 0 0 0>,
+			     <22 1 1 0 0 0 0>,
+			     <30 1 2 0 0 0 0>,
+			     <32 1 7 0 0 0 0>,
+			     <5 2 1 1 0 0 0>,
+			     <8 2 10 0 0 0 0>,
+			     <34 2 16 0 0 0 0>,
+			     <7 3 2 0 0 0 0>,
+			     <38 3 1 0 0 0 0>,
+			     <28 3 5 0 0 0 0>,
+			     <27 3 2 0 0 0 0>,
+			     <35 3 4 1 0 0 0>,
+			     <40 3 4 0 0 0 0>,
+			     <44 3 4 0 0 0 0>,
+			     <47 3 2 1 0 0 0>,
+			     <48 3 2 0 0 0 1>;
+	};
+
+	/* Modem CCIF (AP and MD sides), vendor CCCI driver */
+	ccifdriver@10209000 {
+		compatible = "mediatek,ccci_ccif";
+		reg = <0x0 0x10209000 0x0 0x1000>, <0x0 0x1020a000 0x0 0x1000>;
+		interrupts = <GIC_SPI 289 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 290 IRQ_TYPE_LEVEL_HIGH 0>;
+		clocks = <&infracfg_ao CLK_IFRAO_CCIF_AP>,
+			 <&infracfg_ao CLK_IFRAO_CCIF_MD>,
+			 <&infracfg_ao CLK_IFRAO_CCIF1_AP>,
+			 <&infracfg_ao CLK_IFRAO_CCIF1_MD>,
+			 <&infracfg_ao CLK_IFRAO_CCIF4_MD>,
+			 <&infracfg_ao CLK_IFRAO_CCIF5_MD>;
+		clock-names = "infra-ccif-ap", "infra-ccif-md",
+			      "infra-ccif1-ap", "infra-ccif1-md",
+			      "infra-ccif4-md", "infra-ccif5-md";
+		mediatek,ccif-hw-reset-bit = <18>;
+		mediatek,ccif-hw-reset-ver = <1>;
+		mediatek,sram-size = <0x200>;
+	};
+
+	/*
+	 * MD-side CCIF4/5 windows: the CCIF driver acknowledges them (offset
+	 * 0x14) before gating their clocks at a modem stop, as the vendor
+	 * kernel does.
+	 */
+	md-ccif4@1024d000 {
+		compatible = "mediatek,md_ccif4";
+		reg = <0x0 0x1024d000 0x0 0x1000>;
+	};
+
+	md-ccif5@1025d000 {
+		compatible = "mediatek,md_ccif5";
+		reg = <0x0 0x1025d000 0x0 0x1000>;
+	};
+
+	/* Modem data path (DPMAIF v3), vendor CCCI driver */
+	dpmaif@10014000 {
+		compatible = "mediatek,dpmaif";
+		reg = <0x0 0x10014000 0x0 0x1000>, <0x0 0x1022d000 0x0 0x1000>,
+		      <0x0 0x1022c000 0x0 0x1000>, <0x0 0x1022e000 0x0 0x1000>;
+		interrupts = <GIC_SPI 307 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 852 IRQ_TYPE_LEVEL_HIGH 0>;
+		clocks = <&infracfg_ao CLK_IFRAO_DPMAIF_MAIN>,
+			 <&infracfg_ao CLK_IFRAO_CLDMA_BCLK>,
+			 <&infracfg_ao CLK_IFRAO_RG_MMW_DPMAIF26M_CK>;
+		clock-names = "infra-dpmaif-clk", "infra-dpmaif-blk-clk",
+			      "infra-dpmaif-rg-mmw-clk";
+		dpmaif-infracfg = <&infracfg_ao>;
+		hw-reset-ver = <1>;
+		mediatek,dpmaif-cap = <0x4>;	/* buffers from reserved memory */
+		mediatek,dpmaif-ver = <3>;
+		mediatek,plat-info = <6897>;
+		net-spd-ver = <5>;
+	};
+};
+
+&i2c5 {
+	/* MT6375 sub-PMIC (charger, gauge, AUXADC, TCPC) and the rt6160 buck-boost */
+	clock-frequency = <400000>;
+	status = "okay";
+
+	pmic@34 {
+		/*
+		 * The PMU address 0x34 is the primary; the gauge (0x1a), HK1
+		 * (0x4a), HK2 (0x64) and TCPC (0x4e) are banks of one regmap.
+		 */
+		compatible = "mediatek,mt6375";
+		reg = <0x34>;
+		interrupts-extended = <&pio 7 IRQ_TYPE_LEVEL_LOW>;
+		interrupt-controller;
+		#interrupt-cells = <1>;
+		wakeup-source;
+
+		power-monitor {
+			/* read-only reporting; LK's charger configuration stays */
+			compatible = "mediatek,mt6375-power";
+				mediatek,enable-charge-control;
+				mediatek,auto-charge;
+			monitored-battery = <&battery>;
+		};
+
+		tcpc {
+			compatible = "mediatek,mt6375-tcpc";
+			interrupts = <MT6375_PD_EVT>;
+			interrupt-names = "PD_IRQB";
+
+			connector {
+				compatible = "usb-c-connector";
+				label = "USB-C";
+				/*
+				 * Data role follows the partner and DR_Swap; power
+				 * stays sink-only (no VBUS output yet).
+				 */
+				data-role = "dual";
+				power-role = "sink";
+				try-power-role = "sink";
+				/* PD sink, a single 5 V / 3 A request */
+				typec-power-opmode = "default";
+				self-powered;
+				sink-pdos = <PDO_FIXED(5000, 3000,
+						       PDO_FIXED_USB_COMM |
+						       PDO_FIXED_DATA_SWAP)>;
+				op-sink-microwatt = <10000000>;
+
+				/*
+				 * DisplayPort as a DFP_D: DP 1.3 signalling,
+				 * receptacle, pin assignments C, D and E (the
+				 * stock DT's choice).
+				 */
+				altmodes {
+					displayport {
+						svid = /bits/ 16 <0xff01>;
+						vdo = <0x00001c46>;
+					};
+				};
+
+				ports {
+					#address-cells = <1>;
+					#size-cells = <0>;
+
+					/* High-Speed: the mtu3 controller's role switch */
+					port@0 {
+						reg = <0>;
+
+						usb_c_hs: endpoint {
+							remote-endpoint = <&ssusb_role_sw>;
+						};
+					};
+
+					/*
+					 * SuperSpeed: the lane switches and the DisplayPort
+					 * TX follow the orientation and the pin assignment
+					 */
+					port@1 {
+						reg = <1>;
+						#address-cells = <1>;
+						#size-cells = <0>;
+
+						usb_c_ss_whs3844: endpoint@0 {
+							reg = <0>;
+							remote-endpoint = <&whs3844_ss>;
+						};
+
+						usb_c_ss_selector: endpoint@1 {
+							reg = <1>;
+							remote-endpoint = <&usb_dp_selector_ss>;
+						};
+
+						usb_c_ss_dp: endpoint@2 {
+							reg = <2>;
+							remote-endpoint = <&dp_tx_out>;
+						};
+					};
+
+					/* SBU: the BCT4480 switch (DisplayPort AUX) */
+					port@2 {
+						reg = <2>;
+
+						usb_c_sbu: endpoint {
+							remote-endpoint = <&bct4480_sbu>;
+						};
+					};
+				};
+			};
+		};
+	};
+};
+
+&i2c0 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	/*
+	 * Novatek NT36523N, the touch part of the panel's driver IC; its
+	 * firmware runs from its own flash. Address 0x01 is the firmware
+	 * interface (0x62 is the hardware/bootloader one).
+	 */
+	touchscreen@1 {
+		compatible = "novatek,nt36523n-ts";
+		reg = <0x01>;
+		interrupts-extended = <&pio 9 IRQ_TYPE_EDGE_FALLING>;
+		reset-gpios = <&pio 60 GPIO_ACTIVE_LOW>;
+	};
+};
+
+&disp_pwm0 {
+	status = "okay";
+};
+
+&gpu {
+	status = "okay";
+};
+
+&gpueb_mbox {
+	status = "okay";
+};
+
+&gpufreq {
+	status = "okay";
+};
+
+/*
+ * Keypad matrix positions from the vendor mediatek,hw-init-map. The power
+ * key is reported by the PMIC (mt6363_keys), not by the keypad.
+ */
+&keypad {
+	keypad,num-rows = <1>;
+	keypad,num-columns = <9>;
+	linux,keymap = <MATRIX_KEY(0, 0, KEY_VOLUMEDOWN)
+			MATRIX_KEY(0, 1, KEY_VOLUMEUP)>;
+	status = "okay";
+};
+
+/* As the stock kernel: a long press of the power key resets the PMIC. */
+&mt6363_keys {
+	mediatek,long-press-mode = <1>;
+	power-off-time-sec = <0>;
+	status = "okay";
+};
+
+/*
+ * Connectivity (Wi-Fi/BT) supplies for the MT6637 radio, at the exact
+ * voltages of the stock driver (fixed; nothing else is described, so no
+ * other rail is touched).
+ */
+&mt6363 {
+	mt6363-consys {
+		compatible = "mediatek,mt6363-consys";
+	};
+
+	regulators@30 {
+		compatible = "mediatek,mt6363-regulator";
+		reg = <0x30>;
+
+		mt6363_vcn13: vcn13 {
+			regulator-name = "mt6363_vcn13";
+			regulator-min-microvolt = <1350000>;
+			regulator-max-microvolt = <1350000>;
+		};
+
+		mt6363_vrfio18: vrf-io18 {
+			regulator-name = "mt6363_vrfio18";
+			regulator-min-microvolt = <1700000>;
+			regulator-max-microvolt = <1700000>;
+		};
+	};
+};
+
+&mmc1 {
+	/*
+	 * microSD in the SIM tray, up to SDR104 as the stock kernel (VMC
+	 * switches to 1.8 V for UHS). Pins: function 1 of GPIO72-77, LK's
+	 * pull/drive (not controllable by the pinctrl driver yet).
+	 */
+	bus-width = <4>;
+	max-frequency = <200000000>;
+	cap-sd-highspeed;
+	sd-uhs-sdr12;
+	sd-uhs-sdr25;
+	sd-uhs-sdr50;
+	sd-uhs-sdr104;
+	sd-uhs-ddr50;
+	no-mmc;
+	no-sdio;
+	pinctrl-names = "default", "state_uhs";
+	pinctrl-0 = <&mmc1_pins>;
+	pinctrl-1 = <&mmc1_pins>;
+	/* reads 1 with a card inserted, as the stock flags */
+	cd-gpios = <&pio 102 GPIO_ACTIVE_HIGH>;
+	vmmc-supply = <&mt6368_vmch>;
+	vqmmc-supply = <&mt6368_vmc>;
+	status = "okay";
+};
+
+&pio {
+	/*
+	 * MSDC1 on function 1 of GPIO72 (clock) and GPIO73-77 (command, data),
+	 * as LK leaves them; pulls and drive stay LK's (not described yet).
+	 */
+	mmc1_pins: mmc1-pins {
+		pins-cmd-dat {
+			pinmux = <(MTK_PIN_NO(72) | 1)>, <(MTK_PIN_NO(73) | 1)>,
+				 <(MTK_PIN_NO(74) | 1)>, <(MTK_PIN_NO(75) | 1)>,
+				 <(MTK_PIN_NO(76) | 1)>, <(MTK_PIN_NO(77) | 1)>;
+		};
+	};
+};
+
+&mt6368 {
+	mt6368-consys {
+		compatible = "mediatek,mt6368-consys";
+	};
+
+	regulators {
+		compatible = "mediatek,mt6368-regulator";
+
+		mt6368_vant18: vant18 {
+			regulator-name = "mt6368_vant18";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+		};
+
+		mt6368_vcn33_1: vcn33-1 {
+			regulator-name = "mt6368_vcn33_1";
+			regulator-min-microvolt = <3300000>;
+			regulator-max-microvolt = <3300000>;
+		};
+
+		mt6368_vcn33_2: vcn33-2 {
+			regulator-name = "mt6368_vcn33_2";
+			regulator-min-microvolt = <3300000>;
+			regulator-max-microvolt = <3300000>;
+		};
+
+		/*
+		 * Keep VIBR and VMC at the Android voltage values:
+		 * VIBR 3.0 V and VMC 3.0/1.8 V.
+		 */
+		mt6368_vibr: vibr {
+			regulator-name = "mt6368_vibr";
+			regulator-min-microvolt = <3000000>;
+			regulator-max-microvolt = <3000000>;
+		};
+
+		mt6368_vmch: vmch {
+			regulator-name = "mt6368_vmch";
+			regulator-min-microvolt = <3000000>;
+			regulator-max-microvolt = <3000000>;
+		};
+
+		mt6368_vmc: vmc {
+			regulator-name = "mt6368_vmc";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <3000000>;
+		};
+	};
+};
+
+&mt6685_rtc {
+	status = "okay";
+};
+
+&ssusb {
+	/*
+	 * Dual role through the role switch, which the Type-C port (TCPM)
+	 * drives; without a partner it stays a peripheral (USB networking).
+	 */
+	dr_mode = "otg";
+	usb-role-switch;
+	role-switch-default-mode = "peripheral";
+	/* no USB3 host port while 4-lane DisplayPort takes the SS lanes */
+	mode-switch;
+	/* VBUS goes to the MT6375 charger; the stock kernel forces it too. */
+	mediatek,force-vbus;
+	phys = <&u2port0 PHY_TYPE_USB2>, <&u3port0 PHY_TYPE_USB3>;
+	/*
+	 * As the stock DT: the xHCI host clock (its "host_ck") and the frame
+	 * counter, both left running by the bootloader.
+	 */
+	clocks = <&topckgen CLK_TOP_USB_TOP>,
+		 <&topckgen CLK_TOP_USB_XHCI>,
+		 <&pericfg_ao CLK_PERAOP_SSUSB0_FRMCNT>;
+	clock-names = "sys_ck", "xhci_ck", "frmcnt_ck";
+	maximum-speed = "super-speed";
+	status = "okay";
+
+	port {
+		ssusb_role_sw: endpoint {
+			remote-endpoint = <&usb_c_hs>;
+		};
+	};
+};
+
+&xhci0 {
+	status = "okay";
+};
+
+&u2phy0 {
+	compatible = "mediatek,mt6897-xsphy", "mediatek,xsphy";
+	status = "okay";
+
+	u3port0: usb-phy@11e43400 {
+		reg = <0x0 0x11e43400 0x0 0x500>;
+		clocks = <&clk26m>;
+		clock-names = "ref";
+		#phy-cells = <1>;
+	};
+};
+
+&{/soc} {
+	/*
+	 * Only the Type-C switches (BCT4480, WHS3844) are described on i2c6:
+	 * the bus also carries the speaker amplifiers and the backlight gate
+	 * IC.
+	 */
+	i2c6: i2c@11280000 {
+		compatible = "mediatek,mt6897-i2c";
+		reg = <0x0 0x11280000 0x0 0x1000>,
+		      <0x0 0x11300600 0x0 0x80>;
+		interrupts = <GIC_SPI 192 IRQ_TYPE_LEVEL_HIGH 0>;
+		clocks = <&topckgen CLK_TOP_I2C>, <&clk26m>;
+		clock-names = "main", "dma";
+		clock-div = <1>;
+		clock-frequency = <400000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		/*
+		 * BCT4480, an FSA4480-compatible SBU/USB/audio switch (device
+		 * ID 0x09): routes the DisplayPort AUX to SBU1/SBU2.
+		 */
+		typec-mux@42 {
+			compatible = "fcs,fsa4480";
+			reg = <0x42>;
+			orientation-switch;
+			mode-switch;
+
+			port {
+				bct4480_sbu: endpoint {
+					remote-endpoint = <&usb_c_sbu>;
+				};
+			};
+		};
+
+		typec-mux@44 {
+			compatible = "willsemi,whs3844";
+			reg = <0x44>;
+			vcc-supply = <&whs3844_vcc>;
+			orientation-switch;
+			mode-switch;
+
+			port {
+				whs3844_ss: endpoint {
+					remote-endpoint = <&usb_c_ss_whs3844>;
+				};
+			};
+		};
+	};
+
+	/* Inside the pin controller's range; the driver maps only this word */
+	usb-dp-selector@10005600 {
+		compatible = "mediatek,mt6897-usb-dp-selector";
+		reg = <0x0 0x10005600 0x0 0x4>;
+		orientation-switch;
+		mode-switch;
+
+		port {
+			usb_dp_selector_ss: endpoint {
+				remote-endpoint = <&usb_c_ss_selector>;
+			};
+		};
+	};
+};
+
+/*
+ * DisplayPort over the Type-C port (alt mode): no HPD pin, HPD comes from
+ * the connector; AUX polarity and lanes follow the plug.
+ */
+&dp_tx {
+	orientation-switch;
+	mode-switch;
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+
+			dp_tx_in: endpoint {
+				remote-endpoint = <&dp_intf0_out>;
+			};
+		};
+
+		port@1 {
+			reg = <1>;
+
+			dp_tx_out: endpoint {
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&usb_c_ss_dp>;
+			};
+		};
+	};
+};
+
+&ufshci {
+	/* As the stock DT: MCQ without the run-time-command (RTC) path. */
+	mediatek,ufs-broken-rtc;
+	status = "okay";
+};
+
+&ufsphy {
+	status = "okay";
+};
+
+&watchdog {
+	status = "okay";
+
+	/* The modes the stock LK reads; Android uses the same register. */
+	reboot-mode {
+		compatible = "syscon-reboot-mode";
+		offset = <0x24>;
+		mask = <0xf>;
+		mode-charger = <0x1>;
+		mode-recovery = <0x2>;
+		mode-bootloader = <0x3>;
+	};
+};
+
+&vcp {
+	memory-region = <&vcp_firmware>;
+};
+
+&{/reserved-memory} {
+	/* Same LK-owned reservation forwarded by U-Boot; never map as DMA RAM. */
+	vcp_firmware: lk-reserved@bea00000 {
+		reg = <0 0xbea00000 0 0x800000>;
+		no-map;
+	};
+
+	/* DPMAIF buffer pools (vendor CCCI driver), allocated as on Android */
+	ccci-dpmaif-cache-memory {
+		compatible = "mediatek,dpmaif-resv-cache-mem";
+		size = <0x0 0x190000>;
+		alignment = <0x0 0x1000>;
+		alloc-ranges = <0x0 0x40000000 0x0 0xf0000000>;
+	};
+
+	ccci-dpmaif-nocache-memory {
+		compatible = "mediatek,dpmaif-resv-nocache-mem";
+		size = <0x0 0x50000>;
+		alignment = <0x0 0x1000>;
+		alloc-ranges = <0x0 0x40000000 0x0 0xf0000000>;
+		no-map;
+	};
+
+	/* Keep every LK scanout buffer identity-mapped before a VA switch. */
+	lk_framebuffer: lk-reserved@fd11f000 {
+		no-map;
+		reg = <0x0 0xfd11f000 0x0 0x2ee0000>;
+		iommu-addresses = <&gce 0x0 0xfd11f000 0x0 0x2ee0000>,
+				  <&ovlsys0_ovl0 0x0 0xfd11f000 0x0 0x2ee0000>,
+				  <&ovlsys0_ovl1 0x0 0xfd11f000 0x0 0x2ee0000>,
+				  <&ovlsys0_ovl2 0x0 0xfd11f000 0x0 0x2ee0000>,
+				  <&ovlsys1_ovl0 0x0 0xfd11f000 0x0 0x2ee0000>,
+				  <&ovlsys1_ovl1 0x0 0xfd11f000 0x0 0x2ee0000>,
+				  <&ovlsys1_ovl2 0x0 0xfd11f000 0x0 0x2ee0000>,
+				  <&vdec 0x0 0xfd11f000 0x0 0x2ee0000>,
+				  <&vdec_lat_dma 0x0 0xfd11f000 0x0 0x2ee0000>,
+				  <&venc 0x0 0xfd11f000 0x0 0x2ee0000>,
+				  <&venc_core0_dma 0x0 0xfd11f000 0x0 0x2ee0000>;
+	};
+
+	/*
+	 * LK allocates these and U-Boot forwards them as lk-reserved@<addr>
+	 * (it keeps existing nodes): the connsys firmware/EMI area and the
+	 * Wi-Fi DMA pool.
+	 */
+	consys_reserved: lk-reserved@89e00000 {
+		reg = <0x0 0x89e00000 0x0 0xd00000>;
+		no-map;
+	};
+
+	wifi_reserved: lk-reserved@8ab00000 {
+		compatible = "shared-dma-pool";
+		reg = <0x0 0x8ab00000 0x0 0x1400000>;
+		no-map;
+	};
+
+	/*
+	 * ramoops outside LK's pstore area (0x48090000), which LK restores
+	 * from expdb at every boot. Plain DRAM well below U-Boot's top-down
+	 * EFI allocations; the stock layout: 31 dmesg records of 4 KiB, a
+	 * 256 KiB console, a 4 KiB ftrace and a 512 KiB pmsg zone.
+	 */
+	ramoops@300000000 {
+		compatible = "ramoops";
+		reg = <0x3 0x00000000 0x0 0xe0000>;
+		no-map;
+		record-size = <0x1000>;
+		console-size = <0x40000>;
+		ftrace-size = <0x1000>;
+		pmsg-size = <0x80000>;
+		ecc-size = <0>;
+	};
+};
