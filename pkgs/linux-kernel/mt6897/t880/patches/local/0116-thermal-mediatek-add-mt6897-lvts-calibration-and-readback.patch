 	{
 		.lvts_sensor = {
@@ -2023,6 +2253,12 @@ static const struct lvts_platform_ops lvts_platform_ops_mt7988 = {
 	.lvts_temp_to_raw = lvts_temp_to_raw_mt7988,
 };
 
+static const struct lvts_platform_ops lvts_platform_ops_mt6897 = {
+	.lvts_calib_to_factor = lvts_calib_to_factor_mt6897,
+	.lvts_raw_to_temp = lvts_raw_to_temp_mt6897,
