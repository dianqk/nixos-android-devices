From e2e54a859bda37081145370c1814bce71c44b281 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Tue, 10 Nov 2026 09:02:41 +0800
Subject: [PATCH] drm/mediatek: Forget DSC configuration when stopping

The CRTC starts DSC before DSI performs its late DSC setup. Retaining
dsc_config_done after stop allows the next start to enable compression
with geometry and PPS registers lost through display-domain power loss.

Invalidate the configured state when stopping the core and its resolved
twin. The next start follows the initial bypass path until setup programs
the hardware and marks both cores configured again.

Exercise the production start/setup wrapper/stop sequence across simulated
register loss, including single-core, dual-core and legacy layouts. The
same regression detects an unsafe enable with the previous stop function.

Fixes: 07ccea463e39 ("drm/mediatek: Implement Display Stream Compression support")
Link: https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git/commit/?id=07ccea463e39649c26fe244ab836d536cafbe348
Signed-off-by: dianqk <dianqk@dianqk.net>
---
 drivers/gpu/drm/mediatek/mtk_disp_dsc.c       |   6 +-
 tools/testing/selftests/mtk_clk/Makefile      |   4 +-
 .../selftests/mtk_clk/dsc_epoch_cases.c       | 185 ++++++++++++++++++
 .../selftests/mtk_clk/test_dsc_epoch.py       |  42 ++++
 4 files changed, 234 insertions(+), 3 deletions(-)
 create mode 100644 tools/testing/selftests/mtk_clk/dsc_epoch_cases.c
 create mode 100755 tools/testing/selftests/mtk_clk/test_dsc_epoch.py

diff --git a/drivers/gpu/drm/mediatek/mtk_disp_dsc.c b/drivers/gpu/drm/mediatek/mtk_disp_dsc.c
index 765624a9c1..0729f06807 100644
--- a/drivers/gpu/drm/mediatek/mtk_disp_dsc.c
+++ b/drivers/gpu/drm/mediatek/mtk_disp_dsc.c
@@ -493,9 +493,13 @@ void mtk_dsc_stop(struct device *dev)
 {
 	struct mtk_dsc *disp_dsc = dev_get_drvdata(dev);
 
+	/* Configuration may be lost while stopped; start in bypass until setup. */
+	disp_dsc->dsc_config_done = false;
 	writel(0, disp_dsc->reg + DISP_REG_DSC_CON);
-	if (mtk_dsc_twin(disp_dsc))
+	if (mtk_dsc_twin(disp_dsc)) {
+		disp_dsc->twin->dsc_config_done = false;
 		writel(0, disp_dsc->twin->reg + DISP_REG_DSC_CON);
+	}
 }
 
 static int mtk_dsc_bind(struct device *dev, struct device *master, void *data)
