index 0000000000..7994940ca3
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/mediatek,mt6375-power.yaml
@@ -0,0 +1,53 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/mediatek,mt6375-power.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6375 battery and USB input reporting
+
+maintainers:
+  - dianqk <dianqk@dianqk.net>
+
+description:
+  The MT6375 sub-PMIC holds a charger with its ADC, a coulomb-counter fuel
+  gauge and a housekeeping AUXADC. This child of the MT6375 node describes
+  battery and USB input reporting, with optional bounded charger control.
+  Without the opt-in property the charger retains bootloader configuration.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: mediatek,mt6375-power
+
+  mediatek,enable-charge-control:
+    type: boolean
+    description: |
+      Enable bounded charger control linked synchronously to the sibling TCPC.
+      Starts disabled until explicitly armed unless auto-charge is set.
+      Only 5 V supplies are supported;
+      charge current is requested at 2.1 A and stopped above 2.2 A. Input
+      current is stopped above the smaller of the contract and 2.2 A,
+      with a 100 mA regulation margin where possible. Constant
+      voltage is capped at 4.40 V. Charging stops outside 10 to 45 degrees Celsius.
+      Termination is enabled with a 150 mA end-of-charge threshold.
+      Timers and hardware protection retain firmware settings.
+
+  mediatek,auto-charge:
+    type: boolean
+    description: |
+      Arm charging at probe. A valid supported input contract and fresh safe
+      battery measurements are still required before enabling the charger.
+      Electrical and sensor faults remain latched until explicitly rearmed.
+
+  monitored-battery: true
+
+required:
+  - compatible
+
+dependencies:
+  mediatek,auto-charge: ["mediatek,enable-charge-control"]
+
+unevaluatedProperties: false
