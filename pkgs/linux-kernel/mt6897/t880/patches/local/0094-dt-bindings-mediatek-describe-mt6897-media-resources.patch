From 5eb3c8609a815e8aaff742b9a1bd74752685df00 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Fri, 6 Nov 2026 10:00:00 +0800
Subject: [PATCH] dt-bindings: mediatek: describe MT6897 media resources

Describe the MT6897 media compatibles, resource limits and constants
used by the corresponding controllers and device trees.

Original-Commit: local development history
Original-Author: dianqk <dianqk@dianqk.net>
Original-Date: 2026-11-03T20:25:46+08:00
Original-Commit: local development history
Original-Author: dianqk <dianqk@dianqk.net>
Original-Date: 2026-11-05T13:39:15+08:00
Link: https://github.com/MiCode/MTK_kernel_device_modules/blob/3c4ccd07d5624879555ec710c11bb8818e5cb5c6/drivers/clk/mediatek/clk-mt6897-vcodec.c
Link: https://github.com/MiCode/MTK_kernel_device_modules/blob/3c4ccd07d5624879555ec710c11bb8818e5cb5c6/drivers/soc/mediatek/mtk-scpsys-mt6897.c
Signed-off-by: dianqk <dianqk@dianqk.net>
---
 .../media/mediatek,mt6897-vcodec-enc.yaml     | 96 +++++++++++++++++++
 .../media/mediatek,mt6897-venc-core0-dma.yaml | 29 ++++++
 2 files changed, 125 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/mediatek,mt6897-vcodec-enc.yaml
 create mode 100644 Documentation/devicetree/bindings/media/mediatek,mt6897-venc-core0-dma.yaml

diff --git a/Documentation/devicetree/bindings/media/mediatek,mt6897-vcodec-enc.yaml b/Documentation/devicetree/bindings/media/mediatek,mt6897-vcodec-enc.yaml
new file mode 100644
index 0000000000..34791cc2ac
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/mediatek,mt6897-vcodec-enc.yaml
@@ -0,0 +1,96 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/mediatek,mt6897-vcodec-enc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6897 VCP video encoder
+
+maintainers:
+  - dianqk <dianqk@dianqk.net>
+
+description: |
+  The two encoder cores use separate DISP and MDP IOMMU masters which share
+  a normal translation domain. The main device represents the core 1 DMA
+  master; mediatek,core0-dma identifies the separate core 0 DMA master.
+  Firmware software buffers use the VCP transport's IOMMU device.
+
+properties:
+  compatible:
+    const: mediatek,mt6897-vcodec-enc
+
+  reg:
+    maxItems: 2
+
+  reg-names:
+    items:
+      - const: core0
+      - const: core1
+
+  interrupts:
+    maxItems: 2
+
+  interrupt-names:
+    items:
+      - const: core0
+      - const: core1
+
+  clocks:
+    maxItems: 2
+
+  clock-names:
+    items:
+      - const: core0
+      - const: core1
+
+  power-domains:
+    maxItems: 3
+
+  power-domain-names:
+    items:
+      - const: infra
+      - const: core0
+      - const: core1
+
+  mediatek,larbs:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    minItems: 2
+    maxItems: 2
+    items:
+      maxItems: 1
+    description: Core 0 and core 1 SMI larbs, in that order.
+
+  mediatek,vcp:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: VCP firmware transport.
+
+  mediatek,core0-dma:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: DISP IOMMU DMA master for core 0.
+
+  iommus:
+    minItems: 22
+    maxItems: 22
+
+  memory-region:
+    maxItems: 1
+    description: |
+      Boot framebuffer reservation shared by multimedia DMA clients. Matching
+      iommu-addresses reserve its identity IOVAs before the first allocation.
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - interrupt-names
+  - clocks
+  - clock-names
+  - power-domains
+  - power-domain-names
+  - mediatek,larbs
+  - mediatek,vcp
+  - mediatek,core0-dma
+  - iommus
+
+additionalProperties: false
diff --git a/Documentation/devicetree/bindings/media/mediatek,mt6897-venc-core0-dma.yaml b/Documentation/devicetree/bindings/media/mediatek,mt6897-venc-core0-dma.yaml
new file mode 100644
index 0000000000..812e50dd23
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/mediatek,mt6897-venc-core0-dma.yaml
@@ -0,0 +1,29 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/mediatek,mt6897-venc-core0-dma.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6897 encoder core 0 DMA master
+
+maintainers:
+  - dianqk <dianqk@dianqk.net>
+
+description: |
+  Core 0 uses DISP IOMMU larb 7 independently of the main encoder device's
+  MDP IOMMU larb 8. Both masters must be attached to the same normal domain.
+  This node describes the core 0 DMA path, not a separate codec frontend.
+
+properties:
+  compatible:
+    const: mediatek,mt6897-venc-core0-dma
+
+  iommus:
+    minItems: 22
+    maxItems: 22
+
+required:
+  - compatible
+  - iommus
+
+additionalProperties: false
-- 
