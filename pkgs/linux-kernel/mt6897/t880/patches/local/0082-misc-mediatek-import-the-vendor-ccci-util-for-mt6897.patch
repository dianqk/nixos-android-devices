+const char *ld_md_errno_to_str(int errno)
+{
+	int tmp_idx;
+
+	if (errno == 0)
+		return "Success";
+
+	if (errno < 0)
+		tmp_idx = -errno;
+	else
+		tmp_idx = errno;
+
+	if (tmp_idx < (int)(sizeof(errno_str)/sizeof(char *)))
+		return errno_str[tmp_idx];
+
+	return "errno not found";
+}
