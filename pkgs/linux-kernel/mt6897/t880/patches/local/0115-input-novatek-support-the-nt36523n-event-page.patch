From 5360a2d550a77d4a7b2f4d88167add92afe2326d Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Fri, 6 Nov 2026 10:00:00 +0800
Subject: [PATCH] input: novatek: support the NT36523N event page

Select the NT36523N event-buffer page before reading touchscreen
reports while preserving existing Novatek variants.

Original-Commit: local development history
Original-Author: dianqk <dianqk@dianqk.net>
Original-Date: 2026-10-15T18:07:32+08:00
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: dianqk <dianqk@dianqk.net>
---
 drivers/input/touchscreen/novatek-nvt-ts.c | 41 +++++++++++++++++++---
 1 file changed, 37 insertions(+), 4 deletions(-)

diff --git a/drivers/input/touchscreen/novatek-nvt-ts.c b/drivers/input/touchscreen/novatek-nvt-ts.c
index 0f771f6819..c7f94871c6 100644
--- a/drivers/input/touchscreen/novatek-nvt-ts.c
+++ b/drivers/input/touchscreen/novatek-nvt-ts.c
@@ -49,12 +49,15 @@ static const int nvt_ts_irq_type[4] = {
 
 struct nvt_ts_i2c_chip_data {
 	u8 chip_id;
+	/* Chips that need their event buffer page selected before reads. */
+	u32 event_buf_addr;
 };
 
 struct nvt_ts_data {
 	struct i2c_client *client;
 	struct input_dev *input;
 	struct gpio_desc *reset_gpio;
+	const struct nvt_ts_i2c_chip_data *chip;
 	struct regulator_bulk_data regulators[2];
 	struct touchscreen_properties prop;
 	int max_touches;
@@ -87,6 +90,23 @@ static int nvt_ts_read_data(struct i2c_client *client, u8 reg, u8 *data, int cou
 	return 0;
 }
 
+/* Point the chip's register window at its event buffer (page = bits 23:8). */
+static int nvt_ts_select_event_page(struct nvt_ts_data *data)
+{
+	u32 addr = data->chip->event_buf_addr;
+	u8 buf[3] = { 0xff, addr >> 16, addr >> 8 };
+	int ret;
+
+	if (!addr)
+		return 0;
+
+	ret = i2c_master_send(data->client, buf, sizeof(buf));
+	if (ret != sizeof(buf))
+		return ret < 0 ? ret : -EIO;
+
+	return 0;
+}
+
 static irqreturn_t nvt_ts_irq(int irq, void *dev_id)
 {
 	struct nvt_ts_data *data = dev_id;
@@ -95,8 +115,10 @@ static irqreturn_t nvt_ts_irq(int irq, void *dev_id)
 	bool active;
 	u8 *touch;
 
-	error = nvt_ts_read_data(data->client, NVT_TS_TOUCH_START, data->buf,
-				 data->max_touches * NVT_TS_TOUCH_SIZE);
+	error = nvt_ts_select_event_page(data);
+	if (!error)
+		error = nvt_ts_read_data(data->client, NVT_TS_TOUCH_START, data->buf,
+					 data->max_touches * NVT_TS_TOUCH_SIZE);
 	if (error)
 		return IRQ_HANDLED;
 
@@ -214,6 +236,7 @@ static int nvt_ts_probe(struct i2c_client *client)
 		return -EINVAL;
 
 	data->client = client;
+	data->chip = chip;
 	i2c_set_clientdata(client, data);
 
 	/*
@@ -244,8 +267,10 @@ static int nvt_ts_probe(struct i2c_client *client)
 
 	/* Wait for controller to come out of reset before params read */
 	msleep(100);
-	error = nvt_ts_read_data(data->client, NVT_TS_PARAMETERS_START,
-				 data->buf, NVT_TS_PARAMS_SIZE);
+	error = nvt_ts_select_event_page(data);
+	if (!error)
+		error = nvt_ts_read_data(data->client, NVT_TS_PARAMETERS_START,
+					 data->buf, NVT_TS_PARAMS_SIZE);
 	gpiod_set_value_cansleep(data->reset_gpio, 1); /* Put back in reset */
 	regulator_bulk_disable(ARRAY_SIZE(data->regulators), data->regulators);
 	if (error)
@@ -318,9 +343,16 @@ static const struct nvt_ts_i2c_chip_data nvt_nt36672a_ts_data = {
 	.chip_id = 0x08,
 };
 
+/* The NT36523N event buffer, as in the vendor driver's memory map. */
+static const struct nvt_ts_i2c_chip_data nvt_nt36523n_ts_data = {
+	.chip_id = 0x08,
+	.event_buf_addr = 0x2fd00,
+};
+
 static const struct of_device_id nvt_ts_of_match[] = {
 	{ .compatible = "novatek,nt11205-ts", .data = &nvt_nt11205_ts_data },
 	{ .compatible = "novatek,nt36672a-ts", .data = &nvt_nt36672a_ts_data },
+	{ .compatible = "novatek,nt36523n-ts", .data = &nvt_nt36523n_ts_data },
 	{ }
 };
 MODULE_DEVICE_TABLE(of, nvt_ts_of_match);
@@ -328,6 +360,7 @@ MODULE_DEVICE_TABLE(of, nvt_ts_of_match);
 static const struct i2c_device_id nvt_ts_i2c_id[] = {
 	{ .name = "nt11205-ts", .driver_data = (unsigned long)&nvt_nt11205_ts_data },
 	{ .name = "nt36672a-ts", .driver_data = (unsigned long)&nvt_nt36672a_ts_data },
+	{ .name = "nt36523n-ts", .driver_data = (unsigned long)&nvt_nt36523n_ts_data },
 	{ }
 };
 MODULE_DEVICE_TABLE(i2c, nvt_ts_i2c_id);
-- 
