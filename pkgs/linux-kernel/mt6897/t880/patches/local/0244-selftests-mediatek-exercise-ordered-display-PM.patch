 .../mtk_clk/ordered_pm_admission.inc          |  80 +++++
 .../selftests/mtk_clk/ordered_pm_cases.c      | 292 ++++++++++++++++++
 .../selftests/mtk_clk/test_ordered_pm.py      |  48 +++
 4 files changed, 422 insertions(+), 2 deletions(-)
 create mode 100644 tools/testing/selftests/mtk_clk/ordered_pm_admission.inc
 create mode 100644 tools/testing/selftests/mtk_clk/ordered_pm_cases.c
