diff --git a/drivers/misc/mediatek/eccci/fsm/ccci_fsm.c b/drivers/misc/mediatek/eccci/fsm/ccci_fsm.c
index a34d3cb3da..c194c77e34 100644
--- a/drivers/misc/mediatek/eccci/fsm/ccci_fsm.c
+++ b/drivers/misc/mediatek/eccci/fsm/ccci_fsm.c
@@ -174,6 +174,9 @@ int fsm_append_command(struct ccci_fsm_ctl *ctl,
 			"invalid command %d\n", cmd_id);
 		return -CCCI_ERR_INVALID_PARAM;
 	}
+	ret = READ_ONCE(ctl->stop_error);
+	if (ret)
+		return ret;
 	cmd = kmalloc(sizeof(struct ccci_fsm_command),
 		(in_irq() || in_softirq()
 		|| irqs_disabled()) ? GFP_ATOMIC : GFP_KERNEL);
@@ -191,6 +194,14 @@ int fsm_append_command(struct ccci_fsm_ctl *ctl,
 	cmd->flag = flag;
 
 	spin_lock_irqsave(&ctl->command_lock, flags);
+	ret = READ_ONCE(ctl->stop_error);
+	if (ret) {
+		spin_unlock_irqrestore(&ctl->command_lock, flags);
+		kfree(cmd);
+		return ret;
+	}
+	if (cmd_id == CCCI_COMMAND_STOP)
+		atomic_inc(&ctl->stop_pending);
 	list_add_tail(&cmd->entry, &ctl->command_queue);
 	spin_unlock_irqrestore(&ctl->command_lock, flags);
 	if (!in_irq())
@@ -208,7 +219,9 @@ int fsm_append_command(struct ccci_fsm_ctl *ctl,
 				cmd->complete != 0);
 			if (ret == -ERESTARTSYS)
 				continue;
-			if (cmd->complete != 1)
+			if (cmd->complete < 0)
+				result = cmd->complete;
+			else if (cmd->complete != 1)
 				result = -1;
 			spin_lock_irqsave(&ctl->cmd_complete_lock, flags);
 			kfree(cmd);
@@ -228,6 +241,9 @@ static void fsm_finish_command(struct ccci_fsm_ctl *ctl,
 		"command %d is completed %d by %ps\n",
 		cmd->cmd_id, result,
 		__builtin_return_address(0));
+	/* Publish completion only after stop callbacks and state updates finish. */
+	if (cmd->cmd_id == CCCI_COMMAND_STOP)
+		atomic_dec_return(&ctl->stop_pending);
 	if (cmd->flag & FSM_CMD_FLAG_WAIT_FOR_COMPLETE) {
 		spin_lock_irqsave(&ctl->cmd_complete_lock, flags);
 		cmd->complete = result;
@@ -265,6 +281,8 @@ int fsm_append_event(struct ccci_fsm_ctl *ctl, enum CCCI_FSM_EVENT event_id,
 		CCCI_ERROR_LOG(0, FSM, "invalid event %d\n", event_id);
 		return -CCCI_ERR_INVALID_PARAM;
 	}
+	if (READ_ONCE(ctl->stop_error))
+		return READ_ONCE(ctl->stop_error);
 	if (event_id == CCCI_EVENT_FS_IN) {
 		atomic_set(&(ctl->fs_ongoing), 1);
 		return 0;
@@ -286,6 +304,11 @@ int fsm_append_event(struct ccci_fsm_ctl *ctl, enum CCCI_FSM_EVENT event_id,
 		memcpy(event->data, data, length);
 
 	spin_lock_irqsave(&ctl->event_lock, flags);
+	if (READ_ONCE(ctl->stop_error)) {
+		spin_unlock_irqrestore(&ctl->event_lock, flags);
+		kfree(event);
+		return READ_ONCE(ctl->stop_error);
+	}
 	list_add_tail(&event->entry, &ctl->event_queue);
 	spin_unlock_irqrestore(&ctl->event_lock, flags);
 	/* do not derefence event after here */
@@ -1507,7 +1530,7 @@ static void fsm_routine_stop(struct ccci_fsm_ctl *ctl,
 	ctl->curr_state = CCCI_FSM_STOPPING;
 
 	/* 2. pre-stop: polling MD for infinit sleep mode */
-	ccci_md_pre_stop(cmd->flag & FSM_CMD_FLAG_FLIGHT_MODE ?
+	ret = ccci_md_pre_stop(cmd->flag & FSM_CMD_FLAG_FLIGHT_MODE ?
 		MD_FLIGHT_MODE_ENTER : MD_FLIGHT_MODE_NONE);
 	/* 3. check for EE */
 	ee_cmd = fsm_check_for_ee(ctl, 1);
@@ -1520,9 +1543,21 @@ static void fsm_routine_stop(struct ccci_fsm_ctl *ctl,
 	/*reset fsm poller*/
 	ctl->poller_ctl.poller_state = FSM_POLLER_RECEIVED_RESPONSE;
 	wake_up(&ctl->poller_ctl.status_rx_wq);
-	/* 4. hardware stop */
-	ccci_md_stop(cmd->flag & FSM_CMD_FLAG_FLIGHT_MODE ?
-		MD_FLIGHT_MODE_ENTER : MD_FLIGHT_MODE_NONE);
+	/* Even a failed pre-stop must first block port writes above. */
+	if (!ret)
+		ret = ccci_md_stop(cmd->flag & FSM_CMD_FLAG_FLIGHT_MODE ?
+			MD_FLIGHT_MODE_ENTER : MD_FLIGHT_MODE_NONE);
+	if (ret) {
+		CCCI_ERROR_LOG(0, FSM, "stop failed: %d; host reboot required\n", ret);
+		/* Stop APIs return zero on success; preserve negative errno. */
+		if (ret > 0)
+			ret = -EIO;
+		spin_lock_irqsave(&ctl->command_lock, flags);
+		WRITE_ONCE(ctl->stop_error, ret);
+		ctl->last_state = ctl->curr_state;
+		ctl->curr_state = CCCI_FSM_STOP_FAILED;
+		spin_unlock_irqrestore(&ctl->command_lock, flags);
+	}
 	/* 5. clear event queue */
 	spin_lock_irqsave(&ctl->event_lock, flags);
 	list_for_each_entry_safe(event, next, &ctl->event_queue, entry) {
@@ -1532,7 +1567,12 @@ static void fsm_routine_stop(struct ccci_fsm_ctl *ctl,
 	}
 	spin_unlock_irqrestore(&ctl->event_lock, flags);
 	__pm_relax(ctl->wakelock);
-	/* 6. always end in stopped state */
+	if (ret) {
+		needforcestop = 0;
+		fsm_finish_command(ctl, cmd, ret);
+		return;
+	}
+	/* 6. Publish stopped only after successful hardware stop. */
 success:
 	needforcestop = 0;
 
@@ -1625,6 +1665,11 @@ static int fsm_main_thread(void *data)
 
 		CCCI_NORMAL_LOG(0, FSM, "command process\n");
 		cmd_id = cmd->cmd_id;
+		ret = READ_ONCE(ctl->stop_error);
+		if (ret) {
+			fsm_finish_command(ctl, cmd, ret);
+			continue;
+		}
 		fsm_command_pre(cmd_id);
 
 		switch (cmd->cmd_id) {
@@ -1693,6 +1738,7 @@ int ccci_fsm_init(void)
 	spin_lock_init(&ctl->cmd_complete_lock);
 	spin_lock_init(&state_broadcase_lock);
 	atomic_set(&ctl->fs_ongoing, 0);
+	atomic_set(&ctl->stop_pending, 0);
 	ret = snprintf(ctl->wakelock_name, sizeof(ctl->wakelock_name), "md_wakelock");
 	if (ret <= 0 || ret >= sizeof(ctl->wakelock_name)) {
 		CCCI_ERROR_LOG(0, FSM,
@@ -1771,6 +1817,8 @@ int ccci_fsm_recv_md_interrupt(enum MD_IRQ_TYPE type)
 	if (!ctl)
 		return -CCCI_ERR_INVALID_PARAM;
 
+	if (READ_ONCE(ctl->stop_error))
+		return READ_ONCE(ctl->stop_error);
 	__pm_wakeup_event(ctl->wakelock, jiffies_to_msecs(10 * HZ));
 
 	if (type == MD_IRQ_WDT) {
@@ -1793,6 +1841,10 @@ int ccci_fsm_recv_control_packet(struct sk_buff *skb)
 	if (!ctl)
 		return -CCCI_ERR_INVALID_PARAM;
 
+	if (READ_ONCE(ctl->stop_error)) {
+		ccci_free_skb(skb);
+		return READ_ONCE(ctl->stop_error);
+	}
 	CCCI_NORMAL_LOG(0, FSM,
 		"control message 0x%X,0x%X\n",
 		ccci_h->data[1], ccci_h->reserved);
diff --git a/drivers/misc/mediatek/eccci/fsm/ccci_fsm_internal.h b/drivers/misc/mediatek/eccci/fsm/ccci_fsm_internal.h
index f5b72c7807..586443169a 100644
--- a/drivers/misc/mediatek/eccci/fsm/ccci_fsm_internal.h
+++ b/drivers/misc/mediatek/eccci/fsm/ccci_fsm_internal.h
@@ -38,6 +38,7 @@ enum {
 	CCCI_FSM_READY,
 	CCCI_FSM_STOPPING,
 	CCCI_FSM_EXCEPTION,
+	CCCI_FSM_STOP_FAILED,
 };
 
 enum CCCI_FSM_EVENT {
@@ -225,6 +226,8 @@ struct ccci_fsm_ctl {
 
 	unsigned int curr_state;
 	unsigned int last_state;
+	int stop_error; /* Terminal failure: only a host reboot can recover. */
+	atomic_t stop_pending;
 	struct list_head command_queue;
 	struct list_head event_queue;
 	wait_queue_head_t command_wq;
@@ -259,7 +262,7 @@ struct ccci_fsm_command {
 	struct list_head entry;
 	enum CCCI_FSM_COMMAND cmd_id;
 	unsigned int flag;
-	int complete; /* -1: fail; 0: on-going; 1: success */
+	int complete; /* negative: error; 0: on-going; 1: success */
 	wait_queue_head_t complete_wq;
 };
 
diff --git a/drivers/misc/mediatek/eccci/fsm/ccci_fsm_ioctl.c b/drivers/misc/mediatek/eccci/fsm/ccci_fsm_ioctl.c
index 0ef862194f..814cb2e97a 100644
--- a/drivers/misc/mediatek/eccci/fsm/ccci_fsm_ioctl.c
+++ b/drivers/misc/mediatek/eccci/fsm/ccci_fsm_ioctl.c
@@ -534,6 +534,13 @@ long ccci_fsm_ioctl(unsigned int cmd, unsigned long arg)
 
 	switch (cmd) {
 	case CCCI_IOC_GET_MD_STATE:
+		ret = READ_ONCE(ctl->stop_error);
+		if (ret)
+			break;
+		if (atomic_read_acquire(&ctl->stop_pending)) {
+			ret = -EINPROGRESS;
+			break;
+		}
 		state_for_user = ccci_fsm_get_md_state_for_user();
 		ret = put_user((unsigned int)state_for_user,
 					(unsigned int __user *)arg);
diff --git a/drivers/misc/mediatek/eccci/fsm/md_sys1_platform.c b/drivers/misc/mediatek/eccci/fsm/md_sys1_platform.c
index d8e72872b0..8d2c31f5fa 100644
--- a/drivers/misc/mediatek/eccci/fsm/md_sys1_platform.c
+++ b/drivers/misc/mediatek/eccci/fsm/md_sys1_platform.c
@@ -599,7 +599,7 @@ static int md1_disable_sequencer_setting(struct ccci_modem *md)
 
 static int md_cd_power_off(struct ccci_modem *md, unsigned int timeout)
 {
-	int ret;
+	int ret = 0;
 	unsigned int reg_value = 0;
 	void __iomem *reg;
 
@@ -641,6 +641,15 @@ static int md_cd_power_off(struct ccci_modem *md, unsigned int timeout)
 		"[POWER OFF] MD MTCMOS OFF start\n");
 #ifdef USING_PM_RUNTIME
 	ret = pm_runtime_put_sync(&md->plat_dev->dev);
+	CCCI_NORMAL_LOG(0, TAG, "[POWER OFF] PM result=%d suspended=%d usage=%d\n",
+		ret, pm_runtime_status_suspended(&md->plat_dev->dev),
+		atomic_read(&md->plat_dev->dev.power.usage_count));
+	if (ret < 0)
+		return ret;
+	if (!pm_runtime_status_suspended(&md->plat_dev->dev))
+		return -EBUSY;
+	/* A positive PM return can also indicate successful suspension. */
+	ret = 0;
 #else
 	clk_disable_unprepare(clk_table[0].clk_ref);
 	CCCI_BOOTUP_LOG(0, TAG, "CCF:disable md1 clk\n");
diff --git a/drivers/misc/mediatek/eccci/fsm/modem_sys1.c b/drivers/misc/mediatek/eccci/fsm/modem_sys1.c
index f1cac3dd47..c1d92e08a4 100644
--- a/drivers/misc/mediatek/eccci/fsm/modem_sys1.c
+++ b/drivers/misc/mediatek/eccci/fsm/modem_sys1.c
@@ -370,13 +370,18 @@ static int md_cd_stop(struct ccci_modem *md, unsigned int stop_type)
 		"modem is power off, stop_type=%d\n", stop_type);
 	ccci_hif_md_exception((1<<CCIF_HIF_ID), HIF_EX_STOP_EE_NOTIFY);
 
-	/* power off MD */
-	if (md->hw_info->plat_ptr->power_off)
-		ret = md->hw_info->plat_ptr->power_off(md,
-			stop_type == MD_FLIGHT_MODE_ENTER ? 100 : 0);
-	CCCI_NORMAL_LOG(0, TAG, "modem is power off done, %d\n", ret);
+	ret = ccci_hif_pre_stop(CCIF_HIF_ID);
+	if (ret)
+		return ret;
 
-	return 0;
+	/* Keep the quiesced AP resources if platform power-off fails. */
+	if (!md->hw_info->plat_ptr->power_off)
+		return -EOPNOTSUPP;
+	ret = md->hw_info->plat_ptr->power_off(md,
+		stop_type == MD_FLIGHT_MODE_ENTER ? 100 : 0);
+	CCCI_NORMAL_LOG(0, TAG, "modem power-off result %d\n", ret);
+
+	return ret;
 }
 
 static void dump_runtime_data_v2(struct ccci_modem *md,
diff --git a/drivers/misc/mediatek/eccci/hif/ccci_hif.c b/drivers/misc/mediatek/eccci/hif/ccci_hif.c
index 6cfddb46ae..2feb3219f1 100644
--- a/drivers/misc/mediatek/eccci/hif/ccci_hif.c
+++ b/drivers/misc/mediatek/eccci/hif/ccci_hif.c
@@ -361,6 +361,15 @@ void ccci_md_dump_log_history(
 }
 EXPORT_SYMBOL(ccci_md_dump_log_history);
 
+/* Mandatory process-context preparation; never called from the WDT IRQ. */
+int ccci_hif_pre_stop(unsigned char hif_id)
+{
+	if (hif_id >= CCCI_HIF_NUM || !ccci_hif[hif_id] ||
+	    !ccci_hif_op[hif_id] || !ccci_hif_op[hif_id]->pre_stop)
+		return -ENODEV;
+	return ccci_hif_op[hif_id]->pre_stop(hif_id);
+}
+
 int ccci_hif_stop(unsigned char hif_id)
 {
 	int ret = 0;
diff --git a/drivers/misc/mediatek/eccci/hif/ccci_hif_ccif.c b/drivers/misc/mediatek/eccci/hif/ccci_hif_ccif.c
index 941fb26e4f..5e9cdd3cce 100644
--- a/drivers/misc/mediatek/eccci/hif/ccci_hif_ccif.c
+++ b/drivers/misc/mediatek/eccci/hif/ccci_hif_ccif.c
@@ -333,7 +333,8 @@ static int md_ccif_op_dump_status(unsigned char hif_id,
 		return -1;
 
 	if (ccif_ctrl->ccif_state == HIFCCIF_STATE_PWROFF
-		|| ccif_ctrl->ccif_state == HIFCCIF_STATE_MIN) {
+		|| ccif_ctrl->ccif_state == HIFCCIF_STATE_MIN
+		|| READ_ONCE(ccif_ctrl->ccif_state) == HIFCCIF_STATE_QUIESCED) {
 		CCCI_MEM_LOG_TAG(0, TAG, "CCIF not power on, skip dump\n");
 		return -2;
 	}
@@ -937,6 +938,9 @@ static int md_ccif_send(unsigned char hif_id, int channel_id)
 	int busy = 0;
 	struct md_ccif_ctrl *ccif_ctrl = ccci_ccif_ctrl;
 
+	if (READ_ONCE(ccif_ctrl->ccif_state) == HIFCCIF_STATE_QUIESCED)
+		return -ESHUTDOWN;
+
 	busy = ccif_read32(ccif_ctrl->ccif_ap_base, APCCIF_BUSY);
 	if (busy & (1 << channel_id)) {
 		CCCI_REPEAT_LOG(0, TAG, "CCIF channel %d busy\n", channel_id);
@@ -1048,6 +1052,11 @@ static int md_ccif_op_send_skb(unsigned char hif_id, int qno,
 	 * cause a potential deadlock
 	 */
 	spin_lock_irqsave(&queue->tx_lock, flags);
+	if (READ_ONCE(ccif_ctrl->ccif_state) == HIFCCIF_STATE_QUIESCED ||
+	    ccci_fsm_get_md_state() == WAITING_TO_STOP) {
+		spin_unlock_irqrestore(&queue->tx_lock, flags);
+		return -ESHUTDOWN;
+	}
 
 	if (ccci_ringbuf_writeable(queue->ringbuf, skb->len) > 0) {
 
@@ -1549,6 +1558,38 @@ static int ccif_disable_irq1(unsigned char hif_id)
 	return 0;
 }
 
+/* Process context only: stop_for_ee also runs from the watchdog IRQ. */
+static int ccif_pre_stop(unsigned char hif_id)
+{
+	struct md_ccif_ctrl *ccif_ctrl = ccci_ccif_ctrl;
+	enum hifccif_state state = READ_ONCE(ccif_ctrl->ccif_state);
+	unsigned long flags;
+	unsigned int i;
+
+	if (state == HIFCCIF_STATE_MIN || state == HIFCCIF_STATE_PWROFF ||
+	    state == HIFCCIF_STATE_QUIESCED)
+		return 0;
+	if (state != HIFCCIF_STATE_PWRON)
+		return -EINVAL;
+
+	WRITE_ONCE(ccif_ctrl->ccif_state, HIFCCIF_STATE_QUIESCED);
+	/* New sends fail under these locks; finish sends that already passed. */
+	for (i = 0; i < QUEUE_NUM; i++) {
+		spin_lock_irqsave(&ccif_ctrl->txq[i].tx_lock, flags);
+		spin_unlock_irqrestore(&ccif_ctrl->txq[i].tx_lock, flags);
+	}
+	/* Own a separate mask while the poller retires its nested disable. */
+	disable_irq(ccif_ctrl->ap_ccif_irq0_id);
+	ccif_disable_irq1(hif_id);
+	synchronize_irq(ccif_ctrl->ap_ccif_irq1_id);
+	cancel_delayed_work_sync(&ccif_ctrl->data0_poll_work);
+	if (atomic_xchg(&ccif_ctrl->data0_irq_masked, 0))
+		enable_irq(ccif_ctrl->ap_ccif_irq0_id);
+	cancel_work_sync(&ccif_ctrl->ccif_sram_work);
+	cancel_work_sync(&ccif_ctrl->ccif_status_notify_work);
+	return 0;
+}
+
 static void md_ccif_sram_reset(unsigned char hif_id)
 {
 	int idx = 0;
@@ -1565,11 +1606,20 @@ static int ccif_start(unsigned char hif_id)
 {
 	unsigned long flags;
 	struct md_ccif_ctrl *ccif_ctrl = ccci_ccif_ctrl;
+	int ret;
 
+	if (READ_ONCE(ccif_ctrl->ccif_state) == HIFCCIF_STATE_QUIESCED)
+		return -ESHUTDOWN;
 	if (ccif_ctrl->ccif_state == HIFCCIF_STATE_PWRON)
 		return 0;
-	if (ccif_ctrl->ccif_state == HIFCCIF_STATE_MIN)
-		ccif_late_init(hif_id);
+	if (ccif_ctrl->ccif_state != HIFCCIF_STATE_MIN &&
+	    ccif_ctrl->ccif_state != HIFCCIF_STATE_PWROFF)
+		return -EINVAL;
+	if (ccif_ctrl->ccif_state == HIFCCIF_STATE_MIN) {
+		ret = ccif_late_init(hif_id);
+		if (ret)
+			return ret;
+	}
 	if (hif_id != CCIF_HIF_ID)
 		CCCI_NORMAL_LOG(0, TAG, "%s but %d\n",
 			__func__, hif_id);
@@ -1594,13 +1644,8 @@ static int ccif_start(unsigned char hif_id)
 	/* An immediate empty IRQ may run its poll worker before start returns. */
 	WRITE_ONCE(ccif_ctrl->ccif_state, HIFCCIF_STATE_PWRON);
 	ccif_enable_irq1(CCIF_HIF_ID);
-	if (!ccif_ctrl->irq0_armed) {
-		ccif_ctrl->irq0_armed = true;
-		enable_irq(ccif_ctrl->ap_ccif_irq0_id);
-	} else if (atomic_cmpxchg(&ccif_ctrl->data0_irq_masked, 1, 0) == 1) {
-		/* masked by an empty interrupt before the last stop */
-		enable_irq(ccif_ctrl->ap_ccif_irq0_id);
-	}
+	/* Initial NOAUTOEN or the single mask retained by the previous stop. */
+	enable_irq(ccif_ctrl->ap_ccif_irq0_id);
 	CCCI_NORMAL_LOG(0, TAG, "%s\n", __func__);
 	return 0;
 }
@@ -1608,6 +1653,7 @@ static int ccif_start(unsigned char hif_id)
 static int ccif_stop(unsigned char hif_id)
 {
 	struct md_ccif_ctrl *ccif_ctrl = ccci_ccif_ctrl;
+	int ret;
 
 	if (ccif_ctrl->ccif_state == HIFCCIF_STATE_PWROFF
 		|| ccif_ctrl->ccif_state == HIFCCIF_STATE_MIN)
@@ -1615,8 +1661,10 @@ static int ccif_stop(unsigned char hif_id)
 	/* ACK CCIF for MD. while entering flight mode,
 	 * we may send something after MD slept
 	 */
+	ret = ccif_pre_stop(hif_id);
+	if (ret)
+		return ret;
