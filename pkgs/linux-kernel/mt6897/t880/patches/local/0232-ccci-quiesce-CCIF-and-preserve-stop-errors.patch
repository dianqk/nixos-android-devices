+	race = pause_kind = kind;
+	if (kind != 3) {
+		depth[0] = 1;
+		ctrl.data0_irq_masked.value = 1;
+	}
+	rchnum = kind == 2 ? 4 : 0;
+	pthread_mutex_lock(&pause_lock);
+	worker_live = true;
+	assert(!pthread_create(&worker, NULL, run_worker, NULL));
+	while (!entered)
+		pthread_cond_wait(&pause_cond, &pause_lock);
+	pthread_mutex_unlock(&pause_lock);
+	assert(!ccif_pre_stop(CCIF_HIF_ID));
+	assert(!worker_live && ctrl.ccif_state == HIFCCIF_STATE_QUIESCED);
+	assert(depth[0] == 1 && !ctrl.data0_irq_masked.value &&
+	       !ctrl.data0_poll_work.pending);
+	assert(!clock_off && reset_stage == 6);
+	assert(ccif_start(CCIF_HIF_ID) == -ESHUTDOWN);
+	assert(!ccif_pre_stop(CCIF_HIF_ID) && depth[0] == 1);
+	assert(!ccif_stop(CCIF_HIF_ID) && clock_off == 1);
+	assert(!ccif_stop(CCIF_HIF_ID) && clock_off == 1 && depth[0] == 1);
+	reset_stage = 0;
+	assert(!ccif_start(CCIF_HIF_ID));
+	assert(!depth[0] && !depth[1]);
+}
+static void *stop_sender(void *unused)
+{
+	assert(!ccif_pre_stop(CCIF_HIF_ID));
+	WRITE_ONCE(stop_done, true);
+	return NULL;
+}
+static void inflight_tx_case(void)
+{
+	setup(false);
+	assert(!ccif_start(1));
+	race = pause_kind = 5;
+	thread_skb.len = 16;
+	pthread_mutex_lock(&pause_lock);
+	worker_live = true;
+	assert(!pthread_create(&worker, NULL, run_worker, NULL));
+	while (!entered)
+		pthread_cond_wait(&pause_cond, &pause_lock);
+	pthread_mutex_unlock(&pause_lock);
+	pthread_t stopper;
+	assert(!pthread_create(&stopper, NULL, stop_sender, NULL));
+	while (READ_ONCE(ctrl.ccif_state) != HIFCCIF_STATE_QUIESCED)
+		sched_yield();
+	assert(!READ_ONCE(
+		stop_done)); /* The real TX mutex still belongs to the sender. */
+	pthread_mutex_lock(&pause_lock);
+	released = true;
+	pthread_cond_broadcast(&pause_cond);
+	pthread_mutex_unlock(&pause_lock);
+	assert(!pthread_join(stopper, NULL));
+	assert(stop_done && !worker_live && ring_writes == 1 && skb_frees == 1);
+	/* In-flight send finished before preparation; all later sends retain the SKB. */
+	assert(md_ccif_op_send_skb(1, 0, &thread_skb, 0, 0) == -ESHUTDOWN);
+	assert(ring_writes == 1 && skb_frees == 1);
+}
+int main(int argc, char **argv)
+{
+	assert(argc == 2);
+	if (!strcmp(argv[1], "old-stop")) {
+		setup(false);
+		assert(!ccif_start(CCIF_HIF_ID));
+		late_irq = true;
