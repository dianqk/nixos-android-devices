diff --git a/tools/testing/selftests/mtk_ccci/test_modem_stop.py b/tools/testing/selftests/mtk_ccci/test_modem_stop.py
new file mode 100755
index 0000000000..b007321e15
--- /dev/null
+++ b/tools/testing/selftests/mtk_ccci/test_modem_stop.py
@@ -0,0 +1,76 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Exercise production modem stop/PM/FSM completion without device access."""
+from pathlib import Path
+import os
+import re
+import subprocess
+import tempfile
+
+assets = Path(__file__).resolve().parent
+repo = Path(os.environ.get('KERNEL_SRC', str(assets.parents[3])))
+base = repo / 'drivers/misc/mediatek/eccci'
+fsm = (base / 'fsm/ccci_fsm.c').read_text()
+header = (base / 'fsm/ccci_fsm_internal.h').read_text()
+
+
+def function(name, source):
+    match = re.search(r'^(?:(?:static|inline)\s+)*(?:int|void|enum \w+|struct ccci_fsm_command\s*\*)\s*'
+                      + name + r'\(', source, re.M)
+    start = match.start()
+    end = source.index('{', start) + 1
+    depth = 1
+    while depth:
+        depth += (source[end] == '{') - (source[end] == '}')
+        end += 1
+    return source[start:end]
+
+
+enums = re.search(r'^enum \{\n\tCCCI_FSM_INVALID.*?^};', header, re.M | re.S)[0] + '\n' + '\n'.join(re.findall(r'^enum (?:CCCI_FSM_STATE|CCCI_FSM_EVENT|CCCI_FSM_COMMAND|CCCI_FSM_POLLER_STATE) \{.*?^};',
+                             header, re.M | re.S))
+md_header = (repo / 'drivers/misc/mediatek/include/mt-plat/mtk_ccci_common.h').read_text()
+enums += '\n' + re.search(r'^enum MD_STATE \{.*?^};', md_header, re.M | re.S)[0]
+enums += '\n' + re.search(r'^enum MD_STATE_FOR_USER \{.*?^};', md_header, re.M | re.S)[0]
+platform = function('md_cd_power_off', (base / 'fsm/md_sys1_platform.c').read_text())
+modem = (base / 'fsm/modem_sys1.c').read_text()
+production = function('ccci_hif_pre_stop', (base / 'hif/ccci_hif.c').read_text()) + '\n' + platform
+production += '\n' + '\n'.join(function(n, modem) for n in ['md_cd_pre_stop', 'md_cd_stop', 'ccci_md_pre_stop', 'ccci_md_stop'])
+# Public wrappers delegate through the real stop methods supplied by the fixture.
+production = production.replace('return md->ops->pre_stop(md, stop_type);', 'return md_cd_pre_stop(md, stop_type);')
+production = production.replace('return md->ops->stop(md, stop_type);', 'return md_cd_stop(md, stop_type);')
+production += '\n' + '\n'.join(function(n, fsm) for n in ['fsm_finish_command', 'fsm_append_command',
+    'fsm_command_pre', 'fsm_command_post', 'fsm_append_event', 'fsm_finish_event',
+    'fsm_broadcast_state', 'fsm_routine_stop', 'fsm_main_thread', 'fsm_routine_zombie',
+    'ccci_fsm_get_md_state_for_user'])
+ioctl = (base / 'fsm/ccci_fsm_ioctl.c').read_text()
+case = ioctl[ioctl.index('\tcase CCCI_IOC_GET_MD_STATE:'):ioctl.index('\tcase CCCI_IOC_MD_RESET:')]
+production += '\nstatic long query(struct ccci_fsm_ctl *ctl, unsigned long arg)\n{\n' + \
+    'enum MD_STATE_FOR_USER state_for_user; int ret = 0; switch (CCCI_IOC_GET_MD_STATE) {\n' + \
+    case + '} return ret; }\n'
+stop = function('md_cd_stop', modem)
+old_stop = stop.rsplit('return ret;', 1)
+old_stop = old_stop[0] + 'return 0;' + old_stop[1]
+old_pm = platform.replace('\tif (ret < 0)\n\t\treturn ret;\n', '').replace(
+    '\tif (!pm_runtime_status_suspended(&md->plat_dev->dev))\n\t\treturn -EBUSY;\n', '')
+thread = function('fsm_main_thread', fsm)
+old_thread = re.sub(r'\t\tret = READ_ONCE\(ctl->stop_error\);.*?\t\t}\n', '', thread, count=1, flags=re.S)
+with tempfile.TemporaryDirectory(prefix='mtk-modem-stop-') as tmp:
+    tmp = Path(tmp)
+    for mode, code in [('fixed', production), ('old-stop', production.replace(stop, old_stop)),
+                       ('old-pm', production.replace(platform, old_pm)),
+                       ('old-dispatch', production.replace(thread, old_thread))]:
+        c = tmp / (mode + '.c')
+        c.write_text((assets / 'modem_stop_cases.c').read_text().replace('/* DECLARATIONS */', enums)
+                     .replace('/* PRODUCTION */', code))
+        binary = tmp / mode
+        subprocess.run([os.environ.get('CC', 'cc'), '-std=gnu11', '-Wall', '-Wextra',
+                        '-Wno-unused-parameter', '-Werror', '-fsanitize=address,undefined',
+                        str(c), '-o', str(binary)], check=True)
+        result = subprocess.run([str(binary), mode], capture_output=True, text=True, timeout=10)
+        if mode != 'fixed':
+            assert result.returncode < 0 and 'Assertion' in result.stderr, (mode, result)
+            print(mode + ': reintroduced production failure reproduced')
+            print(result.stderr.strip())
+        else:
+            assert result.returncode == 0, result
+            print(result.stdout, end='')
