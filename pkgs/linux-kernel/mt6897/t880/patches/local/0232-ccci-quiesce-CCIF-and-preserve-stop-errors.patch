+	ctrl.ccif_state = HIFCCIF_STATE_EXCEPTION;
+	assert(ccif_start(1) == -EINVAL && ccif_pre_stop(1) == -EINVAL);
+	setup(false);
+	race = 4;
+	space = 0;
+	struct sk_buff skb = { .len = 16 };
+	assert(md_ccif_op_send_skb(1, 0, &skb, 0, 1) == -ESHUTDOWN);
+	assert(!ring_writes && !skb_frees);
+	setup(false);
+	ctrl.ccif_state = HIFCCIF_STATE_QUIESCED;
+	assert(md_ccif_op_send_skb(1, 0, &skb, 0, 0) == -ESHUTDOWN &&
+	       !skb_frees && !ring_writes);
+	ctrl.ccif_state = HIFCCIF_STATE_PWRON;
+	assert(!md_ccif_op_send_skb(1, 0, &skb, 0, 0) && ring_writes == 1 &&
+	       skb_frees == 1);
+	/* Actual production wrappers preserve the firmware access guard. */
+	unsigned int before = reads;
+	devapc_check_flag = 0;
+	assert(!ccif_read32(NULL, 0) && reads == before);
+	ccif_write32(NULL, 0, 1);
+	assert(!writes);
+	devapc_check_flag = 1;
+	ccif_write32(NULL, 0, 1);
+	assert(writes == 1);
+	puts("CCIF production publication, quiescence, concurrent IRQ/poll depth and TX ownership PASS");
 }
