+		return 0;
+	}
+	failed_case(-ETIMEDOUT, false, 0, false);
+	failed_case(0, false, 0, false);
+	failed_case(0, true, -ENODEV, false);
+	failed_case(0, true, 0, true);
+	for (int value = 0; value <= 1; value++) {
+		setup();
+		pm_return = value;
+		events();
+		struct ccci_fsm_command *c = command(CCCI_COMMAND_STOP, true);
+		fsm_routine_stop(&ctl, c);
+		assert(!ctl.stop_error && ctl.curr_state == CCCI_FSM_GATED &&
+		       c->complete == 1);
+		assert(broadcasts[GATED] == 1 && !wakes && post_pm == 2 &&
+		       delays == 1);
+		assert(quiesced && preparation_calls == 1 && pm_calls == 1);
+		kfree(c);
+		assert(allocations == frees);
+	}
+	setup();
+	pm_return = -EIO;
+	assert(fsm_append_command(&ctl, CCCI_COMMAND_STOP,
+				  FSM_CMD_FLAG_WAIT_FOR_COMPLETE) == -EIO);
+	assert(!wakes && command_pre == 1 && command_post == 1 &&
+	       allocations == frees);
+	setup();
+	ccci_hif[CCIF_HIF_ID] = NULL;
+	assert(ccci_hif_pre_stop(CCIF_HIF_ID) == -ENODEV && !pm_calls);
+	assert(ccci_hif_pre_stop(CCCI_HIF_NUM) == -ENODEV);
+	setup();
+	ctl.curr_state = CCCI_FSM_GATED;
+	struct ccci_fsm_command *c = command(CCCI_COMMAND_STOP, true);
+	fsm_routine_stop(&ctl, c);
+	assert(c->complete == 1 && !wakes && !pm_calls);
+	kfree(c);
+	setup();
+	ctl.curr_state = CCCI_FSM_GATED;
+	ctl.md_state = GATED;
+	assert(!fsm_append_command(&ctl, CCCI_COMMAND_START, 0));
+	assert(!fsm_append_command(&ctl, CCCI_COMMAND_STOP, 0));
+	unsigned int value = 99;
+	assert(query(&ctl, (unsigned long)&value) == -EINPROGRESS &&
+	       value == 99);
+	fsm_main_thread(&ctl);
+	assert(!ctl.stop_pending.value && !query(&ctl, (unsigned long)&value) &&
+	       value == MD_STATE_INVALID);
+	setup();
+	pm_return = -EIO;
+	assert(!fsm_append_command(&ctl, CCCI_COMMAND_STOP, 0));
+	assert(!fsm_append_command(&ctl, CCCI_COMMAND_STOP, 0));
+	assert(ctl.stop_pending.value == 2);
+	fsm_main_thread(&ctl);
+	assert(!ctl.stop_pending.value && ctl.stop_error == -EIO &&
+	       pm_calls == 1);
+	assert(command_pre == 1 && allocations == frees);
+	setup();
+	assert(!fsm_append_command(&ctl, CCCI_COMMAND_STOP, 0));
+	assert(!fsm_append_command(&ctl, CCCI_COMMAND_STOP, 0));
+	fsm_routine_zombie(&ctl);
+	assert(!ctl.stop_pending.value && allocations == frees);
+	puts("Modem production PM/stop/FSM pending, error, waiter, event and wakelock cases PASS");
+}
