diff --git a/drivers/clk/mediatek/clk-mt6897-topckgen.c b/drivers/clk/mediatek/clk-mt6897-topckgen.c
index c8b8e66429..51d5622c63 100644
--- a/drivers/clk/mediatek/clk-mt6897-topckgen.c
+++ b/drivers/clk/mediatek/clk-mt6897-topckgen.c
@@ -11,11 +11,13 @@
 
 #include <dt-bindings/clock/mediatek,mt6897-clock.h>
 #include <linux/clk-provider.h>
+#include <linux/clk/mediatek-mt6897.h>
 #include <linux/iopoll.h>
 #include <linux/mfd/syscon.h>
 #include <linux/module.h>
 #include <linux/regmap.h>
 #include <linux/of.h>
+#include <linux/of_platform.h>
 #include <linux/platform_device.h>
 
 #include "clk-mtk.h"
@@ -1533,11 +1535,23 @@ static const struct mt6897_ro_mux top_ro_muxes[] = {
  * Source: https://github.com/MiCode/MTK_kernel_device_modules/blob/
  * 3c4ccd07d5624879555ec710c11bb8818e5cb5c6/drivers/clk/mediatek/clk-mux.c
  */
+struct mt6897_voted_mux;
+struct mt6897_clk_boot_owner {
+	spinlock_t lock;
+	struct device *dev;
+	struct device *controller;
+	struct mt6897_voted_mux *mux[2];
+	u8 epochs;
+	u8 reported;
+};
+
 struct mt6897_voted_mux {
 	struct clk_hw hw;
 	const struct mt6897_ro_mux *data;
 	struct regmap *voter;
 	void __iomem *base;
+	struct mt6897_clk_boot_owner *owner;
+	bool live;
 	bool classified;
 	bool inherited;
 	bool owned;
@@ -1564,7 +1578,7 @@ static int mt6897_mux_vote(struct mt6897_voted_mux *m, bool on)
 				  2, 100000);
 }
 
-static int mt6897_mux_enable(struct clk_hw *hw)
+static int mt6897_mux_enable_locked(struct clk_hw *hw)
 {
 	struct mt6897_voted_mux *m = container_of(hw, struct mt6897_voted_mux, hw);
 	u32 val, bit = BIT(m->data->shift + 7);
@@ -1598,7 +1612,7 @@ static int mt6897_mux_enable(struct clk_hw *hw)
 	return ret;
 }
 
-static void mt6897_mux_disable(struct clk_hw *hw)
+static void mt6897_mux_disable_locked(struct clk_hw *hw)
 {
 	struct mt6897_voted_mux *m = container_of(hw, struct mt6897_voted_mux, hw);
 	int ret;
@@ -1612,6 +1626,31 @@ static void mt6897_mux_disable(struct clk_hw *hw)
 		m->owned = false;
 }
 
+static int mt6897_mux_enable(struct clk_hw *hw)
+{
+	struct mt6897_voted_mux *m = container_of(hw, struct mt6897_voted_mux, hw);
+	unsigned long flags;
+	int ret;
+
+	spin_lock_irqsave(&m->owner->lock, flags);
+	ret = mt6897_mux_enable_locked(hw);
+	if (!ret)
+		m->live = true;
+	spin_unlock_irqrestore(&m->owner->lock, flags);
+	return ret;
+}
+
+static void mt6897_mux_disable(struct clk_hw *hw)
+{
+	struct mt6897_voted_mux *m = container_of(hw, struct mt6897_voted_mux, hw);
+	unsigned long flags;
+
+	spin_lock_irqsave(&m->owner->lock, flags);
+	m->live = false;
+	mt6897_mux_disable_locked(hw);
+	spin_unlock_irqrestore(&m->owner->lock, flags);
+}
+
 static u8 mt6897_mux_get_parent(struct clk_hw *hw)
 {
 	struct mt6897_voted_mux *m = container_of(hw, struct mt6897_voted_mux, hw);
@@ -1627,7 +1666,8 @@ static const struct clk_ops mt6897_mux_ops = {
 };
 
 static struct clk_hw *mt6897_mux_register(struct device *dev,
-		const struct mt6897_ro_mux *d, void __iomem *base, struct regmap *voter)
+		const struct mt6897_ro_mux *d, void __iomem *base, struct regmap *voter,
+		struct mt6897_clk_boot_owner *owner)
 {
 	struct mt6897_voted_mux *m;
 	struct clk_init_data init = {
@@ -1644,18 +1684,130 @@ static struct clk_hw *mt6897_mux_register(struct device *dev,
 	m->data = d;
 	m->base = base;
 	m->voter = voter;
+	m->owner = owner;
 	ret = devm_clk_hw_register(dev, &m->hw);
+	if (!ret && d->id == CLK_TOP_OVL0_SEL)
+		owner->mux[0] = m;
+	if (!ret && d->id == CLK_TOP_OVL1_SEL)
+		owner->mux[1] = m;
 	return ret ? ERR_PTR(ret) : &m->hw;
 }
 
+/* Lock order: CCF enable lock -> owner lock, or owner lock alone.
+ * Never call CCF, runtime PM or device locking with owner->lock held.
+ */
+static struct platform_driver clk_mt6897_top_drv;
+
+struct mt6897_clk_boot_owner *mt6897_clk_boot_get(struct device_node *np,
+					       struct device *controller)
+{
+	struct platform_device *pdev;
+	struct mt6897_clk_boot_owner *owner;
+	unsigned long flags;
+	int ret = -EPROBE_DEFER;
+
+	if (!np || !controller || !of_device_is_compatible(np, "mediatek,mt6897-topckgen"))
+		return ERR_PTR(-EINVAL);
+	pdev = of_find_device_by_node(np);
+	if (!pdev)
+		return ERR_PTR(-EPROBE_DEFER);
+	device_lock(&pdev->dev);
+	owner = platform_get_drvdata(pdev);
+	if (!device_is_bound(&pdev->dev) ||
+	    pdev->dev.driver != &clk_mt6897_top_drv.driver || !owner)
+		goto out;
+	ret = -EINVAL;
+	if (!owner->mux[0] || !owner->mux[1] ||
+	    owner->mux[0]->data->id != CLK_TOP_OVL0_SEL ||
+	    owner->mux[1]->data->id != CLK_TOP_OVL1_SEL ||
+	    owner->mux[0]->owner != owner || owner->mux[1]->owner != owner ||
+	    !owner->mux[0]->voter || owner->mux[0]->voter != owner->mux[1]->voter)
+		goto out;
+	spin_lock_irqsave(&owner->lock, flags);
+	if (owner->controller) {
+		ret = -EBUSY;
+	} else {
+		owner->controller = controller;
+		ret = 0;
+	}
+	spin_unlock_irqrestore(&owner->lock, flags);
+out:
+	device_unlock(&pdev->dev);
+	if (ret) {
+		put_device(&pdev->dev);
+		return ERR_PTR(ret);
+	}
+	/* of_find_device_by_node's reference belongs to this enrollment. */
+	return owner;
+}
+EXPORT_SYMBOL_GPL(mt6897_clk_boot_get);
+
+void mt6897_clk_boot_put(struct mt6897_clk_boot_owner *owner)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&owner->lock, flags);
+	owner->controller = NULL;
+	spin_unlock_irqrestore(&owner->lock, flags);
+	put_device(owner->dev);
+}
+EXPORT_SYMBOL_GPL(mt6897_clk_boot_put);
+
+int mt6897_clk_boot_record_off(struct mt6897_clk_boot_owner *owner,
+			     unsigned int bank, u32 status)
+{
+	const u32 on = BIT(31) | BIT(30) | BIT(0) | BIT(2) | BIT(3);
+	const u32 isolated = BIT(1) | BIT(4);
+	unsigned long flags;
+	u8 reported = 0;
+	int ret = -EINVAL;
+
+	if (!owner || bank > 1 || (status & on) || (status & isolated) != isolated)
+		return -EINVAL;
+	spin_lock_irqsave(&owner->lock, flags);
+	if (!owner->controller || !owner->mux[0]->classified || !owner->mux[0]->live ||
+	    (bank == 1 && (!owner->mux[1]->classified || !owner->mux[1]->live)))
+		goto out;
+	owner->epochs |= BIT(bank);
+	/* Transfer accounting only; the caller still holds the ordinary roots. */
+	if (bank == 1) {
+		if (owner->mux[1]->inherited && !(owner->reported & BIT(1)))
+			reported |= BIT(1);
+		owner->mux[1]->inherited = false;
+		owner->mux[1]->owned = true;
+	}
+	if (owner->epochs == (BIT(0) | BIT(1))) {
+		if (owner->mux[0]->inherited && !(owner->reported & BIT(0)))
+			reported |= BIT(0);
+		owner->mux[0]->inherited = false;
+		owner->mux[0]->owned = true;
+	}
+	owner->reported |= reported;
+	ret = 0;
+out:
+	spin_unlock_irqrestore(&owner->lock, flags);
+	if (reported & BIT(0))
+		dev_info(owner->dev, "OVL0 root BOOT accounting transferred to ordinary users\n");
+	if (reported & BIT(1))
+		dev_info(owner->dev, "OVL1 root BOOT accounting transferred to ordinary users\n");
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6897_clk_boot_record_off);
+
 static int clk_mt6897_top_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
 	struct clk_hw_onecell_data *clk_data;
+	struct mt6897_clk_boot_owner *owner;
 	void __iomem *base;
 	struct regmap *voter;
 	int i, ret;
 
+	owner = devm_kzalloc(dev, sizeof(*owner), GFP_KERNEL);
+	if (!owner)
+		return -ENOMEM;
+	owner->dev = dev;
+	spin_lock_init(&owner->lock);
 	base = devm_platform_ioremap_resource(pdev, 0);
 	if (IS_ERR(base))
 		return PTR_ERR(base);
@@ -1695,7 +1847,7 @@ static int clk_mt6897_top_probe(struct platform_device *pdev)
 
 		/* Without the voter, keep firmware gate and parent ownership. */
 		if (m->vote_set && voter)
-			hw = mt6897_mux_register(dev, m, base, voter);
+			hw = mt6897_mux_register(dev, m, base, voter, owner);
 		else
 			hw = devm_clk_hw_register_mux(dev, m->name, m->parents,
 					      m->num_parents, 0,
@@ -1707,7 +1859,11 @@ static int clk_mt6897_top_probe(struct platform_device *pdev)
 		clk_data->hws[m->id] = hw;
 	}
 
-	return devm_of_clk_add_hw_provider(dev, of_clk_hw_onecell_get, clk_data);
+	ret = devm_of_clk_add_hw_provider(dev, of_clk_hw_onecell_get, clk_data);
+	if (ret)
+		return ret;
+	platform_set_drvdata(pdev, owner);
+	return 0;
 }
 
 static const struct of_device_id of_match_clk_mt6897_top[] = {
@@ -1720,6 +1876,7 @@ static struct platform_driver clk_mt6897_top_drv = {
 	.probe = clk_mt6897_top_probe,
 	.driver = {
 		.name = "clk-mt6897-top",
+		.suppress_bind_attrs = true,
 		.of_match_table = of_match_clk_mt6897_top,
 	},
 };
diff --git a/include/linux/clk/mediatek-mt6897.h b/include/linux/clk/mediatek-mt6897.h
new file mode 100644
index 0000000000..9f7afdd961
--- /dev/null
+++ b/include/linux/clk/mediatek-mt6897.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_CLK_MEDIATEK_MT6897_H
+#define _LINUX_CLK_MEDIATEK_MT6897_H
+
+#include <linux/err.h>
+#include <linux/errno.h>
+#include <linux/kconfig.h>
+#include <linux/types.h>
+
+struct device;
+struct device_node;
+struct mt6897_clk_boot_owner;
+
+/* This handle is for the static built-in provider with unbind suppressed.
+ * Successful and quarantined controllers retain it for their lifetime.
+ */
+#if IS_ENABLED(CONFIG_COMMON_CLK_MT6897)
+struct mt6897_clk_boot_owner *mt6897_clk_boot_get(struct device_node *np,
+					       struct device *controller);
+/* Only for preflight unwind, before hardware/domain callbacks can use it. */
+void mt6897_clk_boot_put(struct mt6897_clk_boot_owner *owner);
+/* Atomic. Caller holds every ordinary root enable reference for this bank:
+ * OVL0: ovl0; OVL1: ovl0 and ovl1. Records no epoch without live roots.
+ * The raw SPM value must be read after successful HWV-off, before root release.
+ */
+int mt6897_clk_boot_record_off(struct mt6897_clk_boot_owner *owner,
+			     unsigned int bank, u32 status);
+#else
+static inline struct mt6897_clk_boot_owner *
+mt6897_clk_boot_get(struct device_node *np, struct device *controller)
+{
+	return ERR_PTR(-ENODEV);
+}
+static inline void mt6897_clk_boot_put(struct mt6897_clk_boot_owner *owner) {}
+static inline int mt6897_clk_boot_record_off(struct mt6897_clk_boot_owner *owner,
+					   unsigned int bank, u32 status)
+{
+	return -ENODEV;
+}
+#endif
+#endif
diff --git a/tools/testing/selftests/mtk_clk/Makefile b/tools/testing/selftests/mtk_clk/Makefile
index b36bb93355..8c9b04d5c0 100644
--- a/tools/testing/selftests/mtk_clk/Makefile
+++ b/tools/testing/selftests/mtk_clk/Makefile
@@ -1,4 +1,4 @@
