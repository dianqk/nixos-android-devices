-TEST_PROGS := test_mt6897.py test_domains.py
-TEST_FILES := mt6897_stubs.h mt6897_cases.c domain_stubs.h domain_cases.c
+TEST_PROGS := test_mt6897.py test_domains.py test_boot_owner.py
