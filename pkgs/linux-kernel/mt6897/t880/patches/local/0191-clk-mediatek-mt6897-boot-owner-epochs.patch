new file mode 100755
index 0000000000..6386aa9d34
--- /dev/null
+++ b/tools/testing/selftests/mtk_clk/test_boot_owner.py
@@ -0,0 +1,36 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Exercise production boot-owner enrollment, epochs and shared-lock races."""
+from pathlib import Path
+import os
+import subprocess
+import tempfile
+
+assets = Path(__file__).resolve().parent
+repo = Path(os.environ.get('KERNEL_SRC', str(assets.parents[3])))
+s = (repo / 'drivers/clk/mediatek/clk-mt6897-topckgen.c').read_text()
+start = s.index('struct mt6897_voted_mux;')
+end = s.index('static const struct clk_ops mt6897_mux_ops', start)
+production = s[start:end]
+for name in ['mt6897_clk_boot_get', 'mt6897_clk_boot_put', 'mt6897_clk_boot_record_off']:
+    start = s.index(name + '(')
+    start = s.rfind('\n', 0, start) + 1
+    brace = s.index('{', start)
+    end, depth = brace + 1, 1
+    while depth:
+        depth += (s[end] == '{') - (s[end] == '}')
+        end += 1
+    function = s[start:end]
+    production += function + '\n'
+    if name == 'mt6897_clk_boot_record_off':
+        assert 'regmap_' not in function and 'clk_enable(' not in function
+        assert 'clk_disable(' not in function
+with tempfile.TemporaryDirectory(prefix='mtk-boot-') as temporary:
+    out = Path(temporary)
+    (out / 'test.c').write_text((assets / 'mt6897_stubs.h').read_text() +
+                              (assets / 'boot_stubs.h').read_text() + production +
+                              (assets / 'boot_cases.c').read_text())
+    subprocess.run([os.environ.get('CC', 'cc'), '-g', '-pthread',
+                    '-fsanitize=address,undefined', '-o', str(out / 'test'),
+                    str(out / 'test.c')], check=True)
+    subprocess.run([str(out / 'test')], check=True)
