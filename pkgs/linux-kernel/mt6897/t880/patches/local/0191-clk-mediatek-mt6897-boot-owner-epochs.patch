diff --git a/tools/testing/selftests/mtk_clk/boot_cases.c b/tools/testing/selftests/mtk_clk/boot_cases.c
new file mode 100644
index 0000000000..9a4a179aeb
--- /dev/null
+++ b/tools/testing/selftests/mtk_clk/boot_cases.c
@@ -0,0 +1,243 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#define OVL0_BIT BIT(7)
+#define OVL1_BIT BIT(15)
+#define OVL_BITS (OVL0_BIT | OVL1_BIT)
+static struct mt6897_clk_boot_owner owner;
+static struct mt6897_ro_mux data[2];
+static struct mt6897_voted_mux mux[2];
+static struct regmap voter, foreign_voter;
+static u32 regs;
+static struct device controller;
+static struct device_node node = {.compatible = true};
+static bool initialized;
+
+static void cleanup(void)
+{
+	if (!initialized)
+		return;
+	assert(!pthread_mutex_destroy(&owner.lock));
+	assert(!pthread_mutex_destroy(&provider.dev.lock));
+	initialized = false;
+}
+
+static void reset(void)
+{
+	cleanup();
+	memset(&owner, 0, sizeof(owner));
+	spin_lock_init(&owner.lock);
+	provider = (struct platform_device){
+	    .dev = {.driver = &clk_mt6897_top_drv.driver, .bound = true},
+	    .data = &owner,
+	};
+	assert(!pthread_mutex_init(&provider.dev.lock, NULL));
+	initialized = true;
+	owner.dev = &provider.dev;
+	present = true;
+	node.compatible = true;
+	regs = 0;
+	voter = (struct regmap){.vote = OVL_BITS,
+				.done = OVL_BITS,
+				.set = 1,
+				.clr = 2,
+				.done_reg = 3,
+				.pdn = &regs,
+				.allowed = OVL_BITS};
+	for (int i = 0; i < 2; i++) {
+		data[i] = (struct mt6897_ro_mux){
+		    .id = i ? CLK_TOP_OVL1_SEL : CLK_TOP_OVL0_SEL,
+		    .vote_set = 1,
+		    .vote_clr = 2,
+		    .vote_done = 3,
+		    .shift = i * 8,
+		};
+		mux[i] = (struct mt6897_voted_mux){.owner = &owner,
+						   .data = &data[i],
+						   .voter = &voter,
+						   .base = &regs};
+		owner.mux[i] = &mux[i];
+	}
+}
+
+static void enroll_enable(void)
+{
+	assert(mt6897_clk_boot_get(&node, &controller) == &owner);
+	assert(provider.dev.refs == 1);
+	assert(!mt6897_mux_enable(&mux[0].hw));
+	assert(!mt6897_mux_enable(&mux[1].hw));
+}
+
+static void test_enrollment(void)
+{
+	reset();
+	present = false;
+	assert(PTR_ERR(mt6897_clk_boot_get(&node, &controller)) ==
+	       -EPROBE_DEFER);
+	present = true;
+	provider.data = NULL;
+	assert(PTR_ERR(mt6897_clk_boot_get(&node, &controller)) ==
+	       -EPROBE_DEFER);
+	assert(!provider.dev.refs);
+	provider.data = &owner;
+	provider.dev.bound = false;
+	assert(PTR_ERR(mt6897_clk_boot_get(&node, &controller)) ==
+	       -EPROBE_DEFER);
+	assert(!provider.dev.refs);
+	provider.dev.bound = true;
+	provider.dev.driver = NULL;
+	assert(PTR_ERR(mt6897_clk_boot_get(&node, &controller)) ==
+	       -EPROBE_DEFER);
+	assert(!provider.dev.refs);
+	provider.dev.driver = &clk_mt6897_top_drv.driver;
+	owner.mux[1] = NULL;
+	assert(PTR_ERR(mt6897_clk_boot_get(&node, &controller)) == -EINVAL);
+	assert(!provider.dev.refs);
+	owner.mux[1] = &mux[1];
+	data[1].id = 999;
+	assert(PTR_ERR(mt6897_clk_boot_get(&node, &controller)) == -EINVAL);
+	assert(!provider.dev.refs);
+	data[1].id = CLK_TOP_OVL1_SEL;
+	mux[1].voter = &foreign_voter;
+	assert(PTR_ERR(mt6897_clk_boot_get(&node, &controller)) == -EINVAL);
+	assert(!provider.dev.refs);
+	mux[1].voter = &voter;
+	mux[1].owner = NULL;
+	assert(PTR_ERR(mt6897_clk_boot_get(&node, &controller)) == -EINVAL);
+	assert(!provider.dev.refs);
+	mux[1].owner = &owner;
+	assert(mt6897_clk_boot_get(&node, &controller) == &owner);
+	assert(PTR_ERR(mt6897_clk_boot_get(&node, &controller)) == -EBUSY);
+	assert(provider.dev.refs == 1);
+	mt6897_clk_boot_put(&owner);
+	assert(!provider.dev.refs && !owner.controller);
+	assert(mt6897_clk_boot_get(&node, &controller) == &owner);
+	mt6897_clk_boot_put(&owner);
+}
+
+static void test_orders_and_resume(void)
+{
+	for (int first = 0; first < 2; first++) {
+		reset();
+		enroll_enable();
+		int writes = voter.writes;
+		assert(!mt6897_clk_boot_record_off(&owner, first, 18 | BIT(8)));
+		assert(owner.epochs == BIT(first));
+		assert(!mt6897_clk_boot_record_off(&owner, first, 18));
+		assert(voter.writes == writes);
+		if (first == 0) {
+			assert(mux[0].inherited && mux[1].inherited);
+			mt6897_mux_disable(&mux[0].hw);
+			assert(!mt6897_mux_enable(&mux[0].hw));
+		} else {
+			assert(mux[0].inherited && !mux[1].inherited);
+			mt6897_mux_disable(&mux[1].hw);
+			assert(voter.vote == OVL0_BIT);
+			assert(!mt6897_mux_enable(&mux[1].hw));
+		}
+		writes = voter.writes;
+		assert(!mt6897_clk_boot_record_off(&owner, 1 - first, 18));
+		assert(voter.writes == writes && owner.epochs == 3);
+		assert(!mux[0].inherited && !mux[1].inherited);
+		assert(mux[0].owned && mux[1].owned);
+		mt6897_mux_disable(&mux[0].hw);
+		assert(voter.vote == OVL1_BIT);
+		mt6897_mux_disable(&mux[1].hw);
+		assert(!voter.vote);
+	}
+}
+
+static void test_prerequisites(void)
+{
+	reset();
+	enroll_enable();
+	for (unsigned bit = 0; bit < 32; bit++) {
+		if (bit != 0 && bit != 1 && bit != 2 && bit != 3 && bit != 4 &&
+		    bit != 30 && bit != 31)
+			continue;
+		assert(mt6897_clk_boot_record_off(&owner, 1, 18 ^ BIT(bit)) ==
+		       -EINVAL);
+		assert(!owner.epochs);
+	}
+	mux[1].live = false;
+	assert(mt6897_clk_boot_record_off(&owner, 1, 18) == -EINVAL);
+	assert(!owner.epochs);
+	mux[1].live = true;
+	mux[0].live = false;
+	assert(mt6897_clk_boot_record_off(&owner, 0, 18) == -EINVAL);
+	assert(mt6897_clk_boot_record_off(&owner, 1, 18) == -EINVAL);
+	assert(!owner.epochs);
+	mux[0].live = true;
+	mux[0].classified = false;
+	assert(mt6897_clk_boot_record_off(&owner, 0, 18) == -EINVAL);
+	assert(!owner.epochs);
+	mux[0].classified = true;
+	mux[1].classified = false;
+	assert(!mt6897_clk_boot_record_off(&owner, 0, 18));
+	assert(mt6897_clk_boot_record_off(&owner, 1, 18) == -EINVAL);
+	assert(owner.epochs == 1 && mux[0].inherited && mux[1].inherited);
+	mux[1].classified = true;
+	assert(mt6897_clk_boot_record_off(&owner, 2, 18) == -EINVAL);
+}
+
+static void test_unvote_retry(void)
+{
+	reset();
+	enroll_enable();
+	assert(!mt6897_clk_boot_record_off(&owner, 1, 18));
+	assert(!mt6897_clk_boot_record_off(&owner, 0, 18));
+	voter.fail_clear = 1;
+	mt6897_mux_disable(&mux[0].hw);
+	assert(!mux[0].live && mux[0].owned && (voter.vote & OVL0_BIT));
+	assert(mt6897_clk_boot_record_off(&owner, 0, 18) == -EINVAL);
+	voter.fail_clear = 0;
+	assert(!mt6897_mux_enable(&mux[0].hw));
+	mt6897_mux_disable(&mux[0].hw);
+	assert(!(voter.vote & OVL0_BIT) && !mux[0].owned);
+	assert(voter.vote & OVL1_BIT);
+}
+
+static void *racing_enable(void *unused)
+{
+	for (int i = 0; i < 1000; i++) {
+		assert(!mt6897_mux_enable(&mux[0].hw));
+		mt6897_mux_disable(&mux[0].hw);
+	}
+	return NULL;
+}
+
+static void *racing_epoch(void *unused)
+{
+	for (int i = 0; i < 1000; i++) {
+		int ret = mt6897_clk_boot_record_off(&owner, 0, 18);
+		assert(!ret || ret == -EINVAL);
+	}
+	return NULL;
+}
+
+static void test_race(void)
+{
+	reset();
+	enroll_enable();
+	assert(!mt6897_clk_boot_record_off(&owner, 1, 18));
+	mt6897_mux_disable(&mux[0].hw);
+	pthread_t a, b;
+	assert(!pthread_create(&a, NULL, racing_enable, NULL));
+	assert(!pthread_create(&b, NULL, racing_epoch, NULL));
+	pthread_join(a, NULL);
+	pthread_join(b, NULL);
+	assert(!mt6897_mux_enable(&mux[0].hw));
+	assert(!mt6897_clk_boot_record_off(&owner, 0, 18));
+	mt6897_mux_disable(&mux[0].hw);
+	assert(!(voter.vote & OVL0_BIT) && !mux[0].live);
+}
+
+int main(void)
+{
+	test_enrollment();
+	test_orders_and_resume();
+	test_prerequisites();
+	test_unvote_retry();
+	test_race();
+	cleanup();
+	puts("boot-owner enrollment, epochs, retry and 2000 concurrent "
+	     "operations passed");
+}
