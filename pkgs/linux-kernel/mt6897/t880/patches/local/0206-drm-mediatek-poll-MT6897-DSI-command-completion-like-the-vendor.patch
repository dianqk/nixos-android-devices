 transfer = function('mtk_dsi_host_transfer')
 assert transfer.index('!READ_ONCE(dsi->power_ready)') < transfer.index('readl(')
 assert transfer.index('!READ_ONCE(lead->power_ready)') < transfer.index('readl(')
