+/*
+ * debugfs, for link bring-up: "retrain" trains the link again (with the
+ * "max_lanes"/"max_rate" limits, 0 for none) and "link_status" shows the
+ * sink's link status and the main TX registers.
+ */
+static ssize_t mtk_dp_debugfs_retrain(struct file *file,
+				      const char __user *ubuf, size_t count,
+				      loff_t *ppos)
+{
+	struct mtk_dp *mtk_dp = file->private_data;
+	int ret;
+
+	if (!mtk_dp->drm_dev || !mtk_dp->train_info.cable_plugged_in)
+		return -ENODEV;
+
+	/* serialize with the HPD thread */
+	disable_irq(mtk_dp->irq);
+	mtk_dp_aux_panel_poweron(mtk_dp, true);
+	ret = mtk_dp_parse_capabilities(mtk_dp);
+	if (!ret)
+		ret = mtk_dp_training(mtk_dp);
+	mtk_dp->link_failed = ret;
+	dev_info(mtk_dp->dev, "retrain: %d, rate 0x%02x, %u lanes, link status %*ph\n",
+		 ret, mtk_dp->train_info.link_rate, mtk_dp->train_info.lane_count,
+		 DP_LINK_STATUS_SIZE, mtk_dp->last_link_status);
+	enable_irq(mtk_dp->irq);
+
+	drm_helper_hpd_irq_event(mtk_dp->drm_dev);
+
+	return ret ? ret : count;
+}
+
+static const struct file_operations mtk_dp_debugfs_retrain_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = mtk_dp_debugfs_retrain,
+};
