+static int mtk_dp_debugfs_link_status_show(struct seq_file *m, void *unused)
+{
+	static const u16 regs[] = {
+		0x0008, 0x003c, 0x0054, 0x103c, 0x2000, 0x3000, 0x3408,
+		0x3428, 0x34a4, 0x3414, 0x35f0, 0x360c, 0x3680,
+	};
+	struct mtk_dp *mtk_dp = m->private;
+	u8 status[DP_LINK_STATUS_SIZE];
+	int i;
+
+	seq_printf(m, "plugged %d oob_hpd %d link_failed %d typec_lanes %u aux_pn_swap %d\n",
+		   mtk_dp->train_info.cable_plugged_in, mtk_dp->oob_hpd_level,
+		   mtk_dp->link_failed, mtk_dp->typec_lanes, mtk_dp->aux_pn_swap);
+	seq_printf(m, "trained rate 0x%02x lanes %u; last link status %*ph\n",
+		   mtk_dp->train_info.link_rate, mtk_dp->train_info.lane_count,
+		   DP_LINK_STATUS_SIZE, mtk_dp->last_link_status);
+	if (mtk_dp->train_info.cable_plugged_in &&
+	    drm_dp_dpcd_read_link_status(&mtk_dp->aux, status) == 0)
+		seq_printf(m, "sink link status %*ph\n", DP_LINK_STATUS_SIZE, status);
+	if (!pm_runtime_active(mtk_dp->dev))
+		return 0;
+	for (i = 0; i < ARRAY_SIZE(regs); i++)
+		seq_printf(m, "0x%04x: 0x%08x\n", regs[i], mtk_dp_read(mtk_dp, regs[i]));
+
+	return 0;
+}
