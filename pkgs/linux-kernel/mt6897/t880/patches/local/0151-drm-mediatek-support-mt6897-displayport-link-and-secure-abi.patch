+static int mtk_dp_typec_switch_set(struct typec_switch_dev *sw,
+				   enum typec_orientation orientation)
+{
+	struct mtk_dp *mtk_dp = typec_switch_get_drvdata(sw);
+
+	mtk_dp->aux_pn_swap = orientation == TYPEC_ORIENTATION_REVERSE;
+	mtk_dp_set_aux_pn_swap(mtk_dp);
+
+	return 0;
+}
+
+static int mtk_dp_typec_mux_set(struct typec_mux_dev *mux,
+				struct typec_mux_state *state)
+{
+	struct mtk_dp *mtk_dp = typec_mux_get_drvdata(mux);
+	struct typec_displayport_data *dp_data = state->data;
+	bool hpd = false;
+
+	if (!state->alt || state->alt->svid != USB_TYPEC_DP_SID) {
+		mtk_dp->typec_lanes = 0;
+		goto out;
+	}
+
+	switch (state->mode) {
+	case TYPEC_DP_STATE_C:
+	case TYPEC_DP_STATE_E:
+		mtk_dp->typec_lanes = 4;
+		break;
+	case TYPEC_DP_STATE_D:
+	case TYPEC_DP_STATE_F:
+		mtk_dp->typec_lanes = 2;
+		break;
+	default:
+		goto out;
+	}
+
+	/* The DisplayPort status carries the HPD of the sink */
+	hpd = dp_data && (dp_data->status & DP_STATUS_HPD_STATE);
+
+out:
+	if (mtk_dp->oob_hpd)
+		mtk_dp_oob_hpd_update(mtk_dp, hpd);
+
+	return 0;
+}
+
+static void mtk_dp_typec_unregister(void *data)
+{
+	struct mtk_dp *mtk_dp = data;
+
+	typec_mux_unregister(mtk_dp->typec_mux);
+	typec_switch_unregister(mtk_dp->typec_sw);
+}
+
+/*
+ * When the output reaches a USB Type-C connector through the DisplayPort
+ * alt mode, follow the plug orientation (AUX P/N swap) and the pin
+ * assignment (lane count).
+ */
+static int mtk_dp_typec_register(struct mtk_dp *mtk_dp)
+{
+	struct device *dev = mtk_dp->dev;
+	struct typec_switch_desc sw_desc = {
+		.drvdata = mtk_dp,
+		.fwnode = dev_fwnode(dev),
+		.set = mtk_dp_typec_switch_set,
+	};
+	struct typec_mux_desc mux_desc = {
+		.drvdata = mtk_dp,
+		.fwnode = dev_fwnode(dev),
+		.set = mtk_dp_typec_mux_set,
+	};
+
+	if (!IS_ENABLED(CONFIG_TYPEC) ||
+	    !device_property_present(dev, "orientation-switch") ||
+	    !device_property_present(dev, "mode-switch"))
+		return 0;
+
+	mtk_dp->typec_sw = typec_switch_register(dev, &sw_desc);
+	if (IS_ERR(mtk_dp->typec_sw))
+		return dev_err_probe(dev, PTR_ERR(mtk_dp->typec_sw),
+				     "failed to register typec switch\n");
+
+	mtk_dp->typec_mux = typec_mux_register(dev, &mux_desc);
+	if (IS_ERR(mtk_dp->typec_mux)) {
+		typec_switch_unregister(mtk_dp->typec_sw);
+		mtk_dp->typec_sw = NULL;
+		return dev_err_probe(dev, PTR_ERR(mtk_dp->typec_mux),
+				     "failed to register typec mux\n");
+	}
+
+	return devm_add_action_or_reset(dev, mtk_dp_typec_unregister, mtk_dp);
+}
