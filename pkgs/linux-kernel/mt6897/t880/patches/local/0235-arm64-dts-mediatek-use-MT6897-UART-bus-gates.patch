From 73ee13cf9bfaedbf3b2f2f28a57c8ce87e5b2f1c Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Wed, 11 Nov 2026 04:25:43 +0800
Subject: [PATCH] arm64: dts: mediatek: use MT6897 UART bus gates

Connect the UART0/1 bus inputs to the existing PERAO gates instead of
substituting a fixed reference clock. Keep the independent baud input at
26 MHz, matching the stock clock wiring.

Link: https://github.com/MiCode/MTK_kernel_device_modules/blob/3c4ccd07d5624879555ec710c11bb8818e5cb5c6/drivers/clk/mediatek/clk-mt6897-peri.c
Signed-off-by: dianqk <dianqk@dianqk.net>
---
 arch/arm64/boot/dts/mediatek/mt6897.dtsi | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6897.dtsi b/arch/arm64/boot/dts/mediatek/mt6897.dtsi
index dbc7c46b8a..ea9529b499 100644
--- a/arch/arm64/boot/dts/mediatek/mt6897.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6897.dtsi
@@ -1131,7 +1131,7 @@ uart0: serial@11001000 {
 			compatible = "mediatek,mt6577-uart";
 			reg = <0x0 0x11001000 0x0 0x1000>;
 			interrupts = <GIC_SPI 250 IRQ_TYPE_LEVEL_HIGH 0>;
-			clocks = <&clk26m>, <&clk26m>;
+			clocks = <&clk26m>, <&pericfg_ao CLK_PERAOP_UART0>;
 			clock-names = "baud", "bus";
 			status = "disabled";
 		};
@@ -1140,7 +1140,7 @@ uart1: serial@11002000 {
 			compatible = "mediatek,mt6577-uart";
 			reg = <0x0 0x11002000 0x0 0x1000>;
 			interrupts = <GIC_SPI 251 IRQ_TYPE_LEVEL_HIGH 0>;
-			clocks = <&clk26m>, <&clk26m>;
+			clocks = <&clk26m>, <&pericfg_ao CLK_PERAOP_UART1>;
 			clock-names = "baud", "bus";
 			status = "disabled";
 		};
-- 
2.56.0

