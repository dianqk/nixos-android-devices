index 0000000000..e519d200e9
--- /dev/null
+++ b/tools/testing/selftests/mtk_ccci/Makefile
@@ -0,0 +1,4 @@
+# SPDX-License-Identifier: GPL-2.0-only
+TEST_PROGS := test_lk_metadata.py
