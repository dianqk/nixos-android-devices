+/* SPDX-License-Identifier: GPL-2.0-only */
+#define __init
+#define CCCI_UTIL_INF_MSG(...) ((void)0)
+#define CCCI_UTIL_ERR_MSG(...) ((void)0)
+#define LK_LOAD_MD_EN 1
+#define LK_LOAD_MD_ERR_LK_INFO_FAIL 8
+#define MD_SYS1 0
+static unsigned s_g_md_usage_case,s_g_md_env_rdy_flag,consumers,fallbacks,unmaps;
+struct device_node {int dummy;};
+struct property {void *value;};
+static struct device_node device_node;
+static struct property property;
+static bool node_present,prop_present,legacy;
+static int prop_len;
+static struct device_node *of_find_compatible_node(void*a,void*b,const char*k) {(void)a;(void)b;return node_present&&!strcmp(k,"mediatek,mddriver")?&device_node:NULL;}
+static const struct property *of_find_property(struct device_node*n,const char*k,int*len) {(void)n;*len=prop_len;return prop_present&&(!strcmp(k,legacy?"ccci,modem_info":"ccci,modem_info_v2"))?&property:NULL;}
+static void of_node_put(struct device_node*n) {(void)n;}
+static void iounmap(void*p) {assert(p==backing);unmaps++;}
+static void mtk_ccci_dump_md_mem_layout(void) {consumers++;}
+static void mtk_ccci_md_smem_layout_init(void) {consumers++;}
+static void md_mem_info_parsing(void) {consumers++;}
+static void dump_retrieve_info(void) {consumers++;}
+static void md_chk_hdr_info_parse(void) {consumers++;}
+static void share_memory_info_parsing(void) {consumers++;}
+static void verify_md_enable_setting(void) {consumers++;}
+static void cal_md_settings(void) {fallbacks++;}
+static void cal_md_settings_v2(struct device_node*n) {(void)n;fallbacks++;}
diff --git a/tools/testing/selftests/mtk_ccci/lk_metadata_stubs.h b/tools/testing/selftests/mtk_ccci/lk_metadata_stubs.h
new file mode 100644
index 0000000000..c1f8fb09f3
--- /dev/null
+++ b/tools/testing/selftests/mtk_ccci/lk_metadata_stubs.h
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include <stdint.h>
+#include <stdbool.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#include <assert.h>
+#include <errno.h>
+typedef uint8_t u8;
+typedef uint32_t u32;
+typedef uint64_t u64;
+typedef int32_t s32;
+#define __iomem
+#define GFP_KERNEL 0
+#define CCCI_ARGS_KEY_SIZE 36
+#define CCCI_ARGS_MAX_KEYS 73
+#define ARGS_KEY_VAL_KEY_SIZE CCCI_ARGS_KEY_SIZE
+#define ARGS_KEY_VAL_MAX_KEY_NUM CCCI_ARGS_MAX_KEYS
+#define ARGS_KEY_VAL_BUF_NUM 8
+#define ARGS_KEY_VAL_BUF_SIZE 4096
+#define MAX_LK_INFO_SIZE 65536
+#define CCCI_TAG_NAME_LEN 16
+#define CCCI_TAG_NAME_LEN_V2 64
+#define CCCI_LK_INFO_VER_V2 2
+#define PAGE_SIZE 4096
+#define U64_MAX UINT64_MAX
+#define IS_ALIGNED(x,a) (!((x)&((a)-1)))
+#define pr_info(...) ((void)0)
+#define LK_LOAD_MD_ERR_NO_MD_LOAD 4
+#define EXPORT_SYMBOL(x)
+enum args_src {FROM_KERNEL,FROM_LK_TAG};
+static unsigned char backing[65536];
+static bool reserve_ok=true,map_fail,alloc_fail;
+static unsigned maps;
+static void *s_g_lk_inf_base;
+static u64 s_g_tag_phy_addr;
+static unsigned s_g_tag_inf_size,s_g_tag_cnt,s_g_lk_info_tag_version,s_g_lk_load_img_status;
+static int s_g_lk_ld_md_errno,lk_load_img_err_no;
+static void *kmalloc(size_t n,int flags) {(void)flags;return malloc(n);}
+static void *kcalloc(size_t n,size_t s,int flags) {(void)flags;return alloc_fail?NULL:calloc(n,s);}
+#define kfree free
+static void memcpy_fromio(void *d,const void *s,size_t n) {
+ assert((uintptr_t)s>=(uintptr_t)backing);
+ assert((uintptr_t)s+n<=(uintptr_t)backing+s_g_tag_inf_size);
+ memcpy(d,s,n);
+}
+static u32 get_unaligned_le32(const void*p) {const u8*b=p;return b[0]|(u32)b[1]<<8|(u32)b[2]<<16|(u32)b[3]<<24;}
+static u64 get_unaligned_le64(const void*p) {return get_unaligned_le32(p)|((u64)get_unaligned_le32((const u8*)p+4)<<32);}
+static bool ccci_lk_reserved_range(u64 base) {(void)base;return reserve_ok;}
+static void *ccci_map_phy_addr(u64 base,unsigned size) {assert(base&&size==65536);maps++;return map_fail?NULL:backing;}
diff --git a/tools/testing/selftests/mtk_ccci/test_lk_metadata.py b/tools/testing/selftests/mtk_ccci/test_lk_metadata.py
new file mode 100755
index 0000000000..3a61a22039
--- /dev/null
+++ b/tools/testing/selftests/mtk_ccci/test_lk_metadata.py
@@ -0,0 +1,43 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Exercise production LK parsers; OF reservation and mapping calls use stubs."""
+from pathlib import Path
+import hashlib,re,os,subprocess,tempfile
+assets=Path(__file__).resolve().parent
+work=tempfile.TemporaryDirectory(prefix='mtk-ccci-lk-')
+out=Path(work.name)
+repo=Path(os.environ.get('KERNEL_SRC',str(assets.parents[3])))
+root=repo/'drivers/misc/mediatek/ccci_util'
+a=(root/'ccci_util_boot_args.c').read_text(); f=(root/'ccci_util_lib_fo.c').read_text()
+def fn(src,n):
+ m=re.search(r'^.*\b'+re.escape(n)+r'\([^;]*?\)\n\{',src,re.M)
+ if not m: raise ValueError(n)
+ start=m.start(); i=m.end(); depth=1
+ while depth:
+  depth+=(src[i]=='{')-(src[i]=='}');i+=1
+ return src[start:i]+'\n'
+parts=[]
+parts.append(a[a.index('struct args_key_val {'):a.index('static int is_key_exist')])
+for n in ['is_key_exist','mtk_ccci_args_count','mtk_ccci_args_has_key','mtk_ccci_args_rollback','mtk_ccci_add_new_args']:
+ parts.append(fn(a,n))
+parts.append(f[f.index('struct _ccci_lk_info {'):f.index('/*====================================================== */',f.index('struct _ccci_lk_info {'))])
+parts.append(f[f.index('struct ccci_checked_tag {'):f.index('int lk_tag_inf_parsing_to_args_table')])
+for n in ['lk_tag_inf_parsing_to_args_table','ccci_lk_map_info','lk_info_parsing_v1','lk_info_parsing_v2']:
+ if n == 'lk_tag_inf_parsing_to_args_table':
+  parts.append('static unsigned append_calls, fail_append;\nstatic int fault_add(const char *k, unsigned char *v, unsigned s, enum args_src src) { if (++append_calls == fail_append) return -EIO; return mtk_ccci_add_new_args(k,v,s,src); }\n#define mtk_ccci_add_new_args fault_add\n')
+  parts.append(fn(f,n))
+  parts.append('#undef mtk_ccci_add_new_args\n')
+ else:
+  parts.append(fn(f,n))
+parts.append((assets/'lk_metadata_flow_stubs.h').read_text())
+for n in ['collect_lk_boot_arguments','ccci_util_fo_init']:
+ parts.append(fn(f,n))
+(out/'production-functions.c').write_text('\n'.join(parts))
+(out/'source.sha256').write_text(''.join(hashlib.sha256((root/n).read_bytes()).hexdigest()+'  '+n+'\n' for n in ['ccci_util_lib_fo.c','ccci_util_boot_args.c','ccci_util_lib_main.c','ccci_util_lib_main.h']))
+(out/'harness.c').write_text((assets/'lk_metadata_stubs.h').read_text()+'\n'+ '\n'.join(parts)+'\n'+(assets/'lk_metadata_cases.h').read_text())
+
+subprocess.run([os.environ.get('CC','cc'),'-std=gnu11','-Wall','-Wextra','-Werror',
+ '-Wno-unused-parameter','-Wno-sign-compare','-fsanitize=address,undefined','-O1',
+ str(out/'harness.c'),'-o',str(out/'harness')],check=True)
+subprocess.run([str(out/'harness')],check=True)
+work.cleanup()
