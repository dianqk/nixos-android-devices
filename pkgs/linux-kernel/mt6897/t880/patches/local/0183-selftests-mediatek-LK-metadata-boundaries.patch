diff --git a/tools/testing/selftests/mtk_ccci/lk_metadata_cases.h b/tools/testing/selftests/mtk_ccci/lk_metadata_cases.h
new file mode 100644
index 0000000000..9822e3a443
--- /dev/null
+++ b/tools/testing/selftests/mtk_ccci/lk_metadata_cases.h
@@ -0,0 +1,75 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+static unsigned scenarios;
+static void reset(void) {
+ memset(backing,0,sizeof backing);memset(s_args_tbl,0,sizeof s_args_tbl);
+ s_args_num=0;s_init_done=1;s_g_lk_inf_base=NULL;s_g_tag_cnt=0;s_g_tag_inf_size=0;
+ s_g_lk_info_tag_version=0;s_g_lk_load_img_status=0;s_g_lk_ld_md_errno=0;lk_load_img_err_no=0;
+ append_calls=fail_append=0;node_present=prop_present=legacy=false;property.value=NULL;prop_len=0;s_g_md_usage_case=s_g_md_env_rdy_flag=consumers=fallbacks=unmaps=0;maps=0;reserve_ok=true;map_fail=alloc_fail=false;scenarios++;
+}
+static void put32(void*p,u32 v) {u8*b=p;for(unsigned i=0;i<4;i++)b[i]=v>>(8*i);}
+static void put64(void*p,u64 v) {put32(p,v);put32((u8*)p+4,v>>32);}
+static void desc(u8*d,u64 base,u32 size,u32 version,u32 count) {
+ memset(d,0,48);put64(d,base);put32(d+8,size);put32(d+16,version);put32(d+20,count);put32(d+24,1);
+}
+static void tag(unsigned off,const char *name,unsigned data,unsigned size,unsigned next) {
+ unsigned ns=s_g_lk_info_tag_version>=2?64:16;
+ memset(backing+off,0,ns+12);assert(strlen(name)<ns);strcpy((char*)backing+off,name);
+ put32(backing+off+ns,data);put32(backing+off+ns+4,size);put32(backing+off+ns+8,next);
+}
+static void setup(unsigned count,unsigned version) {
+ u8 d[48];reset();desc(d,0xbf2f0000,65536,version,count);
+ assert(lk_info_parsing_v2(d,48)==0);assert(maps==1);
+ for(unsigned i=0;i<count;i++){char k[32];snprintf(k,sizeof k,"k%u",i);tag(i*80,k,10000+i,1,(i+1)*80);}
+}
+static void add(const char*k,unsigned v) {assert(mtk_ccci_add_new_args(k,backing+v,1,FROM_LK_TAG)==1);}
+static void reject_unchanged(void) {
+ struct args_key_val before[73];unsigned n=s_args_num;memcpy(before,s_args_tbl,sizeof before);
+ assert(lk_tag_inf_parsing_to_args_table()<0);assert(s_args_num==n);assert(!memcmp(before,s_args_tbl,sizeof before));
+}
+int main(void) {
+ u8 d[48];
+ (void)s_g_tag_phy_addr;(void)s_g_lk_load_img_status;(void)lk_load_img_err_no;
+ for(int len=0;len<32;len++){reset();desc(d,0xbf2f0000,100,3,1);assert(lk_info_parsing_v2(d,len)==-EINVAL);assert(!maps);}
+ for(int len=0;len<16;len++){reset();desc(d,0xbf2f0000,100,3,1);assert(lk_info_parsing_v1(d,len)==-EINVAL);assert(!maps);}
+ for(unsigned v=1;v<=4;v++){setup(2,v);assert(!lk_tag_inf_parsing_to_args_table());assert(s_args_num==2);}
+ setup(2,INT32_MAX);assert(!lk_tag_inf_parsing_to_args_table());
+ reset();desc(d,0xbf2f0000,56,1,2);put32(d+12,2);assert(!lk_info_parsing_v1(d,16));tag(0,"one",0,0,28);tag(28,"two",56,0,UINT32_MAX);assert(!lk_tag_inf_parsing_to_args_table());assert(s_args_num==2);
+ for(unsigned i=0;i<9;i++){
+  reset();desc(d,0xbf2f0000,65536,3,1);
+  switch(i){case 0:put32(d+8,0);break;case 1:put32(d+8,65537);break;case 2:put32(d+20,0);break;case 3:put32(d+20,UINT32_MAX);break;case 4:put32(d+16,0);break;case 5:put32(d+16,UINT32_MAX);break;case 6:put64(d,0xbf2f0001);break;case 7:put64(d,UINT64_MAX-4095);break;case 8:put32(d+20,863);break;}
+  assert(lk_info_parsing_v2(d,48)<0);assert(!maps);
+ }
+ reset();desc(d,0,0,0,0);assert(lk_info_parsing_v2(d,48)==1);assert(!maps);
+ reset();desc(d,0,0,0,0);put32(d+12,1);assert(lk_info_parsing_v2(d,48)==-EINVAL);assert(!maps);
+ reset();desc(d,0,0,0,0);assert(lk_info_parsing_v1(d,16)==1);assert(!maps);
+ reset();desc(d,0xbf2f0000,76,3,1);reserve_ok=false;assert(lk_info_parsing_v2(d,48)==-EINVAL);assert(!maps);
+ reset();desc(d,0xbf2f0000,76,3,1);map_fail=true;assert(lk_info_parsing_v2(d,48)==-ENOMEM);assert(!s_g_lk_inf_base);
+ setup(3,3);add("ap_platform",20000);tag(0,"ap_platform",10000,1,80);tag(80,"same",10001,1,160);tag(160,"same",10002,1,0);assert(!lk_tag_inf_parsing_to_args_table());assert(s_args_num==2);assert(s_args_tbl[0].pdata==backing+20000);assert(s_args_tbl[1].pdata==backing+10001);
+ setup(73,3);assert(!lk_tag_inf_parsing_to_args_table());assert(s_args_num==73);assert(!lk_tag_inf_parsing_to_args_table());assert(s_args_num==73);assert(mtk_ccci_add_new_args("new",backing,1,FROM_LK_TAG)==-ENOSPC);
+ setup(74,3);reject_unchanged();
+ setup(73,3);add("dt",20000);reject_unchanged();
+ setup(74,3);tag(73*80,"k0",10073,1,0);assert(!lk_tag_inf_parsing_to_args_table());assert(s_args_num==73);
+ for(unsigned i=0;i<10;i++){
+  setup(3,3);add("dt",20000);
+  switch(i){case 0:put32(backing+80+72,0);break;case 1:put32(backing+72,65500);break;case 2:put32(backing+160+64,65537);break;case 3:put32(backing+160+68,UINT32_MAX);break;case 4:memset(backing+160,'x',64);break;case 5:backing[160]=0;break;case 6:memset(backing+160,'x',36);backing[196]=0;break;case 7:alloc_fail=true;break;case 8:s_g_tag_cnt=0;break;case 9:s_g_lk_inf_base=NULL;break;}
+  reject_unchanged();
+ }
+ setup(2,3);put32(backing+80+72,UINT32_MAX);assert(!lk_tag_inf_parsing_to_args_table());
+ setup(2,3);put32(backing+80+64,65536);put32(backing+80+68,0);assert(!lk_tag_inf_parsing_to_args_table());
+ setup(2,3);add("dt",20000);assert(!lk_tag_inf_parsing_to_args_table());mtk_ccci_args_rollback(1);assert(s_args_num==1&&mtk_ccci_args_has_key("dt")&&!mtk_ccci_args_has_key("k0"));
+ setup(2,3);s_init_done=0;reject_unchanged();
+ for(unsigned fail=1;fail<=3;fail++){setup(3,3);add("dt",20000);fail_append=fail;reject_unchanged();assert(append_calls==fail);}
+ for(unsigned test=0;test<5;test++) {
+  setup(2,3);s_g_lk_inf_base=NULL;node_present=prop_present=true;property.value=d;prop_len=48;
+  desc(d,0xbf2f0000,65536,3,2);
+  switch(test){case 0:prop_len=0;break;case 1:put64(d,0);break;case 2:put32(backing+80+68,UINT32_MAX);break;case 3:fail_append=2;break;case 4:put32(d+16,0);break;}
+  assert(ccci_util_fo_init()!=0);assert(!consumers&&!fallbacks&&!s_g_md_usage_case&&!s_g_md_env_rdy_flag&&!(s_g_lk_load_img_status&LK_LOAD_MD_EN));assert(!s_args_num);
+ }
+ setup(2,3);s_g_lk_inf_base=NULL;node_present=prop_present=true;property.value=d;prop_len=48;desc(d,0xbf2f0000,65536,3,2);assert(!ccci_util_fo_init());assert(consumers==7&&!fallbacks&&s_args_num==2&&s_g_md_usage_case==1&&(s_g_lk_load_img_status&LK_LOAD_MD_EN));
+ reset();assert(lk_info_parsing_v1(d,-1)==-EINVAL);
+ reset();assert(lk_info_parsing_v2(d,-1)==-EINVAL);
+ reset();assert(lk_info_parsing_v1(NULL,16)==-EINVAL);
+ reset();assert(lk_info_parsing_v2(NULL,32)==-EINVAL);
+ printf("PASS %u scenarios; extracted descriptor, walker, argument functions; ASan/UBSan\n",scenarios);
+ return 0;
+}
