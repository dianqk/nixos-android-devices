From e41df04151dc7ee037ea85d917271de6ff223925 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Fri, 6 Nov 2026 19:28:41 +0800
Subject: [PATCH] selftests: mediatek: exercise LK metadata parsing boundaries

Extract the production descriptor, chain and argument-table functions for host ASan/UBSan tests with deterministic OF and mapping stubs. Cover truncation, malformed ranges and names, duplicate priority, capacity, transaction rollback and disabled/error control flow.

Signed-off-by: dianqk <dianqk@dianqk.net>
---
 tools/testing/selftests/mtk_ccci/Makefile     |  4 +
 .../selftests/mtk_ccci/lk_metadata_cases.h    | 75 +++++++++++++++++++
 .../mtk_ccci/lk_metadata_flow_stubs.h         | 27 +++++++
 .../selftests/mtk_ccci/lk_metadata_stubs.h    | 50 +++++++++++++
 .../selftests/mtk_ccci/test_lk_metadata.py    | 43 +++++++++++
 5 files changed, 199 insertions(+)
 create mode 100644 tools/testing/selftests/mtk_ccci/Makefile
 create mode 100644 tools/testing/selftests/mtk_ccci/lk_metadata_cases.h
 create mode 100644 tools/testing/selftests/mtk_ccci/lk_metadata_flow_stubs.h
 create mode 100644 tools/testing/selftests/mtk_ccci/lk_metadata_stubs.h
 create mode 100755 tools/testing/selftests/mtk_ccci/test_lk_metadata.py

diff --git a/tools/testing/selftests/mtk_ccci/Makefile b/tools/testing/selftests/mtk_ccci/Makefile
