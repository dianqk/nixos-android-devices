+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Exercise MT6897 display PM ownership with extracted production functions."""
+from pathlib import Path
+import os
+import re
+import subprocess
+import tempfile
+
+assets = Path(__file__).resolve().parent
+repo = Path(os.environ.get('KERNEL_SRC', str(assets.parents[3])))
+
+
+def function(source, name):
+    match = re.search(r'^(?:static )?(?:int|void) ' + name + r'\(', source, re.M)
+    start = match.start()
+    end = source.index('{', start) + 1
+    depth = 1
+    while depth:
+        depth += (source[end] == '{') - (source[end] == '}')
+        end += 1
+    return source[start:end]
+
+
+mutex = (repo / 'drivers/soc/mediatek/mtk-mutex.c').read_text()
+mmsys = (repo / 'drivers/soc/mediatek/mtk-mmsys.c').read_text()
+crtc = (repo / 'drivers/gpu/drm/mediatek/mtk_crtc.c').read_text()
+for source, names in [(mutex, ['mt6897_dispsys0_mutex_driver_data',
+                              'mt6897_dispsys1_mutex_driver_data',
+                              'mt6897_ovlsys_mutex_driver_data']),
+                      (mmsys, ['mt6897_dispsys0_driver_data',
+                               'mt6897_dispsys1_driver_data',
+                               'mt6897_ovlsys_driver_data'])]:
+    assert source.count('.runtime_pm = true') == len(names)
+    for name in names:
+        assert '.runtime_pm = true' in source.split(name + ' = {', 1)[1].split('};', 1)[0]
+probe = function(mmsys, 'mtk_mmsys_probe')
+assert probe.index('platform_set_drvdata') < probe.index('devm_pm_runtime_enable') < probe.index('devm_of_platform_populate') < probe.index('"mediatek-drm"')
+assert 'platform_device_unregister(clks)' not in probe
+mutex_probe = function(mutex, 'mtk_mutex_probe')
+assert mutex_probe.index('mtx->dev = dev') < mutex_probe.index('devm_pm_runtime_enable')
+init = function(crtc, 'mtk_crtc_ddp_hw_init')
+assert init.index('mtk_crtc_mutex_prepare') < init.index('mtk_crtc_ddp_clk_enable')
+assert 'for (i = 0; i < mtk_crtc->num_controllers; i++)\n\t\tmtk_mutex_unprepare' in init.split('err_mutex_unprepare:', 1)[1]
+production = '\n'.join([function(mutex, 'mtk_mutex_prepare'),
+                         function(mutex, 'mtk_mutex_unprepare'),
+                         function(crtc, 'mtk_crtc_mutex_prepare')])
+mmsys_production = '\n'.join([function(mmsys, 'mtk_mmsys_probe'),
+                                 function(mmsys, 'mtk_mmsys_remove')])
+for asset, functions in [('display_pm_cases.c', production),
+                         ('mmsys_pm_cases.c', mmsys_production)]:
+    with tempfile.TemporaryDirectory(prefix='mtk-display-pm-') as tmp:
+        tmp = Path(tmp)
+        c = tmp / 'test.c'
+        c.write_text((assets / asset).read_text().replace('/* PRODUCTION */', functions))
+        binary = tmp / 'test'
+        subprocess.run([os.environ.get('CC', 'cc'), '-std=gnu11', '-Wall', '-Wextra',
+                        '-Werror', '-g', '-fsanitize=address,undefined', str(c), '-o',
+                        str(binary)], check=True)
+        subprocess.run([str(binary)], check=True)
