diff --git a/tools/testing/selftests/mtk_clk/display_pm_cases.c b/tools/testing/selftests/mtk_clk/display_pm_cases.c
new file mode 100644
index 0000000000..384a532e97
--- /dev/null
+++ b/tools/testing/selftests/mtk_clk/display_pm_cases.c
@@ -0,0 +1,128 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <assert.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <errno.h>
+#define container_of(ptr, type, member) ((type *)((char *)(ptr) - offsetof(type, member)))
+#define drm_err(dev, ...) ((void)(dev))
+struct device { int id, refs, error; };
+struct clk { int id, refs, error; };
+struct mtk_mutex { int id; };
+struct mtk_mutex_data { bool runtime_pm; };
+struct mtk_mutex_ctx {
+	struct device *dev;
+	struct clk *clk;
+	struct mtk_mutex mutex[3];
+	const struct mtk_mutex_data *data;
+};
+struct mtk_crtc {
+	struct { struct device *dev; } base;
+	int num_controllers;
+	struct mtk_mutex *mutex[3];
+};
+static int events[128], count;
+static int pm_runtime_resume_and_get(struct device *dev)
+{
+	events[count++] = 10 + dev->id;
+	if (dev->error)
+		return dev->error;
+	dev->refs++;
+	return 0;
+}
+static void pm_runtime_put(struct device *dev)
+{
+	events[count++] = -10 - dev->id;
+	assert(dev->refs > 0);
+	dev->refs--;
+}
+static int clk_prepare_enable(struct clk *clk)
+{
+	events[count++] = 20 + clk->id;
+	if (clk->error)
+		return clk->error;
+	clk->refs++;
+	return 0;
+}
+static void clk_disable_unprepare(struct clk *clk)
+{
+	events[count++] = -20 - clk->id;
+	assert(clk->refs > 0);
+	clk->refs--;
+}
+/* PRODUCTION */
+
+static void check_events(const int *expected, int n)
+{
+	assert(count == n);
+	for (int i = 0; i < n; i++)
+		assert(events[i] == expected[i]);
+	count = 0;
+}
+
+int main(void)
+{
+	struct mtk_mutex_data selected = { true }, other = { false };
+	struct device dev[3] = { { .id = 0 }, { .id = 1 }, { .id = 2 } };
+	struct clk clk[3] = { { .id = 0 }, { .id = 1 }, { .id = 2 } };
+	struct mtk_mutex_ctx ctx[3];
+	struct mtk_crtc crtc = { .base.dev = &dev[0], .num_controllers = 3 };
+
+	for (int i = 0; i < 3; i++) {
+		ctx[i] = (struct mtk_mutex_ctx){ .dev = &dev[i], .clk = &clk[i], .data = &selected };
+		for (int j = 0; j < 3; j++)
+			ctx[i].mutex[j].id = j;
+		crtc.mutex[i] = &ctx[i].mutex[i];
+	}
+	dev[0].error = -EIO;
+	assert(mtk_mutex_prepare(crtc.mutex[0]) == -EIO);
+	assert(dev[0].refs == 0 && clk[0].refs == 0);
+	check_events((int[]){ 10 }, 1);
+	dev[0].error = 0;
+	clk[0].error = -ETIMEDOUT;
+	assert(mtk_mutex_prepare(crtc.mutex[0]) == -ETIMEDOUT);
+	assert(dev[0].refs == 0 && clk[0].refs == 0);
+	check_events((int[]){ 10, 20, -10 }, 3);
+	clk[0].error = 0;
+
+	assert(mtk_mutex_prepare(&ctx[0].mutex[0]) == 0);
+	assert(mtk_mutex_prepare(&ctx[0].mutex[1]) == 0);
+	assert(dev[0].refs == 2 && clk[0].refs == 2);
+	mtk_mutex_unprepare(&ctx[0].mutex[1]);
+	assert(dev[0].refs == 1 && clk[0].refs == 1);
+	mtk_mutex_unprepare(&ctx[0].mutex[0]);
+	check_events((int[]){ 10, 20, 10, 20, -20, -10, -20, -10 }, 8);
+
+	for (int clock_failure = 0; clock_failure < 2; clock_failure++) {
+		for (int failed = 0; failed < 3; failed++) {
+			if (clock_failure)
+				clk[failed].error = -EIO;
+			else
+				dev[failed].error = -EIO;
+			assert(mtk_crtc_mutex_prepare(&crtc) == -EIO);
+			for (int i = 0; i < 3; i++)
+				assert(dev[i].refs == 0 && clk[i].refs == 0);
+			/* Failed prepare handles itself; CRTC drops successful prefix. */
+			assert(count == failed * 4 + (clock_failure ? 3 : 1));
+			assert(events[count - 1] == (failed ? -10 : (clock_failure ? -10 : 10)));
+			count = 0;
+			clk[failed].error = 0;
+			dev[failed].error = 0;
+		}
+	}
+	assert(mtk_crtc_mutex_prepare(&crtc) == 0);
+	for (int i = 0; i < 3; i++)
+		mtk_mutex_unprepare(crtc.mutex[i]);
+	for (int i = 0; i < 3; i++)
+		assert(dev[i].refs == 0 && clk[i].refs == 0);
+	count = 0;
+
+	ctx[0].data = &other;
+	dev[0].error = -EIO;
+	assert(mtk_mutex_prepare(crtc.mutex[0]) == 0);
+	mtk_mutex_unprepare(crtc.mutex[0]);
+	assert(dev[0].refs == 0 && clk[0].refs == 0);
+	check_events((int[]){ 20, -20 }, 2);
+	puts("MT6897 mutex PM/clock order, local failures, shared handles and CRTC prefix unwind passed");
+	return 0;
+}
diff --git a/tools/testing/selftests/mtk_clk/mmsys_pm_cases.c b/tools/testing/selftests/mtk_clk/mmsys_pm_cases.c
new file mode 100644
index 0000000000..e64a3491f0
--- /dev/null
+++ b/tools/testing/selftests/mtk_clk/mmsys_pm_cases.c
@@ -0,0 +1,168 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <errno.h>
+#define GFP_KERNEL 0
+#define THIS_MODULE NULL
+#define PLATFORM_DEVID_AUTO 0
+#define IS_ERR(p) ((uintptr_t)(p) > (uintptr_t)-4096)
+#define PTR_ERR(p) ((int)(intptr_t)(p))
+#define ERR_PTR(e) ((void *)(intptr_t)(e))
+#define dev_err(...) ((void)0)
+#define dev_dbg(...) ((void)0)
+#define spin_lock_init(...) ((void)0)
+struct device { void *of_node, *data; };
+struct platform_device { struct device dev; int kind; };
+struct mtk_mmsys_driver_data { int num_resets; bool runtime_pm, is_vppsys; const char *clk_driver; };
+struct mtk_mmsys {
+	void *regs;
+	const struct mtk_mmsys_driver_data *data;
+	struct platform_device *clks_pdev, *drm_pdev;
+	int lock, cmdq_base;
+	struct { void *owner, *ops, *of_node; int nr_resets; } rcdev;
+};
+static int mtk_mmsys_reset_ops;
+static struct mtk_mmsys_driver_data data;
+static struct platform_device clock_child = { .kind = 1 }, drm_child = { .kind = 2 };
+static int events[32], count, failure, pm_enabled, children;
+static void *allocation;
+static void *devm_kzalloc(struct device *dev, size_t size, int flags)
+{
+	(void)dev; (void)flags;
+	if (failure == 1)
+		return NULL;
+	return allocation = calloc(1, size);
+}
+static void *devm_platform_ioremap_resource(struct platform_device *pdev, int index)
+{
+	(void)pdev; (void)index;
+	return failure == 2 ? ERR_PTR(-EIO) : (void *)1;
+}
+static const void *of_device_get_match_data(struct device *dev)
+{
+	(void)dev;
+	return &data;
+}
+static int devm_reset_controller_register(struct device *dev, void *rcdev)
+{
+	(void)dev; (void)rcdev;
+	return 0;
+}
+static int cmdq_dev_get_client_reg(struct device *dev, int *reg, int index)
+{
+	(void)dev; (void)reg; (void)index;
+	return 0;
+}
+static void platform_set_drvdata(struct platform_device *pdev, void *value)
+{
+	pdev->dev.data = value;
+}
+static void *platform_get_drvdata(struct platform_device *pdev)
+{
+	return pdev->dev.data;
+}
+static int devm_pm_runtime_enable(struct device *dev)
+{
+	assert(dev->data);
+	events[count++] = 10;
+	if (failure == 3)
+		return -ENOMEM;
+	pm_enabled = 1;
+	return 0;
+}
+static struct platform_device *platform_device_register_data(struct device *parent,
+	const char *name, int id, const void *payload, size_t size)
+{
+	(void)parent; (void)id; (void)payload; (void)size;
+	if (name[0] == 'c') {
+		events[count++] = 20;
+		return failure == 4 ? ERR_PTR(-EIO) : &clock_child;
+	}
+	assert(!data.runtime_pm || pm_enabled);
+	assert(children);
+	events[count++] = 40;
+	return failure == 6 ? ERR_PTR(-EIO) : &drm_child;
+}
+static void platform_device_unregister(struct platform_device *pdev)
+{
+	assert(pdev == &clock_child || pdev == &drm_child);
+	assert(!data.runtime_pm || pm_enabled);
+	events[count++] = pdev == &clock_child ? -20 : -40;
+}
+static int devm_of_platform_populate(struct device *dev)
+{
+	(void)dev;
+	assert(!data.runtime_pm || pm_enabled);
+	events[count++] = 30;
+	if (failure == 5)
+		return -EIO;
+	children = 1;
+	return 0;
+}
+/* PRODUCTION */
+
+/* Model the documented reverse managed-action release ordering. */
+static void release_managed(void)
+{
+	if (children) {
+		assert(!data.runtime_pm || pm_enabled);
+		events[count++] = -30;
+		children = 0;
+	}
+	if (pm_enabled) {
+		events[count++] = -10;
+		pm_enabled = 0;
+	}
+	free(allocation);
+	allocation = NULL;
+}
+static void reset(void)
+{
+	assert(!allocation && !pm_enabled && !children);
+	count = 0;
+	failure = 0;
+	data = (struct mtk_mmsys_driver_data){ .runtime_pm = true };
+}
+int main(void)
+{
+	struct platform_device pdev = { 0 };
+
+	for (failure = 1; failure <= 6; failure++) {
+		int point = failure;
+		data = (struct mtk_mmsys_driver_data){ .runtime_pm = true };
+		if (point == 4)
+			data.clk_driver = "clock";
+		assert(mtk_mmsys_probe(&pdev) < 0);
+		release_managed();
+		assert(!pm_enabled && !children);
+		count = 0;
+	}
+	reset();
+	assert(mtk_mmsys_probe(&pdev) == 0);
+	assert(pm_enabled && children);
+	mtk_mmsys_remove(&pdev);
+	release_managed();
+	assert(count == 6);
+	assert(events[0] == 10 && events[1] == 30 && events[2] == 40);
+	assert(events[3] == -40 && events[4] == -30 && events[5] == -10);
+	reset();
+	data = (struct mtk_mmsys_driver_data){ .clk_driver = "clock" };
+	assert(mtk_mmsys_probe(&pdev) == 0);
+	mtk_mmsys_remove(&pdev);
+	release_managed();
+	assert(!pm_enabled);
+	assert(count == 6);
+	assert(events[0] == 20 && events[1] == 30 && events[2] == 40);
+	assert(events[3] == -40 && events[4] == -20 && events[5] == -30);
+	reset();
+	data.is_vppsys = true;
+	assert(mtk_mmsys_probe(&pdev) == 0);
+	mtk_mmsys_remove(&pdev);
+	release_managed();
+	assert(count == 4 && events[2] == -30 && events[3] == -10);
+	puts("MMSYS production probe/remove failure cleanup and managed PM/child ordering passed");
+	return 0;
+}
