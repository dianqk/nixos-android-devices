--- /dev/null
+++ b/tools/testing/selftests/mtk_vcp/test_external_domain.py
@@ -0,0 +1,77 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Exercise actual SCPSYS external-parent probe logic and reverse cleanup."""
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+repo = Path(__file__).resolve().parents[4]
+source = (repo / 'drivers/pmdomain/mediatek/mtk-pm-domains.c').read_text()
+start = source.index('\t/* Resolve an external parent before publishing')
+end = source.index('\n\tdevm_kfree(dev, added_pds_idx);', start)
+probe = source[start:end]
+start = source.index('static void scpsys_domain_cleanup(')
+end = source.index('static int scpsys_get_bus_protection_legacy', start)
+cleanup = source[start:end]
+mocks = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <errno.h>
+#define EPROBE_DEFER 517
+typedef uint8_t u8;
+struct device {void *pm_domain;}; struct device_node {};
+struct generic_pm_domain {int id;};
+struct scpsys_domain {struct generic_pm_domain genpd;};
+struct genpd_onecell_data {struct generic_pm_domain *domains[11];};
+struct scpsys {struct genpd_onecell_data pd_data;};
+static bool child_present, detach_failure, linked, started_attached;
+static int children, parents, helper_result, publish_result;
+static int detach_calls, helper_calls, publish_calls, removed[2], removed_count;
+static bool of_property_present(struct device_node *n,const char *s){return child_present;}
+static int of_property_count_u32_elems(struct device_node *n,const char *s){return children;}
+static int of_count_phandle_with_args(struct device_node *n,const char *s,const char *a){return parents;}
+static int of_genpd_add_child_ids(struct device_node *n,struct genpd_onecell_data *d){helper_calls++;if(helper_result>0)linked=true;return helper_result;}
+static void dev_pm_domain_detach(struct device *d,bool off){if(!d->pm_domain)return;detach_calls++;assert(linked);if(!detach_failure)d->pm_domain=0;}
+static int of_genpd_add_provider_onecell(struct device_node *n,struct genpd_onecell_data *d){publish_calls++;assert(helper_result<=0||detach_calls==(started_attached?1:0));return publish_result;}
+#define dev_err(...) ((void)0)
+#define to_scpsys_domain(x) ((struct scpsys_domain *)(x))
+static void scpsys_remove_one_domain(struct scpsys_domain *p){assert(removed_count<2);removed[removed_count++]=p->genpd.id;if(p->genpd.id==9){assert(removed_count==2&&removed[0]==10);linked=false;}}
+'''
+function = '''
+static int attempt(struct device *dev,struct device_node *np,struct scpsys *scpsys) {
+ int ret;u8 added_pds_idx[]={9,10};u8 num_added_pds=2;
+''' + probe + '''
+ return 0;
+err_cleanup_domains:
+ scpsys_domain_cleanup(scpsys,added_pds_idx,num_added_pds);
+ return ret;
+}
+'''
