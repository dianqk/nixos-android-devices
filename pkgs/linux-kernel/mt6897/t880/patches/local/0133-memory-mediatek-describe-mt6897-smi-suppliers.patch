+/*
+ * MT6897 display larbs, values from the vendor bandwidth-limit table
+ * (MiCode 3c4ccd07 mtk-smi.c). larb32/33 have no ID below 32: they use the
+ * free compact IDs 6 and 10 ("mediatek,larb-id").
+ */
+static const u8 mtk_smi_larb_mt6897_ostd[][SMI_LARB_PORT_NR_MAX] = {
+	[0] = {0x08, 0x30, 0x30, 0x08, 0x30, 0x30, 0x14, 0x01,},  /* larb0 */
+	[1] = {0x08, 0x30, 0x30, 0x08, 0x30, 0x30, 0x14, 0x01,},  /* larb1 */
+	[6] = {0x01, 0x05, 0x06, 0x06, 0x06, 0x0a, 0x0a,},        /* larb32 */
+	[10] = {0x02, 0x0a, 0x06, 0x06, 0x06, 0x14, 0x14,},       /* larb33 */
+	[20] = {0x08, 0x30, 0x30, 0x08, 0x30, 0x30, 0x14, 0x01,}, /* larb20 */
+	[21] = {0x08, 0x30, 0x30, 0x08, 0x30, 0x30, 0x14, 0x01,}, /* larb21 */
+};
+
+/* MT6897 vendor mtk-smi.c 3c4ccd07: decoder larbs have no local clocks.
+ * Keep their transport and PM links; do not invent display clock aliases.
+ */
+static const u8 mtk_smi_larb_mt6897_vdec_ostd[][SMI_LARB_PORT_NR_MAX] = {
+	[4] = {0x40, 0x40, 0x22, 4, 1, 1, 1, 1, 3, 3, 0xa},
+	[5] = {2, 2, 0xa, 0x40, 1, 1, 3, 0x2d, 0x17},
+};
+static int mtk_smi_larb_config_mt6897_vdec(struct device *dev)
+{
+	struct mtk_smi_larb *larb = dev_get_drvdata(dev);
+	unsigned int i, ports = larb->larbid == 4 ? 11 : 9;
+	int ret;
+
+	if (larb->larbid != 4 && larb->larbid != 5)
+		return -EINVAL;
+	writel(larb->larbid == 4 ? 0x370256 : 0x370223, larb->base + 0x24);
+	writel(0x370223, larb->base + 0x524);
+	writel(1, larb->base + 0x40);
+	writel(0xffffffff, larb->base + 0x70);
+	ret = mtk_smi_larb_config_port_gen2_general(dev);
+	if (ret)
+		return ret;
+	for (i = 0; i < ports; i++)
+		writel(readl(larb->base + SMI_LARB_NONSEC_CON(i)) | BIT(3),
+		       larb->base + SMI_LARB_NONSEC_CON(i));
+	wmb();
+	return 0;
+}
+static const struct mtk_smi_larb_gen mtk_smi_larb_mt6897_vdec = {
+	.config_port = mtk_smi_larb_config_mt6897_vdec,
+	.ostd = mtk_smi_larb_mt6897_vdec_ostd,
+	.clockless = true,
+};
+
+/* MT6897 vendor mtk-smi.c: VENC larbs 7/8 each have 32 ports and
+ * unconditional DRAM and SYSRAM fabric suppliers. No sleep handshake. */
+#define MT6897_VENC_OSTD { \
+	0x20, 4, 7, 1, 1, 0x1b, 0x1b, 7, 4, 1, 1, 8, 8, 8, 3, 8, \
+	3, 3, 5, 0xd, 0xd, 4, 2, 8, 0xb, 3, 4, 8, 5, 1, 1, 7 }
+static const u8 mtk_smi_larb_mt6897_venc_ostd[][SMI_LARB_PORT_NR_MAX] = {
+	[7] = MT6897_VENC_OSTD,
+	[8] = MT6897_VENC_OSTD,
+};
+static int mtk_smi_larb_config_mt6897_venc(struct device *dev)
+{
+	struct mtk_smi_larb *larb = dev_get_drvdata(dev);
+	unsigned int i;
+	int ret;
+	if (larb->larbid != 7 && larb->larbid != 8)
+		return -EINVAL;
+	writel(0x370223, larb->base + SMI_LARB_CMD_THRT_CON);
+	writel(larb->larbid == 7 ? 0x370256 : 0x370223,
+	       larb->base + SMI_LARB_INT_CMD_THRT_CON);
+	writel(1, larb->base + 0x40);
+	writel(0xffffffff, larb->base + 0x70);
+	ret = mtk_smi_larb_config_port_gen2_general(dev);
+	if (ret)
+		return ret;
+	for (i = 0; i < 32; i++)
+		writel(readl(larb->base + SMI_LARB_NONSEC_CON(i)) | BIT(3),
+		       larb->base + SMI_LARB_NONSEC_CON(i));
+	wmb();
+	return 0;
+}
+static const struct mtk_smi_larb_gen mtk_smi_larb_mt6897_venc = {
+	.config_port = mtk_smi_larb_config_mt6897_venc,
+	.ostd = mtk_smi_larb_mt6897_venc_ostd,
+	.suppliers = 2,
+};
+
+static const struct mtk_smi_larb_gen mtk_smi_larb_mt6897 = {
+	.config_port                = mtk_smi_larb_config_port_gen2_general,
+	.flags_general	            = MTK_SMI_FLAG_THRT_UPDATE | MTK_SMI_FLAG_SW_FLAG |
+				      MTK_SMI_FLAG_SLEEP_CTL,
+	.ostd		            = mtk_smi_larb_mt6897_ostd,
+};
+
 static const struct mtk_smi_larb_gen mtk_smi_larb_mt8195 = {
 	.config_port                = mtk_smi_larb_config_port_gen2_general,
 	.flags_general	            = MTK_SMI_FLAG_THRT_UPDATE | MTK_SMI_FLAG_SW_FLAG |
@@ -558,11 +654,14 @@ static const struct mtk_smi_larb_gen mtk_smi_larb_mt8195 = {
 };
 
