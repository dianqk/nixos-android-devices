+/* MT6897 bus selection values from the vendor driver (MiCode 3c4ccd07) */
+static const struct mtk_smi_common_plat mtk_smi_common_mt6897_disp = {
+	.type     = MTK_SMI_GEN2,
+	.has_gals = true,
+	.bus_sel  = 0x4444,
+	.init     = mtk_smi_common_mt8195_init,
+};
+
+static const struct mtk_smi_common_plat mtk_smi_common_mt6897_mdp = {
+	.type     = MTK_SMI_GEN2,
+	.has_gals = true,
+	.bus_sel  = 0x5104,
+	.init     = mtk_smi_common_mt8195_init,
+};
+
+/* MT6897 vendor common IDs 8/9: preserve their supplier topology and
+ * all four clocks. Unlike a full common these blocks have no BUS_SEL write.
+ * MiCode MTK_kernel_device_modules 3c4ccd07, mtk_smi_common_mt6897_misc.
+ */
+#define MT6897_VCP_SUB_INIT(mask) \
+	{0x104, 0}, {0x108, 0}, {0x10c, 0}, {0x110, 0}, \
+	{0x114, 0}, {0x118, 0}, {0x11c, 0}, {0x120, 0}, \
+	{SMI_L1LEN, 0xa}, {0x244, mask}, {SMI_DUMMY, 1}
+static const struct mtk_smi_reg_pair mt6897_mmsram_init[] = {
+	MT6897_VCP_SUB_INIT(0x2105),
+};
+static const struct mtk_smi_reg_pair mt6897_mdp_sub_init[] = {
+	MT6897_VCP_SUB_INIT(0x2146),
+};
+/* Vendor common ID 2, supplied by MMSRAM subcommons 7 and 8. */
+static const struct mtk_smi_reg_pair mt6897_sysram_init[] = {
+	{0x104, 0}, {0x108, 0}, {0x10c, 0}, {0x110, 0},
+	{0x114, 0}, {0x118, 0}, {0x11c, 0}, {0x120, 0},
+	{SMI_L1LEN, 2}, {SMI_DCM, 0x4f1}, {SMI_DUMMY, 1},
+};
+static const struct mtk_smi_common_plat mtk_smi_sysram_mt6897 = {
+	.type = MTK_SMI_GEN2,
+	.has_gals = true,
+	.suppliers = 2,
+	.bus_sel = 0x4101,
+	.init = mt6897_sysram_init,
+	.init_nr = ARRAY_SIZE(mt6897_sysram_init),
+};
+static const struct mtk_smi_common_plat mtk_smi_mmsram_mt6897 = {
+	.type = MTK_SMI_GEN2_SUB_COMM,
+	.has_gals = true,
+	.no_parent = true,
+	.required_clks = 4,
+	.init = mt6897_mmsram_init,
+	.init_nr = ARRAY_SIZE(mt6897_mmsram_init),
+};
+static const struct mtk_smi_common_plat mtk_smi_mdp_sub_mt6897 = {
+	.type = MTK_SMI_GEN2_SUB_COMM,
+	.has_gals = true,
+	.required_clks = 4,
+	.init = mt6897_mdp_sub_init,
+	.init_nr = ARRAY_SIZE(mt6897_mdp_sub_init),
+};
+
+static const struct mtk_smi_common_plat mtk_smi_sub_common_mt6897 = {
+	.type     = MTK_SMI_GEN2_SUB_COMM,
+	.has_gals = true,
+};
