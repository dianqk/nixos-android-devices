+	{.compatible = "mediatek,mt6897-smi-vdec-larb", .data = &mtk_smi_larb_mt6897_vdec},
+	{.compatible = "mediatek,mt6897-smi-venc-larb", .data = &mtk_smi_larb_mt6897_venc},
 	{.compatible = "mediatek,mt2701-smi-larb", .data = &mtk_smi_larb_mt2701},
 	{.compatible = "mediatek,mt2712-smi-larb", .data = &mtk_smi_larb_mt2712},
 	{.compatible = "mediatek,mt6779-smi-larb", .data = &mtk_smi_larb_mt6779},
 	{.compatible = "mediatek,mt6795-smi-larb", .data = &mtk_smi_larb_mt8173},
 	{.compatible = "mediatek,mt6893-smi-larb", .data = &mtk_smi_larb_mt6893},
+	{.compatible = "mediatek,mt6897-smi-larb", .data = &mtk_smi_larb_mt6897},
 	{.compatible = "mediatek,mt8167-smi-larb", .data = &mtk_smi_larb_mt8167},
 	{.compatible = "mediatek,mt8173-smi-larb", .data = &mtk_smi_larb_mt8173},
 	{.compatible = "mediatek,mt8183-smi-larb", .data = &mtk_smi_larb_mt8183},
@@ -594,42 +693,86 @@ static void mtk_smi_larb_sleep_ctrl_disable(struct mtk_smi_larb *larb)
 	writel_relaxed(0, larb->base + SMI_LARB_SLP_CON);
 }
 
-static int mtk_smi_device_link_common(struct device *dev, struct device **com_dev)
-{
-	struct platform_device *smi_com_pdev;
-	struct device_node *smi_com_node;
-	struct device *smi_com_dev;
+struct mtk_smi_supplier {
+	struct device *dev;
 	struct device_link *link;
+};
+static void mtk_smi_supplier_release(void *data)
+{
+	struct mtk_smi_supplier *supplier = data;
+	device_link_del(supplier->link);
+	put_device(supplier->dev);
+}
 
-	smi_com_node = of_parse_phandle(dev->of_node, "mediatek,smi", 0);
-	if (!smi_com_node)
-		return -EINVAL;
+static int mtk_smi_device_link_common(struct device *dev, struct device **com_dev,
+				      unsigned int maximum)
+{
+	struct device_node *nodes[2] = {};
+	void *group;
+	int count, i, ret = 0;
 
-	smi_com_pdev = of_find_device_by_node(smi_com_node);
-	of_node_put(smi_com_node);
-	if (!smi_com_pdev) {
-		dev_err(dev, "Failed to get the smi_common device\n");
+	*com_dev = NULL;
+	count = of_count_phandle_with_args(dev->of_node, "mediatek,smi", NULL);
+	if (count < 1 || count > maximum || count > ARRAY_SIZE(nodes))
 		return -EINVAL;
+	for (i = 0; i < count; i++) {
+		nodes[i] = of_parse_phandle(dev->of_node, "mediatek,smi", i);
+		if (!nodes[i] || nodes[i] == dev->of_node ||
+		    (i && nodes[i] == nodes[0])) {
+			ret = -EINVAL;
+			goto put_nodes;
+		}
 	}
-
-	/* smi common is the supplier, Make sure it is ready before */
-	if (!platform_get_drvdata(smi_com_pdev)) {
-		put_device(&smi_com_pdev->dev);
-		return -EPROBE_DEFER;
+	group = devres_open_group(dev, NULL, GFP_KERNEL);
+	if (!group) {
+		ret = -ENOMEM;
+		goto put_nodes;
 	}
+	for (i = 0; i < count; i++) {
+		struct platform_device *pdev = of_find_device_by_node(nodes[i]);
+		struct mtk_smi_supplier *supplier;
 
-	smi_com_dev = &smi_com_pdev->dev;
-	link = device_link_add(dev, smi_com_dev,
-			       DL_FLAG_PM_RUNTIME | DL_FLAG_STATELESS);
-	if (!link) {
-		dev_err(dev, "Unable to link smi-common dev\n");
-		put_device(&smi_com_pdev->dev);
-		return -ENODEV;
+		if (!pdev) {
+			ret = -EPROBE_DEFER;
+			goto release;
+		}
+		if (!platform_get_drvdata(pdev)) {
+			put_device(&pdev->dev);
+			ret = -EPROBE_DEFER;
+			goto release;
+		}
+		supplier = devm_kzalloc(dev, sizeof(*supplier), GFP_KERNEL);
+		if (!supplier) {
+			put_device(&pdev->dev);
+			ret = -ENOMEM;
+			goto release;
+		}
+		supplier->dev = &pdev->dev;
+		supplier->link = device_link_add(dev, supplier->dev,
+				DL_FLAG_PM_RUNTIME | DL_FLAG_STATELESS);
+		if (!supplier->link) {
+			put_device(supplier->dev);
+			ret = -ENODEV;
+			goto release;
+		}
+		ret = devm_add_action_or_reset(dev, mtk_smi_supplier_release, supplier);
+		if (ret)
+			goto release;
+		/* Keep the primary identity used by existing register queries.
+		 * The managed supplier action owns its reference and link. */
+		if (!i)
+			*com_dev = supplier->dev;
 	}
-
-	*com_dev = smi_com_dev;
-
-	return 0;
+	devres_close_group(dev, group);
+	devres_remove_group(dev, group);
+	goto put_nodes;
+release:
+	devres_release_group(dev, group);
+	*com_dev = NULL;
+put_nodes:
+	for (i = 0; i < ARRAY_SIZE(nodes); i++)
+		of_node_put(nodes[i]);
+	return ret;
 }
 
