+			clocks = <&dispsys1_config CLK_DISPSYS1_DISP_DSI0>,
+				 <&dispsys1_config CLK_DISPSYS1_DSI_CLK>,
+				 <&mipi_tx1>;
+			clock-names = "engine", "digital", "hs";
+			power-domains = <&hwv_pd MT6897_POWER_DOMAIN_HWV_DIS1>;
+			phys = <&mipi_tx1>;
+			phy-names = "dphy";
+			trigger-sources = <&dispsys1_mutex 20>;
+			mediatek,dual-dsi-master = <&dsi0>;
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+					#address-cells = <1>;
+					#size-cells = <0>;
+
+					dsi1_in: endpoint@2 {
+						reg = <2>;
+						remote-endpoint = <&dispsys1_dl_relay_in2>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+
+					dsi1_out: endpoint {
+						remote-endpoint = <&panel_in1>;
+					};
+				};
+			};
+		};
+	};
+};
+
+/* The MM gate controllers vote through the hardware voter */
+&dispsys0_config {
+	mediatek,hardware-voter = <&hwv>;
+	power-domains = <&hwv_pd MT6897_POWER_DOMAIN_HWV_DIS0>;
+};
+
+&dispsys1_config {
+	mediatek,hardware-voter = <&hwv>;
+	power-domains = <&hwv_pd MT6897_POWER_DOMAIN_HWV_DIS1>;
+};
+
+&ovlsys0_config {
+	mediatek,hardware-voter = <&hwv>;
+	power-domains = <&hwv_pd MT6897_POWER_DOMAIN_HWV_OVL0>;
+};
+
+&ovlsys1_config {
+	mediatek,hardware-voter = <&hwv>;
+	power-domains = <&hwv_pd MT6897_POWER_DOMAIN_HWV_OVL1>;
+};
+
+&mminfra_config {
+	mediatek,hardware-voter = <&hwv>;
+	power-domains = <&hwv_pd MT6897_POWER_DOMAIN_HWV_MM_INFRA>;
+};
+
+/* TVDPLL, the DisplayPort pixel clock source, is voted through it too */
+&apmixedsys {
+	mediatek,hardware-voter = <&hwv>;
+};
