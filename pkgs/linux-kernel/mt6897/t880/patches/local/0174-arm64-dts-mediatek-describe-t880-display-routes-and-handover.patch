+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Alldocube iPlay 80 mini Ultra (T880): OVL_2L ports on the MM IOMMUs.
+ *
+ * Do not include this from the default board DTS until translated scanout
+ * is verified. Nonidentity software mappings alone do not establish correct
+ * display fetching; whether a display address-mode transition is needed
+ * remains unverified.
+ *
+ * The disp and mdp IOMMUs share one page table and IOVA space. disp owns
+ * larb0 and larb21, mdp owns larb1 and larb20. Each OVL lists only ports
+ * behind one IOMMU: the layer-1 (RDMA1) port behind the other IOMMU is
+ * listed on a sibling OVL of the same OVLSYS instead of its own fetcher.
+ */
+
+#include <dt-bindings/memory/mediatek,mt6897-memory-port.h>
+
+/* OVLSYS0 */
+&ovlsys0_ovl0 {
+	iommus = <&disp_iommu M4U_L0_P0_DISP_OVL0_2L_HDR>,
+		 <&disp_iommu M4U_L0_P1_DISP_OVL0_2L_RDMA0>,
+		 <&disp_iommu M4U_L0_P2_DISP_OVL1_2L_RDMA1>;
+};
+
+&ovlsys0_ovl1 {
+	iommus = <&mdp_iommu M4U_L1_P0_DISP_OVL0_2L_RDMA1>,
+		 <&mdp_iommu M4U_L1_P1_DISP_OVL1_2L_HDR>,
+		 <&mdp_iommu M4U_L1_P2_DISP_OVL1_2L_RDMA0>,
+		 <&mdp_iommu M4U_L1_P3_DISP_OVL2_2L_RDMA1>;
+};
+
+&ovlsys0_ovl2 {
+	iommus = <&disp_iommu M4U_L0_P3_DISP_OVL2_2L_HDR>,
+		 <&disp_iommu M4U_L0_P4_DISP_OVL2_2L_RDMA0>;
+};
+
+/* OVLSYS1 */
+&ovlsys1_ovl0 {
+	iommus = <&mdp_iommu M4U_L20_P0_DISP1_OVL0_2L_HDR>,
+		 <&mdp_iommu M4U_L20_P1_DISP1_OVL0_2L_RDMA0>,
+		 <&mdp_iommu M4U_L20_P2_DISP1_OVL1_2L_RDMA1>;
+};
+
+&ovlsys1_ovl1 {
+	iommus = <&disp_iommu M4U_L21_P0_DISP1_OVL0_2L_RDMA1>,
+		 <&disp_iommu M4U_L21_P1_DISP1_OVL1_2L_HDR>,
+		 <&disp_iommu M4U_L21_P2_DISP1_OVL1_2L_RDMA0>,
+		 <&disp_iommu M4U_L21_P3_DISP1_OVL2_2L_RDMA1>;
+};
+
+&ovlsys1_ovl2 {
+	iommus = <&mdp_iommu M4U_L20_P3_DISP1_OVL2_2L_HDR>,
+		 <&mdp_iommu M4U_L20_P4_DISP1_OVL2_2L_RDMA0>;
+};
