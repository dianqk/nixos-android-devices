index 0000000000..0d4db7847e
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt6897-alldocube-t880-cmdq.dtsi
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Alldocube iPlay 80 mini Ultra (T880): mediatek-drm applies plane and
+ * size updates through the GCE-D (CMDQ) in the vertical blank. Without
+ * this file mediatek-drm writes the registers from the vblank interrupt.
+ *
+ * CRTC 0 (both pipes) is created by DISPSYS0, so its channel is the first
+ * "mboxes" entry of dispsys0 and its event the first "mediatek,gce-events"
+ * entry of the DISPSYS0 MuteX node. Thread 0 at priority 4 is the thread
+ * Android gives to the primary display configuration (CLIENT_CFG0).
+ * In video mode Android waits for the DSI0 frame done ("disp_dsi0_eof",
+ * event 451) before it applies the primary display configuration.
+ * The OVLSYS blocks have no GCE subsys: their writes go by address.
+ */
+
+#include <dt-bindings/gce/mediatek,mt6897-gce.h>
+
+&gce {
+	status = "okay";
+};
+
+&dispsys0 {
+	mboxes = <&gce 0 CMDQ_THR_PRIO_4>;
+};
+
+&dispsys0_mutex {
+	mediatek,gce-events = <CMDQ_EVENT_DISPSYS_DISP_DSI0_FRAME_DONE>;
+};
diff --git a/arch/arm64/boot/dts/mediatek/mt6897-alldocube-t880-display-va.dtsi b/arch/arm64/boot/dts/mediatek/mt6897-alldocube-t880-display-va.dtsi
new file mode 100644
index 0000000000..af203e0eb7
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt6897-alldocube-t880-display-va.dtsi
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+#include <dt-bindings/memory/mediatek,mt6897-memory-port.h>
+#include <dt-bindings/gce/mediatek,mt6897-gce.h>
+
+&{/reserved-memory} {
+	cmdq_reserved: lk-reserved@33fe00000 {
+		reg = <0x3 0x3fe00000 0x0 0x100000>;
+		no-map;
+	};
+};
+
+&{/soc} {
+	display_va: display-va-bootstrap@14405000 {
+		compatible = "mediatek,mt6897-display-va-bootstrap";
+		reg = <0x0 0x14405000 0x0 0x1000>,
+		      <0x0 0x14605000 0x0 0x1000>,
+		      <0x0 0x14015000 0x0 0x1000>,
+		      <0x0 0x14215000 0x0 0x1000>;
+		reg-names = "ovl3", "ovl7", "postmask0", "postmask1";
+		mboxes = <&gce 2 CMDQ_THR_PRIO_4>;
+		power-domains = <&hwv_pd MT6897_POWER_DOMAIN_HWV_MM_INFRA>;
+		clocks = <&mminfra_config CLK_MMINFRA_GCE_D>,
+			 <&mminfra_config CLK_MMINFRA_GCE_26M>,
+			 <&ovlsys0_config CLK_OVLSYS0_OVL0_2L>,
+			 <&ovlsys0_config CLK_OVLSYS0_OVL1_2L>,
+			 <&ovlsys0_config CLK_OVLSYS0_OVL2_2L>,
+			 <&ovlsys0_config CLK_OVLSYS0_OVL3_2L>,
+			 <&ovlsys1_config CLK_OVLSYS1_OVL0_2L>,
+			 <&ovlsys1_config CLK_OVLSYS1_OVL1_2L>,
+			 <&ovlsys1_config CLK_OVLSYS1_OVL2_2L>,
+			 <&ovlsys1_config CLK_OVLSYS1_OVL3_2L>,
+			 <&dispsys0_config CLK_DISPSYS0_DISP_POSTMASK0>,
+			 <&dispsys1_config CLK_DISPSYS1_DISP_POSTMASK0>;
+		clock-names = "gce", "gce-timer", "ovl0", "ovl1", "ovl2", "ovl3",
+			      "ovl4", "ovl5", "ovl6", "ovl7", "postmask0", "postmask1";
+		memory-region = <&lk_framebuffer>, <&cmdq_reserved>;
+		memory-region-names = "framebuffer", "cmdq";
+		mediatek,ovls = <&ovlsys0_ovl0>, <&ovlsys0_ovl1>, <&ovlsys0_ovl2>,
+			       <&ovlsys1_ovl0>, <&ovlsys1_ovl1>, <&ovlsys1_ovl2>;
+		mediatek,suppliers = <&disp_iommu>, <&mdp_iommu>,
+			<&smi_larb0>, <&smi_larb1>, <&smi_larb20>, <&smi_larb21>,
+			<&smi_larb32>, <&smi_larb33>,
+			<&smi_disp_common>, <&smi_mdp_common>,
+			<&smi_disp0_dram>, <&smi_disp1_dram>;
+	};
+};
+
+&dispsys0 { mediatek,display-va-bootstrap = <&display_va>; };
+&dispsys1 { mediatek,display-va-bootstrap = <&display_va>; };
+&ovlsys0 { mediatek,display-va-bootstrap = <&display_va>; };
+&ovlsys1 { mediatek,display-va-bootstrap = <&display_va>; };
+
+#include "mt6897-alldocube-t880-ovl-iommus.dtsi"
diff --git a/arch/arm64/boot/dts/mediatek/mt6897-alldocube-t880-mtkdrm.dtsi b/arch/arm64/boot/dts/mediatek/mt6897-alldocube-t880-mtkdrm.dtsi
new file mode 100644
index 0000000000..a6bef2edb8
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt6897-alldocube-t880-mtkdrm.dtsi
@@ -0,0 +1,1021 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Alldocube iPlay 80 mini Ultra (T880): mediatek-drm on both display pipes
+ * simple-framebuffer stays as the boot console; mediatek-drm takes it over
+ * through the aperture helpers.
+ *
+ * Paths (endpoint number = CRTC path):
+ *  0  OVLSYS0 [OVL0_2L, OVL1_2L, OVL2_2L, DLO relay 3]
+ *     -> DISPSYS0 [DLI 0, (PQ bypass), DSC core 0, DSI0]
+ *  1  OVLSYS1 [OVL4_2L, OVL5_2L, OVL6_2L, DLO relay 3]
+ *     -> DISPSYS1 [DLI 0, (PQ bypass), DLO 0]
+ *     -> DISPSYS0 [DLI 4, DSC core 1, DLO 1]
+ *  2  DISPSYS1 [DLI 5, DSI1]
+ *  3  OVLSYS0 [OVL3_2L, DLO relay 5]
+ *     -> DISPSYS0 [DLI 2, (PQ bypass), DP_INTF0] -> DP TX (Type-C)
+ * Paths 1 and 2 are shadow paths of CRTC 0: OVL4 is OVL0's twin, DSI1 is
+ * DSI0's dual-DSI slave. Path 3 is CRTC 1, DisplayPort.
+ *
+ * Without IOMMU: the larbs stay in the bypass LK leaves, so the OVLs scan
+ * physical addresses (34-bit).
+ */
+
+#include <dt-bindings/phy/phy.h>
+#include <dt-bindings/power/mediatek,mt6897-power.h>
+
+/ {
+	aliases {
+		ovl-2l0 = &ovlsys0_ovl0;
+		ovl-2l1 = &ovlsys0_ovl1;
+		ovl-2l2 = &ovlsys0_ovl2;
+		ovl-2l4 = &ovlsys1_ovl0;
+		ovl-2l5 = &ovlsys1_ovl1;
+		ovl-2l6 = &ovlsys1_ovl2;
+		dsc0 = &disp_dsc0;
+		dsc1 = &disp_dsc1;
+		dsi0 = &dsi0;
+		dsi1 = &dsi1;
+		ovl-2l3 = &ovlsys0_ovl3;
+		dp-intf0 = &dp_intf0;
+	};
+
+	/* Panel supplies: GPIO-switched, on as LK leaves them */
+	panel_vddio: regulator-panel-vddio {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_vddio";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&pio 49 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+	};
+
+	panel_vsp: regulator-panel-vsp {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_vsp";
+		regulator-min-microvolt = <5700000>;
+		regulator-max-microvolt = <5700000>;
+		gpio = <&pio 25 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+	};
+
+	panel_vsn: regulator-panel-vsn {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_vsn";
+		regulator-min-microvolt = <5700000>;
+		regulator-max-microvolt = <5700000>;
+		gpio = <&pio 26 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+	};
+};
+
+&{/soc} {
+	/* Hardware voter (infra HW_CCF): MM power domains and HWV gates */
+	hwv: syscon@10320000 {
+		compatible = "mediatek,mt6897-hwv", "syscon", "simple-mfd";
+		reg = <0x0 0x10320000 0x0 0x2000>;
+
+		hwv_pd: power-controller {
+			compatible = "mediatek,mt6897-hwv-power-controller";
+			#address-cells = <1>;
+			#size-cells = <0>;
+			#power-domain-cells = <1>;
+
+			mm_infra_pd: power-domain@MT6897_POWER_DOMAIN_HWV_MM_INFRA {
+				reg = <MT6897_POWER_DOMAIN_HWV_MM_INFRA>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+				#power-domain-cells = <1>;
+
+				/* Shipping MT6897 scpsys: MM_INFRA -> VDE0 -> VDE1. */
+				power-domain@MT6897_POWER_DOMAIN_HWV_VDE0 {
+					reg = <MT6897_POWER_DOMAIN_HWV_VDE0>;
+					#address-cells = <1>;
+					#size-cells = <0>;
+					#power-domain-cells = <1>;
+
+					power-domain@MT6897_POWER_DOMAIN_HWV_VDE1 {
+						reg = <MT6897_POWER_DOMAIN_HWV_VDE1>;
+						#power-domain-cells = <0>;
+					};
+				};
+
+				dis0_pd: power-domain@MT6897_POWER_DOMAIN_HWV_DIS0 {
+					reg = <MT6897_POWER_DOMAIN_HWV_DIS0>;
+					#address-cells = <1>;
+					#size-cells = <0>;
+					#power-domain-cells = <1>;
+
+					power-domain@MT6897_POWER_DOMAIN_HWV_OVL0 {
+						reg = <MT6897_POWER_DOMAIN_HWV_OVL0>;
+						#power-domain-cells = <0>;
+					};
+				};
+
+				dis1_pd: power-domain@MT6897_POWER_DOMAIN_HWV_DIS1 {
+					reg = <MT6897_POWER_DOMAIN_HWV_DIS1>;
+					#address-cells = <1>;
+					#size-cells = <0>;
+					#power-domain-cells = <1>;
+
+					power-domain@MT6897_POWER_DOMAIN_HWV_OVL1 {
+						reg = <MT6897_POWER_DOMAIN_HWV_OVL1>;
+						#power-domain-cells = <0>;
+					};
+				};
+			};
+		};
+	};
+
+	mipi_tx0: dsi-phy@11e50000 {
+		compatible = "mediatek,mt6897-mipi-tx", "mediatek,mt8196-mipi-tx";
+		reg = <0x0 0x11e50000 0x0 0x1000>;
+		clocks = <&clk26m>;
+		clock-output-names = "mipi_tx0_pll";
+		#clock-cells = <0>;
+		#phy-cells = <0>;
+		phy-type = <PHY_TYPE_CPHY>;
+	};
+
+	mipi_tx1: dsi-phy@11e60000 {
+		compatible = "mediatek,mt6897-mipi-tx", "mediatek,mt8196-mipi-tx";
+		reg = <0x0 0x11e60000 0x0 0x1000>;
+		clocks = <&clk26m>;
+		clock-output-names = "mipi_tx1_pll";
+		#clock-cells = <0>;
+		#phy-cells = <0>;
+		phy-type = <PHY_TYPE_CPHY>;
+	};
+
+	/* ---------------- OVLSYS0: leader of path 0 ---------------- */
+	ovlsys0: syscon@14400000 {
+		compatible = "mediatek,mt6897-ovlsys0", "syscon";
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+		reg = <0x0 0x14400000 0x0 0x1000>;
+		power-domains = <&hwv_pd MT6897_POWER_DOMAIN_HWV_OVL0>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				ovlsys0_root0: endpoint@0 {
+					reg = <0>;
+					remote-endpoint = <&ovl0_in>;
+				};
+
+				ovlsys0_root3: endpoint@3 {
+					reg = <3>;
+					remote-endpoint = <&ovl3_in>;
+				};
+			};
+		};
+
+		ovlsys0_mutex: mutex@14401000 {
+			compatible = "mediatek,mt6897-ovlsys-mutex";
+			reg = <0x0 0x14401000 0x0 0x1000>;
+			interrupts = <GIC_SPI 354 IRQ_TYPE_LEVEL_HIGH 0>;
+			clocks = <&ovlsys0_config CLK_OVLSYS0_DISP_MUTEX0>;
+			power-domains = <&hwv_pd MT6897_POWER_DOMAIN_HWV_OVL0>;
+			#trigger-source-cells = <1>;
+		};
+
+		ovlsys0_ovl0: ovl@14402000 {
+			compatible = "mediatek,mt6897-disp-ovl-2l";
+			reg = <0x0 0x14402000 0x0 0x1000>;
+			interrupts = <GIC_SPI 387 IRQ_TYPE_LEVEL_HIGH 0>;
+			clocks = <&ovlsys0_config CLK_OVLSYS0_OVL0_2L>;
+			power-domains = <&hwv_pd MT6897_POWER_DOMAIN_HWV_OVL0>;
+			trigger-sources = <&ovlsys0_mutex 0>;
+			mediatek,dual-pipe-twin = <&ovlsys1_ovl0>;
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+					#address-cells = <1>;
+					#size-cells = <0>;
+
+					ovl0_in: endpoint@0 {
+						reg = <0>;
+						remote-endpoint = <&ovlsys0_root0>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+					#address-cells = <1>;
+					#size-cells = <0>;
+
+					ovl0_out: endpoint@0 {
+						reg = <0>;
+						remote-endpoint = <&ovl1_in>;
+					};
+				};
+			};
+		};
+
+		ovlsys0_ovl1: ovl@14403000 {
+			compatible = "mediatek,mt6897-disp-ovl-2l";
+			reg = <0x0 0x14403000 0x0 0x1000>;
+			interrupts = <GIC_SPI 388 IRQ_TYPE_LEVEL_HIGH 0>;
+			clocks = <&ovlsys0_config CLK_OVLSYS0_OVL1_2L>;
+			power-domains = <&hwv_pd MT6897_POWER_DOMAIN_HWV_OVL0>;
+			trigger-sources = <&ovlsys0_mutex 1>;
+			mediatek,dual-pipe-twin = <&ovlsys1_ovl1>;
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+					#address-cells = <1>;
+					#size-cells = <0>;
+
+					ovl1_in: endpoint@0 {
+						reg = <0>;
+						remote-endpoint = <&ovl0_out>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+					#address-cells = <1>;
+					#size-cells = <0>;
+
+					ovl1_out: endpoint@0 {
+						reg = <0>;
+						remote-endpoint = <&ovl2_in>;
+					};
+				};
+			};
+		};
+
+		ovlsys0_ovl2: ovl@14404000 {
+			compatible = "mediatek,mt6897-disp-ovl-2l";
+			reg = <0x0 0x14404000 0x0 0x1000>;
+			interrupts = <GIC_SPI 389 IRQ_TYPE_LEVEL_HIGH 0>;
+			clocks = <&ovlsys0_config CLK_OVLSYS0_OVL2_2L>;
+			power-domains = <&hwv_pd MT6897_POWER_DOMAIN_HWV_OVL0>;
+			trigger-sources = <&ovlsys0_mutex 2>;
+			mediatek,dual-pipe-twin = <&ovlsys1_ovl2>;
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+					#address-cells = <1>;
+					#size-cells = <0>;
+
+					ovl2_in: endpoint@0 {
+						reg = <0>;
+						remote-endpoint = <&ovl1_out>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+					#address-cells = <1>;
+					#size-cells = <0>;
+
+					ovl2_out: endpoint@0 {
+						reg = <0>;
+						remote-endpoint = <&ovlsys0_dl_relay_out0>;
+					};
+				};
+			};
+		};
+
+		/* DisplayPort CRTC; no dual-pipe twin */
+		ovlsys0_ovl3: ovl@14405000 {
+			compatible = "mediatek,mt6897-disp-ovl-2l";
+			reg = <0x0 0x14405000 0x0 0x1000>;
+			interrupts = <GIC_SPI 390 IRQ_TYPE_LEVEL_HIGH 0>;
+			clocks = <&ovlsys0_config CLK_OVLSYS0_OVL3_2L>;
