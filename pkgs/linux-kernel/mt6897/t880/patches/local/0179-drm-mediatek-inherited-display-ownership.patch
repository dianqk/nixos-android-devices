+larb_tests=r'''int main(void){struct gen gen={MTK_SMI_FLAG_SLEEP_CTL};struct mtk_smi_larb larb={&gen,{2,0}};struct device dev={&larb};
+drain_error=-ETIMEDOUT;assert(mtk_smi_larb_suspend(&dev)==-ETIMEDOUT&&!clock_disables);
