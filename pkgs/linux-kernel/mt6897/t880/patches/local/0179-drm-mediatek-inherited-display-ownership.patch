diff --git a/drivers/gpu/drm/mediatek/mtk_ddp_comp.h b/drivers/gpu/drm/mediatek/mtk_ddp_comp.h
index db853e001f..8ad776dee1 100644
--- a/drivers/gpu/drm/mediatek/mtk_ddp_comp.h
+++ b/drivers/gpu/drm/mediatek/mtk_ddp_comp.h
@@ -45,6 +45,7 @@ struct mtk_ddp_comp_funcs {
 	void (*dsc_setup)(struct device *dev, struct drm_dsc_config *dsc);
 	void (*start)(struct device *dev);
 	void (*stop)(struct device *dev);
+	void (*boot_handover)(struct device *dev);
 	void (*register_vblank_cb)(struct device *dev,
 				   void (*vblank_cb)(void *),
 				   void *vblank_cb_data);
@@ -166,6 +167,12 @@ static inline void mtk_ddp_comp_stop(struct mtk_ddp_comp *comp)
 		comp->funcs->stop(comp->dev);
 }
 
+static inline void mtk_ddp_comp_boot_handover(struct mtk_ddp_comp *comp)
+{
+	if (comp->funcs && comp->funcs->boot_handover)
+		comp->funcs->boot_handover(comp->dev);
+}
+
 static inline void mtk_ddp_comp_register_vblank_cb(struct mtk_ddp_comp *comp,
 						   void (*vblank_cb)(void *),
 						   void *vblank_cb_data)
diff --git a/drivers/gpu/drm/mediatek/mtk_disp_boot.c b/drivers/gpu/drm/mediatek/mtk_disp_boot.c
new file mode 100644
index 0000000000..9a2cbd7bb8
--- /dev/null
+++ b/drivers/gpu/drm/mediatek/mtk_disp_boot.c
@@ -0,0 +1,411 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Independent owner of inherited MT6897 display DMA. Registers/port mapping:
+ * https://github.com/MiCode/MTK_kernel_device_modules/tree/3c4ccd07d5624879555ec710c11bb8818e5cb5c6
+ * mediatek_v2/mtk_disp_ovl.c, mtk_disp_postmask.c and mt6897.dts.
+ * This driver is built in, never part of the removable DRM module. A failed
+ * acquisition or unsupported live engine retains its acquired resources.
+ */
+#include <linux/clk.h>
+#include <linux/io.h>
+#include <linux/mutex.h>
+#include <linux/of_address.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <soc/mediatek/mtk_iommu.h>
+
+#include "mtk_disp_boot.h"
+
+#define MTK_BOOT_ENGINES 8
+#define MTK_BOOT_PATHS 2
+
+struct mtk_boot_engine {
+	struct device_node *node;
+	void __iomem *regs;
+	struct clk *clk;
+	struct device *paths[MTK_BOOT_PATHS];
+	unsigned int held_paths;
+	bool clock_held, active;
+};
+
+struct mtk_disp_boot {
+	struct device *dev;
+	struct mutex lock; /* Serialize acquisition and per-engine transfer. */
+	struct mtk_boot_engine engines[MTK_BOOT_ENGINES];
+	unsigned int num_engines;
+	struct device *iommus[MTK_BOOT_PATHS];
+	struct device *gce;
+	bool gce_held;
+	void __iomem *unowned_ovl, *postmasks[2];
+	struct clk_bulk_data *clocks;
+	int num_clocks;
+	bool power_held, clocks_held, attempted, ready;
+	int error;
+};
+
+static void mtk_boot_put_device(void *dev)
+{
+	put_device(dev);
+}
+
+static void mtk_boot_put_node(void *node)
+{
+	of_node_put(node);
+}
+
+static void mtk_boot_put_clock(void *clock)
+{
+	clk_put(clock);
+}
+
+static int mtk_boot_resolve(struct device *dev, struct device_node *node,
+			    struct device **result)
+{
+	struct platform_device *pdev;
+	int ret;
+
+	if (!node)
+		return -EINVAL;
+	pdev = of_find_device_by_node(node);
+	if (!pdev)
+		return -EPROBE_DEFER;
+	if (!device_is_bound(&pdev->dev)) {
+		put_device(&pdev->dev);
+		return -EPROBE_DEFER;
+	}
+	*result = &pdev->dev;
+	ret = devm_add_action_or_reset(dev, mtk_boot_put_device, *result);
+	return ret;
+}
+
+static void mtk_boot_engine_release(struct mtk_boot_engine *engine)
+{
+	if (engine->clock_held) {
+		clk_disable_unprepare(engine->clk);
+		engine->clock_held = false;
+	}
+	/* Last-user larb suspend drains through SLP_PROT_RDY. A failed drain
+	 * keeps its clocks and upstream supplier references in the PM core.
+	 * Clearing OVL EN alone is not a DMA-drain assertion.
+	 */
+	while (engine->held_paths)
+		pm_runtime_put(engine->paths[--engine->held_paths]);
+}
+
+/* Same non-fetching POSTMASK predicates as the VA preflight. These are not a
+ * generic outstanding-DMA counter; unknown enabled state must retain power.
+ */
+static int mtk_boot_check_postmask(void __iomem *base)
+{
+	u32 en = readl(base), cfg = readl(base + 0x20);
+
+	if ((en & BIT(0)) && !(readl(base + 0x24) & (BIT(1) | BIT(2))))
+		return -EINVAL;
+	if ((en & BIT(0)) && !(cfg & BIT(0)) && (cfg & BIT(1)))
+		return -EINVAL;
+	return 0;
+}
+
+static int mtk_boot_acquire(struct mtk_disp_boot *boot)
+{
+	unsigned int i, j;
+	int ret;
+
+	if (boot->attempted)
+		return boot->error;
+	ret = pm_runtime_resume_and_get(boot->dev);
+	if (ret < 0)
+		return ret; /* No acquired lease: ordinary probe deferral may retry. */
+	boot->attempted = true;
+	boot->power_held = true;
+	for (i = 0; i < boot->num_engines; i++) {
+		struct mtk_boot_engine *engine = &boot->engines[i];
+
+		for (j = 0; j < MTK_BOOT_PATHS; j++) {
+			ret = pm_runtime_resume_and_get(engine->paths[j]);
+			if (ret < 0)
+				goto quarantine;
+			engine->held_paths++;
+		}
+		ret = clk_prepare_enable(engine->clk);
+		if (ret)
+			goto quarantine;
+		engine->clock_held = true;
+		engine->active = readl(engine->regs + 0xc) & BIT(0);
+	}
+	/* Both OVL and DIS domains are now owned through the larb chains. */
+	ret = clk_bulk_prepare_enable(boot->num_clocks, boot->clocks);
+	if (ret)
+		goto quarantine;
+	boot->clocks_held = true;
+	/* Probe/RPM_SUSPENDED does not establish that inherited GCE threads
+	 * stopped. Managed resume first validates/takes firmware ownership.
+	 */
+	ret = pm_runtime_resume_and_get(boot->gce);
+	if (ret < 0)
+		goto quarantine;
+	boot->gce_held = true;
+	/* OVL7 has no normal component owner. Its disabled EN predicate and
+	 * the POSTMASK checks are inherited from the source-verified preflight.
+	 */
+	if (readl(boot->unowned_ovl + 0xc) & BIT(0)) {
+		ret = -EBUSY;
+		goto quarantine;
+	}
+	for (i = 0; i < ARRAY_SIZE(boot->postmasks); i++) {
+		ret = mtk_boot_check_postmask(boot->postmasks[i]);
+		if (ret)
+			goto quarantine;
+	}
+	/* Force the existing verified STOP path when this is the last user.
+	 * Another normal runtime user may instead retain GCE ownership.
+	 * The put consumes our usage reference even if suspend fails.
+	 */
+	ret = pm_runtime_put_sync_suspend(boot->gce);
+	if (ret < 0) {
+		pm_runtime_get_noresume(boot->gce);
+		goto quarantine;
+	}
+	boot->gce_held = false;
+	/* Every possible fetch now has an independent owner. The references
+	 * resolved at probe keep both providers alive across a partial ack.
+	 * Failed/partial acknowledgment retains all engine/fabric leases.
+	 */
+	for (i = 0; i < MTK_BOOT_PATHS; i++) {
+		ret = mtk_iommu_release_boot_guard(boot->iommus[i]);
+		if (ret)
+			goto quarantine;
+	}
+	boot->ready = true;
+	/* Disable borrowed read clocks while all OVL/DIS supplier domains are
+	 * still owned. Only then may an inactive engine drop its last path.
+	 */
+	clk_bulk_disable_unprepare(boot->num_clocks, boot->clocks);
+	boot->clocks_held = false;
+	pm_runtime_put(boot->dev);
+	boot->power_held = false;
+	for (i = 0; i < boot->num_engines; i++)
+		if (!boot->engines[i].active)
+			mtk_boot_engine_release(&boot->engines[i]);
+	dev_info(boot->dev, "inherited DMA covered; initial IOMMU guards retired\n");
+	return 0;
+quarantine:
+	boot->error = ret;
+	dev_err(boot->dev, "boot DMA ownership failed (%d); acquired resources retained\n", ret);
+	return ret;
+}
+
+static struct platform_device *mtk_boot_find(struct device *consumer)
+{
+	struct device_node *node;
+	struct platform_device *pdev;
+
+	if (!of_property_present(consumer->of_node, "mediatek,boot-handover"))
+		return NULL;
+	node = of_parse_phandle(consumer->of_node, "mediatek,boot-handover", 0);
+	if (!node)
+		return ERR_PTR(-EINVAL);
+	if (!of_device_is_compatible(node, "mediatek,mt6897-display-boot-state")) {
+		of_node_put(node);
+		return ERR_PTR(-EINVAL);
+	}
+	pdev = of_find_device_by_node(node);
+	of_node_put(node);
+	return pdev ?: ERR_PTR(-EPROBE_DEFER);
+}
+
+int mtk_disp_boot_ready(struct device *consumer)
+{
+	struct platform_device *pdev = mtk_boot_find(consumer);
+	struct mtk_disp_boot *boot;
+	int ret;
+
+	if (IS_ERR_OR_NULL(pdev))
+		return PTR_ERR_OR_ZERO(pdev);
+	/* This independent provider is built in with manual unbind disabled.
+	 * Probe completes before it publishes ownership to OVL components.
+	 */
+	if (!device_is_bound(&pdev->dev)) {
+		ret = -EPROBE_DEFER;
+		goto put;
+	}
+	boot = platform_get_drvdata(pdev);
+	mutex_lock(&boot->lock);
+	ret = mtk_boot_acquire(boot);
+	mutex_unlock(&boot->lock);
+put:
+	put_device(&pdev->dev);
+	return ret;
+}
+
+static void mtk_boot_transfer_engine(struct mtk_disp_boot *boot,
+				     struct device_node *node)
+{
+	unsigned int i;
+
+	if (!boot->ready)
+		return;
+	for (i = 0; i < boot->num_engines; i++) {
+		if (boot->engines[i].node != node)
+			continue;
+		mtk_boot_engine_release(&boot->engines[i]);
+		boot->engines[i].active = false;
+		break;
+	}
+}
+
+/* Called only with normal OVL runtime/clock ownership already established,
+ * after successful full CRTC setup or its stop sequence, including its twin.
+ */
+void mtk_disp_boot_transfer(struct device *consumer)
+{
+	struct platform_device *pdev = mtk_boot_find(consumer);
+	struct mtk_disp_boot *boot;
+
+	if (IS_ERR_OR_NULL(pdev))
+		return;
+	boot = platform_get_drvdata(pdev);
+	if (!boot)
+		goto put;
+	mutex_lock(&boot->lock);
+	mtk_boot_transfer_engine(boot, consumer->of_node);
+	mutex_unlock(&boot->lock);
+put:
+	put_device(&pdev->dev);
+}
+
+static int mtk_disp_boot_probe(struct platform_device *pdev)
+{
+	/* Register windows from the pinned MT6897 vendor DT, not port guesses. */
+	static const resource_size_t engine_windows[] = {
+		0x14402000, 0x14403000, 0x14404000, 0x14405000,
+		0x14602000, 0x14603000, 0x14604000,
+	};
+	static const resource_size_t check_windows[] = {
+		0x14605000, 0x14015000, 0x14215000,
+	};
+	static const char *const registers[] = { "unowned-ovl", "postmask0", "postmask1" };
+	struct device *dev = &pdev->dev;
+	struct mtk_disp_boot *boot;
+	struct device_node *node, *supplier;
+	void __iomem *maps[3];
+	struct resource resource;
+	int count, ret, i, j;
+
+	boot = devm_kzalloc(dev, sizeof(*boot), GFP_KERNEL);
+	if (!boot)
+		return -ENOMEM;
+	boot->dev = dev;
+	mutex_init(&boot->lock);
+	boot->num_clocks = devm_clk_bulk_get_all(dev, &boot->clocks);
+	if (boot->num_clocks != 3)
+		return boot->num_clocks < 0 ? boot->num_clocks : -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(maps); i++) {
+		struct resource *res = platform_get_resource_byname(pdev, IORESOURCE_MEM,
+								registers[i]);
+		if (!res || res->start != check_windows[i] || resource_size(res) < 0x1000)
+			return -EINVAL;
+		/* VA preflight also borrows read-only mappings of these windows. */
+		maps[i] = devm_ioremap(dev, res->start, 0x1000);
+		if (!maps[i])
+			return -ENOMEM;
+	}
+	boot->unowned_ovl = maps[0];
+	boot->postmasks[0] = maps[1];
+	boot->postmasks[1] = maps[2];
+	count = of_count_phandle_with_args(dev->of_node, "mediatek,iommus", NULL);
+	if (count != MTK_BOOT_PATHS)
+		return -EINVAL;
+	for (i = 0; i < count; i++) {
+		node = of_parse_phandle(dev->of_node, "mediatek,iommus", i);
+		ret = mtk_boot_resolve(dev, node, &boot->iommus[i]);
+		of_node_put(node);
+		if (ret)
+			return ret;
+	}
+	node = of_parse_phandle(dev->of_node, "mediatek,gce", 0);
+	if (!node)
+		return -EINVAL;
+	if (!of_device_is_compatible(node, "mediatek,mt6897-gce") ||
+	    of_address_to_resource(node, 0, &resource) ||
+	    resource.start != 0x1e980000) {
+		of_node_put(node);
+		return -EINVAL;
+	}
+	ret = mtk_boot_resolve(dev, node, &boot->gce);
+	of_node_put(node);
+	if (ret)
+		return ret;
+	count = of_count_phandle_with_args(dev->of_node, "mediatek,engines", NULL);
+	if (count != ARRAY_SIZE(engine_windows))
+		return -EINVAL;
+	boot->num_engines = count;
+	for (i = 0; i < count; i++) {
+		struct mtk_boot_engine *engine = &boot->engines[i];
+
+		node = of_parse_phandle(dev->of_node, "mediatek,engines", i);
+		if (!node)
+			return -EINVAL;
+		if (of_address_to_resource(node, 0, &resource) ||
+		    resource.start != engine_windows[i] ||
+		    resource_size(&resource) < 0x1000) {
+			of_node_put(node);
+			return -EINVAL;
+		}
+		engine->node = node;
+		ret = devm_add_action_or_reset(dev, mtk_boot_put_node, node);
+		if (ret)
+			return ret;
+		engine->regs = devm_ioremap(dev, resource.start, 0x1000);
+		if (!engine->regs)
+			return -ENOMEM;
+		engine->clk = of_clk_get(node, 0);
+		if (IS_ERR(engine->clk))
+			return PTR_ERR(engine->clk);
+		ret = devm_add_action_or_reset(dev, mtk_boot_put_clock, engine->clk);
+		if (ret)
+			return ret;
+		if (of_count_phandle_with_args(node, "mediatek,smi", NULL) != MTK_BOOT_PATHS)
+			return -EINVAL;
+		for (j = 0; j < MTK_BOOT_PATHS; j++) {
+			resource_size_t first = i < 4 ? 0x1440c000 : 0x1460c000;
+			struct resource path_resource;
+
+			supplier = of_parse_phandle(node, "mediatek,smi", j);
+			if (!supplier ||
+			    !of_device_is_compatible(supplier, "mediatek,mt6897-smi-larb") ||
+			    of_address_to_resource(supplier, 0, &path_resource) ||
+			    (path_resource.start != first &&
+			     path_resource.start != first + 0x1000)) {
+				of_node_put(supplier);
+				return -EINVAL;
+			}
+			ret = mtk_boot_resolve(dev, supplier, &engine->paths[j]);
+			of_node_put(supplier);
+			if (ret)
+				return ret;
+		}
+		if (engine->paths[0] == engine->paths[1])
+			return -EINVAL;
+	}
+	if (boot->iommus[0] == boot->iommus[1])
