+p=w/'iommu-guard.c';p.write_text(pre+fn('mtk_iommu_release_boot_guard')+tests);subprocess.run([os.environ.get('CC','cc'),'-Wall','-Wextra','-Werror','-fsanitize=address,undefined','-O1',str(p),'-o',str(w/'iommu-guard')],check=True);subprocess.run([str(w/'iommu-guard')],check=True)
+# Verify the firmware command is enclosed by its own acquired reference.
+a=s.index('if (data->plat_data->firmware_banks) {',s.index('static int mtk_iommu_probe'))
