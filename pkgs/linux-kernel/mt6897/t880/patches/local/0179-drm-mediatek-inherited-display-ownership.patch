--- a/drivers/gpu/drm/mediatek/Makefile
+++ b/drivers/gpu/drm/mediatek/Makefile
@@ -40,3 +40,5 @@ obj-$(CONFIG_DRM_MEDIATEK_HDMI_V2) += mtk_hdmi_ddc_v2.o
 obj-$(CONFIG_DRM_MEDIATEK_DP) += mtk_dp.o
 
 obj-$(CONFIG_DRM_MEDIATEK_MT6897_VA_BOOTSTRAP) += mtk_disp_va.o
+
+obj-$(CONFIG_DRM_MEDIATEK_MT6897_BOOT_HANDOVER) += mtk_disp_boot.o
diff --git a/drivers/gpu/drm/mediatek/mtk_crtc.c b/drivers/gpu/drm/mediatek/mtk_crtc.c
index 1e8274571b..c831f76516 100644
--- a/drivers/gpu/drm/mediatek/mtk_crtc.c
+++ b/drivers/gpu/drm/mediatek/mtk_crtc.c
@@ -713,6 +713,14 @@ static int mtk_crtc_ddp_hw_init(struct mtk_crtc *mtk_crtc)
 		mtk_crtc_config_layer(mtk_crtc, plane_state, i, NULL);
 	}
 
+	/* All failure exits precede this point. The complete CRTC owns its
+	 * component clocks/PM, so inherited leases can transfer without a gap.
+	 */
+	for (i = 0; i < mtk_crtc->ddp_comp_nr; i++)
+		mtk_ddp_comp_boot_handover(mtk_crtc->ddp_comp[i]);
+	for (i = 0; i < mtk_crtc->shadow_comp_nr; i++)
+		mtk_ddp_comp_boot_handover(mtk_crtc->shadow_comp[i]);
+
 	return 0;
 
 err_clk_disable:
