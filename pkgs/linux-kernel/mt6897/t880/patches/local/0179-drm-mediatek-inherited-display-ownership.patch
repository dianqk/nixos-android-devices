diff --git a/drivers/gpu/drm/mediatek/Kconfig b/drivers/gpu/drm/mediatek/Kconfig
index 26523950c4..f83f5e9cd5 100644
--- a/drivers/gpu/drm/mediatek/Kconfig
+++ b/drivers/gpu/drm/mediatek/Kconfig
@@ -21,6 +21,17 @@ config DRM_MEDIATEK
 	  This driver provides kernel mode setting and
 	  buffer management to userspace.
 
+config DRM_MEDIATEK_MT6897_BOOT_HANDOVER
+	bool "MT6897 inherited display DMA ownership"
+	depends on PM && DRM_MEDIATEK=y && MTK_IOMMU=y && MTK_SMI=y
+	depends on MTK_CMDQ_MBOX=y
+	default y if ARCH_MEDIATEK
+	help
+	  Keep inherited display DMA owned independently of component binding.
+	  The static platform provider is built in so a quarantined boot lease
+	  cannot disappear with a removable DRM module. Device-tree consumers
+	  must describe both physical SMI paths and all inherited engines.
+
 config DRM_MEDIATEK_DP
 	tristate "DRM DPTX Support for MediaTek SoCs"
 	depends on DRM_MEDIATEK
