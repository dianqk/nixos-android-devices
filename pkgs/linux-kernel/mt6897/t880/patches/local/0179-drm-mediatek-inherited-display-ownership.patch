index 0000000000..e82683dcdf
--- /dev/null
+++ b/tools/testing/selftests/mtk_display/test_boot_ownership.py
@@ -0,0 +1,190 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Exercise production boot ownership with PM, clock and firmware fault injection."""
+from pathlib import Path
+import hashlib
+import os
+import subprocess
+import tempfile
+work=tempfile.TemporaryDirectory(prefix='mtk-display-boot-')
+out=Path(work.name)
+repo=Path(__file__).resolve().parents[4]
+src=(repo/'drivers/gpu/drm/mediatek/mtk_disp_boot.c').read_text()
+names=['mtk_boot_engine_release','mtk_boot_check_postmask','mtk_boot_acquire','mtk_boot_transfer_engine']
+def fn(n):
+ start=src.rfind('\nstatic ',0,src.index(n+'('))+1
+ brace=src.index('{',src.index(n+'('));depth=1;i=brace+1
+ while depth:
+  depth+=(src[i]=='{')-(src[i]=='}');i+=1
+ return src[start:i]
+structs=src[src.index('struct mtk_boot_engine {'):src.index('static void mtk_boot_put_device')]
+preamble=r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <errno.h>
+#define __iomem
+#define MTK_BOOT_ENGINES 8
+#define MTK_BOOT_PATHS 2
+#define BIT(n) (1U<<(n))
+#define ARRAY_SIZE(a) (sizeof(a)/sizeof((a)[0]))
+typedef uint32_t u32;
+struct device_node { int id; };
+struct device { int id, refs; };
+struct clk { int id, refs; };
+struct mutex { int unused; };
+struct clk_bulk_data { int unused; };
+'''
+stubs=r'''
+static struct mtk_disp_boot boot;
+static struct device own,paths[4],providers[2],gce;
+static struct clk clocks[7];
+static struct device_node nodes[8];
+static uint32_t registers[7][1024],extra[1024],post[2][1024];
+static int stage,fail_stage,bulk,acks[2],releases,tests,gce_puts,gce_restores,gce_stops,other_gce_owner;
+static int fail(void) { return ++stage==fail_stage; }
+static int pm_runtime_resume_and_get(struct device*d) {
+ if(fail()) return -EIO;
+ d->refs++;return 0;
+}
+static int pm_runtime_put_sync_suspend(struct device*d) {
+ assert(d==&gce&&d->refs>0&&bulk);d->refs--;gce_puts++;
+ if(fail())return -EIO;
+ if(!d->refs)gce_stops++;
+ return 0;
+}
+static void pm_runtime_get_noresume(struct device*d) {
+ assert(d==&gce);d->refs++;gce_restores++;
+}
+static void pm_runtime_put(struct device*d) {
+ assert(!bulk);assert(d->refs>0);d->refs--;releases++;
+}
+static int clk_prepare_enable(struct clk*c) {
+ int side=c->id<4?0:2;
+ assert(paths[side].refs>0 && paths[side+1].refs>0);
+ if(fail()) return -EIO;
+ c->refs++;return 0;
+}
+static void clk_disable_unprepare(struct clk*c) {
+ int side=c->id<4?0:2;
+ assert(!bulk);assert(paths[side].refs>0&&paths[side+1].refs>0);
+ assert(c->refs>0);c->refs--;releases++;
+}
+static int clk_bulk_prepare_enable(int n,struct clk_bulk_data*c) {
+ (void)c;assert(n==3);for(int i=0;i<4;i++)assert(paths[i].refs>0);
+ if(fail())return -EIO;
+ bulk=1;return 0;
+}
+static void clk_bulk_disable_unprepare(int n,struct clk_bulk_data*c) {
+ (void)c;assert(n==3&&bulk);for(int i=0;i<4;i++)assert(paths[i].refs>0);
+ bulk=0;releases++;
+}
+static int mtk_iommu_release_boot_guard(struct device*d) {
+ assert(bulk&&!boot.gce_held&&gce.refs==other_gce_owner);assert(gce_puts==1&&!gce_restores);for(int i=0;i<7;i++)assert(clocks[i].refs==1);
+ if(fail()) return -EIO;
+ acks[d->id]++;assert(acks[d->id]==1);return 0;
+}
+static u32 readl(const void*p) {
+ for(int i=0;i<7;i++)if((uintptr_t)p>=(uintptr_t)registers[i] && (uintptr_t)p<(uintptr_t)(registers[i]+1024))assert(clocks[i].refs);
+ if((uintptr_t)p>=(uintptr_t)extra && (uintptr_t)p<(uintptr_t)(extra+1024))assert(bulk);
+ if((uintptr_t)p>=(uintptr_t)post && (uintptr_t)p<(uintptr_t)(post+2))assert(bulk);
+ return *(const uint32_t*)p;
+}
+#define dev_info(...) ((void)0)
+#define dev_err(...) ((void)0)
+'''
+tests=r'''
+static void reset(unsigned mask,int failure) {
+ memset(&boot,0,sizeof boot);memset(&own,0,sizeof own);memset(paths,0,sizeof paths);
+ memset(providers,0,sizeof providers);memset(clocks,0,sizeof clocks);memset(registers,0,sizeof registers);
+ memset(extra,0,sizeof extra);memset(post,0,sizeof post);memset(acks,0,sizeof acks);
+ stage=bulk=releases=gce_puts=gce_restores=gce_stops=other_gce_owner=0;memset(&gce,0,sizeof gce);fail_stage=failure;boot.gce=&gce;boot.dev=&own;boot.num_engines=7;boot.num_clocks=3;
+ boot.unowned_ovl=extra;boot.postmasks[0]=post[0];boot.postmasks[1]=post[1];
+ for(int i=0;i<2;i++){providers[i].id=i;boot.iommus[i]=&providers[i];}
+ for(int i=0;i<7;i++) {
+  int s=i<4?0:2;clocks[i].id=i;nodes[i].id=i;
+  boot.engines[i]=(struct mtk_boot_engine){.node=&nodes[i],.regs=registers[i],.clk=&clocks[i],.paths={&paths[s],&paths[s+1]}};
+  registers[i][3]=!!(mask&BIT(i));
+ }
+}
+static void balanced(void) {
+ assert(!own.refs&&!bulk&&gce.refs==other_gce_owner);for(int i=0;i<4;i++)assert(!paths[i].refs);
+ for(int i=0;i<7;i++)assert(!clocks[i].refs);
+}
+static void frozen_retry(int expected) {
+ struct mtk_disp_boot old=boot;int s=stage,r=releases;
+ assert(mtk_boot_acquire(&boot)==expected);assert(stage==s&&releases==r);
+ assert(!memcmp(&old,&boot,sizeof boot));
+ for(int i=0;i<7;i++)mtk_boot_transfer_engine(&boot,&nodes[i]);
+ assert(stage==s&&releases==r);assert(!memcmp(&old,&boot,sizeof boot));
+}
+int main(void) {
+ /* Every inherited-active subset, including all inactive/all active. */
+ for(unsigned mask=0;mask<128;mask++) {
+  reset(mask,0);assert(mtk_boot_acquire(&boot)==0);assert(stage==27&&boot.ready);
+  assert(acks[0]==1&&acks[1]==1&&!bulk&&!own.refs);
+  for(int i=0;i<7;i++)assert(clocks[i].refs==!!(mask&BIT(i)));
+  int s=stage,r=releases;assert(mtk_boot_acquire(&boot)==0);assert(stage==s&&releases==r);
+  mtk_boot_transfer_engine(&boot,&nodes[7]);assert(releases==r);
+  for(int i=6;i>=0;i--) {mtk_boot_transfer_engine(&boot,&nodes[i]);r=releases;mtk_boot_transfer_engine(&boot,&nodes[i]);assert(releases==r);}
+  balanced();assert(mtk_boot_acquire(&boot)==0);balanced();tests++;
+ }
+ /* Transfer must preserve already acquired normal owner references. */
+ reset(127,0);assert(mtk_boot_acquire(&boot)==0);
+ for(int i=0;i<7;i++){int s=i<4?0:2;paths[s].refs++;paths[s+1].refs++;clocks[i].refs++;}
+ for(int i=0;i<7;i++)mtk_boot_transfer_engine(&boot,&nodes[i]);
+ for(int i=0;i<7;i++)assert(clocks[i].refs==1);
+ assert(paths[0].refs==4&&paths[1].refs==4&&paths[2].refs==3&&paths[3].refs==3);
+ for(int i=0;i<7;i++){int s=i<4?0:2;clk_disable_unprepare(&clocks[i]);pm_runtime_put(&paths[s+1]);pm_runtime_put(&paths[s]);}
+ balanced();tests++;
+ /* All 27 boundaries: 1 own PM,14 path PM,7 clock,bulk,GCE get,GCE put,2 ack. */
+ for(int f=1;f<=27;f++) {
+  reset(127,f);assert(mtk_boot_acquire(&boot)==-EIO);assert(stage==f&&!boot.ready);
+  assert(!releases);assert(acks[0]==(f==27));assert(acks[1]==0);
+  int expected_paths[4]={0};
+  for(int i=0;i<7;i++) {
+   int side=i<4?0:2,held=0;
+   for(int j=0;j<2;j++)if(2+3*i+j<f){expected_paths[side+j]++;held++;}
+   assert(boot.engines[i].held_paths==(unsigned)held);
