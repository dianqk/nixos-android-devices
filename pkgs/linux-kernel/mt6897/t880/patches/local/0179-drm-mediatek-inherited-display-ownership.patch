+	.probe = mtk_disp_boot_probe,
+	.driver = {
+		.name = "mt6897-display-boot-state",
+		.of_match_table = mtk_boot_of_match,
+		.suppress_bind_attrs = true,
+	},
+};
+builtin_platform_driver(mtk_disp_boot_driver);
