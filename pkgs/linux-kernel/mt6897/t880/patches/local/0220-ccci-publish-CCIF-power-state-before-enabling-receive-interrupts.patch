From 2dbb7388b1832194cf7bff3246b88f552e3c1e3e Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Sun, 8 Nov 2026 07:46:16 +0800
Subject: [PATCH 221/221] ccci: publish CCIF power state before enabling
 receive interrupts

An immediate empty DATA0 interrupt masks the IRQ and schedules its delayed poll. If start is descheduled until that worker runs, publishing PWRON only after enable_irq lets the poll see OFF and exit, leaving the IRQ masked without another poll.

Publish PWRON after all resets but before enabling either IRQ. Pair the polled READ_ONCE state with WRITE_ONCE at start and stop. Exercise the actual startup, ISR and poll code with an IRQ-enable interleaving, and reproduce the lost-poll state with the old publication position.
---
 .../misc/mediatek/eccci/hif/ccci_hif_ccif.c   |   5 +-
 tools/testing/selftests/mtk_ccci/Makefile     |   4 +-
 .../selftests/mtk_ccci/ccif_start_cases.c     | 137 ++++++++++++++++++
 .../selftests/mtk_ccci/test_ccif_start.py     |  43 ++++++
 4 files changed, 185 insertions(+), 4 deletions(-)
 create mode 100644 tools/testing/selftests/mtk_ccci/ccif_start_cases.c
 create mode 100755 tools/testing/selftests/mtk_ccci/test_ccif_start.py

diff --git a/drivers/misc/mediatek/eccci/hif/ccci_hif_ccif.c b/drivers/misc/mediatek/eccci/hif/ccci_hif_ccif.c
index eda157445b..941fb26e4f 100644
--- a/drivers/misc/mediatek/eccci/hif/ccci_hif_ccif.c
+++ b/drivers/misc/mediatek/eccci/hif/ccci_hif_ccif.c
@@ -1591,6 +1591,8 @@ static int ccif_start(unsigned char hif_id)
 	/* clear all ccif irq before enable it.*/
 	ccci_reset_ccif_hw(AP_MD1_CCIF, ccif_ctrl->ccif_ap_base,
 		ccif_ctrl->ccif_md_base, ccif_ctrl);
+	/* An immediate empty IRQ may run its poll worker before start returns. */
+	WRITE_ONCE(ccif_ctrl->ccif_state, HIFCCIF_STATE_PWRON);
 	ccif_enable_irq1(CCIF_HIF_ID);
 	if (!ccif_ctrl->irq0_armed) {
 		ccif_ctrl->irq0_armed = true;
@@ -1599,7 +1601,6 @@ static int ccif_start(unsigned char hif_id)
 		/* masked by an empty interrupt before the last stop */
 		enable_irq(ccif_ctrl->ap_ccif_irq0_id);
 	}
-	ccif_ctrl->ccif_state = HIFCCIF_STATE_PWRON;
 	CCCI_NORMAL_LOG(0, TAG, "%s\n", __func__);
 	return 0;
 }
@@ -1614,7 +1615,7 @@ static int ccif_stop(unsigned char hif_id)
 	/* ACK CCIF for MD. while entering flight mode,
 	 * we may send something after MD slept
 	 */
-	ccif_ctrl->ccif_state = HIFCCIF_STATE_PWROFF;
+	WRITE_ONCE(ccif_ctrl->ccif_state, HIFCCIF_STATE_PWROFF);
 	cancel_delayed_work_sync(&ccif_ctrl->data0_poll_work);
 	ccci_reset_ccif_hw(AP_MD1_CCIF,
 		ccif_ctrl->ccif_ap_base, ccif_ctrl->ccif_md_base, ccif_ctrl);
