From 17215baaaaf36eeca83ef0888ce5c6fe707230d8 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Tue, 10 Nov 2026 13:55:25 +0800
Subject: [PATCH] drm/mediatek: separate MT6897 DSC VERSION and shadow control

MT6897 keeps the DSC VERSION field at 0x200 while its shadow control moved
to 0x228. Initialize VERSION at its own register instead of placing those
bits in the relocated control word, including after display-domain power
loss. Preserve non-version fields with the vendor's 0x60 mask.

Keep the existing FORCE_COMMIT/BYPASS behavior and programming order at
0x228. MT8195 retains its combined register path and MMIO trace. No DSC
geometry, PPS arithmetic, reset or enable sequencing changes are included.
Add production core/wrapper regressions for versions, register seeds,
enabled and disabled setup, twins and repeated epochs.

Link: https://github.com/MiCode/MTK_kernel_device_modules/blob/3c4ccd07d5624879555ec710c11bb8818e5cb5c6/drivers/gpu/drm/mediatek/mediatek_v2/mtk_disp_dsc.c#L1219-L1221
Link: https://github.com/MiCode/MTK_kernel_device_modules/blob/3c4ccd07d5624879555ec710c11bb8818e5cb5c6/drivers/gpu/drm/mediatek/mediatek_v2/mtk_disp_dsc.c#L206-L219
Signed-off-by: dianqk <dianqk@dianqk.net>
---
 drivers/gpu/drm/mediatek/mtk_disp_dsc.c       |  12 +
 tools/testing/selftests/mtk_clk/Makefile      |   4 +-
 .../selftests/mtk_clk/dsc_version_cases.c     | 223 ++++++++++++++++++
 .../selftests/mtk_clk/test_dsc_version.py     |  46 ++++
 4 files changed, 283 insertions(+), 2 deletions(-)
 create mode 100644 tools/testing/selftests/mtk_clk/dsc_version_cases.c
 create mode 100755 tools/testing/selftests/mtk_clk/test_dsc_version.py

diff --git a/drivers/gpu/drm/mediatek/mtk_disp_dsc.c b/drivers/gpu/drm/mediatek/mtk_disp_dsc.c
index 0729f06807..272f74920a 100644
--- a/drivers/gpu/drm/mediatek/mtk_disp_dsc.c
+++ b/drivers/gpu/drm/mediatek/mtk_disp_dsc.c
@@ -130,10 +130,12 @@
 #  define DSC_BYPASS_SHADOW		BIT(1)
 #  define DSC_READ_WORKING		BIT(2)
 #  define DSC_SHADOW_DSC_VERSION_MINOR	GENMASK(8, 5)
+#  define DSC_VERSION_MINOR_MASK		GENMASK(6, 5)
 
 /**
  * struct mtk_dsc_data - per-SoC DSC data
  * @shadow_reg: offset of the shadow control register
+ * @version_reg: separate VERSION register, or 0 when combined with shadow control
  * @obuf_sw_narrow: output buffer setting (with the software override bit)
  *		    for encoded widths below 1440, or 0 for the default size
  * @dsi_buffer: the DSI has a TX buffer (no DSC init delay), and the core
@@ -145,6 +147,7 @@
  */
 struct mtk_dsc_data {
 	u16 shadow_reg;
+	u16 version_reg;
 	u32 obuf_sw_narrow;
 	bool dsi_buffer;
 };
@@ -156,6 +159,7 @@ static const struct mtk_dsc_data mt8195_dsc_data = {
 /* MT6897: shadow control at 0x228 and a smaller output buffer below 1440 */
 static const struct mtk_dsc_data mt6897_dsc_data = {
 	.shadow_reg = 0x228,
+	.version_reg = DISP_REG_DSC_SHADOW,
 	.obuf_sw_narrow = 0x800000c8,
 	.dsi_buffer = true,
 };
@@ -404,6 +408,14 @@ static void mtk_dsc_setup_core(struct mtk_dsc *disp_dsc, void __iomem *reg,
 		writel(disp_dsc->data->obuf_sw_narrow, reg + DISP_REG_DSC_OUTBUF);
 	else
 		writel(FIELD_PREP_CONST(DSC_OBUF_SIZE, 1040), reg + DISP_REG_DSC_OUTBUF);
+	if (disp_dsc->data->version_reg) {
+		u32 version = readl(reg + disp_dsc->data->version_reg);
+
+		version &= ~DSC_VERSION_MINOR_MASK;
+		version |= dsc_shadow & DSC_VERSION_MINOR_MASK;
+		writel(version, reg + disp_dsc->data->version_reg);
+		dsc_shadow &= ~DSC_SHADOW_DSC_VERSION_MINOR;
+	}
 	writel(dsc_shadow, reg + disp_dsc->data->shadow_reg);
 
 	/* Set PPS registers configuration */
