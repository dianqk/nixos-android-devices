+/*
+ * A blender that follows another blender takes its background from it
+ * (OVL chains such as MT6897's OVL0_2L -> OVL1_2L -> OVL2_2L).
+ */
+static bool mtk_crtc_bg_chained(struct mtk_crtc *mtk_crtc, unsigned int i)
+{
+	struct mtk_ddp_comp *prev;
+
+	if (i == 0)
+		return false;
+
+	prev = mtk_crtc->ddp_comp[i - 1];
+	return i == 1 || (prev->funcs && prev->funcs->bgclr_in_on);
+}
+
+static struct mtk_mutex *mtk_crtc_comp_mutex(struct mtk_crtc *mtk_crtc,
+					     struct mtk_ddp_comp *comp)
+{
+	struct mtk_drm_private *priv = mtk_crtc_get_comp_priv(mtk_crtc, comp);
+
+	return mtk_crtc->mutex[mtk_crtc_get_controller_map_idx(mtk_crtc,
+							       priv->data->mmsys_id)];
+}
+
+/* Link (or unlink) the dual-pipe shadow path: routes and MuteX triggers */
+static void mtk_crtc_shadow_link(struct mtk_crtc *mtk_crtc, bool link)
+{
+	unsigned int i, n = mtk_crtc->shadow_comp_nr;
+
+	for (i = 0; i < n; i++) {
+		struct mtk_ddp_comp *comp = mtk_crtc->shadow_comp[i];
+		struct mtk_drm_private *priv = mtk_crtc_get_comp_priv(mtk_crtc, comp);
+		struct mtk_mutex *mutex = mtk_crtc_comp_mutex(mtk_crtc, comp);
+
+		/* Shadow paths are linked within themselves only */
+		if (i + 1 < n && !(mtk_crtc->shadow_seg_start & BIT(i + 1))) {
+			struct mtk_ddp_comp *next = mtk_crtc->shadow_comp[i + 1];
+
+			if (link && !mtk_ddp_comp_connect(comp, priv->mmsys_dev, next))
+				mtk_mmsys_hw_connect(priv->mmsys_dev, comp->type, comp->inst_id,
+						     next->type, next->inst_id);
+			else if (!link && !mtk_ddp_comp_disconnect(comp, priv->mmsys_dev, next))
+				mtk_mmsys_hw_disconnect(priv->mmsys_dev, comp->type, comp->inst_id,
+							next->type, next->inst_id);
+		}
+
+		if (link && !mtk_ddp_comp_add(comp, mutex))
+			mtk_mutex_add_trigger(mutex, comp->type, comp->inst_id, comp->mtx_trig_id);
+		else if (!link && !mtk_ddp_comp_remove(comp, mutex))
+			mtk_mutex_remove_trigger(mutex, comp->type, comp->inst_id,
+						 comp->mtx_trig_id);
+	}
+}
+
+static bool mtk_crtc_comp_is_output(const struct mtk_ddp_comp *comp)
+{
+	switch (comp->type) {
+	case MTK_DISP_DP_INTF:
+	case MTK_DISP_DPI:
+	case MTK_DISP_DSI:
+	case MTK_DISP_DVO:
+		return true;
+	default:
+		return false;
+	}
+}
+
+/*
+ * A controller without an output component of its own (e.g. an OVLSYS)
+ * must start its frames on the output of the pipe it feeds; controllers
+ * that own an output got their SOF when that component was added.
+ */
+static void mtk_crtc_path_follower_sof(struct mtk_crtc *mtk_crtc,
+				       struct mtk_ddp_comp **comps, unsigned int n,
+				       unsigned long *done, bool set)
+{
+	struct mtk_ddp_comp *out = NULL;
+	unsigned int i;
+
+	/* The pipe's output: the main path ends with it, a shadow set holds one */
+	for (i = 0; i < n; i++)
+		if (mtk_crtc_comp_is_output(comps[i]))
+			out = comps[i];
+	if (!out)
+		return;
+
+	for (i = 0; i < n; i++) {
+		u8 cid = comps[i]->controller_id;
+		struct mtk_mutex *mutex;
+
+		if (*done & BIT(cid))
+			continue;
+		*done |= BIT(cid);
+
+		mutex = mtk_crtc_comp_mutex(mtk_crtc, comps[i]);
+		if (set)
+			mtk_mutex_add_trigger(mutex, out->type, out->inst_id, out->mtx_trig_id);
+		else
+			mtk_mutex_remove_trigger(mutex, out->type, out->inst_id,
+						 out->mtx_trig_id);
+	}
+}
+
+static void mtk_crtc_follower_sof(struct mtk_crtc *mtk_crtc, bool set)
+{
+	unsigned long done = 0;
+	unsigned int i;
+
+	/* Controllers with their own output are already done */
+	for (i = 0; i < mtk_crtc->ddp_comp_nr; i++)
+		if (mtk_crtc_comp_is_output(mtk_crtc->ddp_comp[i]))
+			done |= BIT(mtk_crtc->ddp_comp[i]->controller_id);
+	for (i = 0; i < mtk_crtc->shadow_comp_nr; i++)
+		if (mtk_crtc_comp_is_output(mtk_crtc->shadow_comp[i]))
+			done |= BIT(mtk_crtc->shadow_comp[i]->controller_id);
+
+	/* The main path first: a controller shared by both pipes follows it */
+	mtk_crtc_path_follower_sof(mtk_crtc, mtk_crtc->ddp_comp, mtk_crtc->ddp_comp_nr,
+				   &done, set);
+	mtk_crtc_path_follower_sof(mtk_crtc, mtk_crtc->shadow_comp,
+				   mtk_crtc->shadow_comp_nr, &done, set);
+}
+
 static int mtk_crtc_ddp_hw_init(struct mtk_crtc *mtk_crtc)
 {
 	struct drm_crtc *crtc = &mtk_crtc->base;
@@ -484,6 +633,10 @@ static int mtk_crtc_ddp_hw_init(struct mtk_crtc *mtk_crtc)
 		goto err_mutex_unprepare;
 	}
 
+	ret = mtk_disp_va_runtime_gate(crtc->dev->dev);
+	if (ret)
+		goto err_clk_disable;
+
 	for (i = 0; i < mtk_crtc->ddp_comp_nr - 1; i++) {
 		struct mtk_ddp_comp *comp = mtk_crtc->ddp_comp[i];
 		struct mtk_ddp_comp *next = mtk_crtc->ddp_comp[i + 1];
@@ -516,6 +669,10 @@ static int mtk_crtc_ddp_hw_init(struct mtk_crtc *mtk_crtc)
 				      mtk_crtc->ddp_comp[i]->inst_id,
 				      mtk_crtc->ddp_comp[i]->mtx_trig_id);
 
+	mtk_crtc_shadow_link(mtk_crtc, true);
+	mtk_crtc_follower_sof(mtk_crtc, true);
+
+	/* Both pipes' MuteXes are enabled together, before the output starts */
 	for (i = 0; i < mtk_crtc->num_controllers; i++)
 		mtk_mutex_enable(mtk_crtc->mutex[i]);
 
@@ -529,7 +686,7 @@ static int mtk_crtc_ddp_hw_init(struct mtk_crtc *mtk_crtc)
 		if (comp->type == MTK_DISP_DSC && !comp_dsc)
 			comp_dsc = comp;
 
-		if (i == 1)
+		if (mtk_crtc_bg_chained(mtk_crtc, i))
 			mtk_ddp_comp_bgclr_in_on(comp);
 
 		mtk_ddp_comp_config(comp, width, height, vrefresh, bpc, NULL);
@@ -558,6 +715,8 @@ static int mtk_crtc_ddp_hw_init(struct mtk_crtc *mtk_crtc)
 
 	return 0;
 
+err_clk_disable:
+	mtk_crtc_ddp_clk_disable(mtk_crtc);
 err_mutex_unprepare:
 	for (i = 0; i < mtk_crtc->num_controllers; i++)
 		mtk_mutex_unprepare(mtk_crtc->mutex[i]);
@@ -579,13 +738,16 @@ static void mtk_crtc_ddp_hw_fini(struct mtk_crtc *mtk_crtc)
 
 	for (i = 0; i < mtk_crtc->ddp_comp_nr; i++) {
 		mtk_ddp_comp_stop(mtk_crtc->ddp_comp[i]);
-		if (i == 1)
+		if (mtk_crtc_bg_chained(mtk_crtc, i))
 			mtk_ddp_comp_bgclr_in_off(mtk_crtc->ddp_comp[i]);
 	}
 
 	for (i = 0; i < mtk_crtc->num_controllers; i++)
 		mtk_mutex_disable(mtk_crtc->mutex[i]);
 
+	mtk_crtc_follower_sof(mtk_crtc, false);
+	mtk_crtc_shadow_link(mtk_crtc, false);
+
 	for (i = 0; i < mtk_crtc->ddp_comp_nr; i++) {
 		struct mtk_ddp_comp *comp = mtk_crtc->ddp_comp[i];
 
@@ -1000,13 +1162,39 @@ static void mtk_crtc_atomic_disable(struct drm_crtc *crtc,
 	mtk_crtc_update_config(mtk_crtc, false);
 #if IS_REACHABLE(CONFIG_MTK_CMDQ)
 	/* Wait for planes to be disabled by cmdq */
-	if (mtk_crtc->cmdq_client.chan)
-		wait_event_timeout(mtk_crtc->cb_blocking_queue,
-				   mtk_crtc->cmdq_vblank_cnt == 0,
-				   msecs_to_jiffies(500));
+	if (mtk_crtc->cmdq_client.chan &&
+	    !wait_event_timeout(mtk_crtc->cb_blocking_queue,
+				mtk_crtc->cmdq_vblank_cnt == 0,
+				msecs_to_jiffies(500))) {
+		/*
+		 * The GCE thread still waits for an event of a pipe that does
+		 * not run. Abort it before the path is torn down and powered
+		 * off, so that it cannot write to the engines later, and
+		 * complete the page flip it was carrying.
+		 */
+		drm_warn(dev, "[CRTC:%d] CMDQ configuration did not complete, aborting\n",
+			 crtc->base.id);
+		mbox_flush(mtk_crtc->cmdq_client.chan, 2000);
+		mtk_crtc->cmdq_vblank_cnt = 0;
+		if (mtk_crtc->pending_needs_vblank) {
+			mtk_crtc_finish_page_flip(mtk_crtc);
+			mtk_crtc->pending_needs_vblank = false;
+		}
+	}
 #endif
-	/* Wait for planes to be disabled */
-	drm_crtc_wait_one_vblank(crtc);
+	/*
+	 * Wait for planes to be disabled. The bridges are post-disabled
+	 * before the CRTC, and a DSI panel's off commands stop video there,
+	 * so no vblank may come: wait without warning.
+	 */
+	if (!drm_crtc_vblank_get(crtc)) {
+		u64 count = drm_crtc_vblank_count(crtc);
+
+		wait_event_timeout(*drm_crtc_vblank_waitqueue(crtc),
+				   drm_crtc_vblank_count(crtc) != count,
+				   msecs_to_jiffies(100));
+		drm_crtc_vblank_put(crtc);
+	}
 
 	drm_crtc_vblank_off(crtc);
 	mtk_crtc_ddp_hw_fini(mtk_crtc);
@@ -1287,22 +1475,38 @@ static int mtk_crtc_find_suitable_dma_dev(struct mtk_crtc *mtk_crtc)
 		mtk_crtc->dma_dev = mtk_ddp_comp_dma_dev_get(dma_comp_mmu);
 	else if (dma_comp)
 		mtk_crtc->dma_dev = mtk_ddp_comp_dma_dev_get(dma_comp);
+	else if (mtk_crtc->config_comp_idx >= 0)
+		/*
+		 * No IOMMU and no "#dma-cells": the layer configuration component
+		 * (an OVL/RDMA/exDMA) still reads the planes, with physical
+		 * addresses within its DMA mask.
+		 */
+		mtk_crtc->dma_dev = mtk_ddp_comp_dma_dev_get(mtk_crtc->ddp_comp[mtk_crtc->config_comp_idx]);
 	else
 		return -EINVAL;
 
 	return 0;
 }
 
+/* Main path components first, then the dual-pipe shadow path */
+static struct mtk_ddp_comp *mtk_crtc_any_comp(struct mtk_crtc *mtk_crtc, unsigned int i)
+{
+	if (i < mtk_crtc->ddp_comp_nr)
+		return mtk_crtc->ddp_comp[i];
+
+	return mtk_crtc->shadow_comp[i - mtk_crtc->ddp_comp_nr];
+}
+
 static int mtk_crtc_init_multi_controller_properties(struct device *dev,
 						     struct mtk_crtc *mtk_crtc)
 {
 	struct drm_crtc *crtc = &mtk_crtc->base;
 	unsigned long controllers_mask = 0;
 	struct mtk_drm_private *priv;
-	unsigned int i, j, k, z;
+	unsigned int i, j, k, z = 0;
 
-	for (i = 0; i < mtk_crtc->ddp_comp_nr; i++) {
-		u8 controller_id = mtk_crtc->ddp_comp[i]->controller_id;
+	for (i = 0; i < mtk_crtc->ddp_comp_nr + mtk_crtc->shadow_comp_nr; i++) {
+		u8 controller_id = mtk_crtc_any_comp(mtk_crtc, i)->controller_id;
 
 		if (controller_id > MTK_DISP_CONTROLLER_MAX_CONTROLLERS_NUM) {
 			dev_err(mtk_crtc->mmsys_dev, "Bad controller ID %u\n",
@@ -1335,24 +1539,24 @@ static int mtk_crtc_init_multi_controller_properties(struct device *dev,
 	priv = crtc->dev->dev_private;
 
 	for_each_set_bit(i, &controllers_mask, MTK_DISP_CONTROLLER_MAX_CONTROLLERS_NUM) {
-		for (j = 0; j < mtk_crtc->ddp_comp_nr; j++) {
+		for (j = 0; j < mtk_crtc->ddp_comp_nr + mtk_crtc->shadow_comp_nr; j++) {
 			struct mtk_drm_private *controller_priv;
