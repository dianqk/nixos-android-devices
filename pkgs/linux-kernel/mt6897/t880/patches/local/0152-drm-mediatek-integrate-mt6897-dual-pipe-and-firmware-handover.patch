+// SPDX-License-Identifier: GPL-2.0-only
+/* MT6897 display VA handover. Successful transactions release their runtime
+ * resources; unknown firmware/packet completion is quarantined until reboot.
+ * Register/SMC ABI reference: MiCode MTK_kernel_device_modules
+ * 3c4ccd07d5624879555ec710c11bb8818e5cb5c6, mediatek_v2/mtk_disp_ovl.c,
+ * mtk_disp_postmask.c, cmdq-util.c and mtk-cmdq-mailbox-ext.c.
+ * https://github.com/MiCode/MTK_kernel_device_modules/tree/3c4ccd07d5624879555ec710c11bb8818e5cb5c6
+ */
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/mailbox_controller.h>
+#include <linux/device.h>
+#include <linux/iommu.h>
