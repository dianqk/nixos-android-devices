+#include <linux/io.h>
+
+#define MTK_DISP_VA_START 692
+#define MTK_DISP_VA_END 693
+
+enum mtk_disp_va_state {
+	MTK_DISP_VA_IDLE,
+	MTK_DISP_VA_PREPARED,
+	MTK_DISP_VA_ATTEMPTED,
+	MTK_DISP_VA_TRANSLATED,
+};
+
+/* Checked linear fetch validation, independent of the hardware decoder. */
+static int mtk_disp_va_check_linear(u64 address, u32 width, u32 height,
+				    u32 pitch, u32 bytes_per_pixel,
+				    u64 reserved_start, u64 reserved_size,
+				    u64 *last)
+{
+	u64 row_bytes, tail, end, reserved_end;
+
+	if (!width || !height || !bytes_per_pixel || !reserved_size ||
+	    check_mul_overflow((u64)width, (u64)bytes_per_pixel, &row_bytes) ||
+	    row_bytes > pitch ||
+	    check_mul_overflow((u64)(height - 1), (u64)pitch, &tail) ||
+	    check_add_overflow(tail, row_bytes - 1, &tail) ||
+	    check_add_overflow(address, tail, &end) ||
+	    check_add_overflow(reserved_start, reserved_size - 1, &reserved_end) ||
+	    address < reserved_start || end > reserved_end)
+		return -EINVAL;
+	*last = end;
+	return 0;
+}
+
+static int mtk_disp_va_check_identity(struct iommu_domain *domain,
+				      u64 first, u64 last)
+{
+	u64 page = first & PAGE_MASK;
+
+	if (!domain || !iommu_is_dma_domain(domain) || first > last)
+		return -EINVAL;
+	for (;;) {
+		if (iommu_iova_to_phys(domain, page) != page)
+			return -EINVAL;
+		if (last - page < PAGE_SIZE)
+			break;
+		if (check_add_overflow(page, (u64)PAGE_SIZE, &page))
+			return -EINVAL;
+	}
+	return 0;
+}
+
+/* MT6897 2-layer OVL snapshot decoder. Registers are read only after all
+ * explicit display power/clock holds; snapshot must be rechecked before SMC.
+ */
+struct mtk_disp_va_layer {
+	u64 first;
+	u64 last;
+};
+
+static int mtk_disp_va_decode_ovl(void __iomem *base, u64 start, u64 length,
+				struct mtk_disp_va_layer layers[2], u32 *active)
+{
+	u32 en = readl(base + 0xc), src = readl(base + 0x2c);
+	u32 datapath = readl(base + 0x24), ext = readl(base + 0x324);
+	unsigned int i;
+
+	*active = 0;
+	if (!(en & BIT(0)))
+		return 0;
+	if (!(en & (BIT(20) | BIT(22))))
+		return -EINVAL;
+	if ((src & ~GENMASK(1, 0)) || (ext & GENMASK(2, 0)) ||
+	    (datapath & GENMASK(23, 16)))
+		return -EINVAL;
+	for (i = 0; i < 2; i++) {
+		u32 con, size, pitch, pitch_msb, high, fmt, bpp;
+		u64 address;
+		int ret;
+
+		if (!(src & BIT(i))) {
+			if (readl(base + 0xc0 + 0x20 * i) & BIT(0))
+				return -EINVAL;
+			continue;
+		}
+		con = readl(base + 0x30 + 0x20 * i);
+		/* Memory source, linear, uncompressed, no flips/3D/landscape. */
+		if ((datapath & BIT(i + 4)) ||
+		    (readl(base + 0x2d0) & (3 << (4 * i))) ||
+		    (readl(base + 0xc0 + 0x20 * i) & BIT(4)) ||
+		    readl(base + 0x880 + 0x10 * i) ||
+		    (con & (GENMASK(29, 28) | GENMASK(22, 20) | BIT(10) | BIT(9))))
+			return -EINVAL;
+		fmt = (con >> 12) & 0xf;
+		switch (fmt) {
+		case 0: bpp = 2; break;
+		case 1: bpp = 3; break;
+		case 2:
+		case 3: bpp = 4; break;
+		default: return -EINVAL;
+		}
+		address = readl(base + 0xf40 + 0x20 * i);
+		high = readl(base + 0xf4c + 0x20 * i);
+		if (high & ~0xf)
+			return -EINVAL;
+		address |= (u64)high << 32;
+		pitch = readl(base + 0x44 + 0x20 * i) & 0xffff;
+		pitch_msb = readl(base + 0x40 + 0x20 * i);
+		if (pitch_msb & BIT(16))
+			return -EINVAL;
+		/* RGB YUV_TRANS bit20 is harmless; do not reject it. */
+		pitch |= (pitch_msb & 0xf) << 16;
+		size = readl(base + 0x38 + 0x20 * i);
+		if (size & ~0x0fff0fff)
+			return -EINVAL;
+		ret = mtk_disp_va_check_linear(address, size & 0xfff,
+					     (size >> 16) & 0xfff, pitch, bpp,
+					     start, length, &layers[i].last);
+		if (ret)
+			return ret;
+		layers[i].first = address;
+		*active |= BIT(i);
+	}
+	return 0;
+}
+
+static int mtk_disp_va_check_postmask(void __iomem *base)
+{
+	u32 en = readl(base), cfg = readl(base + 0x20);
+
+	if ((en & BIT(0)) && !(readl(base + 0x24) & (BIT(1) | BIT(2))))
+		return -EINVAL;
+	/* Only proven non-fetching POSTMASK is supported by this initial implementation. */
+	if ((en & BIT(0)) && !(cfg & BIT(0)) && (cfg & BIT(1)))
+		return -EINVAL;
+	return 0;
+}
+
+
+#define MTK_VA_SUPPLIERS 12
+#define MTK_VA_OVLS 8
+#define MTK_VA_POSTMASKS 2
+
+struct mtk_va_raw_snapshot {
+	u32 ovl[MTK_VA_OVLS][21];
+	u32 postmask[MTK_VA_POSTMASKS][3];
+};
+
+struct mtk_disp_va_bootstrap {
+	struct device *dev;
+	struct mutex lock;
+	enum mtk_disp_va_state state;
+	struct cmdq_client client;
+	struct cmdq_pkt packet;
+	struct completion done;
+	int packet_status;
+	bool packet_mapped;
+	bool gce_held;
+	bool initial_done;
+	struct iommu_group *groups[7];
+	struct clk_bulk_data *clocks;
+	int num_clocks;
+	struct device *suppliers[MTK_VA_SUPPLIERS];
+	unsigned int num_suppliers, held, held_ovls;
+	struct device *dma_dev;
+	struct device *ovl_devs[6];
+	struct iommu_domain *domain;
+	void __iomem *ovl[MTK_VA_OVLS];
+	void __iomem *postmask[MTK_VA_POSTMASKS];
+	struct resource identity;
+	struct mtk_va_raw_snapshot snapshots[2];
+	bool clocks_held;
+};
+
+
+
+static int mtk_va_snapshot(struct mtk_disp_va_bootstrap *b,
+			   struct mtk_disp_va_layer layers[MTK_VA_OVLS][2],
+			   u32 active[MTK_VA_OVLS], struct mtk_va_raw_snapshot *raw)
+{
+	static const unsigned int common[] = { 0xc, 0x2c, 0x24, 0x324, 0x2d0 };
+	static const unsigned int per_layer[] = { 0x30, 0x38, 0x44, 0x40,
+		0xf40, 0xf4c, 0xc0 };
+	unsigned int i, j, n, cursor;
+	int ret;
+
+	memset(raw, 0, sizeof(*raw));
+	memset(layers, 0, sizeof(*layers) * MTK_VA_OVLS);
+	for (i = 0; i < MTK_VA_OVLS; i++) {
+		cursor = 0;
+		for (j = 0; j < ARRAY_SIZE(common); j++)
+			raw->ovl[i][cursor++] = readl(b->ovl[i] + common[j]);
+		for (n = 0; n < 2; n++) {
+			for (j = 0; j < ARRAY_SIZE(per_layer); j++)
+				raw->ovl[i][cursor++] = readl(b->ovl[i] + per_layer[j] + 0x20 * n) &
+					(j == 6 ? (BIT(0) | BIT(4)) : ~0U);
+			raw->ovl[i][cursor++] = readl(b->ovl[i] + 0x880 + 0x10 * n);
+		}
+		ret = mtk_disp_va_decode_ovl(b->ovl[i], b->identity.start,
+				resource_size(&b->identity), layers[i], &active[i]);
+		if (ret) {
+			dev_err(b->dev, "OVL%u unsupported fetch config EN=%08x SRC=%08x (%d)\n",
+				i, raw->ovl[i][0], raw->ovl[i][1], ret);
+			return ret;
+		}
+		/* OVL3/7 have no port attachment in this candidate. */
+		if ((i == 3 || i == 7) && active[i]) {
+			dev_err(b->dev, "OVL%u active without a port attachment\n", i);
+			return -EINVAL;
+		}
+	}
+	for (i = 0; i < MTK_VA_POSTMASKS; i++) {
+		raw->postmask[i][0] = readl(b->postmask[i]);
+		raw->postmask[i][1] = readl(b->postmask[i] + 0x20);
+		raw->postmask[i][2] = readl(b->postmask[i] + 0x24) & (BIT(1) | BIT(2));
+		ret = mtk_disp_va_check_postmask(b->postmask[i]);
+		if (ret) {
+			dev_err(b->dev, "POSTMASK%u unsupported fetch EN=%08x CFG=%08x SHADOW=%08x\n",
+				i, raw->postmask[i][0], raw->postmask[i][1], raw->postmask[i][2]);
+			return ret;
+		}
+	}
+	return 0;
+}
+
+static void mtk_va_release_prepared(void *ctx)
+{
+	struct mtk_disp_va_bootstrap *b = ctx;
+	unsigned int i;
+
+	if (b->packet_mapped) {
+		cmdq_pkt_destroy(&b->client, &b->packet);
+		b->packet_mapped = false;
+	}
+	for (i = 0; i < ARRAY_SIZE(b->groups); i++) {
+		if (b->groups[i])
+			iommu_group_put(b->groups[i]);
+		b->groups[i] = NULL;
+	}
+
+	if (b->clocks_held) {
+		clk_bulk_disable_unprepare(b->num_clocks, b->clocks);
+		b->clocks_held = false;
+	}
+	while (b->held_ovls)
+		pm_runtime_put(b->ovl_devs[--b->held_ovls]);
+	while (b->held)
+		pm_runtime_put(b->suppliers[--b->held]);
+	pm_runtime_put(b->dev);
+}
+
+static int mtk_va_acquire(void *ctx)
+{
+	struct mtk_disp_va_bootstrap *b = ctx;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(b->dev);
+	if (ret < 0)
+		return ret;
+	for (; b->held < b->num_suppliers; b->held++) {
+		ret = pm_runtime_resume_and_get(b->suppliers[b->held]);
+		if (ret < 0) {
+			dev_err(b->dev, "supplier %s PM failed: %d\n",
+				dev_name(b->suppliers[b->held]), ret);
+			goto fail;
+		}
+	}
+	/* The last OVL can be inside component_add() here, before its probe
+	 * returns. All components have bound and PM was enabled first; do not
+	 * require device_is_bound or managed supplier links for these OVLs.
+	 */
+	for (; b->held_ovls < ARRAY_SIZE(b->ovl_devs); b->held_ovls++) {
+		ret = pm_runtime_resume_and_get(b->ovl_devs[b->held_ovls]);
+		if (ret < 0) {
+			dev_err(b->dev, "OVL %s PM failed: %d\n",
+				dev_name(b->ovl_devs[b->held_ovls]), ret);
+			goto fail;
+		}
+	}
+	ret = clk_bulk_prepare_enable(b->num_clocks, b->clocks);
+	if (ret)
+		goto fail;
+	b->clocks_held = true;
+	return 0;
+fail:
+	mtk_va_release_prepared(b);
+	return ret;
+}
+
+static int mtk_va_preflight(void *ctx)
+{
+	struct mtk_disp_va_bootstrap *b = ctx;
+	struct mtk_disp_va_layer layers[MTK_VA_OVLS][2], again[MTK_VA_OVLS][2];
+	u32 active[MTK_VA_OVLS], again_active[MTK_VA_OVLS];
+	struct mtk_va_raw_snapshot *raw = &b->snapshots[0];
+	struct mtk_va_raw_snapshot *again_raw = &b->snapshots[1];
+	unsigned int i, j;
+	int ret;
+
+	b->domain = iommu_get_domain_for_dev(b->dma_dev);
+	if (!b->domain || !iommu_is_dma_domain(b->domain)) {
+		dev_err(b->dev, "OVL0 has no translated DMA domain\n");
+		return -EINVAL;
+	}
+	for (i = 0; i < ARRAY_SIZE(b->ovl_devs); i++)
+		if (!of_property_present(b->ovl_devs[i]->of_node, "iommus") ||
+		    iommu_get_domain_for_dev(b->ovl_devs[i]) != b->domain) {
+			dev_err(b->dev, "%s missing/shared domain mismatch\n",
+				dev_name(b->ovl_devs[i]));
+			return -EINVAL;
+		}
+	ret = mtk_va_snapshot(b, layers, active, raw);
+	if (ret)
+		return ret;
+	ret = mtk_disp_va_check_identity(b->domain, b->identity.start, b->identity.end);
+	if (ret) {
+		dev_err(b->dev, "LK identity reservation %#llx-%#llx not fully mapped\n",
+			(u64)b->identity.start, (u64)b->identity.end);
+		return ret;
+	}
+	for (i = 0; i < MTK_VA_OVLS; i++)
+		for (j = 0; j < 2; j++) {
+			if (!(active[i] & BIT(j)))
+				continue;
+			ret = mtk_disp_va_check_identity(b->domain,
+					layers[i][j].first, layers[i][j].last);
+			if (ret) {
+				dev_err(b->dev, "OVL%u layer%u identity %#llx-%#llx failed\n",
+					i, j, layers[i][j].first, layers[i][j].last);
+				return ret;
+			}
+		}
+	ret = mtk_va_snapshot(b, again, again_active, again_raw);
+	if (ret)
+		return ret;
+	if (memcmp(layers, again, sizeof(layers)) ||
+	    memcmp(active, again_active, sizeof(active)) ||
+	    memcmp(raw, again_raw, sizeof(*raw))) {
+		dev_err(b->dev, "fetch config changed during identity validation\n");
+		return -EAGAIN;
+	}
+	dev_info(b->dev, "identity %#llx-%#llx OVL masks %x/%x/%x/%x/%x/%x/%x/%x\n",
+		(u64)b->identity.start, (u64)b->identity.end, active[0], active[1],
+		active[2], active[3], active[4], active[5], active[6], active[7]);
+	return 0;
+}
+
+static void mtk_va_done(struct mbox_client *client, void *message)
+{
+	struct cmdq_client *cmdq_client = container_of(client, struct cmdq_client, client);
+	struct mtk_disp_va_bootstrap *b = container_of(cmdq_client, struct mtk_disp_va_bootstrap, client);
+	struct cmdq_cb_data *data = message;
+
+	WRITE_ONCE(b->packet_status,
+		   data && data->pkt == &b->packet ? data->sta : -EPROTO);
+	complete(&b->done);
+}
+
+static int mtk_va_prepare_packet(struct mtk_disp_va_bootstrap *b)
+{
+	struct device *gce = b->client.chan->mbox->dev;
+	struct iommu_domain *domain = iommu_get_domain_for_dev(gce);
+	phys_addr_t physical;
+	unsigned int i;
+	int ret;
+
+	if (!domain || domain != b->domain)
+		return -EINVAL;
+	if (b->packet_mapped)
+		return -EBUSY;
+	for (i = 0; i < ARRAY_SIZE(b->ovl_devs); i++) {
+		b->groups[i] = iommu_group_get(b->ovl_devs[i]);
+		if (!b->groups[i])
+			return -EINVAL;
+	}
+	b->groups[6] = iommu_group_get(gce);
+	if (!b->groups[6])
+		return -EINVAL;
+	memset(&b->packet, 0, sizeof(b->packet));
+	ret = cmdq_pkt_create(&b->client, &b->packet, PAGE_SIZE);
+	if (ret)
+		return ret;
+	b->packet_mapped = true;
+	physical = virt_to_phys(b->packet.va_base);
+	for (i = 0; i < b->packet.buf_size; i += PAGE_SIZE)
+		if (iommu_iova_to_phys(domain, b->packet.pa_base + i) != physical + i)
+			return -EFAULT;
+	if (physical < 0x33ff00000ULL && physical + b->packet.buf_size > 0x33fe00000ULL)
+		return -EINVAL;
+	ret = cmdq_pkt_set_event(&b->packet, MTK_DISP_VA_START);
+	if (!ret)
+		ret = cmdq_pkt_wfe(&b->packet, MTK_DISP_VA_END, true);
+	if (!ret)
+		ret = cmdq_pkt_eoc(&b->packet);
+	if (ret)
+		return ret;
+	dma_sync_single_for_device(gce, b->packet.pa_base,
+				   b->packet.cmd_buf_size, DMA_TO_DEVICE);
+	dev_dbg(b->dev, "VA packet IOVA=%pad PA=%pa bytes=%zu\n",
+		 &b->packet.pa_base, &physical, b->packet.cmd_buf_size);
+	return 0;
+}
+
+/* The independent provider keeps callback/packet storage alive if DRM bind
+ * fails after an unknown completion. Normal success retains no runtime holds.
+ */
+static int mtk_disp_va_bootstrap_run(struct mtk_disp_va_bootstrap *b, bool initial)
+{
+	unsigned long deadline;
+	long remaining;
+	unsigned int i;
+	int ret;
+
+	mutex_lock(&b->lock);
+	if (b->state == MTK_DISP_VA_ATTEMPTED) {
+		ret = -EIO;
+		goto unlock;
+	}
+	if (initial && b->initial_done) {
+		ret = iommu_get_domain_for_dev(b->dma_dev) == b->domain ? 0 : -EINVAL;
+		goto unlock;
+	}
+	ret = mtk_va_acquire(b);
+	if (ret)
+		goto unlock;
+	b->state = MTK_DISP_VA_PREPARED;
+	if (initial) {
+		ret = mtk_va_preflight(b);
+	} else {
+		ret = b->initial_done ? 0 : -EINVAL;
+		for (i = 0; !ret && i < ARRAY_SIZE(b->ovl_devs); i++)
+			if (iommu_get_domain_for_dev(b->ovl_devs[i]) != b->domain)
+				ret = -EINVAL;
+	}
+	if (!ret)
+		ret = mtk_va_prepare_packet(b);
+	if (ret) {
+		mtk_va_release_prepared(b);
+		b->state = b->initial_done ? MTK_DISP_VA_TRANSLATED : MTK_DISP_VA_IDLE;
+		goto unlock;
+	}
+	init_completion(&b->done);
+	b->packet_status = -EINPROGRESS;
+	deadline = jiffies + msecs_to_jiffies(100);
+	/* Runtime resume may start prebuilt firmware, so all mapping/boot
+	 * checks must precede this get and any subsequent error is retained.
+	 */
+	b->state = MTK_DISP_VA_ATTEMPTED;
+	ret = pm_runtime_resume_and_get(b->client.chan->mbox->dev);
+	if (ret < 0)
+		goto retained;
+	b->gce_held = true;
+	if (time_after_eq(jiffies, deadline)) {
+		ret = -ETIMEDOUT;
+		goto retained;
+	}
+	ret = cmdq_mbox_disp_va_enable(b->client.chan);
+	if (ret)
+		goto retained;
+	if (time_after_eq(jiffies, deadline)) {
+		ret = -ETIMEDOUT;
+		goto retained;
+	}
+	ret = mbox_send_message(b->client.chan, &b->packet);
+	if (ret < 0)
+		goto retained;
+	mbox_client_txdone(b->client.chan, 0);
+	remaining = (long)(deadline - jiffies);
+	if (remaining <= 0 || !wait_for_completion_timeout(&b->done, remaining)) {
+		ret = -ETIMEDOUT;
+		goto retained;
+	}
+	ret = READ_ONCE(b->packet_status);
+	if (ret)
+		goto retained;
+	/* IRQ callback completion precedes unlink/free/disable. Acquire its
+	 * channel lock through the read-only idle helper before freeing DMA.
+	 */
+	while (!cmdq_mbox_channel_idle(b->client.chan)) {
+		if (time_after_eq(jiffies, deadline)) {
+			ret = -ETIMEDOUT;
+			goto retained;
+		}
+		usleep_range(50, 100);
+	}
+	ret = pm_runtime_put_sync_suspend(b->client.chan->mbox->dev);
+	b->gce_held = false; /* The put consumes the reference even on failure. */
+	if (ret < 0)
+		goto retained;
+	mtk_va_release_prepared(b);
+	b->initial_done = true;
+	b->state = MTK_DISP_VA_TRANSLATED;
+	ret = 0;
+	dev_dbg(b->dev, "VA transaction initial=%u retired; runtime resources released\n", initial);
+	goto unlock;
+retained:
+	dev_err(b->dev, "VA transaction result=%d; unknown completion quarantined until reboot\n", ret);
+unlock:
+	mutex_unlock(&b->lock);
+	return ret;
+}
+
+static void mtk_va_put_device(void *dev)
+{
+	put_device(dev);
+}
+
+static int mtk_va_add_supplier(struct mtk_disp_va_bootstrap *b,
+			       struct device_node *np)
+{
+	struct platform_device *pdev = of_find_device_by_node(np);
+	struct device *supplier;
+	int ret;
+
+	if (!pdev)
+		return -EPROBE_DEFER;
+	supplier = &pdev->dev;
+	if (!device_is_bound(supplier)) {
+		put_device(supplier);
+		return -EPROBE_DEFER;
+	}
+	ret = devm_add_action_or_reset(b->dev, mtk_va_put_device, supplier);
+	if (ret)
+		return ret;
+	if (!device_link_add(b->dev, supplier,
+			     DL_FLAG_PM_RUNTIME | DL_FLAG_AUTOREMOVE_SUPPLIER))
+		return -ENOMEM;
+	b->suppliers[b->num_suppliers++] = supplier;
+	return 0;
+}
+
+static int mtk_va_map_ovl(struct mtk_disp_va_bootstrap *b, unsigned int index,
+			 struct device_node *np)
+{
+	struct resource res;
+	int ret;
+
+	ret = of_address_to_resource(np, 0, &res);
+	if (ret || resource_size(&res) < 0x1000)
+		return -EINVAL;
+	b->ovl[index] = devm_ioremap(b->dev, res.start, 0x1000);
+	return b->ovl[index] ? 0 : -ENOMEM;
+}
+
+static int mtk_va_probe(struct platform_device *pdev)
+{
+	static const unsigned int represented[] = { 0, 1, 2, 4, 5, 6 };
+	static const char * const extra_ovls[] = { "ovl3", "ovl7" };
+	static const char * const postmasks[] = { "postmask0", "postmask1" };
+	struct device *dev = &pdev->dev;
+	struct device_node *np = dev->of_node, *supplier;
+	struct mtk_disp_va_bootstrap *b;
+	struct resource res;
+	unsigned int i;
+	int ret, count;
+
+	b = devm_kzalloc(dev, sizeof(*b), GFP_KERNEL);
+	if (!b)
+		return -ENOMEM;
+	b->dev = dev;
+	mutex_init(&b->lock);
+	b->num_clocks = devm_clk_bulk_get_all(dev, &b->clocks);
+	if (b->num_clocks < 0)
+		return b->num_clocks;
+	/* Eight OVL gates, both POSTMASK gates, GCE_D and GCE 26 MHz. */
+	if (b->num_clocks != 12)
+		return -EINVAL;
+	count = of_count_phandle_with_args(np, "mediatek,suppliers", NULL);
+	if (count != MTK_VA_SUPPLIERS)
+		return -EINVAL;
+	for (i = 0; i < count; i++) {
+		supplier = of_parse_phandle(np, "mediatek,suppliers", i);
+		ret = mtk_va_add_supplier(b, supplier);
+		of_node_put(supplier);
+		if (ret)
+			return dev_err_probe(dev, ret, "bootstrap supplier %u\n", i);
+	}
+	for (i = 0; i < ARRAY_SIZE(represented); i++) {
+		supplier = of_parse_phandle(np, "mediatek,ovls", i);
+		if (!supplier)
+			return -EINVAL;
+		ret = mtk_va_map_ovl(b, represented[i], supplier);
+		if (ret) {
+			of_node_put(supplier);
+			return ret;
+		}
+		{
+			struct platform_device *ovl = of_find_device_by_node(supplier);
+
+			if (!ovl)
+				ret = -EPROBE_DEFER;
+			else {
+				b->ovl_devs[i] = &ovl->dev;
+				if (!i)
+					b->dma_dev = &ovl->dev;
+				ret = devm_add_action_or_reset(dev, mtk_va_put_device,
+						      &ovl->dev);
+			}
+		}
+		of_node_put(supplier);
+		if (ret)
+			return ret;
+	}
+	for (i = 0; i < 2; i++) {
+		struct resource *r;
+
+		r = platform_get_resource_byname(pdev, IORESOURCE_MEM, extra_ovls[i]);
+		if (!r || resource_size(r) < 0x1000)
+			return -EINVAL;
+		b->ovl[3 + 4 * i] = devm_ioremap(dev, r->start, 0x1000);
+		r = platform_get_resource_byname(pdev, IORESOURCE_MEM, postmasks[i]);
+		if (!r || resource_size(r) < 0x1000)
+			return -EINVAL;
+		b->postmask[i] = devm_ioremap(dev, r->start, 0x1000);
+		if (!b->ovl[3 + 4 * i] || !b->postmask[i])
+			return -ENOMEM;
+	}
+	supplier = of_parse_phandle(np, "memory-region", 0);
+	ret = supplier ? of_address_to_resource(supplier, 0, &b->identity) : -EINVAL;
+	if (supplier && !of_property_present(supplier, "no-map"))
+		ret = -EINVAL;
+	of_node_put(supplier);
+	if (ret)
+		return ret;
+	supplier = of_parse_phandle(np, "memory-region", 1);
+	ret = supplier ? of_address_to_resource(supplier, 0, &res) : -EINVAL;
+	if (supplier && !of_property_present(supplier, "no-map"))
+		ret = -EINVAL;
+	of_node_put(supplier);
+	if (ret || res.start != 0x33fe00000ULL || resource_size(&res) != SZ_1M)
+		return -EINVAL;
+	platform_set_drvdata(pdev, b);
+	b->client.client.dev = dev;
+	b->client.client.knows_txdone = true;
+	b->client.client.rx_callback = mtk_va_done;
+	b->client.chan = mbox_request_channel(&b->client.client, 0);
+	if (IS_ERR(b->client.chan))
+		return PTR_ERR(b->client.chan);
+	pm_runtime_enable(dev);
+	return 0;
+}
+
+static int mtk_disp_va_gate(struct device *consumer, bool initial)
+{
+	struct device_node *np;
+	struct platform_device *pdev;
+	struct mtk_disp_va_bootstrap *b;
+	int ret;
+
+	np = of_parse_phandle(consumer->parent->of_node, "mediatek,display-va-bootstrap", 0);
+	if (!np)
+		return 0;
+	pdev = of_find_device_by_node(np);
+	of_node_put(np);
+	if (!pdev)
+		return -EPROBE_DEFER;
+	if (!device_is_bound(&pdev->dev)) {
+		ret = -EPROBE_DEFER;
+		goto put;
+	}
+	/* The dedicated built-in provider has an independent boot lifetime.
+	 * Keep the get_device reference across this synchronous gate. Manual
+	 * provider/supplier removal is unsupported; no master lifetime link
+	 * is needed or used during component-framework probe/bind ordering.
+	 */
+	b = platform_get_drvdata(pdev);
+	ret = b ? mtk_disp_va_bootstrap_run(b, initial) : -EPROBE_DEFER;
+put:
+	put_device(&pdev->dev);
+	return ret;
+}
+
+int mtk_disp_va_bootstrap_gate(struct device *consumer)
+{
+	return mtk_disp_va_gate(consumer, true);
+}
+
+int mtk_disp_va_runtime_gate(struct device *consumer)
+{
+	return mtk_disp_va_gate(consumer, false);
+}
+
+static const struct of_device_id mtk_va_of_match[] = {
+	{ .compatible = "mediatek,mt6897-display-va-bootstrap" },
+	{ }
+};
+
+static struct platform_driver mtk_va_driver = {
+	.probe = mtk_va_probe,
+	.driver = {
+		.name = "mt6897-display-va-bootstrap",
+		.of_match_table = mtk_va_of_match,
+		.suppress_bind_attrs = true,
+	},
+};
+/* Independent lifetime protects quarantined callbacks on DRM bind failure. */
+builtin_platform_driver(mtk_va_driver);
