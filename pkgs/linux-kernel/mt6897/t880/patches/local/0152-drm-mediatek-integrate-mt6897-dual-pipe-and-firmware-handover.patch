+							       ctrlr_path->comp[i].type,
+							       ctrlr_path->comp[i].inst_id);
+				if (!comp || !comp->dev)
+					return -ENODEV;
+				if (comps)
+					comps[n] = comp;
+				n++;
+			}
+		}
+	}
+
