+/*
+ * Dual pipe: the second pipe is described as ordinary output paths that are
+ * this CRTC's shadow paths rather than CRTCs of their own:
+ * - the path that starts with the twin of the first component (the other
+ *   pipe's OVL), and
+ * - a path that ends with the slave of this CRTC's DSI. A controller can
+ *   hold only one segment of a path, and the MT6897 second pipe re-enters
+ *   DISPSYS1 for DSI1, so that last stretch is a path of its own.
+ * Shadow paths must come after this path in the devicetree.
+ */
+static int mtk_crtc_init_shadow_path(struct device *dev, struct mtk_crtc *mtk_crtc,
+				     struct mtk_drm_private *priv, unsigned int path_sel)
+{
+	struct mtk_ddp_comp *first = mtk_crtc->ddp_comp[0];
+	struct mtk_ddp_comp *last = mtk_crtc->ddp_comp[mtk_crtc->ddp_comp_nr - 1];
+	struct mtk_ddp_comp **comps, **all;
+	struct device *twin, *slave = NULL;
+	unsigned int p, total = 0;
+	bool found_twin = false;
+	int n;
+
+	if (first->type != MTK_DISP_OVL && first->type != MTK_DISP_OVL_2L)
+		return 0;
+
+	twin = mtk_ovl_get_twin(first->dev);
+	if (!twin)
+		return 0;
+
+	if (last->type == MTK_DISP_DSI)
+		slave = mtk_dsi_get_slave_dev(last->dev);
+
+	all = devm_kcalloc(dev, MTK_DISP_CONTROLLER_MAX_COMP_PER_PATH * MAX_CRTC,
+			   sizeof(*all), GFP_KERNEL);
+	if (!all)
+		return -ENOMEM;
+
+	for (p = 0; p < MAX_CRTC; p++) {
+		bool is_twin, is_slave;
+
+		if (p == path_sel)
+			continue;
+
+		n = mtk_crtc_gather_path(priv, p, NULL);
+		if (n <= 0)
+			continue;
+
+		comps = devm_kcalloc(dev, n, sizeof(*comps), GFP_KERNEL);
+		if (!comps)
+			return -ENOMEM;
+		mtk_crtc_gather_path(priv, p, comps);
+
+		is_twin = comps[0]->dev == twin;
+		is_slave = slave && comps[n - 1]->dev == slave;
+		if (!is_twin && !is_slave) {
+			devm_kfree(dev, comps);
+			continue;
+		}
+
+		if (p < path_sel) {
+			dev_err(dev, "Dual-pipe shadow path %u precedes its CRTC path %u\n",
+				p, path_sel);
+			devm_kfree(dev, comps);
+			return -EINVAL;
+		}
+
+		if (total + n > BITS_PER_LONG) {
+			devm_kfree(dev, comps);
+			return -E2BIG;
+		}
+
+		found_twin |= is_twin;
+		comps[0]->shadow_head = true;
+		mtk_crtc->shadow_seg_start |= BIT(total);
+		memcpy(&all[total], comps, n * sizeof(*comps));
+		total += n;
+		devm_kfree(dev, comps);
+		dev_info(dev, "Dual pipe: path %u (%d components) is a shadow of path %u\n",
+			 p, n, path_sel);
+	}
+
+	if (!found_twin) {
+		dev_err(dev, "Dual-pipe twin %s is not the head of any output path\n",
+			dev_name(twin));
+		return -ENODEV;
+	}
+
+	mtk_crtc->shadow_comp = all;
+	mtk_crtc->shadow_comp_nr = total;
+	return 0;
+}
+
