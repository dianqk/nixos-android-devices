+static void put_device(struct device *d)
+{
+	assert(d->refs > 0);
+	d->refs--;
+	parent_ref_put++;
+}
+static struct regmap bus_map;
+static struct regmap *
+scpsys_bus_protect_get_regmap(struct scpsys_domain *p,
+			      const struct scpsys_bus_prot_data *b)
+{
+	return &bus_map;
+}
+static struct regmap *
+scpsys_bus_protect_get_sta_regmap(struct scpsys_domain *p,
+				  const struct scpsys_bus_prot_data *b)
+{
+	return &bus_map;
+}
+static int regmap_set_bits(struct regmap *, u32, u32);
+static int regmap_clear_bits(struct regmap *, u32, u32);
+
+static int regmap_set_bits(struct regmap *m, u32 r, u32 mask)
+{
+	u32 v;
+	int ret = regmap_read(m, r, &v);
+	if (ret)
+		return ret;
+	return regmap_write(m, r, v | mask);
+}
+static int regmap_clear_bits(struct regmap *m, u32 r, u32 mask)
+{
+	u32 v;
+	int ret = regmap_read(m, r, &v);
+	if (ret)
+		return ret;
+	return regmap_write(m, r, v & ~mask);
+}
