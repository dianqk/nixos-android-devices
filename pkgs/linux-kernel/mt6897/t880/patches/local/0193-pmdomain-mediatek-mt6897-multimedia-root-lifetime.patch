+static atomic_uint simulated_sd_count;
+static atomic_bool child_started;
+static void *racing_child_fault(void *arg)
+{
+	struct scpsys_domain *child = arg;
+	atomic_fetch_add_explicit(&simulated_sd_count, 1, memory_order_seq_cst);
+	atomic_store_explicit(&child_started, true, memory_order_release);
+	assert(scpsys_direct_root_power_on(&child->genpd) == -EIO);
+	atomic_fetch_sub_explicit(&simulated_sd_count, 1, memory_order_seq_cst);
+	return NULL;
+}
+static void *racing_parent_off(void *unused)
+{
+	while (!atomic_load_explicit(&child_started, memory_order_acquire)) {
+	}
+	while (
+	    atomic_load_explicit(&simulated_sd_count, memory_order_acquire)) {
+	}
+	assert_parent_blocked();
+	return NULL;
+}
+static void test_fault_counter_handoff(void)
+{
+	for (unsigned i = 0; i < 100; i++) {
+		ven_fixture();
+		ven_prepare();
+		struct scpsys_domain d = ven_domain(0);
+		direct_fail_at = 1;
+		atomic_init(&simulated_sd_count, 0);
+		atomic_init(&child_started, false);
+		pthread_t child, parent;
+		assert(!pthread_create(&child, NULL, racing_child_fault, &d));
+		assert(!pthread_create(&parent, NULL, racing_parent_off, NULL));
+		pthread_join(child, NULL);
+		pthread_join(parent, NULL);
+		assert(shared.enabled == 1 && parent_core.enabled == 1);
+	}
+}
+
+int main(void)
+{
+	test_existing_domains();
+	test_ven_preflight();
+	test_pending_parent_handoff();
+	test_ven_lifetime();
+	test_every_ven_access_failure();
+	test_ven_ack_failures();
+	test_unselected_bus_behavior();
+	test_ven_enable_failure();
+	test_fault_counter_handoff();
+	direct_active = false;
+	reset();
+	pthread_mutex_destroy(&controller.local_fault.lock);
+	pthread_mutex_destroy(&parent_provider.dev.lock);
+	pthread_mutex_destroy(&parent_fault.lock);
+	puts("100 host sd-count/fault-lock handoffs passed");
+	puts("selected VEN lifetimes, pure admission, phased ACKs, bus "
+	     "compatibility and parent quarantine passed");
+}
