+		assert(scpsys_get_root_parent(&controller) < 0);
+		assert(!parent_provider.dev.refs && !map.writes &&
+		       !bus_map.writes);
+		scpsys_unprepare_root_clocks(&controller);
+		assert(!shared.prepared && !shared.handles);
