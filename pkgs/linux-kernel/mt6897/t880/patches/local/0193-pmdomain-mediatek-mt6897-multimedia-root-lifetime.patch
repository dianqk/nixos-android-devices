+static const struct scpsys_root_data *scpsys_root_data(struct scpsys *scpsys, u32 id)
+{
+	if (scpsys->soc_data->type == SCPSYS_MTCMOS_TYPE_HW_VOTER)
+		return scpsys->soc_data->hwv_domains_data[id].roots;
+	return scpsys->soc_data->domains_data[id].roots;
+}
+
+/* This lock protects only fault publication. Never retain it over CCF, PM,
+ * MMIO or waits. Child sd_count remains held until its callback returns.
+ */
+static bool scpsys_root_faulted(struct scpsys *scpsys)
+{
+	unsigned long flags;
+	bool failed;
+
+	if (!scpsys->fault)
+		return READ_ONCE(scpsys->quarantined);
+	spin_lock_irqsave(&scpsys->fault->lock, flags);
+	failed = scpsys->fault->failed;
+	spin_unlock_irqrestore(&scpsys->fault->lock, flags);
+	return failed || READ_ONCE(scpsys->quarantined);
+}
+
+static void scpsys_root_set_fault(struct scpsys *scpsys)
+{
+	unsigned long flags;
+
+	if (!scpsys->fault)
+		return;
+	spin_lock_irqsave(&scpsys->fault->lock, flags);
+	scpsys->fault->failed = true;
+	spin_unlock_irqrestore(&scpsys->fault->lock, flags);
+}
+
+static bool scpsys_root_children_pending(struct scpsys_domain *pd)
+{
+	struct scpsys *scpsys = pd->scpsys;
+	unsigned long flags;
+	bool pending;
+
+	if (!scpsys->soc_data->root_bootstrap_guard ||
+	    pd->id != scpsys->soc_data->root_bootstrap_id)
+		return false;
+	spin_lock_irqsave(&scpsys->fault->lock, flags);
+	pending = scpsys->fault->pending_children;
+	spin_unlock_irqrestore(&scpsys->fault->lock, flags);
+	return pending;
+}
+
+static int scpsys_admit_root_children(struct scpsys *scpsys)
+{
+	unsigned long flags;
+	int ret = 0;
+
+	if (!scpsys->soc_data->root_fault_parent)
+		return 0;
+	if (!scpsys->parent_device || !scpsys->roots_admitted || !scpsys->fault)
+		return -EINVAL;
+	spin_lock_irqsave(&scpsys->fault->lock, flags);
+	if (scpsys->fault->failed)
+		ret = -EIO;
+	else
+		scpsys->fault->pending_children = false;
+	spin_unlock_irqrestore(&scpsys->fault->lock, flags);
+	return ret;
+}
+
+static struct platform_driver scpsys_pm_domain_driver;
+
+static int scpsys_get_root_parent(struct scpsys *scpsys)
+{
+	const struct scpsys_soc_data *soc = scpsys->soc_data;
+	struct of_phandle_args args;
+	struct platform_device *pdev;
+	struct scpsys *parent;
+	u32 child;
+	int ret;
+
+	if (!soc->root_fault_parent)
+		return 0;
+	if (of_property_count_u32_elems(scpsys->dev->of_node, "power-domains-child-ids") != 1 ||
+	    of_count_phandle_with_args(scpsys->dev->of_node, "power-domains", "#power-domain-cells") != 1)
+		return -EINVAL;
+	ret = of_property_read_u32(scpsys->dev->of_node, "power-domains-child-ids", &child);
+	if (ret || child != soc->root_fault_child_id)
+		return -EINVAL;
+	ret = of_parse_phandle_with_args(scpsys->dev->of_node, "power-domains",
+					 "#power-domain-cells", 0, &args);
+	if (ret)
+		return ret;
+	if (args.args_count != 1 || args.args[0] != soc->root_fault_parent_id ||
+	    !of_device_is_compatible(args.np, soc->root_fault_parent_compatible)) {
+		of_node_put(args.np);
+		return -EINVAL;
+	}
+	pdev = of_find_device_by_node(args.np);
+	of_node_put(args.np);
+	if (!pdev)
+		return -EPROBE_DEFER;
+	device_lock(&pdev->dev);
+	parent = platform_get_drvdata(pdev);
+	ret = -EPROBE_DEFER;
+	if (!device_is_bound(&pdev->dev) ||
+	    pdev->dev.driver != &scpsys_pm_domain_driver.driver || !parent || !parent->published)
+		goto out;
+	ret = -EINVAL;
+	if (parent->soc_data->type != SCPSYS_MTCMOS_TYPE_HW_VOTER || !parent->fault ||
+	    !parent->soc_data->quarantine_init_failure)
+		goto out;
+	ret = -EIO;
+	if (scpsys_root_faulted(parent))
+		goto out;
+	scpsys->fault = parent->fault;
+	scpsys->parent_device = &pdev->dev;
+	ret = 0;
+out:
+	device_unlock(&pdev->dev);
+	if (ret)
+		put_device(&pdev->dev);
+	return ret;
+}
+
+static int scpsys_validate_direct_root(struct scpsys *scpsys, u32 id)
+{
+	const struct scpsys_domain_data *data = &scpsys->soc_data->domains_data[id];
+	u32 status;
+	int ret;
+
+	/* Only ordinary VEN MTCMOS: no modem, RTFF, supply or subsystem policy. */
+	if (data->caps != MTK_SCPD_KEEP_DEFAULT_OFF ||
+	    data->rtff_type != SCPSYS_RTFF_NONE || data->ext_buck_iso_offs ||
+	    data->pwr_sta_offs != data->ctl_offs ||
+	    data->pwr_sta2nd_offs != data->ctl_offs ||
+	    data->sta_mask != BIT(30) || data->sta2nd_mask != BIT(31) ||
+	    data->sram_pdn_bits != BIT(8) || data->sram_pdn_ack_bits != BIT(12))
+		return -EINVAL;
+	ret = regmap_read(scpsys->base, data->ctl_offs, &status);
+	if (ret) {
+		dev_err(scpsys->dev, "%s: initial power status read failed: %d\n", data->name, ret);
+		return ret;
+	}
+	/* Deliberately conservative default-OFF admission, before any mutation. */
+	if ((status & (BIT(31) | BIT(30) | GENMASK(4, 0))) != (BIT(1) | BIT(4))) {
+		dev_err(scpsys->dev, "%s: initial power state %#x is not verified OFF\n",
+			data->name, status);
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static struct device_node *scpsys_root_voter_node(struct scpsys *scpsys)
+{
+	struct device_node *controller, *voter;
+
+	if (!scpsys->soc_data->root_fault_parent)
+		return of_node_get(scpsys->hwv_node);
+	controller = of_parse_phandle(scpsys->dev->of_node, "power-domains", 0);
+	if (!controller)
+		return NULL;
+	if (!of_device_is_compatible(controller, scpsys->soc_data->root_fault_parent_compatible)) {
+		of_node_put(controller);
+		return NULL;
+	}
+	voter = of_get_parent(controller);
+	of_node_put(controller);
+	return voter;
+}
