Subject: [PATCH] arm64: dts: qcom: add Xiaomi 12S Pro

Describe the board supplies, thermal zones, storage, USB and peripheral
wiring. Each included functional description contains its final configuration.

diff --git a/Documentation/devicetree/bindings/arm/qcom.yaml b/Documentation/devicetree/bindings/arm/qcom.yaml
--- a/Documentation/devicetree/bindings/arm/qcom.yaml
+++ b/Documentation/devicetree/bindings/arm/qcom.yaml
@@ -1128,6 +1128,10 @@
               - sony,pdx223
               - sony,pdx224
           - const: qcom,sm8450
+
+      - items:
+          - const: xiaomi,unicorn
+          - const: qcom,sm8475
 
       - items:
           - enum:
diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -382,6 +382,8 @@
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8450-sony-xperia-nagara-pdx223.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8450-sony-xperia-nagara-pdx224.dtb
 
+dtb-$(CONFIG_ARCH_QCOM)	+= sm8475-xiaomi-unicorn.dtb
+
 sm8550-hdk-display-card-dtbs	:= sm8550-hdk.dtb sm8550-hdk-display-card.dtbo
 sm8550-hdk-display-card-rear-camera-card-dtbs	:= sm8550-hdk.dtb sm8550-hdk-display-card.dtbo sm8550-hdk-rear-camera-card.dtbo
 sm8550-hdk-rear-camera-card-dtbs	:= sm8550-hdk.dtb sm8550-hdk-rear-camera-card.dtbo
diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-audio.dtsi b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-audio.dtsi
new file mode 100644
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-audio.dtsi
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+/* Xiaomi 12S Pro audio wiring, reconstructed from the running vendor DT. */
+
+#include <dt-bindings/sound/qcom,q6dsp-lpass-ports.h>
+
+/ {
+	wcd938x: audio-codec {
+		/* Both WCD938x variants are identified by the driver at probe. */
+		compatible = "qcom,wcd9380-codec";
+		#sound-dai-cells = <1>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&unicorn_wcd_reset>;
+		reset-gpios = <&tlmm 43 GPIO_ACTIVE_LOW>;
+		vdd-buck-supply = <&pm8350_s10>;
+		vdd-rxtx-supply = <&pm8350_s10>;
+		vdd-io-supply = <&pm8350_s10>;
+		vdd-mic-bias-supply = <&vreg_bob>;
+		qcom,micbias1-microvolt = <2750000>;
+		qcom,micbias2-microvolt = <2750000>;
+		qcom,micbias3-microvolt = <2750000>;
+		qcom,micbias4-microvolt = <2750000>;
+		qcom,rx-device = <&wcd_rx>;
+		qcom,tx-device = <&wcd_tx>;
+		qcom,hphl-jack-type-normally-closed;
+		qcom,ground-jack-type-normally-closed;
+		qcom,mbhc-buttons-vthreshold-microvolt =
+			<75000 260000 500000 500000 500000 500000 500000 500000>;
+	};
+};
+
+&sound {
+	compatible = "qcom,sm8475-sndcard", "qcom,sm8450-sndcard";
+	model = "Xiaomi-12S-Pro";
+	audio-routing = "IN1_HPHL", "HPHL_OUT",
+			"IN2_HPHR", "HPHR_OUT",
+			"AMIC1", "MIC BIAS1",
+			"AMIC2", "MIC BIAS2",
+			"AMIC3", "MIC BIAS3",
+			"AMIC4", "MIC BIAS3",
+			"AMIC5", "MIC BIAS4",
+			"TX SWR_INPUT0", "ADC1_OUTPUT",
+			"TX SWR_INPUT1", "ADC2_OUTPUT",
+			"TX SWR_INPUT0", "ADC3_OUTPUT",
+			"TX SWR_INPUT1", "ADC4_OUTPUT";
+	status = "okay";
+
+	wcd-playback-dai-link {
+		link-name = "WCD Playback";
+		cpu {
+			sound-dai = <&q6apmbedai RX_CODEC_DMA_RX_0>;
+		};
+		codec {
+			sound-dai = <&wcd938x 0>, <&swr1 0>, <&rxmacro 0>;
+		};
+		platform {
+			sound-dai = <&q6apm>;
+		};
+	};
+
+	wcd-capture-dai-link {
+		link-name = "WCD Capture";
+		cpu {
+			sound-dai = <&q6apmbedai TX_CODEC_DMA_TX_3>;
+		};
+		codec {
+			sound-dai = <&wcd938x 1>, <&swr2 0>, <&txmacro 0>;
+		};
+		platform {
+			sound-dai = <&q6apm>;
+		};
+	};
+};
+
+&swr1 {
+	status = "okay";
+
+	wcd_rx: codec@0,4 {
+		compatible = "sdw20217010d00";
+		reg = <0 4>;
+		qcom,rx-port-mapping = <1 2 3 4 5>;
+	};
+};
+
+&swr2 {
+	status = "okay";
+
+	wcd_tx: codec@0,3 {
+		compatible = "sdw20217010d00";
+		reg = <0 3>;
+		qcom,tx-port-mapping = <1 1 2 3>;
+	};
+};
+
+&vamacro {
+	status = "okay";
+	qcom,dmic-sample-rate = <600000>;
+	vdd-micb-supply = <&pm8350_s10>;
+};
+
+&tlmm {
+	unicorn_wcd_reset: wcd-reset-state {
+		pins = "gpio43";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+	};
+
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-camera.dtsi b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-camera.dtsi
new file mode 100644
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-camera.dtsi
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-3-Clause)
+/* Existing SoC CCI controllers only. Sensor identities and pipelines are separate. */
+&cci0 {
+	status = "okay";
+};
+
+&cci1 {
+	status = "okay";
+};
+
+/* Digital capture controller; physical PHYs and sensors remain disabled. */
+&camss {
+	status = "okay";
+};
+
+/* PM8008J regulator provider. No camera consumer or LDO boot request. */
+&i2c5 {
+	pm8008j: pmic@c {
+		compatible = "qcom,pm8008";
+		reg = <0xc>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&camera_pmic_enable_default>;
+		vdd-l1-l2-supply = <&pm8350_s12>;
+		vdd-l3-l4-supply = <&vreg_bob>;
+		vdd-l5-supply = <&pm8350c_s1>;
+		vdd-l6-supply = <&vreg_bob>;
+		vdd-l7-supply = <&vreg_bob>;
+
+		/* Name-only constraints: registration must not program voltages. */
+		regulators {
+			pm8008j_l1: ldo1 {
+				regulator-name = "pm8008j_l1";
+			};
+			pm8008j_l2: ldo2 {
+				regulator-name = "pm8008j_l2";
+			};
+			pm8008j_l3: ldo3 {
+				regulator-name = "pm8008j_l3";
+			};
+			pm8008j_l4: ldo4 {
+				regulator-name = "pm8008j_l4";
+			};
+			pm8008j_l5: ldo5 {
+				regulator-name = "pm8008j_l5";
+			};
+			pm8008j_l6: ldo6 {
+				regulator-name = "pm8008j_l6";
+			};
+			pm8008j_l7: ldo7 {
+				regulator-name = "pm8008j_l7";
+			};
+		};
+	};
+};
+
+&tlmm {
+	camera_pmic_enable_default: camera-pmic-enable-state {
+		pins = "gpio11";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+		output-high;
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-display.dtsi b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-display.dtsi
new file mode 100644
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-display.dtsi
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/* Xiaomi 12S Pro display wiring, verified against the running vendor DT. */
+
+/ {
+	panel_vci: regulator-panel-vci {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_vci";
+		regulator-min-microvolt = <3000000>;
+		regulator-max-microvolt = <3000000>;
+		gpio = <&tlmm 75 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	panel_vddio: regulator-panel-vddio {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_vddio";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&tlmm 74 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	panel_vddd: regulator-panel-vddd {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_vddd";
+		regulator-min-microvolt = <1500000>;
+		regulator-max-microvolt = <1500000>;
+		gpio = <&tlmm 25 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+};
+
+&gpu {
+	compatible = "qcom,adreno-730.2", "qcom,adreno";
+	status = "okay";
+};
+
+&gpu_zap_shader {
+	firmware-name = "qcom/sm8475/xiaomi/unicorn/a730_zap.mdt";
+};
+
+&mdss {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	vdda-supply = <&pm8350c_l10>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&panel_te_default>;
+	status = "okay";
+
+	panel: panel@0 {
+		compatible = "xiaomi,l2s-38-0c-0a";
+		reg = <0>;
+		vci-supply = <&panel_vci>;
+		vddio-supply = <&panel_vddio>;
+		vddd-supply = <&panel_vddd>;
+		reset-gpios = <&tlmm 0 GPIO_ACTIVE_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&panel_reset_default>;
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	remote-endpoint = <&panel_in>;
+	data-lanes = <0 1 2 3>;
+};
+
+&mdss_dsi0_phy {
+	vdds-supply = <&pm8350_l5>;
+	status = "okay";
+};
+
+&tlmm {
+	panel_reset_default: panel-reset-default-state {
+		pins = "gpio0";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	panel_te_default: panel-te-default-state {
+		pins = "gpio86";
+		function = "mdp_vsync";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-dsp.dtsi b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-dsp.dtsi
new file mode 100644
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-dsp.dtsi
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+/* Unicorn DSP firmware paths and PMIC battery transport. */
+/ {
+	pmic-glink {
+		compatible = "qcom,sm8450-pmic-glink", "qcom,pmic-glink";
+	};
+};
+
+&remoteproc_adsp {
+	firmware-name = "qcom/sm8475/xiaomi/unicorn/adsp.mdt";
+	status = "okay";
+};
+
+&remoteproc_slpi {
+	firmware-name = "qcom/sm8475/xiaomi/unicorn/slpi.mdt";
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-nfc.dtsi b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-nfc.dtsi
new file mode 100644
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-nfc.dtsi
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-3-Clause)
+/* Actual Unicorn qcom,sn-nci family/wiring; exact SN product remains unknown. */
+&i2c9 {
+	nfc@28 {
+		compatible = "qcom,sn-nci";
+		reg = <0x28>;
+		interrupts-extended = <&tlmm 46 IRQ_TYPE_LEVEL_HIGH>;
+		irq-gpios = <&tlmm 46 GPIO_ACTIVE_HIGH>;
+		enable-gpios = <&tlmm 34 GPIO_ACTIVE_HIGH>;
+		firmware-gpios = <&tlmm 45 GPIO_ACTIVE_HIGH>;
+		clock-request-gpios = <&tlmm 35 GPIO_ACTIVE_HIGH>;
+		vddio-supply = <&pm8350_s10>;
+		pinctrl-names = "default", "active", "sleep";
+		pinctrl-0 = <&unicorn_nfc_sleep>;
+		pinctrl-1 = <&unicorn_nfc_active_control &unicorn_nfc_active_irq>;
+		pinctrl-2 = <&unicorn_nfc_sleep>;
+	};
+};
+
+&tlmm {
+	unicorn_nfc_active_control: nfc-active-control-state {
+		pins = "gpio34", "gpio35", "gpio45";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	unicorn_nfc_active_irq: nfc-active-irq-state {
+		pins = "gpio46";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	/* Native38 measured input baseline, including VEN high after release. */
+	unicorn_nfc_sleep: nfc-sleep-state {
+		pins = "gpio34", "gpio35", "gpio45", "gpio46";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+		output-disable;
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-peripherals.dtsi b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-peripherals.dtsi
new file mode 100644
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-peripherals.dtsi
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-3-Clause)
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+&gpi_dma1 { status = "okay"; };
+&gpi_dma2 { status = "okay"; };
+&qupv3_id_1 { status = "okay"; };
+&qupv3_id_2 { status = "okay"; };
+
+&i2c18 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	haptics: vibrator@5a {
+		compatible = "xiaomi,unicorn-aw86927", "awinic,aw86927";
+		reg = <0x5a>;
+		interrupts-extended = <&tlmm 90 IRQ_TYPE_EDGE_FALLING>;
+		reset-gpios = <&tlmm 89 GPIO_ACTIVE_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&haptics_reset_default>, <&haptics_irq_default>;
+
+	};
+};
+
+&qup_spi13_cs {
+	drive-strength = <6>;
+	bias-disable;
+};
+
+&qup_spi13_data_clk {
+	drive-strength = <6>;
+	bias-disable;
+};
+
+&spi13 {
+	status = "okay";
+
+	/* The vendor driver streams the IR waveform directly over MOSI. */
+	irled@0 {
+		compatible = "ir-spi-led";
+		reg = <0>;
+		spi-max-frequency = <19200000>;
+		duty-cycle = /bits/ 8 <30>;
+	};
+};
+
+&tlmm {
+	haptics_reset_default: haptics-reset-default-state {
+		pins = "gpio89";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	haptics_irq_default: haptics-irq-default-state {
+		pins = "gpio90";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-speakers.dtsi b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-speakers.dtsi
new file mode 100644
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-speakers.dtsi
@@ -0,0 +1,170 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-3-Clause)
+/* Unicorn CS35L41 amplifiers and protected 96 kHz TDM transport. */
+
+&i2c15 {
+	status = "okay";
+
+	cs35l41_bottom: amplifier@40 {
+		compatible = "cirrus,cs35l41";
+		reg = <0x40>;
+		#sound-dai-cells = <1>;
+		interrupts-extended = <&tlmm 117 IRQ_TYPE_LEVEL_LOW>;
+		/* With ACTIVE_HIGH, driver LOW then HIGH asserts then releases reset. */
+		reset-gpios = <&tlmm 120 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&unicorn_amp_bottom_reset &unicorn_amp_bottom_irq>;
+		sound-name-prefix = "B";
+		cirrus,subsystem-id = "xiaomi-unicorn";
+		cirrus,boost-type = <0>;
+		cirrus,boost-peak-milliamp = <4000>;
+		cirrus,boost-ind-nanohenry = <1000>;
+		cirrus,boost-cap-microfarad = <15>;
+		cirrus,asp-sdout-hiz = <3>;
+		cirrus,gpio2-src-select = <4>;
+		cirrus,gpio2-output-enable;
+	};
+
+	cs35l41_top: amplifier@43 {
+		compatible = "cirrus,cs35l41";
+		reg = <0x43>;
+		#sound-dai-cells = <1>;
+		interrupts-extended = <&tlmm 88 IRQ_TYPE_LEVEL_LOW>;
+		reset-gpios = <&tlmm 1 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&unicorn_amp_top_reset &unicorn_amp_top_irq>;
+		sound-name-prefix = "T";
+		cirrus,subsystem-id = "xiaomi-unicorn";
+		cirrus,boost-type = <0>;
+		cirrus,boost-peak-milliamp = <4000>;
+		cirrus,boost-ind-nanohenry = <1000>;
+		cirrus,boost-cap-microfarad = <15>;
+		cirrus,asp-sdout-hiz = <3>;
+		cirrus,gpio2-src-select = <4>;
+		cirrus,gpio2-output-enable;
+	};
+};
+
+&qup_i2c15_data_clk {
+	drive-strength = <2>;
+	bias-pull-up;
+	/delete-property/ bias-disable;
+};
+
+&tlmm {
+	unicorn_amp_bottom_reset: amp-bottom-reset-state {
+		pins = "gpio120";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+		output-high;
+	};
+
+	unicorn_amp_top_reset: amp-top-reset-state {
+		pins = "gpio1";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+		output-high;
+	};
+
+	unicorn_amp_bottom_irq: amp-bottom-irq-state {
+		pins = "gpio117";
+		function = "gpio";
+		drive-strength = <2>;
+		output-disable;
+		bias-pull-up;
+	};
+
+	unicorn_amp_top_irq: amp-top-irq-state {
+		pins = "gpio88";
+		function = "gpio";
+		drive-strength = <2>;
+		output-disable;
+		bias-pull-up;
+	};
+};
+
+/* Expose the per-amplifier prefixed controls. */
+&sound {
+	aux-devs = <&cs35l41_top>, <&cs35l41_bottom>;
+};
+
+/*
+ * Unicorn TDM transport: 96 kHz, three channels in four 32-bit slots.
+ * GPIO52 is not a proven mute and is deliberately not acquired here.
+ * MainAMP endpoints have reversible card pin controls, initially disabled.
+ */
+
+&q6apmbedai {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	dai@38 {
+		reg = <TERTIARY_TDM_RX_0>;
+		clocks = <&q6prmcc LPASS_CLK_ID_TER_TDM_IBIT
+			  LPASS_CLK_ATTRIBUTE_INVERT_COUPLE_NO>;
+		clock-names = "bclk";
+	};
+};
+
+&sound {
+	compatible = "xiaomi,unicorn-sndcard", "qcom,sm8450-sndcard";
+	pinctrl-names = "default", "tdm-active", "tdm-sleep";
+	pinctrl-0 = <&unicorn_tdm_sleep>;
+	pinctrl-1 = <&unicorn_tdm_clk &unicorn_tdm_ws
+		     &unicorn_tdm_data0 &unicorn_tdm_data1>;
+	pinctrl-2 = <&unicorn_tdm_sleep>;
+
+	speaker-playback-dai-link {
+		link-name = "Unicorn Protected Speaker Playback";
+		cpu {
+			sound-dai = <&q6apmbedai TERTIARY_TDM_RX_0>;
+		};
+		codec {
+			sound-dai = <&cs35l41_top 0>, <&cs35l41_bottom 0>;
+		};
+		platform {
+			sound-dai = <&q6apm>;
+		};
+	};
+};
+
+&tlmm {
+	unicorn_tdm_clk: unicorn-tdm-clock-state {
+		pins = "gpio121";
+		function = "mi2s2_sck";
+		drive-strength = <8>;
+		bias-disable;
+		output-high;
+	};
+
+	unicorn_tdm_ws: unicorn-tdm-ws-state {
+		pins = "gpio123";
+		function = "mi2s2_ws";
+		drive-strength = <8>;
+		bias-disable;
+		output-high;
+	};
+
+	unicorn_tdm_data0: unicorn-tdm-data0-state {
+		pins = "gpio122";
+		function = "mi2s2_data0";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	unicorn_tdm_data1: unicorn-tdm-data1-state {
+		pins = "gpio124";
+		function = "mi2s2_data1";
+		drive-strength = <8>;
+		bias-pull-down;
+	};
+
+	unicorn_tdm_sleep: unicorn-tdm-sleep-state {
+		pins = "gpio121", "gpio122", "gpio123", "gpio124";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+		output-disable;
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-thermal.dtsi b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-thermal.dtsi
