+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-thermal.dtsi
@@ -0,0 +1,138 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* ADC channel numbers and scaling are from unicorn's running vendor DT. */
+&pmk8350_vadc {
+	pinctrl-names = "default";
+	pinctrl-0 = <&rear_tof_therm_default>;
+	status = "okay";
+
+	channel@3 {
+		reg = <0x3>;
+		label = "pmk8350_die_temp";
+	};
+
+	channel@103 {
+		reg = <0x103>;
+		label = "pm8350_die_temp";
+	};
+
+	channel@303 {
+		reg = <0x303>;
+		label = "pm8350b_die_temp";
+	};
+
+	channel@403 {
+		reg = <0x403>;
+		label = "pmr735a_die_temp";
+	};
+
+	channel@503 {
+		reg = <0x503>;
+		label = "pmr735b_die_temp";
+	};
+
+	channel@144 {
+		reg = <0x144>;
+		label = "pm8350_msm_therm";
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+	};
+
+	channel@145 {
+		reg = <0x145>;
+		label = "pm8350_cam_flash_therm";
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+	};
+
+	channel@146 {
+		reg = <0x146>;
+		label = "pm8350_hot_pocket_therm";
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+	};
+
+	channel@34d {
+		reg = <0x34d>;
+		label = "pm8350_wide_rfc_therm";
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+	};
+
+	channel@34b {
+		reg = <0x34b>;
+		label = "pm8350b_rear_tof_therm";
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+	};
+
+	channel@44a {
+		reg = <0x44a>;
+		label = "pm8350b_usb_conn_therm";
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+	};
+
+	channel@44b {
+		reg = <0x44b>;
+		label = "pm8350b_wl_chg_therm";
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+	};
+
+	channel@44c {
+		reg = <0x44c>;
+		label = "pmk8350_wifi_therm";
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+	};
+
+	channel@44 {
+		reg = <0x44>;
+		label = "pmk8350_xo_therm";
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+	};
+};
+
+&pm8350b_gpios {
+	rear_tof_therm_default: rear-tof-therm-default-state {
+		pins = "gpio2";
+		function = "normal";
+		bias-high-impedance;
+	};
+};
+
+&pm8350_temp_alarm {
+	io-channels = <&pmk8350_vadc 0x103>;
+	io-channel-names = "thermal";
+};
+
+&pm8350b_temp_alarm {
+	io-channels = <&pmk8350_vadc 0x303>;
+	io-channel-names = "thermal";
+};
+
+&pmr735a_temp_alarm {
+	io-channels = <&pmk8350_vadc 0x403>;
+	io-channel-names = "thermal";
+};
+
+/ {
+	hwmon {
+		compatible = "iio-hwmon";
+		io-channels = <&pmk8350_vadc 0x3>,
+			      <&pmk8350_vadc 0x103>,
+			      <&pmk8350_vadc 0x303>,
+			      <&pmk8350_vadc 0x403>,
+			      <&pmk8350_vadc 0x503>,
+			      <&pmk8350_vadc 0x144>,
+			      <&pmk8350_vadc 0x145>,
+			      <&pmk8350_vadc 0x146>,
+			      <&pmk8350_vadc 0x34d>,
+			      <&pmk8350_vadc 0x34b>,
+			      <&pmk8350_vadc 0x44a>,
+			      <&pmk8350_vadc 0x44b>,
+			      <&pmk8350_vadc 0x44c>,
+			      <&pmk8350_vadc 0x44>;
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-touch.dtsi b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-touch.dtsi
new file mode 100644
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-touch.dtsi
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-3-Clause)
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+&spi4 {
+	status = "okay";
+
+	touchscreen: touchscreen@0 {
+		compatible = "xiaomi,unicorn-touchscreen";
+		reg = <0>;
+		spi-max-frequency = <12000000>;
+
+		interrupt-parent = <&tlmm>;
+		interrupts = <21 IRQ_TYPE_LEVEL_LOW>;
+		reset-gpios = <&tlmm 20 GPIO_ACTIVE_LOW>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&touch_irq_default>, <&touch_reset_default>;
+
+		vdd-supply = <&pm8350c_l2>;
+		avdd-supply = <&pm8350c_l9>;
+
+		touchscreen-size-x = <14400>;
+		touchscreen-size-y = <32000>;
+	};
+};
+
+&tlmm {
+	touch_irq_default: touch-irq-default-state {
+		pins = "gpio21";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-up;
+	};
+
+	touch_reset_default: touch-reset-default-state {
+		pins = "gpio20";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-up;
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-wireless.dtsi b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-wireless.dtsi
new file mode 100644
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-wireless.dtsi
@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Xiaomi 12S Pro PCIe0 and UART20 host wiring from the vendor board DT. */
+
+&pcie0 {
+	status = "okay";
+};
+
+&pcie0_phy {
+	vdda-phy-supply = <&pm8350_l5>;
+	vdda-pll-supply = <&pm8350c_l10>;
+
+	status = "okay";
+};
+
+&qupv3_id_2 {
+	status = "okay";
+};
+
+/* UART20 uses GPIO76 CTS, GPIO77 RTS, GPIO78 TX and GPIO79 RX. */
+&uart20 {
+	pinctrl-0 = <&uart20_default>;
+	pinctrl-names = "default";
+	status = "okay";
+
+	bluetooth {
+		compatible = "qcom,wcn6855-bt";
+		power-sequencers = <&unicorn_radio>;
+	};
+};
+
+&pcieport0 {
+	wifi@0 {
+		compatible = "pci17cb,1103";
+		reg = <0x10000 0 0 0 0>;
+		power-sequencers = <&unicorn_radio>;
+	};
+};
+
+/ {
+	unicorn_radio: radio-power-sequencer {
+		compatible = "xiaomi,unicorn-radio-pwrseq";
+		pinctrl-names = "default", "wlan-active", "wlan-sleep";
+		pinctrl-0 = <&unicorn_wlan_sleep>, <&unicorn_bt_sleep>;
+		pinctrl-1 = <&unicorn_wlan_active>;
+		pinctrl-2 = <&unicorn_wlan_sleep>;
+		wlan-enable-gpios = <&tlmm 80 GPIO_ACTIVE_HIGH>;
+		bt-enable-gpios = <&tlmm 81 GPIO_ACTIVE_HIGH>;
+		swctrl-gpios = <&tlmm 82 GPIO_ACTIVE_HIGH>;
+		xo-clk-gpios = <&tlmm 204 GPIO_ACTIVE_HIGH>;
+		clocks = <&rpmhcc RPMH_RF_CLK3>;
+		vddio-supply = <&pm8350_s10>;
+		vddasd-supply = <&pmr735a_l7>;
+		vddwlan-aon-supply = <&pmr735a_s2>;
+		vdddig-supply = <&pm8350_s11>;
+		vddrfa1-supply = <&pm8350c_s1>;
+		vddrfa2-supply = <&pm8350_s12>;
+	};
+};
+
+&tlmm {
+	unicorn_wlan_sleep: unicorn-wlan-sleep-state {
+		pins = "gpio80";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	unicorn_wlan_active: unicorn-wlan-active-state {
+		pins = "gpio80";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-pull-up;
+	};
+
+	unicorn_bt_sleep: unicorn-bt-sleep-state {
+		pins = "gpio81";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	uart20_default: uart20-default-state {
+		cts-rx-pins {
+			pins = "gpio76", "gpio79";
+			function = "qup20";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		rts-pins {
+			pins = "gpio77";
+			function = "qup20";
+			drive-strength = <2>;
+			bias-pull-down;
+		};
+
+		tx-pins {
+			pins = "gpio78";
+			function = "qup20";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn.dts b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn.dts
new file mode 100644
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn.dts
@@ -0,0 +1,522 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Xiaomi 12S Pro (unicorn), board wiring from the running vendor DT. */
+/dts-v1/;
+
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
+#include "sm8475.dtsi"
+#include "pm8350.dtsi"
+#include "pm8350b.dtsi"
+#include "pm8350c.dtsi"
+#include "pm8450.dtsi"
+#include "pmk8350.dtsi"
+#include "pmr735a.dtsi"
+#include "sm8475-xiaomi-unicorn-wireless.dtsi"
+
+/* These SM8450 reference reservations differ on unicorn. */
+/delete-node/ &adsp_mem;
+/delete-node/ &rmtfs_mem;
+/delete-node/ &xbl_ramdump_mem;
+/delete-node/ &xbl_sc_mem;
+/delete-node/ &oem_vm_mem;
+
+/ {
+	model = "Xiaomi 12S Pro";
+	compatible = "xiaomi,unicorn", "qcom,sm8475";
+	chassis-type = "handset";
+
+	aliases {
+		serial0 = &uart7;
+	};
+
+	chosen {
+		/* USB gadget console is configured by the initramfs. */
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+		pinctrl-names = "default";
+		pinctrl-0 = <&volume_up_default>;
+
+		key-volume-up {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&pm8350_gpios 6 GPIO_ACTIVE_LOW>;
+			debounce-interval = <15>;
+			wakeup-source;
+		};
+	};
+
+
+	vph_pwr: regulator-vph-pwr {
+		compatible = "regulator-fixed";
+		regulator-name = "vph_pwr";
+		regulator-min-microvolt = <3700000>;
+		regulator-max-microvolt = <3700000>;
+		regulator-always-on;
+	};
+
+	reserved-memory {
+
+		xbl_ramdump_mem: memory@a6b80000 {
+			reg = <0 0xa6b80000 0 0x280000>;
+			no-map;
+		};
+
+		adsp_mem: memory@9fd00000 {
+			reg = <0 0x9fd00000 0 0x3100000>;
+			no-map;
+		};
+
+		/* xbl_sc_mem2 in sm8450.dtsi already reserves 0xa6e00000. */
+		ramoops@a7000000 {
+			compatible = "ramoops";
+			reg = <0 0xa7000000 0 0x400000>;
+			console-size = <0x200000>;
+			pmsg-size = <0x200000>;
+		};
+
+		/* Bootloader scanout buffer; dimensions are not assumed. */
+		splash_region: memory@b8000000 {
+			reg = <0 0xb8000000 0 0x2b00000>;
+			no-map;
+		};
+
+		trusted_apps_mem: memory@ea000000 {
+			reg = <0 0xea000000 0 0x3900000>;
+			no-map;
+		};
+
+		trusted_apps_ext_mem: memory@ed900000 {
+			reg = <0 0xed900000 0 0x3b00000>;
+			no-map;
+		};
+	};
+};
+
+/* RAM banks are populated by the bootloader for the installed RAM SKU. */
+
+&apps_rsc {
+	regulators-0 {
+		compatible = "qcom,pm8350-rpmh-regulators";
+		qcom,pmic-id = "b";
+
+		pm8350_s10: smps10 {
+			regulator-name = "pm8350_s10";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+		};
+
+		pm8350_s11: smps11 {
+			regulator-name = "pm8350_s11";
+			regulator-min-microvolt = <966000>;
+			regulator-max-microvolt = <1170000>;
+		};
+
+		pm8350_s12: smps12 {
+			regulator-name = "pm8350_s12";
+			regulator-min-microvolt = <1350000>;
+			regulator-max-microvolt = <2024000>;
+		};
+
+		pm8350_l1: ldo1 {
+			regulator-name = "pm8350_l1";
+			regulator-min-microvolt = <830000>;
+			regulator-max-microvolt = <920000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		pm8350_l2: ldo2 {
+			regulator-name = "pm8350_l2";
+			regulator-min-microvolt = <3075000>;
+			regulator-max-microvolt = <3300000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		pm8350_l3: ldo3 {
+			regulator-name = "pm8350_l3";
+			regulator-min-microvolt = <870000>;
+			regulator-max-microvolt = <970000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		pm8350_l5: ldo5 {
+			regulator-name = "pm8350_l5";
+			regulator-min-microvolt = <880000>;
+			regulator-max-microvolt = <958000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		pm8350_l6: ldo6 {
+			regulator-name = "pm8350_l6";
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1216000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		pm8350_l7: ldo7 {
+			regulator-name = "pm8350_l7";
+			regulator-min-microvolt = <2400000>;
+			regulator-max-microvolt = <3544000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		pm8350_l9: ldo9 {
+			regulator-name = "pm8350_l9";
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1304000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+	};
+
+	regulators-1 {
+		compatible = "qcom,pm8350c-rpmh-regulators";
+		qcom,pmic-id = "c";
+
+		pm8350c_s1: smps1 {
+			regulator-name = "pm8350c_s1";
+			regulator-min-microvolt = <1900000>;
+			regulator-max-microvolt = <2024000>;
+		};
+
+		pm8350c_s10: smps10 {
+			regulator-name = "pm8350c_s10";
+			regulator-min-microvolt = <1052000>;
+			regulator-max-microvolt = <1170000>;
+		};
+
+		pm8350c_l1: ldo1 {
+			/* Firmware has no ldoc1 resource; no board consumers. */
+			status = "disabled";
+			regulator-name = "pm8350c_l1";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1980000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		pm8350c_l2: ldo2 {
+			regulator-name = "pm8350c_l2";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		pm8350c_l3: ldo3 {
+			regulator-name = "pm8350c_l3";
+			regulator-min-microvolt = <2700000>;
+			regulator-max-microvolt = <3544000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		pm8350c_l4: ldo4 {
+			regulator-name = "pm8350c_l4";
+			regulator-min-microvolt = <1620000>;
+			regulator-max-microvolt = <3300000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		pm8350c_l5: ldo5 {
+			regulator-name = "pm8350c_l5";
+			regulator-min-microvolt = <1620000>;
+			regulator-max-microvolt = <3300000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		pm8350c_l6: ldo6 {
+			regulator-name = "pm8350c_l6";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <3544000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		pm8350c_l7: ldo7 {
+			regulator-name = "pm8350c_l7";
+			regulator-min-microvolt = <3000000>;
+			regulator-max-microvolt = <3544000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		pm8350c_l8: ldo8 {
+			regulator-name = "pm8350c_l8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <2000000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		pm8350c_l9: ldo9 {
+			regulator-name = "pm8350c_l9";
+			regulator-min-microvolt = <3224000>;
+			regulator-max-microvolt = <3224000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		pm8350c_l10: ldo10 {
+			regulator-name = "pm8350c_l10";
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1304000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		pm8350c_l11: ldo11 {
+			regulator-name = "pm8350c_l11";
+			regulator-min-microvolt = <3008000>;
+			regulator-max-microvolt = <3008000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-always-on;
+			regulator-boot-on;
+		};
+
+		pm8350c_l12: ldo12 {
+			regulator-name = "pm8350c_l12";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1980000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		pm8350c_l13: ldo13 {
+			regulator-name = "pm8350c_l13";
+			regulator-min-microvolt = <2700000>;
+			regulator-max-microvolt = <3544000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_bob: pm8350c_bob: bob {
+			regulator-name = "pm8350c_bob";
+			regulator-min-microvolt = <3296000>;
+			regulator-max-microvolt = <3296000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
+		};
+	};
+
+	regulators-2 {
+		compatible = "qcom,pm8450-rpmh-regulators";
+		qcom,pmic-id = "h";
+
+		pm8450_s3: smps3 {
+			regulator-name = "pm8450_s3";
+			regulator-min-microvolt = <470000>;
+			regulator-max-microvolt = <570000>;
+		};
