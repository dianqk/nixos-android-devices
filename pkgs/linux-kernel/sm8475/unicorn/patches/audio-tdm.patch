+/*
+ * The Unicorn transport uses 96 kHz, three channels in four 32-bit slots.
+ * The device mux combines stereo with an independent ultrasound
+ * input. This transport requires an explicit three-channel frontend; ordinary
+ * playback must supply zero in its third channel. Channel maps here only
+ * select per-DAI channel counts, not sample or physical slot positions.
+ */
+static struct snd_soc_dai_link_ch_map unicorn_tdm_ch_maps[] = {
+	{ .cpu = 0, .codec = 0, .cpu_ch_mask = 0x7, .codec_ch_mask = 0x3 },
+	{ .cpu = 0, .codec = 1, .cpu_ch_mask = 0x7, .codec_ch_mask = 0x3 },
+};
+
+static const struct snd_kcontrol_new unicorn_controls[] = {
+	SOC_DAPM_PIN_SWITCH("T SPK"),
+	SOC_DAPM_PIN_SWITCH("B SPK"),
+};
+
+static const struct snd_soc_dapm_widget unicorn_dapm_widgets[] = {
+	SND_SOC_DAPM_HP("Headphone Jack", NULL),
+	SND_SOC_DAPM_MIC("Mic Jack", NULL),
+	SND_SOC_DAPM_SPK("DP0 Jack", NULL),
+	SND_SOC_DAPM_SPK("DP1 Jack", NULL),
+	SND_SOC_DAPM_SPK("DP2 Jack", NULL),
+	SND_SOC_DAPM_SPK("DP3 Jack", NULL),
+	SND_SOC_DAPM_SPK("DP4 Jack", NULL),
+	SND_SOC_DAPM_SPK("DP5 Jack", NULL),
+	SND_SOC_DAPM_SPK("DP6 Jack", NULL),
+	SND_SOC_DAPM_SPK("DP7 Jack", NULL),
+	SND_SOC_DAPM_PINCTRL("Unicorn TDM Pins", "tdm-active", "tdm-sleep"),
+};
+
+static const struct snd_soc_dapm_route unicorn_dapm_routes[] = {
+	{ "Tertiary TDM0 Playback", NULL, "Unicorn TDM Pins" },
+};
+
+static int unicorn_snd_init(struct snd_soc_pcm_runtime *rtd)
+{
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	struct snd_soc_dapm_context *dapm = snd_soc_card_to_dapm(rtd->card);
+	int ret;
+
+	if (cpu_dai->id != TERTIARY_TDM_RX_0)
+		return 0;
+	if (rtd->dai_link->num_cpus != 1 || rtd->dai_link->num_codecs != 2)
+		return -EINVAL;
+
+	rtd->dai_link->ch_maps = unicorn_tdm_ch_maps;
+	ret = snd_soc_dapm_disable_pin(dapm, "T SPK");
+	if (ret)
+		return ret;
+
+	/* Reversible pin controls stay off until protected output is validated. */
+	return snd_soc_dapm_disable_pin(dapm, "B SPK");
+}
+
+static int unicorn_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
+				      struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	struct snd_interval *rate = hw_param_interval(params,
+					SNDRV_PCM_HW_PARAM_RATE);
+	struct snd_interval *channels = hw_param_interval(params,
+					SNDRV_PCM_HW_PARAM_CHANNELS);
+	struct snd_mask *fmt = hw_param_mask(params, SNDRV_PCM_HW_PARAM_FORMAT);
+
+	if (cpu_dai->id == TERTIARY_TDM_RX_0) {
+		rate->min = rate->max = 96000;
+		channels->min = channels->max = 3;
+		snd_mask_none(fmt);
+		snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S24_LE);
+	}
+
+	return 0;
+}
+
+static int unicorn_tdm_hw_params(struct snd_pcm_substream *substream,
+				 struct snd_pcm_hw_params *params)
+{
+	static const unsigned int top_rx_slots[] = { 0, 2 };
+	static const unsigned int bottom_rx_slots[] = { 1, 4 };
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	struct snd_soc_dai *codec_dai;
+	unsigned int tx_slot, bclk = 96000 * 4 * 32;
+	const unsigned int *rx_slots;
+	const char *prefix;
+	int i, ret;
+
+	if (cpu_dai->id != TERTIARY_TDM_RX_0)
+		return sc8280xp_tdm_hw_params(substream, params);
+
+	if (params_rate(params) != 96000 || params_channels(params) != 3 ||
+	    params_format(params) != SNDRV_PCM_FORMAT_S24_LE)
+		return -EINVAL;
+
+	ret = snd_soc_dai_set_fmt(cpu_dai, SND_SOC_DAIFMT_BP_FP);
+	if (ret)
+		return ret;
+
+	ret = snd_soc_dai_set_tdm_slot(cpu_dai, 0, 0x7, 4, 32);
+	if (ret)
+		return ret;
+
+	for_each_rtd_codec_dais(rtd, i, codec_dai) {
+		ret = of_property_read_string(codec_dai->dev->of_node,
+					      "sound-name-prefix", &prefix);
+		if (ret)
+			return ret;
+
+		if (!strcmp(prefix, "T")) {
+			rx_slots = top_rx_slots;
+			tx_slot = 0;
+		} else if (!strcmp(prefix, "B")) {
+			rx_slots = bottom_rx_slots;
+			tx_slot = 1;
+		} else {
+			return -EINVAL;
+		}
+
+		/* Keep 24 valid bits in each 32-bit slot on both ends of the bus. */
+		ret = snd_soc_dai_set_tdm_slot(codec_dai, 0, 0, 4, 32);
+		if (ret)
+			return ret;
+
+		/* The vendor mixer leaves bottom ASPRX2 unused by its DSP. */
+		ret = snd_soc_dai_set_channel_map(codec_dai, 1, &tx_slot,
+						  2, rx_slots);
+		if (ret)
+			return ret;
+
+		ret = snd_soc_dai_set_fmt(codec_dai, SND_SOC_DAIFMT_CBC_CFC |
+					  SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_DSP_A);
+		if (ret)
+			return ret;
+
+		/* Component callback programs the PLL; DAI callback sets FS_MON. */
+		ret = snd_soc_component_set_sysclk(codec_dai->component,
+						   CS35L41_CLKID_SCLK, 0, bclk,
+						   SND_SOC_CLOCK_IN);
+		if (ret)
+			return ret;
+
+		ret = snd_soc_dai_set_sysclk(codec_dai, CS35L41_CLKID_SCLK,
+					     bclk, SND_SOC_CLOCK_IN);
+		if (ret)
+			return ret;
+	}
+
+	/* The clock DT specifier must use INVERT_COUPLE_NO, as downstream. */
+	return snd_soc_dai_set_sysclk(cpu_dai, LPAIF_MI2S_BCLK, bclk,
+				      SND_SOC_CLOCK_OUT);
 }
 
