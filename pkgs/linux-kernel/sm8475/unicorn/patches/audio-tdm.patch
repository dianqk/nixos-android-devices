+static int audioreach_widget_tdm_module_load(struct audioreach_module *mod,
+					     const struct snd_soc_tplg_vendor_array *mod_array)
+{
+	static const u32 tokens[] = {
+		AR_TKN_U32_MODULE_HW_IF_TYPE,
+		AR_TKN_U32_MODULE_HW_IF_IDX,
+		AR_TKN_U32_MODULE_FMT_DATA,
+		AR_TKN_U16_MODULE_SYNC_SRC,
+		AR_TKN_U16_MODULE_CTRL_DATA_OUT_ENABLE,
+		AR_TKN_U32_MODULE_SLOT_MASK,
+		AR_TKN_U16_MODULE_NSLOTS_PER_FRAME,
+		AR_TKN_U16_MODULE_SLOT_WIDTH,
+		AR_TKN_U16_MODULE_SYNC_MODE,
+		AR_TKN_U16_MODULE_CTRL_INVERT_SYNC_PULSE,
+		AR_TKN_U16_MODULE_CTRL_SYNC_DATA_DELAY,
+		AR_TKN_U32_MODULE_ACTIVE_LANE_MASK,
+		AR_TKN_U32_MODULE_HW_CLK_ATTR,
+	};
+	u32 count = le32_to_cpu(mod_array->num_elems);
+	u32 size = le32_to_cpu(mod_array->size);
+	u32 values[ARRAY_SIZE(tokens)] = { 0 };
+	unsigned long present = 0;
+	unsigned int i, j;
+
+	if (le32_to_cpu(mod_array->type) != SND_SOC_TPLG_TUPLE_TYPE_WORD ||
+	    size < sizeof(*mod_array) ||
+	    count != (size - sizeof(*mod_array)) / sizeof(*mod_array->value) ||
+	    (size - sizeof(*mod_array)) % sizeof(*mod_array->value))
+		return -EINVAL;
+
+	for (i = 0; i < count; i++) {
+		for (j = 0; j < ARRAY_SIZE(tokens); j++) {
+			if (le32_to_cpu(mod_array->value[i].token) != tokens[j])
+				continue;
+
+			if (present & BIT(j))
+				return -EINVAL;
+			values[j] = le32_to_cpu(mod_array->value[i].value);
+			present |= BIT(j);
+			break;
+		}
+	}
+
+	/* A zero value can be valid; an absent physical configuration cannot. */
+	if ((present & GENMASK(10, 0)) != GENMASK(10, 0))
+		return -EINVAL;
+
+	for (i = 3; i < 11; i++) {
+		if (i != 5 && values[i] > U16_MAX)
+			return -EINVAL;
+	}
+
+	/* Omitted lane configuration retains the DSP single-lane default. */
+	if ((present & BIT(11)) && (!values[11] || values[11] > U16_MAX))
+		return -EINVAL;
+
+	if (values[12] && values[12] != 4)
+		return -EINVAL;
+
+	mod->hw_interface_type = values[0];
+	mod->hw_interface_idx = values[1];
+	mod->data_format = values[2];
+	mod->sync_src = values[3];
+	mod->ctrl_data_out_enable = values[4];
+	mod->slot_mask = values[5];
+	mod->nslots_per_frame = values[6];
+	mod->slot_width = values[7];
+	mod->sync_mode = values[8];
+	mod->ctrl_invert_sync_pulse = values[9];
+	mod->ctrl_sync_data_delay = values[10];
+	mod->active_lane_mask = values[11];
+	mod->hw_clk_attr = values[12];
+
+	return audioreach_tdm_validate_config(mod, mod->slot_mask,
+					     mod->nslots_per_frame, mod->slot_width);
+}
