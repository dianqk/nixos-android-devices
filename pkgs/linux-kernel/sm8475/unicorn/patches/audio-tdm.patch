+/* Validate TDM before common parsing allocates graph, container or module state. */
+static int audioreach_widget_tdm_preflight(const struct snd_soc_tplg_private *private)
+{
+	const u8 *data = (const u8 *)private->array;
+	u32 remaining = le32_to_cpu(private->size);
+
+	while (remaining) {
+		const struct snd_soc_tplg_vendor_array *array = (const void *)data;
+		u32 size, type, count, i;
+
+		if (remaining < sizeof(*array))
+			return -EINVAL;
+		size = le32_to_cpu(array->size);
+		if (size < sizeof(*array) || size > remaining)
+			return -EINVAL;
+
+		type = le32_to_cpu(array->type);
+		if (type == SND_SOC_TPLG_TUPLE_TYPE_WORD ||
+		    type == SND_SOC_TPLG_TUPLE_TYPE_BOOL ||
+		    type == SND_SOC_TPLG_TUPLE_TYPE_BYTE ||
+		    type == SND_SOC_TPLG_TUPLE_TYPE_SHORT) {
+			count = le32_to_cpu(array->num_elems);
+			if (count != (size - sizeof(*array)) / sizeof(*array->value) ||
+			    (size - sizeof(*array)) % sizeof(*array->value))
+				return -EINVAL;
+
+			for (i = 0; i < count; i++) {
+				struct audioreach_module module = { 0 };
+				u32 id = le32_to_cpu(array->value[i].value);
+				int ret;
+
+				if (le32_to_cpu(array->value[i].token) != AR_TKN_U32_MODULE_ID ||
+				    (id != MODULE_ID_TDM_SINK && id != MODULE_ID_TDM_SOURCE))
+					continue;
+
+				ret = audioreach_widget_tdm_module_load(&module, array);
+				if (ret)
+					return ret;
+			}
+		}
+		data += size;
+		remaining -= size;
+	}
+
+	return 0;
+}
