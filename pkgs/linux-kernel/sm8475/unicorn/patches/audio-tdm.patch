+int audioreach_tdm_validate_config(const struct audioreach_module *module,
+				   u32 slot_mask, u16 slots, u16 slot_width)
+{
+	if (module->hw_interface_type > 4 || module->hw_interface_idx > 4 ||
+	    module->data_format != DATA_FORMAT_FIXED_POINT ||
+	    module->sync_src > 1 || module->ctrl_data_out_enable > 1 ||
+	    module->sync_mode > 2 || module->ctrl_invert_sync_pulse > 1 ||
+	    module->ctrl_sync_data_delay > 2 || module->active_lane_mask > U16_MAX ||
+	    (module->hw_clk_attr && module->hw_clk_attr != 4))
+		return -EINVAL;
+
+	if (!slots || slots > 32 || !slot_mask ||
+	    (slot_width != 16 && slot_width != 24 && slot_width != 32))
+		return -EINVAL;
+
+	if (slot_mask & ~GENMASK(slots - 1, 0))
+		return -EINVAL;
+
+	return 0;
+}
+
+static int audioreach_tdm_set_media_format(struct q6apm_graph *graph,
+					   const struct audioreach_module *module,
+					   const struct audioreach_module_config *cfg)
+{
+	struct apm_module_frame_size_factor_cfg *fs_cfg;
+	struct apm_module_hw_ep_mf_cfg *hw_cfg;
+	struct apm_tdm_module_intf_cfg *intf_cfg;
+	struct apm_tdm_module_lane_cfg *lane_cfg;
+	struct apm_module_hw_intf_clk_cfg *clk_cfg;
+	u32 slot_mask = cfg->slot_mask ? cfg->slot_mask : module->slot_mask;
+	u16 slots = cfg->nslots_per_frame ? cfg->nslots_per_frame : module->nslots_per_frame;
+	u16 slot_width = cfg->slot_width ? cfg->slot_width : module->slot_width;
+	int size = APM_TDM_INTF_CFG_PSIZE + APM_HW_EP_CFG_PSIZE + APM_FS_CFG_PSIZE;
+	void *p;
+	int ret;
+
+	ret = audioreach_tdm_validate_config(module, slot_mask, slots, slot_width);
+	if (ret)
+		return ret;
+
+	if (!cfg->sample_rate || !cfg->num_channels ||
+	    cfg->num_channels != hweight32(slot_mask) || cfg->bit_width > slot_width ||
+	    (cfg->bit_width != 16 && cfg->bit_width != 24 && cfg->bit_width != 32))
+		return -EINVAL;
+
+	if (module->active_lane_mask)
+		size += APM_TDM_LANE_CFG_PSIZE;
+	if (module->hw_clk_attr)
+		size += APM_HW_INTF_CLK_CFG_PSIZE;
+
+	struct gpr_pkt *pkt __free(kfree) = audioreach_alloc_apm_cmd_pkt(size, APM_CMD_SET_CFG, 0);
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
+
+	p = (void *)pkt + GPR_HDR_SIZE + APM_CMD_HDR_SIZE;
+	/* Apply optional endpoint defaults before its tagged interface config. */
+	if (module->active_lane_mask) {
+		lane_cfg = p;
+		lane_cfg->param_data.module_instance_id = module->instance_id;
+		lane_cfg->param_data.param_id = PARAM_ID_TDM_LANE_CFG;
+		lane_cfg->param_data.param_size = sizeof(lane_cfg->cfg);
+		lane_cfg->cfg.lane_mask = module->active_lane_mask;
+		lane_cfg->cfg.reserved = 0;
+		p += APM_TDM_LANE_CFG_PSIZE;
+	}
+
+	if (module->hw_clk_attr) {
+		clk_cfg = p;
+		clk_cfg->param_data.module_instance_id = module->instance_id;
+		clk_cfg->param_data.param_id = PARAM_ID_HW_INTF_CLK_CFG;
+		clk_cfg->param_data.param_size = sizeof(clk_cfg->cfg);
+		/* Let the endpoint select its clock ID/frequency, as in ACDB. */
+		clk_cfg->cfg.clock_id = 0;
+		clk_cfg->cfg.clock_freq = 0;
+		clk_cfg->cfg.clock_attri = module->hw_clk_attr;
+		clk_cfg->cfg.clock_root = 0;
+		p += APM_HW_INTF_CLK_CFG_PSIZE;
+	}
+
+	intf_cfg = p;
+	intf_cfg->param_data.module_instance_id = module->instance_id;
+	intf_cfg->param_data.param_id = PARAM_ID_TDM_INTF_CFG;
+	/* Parameter bytes exclude the padding before the next 8-byte boundary. */
+	intf_cfg->param_data.param_size = sizeof(intf_cfg->cfg);
+	intf_cfg->cfg.lpaif_type = module->hw_interface_type;
+	intf_cfg->cfg.intf_idx = module->hw_interface_idx;
+	intf_cfg->cfg.sync_src = module->sync_src;
+	intf_cfg->cfg.ctrl_data_out_enable = module->ctrl_data_out_enable;
+	intf_cfg->cfg.slot_mask = slot_mask;
+	intf_cfg->cfg.nslots_per_frame = slots;
+	intf_cfg->cfg.slot_width = slot_width;
+	intf_cfg->cfg.sync_mode = module->sync_mode;
+	intf_cfg->cfg.ctrl_invert_sync_pulse = module->ctrl_invert_sync_pulse;
+	intf_cfg->cfg.ctrl_sync_data_delay = module->ctrl_sync_data_delay;
+	intf_cfg->cfg.reserved = 0;
+
+	p += APM_TDM_INTF_CFG_PSIZE;
+	hw_cfg = p;
+	hw_cfg->param_data.module_instance_id = module->instance_id;
+	hw_cfg->param_data.param_id = PARAM_ID_HW_EP_MF_CFG;
+	hw_cfg->param_data.param_size = sizeof(hw_cfg->mf);
+	hw_cfg->mf.sample_rate = cfg->sample_rate;
+	hw_cfg->mf.bit_width = cfg->bit_width;
+	hw_cfg->mf.num_channels = cfg->num_channels;
+	hw_cfg->mf.data_format = module->data_format;
+
+	p += APM_HW_EP_CFG_PSIZE;
+	fs_cfg = p;
+	fs_cfg->param_data.module_instance_id = module->instance_id;
+	fs_cfg->param_data.param_id = PARAM_ID_HW_EP_FRAME_SIZE_FACTOR;
+	fs_cfg->param_data.param_size = sizeof(fs_cfg->frame_size_factor);
+	fs_cfg->frame_size_factor = 1;
+
+
+	return q6apm_send_cmd_sync(graph->apm, pkt, 0);
+}
