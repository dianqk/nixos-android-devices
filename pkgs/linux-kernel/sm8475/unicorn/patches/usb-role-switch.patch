Subject: [PATCH] arm64: dts: qcom: unicorn: connect the USB2 role switch to UCSI

Unicorn's OEM xiaomi-sm8475-common.dtsi connects the USB controller to the
PMIC GLINK Type-C connector. Use the upstream UCSI graph for the same
connection, retain the external NXP USB2 repeater and peripheral fallback.
Power negotiation belongs to the ADSP charger service. No USB3/DP wiring
or analog audio switch supply is inferred from another board.

Source: LineageOS/android_kernel_xiaomi_sm8450-devicetrees,
2e649a7f3e762903eedad43d8256b91e28b512d8, qcom/xiaomi-sm8475-common.dtsi.
Analog FSA4480 and GPIO42 routing need separate hardware validation.

---
diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-dsp.dtsi b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-dsp.dtsi
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-dsp.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-dsp.dtsi
@@ -3,6 +3,21 @@
 / {
 	pmic-glink {
 		compatible = "qcom,sm8450-pmic-glink", "qcom,pmic-glink";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		connector@0 {
+			compatible = "usb-c-connector";
+			reg = <0>;
+			power-role = "dual";
+			data-role = "dual";
+
+			port {
+				unicorn_usb_hs: endpoint {
+					remote-endpoint = <&usb_1_dwc3_hs>;
+				};
+			};
+		};
 	};
 };
 
diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn.dts b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn.dts
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn.dts
@@ -477,7 +477,9 @@
 &usb_1 {
 	/* The handset uses an external USB2 repeater, no wired USB3 path. */
 	qcom,select-utmi-as-pipe-clk;
-	dr_mode = "peripheral";
+	dr_mode = "otg";
+	usb-role-switch;
+	role-switch-default-mode = "peripheral";
 	maximum-speed = "high-speed";
 	phys = <&usb_1_hsphy>;
 	phy-names = "usb2-phy";
@@ -525,3 +527,7 @@
 &crypto {
 	status = "disabled";
 };
+
+&usb_1_dwc3_hs {
+	remote-endpoint = <&unicorn_usb_hs>;
+};
