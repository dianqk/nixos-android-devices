 	return 0;
diff --git a/drivers/power/sequencing/Kconfig b/drivers/power/sequencing/Kconfig
--- a/drivers/power/sequencing/Kconfig
+++ b/drivers/power/sequencing/Kconfig
@@ -12,6 +12,15 @@
 	  If unsure, say no.
 
 if POWER_SEQUENCING
+
+config POWER_SEQUENCING_XIAOMI_UNICORN
+	tristate "Xiaomi 12S Pro external radio power sequence"
+	depends on ARCH_QCOM && OF && REGULATOR && GPIOLIB && COMMON_CLK
+	help
+	  Control the measured external PMIC supplies, RF clock and enable
+	  GPIOs shared by WLAN and Bluetooth on the Xiaomi 12S Pro.
+	  Consumers use an explicit power-sequencers phandle, without
+	  requiring an inferred model of the radio package's internal rails.
 
 config POWER_SEQUENCING_QCOM_WCN
 	tristate "Qualcomm WCN family PMU driver"
