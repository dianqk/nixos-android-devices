diff --git a/Documentation/devicetree/bindings/power/xiaomi,unicorn-radio-pwrseq.yaml b/Documentation/devicetree/bindings/power/xiaomi,unicorn-radio-pwrseq.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/xiaomi,unicorn-radio-pwrseq.yaml
@@ -0,0 +1,86 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/xiaomi,unicorn-radio-pwrseq.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Xiaomi 12S Pro external radio power sequencing
+
+maintainers:
+  - dwuggh <dwuggh@gmail.com>
+
+description: |
+  The Unicorn board supplies its QCA6490 WLAN/Bluetooth package through six
+  physical PMIC rails, a shared RF clock and WLAN_EN, BT_EN and XO selection
+  signals. This board-level provider describes those measured external
+  connections without inferring the package's internal regulator outputs.
+  Consumers refer to this node with their power-sequencers phandle.
+
+properties:
+  compatible:
+    const: xiaomi,unicorn-radio-pwrseq
+
+  clocks:
+    maxItems: 1
+
+  pinctrl-names:
+    items:
+      - const: default
+      - const: wlan-active
+      - const: wlan-sleep
+
+  pinctrl-0: true
+  pinctrl-1: true
+  pinctrl-2: true
+
+  wlan-enable-gpios:
+    maxItems: 1
+
+  bt-enable-gpios:
+    maxItems: 1
+
+  swctrl-gpios:
+    maxItems: 1
+    description: Input indicating the BT clock supply state.
+
+  xo-clk-gpios:
+    maxItems: 1
+    description: XO selection latch signal, asserted around either enable edge.
+
+  vddio-supply:
+    description: Shared PM8350 S10 1.8 V input.
+
+  vddasd-supply:
+    description: Shared PMR735A L7 2.8 V antenna switch supply.
+
+  vddwlan-aon-supply:
+    description: WLAN PMR735A S2 input.
+
+  vdddig-supply:
+    description: Shared PM8350 S11 input, also used by the BT AON and RF domains.
+
+  vddrfa1-supply:
+    description: Shared PM8350C S1 RF input.
+
+  vddrfa2-supply:
+    description: Shared PM8350 S12 RF input.
+
+required:
+  - compatible
+  - clocks
+  - pinctrl-names
+  - pinctrl-0
+  - pinctrl-1
+  - pinctrl-2
+  - wlan-enable-gpios
+  - bt-enable-gpios
+  - swctrl-gpios
+  - xo-clk-gpios
+  - vddio-supply
+  - vddasd-supply
+  - vddwlan-aon-supply
+  - vdddig-supply
+  - vddrfa1-supply
+  - vddrfa2-supply
+
+additionalProperties: false
