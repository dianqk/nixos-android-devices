Subject: [PATCH] arm64: dts: qcom: unicorn: describe all RX SoundWire ports

The RX manager reports six output ports and one input. The inherited SM8450
configuration has no inputs and six-element arrays. Preserve the six tested
playback configurations and append the binding's invalid/not-applicable
sentinels for the unused input; do not renumber existing playback DAIs.

diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-audio.dtsi b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-audio.dtsi
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-audio.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-audio.dtsi
@@ -74,6 +74,18 @@
 &swr1 {
 	status = "okay";
 
+	/* Six playback ports followed by one unused hardware input port. */
+	qcom,din-ports = <1>;
+	qcom,ports-sinterval = /bits/ 16 <0x03 0x3f 0x1f 0x07 0x00 0x18f 0xffff>;
+	qcom,ports-offset1 = /bits/ 8 <0x00 0x00 0x0b 0x01 0x00 0x00 0xff>;
+	qcom,ports-offset2 = /bits/ 8 <0x00 0x00 0x0b 0x00 0x00 0x00 0xff>;
+	qcom,ports-hstart = /bits/ 8 <0xff 0x03 0xff 0xff 0xff 0x08 0xff>;
+	qcom,ports-hstop = /bits/ 8 <0xff 0x06 0xff 0xff 0xff 0x08 0xff>;
+	qcom,ports-word-length = /bits/ 8 <0x01 0x07 0x04 0xff 0xff 0x0f 0xff>;
+	qcom,ports-block-pack-mode = /bits/ 8 <0xff 0x00 0x01 0xff 0xff 0x00 0xff>;
+	qcom,ports-block-group-count = /bits/ 8 <0xff 0xff 0xff 0xff 0x00 0x00 0xff>;
+	qcom,ports-lane-control = /bits/ 8 <0x01 0x00 0x00 0x00 0x00 0x00 0xff>;
+
 	wcd_rx: codec@0,4 {
 		compatible = "sdw20217010d00";
 		reg = <0 4>;
