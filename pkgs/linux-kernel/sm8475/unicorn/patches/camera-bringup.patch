Subject: [PATCH] media: unicorn: isolate sensor binding and add IMX707 C-PHY

Identify OV32B40 with the OEM word read and log CCI message failures.
Create media links and subdev nodes as each sensor binds, with scoped
rollback and unbind cleanup. Keep chip identification mandatory at probe
and every capture restart.

Backport the generic C-PHY API and Qualcomm PHY plumbing from George
Neacsu's v3 series (20261016-x1e-cphy-rfc-v3, patches 1-6). Adapt CAMSS
to the pinned 7.3-rc6 interfaces and the SM8450 CSID 680 receiver.

Use a distinct Unicorn PHY compatible with the OEM v2.1.3-xiaomi-l2s
trio initialization, settle register count 30 and ordered CDR tables, not X1E's
v2.1.2 C-PHY data. The stock IMX707 4096x3072 RAW10 mode and controls
use three trios, with auxiliary DT0x30 filtered by CSID's DT0x2b match.

Register provenance and hardware acceptance status are documented in
docs/unicorn/camera.md in nixos-android-devices. This patch does not
claim that the pre-existing OV32B40 NACK has been resolved on hardware.

diff --git a/Documentation/devicetree/bindings/phy/qcom,x1e80100-csi2-phy.yaml b/Documentation/devicetree/bindings/phy/qcom,x1e80100-csi2-phy.yaml
index 7c9015a..c7c4eae 100644
--- a/Documentation/devicetree/bindings/phy/qcom,x1e80100-csi2-phy.yaml
+++ b/Documentation/devicetree/bindings/phy/qcom,x1e80100-csi2-phy.yaml
@@ -17,6 +17,7 @@ description:
 properties:
   compatible:
     oneOf:
+      - const: xiaomi,unicorn-csi2-phy
       - const: qcom,x1e80100-csi2-phy
       - items:
           - enum:
@@ -106,6 +107,22 @@ properties:
               - data-lanes
               - remote-endpoint
 
+            allOf:
+              - if:
+                  properties:
+                    bus-type:
+                      const: 1
+                  required:
+                    - bus-type
+                then:
+                  properties:
+                    data-lanes:
+                      maxItems: 3
+                      items:
+                        maximum: 3
+                    clock-lanes: false
+                    lane-polarities: false
+
         allOf:
           - if:
               required:
diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-camera.dtsi b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-camera.dtsi
index 83f5659..91a035b 100644
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-camera.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-camera.dtsi
@@ -1,5 +1,6 @@
 // SPDX-License-Identifier: (GPL-2.0-only OR BSD-3-Clause)
-/* Stock Unicorn routing and supplies; main IMX707 requires C-PHY support. */
+#include <dt-bindings/media/video-interfaces.h>
+/* Stock Unicorn routing, supplies and 19.2 MHz sensor modules. */
 &cci0 {
 	status = "okay";
 };
@@ -51,9 +52,13 @@ pm8008j_l5: ldo5 {
 			};
 			pm8008j_l6: ldo6 {
 				regulator-name = "pm8008j_l6";
+				regulator-min-microvolt = <3104000>;
+				regulator-max-microvolt = <3104000>;
 			};
 			pm8008j_l7: ldo7 {
 				regulator-name = "pm8008j_l7";
+				regulator-min-microvolt = <3104000>;
+				regulator-max-microvolt = <3104000>;
 			};
 		};
 	};
@@ -291,3 +296,102 @@ camera_front_reset: camera-front-reset-state {
 	};
 
 };
+
+/ {
+	camera_main_avdd: regulator-camera-main-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "camera_main_avdd";
+		regulator-min-microvolt = <1860000>;
+		regulator-max-microvolt = <1860000>;
+		gpio = <&tlmm 70 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <100>;
+	};
+
+	camera_main_dvdd: regulator-camera-main-dvdd {
+		compatible = "regulator-fixed";
+		regulator-name = "camera_main_dvdd";
+		regulator-min-microvolt = <1250000>;
+		regulator-max-microvolt = <1250000>;
+		vin-supply = <&pm8350_s12>;
+		gpio = <&tlmm 2 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <100>;
+	};
+};
+
+&cci0_i2c1 {
+	status = "okay";
+	clock-frequency = <400000>;
+
+	camera_main: camera@10 {
+		compatible = "xiaomi,unicorn-imx707";
+		reg = <0x10>;
+		clocks = <&camcc CAM_CC_MCLK2_CLK>;
+		clock-frequency = <19200000>;
+		assigned-clocks = <&camcc CAM_CC_MCLK2_CLK>;
+		assigned-clock-rates = <19200000>;
+		pinctrl-names = "default", "sleep";
+		pinctrl-0 = <&cam2_default &camera_main_reset>;
+		pinctrl-1 = <&cam2_sleep &camera_main_reset>;
+		reset-gpios = <&tlmm 126 GPIO_ACTIVE_LOW>;
+		avdd-supply = <&camera_main_avdd>;
+		dvdd-supply = <&camera_main_dvdd>;
+		iovdd-supply = <&pm8008j_l5>;
+		afvdd-supply = <&pm8008j_l7>;
+		auxvdd-supply = <&pm8008j_l6>;
+		rotation = <90>;
+		orientation = <1>;
+
+		port {
+			camera_main_ep: endpoint {
+				remote-endpoint = <&csiphy2_in_ep>;
+				bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
+				data-lanes = <1 2 3>;
+				link-frequencies = /bits/ 64 <857600000>;
+			};
+		};
+	};
+};
+
+&csiphy2 {
+	compatible = "xiaomi,unicorn-csi2-phy";
+	status = "okay";
+};
+
+&csiphy2_in_ep {
+	remote-endpoint = <&camera_main_ep>;
+	bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
+	data-lanes = <1 2 3>;
+};
+
+&camss_csiphy2_inep {
+	bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
+	data-lanes = <1 2 3>;
+};
+
+&tlmm {
+	camera_main_reset: camera-main-reset-state {
+		pins = "gpio126";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+};
+
+/* Stock Unicorn MCLK signal drive strength; SoC defaults are 2 mA. */
+&cam2_default {
+	drive-strength = <4>;
+};
+
+&cam2_sleep {
+	drive-strength = <4>;
+};
+
+&cam5_default {
+	drive-strength = <4>;
+};
+
+&cam5_sleep {
+	drive-strength = <4>;
+};
