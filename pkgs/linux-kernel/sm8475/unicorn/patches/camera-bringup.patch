+	for (i = 0; i < count; i++) {
+		u32 val = regs[i].reg_data;
+
+		switch (regs[i].param_type) {
+		case CSIPHY_DNP_PARAMS:
+			continue;
+		case CSIPHY_SETTLE_CNT_LOWER_BYTE:
+			val = settle & 0xff;
+			break;
+		case CSIPHY_SETTLE_CNT_HIGHER_BYTE:
+			val = settle >> 8;
+			break;
+		}
