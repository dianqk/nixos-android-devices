diff --git a/drivers/media/i2c/unicorn-sensors.c b/drivers/media/i2c/unicorn-sensors.c
new file mode 100644
--- /dev/null
+++ b/drivers/media/i2c/unicorn-sensors.c
@@ -0,0 +1,591 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Xiaomi 12S Pro D-PHY sensors: two S5KJN1 modules and OV32B40. */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+
+struct unicorn_reg {
+	u32 reg;
+	u32 val;
+	u32 delay_us;
+};
+
+#include "unicorn-sensor-regs.h"
+
+struct unicorn_sensor_info {
+	const char *name;
+	const struct unicorn_reg *init;
+	u32 init_count;
+	const struct unicorn_reg *mode;
+	u32 mode_count;
+	u32 chip_id_reg;
+	u32 chip_id;
+	u32 width, height, hts, vts, pixel_rate;
+	u32 code;
+	s64 link_freq;
+	u32 exposure_reg, vts_reg, gain_reg;
+	u32 exposure_min, exposure_margin, exposure_default;
+	u32 gain_min, gain_max, gain_step;
+	struct v4l2_rect native, crop;
+	bool omnivision;
+};
+
+static const struct unicorn_sensor_info unicorn_s5kjn1 = {
+	.name = "s5kjn1-unicorn",
+	.init = s5kjn1_init, .init_count = ARRAY_SIZE(s5kjn1_init),
+	.mode = s5kjn1_mode, .mode_count = ARRAY_SIZE(s5kjn1_mode),
+	.chip_id_reg = CCI_REG16(0x0000), .chip_id = 0x38e1,
+	.width = 4080, .height = 3072, .hts = 5888, .vts = 3162,
+	/* VT: 19.2 MHz / 3 * 131 / 6 * 4. OP: 19.2 MHz / 3 * 136. */
+	.pixel_rate = 558933333, .link_freq = 870400000,
+	.code = MEDIA_BUS_FMT_SGRBG10_1X10,
+	.exposure_reg = CCI_REG16(0x0202), .vts_reg = CCI_REG16(0x0340),
+	.gain_reg = CCI_REG16(0x0204),
+	.exposure_min = 8, .exposure_margin = 12, .exposure_default = 256,
+	.gain_min = 32, .gain_max = 2048, .gain_step = 1,
+	.native = { .width = 8192, .height = 6176 },
+	.crop = { .left = 16, .top = 16, .width = 8160, .height = 6144 },
+};
+
+static const struct unicorn_sensor_info unicorn_ov32b40 = {
+	.name = "ov32b40-unicorn",
+	.init = ov32b40_init, .init_count = ARRAY_SIZE(ov32b40_init),
+	.mode = ov32b40_mode, .mode_count = ARRAY_SIZE(ov32b40_mode),
+	.chip_id_reg = CCI_REG24(0x300a), .chip_id = 0x563242,
+	.width = 3264, .height = 2448, .hts = 720 * 6, .vts = 5332,
+	/* OEM output clock; HTS is expressed in six-pixel units. */
+	.pixel_rate = 673920000, .link_freq = 842400000,
+	.code = MEDIA_BUS_FMT_SBGGR10_1X10,
+	.exposure_reg = CCI_REG24(0x3500), .vts_reg = CCI_REG16(0x380e),
+	.gain_reg = CCI_REG16(0x3508),
+	.exposure_min = 16, .exposure_margin = 16, .exposure_default = 2560,
+	/* Register gain is 1/256; 16-unit steps also cover gains above 8x. */
+	.gain_min = 256, .gain_max = 4080, .gain_step = 16,
+	.native = { .width = 6560, .height = 4928 },
+	.crop = { .left = 16, .top = 16, .width = 6528, .height = 4896 },
+	.omnivision = true,
+};
+
+struct unicorn_sensor {
+	struct device *dev;
+	const struct unicorn_sensor_info *info;
+	struct regmap *regmap;
+	struct clk *clk;
+	struct gpio_desc *reset;
+	struct regulator *avdd, *dvdd, *iovdd;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *exposure, *vblank;
+	bool streaming;
+};
+
+static struct unicorn_sensor *to_unicorn(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct unicorn_sensor, sd);
+}
+
+static int unicorn_write_table(struct unicorn_sensor *sensor,
+			       const struct unicorn_reg *regs, unsigned int count)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < count; i++) {
+		ret = cci_write(sensor->regmap, regs[i].reg, regs[i].val, NULL);
+		if (ret)
+			return ret;
+		if (regs[i].delay_us)
+			usleep_range(regs[i].delay_us, regs[i].delay_us + 1000);
+	}
+	return 0;
+}
+
+static int unicorn_power_off(struct device *dev)
+{
+	struct unicorn_sensor *sensor = to_unicorn(dev_get_drvdata(dev));
+
+	if (!sensor->info->omnivision) {
+		clk_disable_unprepare(sensor->clk);
+		usleep_range(1000, 2000);
+	}
+	gpiod_set_value_cansleep(sensor->reset, 1);
+	usleep_range(1000, 2000);
+	if (sensor->info->omnivision) {
+		clk_disable_unprepare(sensor->clk);
+		usleep_range(1000, 2000);
+		regulator_disable(sensor->dvdd);
+		regulator_disable(sensor->iovdd);
+		regulator_disable(sensor->avdd);
+		return 0;
+	}
+	regulator_disable(sensor->avdd);
+	usleep_range(3000, 4000);
+	regulator_disable(sensor->dvdd);
+	usleep_range(1000, 2000);
+	regulator_disable(sensor->iovdd);
+	return 0;
+}
+
+static int unicorn_power_on(struct device *dev)
+{
+	struct unicorn_sensor *sensor = to_unicorn(dev_get_drvdata(dev));
+	int ret;
+
+	gpiod_set_value_cansleep(sensor->reset, 1);
+	usleep_range(1000, 2000);
+	/* Keep the stock order: JN1 I/O -> digital -> analog; OV analog -> I/O -> digital. */
+	if (sensor->info->omnivision) {
+		ret = regulator_enable(sensor->avdd);
+		if (ret)
+			return ret;
+		usleep_range(1000, 2000);
+	}
+	ret = regulator_enable(sensor->iovdd);
+	if (ret)
+		goto disable_avdd;
+	usleep_range(1000, 2000);
+	ret = regulator_enable(sensor->dvdd);
+	if (ret)
+		goto disable_iovdd;
+	usleep_range(5000, 6000);
+	if (!sensor->info->omnivision) {
+		ret = regulator_enable(sensor->avdd);
+		if (ret)
+			goto disable_dvdd;
+		usleep_range(3000, 4000);
+		gpiod_set_value_cansleep(sensor->reset, 0);
+		usleep_range(5000, 6000);
+	}
+	ret = clk_prepare_enable(sensor->clk);
+	if (ret)
+		goto assert_reset;
+	if (sensor->info->omnivision) {
+		usleep_range(1000, 2000);
+		gpiod_set_value_cansleep(sensor->reset, 0);
+	}
+	usleep_range(10000, 11000);
+	return 0;
+
+assert_reset:
+	gpiod_set_value_cansleep(sensor->reset, 1);
+	if (!sensor->info->omnivision)
+		regulator_disable(sensor->avdd);
+disable_dvdd:
+	regulator_disable(sensor->dvdd);
+disable_iovdd:
+	regulator_disable(sensor->iovdd);
+disable_avdd:
+	if (sensor->info->omnivision)
+		regulator_disable(sensor->avdd);
+	return ret;
+}
+
+static int unicorn_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct unicorn_sensor *sensor = container_of(ctrl->handler,
+						    struct unicorn_sensor, ctrls);
+	const struct unicorn_sensor_info *info = sensor->info;
+	u32 reg, val;
+	int ret, release_ret;
+
+	if (ctrl->id == V4L2_CID_VBLANK)
+		__v4l2_ctrl_modify_range(sensor->exposure, info->exposure_min,
+			info->height + ctrl->val - info->exposure_margin, 1,
+			info->exposure_default);
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		reg = info->exposure_reg;
+		val = ctrl->val;
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		reg = info->gain_reg;
+		val = ctrl->val;
+		break;
+	case V4L2_CID_VBLANK:
+		reg = info->vts_reg;
+		val = info->height + ctrl->val;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	if (!pm_runtime_get_if_in_use(sensor->dev))
+		return 0;
+
+	/* Hold/release even on a failed write, so a recoverable I2C error cannot
+	 * leave all subsequent exposure updates latched indefinitely.
+	 */
+	ret = cci_write(sensor->regmap,
+		info->omnivision ? CCI_REG8(0x3208) : CCI_REG8(0x0104),
+		info->omnivision ? 3 : 1, NULL);
+	cci_write(sensor->regmap, reg, val, &ret);
+	release_ret = cci_write(sensor->regmap,
+		info->omnivision ? CCI_REG8(0x3208) : CCI_REG8(0x0104),
+		info->omnivision ? 0x13 : 0, NULL);
+	if (info->omnivision)
+		cci_write(sensor->regmap, CCI_REG8(0x3208), 0xa3, &release_ret);
+	pm_runtime_put_autosuspend(sensor->dev);
+	return ret ? ret : release_ret;
+}
+
+static const struct v4l2_ctrl_ops unicorn_ctrl_ops = {
+	.s_ctrl = unicorn_set_ctrl,
+};
+
+static int unicorn_init_controls(struct unicorn_sensor *sensor)
+{
+	const struct unicorn_sensor_info *info = sensor->info;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl_handler *hdl = &sensor->ctrls;
+	struct v4l2_ctrl *ctrl;
+	u32 hblank = info->hts - info->width;
+	int ret;
+
+	v4l2_ctrl_handler_init(hdl, 8);
+	ctrl = v4l2_ctrl_new_int_menu(hdl, NULL, V4L2_CID_LINK_FREQ, 0, 0,
+				      &info->link_freq);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	v4l2_ctrl_new_std(hdl, NULL, V4L2_CID_PIXEL_RATE,
+			  info->pixel_rate, info->pixel_rate, 1, info->pixel_rate);
+	ctrl = v4l2_ctrl_new_std(hdl, NULL, V4L2_CID_HBLANK,
+				hblank, hblank, 1, hblank);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	sensor->vblank = v4l2_ctrl_new_std(hdl, &unicorn_ctrl_ops, V4L2_CID_VBLANK,
+		info->vts - info->height, 0xffff - info->height, 1,
+		info->vts - info->height);
+	sensor->exposure = v4l2_ctrl_new_std(hdl, &unicorn_ctrl_ops, V4L2_CID_EXPOSURE,
+		info->exposure_min, info->vts - info->exposure_margin, 1,
+		info->exposure_default);
+	v4l2_ctrl_new_std(hdl, &unicorn_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+		info->gain_min, info->gain_max, info->gain_step, info->gain_min);
+	if (hdl->error)
+		return hdl->error;
+	ret = v4l2_fwnode_device_parse(sensor->dev, &props);
+	if (ret)
+		return ret;
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, &unicorn_ctrl_ops, &props);
+	if (ret)
+		return ret;
+	sensor->sd.ctrl_handler = hdl;
+	sensor->sd.state_lock = hdl->lock;
+	return 0;
+}
+
+static void unicorn_format(struct unicorn_sensor *sensor,
+			   struct v4l2_mbus_framefmt *format)
+{
+	*format = (struct v4l2_mbus_framefmt) {
+		.width = sensor->info->width, .height = sensor->info->height,
+		.code = sensor->info->code, .field = V4L2_FIELD_NONE,
+		.colorspace = V4L2_COLORSPACE_RAW,
+		.quantization = V4L2_QUANTIZATION_FULL_RANGE,
+		.xfer_func = V4L2_XFER_FUNC_NONE,
+	};
+}
+
+static int unicorn_init_state(struct v4l2_subdev *sd,
+			      struct v4l2_subdev_state *state)
+{
+	unicorn_format(to_unicorn(sd), v4l2_subdev_state_get_format(state, 0));
+	return 0;
+}
+
+static int unicorn_set_fmt(struct v4l2_subdev *sd,
+			   struct v4l2_subdev_state *state,
+			   struct v4l2_subdev_format *fmt)
+{
+	struct unicorn_sensor *sensor = to_unicorn(sd);
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE && sensor->streaming)
+		return -EBUSY;
+	unicorn_format(sensor, &fmt->format);
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+	return 0;
+}
+
+static int unicorn_enum_code(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state,
+			     struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+	code->code = to_unicorn(sd)->info->code;
+	return 0;
+}
+
+static int unicorn_enum_size(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state,
+			     struct v4l2_subdev_frame_size_enum *fse)
+{
+	const struct unicorn_sensor_info *info = to_unicorn(sd)->info;
+
+	if (fse->index || fse->code != info->code)
+		return -EINVAL;
+	fse->min_width = fse->max_width = info->width;
+	fse->min_height = fse->max_height = info->height;
+	return 0;
+}
+
+static int unicorn_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	const struct unicorn_sensor_info *info = to_unicorn(sd)->info;
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r = info->native;
+		return 0;
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r = info->crop;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int unicorn_enable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  u32 pad, u64 streams_mask)
+{
+	struct unicorn_sensor *sensor = to_unicorn(sd);
+	const struct unicorn_sensor_info *info = sensor->info;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sensor->dev);
+	if (ret < 0)
+		return ret;
+	ret = unicorn_write_table(sensor, info->init, info->init_count);
+	if (ret)
+		goto power_down;
+	ret = unicorn_write_table(sensor, info->mode, info->mode_count);
+	if (ret)
+		goto power_down;
+	/* JN1 native GRBG order; do not silently set the OEM's 180-degree flip. */
+	if (!info->omnivision)
+		cci_write(sensor->regmap, CCI_REG8(0x0101), 0, &ret);
+	if (ret)
+		goto power_down;
+	ret = __v4l2_ctrl_handler_setup(&sensor->ctrls);
+	cci_write(sensor->regmap, CCI_REG8(0x0100), 1, &ret);
+	if (ret)
+		goto power_down;
+	sensor->streaming = true;
+	return 0;
+
+power_down:
+	cci_write(sensor->regmap, CCI_REG8(0x0100), 0, NULL);
+	pm_runtime_put_sync_suspend(sensor->dev);
+	return ret;
+}
+
+static int unicorn_disable_streams(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *state,
+				   u32 pad, u64 streams_mask)
+{
+	struct unicorn_sensor *sensor = to_unicorn(sd);
+	int ret;
+
+	ret = cci_write(sensor->regmap, CCI_REG8(0x0100), 0, NULL);
+	/* Let the last frame drain before an immediate stream restart. */
+	usleep_range(35000, 36000);
+	sensor->streaming = false;
+	pm_runtime_put_sync_suspend(sensor->dev);
+	return ret;
+}
+
+static const struct v4l2_subdev_pad_ops unicorn_pad_ops = {
+	.enum_mbus_code = unicorn_enum_code,
+	.enum_frame_size = unicorn_enum_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = unicorn_set_fmt,
+	.get_selection = unicorn_get_selection,
+	.enable_streams = unicorn_enable_streams,
+	.disable_streams = unicorn_disable_streams,
+};
+
+static const struct v4l2_subdev_video_ops unicorn_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_ops unicorn_subdev_ops = {
+	.pad = &unicorn_pad_ops,
+	.video = &unicorn_video_ops,
+};
+
+static const struct v4l2_subdev_internal_ops unicorn_internal_ops = {
+	.init_state = unicorn_init_state,
+};
+
+static const struct media_entity_operations unicorn_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+static int unicorn_check_endpoint(struct unicorn_sensor *sensor)
+{
+	struct v4l2_fwnode_endpoint ep = { .bus_type = V4L2_MBUS_CSI2_DPHY };
+	struct fwnode_handle *fwnode;
+	unsigned long bitmap;
+	int ret;
+
+	fwnode = fwnode_graph_get_next_endpoint(dev_fwnode(sensor->dev), NULL);
+	if (!fwnode)
+		return -EINVAL;
+	ret = v4l2_fwnode_endpoint_alloc_parse(fwnode, &ep);
+	fwnode_handle_put(fwnode);
+	if (ret)
+		return ret;
+	if (ep.bus.mipi_csi2.num_data_lanes != 4) {
+		ret = -EINVAL;
+		goto out;
+	}
+	ret = v4l2_link_freq_to_bitmap(sensor->dev, ep.link_frequencies,
+		ep.nr_of_link_frequencies, &sensor->info->link_freq, 1, &bitmap);
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+	return ret;
+}
+
+static int unicorn_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct unicorn_sensor *sensor;
+	u64 id;
+	int ret;
+
+	sensor = devm_kzalloc(dev, sizeof(*sensor), GFP_KERNEL);
+	if (!sensor)
+		return -ENOMEM;
+	sensor->dev = dev;
+	sensor->info = i2c_get_match_data(client);
+	v4l2_i2c_subdev_init(&sensor->sd, client, &unicorn_subdev_ops);
+	snprintf(sensor->sd.name, sizeof(sensor->sd.name), "%s %d-%04x",
+		sensor->info->name, i2c_adapter_id(client->adapter), client->addr);
+	sensor->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(sensor->regmap))
+		return dev_err_probe(dev, PTR_ERR(sensor->regmap), "CCI regmap\n");
+	sensor->clk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(sensor->clk))
+		return dev_err_probe(dev, PTR_ERR(sensor->clk), "MCLK\n");
+	if (clk_get_rate(sensor->clk) != 19200000)
+		return dev_err_probe(dev, -EINVAL, "19.2 MHz MCLK required\n");
+	ret = unicorn_check_endpoint(sensor);
+	if (ret)
+		return dev_err_probe(dev, ret, "invalid CSI endpoint\n");
+	sensor->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(sensor->reset))
+		return dev_err_probe(dev, PTR_ERR(sensor->reset), "reset GPIO\n");
+	sensor->avdd = devm_regulator_get(dev, "avdd");
+	if (IS_ERR(sensor->avdd))
+		return dev_err_probe(dev, PTR_ERR(sensor->avdd), "AVDD\n");
+	sensor->dvdd = devm_regulator_get(dev, "dvdd");
+	if (IS_ERR(sensor->dvdd))
+		return dev_err_probe(dev, PTR_ERR(sensor->dvdd), "DVDD\n");
+	sensor->iovdd = devm_regulator_get(dev, "iovdd");
+	if (IS_ERR(sensor->iovdd))
+		return dev_err_probe(dev, PTR_ERR(sensor->iovdd), "IOVDD\n");
+	ret = unicorn_power_on(dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "power on\n");
+	ret = cci_read(sensor->regmap, sensor->info->chip_id_reg, &id, NULL);
+	if (!ret && id != sensor->info->chip_id) {
+		dev_err(dev, "unexpected sensor ID 0x%llx\n", id);
+		ret = -ENODEV;
+	}
+	if (ret)
+		goto power_off;
+	ret = unicorn_init_controls(sensor);
+	if (ret)
+		goto free_controls;
+	sensor->sd.internal_ops = &unicorn_internal_ops;
+	sensor->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sensor->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	sensor->sd.entity.ops = &unicorn_entity_ops;
+	sensor->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&sensor->sd.entity, 1, &sensor->pad);
+	if (ret)
+		goto free_controls;
+	ret = v4l2_subdev_init_finalize(&sensor->sd);
+	if (ret)
+		goto cleanup_entity;
+	ret = pm_runtime_set_active(dev);
+	if (ret)
+		goto cleanup_subdev;
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	ret = v4l2_async_register_subdev_sensor(&sensor->sd);
+	if (ret)
+		goto disable_pm;
+	pm_runtime_put_autosuspend(dev);
+	return 0;
+
+disable_pm:
+	pm_runtime_disable(dev);
+	pm_runtime_put_noidle(dev);
+	pm_runtime_set_suspended(dev);
+cleanup_subdev:
+	v4l2_subdev_cleanup(&sensor->sd);
+cleanup_entity:
+	media_entity_cleanup(&sensor->sd.entity);
+free_controls:
+	v4l2_ctrl_handler_free(&sensor->ctrls);
+power_off:
+	unicorn_power_off(dev);
+	return ret;
+}
+
+static void unicorn_remove(struct i2c_client *client)
+{
+	struct unicorn_sensor *sensor = to_unicorn(i2c_get_clientdata(client));
+
+	v4l2_async_unregister_subdev(&sensor->sd);
+	v4l2_subdev_cleanup(&sensor->sd);
+	media_entity_cleanup(&sensor->sd.entity);
+	v4l2_ctrl_handler_free(&sensor->ctrls);
+	pm_runtime_disable(sensor->dev);
+	if (!pm_runtime_status_suspended(sensor->dev))
+		unicorn_power_off(sensor->dev);
+	pm_runtime_set_suspended(sensor->dev);
+}
+
+static const struct dev_pm_ops unicorn_pm_ops = {
+	SET_RUNTIME_PM_OPS(unicorn_power_off, unicorn_power_on, NULL)
+};
+
+static const struct of_device_id unicorn_of_match[] = {
+	{ .compatible = "xiaomi,unicorn-s5kjn1", .data = &unicorn_s5kjn1 },
+	{ .compatible = "xiaomi,unicorn-ov32b40", .data = &unicorn_ov32b40 },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, unicorn_of_match);
+
+static struct i2c_driver unicorn_driver = {
+	.driver = {
+		.name = "unicorn-sensors",
+		.of_match_table = unicorn_of_match,
+		.pm = pm_ptr(&unicorn_pm_ops),
+	},
+	.probe = unicorn_probe,
+	.remove = unicorn_remove,
+};
+module_i2c_driver(unicorn_driver);
+
+MODULE_DESCRIPTION("Xiaomi 12S Pro S5KJN1 and OV32B40 sensors");
+MODULE_LICENSE("GPL");
