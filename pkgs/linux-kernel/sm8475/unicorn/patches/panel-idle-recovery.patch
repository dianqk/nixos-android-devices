+
+/* Caller holds ctx->lock; never recurse into the backlight update lock. */
+static int l2s_write_brightness_locked(struct l2s_panel *ctx)
+{
+	unsigned long mode_flags = ctx->dsi->mode_flags;
+	int ret;
+
+	lockdep_assert_held(&ctx->lock);
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_dcs_set_display_brightness_large(ctx->dsi, ctx->brightness);
+	ctx->dsi->mode_flags = mode_flags;
+	return ret;
