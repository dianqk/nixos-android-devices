 static int l2s_idle_exit(struct drm_panel *panel)
 {
 	struct l2s_panel *ctx = to_l2s_panel(panel);
-	int ret = 0;
-	mutex_lock(&ctx->lock);
-	if (ctx->idle_active) {
-		ret = l2s_runtime_send(ctx, idle_hz, 120);
-		ctx->idle_active = false;
-		if (!ret)
-			ctx->idle_exits++;
-	}
-	if (ctx->runtime_failed && ctx->prepared)
-		ret = ctx->runtime_error ?: -EIO;
-	mutex_unlock(&ctx->lock);
-	if (ret) {
-		int recovery;
-		/* Reinitialization keeps the original failure latched for diagnostics. */
-		l2s_panel_unprepare(panel);
-		recovery = l2s_panel_prepare(panel);
-		if (!recovery)
-			recovery = l2s_panel_enable(panel);
-		if (recovery)
-			dev_err(&ctx->dsi->dev, "idle recovery failed: %d\n",
-				recovery);
-	}
+	int mode, ret;
+
+	mutex_lock(&ctx->lock);
+	mode = l2s_panel_get_current_mode(ctx);
+	if (mode < 0) {
+		ret = mode;
+		goto out;
+	}
+	if (ctx->idle_active && ctx->prepared && ctx->enabled &&
+	    !ctx->runtime_failed &&
+	    ctx->refresh == drm_mode_vrefresh(&l2s_panel_modes[mode])) {
+		ret = l2s_runtime_send(ctx, idle_hz, ctx->refresh);
+		if (!ret) {
+			ctx->idle_active = false;
+			ret = l2s_write_brightness_locked(ctx);
+			if (!ret) {
+				ctx->idle_requested = false;
+				ctx->idle_exits++;
+				goto out;
+			}
+			if (!ctx->runtime_failed) {
+				ctx->runtime_error = ret;
+				ctx->runtime_failed = true;
+			}
+		}
+	}
+
+	/* A changed mode or a partial command needs a complete panel reset.
+	 * All exposed modes share the WQHD command stream, DSC and lane rate.
+	 * Keep the DSI link retained by the bridge, and use the incoming mode.
+	 */
+	l2s_panel_disable_locked(ctx);
+	ret = l2s_panel_unprepare_locked(ctx);
+	if (ret)
+		goto out;
+	ret = l2s_panel_prepare_locked(ctx);
+	if (!ret)
+		ret = l2s_panel_enable_locked(ctx);
+	if (!ret)
+		ret = l2s_write_brightness_locked(ctx);
+	if (ret)
+		l2s_panel_unprepare_locked(ctx);
+out:
+	ctx->recovery_error = ret;
+	if (ret && !ctx->runtime_failed) {
+		ctx->runtime_error = ret;
+		ctx->runtime_failed = true;
+	}
+	if (ret)
+		dev_err(&ctx->dsi->dev, "idle recovery failed: %d\n", ret);
+	mutex_unlock(&ctx->lock);
 	return ret;
 }
 
