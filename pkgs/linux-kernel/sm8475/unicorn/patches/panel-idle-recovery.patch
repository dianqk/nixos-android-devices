+/* Backlight update_status holds update_lock. KMS callbacks can take that lock,
+ * so do not acquire modeset locks or commit synchronously from update_status.
+ */
+static void l2s_backlight_work(struct work_struct *work)
+{
+	struct l2s_panel *ctx = container_of(work, struct l2s_panel, backlight_work);
+	int ret;
+
+	ret = l2s_backlight_wake(ctx);
+	mutex_lock(&ctx->lock);
+	if (!ret && !ctx->stopping && ctx->prepared && ctx->enabled &&
+	    !ctx->idle_requested)
+		ret = l2s_write_brightness_locked(ctx);
+	ctx->backlight_error = ret;
+	mutex_unlock(&ctx->lock);
+	if (ret)
+		dev_err(&ctx->dsi->dev, "backlight wake failed: %d\n", ret);
+}
+
+static void l2s_stop_backlight_work(void *data)
+{
+	struct l2s_panel *ctx = data;
+	struct drm_connector *connector;
+
+	mutex_lock(&ctx->lock);
+	ctx->stopping = true;
+	mutex_unlock(&ctx->lock);
+	cancel_work_sync(&ctx->backlight_work);
+	mutex_lock(&ctx->lock);
+	connector = ctx->connector;
+	ctx->connector = NULL;
+	mutex_unlock(&ctx->lock);
+	if (connector)
+		drm_connector_put(connector);
 }
 
