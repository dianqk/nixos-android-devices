+	case CS35L41_ASP_WIDTH_16:
+	case CS35L41_ASP_WIDTH_24:
+	case CS35L41_ASP_WIDTH_32:
+		cs35l41->slot_width = slot_width;
+		return 0;
+	default:
+		return -EINVAL;
+	}
