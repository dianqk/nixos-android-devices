+/* The original libcrussp format is two little-endian u32 values, T then B. */
+static int cs35l41_unicorn_parse_calibration(const struct firmware *fw,
+					     const char *prefix, u32 *resistance)
+{
+	u32 top, bottom;
+
+	if (!fw || fw->size != 8 || !fw->data || !prefix)
+		return -EINVAL;
+
+	top = get_unaligned_le32(fw->data);
+	bottom = get_unaligned_le32(fw->data + sizeof(u32));
+	/* Original library limits; these are validation bounds, not defaults. */
+	if (top < 8000 || top > 12000 || bottom < 8000 || bottom > 12000)
+		return -ERANGE;
+
+	if (!strcmp(prefix, "T"))
+		*resistance = top;
+	else if (!strcmp(prefix, "B"))
+		*resistance = bottom;
+	else
+		return -EINVAL;
+
+	return 0;
+}
+
+static int cs35l41_unicorn_pre_run(struct wm_adsp *dsp)
+{
+	static const char calibration_file[] = "cirrus/cs35l41-xiaomi-unicorn-calibration.bin";
+	static const char * const names[] = { "CAL_R", "CAL_STATUS", "CAL_CHECKSUM" };
+	struct cs_dsp_coeff_ctl *controls[ARRAY_SIZE(names)], *music_controls[5];
+	struct cs_dsp *core = &dsp->cs_dsp;
+	const struct firmware *fw;
+	__be32 values[ARRAY_SIZE(names)], invalid = 0;
+	u32 resistance;
+	int i, ret;
+
+	/* cs_dsp_run holds this lock; wm_adsp_write_ctl would lock it again. */
+	lockdep_assert_held(&core->pwr_lock);
+	if (!dsp->system_name || strcmp(dsp->system_name, "xiaomi-unicorn") ||
+	    !dsp->bin_mandatory || !dsp->fwf_exact_match || dsp->fw != 9)
+		return -EPERM;
+	if (!core->booted || core->running || !dsp->component)
+		return -EPIPE;
+	if (core->fw_id != 0x400a4 || core->fw_id_version != 0x2b01)
+		return -EINVAL;
+
+	/* Never replay a cached Music command/prefix during pre-start sync. */
+	ret = cs35l41_unicorn_music_controls(core, music_controls);
+	if (ret)
+		return ret;
+	music_controls[0]->set = 0;
+	music_controls[1]->set = 0;
+
+	ret = request_firmware_direct(&fw, calibration_file, core->dev);
+	if (ret)
+		return ret;
+	ret = cs35l41_unicorn_parse_calibration(fw, dsp->component->name_prefix,
+						&resistance);
+	release_firmware(fw);
+	if (ret)
+		return ret;
+
+	/* These exact firmware controls use the legacy, cached flags=0 ABI. */
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		controls[i] = cs_dsp_get_ctl(core, names[i], WMFW_ADSP2_XM, 0xcd);
+		if (!controls[i] || !controls[i]->enabled || controls[i]->flags ||
+		    controls[i]->len != sizeof(__be32) || controls[i]->type != WMFW_CTL_TYPE_BYTES)
+			return -EINVAL;
+	}
+
+	values[0] = cpu_to_be32(resistance);
+	values[1] = cpu_to_be32(1);
+	values[2] = cpu_to_be32(resistance + 1);
+	ret = cs_dsp_coeff_write_ctrl(controls[1], 0, &invalid, sizeof(invalid));
+	if (ret < 0)
+		return ret;
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		ret = cs_dsp_coeff_write_ctrl(controls[i], 0, &values[i], sizeof(values[i]));
+		if (ret < 0)
+			return ret;
+	}
+
+	/* cs_dsp_run checks coefficient sync errors before starting the core. */
+	return 0;
+}
