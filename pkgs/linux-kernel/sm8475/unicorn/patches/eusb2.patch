 	phy->mode = mode;
-
-	return phy_set_mode_ext(phy->repeater, mode, submode);
+	return 0;
 }
 
 static void snps_eusb2_hsphy_write_mask(void __iomem *base, u32 offset,
@@ -444,6 +448,16 @@
 
 static const char * const qcom_eusb2_hsphy_clock_names[] = {
 	"ref",
+};
+
+static const char * const sm8475_eusb2_hsphy_clock_names[] = {
+	"ref", "ref_aux",
+};
+
+static const struct snps_eusb2_phy_drvdata sm8475_snps_eusb2_phy = {
+	.phy_init	= qcom_snps_eusb2_hsphy_init,
+	.clk_names	= sm8475_eusb2_hsphy_clock_names,
+	.num_clks	= ARRAY_SIZE(sm8475_eusb2_hsphy_clock_names),
 };
 
 static const struct snps_eusb2_phy_drvdata sm8550_snps_eusb2_phy = {
@@ -608,6 +622,9 @@
 
 static const struct of_device_id snps_eusb2_hsphy_of_match_table[] = {
 	{
+		.compatible = "qcom,sm8475-snps-eusb2-phy",
+		.data = &sm8475_snps_eusb2_phy,
+	}, {
 		.compatible = "qcom,sm8550-snps-eusb2-phy",
 		.data = &sm8550_snps_eusb2_phy,
 	}, {
