+static int panel_bridge_atomic_check(struct drm_bridge *bridge,
+				     struct drm_bridge_state *bridge_state,
+				     struct drm_crtc_state *crtc_state,
+				     struct drm_connector_state *conn_state)
+{
+	struct drm_panel *panel = drm_bridge_to_panel_bridge(bridge)->panel;
+
+	/* Existing panels keep their previous connector-state behavior. */
+	if (!panel->funcs->idle_supported)
+		return 0;
+	conn_state->self_refresh_aware =
+		panel->funcs->idle_supported(panel, crtc_state);
+	if (conn_state->self_refresh_aware)
+		crtc_state->self_refresh_entry_delay_ms = 1000;
+	if (crtc_state->self_refresh_active && !conn_state->self_refresh_aware)
+		return -EINVAL;
+	return 0;
+}
