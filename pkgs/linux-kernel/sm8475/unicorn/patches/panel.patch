+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/xiaomi,l2s-38-0c-0a.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Xiaomi L2S 38/0c/0a 1440x3200 AMOLED panel
+
+maintainers:
+  - dwuggh <dwuggh@gmail.com>
+
+description:
+  Four-lane MIPI DSI command-mode DSC panel used by Xiaomi 12S Pro.
+  The identifier distinguishes this panel from the alternative L2S
+  42/02/0b panel fitted to the same device model.
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: xiaomi,l2s-38-0c-0a
+
+  reg:
+    maxItems: 1
+
+  vci-supply:
+    description: 3.0 V analog supply
+
+  vddio-supply:
+    description: 1.8 V I/O supply
+
+  vddd-supply:
+    description: 1.5 V digital supply
+
+  reset-gpios:
+    maxItems: 1
+    description: Active-low reset
+
+  port: true
+
+required:
+  - compatible
+  - reg
+  - vci-supply
+  - vddio-supply
+  - vddd-supply
+  - reset-gpios
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    dsi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        panel@0 {
+            compatible = "xiaomi,l2s-38-0c-0a";
+            reg = <0>;
+            vci-supply = <&panel_vci>;
+            vddio-supply = <&panel_vddio>;
+            vddd-supply = <&panel_vddd>;
+            reset-gpios = <&tlmm 0 GPIO_ACTIVE_LOW>;
+
+            port {
+                panel_in: endpoint {
+                    remote-endpoint = <&mdss_dsi0_out>;
+                };
+            };
+        };
+    };
