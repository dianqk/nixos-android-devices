+/**
+ * mipi_dsi_transfer_sequence - send explicit packets as a single transaction
+ * @dsi: DSI peripheral
+ * @cmds: Write commands with explicit flags, grouping and completion delays
+ * @count: Number of commands
+ *
+ * No implicit LP-mode flags are added. Unsupported hosts return -EOPNOTSUPP.
+ * Returns zero only after every DMA group and delay has completed.
+ */
+int mipi_dsi_transfer_sequence(struct mipi_dsi_device *dsi,
+			       const struct mipi_dsi_cmd *cmds, size_t count)
+{
+	if (!count || !cmds || !dsi->host->ops->transfer_sequence)
+		return -EOPNOTSUPP;
+	return dsi->host->ops->transfer_sequence(dsi->host, cmds, count);
+}
+EXPORT_SYMBOL_GPL(mipi_dsi_transfer_sequence);
