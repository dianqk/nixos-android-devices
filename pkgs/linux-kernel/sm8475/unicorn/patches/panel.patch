+/* Keep the pixel/byte ratio, including RGB101010, in mode validation too. */
+static unsigned long dsi_host_get_pclk_rate(struct msm_dsi_host *msm_host,
+		const struct drm_display_mode *mode, bool is_bonded_dsi)
+{
+	unsigned long rate = dsi_get_pclk_rate(mode, msm_host->dsc, is_bonded_dsi);
+	int bpp;
+
+	if (msm_host->cmd_hs_rate && !is_bonded_dsi && !msm_host->cphy_mode &&
+	    !(msm_host->mode_flags & MIPI_DSI_MODE_VIDEO) && msm_host->lanes) {
+		bpp = mipi_dsi_pixel_format_to_bpp(msm_host->format);
+		if (bpp > 0)
+			return DIV_ROUND_UP_ULL((u64)msm_host->cmd_hs_rate *
+							msm_host->lanes,
+						bpp);
+	}
+
+	return rate;
+}
+
 unsigned long dsi_byte_clk_get_rate(struct mipi_dsi_host *host, bool is_bonded_dsi,
