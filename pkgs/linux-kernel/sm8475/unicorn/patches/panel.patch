+					    unsigned int new_hz)
+{
+#define L2S_SET(hz)                                                  \
+	case hz:                                                     \
+		return old_hz == 90 ?                                \
+			       (struct l2s_cmdset){                  \
+				       l2s_exit90_##hz,              \
+				       ARRAY_SIZE(l2s_exit90_##hz)   \
+			       } :                                   \
+			       (struct l2s_cmdset)                   \
+		{                                                    \
+			l2s_switch_##hz, ARRAY_SIZE(l2s_switch_##hz) \
+		}
+	switch (new_hz) {
+		L2S_SET(60);
+		L2S_SET(120);
+		L2S_SET(90);
+		L2S_SET(40);
+		L2S_SET(30);
+		L2S_SET(24);
+		L2S_SET(10);
+		L2S_SET(1);
+	default:
+		return (struct l2s_cmdset){};
+	}
+#undef L2S_SET
