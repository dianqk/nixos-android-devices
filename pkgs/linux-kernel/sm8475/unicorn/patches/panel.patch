+static struct msm_dsi *dpu_encoder_runtime_dsi(struct drm_encoder *encoder)
+{
+	struct dpu_encoder_virt *enc = to_dpu_encoder_virt(encoder);
+	struct msm_drm_private *priv = encoder->dev->dev_private;
+	unsigned int id = enc->disp_info.h_tile_instance[0];
+	if (enc->disp_info.intf_type != INTF_DSI || enc->num_phys_encs != 1 ||
+	    enc->phys_encs[0]->intf_mode != INTF_MODE_CMD || id >= DSI_MAX)
+		return NULL;
+	return priv->kms->dsi[id];
+}
+
+bool dpu_encoder_runtime_mode_valid(struct drm_encoder *encoder,
+				    const struct drm_display_mode *old,
+				    const struct drm_display_mode *new)
+{
+	struct msm_dsi *dsi = dpu_encoder_runtime_dsi(encoder);
+	return dsi && msm_dsi_runtime_mode_valid(dsi, old, new);
+}
+
+int dpu_encoder_runtime_mode_set(struct drm_encoder *encoder,
+				 struct drm_crtc_state *state,
+				 const struct drm_display_mode *old)
+{
+	struct msm_dsi *dsi = dpu_encoder_runtime_dsi(encoder);
+	struct dpu_encoder_virt *enc = to_dpu_encoder_virt(encoder);
+	int ret;
+	if (!dsi)
+		return -EOPNOTSUPP;
+	ret = msm_dsi_runtime_mode_set(dsi, old, &state->adjusted_mode);
+	if (ret)
+		return ret;
+	enc->phys_encs[0]->cached_mode = state->adjusted_mode;
+	enc->phys_encs[0]->ops.runtime_mode_set(enc->phys_encs[0]);
+	drm_calc_timestamping_constants(state->crtc, &state->adjusted_mode);
+	return 0;
+}
