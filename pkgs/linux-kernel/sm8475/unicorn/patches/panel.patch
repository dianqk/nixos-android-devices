+static int dpu_kms_check_runtime_mode(struct msm_kms *kms,
+				      struct drm_atomic_commit *state)
+{
+	struct drm_crtc_state *old, *new;
+	struct drm_crtc *crtc;
+	struct drm_encoder *encoder;
+	int i, count;
+	bool valid;
+
+	for_each_oldnew_crtc_in_state(state, crtc, old, new, i) {
+		struct dpu_crtc_state *cs = to_dpu_crtc_state(new);
+		cs->runtime_mode_changed = false;
+		if (!new->mode_changed || !old->active || !new->active ||
+		    old->self_refresh_active || new->self_refresh_active ||
+		    new->active_changed || new->connectors_changed ||
+		    new->color_mgmt_changed ||
+		    old->encoder_mask != new->encoder_mask ||
+		    drm_mode_equal(&old->mode, &new->mode))
+			continue;
+		count = 0;
+		valid = true;
+		drm_for_each_encoder_mask(encoder, crtc->dev,
+					  new->encoder_mask) {
+			count++;
+			if (!dpu_encoder_runtime_mode_valid(
+				    encoder, &old->adjusted_mode,
+				    &new->adjusted_mode))
+				valid = false;
+		}
+		if (count != 1 || !valid)
+			continue;
+		cs->runtime_old_mode = old->adjusted_mode;
+		cs->runtime_mode_changed = true;
+		new->mode_changed = false;
+		state->legacy_cursor_update = false;
+		state->async_update = false;
+	}
+	return 0;
+}
+
+static void dpu_kms_prepare_runtime_commit(struct msm_kms *kms,
+					   struct drm_atomic_commit *state)
+{
+	struct drm_crtc_state *new;
+	struct drm_crtc *crtc;
+	struct drm_encoder *encoder;
+	int i, ret;
+
+	for_each_new_crtc_in_state(state, crtc, new, i) {
+		struct dpu_crtc_state *cs = to_dpu_crtc_state(new);
+		if (!cs->runtime_mode_changed || new->mode_changed)
+			continue;
+		drm_for_each_encoder_mask(encoder, crtc->dev,
+					  new->encoder_mask) {
+			ret = dpu_encoder_runtime_mode_set(
+				encoder, new, &cs->runtime_old_mode);
+			if (ret) {
+				/* Resources were checked for the complete modeset before fast-path
+     * selection. Tail has not disabled anything yet: recover using it. */
+				DPU_ERROR(
+					"runtime mode transaction failed: %d; full modeset\n",
+					ret);
+				new->mode_changed = true;
+				cs->runtime_mode_changed = false;
+			}
+		}
+	}
+}
