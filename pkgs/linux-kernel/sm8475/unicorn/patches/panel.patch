+/* panel_bridge prepare runs after the incoming atomic state is installed.
+ * Select it again on every full modeset/wake, before touching panel power.
+ */
+static int l2s_panel_get_current_mode(struct l2s_panel *ctx)
+{
+	struct drm_connector *connector = ctx->connector;
+	struct drm_crtc_state *state;
+	unsigned int i;
+
+	if (!connector || !connector->state || !connector->state->crtc)
+		return 0;
+	state = connector->state->crtc->state;
+	if (!state)
+		return -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(l2s_panel_modes); i++) {
+		if (drm_mode_match(&state->mode, &l2s_panel_modes[i],
+				   DRM_MODE_MATCH_TIMINGS | DRM_MODE_MATCH_CLOCK |
+				   DRM_MODE_MATCH_FLAGS))
+			return i;
+	}
+	return -EINVAL;
+}
+
+static int l2s_runtime_send(struct l2s_panel *ctx, unsigned int old_hz,
+			    unsigned int new_hz)
+{
+	struct l2s_cmdset set = l2s_runtime_cmdset(old_hz, new_hz);
+	int ret;
+	if (!set.count)
+		return -EINVAL;
+	ret = mipi_dsi_transfer_sequence(ctx->dsi, set.cmds, set.count);
+	if (ret) {
+		ctx->runtime_failed = true;
+		ctx->runtime_error = ret;
+		dev_err(&ctx->dsi->dev, "runtime %u -> %u Hz failed: %d\n",
+			old_hz, new_hz, ret);
+	}
+	return ret;
+}
+
+static int l2s_runtime_mode_index(const struct drm_display_mode *mode)
+{
+	unsigned int i;
+	for (i = 0; i < ARRAY_SIZE(l2s_panel_modes); i++)
+		if (drm_mode_match(mode, &l2s_panel_modes[i],
+				   DRM_MODE_MATCH_TIMINGS |
+					   DRM_MODE_MATCH_CLOCK |
+					   DRM_MODE_MATCH_FLAGS))
+			return i;
+	return -EINVAL;
+}
+
+static bool l2s_runtime_mode_valid(struct drm_panel *panel,
+				   const struct drm_display_mode *old,
+				   const struct drm_display_mode *new)
+{
+	struct l2s_panel *ctx = to_l2s_panel(panel);
+	int a = l2s_runtime_mode_index(old), b = l2s_runtime_mode_index(new);
+	return seamless && !READ_ONCE(ctx->runtime_failed) && a >= 0 &&
+	       b >= 0 && a != b && (seamless_mask & BIT(a)) &&
+	       (seamless_mask & BIT(b));
+}
+
+static int l2s_runtime_mode_set(struct drm_panel *panel,
+				const struct drm_display_mode *old,
+				const struct drm_display_mode *new)
+{
+	struct l2s_panel *ctx = to_l2s_panel(panel);
+	struct drm_crtc *crtc = ctx->connector->state->crtc;
+	unsigned int hz = drm_mode_vrefresh(new);
+	int ret;
+
+	mutex_lock(&ctx->lock);
+	if (!ctx->prepared || !ctx->enabled || ctx->idle_active ||
+	    ctx->runtime_failed || ctx->refresh != drm_mode_vrefresh(old)) {
+		ret = -EBUSY;
+		goto out;
+	}
+	/* Raw OEM commands also schedule DMA at TE, not just a userspace sleep. */
+	ret = drm_crtc_vblank_get(crtc);
+	if (ret)
+		goto failed;
+	{
+		unsigned int seq = drm_crtc_vblank_count(crtc);
+		ret = wait_event_timeout(
+			crtc->dev->vblank[drm_crtc_index(crtc)].queue,
+			drm_crtc_vblank_count(crtc) != seq,
+			msecs_to_jiffies(100));
+	}
+	drm_crtc_vblank_put(crtc);
+	if (!ret) {
+		ret = -ETIMEDOUT;
+		goto failed;
+	}
+	ret = l2s_runtime_send(ctx, ctx->refresh, hz);
+	if (!ret) {
+		ctx->refresh = hz;
+		ctx->mode_switches++;
+	}
+	goto out;
+failed:
+	ctx->runtime_failed = true;
+	ctx->runtime_error = ret;
+out:
+	mutex_unlock(&ctx->lock);
+	return ret;
+}
+
+static bool l2s_idle_supported(struct drm_panel *panel,
+			       const struct drm_crtc_state *state)
+{
+	struct l2s_panel *ctx = to_l2s_panel(panel);
+	return idle_hz && state->enable && !state->vrr_enabled &&
+	       !READ_ONCE(ctx->runtime_failed) &&
+	       drm_mode_vrefresh(&state->mode) == 120;
+}
+
+static int l2s_idle_enter(struct drm_panel *panel)
+{
+	struct l2s_panel *ctx = to_l2s_panel(panel);
+	int ret = -EBUSY;
+	mutex_lock(&ctx->lock);
+	if (ctx->prepared && ctx->enabled && ctx->refresh == 120 &&
+	    !ctx->runtime_failed && !ctx->idle_active) {
+		ret = l2s_runtime_send(ctx, 120, idle_hz);
+		if (!ret) {
+			ctx->idle_active = true;
+			ctx->idle_entries++;
+		}
+	}
+	mutex_unlock(&ctx->lock);
+	return ret;
+}
+
+static int l2s_panel_prepare(struct drm_panel *panel);
+static int l2s_panel_enable(struct drm_panel *panel);
+static int l2s_panel_unprepare(struct drm_panel *panel);
+
+static int l2s_idle_exit(struct drm_panel *panel)
+{
+	struct l2s_panel *ctx = to_l2s_panel(panel);
+	int ret = 0;
+	mutex_lock(&ctx->lock);
+	if (ctx->idle_active) {
+		ret = l2s_runtime_send(ctx, idle_hz, 120);
+		ctx->idle_active = false;
+		if (!ret)
+			ctx->idle_exits++;
+	}
+	if (ctx->runtime_failed && ctx->prepared)
+		ret = ctx->runtime_error ?: -EIO;
+	mutex_unlock(&ctx->lock);
+	if (ret) {
+		int recovery;
+		/* Reinitialization keeps the original failure latched for diagnostics. */
+		l2s_panel_unprepare(panel);
+		recovery = l2s_panel_prepare(panel);
+		if (!recovery)
+			recovery = l2s_panel_enable(panel);
+		if (recovery)
+			dev_err(&ctx->dsi->dev, "idle recovery failed: %d\n",
+				recovery);
+	}
+	return ret;
+}
+
+/* A direct backlight update is not itself a KMS commit. Wake through DRM so
+ * host clocks, PHY and the first-frame path are restored before DCS access. */
+static int l2s_backlight_wake(struct l2s_panel *ctx)
+{
+	struct drm_modeset_acquire_ctx acquire;
+	struct drm_atomic_commit *state;
+	struct drm_crtc_state *cs;
+	struct drm_crtc *crtc;
+	int ret;
+
+	if (!READ_ONCE(ctx->idle_active))
+		return 0;
+	drm_modeset_acquire_init(&acquire, 0);
+	state = drm_atomic_commit_alloc(ctx->connector->dev);
+	if (!state) {
+		ret = -ENOMEM;
+		goto drop;
+	}
+retry:
+	state->acquire_ctx = &acquire;
+	ret = drm_modeset_lock(
+		&ctx->connector->dev->mode_config.connection_mutex, &acquire);
+	if (ret)
+		goto out;
+	crtc = ctx->connector->state->crtc;
+	if (!crtc) {
+		ret = -ENODEV;
+		goto out;
+	}
+	cs = drm_atomic_get_crtc_state(state, crtc);
+	if (IS_ERR(cs)) {
+		ret = PTR_ERR(cs);
+		goto out;
+	}
+	if (!cs->self_refresh_active) {
+		ret = 0;
+		goto out;
+	}
+	cs->active = true;
+	cs->self_refresh_active = false;
+	state->allow_modeset = true;
+	ret = drm_atomic_commit(state);
+out:
+	if (ret == -EDEADLK) {
+		drm_atomic_commit_clear(state);
+		ret = drm_modeset_backoff(&acquire);
+		if (!ret)
+			goto retry;
+	}
+	drm_atomic_commit_put(state);
+drop:
+	drm_modeset_drop_locks(&acquire);
+	drm_modeset_acquire_fini(&acquire);
+	return ret;
+}
+
+static int l2s_runtime_state_show(struct seq_file *s, void *unused)
+{
+	struct l2s_panel *ctx = s->private;
+	mutex_lock(&ctx->lock);
+	seq_printf(
+		s,
+		"refresh=%u\nidle_hz=%u\nidle_active=%u\nfailed=%u\nerror=%d\n"
+		"mode_switches=%llu\nidle_entries=%llu\nidle_exits=%llu\n"
+		"vrr_capable=0\n",
+		ctx->refresh, idle_hz, ctx->idle_active, ctx->runtime_failed,
+		ctx->runtime_error, ctx->mode_switches, ctx->idle_entries,
+		ctx->idle_exits);
+	mutex_unlock(&ctx->lock);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(l2s_runtime_state);
+
+static void l2s_runtime_debugfs_init(struct drm_panel *panel,
+				     struct dentry *root)
+{
+	debugfs_create_file("runtime_state", 0400, root, to_l2s_panel(panel),
+			    &l2s_runtime_state_fops);
+}
