+					   0xc3, 0x03, 0x43, 0x07, 0xa0, 0x07, 0xa1, 0x07,
+					   0xa2, 0x07, 0xa6, 0x07, 0xa8, 0x07, 0xaa, 0x07,
+					   0xac, 0x07, 0xae, 0x07, 0xb0, 0x07, 0xb2, 0x07,
+					   0xb4, 0x07, 0xb6, 0x00, 0x03, 0x00, 0xa4, 0x00,
+					   0xc0, 0x00, 0xd1, 0x01, 0x86, 0x03, 0xff, 0x07,
+					   0xff, 0x30, 0x30, 0x35, 0x40, 0x35, 0x30, 0x40,
+					   0x40, 0x35, 0x80, 0x80, 0x80, 0x0a, 0x0f, 0x14,
+					   0x18, 0x1e, 0x3a, 0x78, 0x80, 0x80, 0x80, 0x80,
+					   0x80, 0x80, 0x80, 0x80, 0x01, 0xb1);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x78, 0xbd);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xbd, 0x10);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf7, 0x0f);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+
+	return dsi_ctx.accum_err;
+}
+
+static void l2s_panel_power_off(struct l2s_panel *ctx)
+{
+	int i;
+
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	for (i = ARRAY_SIZE(ctx->supplies) - 1; i >= 0; i--) {
+		regulator_disable(ctx->supplies[i].consumer);
+		usleep_range(1000, 2000);
+	}
+}
+
+static int l2s_panel_prepare(struct drm_panel *panel)
+{
+	struct l2s_panel *ctx = to_l2s_panel(panel);
+	int i, ret, mode;
+
+	mutex_lock(&ctx->lock);
+	mode = l2s_panel_get_current_mode(ctx);
+	if (mode < 0) {
+		ret = mode;
+		dev_err(&ctx->dsi->dev, "unsupported L2S display mode\n");
+		goto unlock;
+	}
+	ctx->refresh = drm_mode_vrefresh(&l2s_panel_modes[mode]);
+
+
+	/* Preserve downstream order and its 1 ms delay after each supply. */
+	for (i = 0; i < ARRAY_SIZE(ctx->supplies); i++) {
+		ret = regulator_enable(ctx->supplies[i].consumer);
+
+		if (ret) {
+			while (i--) {
+				regulator_disable(ctx->supplies[i].consumer);
+				usleep_range(1000, 2000);
+			}
+			goto unlock;
+		}
+		usleep_range(1000, 2000);
+	}
+
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(ctx->reset, 0);
+	usleep_range(10000, 11000);
+
+	ret = l2s_panel_init(ctx);
+	if (ret)
+		l2s_panel_power_off(ctx);
+	else
+		ctx->prepared = true;
+unlock:
+	mutex_unlock(&ctx->lock);
+	return ret;
+}
+
+static void l2s_panel_post_on(struct l2s_panel *ctx,
+			      struct mipi_dsi_multi_context *dsi_ctx)
+{
+	if (ctx->refresh != 120)
+		return;
+
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xbd, 0x23, 0x02);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb0, 0x00, 0x14, 0xbd);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xbd, 0x01);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xf7, 0x0f);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xf0, 0xa5, 0xa5);
+}
+
+static int l2s_panel_enable(struct drm_panel *panel)
+{
+	struct l2s_panel *ctx = to_l2s_panel(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	struct drm_dsc_picture_parameter_set pps;
+
+	mutex_lock(&ctx->lock);
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+
+	l2s_panel_post_on(ctx, &dsi_ctx);
+	/* Match the PPS to the same configuration used by the DPU encoder. */
+	drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
+	mipi_dsi_picture_parameter_set_multi(&dsi_ctx, &pps);
+
+
+	if (!dsi_ctx.accum_err) {
+		ctx->enabled = true;
+	}
+	mutex_unlock(&ctx->lock);
+
+	return dsi_ctx.accum_err;
+}
+
+static int l2s_panel_disable(struct drm_panel *panel)
+{
+	struct l2s_panel *ctx = to_l2s_panel(panel);
+	int ret;
+
+	mutex_lock(&ctx->lock);
+	ctx->enabled = false;
+	if (ctx->idle_active) {
+		mutex_unlock(&ctx->lock);
+		return 0;
+	}
+	ret = mipi_dsi_dcs_set_display_off(ctx->dsi);
+	msleep(20);
+	mutex_unlock(&ctx->lock);
+
+	return ret;
+}
+
+static int l2s_panel_unprepare(struct drm_panel *panel)
+{
+	struct l2s_panel *ctx = to_l2s_panel(panel);
+	int ret;
+
+	mutex_lock(&ctx->lock);
+	ret = ctx->idle_active ? 0 : mipi_dsi_dcs_enter_sleep_mode(ctx->dsi);
+	ctx->idle_active = false;
+	msleep(100);
+	ctx->prepared = false;
+	l2s_panel_power_off(ctx);
+	mutex_unlock(&ctx->lock);
+
+	return ret;
+}
+
+static int l2s_panel_get_modes(struct drm_panel *panel,
+			       struct drm_connector *connector)
+{
+	struct l2s_panel *ctx = to_l2s_panel(panel);
+	struct drm_display_mode *mode;
+	unsigned int i;
+
+	ctx->connector = connector;
+	for (i = 0; i < ARRAY_SIZE(l2s_panel_modes); i++) {
+		mode = drm_mode_duplicate(connector->dev, &l2s_panel_modes[i]);
+		if (!mode)
+			return -ENOMEM;
+		drm_mode_set_name(mode);
+		drm_mode_probed_add(connector, mode);
+	}
+	connector->display_info.width_mm = 70;
+	connector->display_info.height_mm = 156;
+	connector->display_info.bpc = 10;
+
+	return ARRAY_SIZE(l2s_panel_modes);
+}
+
+static const struct drm_panel_funcs l2s_panel_funcs = {
+	.runtime_mode_valid = l2s_runtime_mode_valid,
+	.runtime_mode_set = l2s_runtime_mode_set,
+	.idle_supported = l2s_idle_supported,
+	.idle_enter = l2s_idle_enter,
+	.idle_exit = l2s_idle_exit,
+	.debugfs_init = l2s_runtime_debugfs_init,
+	.prepare = l2s_panel_prepare,
+	.enable = l2s_panel_enable,
+	.disable = l2s_panel_disable,
+	.unprepare = l2s_panel_unprepare,
+	.get_modes = l2s_panel_get_modes,
+};
+
+static int l2s_panel_bl_update_status(struct backlight_device *bl)
+{
+	struct l2s_panel *ctx = bl_get_data(bl);
+	u16 brightness = backlight_get_brightness(bl);
+	unsigned long mode_flags;
+	int ret = 0;
+
+	if (READ_ONCE(ctx->idle_active)) {
+		if (backlight_is_blank(bl))
+			return 0;
+		ret = l2s_backlight_wake(ctx);
+		if (ret)
+			return ret;
+	}
+	mutex_lock(&ctx->lock);
+	if (!ctx->prepared)
+		goto unlock;
+
+	/* The vendor inverted-dbv flag means high byte first. */
+	mode_flags = ctx->dsi->mode_flags;
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_dcs_set_display_brightness_large(ctx->dsi, brightness);
+
+	ctx->dsi->mode_flags = mode_flags;
+unlock:
+	mutex_unlock(&ctx->lock);
+	return ret;
+}
+
+static const struct backlight_ops l2s_panel_bl_ops = {
+	.update_status = l2s_panel_bl_update_status,
+};
+
+static int l2s_panel_probe(struct mipi_dsi_device *dsi)
+{
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = 307,
+		.max_brightness = 2047,
+	};
+	struct device *dev = &dsi->dev;
+	struct l2s_panel *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct l2s_panel, panel,
+				   &l2s_panel_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	if (idle_hz != 0 && idle_hz != 10 && idle_hz != 1)
+		return dev_err_probe(dev, -EINVAL,
+				     "idle_hz must be 0, 10 or 1\n");
+	if (seamless_mask & ~GENMASK(5, 0))
+		return dev_err_probe(dev, -EINVAL,
+				     "invalid seamless mode mask\n");
+	if (vrr)
+		dev_warn(
+			dev,
+			"VRR unavailable: arbitrary frame intervals not verified\n");
+	if (seamless || idle_hz)
+		dsi->cmd_hs_rate = 1360000000;
+	ctx->dsi = dsi;
+	mutex_init(&ctx->lock);
+	ctx->supplies[0].supply = "vci";
+	ctx->supplies[1].supply = "vddio";
+	ctx->supplies[2].supply = "vddd";
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ctx->supplies),
+				      ctx->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to get supplies\n");
+
+	ctx->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset),
+				     "Failed to get reset GPIO\n");
+
+	ctx->panel.prepare_prev_first = true;
+	ctx->panel.backlight = devm_backlight_device_register(dev, dev_name(dev),
+					dev, ctx, &l2s_panel_bl_ops, &props);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "Failed to register backlight\n");
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB101010;
+	/* Keep the clock lane stoppable between command-mode transfers. */
+	dsi->mode_flags = MIPI_DSI_MODE_LPM |
+		MIPI_DSI_CLOCK_NON_CONTINUOUS |
+		MIPI_DSI_MODE_DSC_ALL_SLICES_IN_PKT;
+	dsi->dsc = &ctx->dsc;
+	ctx->dsc.dsc_version_major = 1;
+	ctx->dsc.dsc_version_minor = 1;
+	ctx->dsc.slice_width = 720;
+	ctx->dsc.slice_height = 50;
+	ctx->dsc.slice_count = 2;
+	ctx->dsc.bits_per_component = 10;
+	ctx->dsc.bits_per_pixel = 8 << 4;
+	ctx->dsc.block_pred_enable = true;
+
+	mipi_dsi_set_drvdata(dsi, ctx);
+	drm_panel_add(&ctx->panel);
+	ret = devm_mipi_dsi_attach(dev, dsi);
+	if (ret) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "Failed to attach DSI\n");
+	}
+
+	return 0;
+}
+
+static void l2s_panel_remove(struct mipi_dsi_device *dsi)
+{
+	struct l2s_panel *ctx = mipi_dsi_get_drvdata(dsi);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id l2s_panel_of_match[] = {
+	{ .compatible = "xiaomi,l2s-38-0c-0a" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, l2s_panel_of_match);
+
+static struct mipi_dsi_driver l2s_panel_driver = {
+	.probe = l2s_panel_probe,
+	.remove = l2s_panel_remove,
+	.driver = {
+		.name = "panel-xiaomi-l2s-380c0a",
+		.of_match_table = l2s_panel_of_match,
+	},
+};
+module_mipi_dsi_driver(l2s_panel_driver);
+
+MODULE_DESCRIPTION("Xiaomi 12S Pro L2S 38/0c/0a AMOLED panel");
+MODULE_LICENSE("GPL");
