Subject: [PATCH] power: supply: qcom_battmgr: add Unicorn Xiaomi charging ABI

Use the Unicorn property table and exact vendor scalar, VDM and 32-byte
digest messages. Expose diagnostic properties read-only and keep policy in
the optional service. Preserve firmware thermal protection.

Reference: MiCode/Xiaomi_Kernel_OpenSource
fa4513e61931e11a59e3f177ae590d4e090d7229
drivers/power/supply/qti_battery_charger.c and vendor/unicorn_GKI.config.

diff --git a/drivers/power/supply/qcom_battmgr.c b/drivers/power/supply/qcom_battmgr.c
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -6,6 +6,7 @@
  */
 #include <linux/auxiliary_bus.h>
 #include <linux/devm-helpers.h>
+#include <linux/hex.h>
 #include <linux/module.h>
 #include <linux/mutex.h>
 #include <linux/nvmem-consumer.h>
@@ -13,6 +14,8 @@
 #include <linux/of_device.h>
 #include <linux/power_supply.h>
 #include <linux/property.h>
+#include <linux/spinlock.h>
+#include <linux/unaligned.h>
 #include <linux/soc/qcom/pdr.h>
 #include <linux/soc/qcom/pmic_glink.h>
 #include <linux/math.h>
