Subject: [PATCH] drm/msm/adreno: recognize the SM8475 A730 revision

Use the existing A730 GPU description for chip ID 0x07030002.

diff --git a/Documentation/devicetree/bindings/display/msm/gpu.yaml b/Documentation/devicetree/bindings/display/msm/gpu.yaml
--- a/Documentation/devicetree/bindings/display/msm/gpu.yaml
+++ b/Documentation/devicetree/bindings/display/msm/gpu.yaml
@@ -445,6 +445,7 @@
               - qcom,adreno-680.1
               - qcom,adreno-690.0
               - qcom,adreno-730.1
+              - qcom,adreno-730.2
               - qcom,adreno-43020100
               - qcom,adreno-43030c00
               - qcom,adreno-43050a01
diff --git a/drivers/gpu/drm/msm/adreno/a6xx_catalog.c b/drivers/gpu/drm/msm/adreno/a6xx_catalog.c
--- a/drivers/gpu/drm/msm/adreno/a6xx_catalog.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_catalog.c
@@ -1478,7 +1478,7 @@
 			{ 142, 3 },
 		),
 	}, {
-		.chip_ids = ADRENO_CHIP_IDS(0x07030001),
+		.chip_ids = ADRENO_CHIP_IDS(0x07030001, 0x07030002),
 		.family = ADRENO_7XX_GEN1,
 		.fw = {
 			[ADRENO_FW_SQE] = "a730_sqe.fw",
