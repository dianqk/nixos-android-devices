diff --git a/arch/arm64/boot/dts/qcom/sm8475.dtsi b/arch/arm64/boot/dts/qcom/sm8475.dtsi
--- a/arch/arm64/boot/dts/qcom/sm8475.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8475.dtsi
@@ -4,6 +4,7 @@
  */
 
 #include "sm8450.dtsi"
+#include "sm8475-ufs.dtsi"
 
 /delete-node/ &usb_1_hsphy;
 /delete-node/ &ufs_mem_phy;
diff --git a/arch/arm64/boot/dts/qcom/sm8475-ufs.dtsi b/arch/arm64/boot/dts/qcom/sm8475-ufs.dtsi
new file mode 100644
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8475-ufs.dtsi
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/* SM8475 UFS clocks share the CX and MX performance requirements. */
+
+&gcc {
+	power-domains = <&rpmhpd RPMHPD_CX>, <&rpmhpd RPMHPD_MX>;
+};
+
+&ice {
+	/* Bootstrap at the minimum OPP before the UFS consumer probes. */
+	assigned-clocks = <&gcc GCC_UFS_PHY_ICE_CORE_CLK>;
+	assigned-clock-rates = <75000000>;
+	required-opps = <&rpmhpd_opp_low_svs>;
+};
+
+&ufs_mem_hc {
+	/delete-property/ freq-table-hz;
+
+	clocks = <&gcc GCC_UFS_PHY_AXI_CLK>,
+		 <&gcc GCC_AGGRE_UFS_PHY_AXI_CLK>,
+		 <&gcc GCC_UFS_PHY_AHB_CLK>,
+		 <&gcc GCC_UFS_PHY_UNIPRO_CORE_CLK>,
+		 <&rpmhcc RPMH_CXO_CLK>,
+		 <&gcc GCC_UFS_PHY_TX_SYMBOL_0_CLK>,
+		 <&gcc GCC_UFS_PHY_RX_SYMBOL_0_CLK>,
+		 <&gcc GCC_UFS_PHY_RX_SYMBOL_1_CLK>,
+		 <&gcc GCC_UFS_PHY_ICE_CORE_CLK>;
+	clock-names = "core_clk", "bus_aggr_clk", "iface_clk",
+		      "core_clk_unipro", "ref_clk", "tx_lane0_sync_clk",
+		      "rx_lane0_sync_clk", "rx_lane1_sync_clk", "ice_core_clk";
+
+	operating-points-v2 = <&ufs_opp_table>;
+
+	ufs_opp_table: opp-table {
+		compatible = "operating-points-v2";
+
+		opp-75000000 {
+			opp-hz = /bits/ 64 <75000000 0 0 75000000 0 0 0 0 75000000>;
+			required-opps = <&rpmhpd_opp_low_svs>;
+		};
+
+		opp-850000000 {
+			opp-hz = /bits/ 64 <850000000 0 0 850000000 0 0 0 0 850000000>;
+			required-opps = <&rpmhpd_opp_turbo_l1>;
+		};
+	};
+};
