@@ -79,6 +79,7 @@
       - const: tx_lane0_sync_clk
       - const: rx_lane0_sync_clk
       - const: rx_lane1_sync_clk
+      - const: ice_core_clk
 
   qcom,ice:
     $ref: /schemas/types.yaml#/definitions/phandle
@@ -109,6 +110,21 @@
           minItems: 8
         clock-names:
           minItems: 8
+
+  - if:
+      not:
+        properties:
+          compatible:
+            contains:
