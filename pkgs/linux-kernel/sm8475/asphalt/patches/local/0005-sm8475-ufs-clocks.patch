From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Wed, 23 Sep 2026 14:47:34 +0800
Subject: [PATCH] clk: qcom: gcc-sm8450: source the SM8475 850 MHz UFS
 clocks from GPLL3

Select GPLL3 for the 850 MHz entry of SM8475's UFS AXI and ICE clock
tables, matching Qualcomm's downstream cape table. The GCC change is
local.

The 40 ns UniPro timing for 850 MHz that this patch previously carried
(ported by Danila Tikhonov from lenovo-basements 50743167d589) was
dropped. The SM8475 UFS OPP table selects 850 MHz together with the
ufs-qcom turbo configuration for "qcom,sm8475-ufshc", which programs
the downstream UniPro 1 us/40 ns cycle counts, SYS1CLK and
HCI_SEL_TURBO for that rate.
---
 drivers/clk/qcom/gcc-sm8450.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/clk/qcom/gcc-sm8450.c b/drivers/clk/qcom/gcc-sm8450.c
index b18bb34889ab..9d8a11c5f011 100644
--- a/drivers/clk/qcom/gcc-sm8450.c
+++ b/drivers/clk/qcom/gcc-sm8450.c
@@ -1068,7 +1068,7 @@ static const struct freq_tbl sm8475_ftbl_gcc_ufs_phy_axi_clk_src[] = {
 	F(300000000, P_GCC_GPLL0_OUT_MAIN, 2, 0, 0),
 	F(600000000, P_GCC_GPLL0_OUT_MAIN, 1, 0, 0),
 	F(806400000, P_SM8475_GCC_GPLL2_OUT_EVEN, 1, 0, 0),
-	F(850000000, P_SM8475_GCC_GPLL2_OUT_EVEN, 1, 0, 0),
+	F(850000000, P_SM8475_GCC_GPLL3_OUT_EVEN, 1, 0, 0),
 	{ }
 };
 
@@ -1110,7 +1110,7 @@ static const struct freq_tbl sm8475_ftbl_gcc_ufs_phy_ice_core_clk_src[] = {
 	F(300000000, P_GCC_GPLL0_OUT_MAIN, 2, 0, 0),
 	F(600000000, P_GCC_GPLL0_OUT_MAIN, 1, 0, 0),
 	F(806400000, P_SM8475_GCC_GPLL2_OUT_EVEN, 1, 0, 0),
-	F(850000000, P_SM8475_GCC_GPLL2_OUT_EVEN, 1, 0, 0),
+	F(850000000, P_SM8475_GCC_GPLL3_OUT_EVEN, 1, 0, 0),
 	{ }
 };
 
