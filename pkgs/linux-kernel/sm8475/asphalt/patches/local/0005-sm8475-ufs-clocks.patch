From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Wed, 23 Sep 2026 14:47:34 +0800
Subject: [PATCH 05/10] clk: qcom: support the SM8475 850 MHz UFS clock path

Select GPLL3 for SM8475's 850 MHz UFS clock and add the matching
40 ns UniPro timing. The timing was ported by Danila Tikhonov from
lenovo-basements; the GCC change is local.

Component-source: lenovo-basements/linux 50743167d589df685a26e16a15a8596bab621504
---
diff --git a/drivers/clk/qcom/gcc-sm8450.c b/drivers/clk/qcom/gcc-sm8450.c
index b18bb3488..9d8a11c5f 100644
--- a/drivers/clk/qcom/gcc-sm8450.c
+++ b/drivers/clk/qcom/gcc-sm8450.c
@@ -1068,7 +1068,7 @@ static const struct freq_tbl sm8475_ftbl_gcc_ufs_phy_axi_clk_src[] = {
 	F(300000000, P_GCC_GPLL0_OUT_MAIN, 2, 0, 0),
 	F(600000000, P_GCC_GPLL0_OUT_MAIN, 1, 0, 0),
 	F(806400000, P_SM8475_GCC_GPLL2_OUT_EVEN, 1, 0, 0),
-	F(850000000, P_SM8475_GCC_GPLL2_OUT_EVEN, 1, 0, 0),
+	F(850000000, P_SM8475_GCC_GPLL3_OUT_EVEN, 1, 0, 0),
 	{ }
 };
 
@@ -1110,7 +1110,7 @@ static const struct freq_tbl sm8475_ftbl_gcc_ufs_phy_ice_core_clk_src[] = {
 	F(300000000, P_GCC_GPLL0_OUT_MAIN, 2, 0, 0),
 	F(600000000, P_GCC_GPLL0_OUT_MAIN, 1, 0, 0),
 	F(806400000, P_SM8475_GCC_GPLL2_OUT_EVEN, 1, 0, 0),
-	F(850000000, P_SM8475_GCC_GPLL2_OUT_EVEN, 1, 0, 0),
+	F(850000000, P_SM8475_GCC_GPLL3_OUT_EVEN, 1, 0, 0),
 	{ }
 };
 
diff --git a/drivers/ufs/host/ufs-qcom.c b/drivers/ufs/host/ufs-qcom.c
index 954be9343..aedf41b32 100644
--- a/drivers/ufs/host/ufs-qcom.c
+++ b/drivers/ufs/host/ufs-qcom.c
@@ -1758,6 +1758,9 @@ static int ufs_qcom_set_clk_40ns_cycles(struct ufs_hba *hba,
 	 * generic formulae.
 	 */
 	switch (cycles_in_1us) {
+	case UNIPRO_CORE_CLK_FREQ_850_MHZ:
+		cycles_in_40ns = 34;
+		break;
 	case UNIPRO_CORE_CLK_FREQ_403_MHZ:
 		cycles_in_40ns = 16;
 		break;
diff --git a/drivers/ufs/host/ufs-qcom.h b/drivers/ufs/host/ufs-qcom.h
index a5ad5ce44..084aaf0e4 100644
--- a/drivers/ufs/host/ufs-qcom.h
+++ b/drivers/ufs/host/ufs-qcom.h
@@ -221,6 +221,7 @@ enum {
 #define UNIPRO_CORE_CLK_FREQ_300_MHZ           300
 #define UNIPRO_CORE_CLK_FREQ_201_5_MHZ         202
 #define UNIPRO_CORE_CLK_FREQ_403_MHZ           403
+#define UNIPRO_CORE_CLK_FREQ_850_MHZ           850
 
 /* TX_HSG1_SYNC_LENGTH attr value */
 #define PA_TX_HSG1_SYNC_LENGTH_VAL	0x4A
