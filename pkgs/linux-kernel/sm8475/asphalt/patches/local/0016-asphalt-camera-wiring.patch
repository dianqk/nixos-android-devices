Subject: [PATCH] arm64: dts: qcom: wire three TB320FC cameras

Use the actual TB320FC vendor DT supplies, CCI buses, MCLK/reset pins and
CSIPHY indices. The front is S5K4H7, main HI1339, auxiliary SC202CS; all
three sensor IDs were verified in the stock vendor driver on this tablet.

Keep SM8450's dynamically selected lane mask instead of overwriting it
with the shared X1E80100 table's four-lane constant. The macro uses one lane.

---
diff --git a/arch/arm64/boot/dts/qcom/sm8475-lenovo-asphalt.dts b/arch/arm64/boot/dts/qcom/sm8475-lenovo-asphalt.dts
index 1544f49e8..bd11263cf 100644
--- a/arch/arm64/boot/dts/qcom/sm8475-lenovo-asphalt.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-lenovo-asphalt.dts
@@ -921,3 +921,214 @@ &ufs_mem_phy {
 
 	status = "okay";
 };
+
+/* TB320FC production camera wiring, from its vendor DT and sensor modules. */
+/ {
+ camera_io: regulator-camera-io {
+  compatible = "regulator-fixed";
+  regulator-name = "camera-io";
+  regulator-min-microvolt = <1800000>;
+  regulator-max-microvolt = <1800000>;
+  gpio = <&tlmm 122 GPIO_ACTIVE_HIGH>;
+  enable-active-high;
+  startup-delay-us = <233>;
+ };
+};
+
+&apps_rsc {
+ regulators-1 {
+  pm8350c_l4: ldo4 {
+   regulator-name = "pm8350c_l4";
+   regulator-min-microvolt = <1800000>;
+   regulator-max-microvolt = <1800000>;
+   regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+  };
+ };
+};
+
+&camcc { status = "okay"; };
+&cci0 { status = "okay"; };
+&cci1 { status = "okay"; };
+&cci1_i2c0 {
+ status = "okay";
+ clock-frequency = <400000>;
+ camera_pmic: regulator@29 {
+  compatible = "willsemi,wl2864c";
+  reg = <0x29>;
+  vdd-supply = <&pm8350c_l4>;
+  vio-supply = <&camera_io>;
+  regulators {
+   camera_ldo1: ldo1 {
+    regulator-name = "camera-ldo1";
+    regulator-min-microvolt = <1100000>;
+    regulator-max-microvolt = <1100000>;
+   };
+   camera_ldo2: ldo2 {
+    regulator-name = "camera-ldo2";
+    regulator-min-microvolt = <1200000>;
+    regulator-max-microvolt = <1200000>;
+   };
+   camera_ldo3: ldo3 {
+    regulator-name = "camera-ldo3";
+    regulator-min-microvolt = <2800000>;
+    regulator-max-microvolt = <2800000>;
+   };
+   camera_ldo4: ldo4 {
+    regulator-name = "camera-ldo4";
+    regulator-min-microvolt = <2800000>;
+    regulator-max-microvolt = <2800000>;
+   };
+   camera_ldo5: ldo5 {
+    regulator-name = "camera-ldo5";
+    regulator-min-microvolt = <2800000>;
+    regulator-max-microvolt = <2800000>;
+   };
+   camera_ldo6: ldo6 {
+    regulator-name = "camera-ldo6";
+    regulator-min-microvolt = <2800000>;
+    regulator-max-microvolt = <2800000>;
+   };
+  };
+ };
+};
+
+&cci0_i2c0 {
+ status = "okay";
+ clock-frequency = <400000>;
+ hi1339: camera@20 {
+  compatible = "hynix,hi1339";
+  reg = <0x20>;
+  clocks = <&camcc CAM_CC_MCLK0_CLK>;
+  clock-names = "xclk";
+  assigned-clocks = <&camcc CAM_CC_MCLK0_CLK>;
+  assigned-clock-rates = <24000000>;
+  pinctrl-names = "default";
+  pinctrl-0 = <&camera_mclk0>;
+  reset-gpios = <&tlmm 25 GPIO_ACTIVE_LOW>;
+  vddio-supply = <&camera_io>;
+  vdd-supply = <&pm8350c_l4>;
+  avdd-supply = <&camera_ldo4>;
+  dvdd-supply = <&camera_ldo1>;
+  orientation = <1>;
+  rotation = <270>;
+  port {
+   hi1339_ep: endpoint {
+    remote-endpoint = <&csiphy0_ep>;
+    data-lanes = <1 2 3 4>;
+    link-frequencies = /bits/ 64 <608000000>;
+   };
+  };
+ };
+};
+
+&cci0_i2c1 {
+ status = "okay";
+ clock-frequency = <400000>;
+ s5k4h7: camera@10 {
+  compatible = "samsung,s5k4h7";
+  reg = <0x10>;
+  clocks = <&camcc CAM_CC_MCLK2_CLK>;
+  clock-names = "xclk";
+  assigned-clocks = <&camcc CAM_CC_MCLK2_CLK>;
+  assigned-clock-rates = <24000000>;
+  pinctrl-names = "default";
+  pinctrl-0 = <&camera_mclk2>;
+  reset-gpios = <&tlmm 117 GPIO_ACTIVE_LOW>;
+  vddio-supply = <&camera_io>;
+  vdd-supply = <&pm8350c_l4>;
+  avdd-supply = <&camera_ldo3>;
+  dvdd-supply = <&camera_ldo2>;
+  orientation = <0>;
+  rotation = <270>;
+  port {
+   s5k4h7_ep: endpoint {
+    remote-endpoint = <&csiphy2_ep>;
+    data-lanes = <1 2 3 4>;
+    link-frequencies = /bits/ 64 <340000000>;
+   };
+  };
+ };
+};
+
+&cci1_i2c0 {
+ status = "okay";
+ clock-frequency = <400000>;
+ sc202cs: camera@36 {
+  compatible = "smartsens,sc202cs";
+  reg = <0x36>;
+  clocks = <&camcc CAM_CC_MCLK1_CLK>;
+  clock-names = "xclk";
+  assigned-clocks = <&camcc CAM_CC_MCLK1_CLK>;
+  assigned-clock-rates = <24000000>;
+  pinctrl-names = "default";
+  pinctrl-0 = <&camera_mclk1>;
+  reset-gpios = <&tlmm 24 GPIO_ACTIVE_LOW>;
+  vddio-supply = <&camera_io>;
+  vdd-supply = <&pm8350c_l4>;
+  avdd-supply = <&camera_ldo6>;
+  orientation = <1>;
+  rotation = <270>;
+  port {
+   sc202cs_ep: endpoint {
+    remote-endpoint = <&csiphy1_ep>;
+    data-lanes = <1>;
+    link-frequencies = /bits/ 64 <360000000>;
+   };
+  };
+ };
+};
+
+&camss {
+ vdda-phy-supply = <&pm8350_l5>;
+ vdda-pll-supply = <&pm8350c_l10>;
+ status = "okay";
+ ports {
+  #address-cells = <1>;
+  #size-cells = <0>;
+  port@0 {
+   reg = <0>;
+   csiphy0_ep: endpoint {
+    remote-endpoint = <&hi1339_ep>;
+    clock-lanes = <7>;
+    data-lanes = <0 1 2 3>;
+   };
+  };
+  port@2 {
+   reg = <2>;
+   csiphy2_ep: endpoint {
+    remote-endpoint = <&s5k4h7_ep>;
+    clock-lanes = <7>;
+    data-lanes = <0 1 2 3>;
+   };
+  };
+  port@1 {
+   reg = <1>;
+   csiphy1_ep: endpoint {
+    remote-endpoint = <&sc202cs_ep>;
+    clock-lanes = <7>;
+    data-lanes = <0>;
+   };
+  };
+ };
+};
+
+&tlmm {
+ camera_mclk0: camera-mclk0-state {
+  pins = "gpio100";
+  function = "cam_mclk";
+  drive-strength = <2>;
+  bias-disable;
+ };
+ camera_mclk1: camera-mclk1-state {
+  pins = "gpio101";
+  function = "cam_mclk";
+  drive-strength = <2>;
+  bias-disable;
+ };
+ camera_mclk2: camera-mclk2-state {
+  pins = "gpio102";
+  function = "cam_mclk";
+  drive-strength = <2>;
+  bias-disable;
+ };
+};
diff --git a/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c b/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c
--- a/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c
+++ b/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c
@@ -1092,6 +1092,9 @@
 	u32 val;
 
 	for (i = 0; i < array_size; i++, r++) {
+		/* Preserve the lane mask selected above for one-lane SM8450 sensors. */
+		if (csiphy->camss->res->version == CAMSS_8450 && r->reg_addr == 0x1014)
+			continue;
 		switch (r->csiphy_param_type) {
 		case CSIPHY_SETTLE_CNT_LOWER_BYTE:
 			val = settle_cnt & 0xff;
