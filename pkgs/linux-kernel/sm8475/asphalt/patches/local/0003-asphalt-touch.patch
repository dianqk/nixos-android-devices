From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Wed, 23 Sep 2026 14:47:34 +0800
Subject: [PATCH 03/10] input: touchscreen: integrate Y700 NT36523N driver

Consolidate the validated NT36523N SPI binding and touchscreen
driver from historical local patches 0020-0034 by dianqk. This keeps
the staged firmware checks, panel lifecycle, input path and bounded
recovery behavior.

---
diff --git a/Documentation/devicetree/bindings/input/touchscreen/novatek,nt36523n-spi.yaml b/Documentation/devicetree/bindings/input/touchscreen/novatek,nt36523n-spi.yaml
new file mode 100644
index 000000000..aed624661
--- /dev/null
+++ b/Documentation/devicetree/bindings/input/touchscreen/novatek,nt36523n-spi.yaml
@@ -0,0 +1,75 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/touchscreen/novatek,nt36523n-spi.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Novatek NT36523N SPI touchscreen controller
+
+maintainers:
+  - dianqk <dianqk@dianqk.net>
+
+allOf:
+  - $ref: touchscreen.yaml#
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: novatek,nt36523n-spi
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  reset-gpios:
+    maxItems: 1
+
+  firmware-name:
+    maxItems: 1
+
+  panel: true
+
+  spi-max-frequency:
+    maximum: 9600000
+
+  touchscreen-size-x: true
+  touchscreen-size-y: true
+  touchscreen-inverted-x: true
+  touchscreen-inverted-y: true
+  touchscreen-swapped-x-y: true
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - reset-gpios
+  - firmware-name
+  - panel
+  - spi-max-frequency
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    spi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        touchscreen@0 {
+            compatible = "novatek,nt36523n-spi";
+            reg = <0>;
+            spi-max-frequency = <9600000>;
+            interrupts-extended = <&tlmm 21 IRQ_TYPE_EDGE_RISING>;
+            reset-gpios = <&tlmm 20 GPIO_ACTIVE_LOW>;
+            firmware-name = "novatek/lenovo-tb320fc.bin";
+            panel = <&panel>;
+            touchscreen-size-x = <1600>;
+            touchscreen-size-y = <2560>;
+        };
+    };
+...
diff --git a/drivers/input/touchscreen/Kconfig b/drivers/input/touchscreen/Kconfig
index 9b9ae8ac3..dce80453f 100644
--- a/drivers/input/touchscreen/Kconfig
+++ b/drivers/input/touchscreen/Kconfig
@@ -701,6 +701,18 @@ config TOUCHSCREEN_NOVATEK_NVT_TS
 	  To compile this driver as a module, choose M here: the
 	  module will be called novatek-nvt-ts.
 
+config TOUCHSCREEN_NOVATEK_NT36523N_SPI
+	tristate "Novatek NT36523N SPI touchscreen support"
+	depends on DRM
+	depends on SPI_MASTER
+	depends on GPIOLIB || COMPILE_TEST
+	help
+	  Say Y here if you have a Novatek NT36523N-family no-flash
+	  touchscreen controller connected over SPI.
+
+	  To compile this driver as a module, choose M here: the module will be
+	  called novatek-nt36523n-spi.
+
 config TOUCHSCREEN_IMAGIS
 	tristate "Imagis touchscreen support"
 	depends on I2C
