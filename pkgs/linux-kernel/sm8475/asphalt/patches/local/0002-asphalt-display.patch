+/**
+ * mipi_dsi_dcs_write_buffer_type() - transmit a DCS command with an explicit
+ * packet data type
+ * @dsi: DSI peripheral device
+ * @type: one of the MIPI DSI DCS write packet data types
+ * @data: buffer containing data to be transmitted
+ * @len: size of transmission buffer
+ *
+ * Some panels require a long-write packet for short command payloads. Unlike
+ * mipi_dsi_dcs_write_buffer(), this function preserves the caller's packet
+ * type instead of deriving it from @len.
+ *
+ * Return: The number of bytes successfully transmitted or a negative error
+ * code on failure.
+ */
+ssize_t mipi_dsi_dcs_write_buffer_type(struct mipi_dsi_device *dsi, u8 type,
+				       const void *data, size_t len)
+{
+	struct mipi_dsi_msg msg = {
+		.channel = dsi->channel,
+		.type = type,
+		.tx_buf = data,
+		.tx_len = len,
+	};
+
+	if (type != MIPI_DSI_DCS_SHORT_WRITE &&
+	    type != MIPI_DSI_DCS_SHORT_WRITE_PARAM &&
+	    type != MIPI_DSI_DCS_LONG_WRITE)
+		return -EINVAL;
+
+	return mipi_dsi_device_transfer(dsi, &msg);
+}
+EXPORT_SYMBOL(mipi_dsi_dcs_write_buffer_type);
+
