From: dianqk <dianqk@dianqk.net>
Date: Fri, 2 Oct 2026 12:00:00 +0800
Subject: [PATCH] arm64: dts: qcom: enable asphalt SLPI sensors

Enable the existing SLPI PAS/GLINK transport and request the board sensor
firmware. Subscribe to sensor_pd service notifications through FastRPC.

--- a/arch/arm64/boot/dts/qcom/sm8475-lenovo-asphalt.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-lenovo-asphalt.dts
@@ -1179,3 +1179,14 @@
 &usb_1_qmpphy_out {
 	remote-endpoint = <&pmic_glink_dp_ss>;
 };
+
+&remoteproc_slpi {
+	firmware-name = "qcom/sm8475/lenovo/tb320fc/slpi.mdt";
+	status = "okay";
+
+	glink-edge {
+		fastrpc {
+			qcom,protection-domain = "tms/servreg", "msm/slpi/sensor_pd";
+		};
+	};
+};
