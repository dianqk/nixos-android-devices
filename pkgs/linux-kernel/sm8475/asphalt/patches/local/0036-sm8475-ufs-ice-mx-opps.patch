Subject: [PATCH] arm64: dts: qcom: sm8475: coordinate UFS ICE and CX/MX OPPs

Extend Asphalt's existing 75/850 MHz OPP table with the ICE clock and
parent GCC GDSCs to both RPMh CX and MX. Bootstrap ICE at 75 MHz/LOW_SVS
before its driver enables the clock. Use the UFS OPP vote rather than a
permanent host-level NOM floor; preserve the SM8475 turbo compatible,
controller timing and PHY sequence introduced by the upstream queue.

This ports the coordinated clock/power behavior from the original
sm8475: enable shared UFS OPP scaling on Asphalt change onto Linux 7.3.4.
The matching initialization-order fix is selected separately from the
existing shared patch, also used by Unicorn. SM8450 keeps one GCC parent.

diff --git a/Documentation/devicetree/bindings/clock/qcom,gcc-sm8450.yaml b/Documentation/devicetree/bindings/clock/qcom,gcc-sm8450.yaml
--- a/Documentation/devicetree/bindings/clock/qcom,gcc-sm8450.yaml
+++ b/Documentation/devicetree/bindings/clock/qcom,gcc-sm8450.yaml
@@ -48,8 +48,10 @@
     minItems: 2
 
   power-domains:
+    minItems: 1
     items:
       - description: CX power domain
+      - description: MX power domain
 
 required:
   - compatible
@@ -60,6 +62,19 @@
 
 allOf:
   - $ref: qcom,gcc.yaml#
+
+  - if:
+      properties:
+        compatible:
+          const: qcom,sm8475-gcc
+    then:
+      properties:
+        power-domains:
+          minItems: 2
+    else:
+      properties:
+        power-domains:
+          maxItems: 1
 
 unevaluatedProperties: false
 
diff --git a/Documentation/devicetree/bindings/ufs/qcom,sc7180-ufshc.yaml b/Documentation/devicetree/bindings/ufs/qcom,sc7180-ufshc.yaml
--- a/Documentation/devicetree/bindings/ufs/qcom,sc7180-ufshc.yaml
+++ b/Documentation/devicetree/bindings/ufs/qcom,sc7180-ufshc.yaml
@@ -69,7 +69,7 @@
 
   clocks:
     minItems: 7
-    maxItems: 8
+    maxItems: 9
 
   clock-names:
     minItems: 7
@@ -82,6 +82,7 @@
       - const: tx_lane0_sync_clk
       - const: rx_lane0_sync_clk
       - const: rx_lane1_sync_clk
+      - const: ice_core_clk
 
   qcom,ice:
     $ref: /schemas/types.yaml#/definitions/phandle
@@ -112,6 +113,21 @@
           minItems: 8
         clock-names:
           minItems: 8
+
+  - if:
+      not:
+        properties:
+          compatible:
+            contains:
+              enum:
+                - qcom,sm8450-ufshc
+                - qcom,sm8475-ufshc
+    then:
+      properties:
+        clocks:
+          maxItems: 8
+        clock-names:
+          maxItems: 8
 
 unevaluatedProperties: false
 
diff --git a/Documentation/devicetree/bindings/crypto/qcom,inline-crypto-engine.yaml b/Documentation/devicetree/bindings/crypto/qcom,inline-crypto-engine.yaml
--- a/Documentation/devicetree/bindings/crypto/qcom,inline-crypto-engine.yaml
+++ b/Documentation/devicetree/bindings/crypto/qcom,inline-crypto-engine.yaml
@@ -45,6 +45,9 @@
       - const: iface
 
   power-domains:
+    maxItems: 1
+
+  required-opps:
     maxItems: 1
 
   operating-points-v2: true
diff --git a/arch/arm64/boot/dts/qcom/sm8475.dtsi b/arch/arm64/boot/dts/qcom/sm8475.dtsi
--- a/arch/arm64/boot/dts/qcom/sm8475.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8475.dtsi
@@ -72,39 +72,48 @@
 	compatible = "qcom,sm8475-tlmm";
 };
 
+&gcc {
+	power-domains = <&rpmhpd RPMHPD_CX>, <&rpmhpd RPMHPD_MX>;
+};
+
+&ice {
+	/* Bootstrap before the ICE driver enables its core clock. */
+	assigned-clocks = <&gcc GCC_UFS_PHY_ICE_CORE_CLK>;
+	assigned-clock-rates = <75000000>;
+	required-opps = <&rpmhpd_opp_low_svs>;
+};
+
 &ufs_mem_hc {
 	compatible = "qcom,sm8475-ufshc", "qcom,sm8450-ufshc", "qcom,ufshc",
 		     "jedec,ufs-2.0";
 
 	/delete-property/ freq-table-hz;
 
-	required-opps = <&rpmhpd_opp_nom>;
+	/* Keep ICE in the same performance transition as AXI and UniPro. */
+	clocks = <&gcc GCC_UFS_PHY_AXI_CLK>,
+		 <&gcc GCC_AGGRE_UFS_PHY_AXI_CLK>,
+		 <&gcc GCC_UFS_PHY_AHB_CLK>,
+		 <&gcc GCC_UFS_PHY_UNIPRO_CORE_CLK>,
+		 <&rpmhcc RPMH_CXO_CLK>,
+		 <&gcc GCC_UFS_PHY_TX_SYMBOL_0_CLK>,
+		 <&gcc GCC_UFS_PHY_RX_SYMBOL_0_CLK>,
+		 <&gcc GCC_UFS_PHY_RX_SYMBOL_1_CLK>,
+		 <&gcc GCC_UFS_PHY_ICE_CORE_CLK>;
+	clock-names = "core_clk", "bus_aggr_clk", "iface_clk",
+		      "core_clk_unipro", "ref_clk", "tx_lane0_sync_clk",
+		      "rx_lane0_sync_clk", "rx_lane1_sync_clk", "ice_core_clk";
 	operating-points-v2 = <&ufs_opp_table>;
 
 	ufs_opp_table: opp-table {
 		compatible = "operating-points-v2";
 
 		opp-75000000 {
-			opp-hz = /bits/ 64 <75000000>,
-				 /bits/ 64 <0>,
-				 /bits/ 64 <0>,
-				 /bits/ 64 <75000000>,
-				 /bits/ 64 <0>,
-				 /bits/ 64 <0>,
-				 /bits/ 64 <0>,
-				 /bits/ 64 <0>;
+			opp-hz = /bits/ 64 <75000000 0 0 75000000 0 0 0 0 75000000>;
 			required-opps = <&rpmhpd_opp_low_svs>;
 		};
 
 		opp-850000000 {
-			opp-hz = /bits/ 64 <850000000>,
-				 /bits/ 64 <0>,
-				 /bits/ 64 <0>,
-				 /bits/ 64 <850000000>,
-				 /bits/ 64 <0>,
-				 /bits/ 64 <0>,
-				 /bits/ 64 <0>,
-				 /bits/ 64 <0>;
+			opp-hz = /bits/ 64 <850000000 0 0 850000000 0 0 0 0 850000000>;
 			required-opps = <&rpmhpd_opp_turbo_l1>;
 		};
 	};
