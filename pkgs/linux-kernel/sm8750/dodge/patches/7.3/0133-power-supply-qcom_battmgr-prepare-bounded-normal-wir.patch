 {
-	return false;
+	/* No public register API: fixed typed helpers alone can reach these addresses. */
+	return reg <= 5 || reg == 0x0060 || reg == NU1669_BUSY;
 }
 
 static const struct regmap_config nu1669_regmap_config = {
 	.reg_bits = 16,
 	.val_bits = 8,
 	.reg_format_endian = REGMAP_ENDIAN_BIG,
-	.max_register = NU1669_INFO_BASE + NU1669_INFO_SIZE - 1,
+	.max_register = NU1669_FOD_SHADOW + NU1669_FOD_SHADOW_SIZE - 1,
 	.rd_table = &nu1669_read_table,
 	.writeable_reg = nu1669_writeable_reg,
 	.cache_type = REGCACHE_NONE,
@@ -137,36 +172,63 @@ static const struct power_supply_desc nu1669_psy_desc = {
 	.get_property = nu1669_get_property,
 };
 
+/* Caller holds lock. Logical generation changes alone never rearm a query. */
+static void nu1669_observe_presence(struct nu1669 *rx, int present)
+{
+	if (present <= 0)
+		rx->result_valid = false;
+	if (!present)
+		rx->physical_absent = true;
+	else if (present > 0 && rx->physical_absent) {
+		rx->physical_absent = false;
+		rx->physical_verified = true;
+		rx->query_rearm = true;
+		rx->result_valid = false;
+	}
+}
+
+static int nu1669_live(struct nu1669 *rx, u32 generation)
+{
+	int present;
+
+	if (READ_ONCE(rx->suspended) || READ_ONCE(rx->stopped) ||
+	    generation != atomic_read(&rx->generation))
+		return -ECANCELED;
+	present = gpiod_get_value_cansleep(rx->connected);
+	nu1669_observe_presence(rx, present);
+	if (present <= 0)
+		return present < 0 ? present : -ENODEV;
+	return generation == atomic_read(&rx->generation) &&
+		!READ_ONCE(rx->suspended) && !READ_ONCE(rx->stopped) ? 0 : -ECANCELED;
+}
+
+static int nu1669_read_info(struct nu1669 *rx, u32 generation, u8 *info)
+{
+	int ret;
+
+	ret = nu1669_live(rx, generation);
+	if (ret)
+		return ret;
+	ret = regmap_bulk_read(rx->regmap, NU1669_INFO_BASE, info, NU1669_INFO_SIZE);
+	return ret ?: nu1669_live(rx, generation);
+}
+
 int nu1669_get_snapshot(struct power_supply *psy, struct nu1669_snapshot *snapshot)
 {
 	struct nu1669 *rx;
 	u8 info[NU1669_INFO_SIZE];
 	u32 generation;
-	int present, ret;
+	int ret;
 
 	if (!psy || psy->desc != &nu1669_psy_desc)
 		return -EOPNOTSUPP;
 	rx = power_supply_get_drvdata(psy);
-	generation = atomic_read(&rx->generation);
-	mutex_lock(&rx->lock);
-	ret = rx->suspended || rx->stopped ? -EBUSY : 0;
-	mutex_unlock(&rx->lock);
-	if (ret)
-		return ret;
-	present = gpiod_get_value_cansleep(rx->connected);
-	if (present <= 0)
-		return present < 0 ? present : -ENODEV;
-	ret = regmap_bulk_read(rx->regmap, NU1669_INFO_BASE, info, sizeof(info));
-	if (ret)
-		return ret;
-	present = gpiod_get_value_cansleep(rx->connected);
-	if (present <= 0)
-		return present < 0 ? present : -ENODEV;
-
 	mutex_lock(&rx->lock);
-	if (rx->suspended || rx->stopped || generation != atomic_read(&rx->generation)) {
-		ret = -EAGAIN;
-	} else {
+	generation = atomic_read(&rx->generation);
+	ret = nu1669_read_info(rx, generation, info);
+	if (ret == -ECANCELED)
+		ret = READ_ONCE(rx->suspended) || READ_ONCE(rx->stopped) ? -EBUSY : -EAGAIN;
+	if (!ret) {
 		*snapshot = (struct nu1669_snapshot) {
 			.generation = generation,
 			.chip_id = get_unaligned_le16(info),
@@ -236,23 +298,24 @@ static void nu1669_poll(struct work_struct *work)
 
 	mutex_lock(&rx->lock);
 	generation = atomic_read(&rx->generation);
-	if (rx->suspended || rx->stopped) {
+	if (READ_ONCE(rx->suspended) || READ_ONCE(rx->stopped)) {
 		mutex_unlock(&rx->lock);
 		return;
 	}
-	mutex_unlock(&rx->lock);
 
 	present = gpiod_get_value_cansleep(rx->connected);
+	nu1669_observe_presence(rx, present);
 	if (present > 0) {
 		ret = regmap_bulk_read(rx->regmap, NU1669_INFO_BASE, info, sizeof(info));
 		if (!ret) {
 			present = gpiod_get_value_cansleep(rx->connected);
+			nu1669_observe_presence(rx, present);
 			valid = present > 0;
 		}
 	}
 
-	mutex_lock(&rx->lock);
-	if (rx->suspended || rx->stopped || generation != atomic_read(&rx->generation)) {
+	if (READ_ONCE(rx->suspended) || READ_ONCE(rx->stopped) ||
+	    generation != atomic_read(&rx->generation)) {
 		mutex_unlock(&rx->lock);
 		return;
 	}
@@ -287,9 +350,10 @@ static irqreturn_t nu1669_connected_irq(int irq, void *data)
 	struct nu1669 *rx = data;
 
 	mutex_lock(&rx->lock);
+	nu1669_observe_presence(rx, gpiod_get_value_cansleep(rx->connected));
 	rx->valid = false;
 	memset(rx->info, 0, sizeof(rx->info));
-	if (!rx->suspended && !rx->stopped) {
+	if (!READ_ONCE(rx->suspended) && !READ_ONCE(rx->stopped)) {
 		/* Always notify, including an attach/detach coalesced before sampling. */
 		power_supply_changed(rx->psy);
 		mod_delayed_work(system_percpu_wq, &rx->poll, 0);
@@ -302,13 +366,11 @@ static void nu1669_stop(void *data)
 {
 	struct nu1669 *rx = data;
 
-	mutex_lock(&rx->lock);
-	if (rx->stopped) {
-		mutex_unlock(&rx->lock);
+	if (xchg(&rx->stopped, true))
 		return;
-	}
-	rx->stopped = true;
