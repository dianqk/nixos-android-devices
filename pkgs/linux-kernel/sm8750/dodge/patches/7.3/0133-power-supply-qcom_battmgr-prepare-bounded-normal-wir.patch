+static void nu1669_debugfs_remove(void *data)
+{
+	struct nu1669 *rx = data;
+
+	/* Cancel active I/O before the debugfs proxy waits for its callback to drain. */
+	nu1669_stop(rx);
+	debugfs_remove_recursive(rx->debugfs);
+	rx->debugfs = NULL;
+}
+
+static int nu1669_debugfs_init(struct nu1669 *rx, struct device *dev)
+{
+	struct dentry *directory;
+
+	/* Per-device name permits multiple receivers without sharing query state. */
+	directory = debugfs_create_dir(dev_name(dev), NULL);
+	if (IS_ERR_OR_NULL(directory))
+		return 0;
+	rx->debugfs = directory;
+	debugfs_create_file("fod_shadow", 0400, directory, rx, &nu1669_fod_shadow_fops);
+	debugfs_create_file("query_tx_id", 0200, directory, rx, &nu1669_query_tx_id_fops);
+	debugfs_create_file("last_tx_id", 0400, directory, rx, &nu1669_last_tx_id_fops);
+	return devm_add_action_or_reset(dev, nu1669_debugfs_remove, rx);
+}
