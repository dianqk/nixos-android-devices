+static void qcom_battmgr_input_probe_schedule(struct qcom_battmgr *battmgr)
+{
+	unsigned long delay;
+
+	if (!battmgr->input_owned || battmgr->input_frozen ||
+	    READ_ONCE(battmgr->charge_closing) || READ_ONCE(battmgr->charge_suspending))
+		return;
+	delay = time_after_eq(jiffies, battmgr->input_deadline) ? 0 :
+		min_t(unsigned long, HZ, battmgr->input_deadline - jiffies);
+	mod_delayed_work(system_percpu_wq, &battmgr->input_work, delay);
+}
+
+static void qcom_battmgr_input_probe_worker(struct work_struct *work)
+{
+	struct qcom_battmgr *battmgr = container_of(to_delayed_work(work),
+						 struct qcom_battmgr, input_work);
+	int ret;
+
+	mutex_lock(&battmgr->lock);
+	if (!battmgr->input_owned || battmgr->input_frozen ||
+	    READ_ONCE(battmgr->charge_closing) || READ_ONCE(battmgr->charge_suspending))
+		goto out;
+	if (time_after_eq(jiffies, battmgr->input_deadline)) {
+		qcom_battmgr_input_probe_cleanup(battmgr, "deadline");
+		goto out;
+	}
+	ret = qcom_battmgr_input_probe_source(battmgr, false);
+	if (ret) {
+		battmgr->input_error = ret;
+		battmgr->input_failure_stage = battmgr->input_stage;
+		qcom_battmgr_input_probe_cleanup(battmgr, "source-or-health-revalidation");
+	} else {
+		battmgr->input_stage = "active";
+		qcom_battmgr_input_probe_schedule(battmgr);
+	}
+out:
+	mutex_unlock(&battmgr->lock);
+}
+
+static int qcom_battmgr_input_probe_control(struct qcom_battmgr *battmgr, bool start)
+{
+	unsigned long flags;
+	int ret;
+
+	if (start) {
+		if (!mutex_trylock(&battmgr->lock))
+			return -EBUSY;
+	} else {
+		mutex_lock(&battmgr->lock);
+	}
+	if (!start) {
+		ret = qcom_battmgr_input_probe_cleanup(battmgr, "explicit-stop");
+		goto out;
+	}
+	if (!IS_BUILTIN(CONFIG_BATTERY_QCOM_BATTMGR)) {
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+	if (battmgr->charge_owned || battmgr->charge_pending || battmgr->charge_frozen ||
+	    READ_ONCE(battmgr->charge_closing) || READ_ONCE(battmgr->charge_suspending)) {
+		ret = -EBUSY;
+		goto out;
+	}
+	/* Static built-in state survives service restart, suspend and driver reprobe. */
+	if (atomic_cmpxchg(&dodge_input_boot_state, INPUT_BOOT_UNUSED,
+			   INPUT_BOOT_CONSUMED_NO_REQUEST) != INPUT_BOOT_UNUSED) {
+		ret = -EALREADY;
+		goto out;
+	}
+	battmgr->input_phase = "PREFLIGHT";
+	battmgr->input_start_ack = -ENODATA;
+	battmgr->input_cleanup_ack = -ENODATA;
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	battmgr->input_generation = battmgr->dodge_service_generation;
+	battmgr->input_session_usb_epoch = battmgr->input_usb_epoch;
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+	ret = qcom_battmgr_input_probe_source(battmgr, true);
+	if (!ret)
+		ret = qcom_battmgr_input_probe_source(battmgr, false);
+	if (ret) {
+		battmgr->input_phase = "REJECTED_NO_REQUEST";
+		battmgr->input_error = ret;
+		battmgr->input_failure_stage = battmgr->input_stage;
+		goto out;
+	}
+	battmgr->input_stage = "start-set750000";
+	battmgr->input_phase = "START_PENDING";
+	battmgr->input_deadline = jiffies + 45 * HZ;
+	atomic_set(&dodge_input_boot_state, INPUT_BOOT_MAYBE_OWNED);
+	WRITE_ONCE(battmgr->input_owned, true);
+	/* Arm before the potentially ambiguous SET; never extend this absolute deadline. */
+	mod_delayed_work(system_percpu_wq, &battmgr->input_work, 45 * HZ);
+	ret = qcom_battmgr_input_probe_send(battmgr, true);
+	battmgr->input_start_ack = ret;
+	if (ret)
+		goto out;
+	battmgr->input_phase = "ACTIVE_ACKNOWLEDGED";
+	ret = qcom_battmgr_input_probe_source(battmgr, false);
+	if (ret) {
+		battmgr->input_error = ret;
+		battmgr->input_failure_stage = battmgr->input_stage;
+		qcom_battmgr_input_probe_cleanup(battmgr, "post-start-revalidation");
+	} else {
+		battmgr->input_stage = "active";
+		qcom_battmgr_input_probe_schedule(battmgr);
+	}
+out:
+	mutex_unlock(&battmgr->lock);
+	return ret;
+}
+
+static void qcom_battmgr_input_probe_close(struct qcom_battmgr *battmgr)
+{
+	unsigned long flags;
+	int ret;
+
+	if (battmgr->variant != QCOM_BATTMGR_DODGE)
+		return;
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	battmgr->charge_closing = true;
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+	cancel_delayed_work_sync(&battmgr->input_work);
+	mutex_lock(&battmgr->lock);
+	if (!battmgr->input_closed) {
+		battmgr->input_closed = true;
+		ret = qcom_battmgr_input_probe_cleanup(battmgr, "teardown");
+		if (ret)
+			dev_err(battmgr->dev,
+				"input probe cleanup UNKNOWN before teardown: %d\n", ret);
+	}
+	mutex_unlock(&battmgr->lock);
+}
+
+static ssize_t qcom_battmgr_input_probe_write(struct file *file, const char __user *buffer,
+					    size_t count, loff_t *position)
+{
+	char trigger[2];
+	int ret;
+
+	if (count != 1 && count != 2)
+		return -EINVAL;
+	if (copy_from_user(trigger, buffer, count))
+		return -EFAULT;
+	if ((trigger[0] != '0' && trigger[0] != '1') || (count == 2 && trigger[1] != '\n'))
+		return -EINVAL;
+	ret = qcom_battmgr_input_probe_control(file->private_data, trigger[0] == '1');
+	return ret ? ret : (ssize_t)count;
+}
+
+static const struct file_operations qcom_battmgr_input_probe_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = qcom_battmgr_input_probe_write,
+};
