 	mutex_unlock(&rx->lock);
@@ -317,6 +379,414 @@ static void nu1669_stop(void *data)
 	cancel_delayed_work_sync(&rx->poll);
 }
 
+/* All helpers below hold lock; only an explicit root write enters this transport. */
+static int nu1669_query_live(struct nu1669 *rx)
+{
+	int ret = nu1669_live(rx, rx->query_generation);
+
+	if (!ret && time_after_eq(jiffies, rx->query_deadline))
+		ret = -ETIMEDOUT;
+	return ret;
+}
+
+static int nu1669_query_context(struct nu1669 *rx, bool initial)
+{
+	u8 info[NU1669_INFO_SIZE];
+	u16 mv;
+	int ret;
+
+	ret = nu1669_query_live(rx);
+	if (ret)
+		return ret;
+	ret = nu1669_read_info(rx, rx->query_generation, info);
+	if (ret)
+		return ret;
+	mv = get_unaligned_le16(info + 0x34);
+	if (get_unaligned_le16(info) != 0x1669 || info[0x11] != 0x04 || info[0x44] ||
+	    (info[0x46] & BIT(0)) || mv < 4500 || mv > 6000)
+		return -EOPNOTSUPP;
+	if (initial)
+		memcpy(rx->query_identity, info, sizeof(rx->query_identity));
+	else if (memcmp(rx->query_identity, info, sizeof(rx->query_identity)))
+		return -ESTALE;
+	return nu1669_query_live(rx);
+}
+
+static int nu1669_query_flags(struct nu1669 *rx, u32 *flags, bool initial)
+{
+	u8 data[4];
+	int ret;
+
+	ret = nu1669_query_live(rx);
+	if (ret)
+		return ret;
+	ret = regmap_bulk_read(rx->regmap, NU1669_FLAGS, data, sizeof(data));
+	if (ret)
+		return ret;
+	ret = nu1669_query_live(rx);
+	if (ret)
+		return ret;
+	*flags = get_unaligned_le32(data);
+	rx->query_last_flags = *flags;
+	if (*flags == U32_MAX)
+		return -EIO;
+	if (initial) {
+		rx->query_initial_flags = *flags;
+		rx->query_sticky = *flags & ~NU1669_RX_DATA;
+	} else {
+		/* New bits may arrive; loss of captured unrelated evidence is ambiguous. */
+		if (rx->query_sticky & ~*flags)
+			return -EPROTO;
+		if ((*flags & NU1669_QUERY_FAULTS) & ~rx->query_initial_flags)
+			return -EIO;
+		rx->query_sticky |= *flags & ~NU1669_RX_DATA;
+	}
+	return 0;
+}
+
+static int nu1669_query_idle(struct nu1669 *rx)
+{
+	unsigned int busy;
+	int ret, i;
+
+	for (i = 0; i < 30; i++) {
+		ret = nu1669_query_live(rx);
+		if (ret)
+			return ret;
+		ret = regmap_read(rx->regmap, NU1669_BUSY, &busy);
+		if (ret)
+			return ret;
+		ret = nu1669_query_live(rx);
+		if (ret)
+			return ret;
+		if (!busy)
+			return 0;
+		usleep_range(1000, 2000);
+	}
+	return -EBUSY;
+}
+
+/* The only two messages: exact five-byte GET05 or four-byte BIT10-only ACK. */
+static int nu1669_query_mailbox(struct nu1669 *rx, bool ack)
+{
+	static const u8 get_id[] = { 0x18, 0x05, 0x00, 0x00, 0x00 };
+	static const u8 ack_rx[] = { 0x00, 0x04, 0x00, 0x00 };
+	const u8 *data = ack ? ack_rx : get_id;
+	size_t length = ack ? sizeof(ack_rx) : sizeof(get_id);
+	int ret;
+
+	ret = nu1669_query_idle(rx);
+	if (ret)
+		return ret;
+	ret = regmap_write(rx->regmap, NU1669_BUSY, 1);
+	if (ret)
+		return ret;
+	ret = nu1669_query_live(rx);
+	if (ret)
+		return ret;
+	ret = regmap_write(rx->regmap, 0x0000, length);
+	if (ret)
+		return ret;
+	ret = nu1669_query_live(rx);
+	if (ret)
+		return ret;
+	ret = regmap_bulk_write(rx->regmap, 0x0001, data, length);
+	if (ret)
+		return ret;
+	ret = nu1669_query_context(rx, false);
+	if (ret)
+		return ret;
+	/* No retained/new receive event may precede this GET's execute trigger. */
+	{
+		u32 flags;
+
+		ret = nu1669_query_flags(rx, &flags, false);
+		if (ret || (!ack && (flags & NU1669_RX_DATA)))
+			return ret ?: -EBUSY;
+	}
+	ret = regmap_write(rx->regmap, 0x0060, ack ? 0x28 : 0x51);
+	if (ret)
+		return ret;
+	/* Firmware alone releases busy. Availability is not command acceptance. */
+	return nu1669_query_idle(rx);
+}
+
+static int nu1669_query_ack(struct nu1669 *rx)
+{
+	u32 flags;
+	int ret, i;
+
+	ret = nu1669_query_mailbox(rx, true);
+	if (ret)
+		return ret;
+	for (i = 0; i < 30; i++) {
+		ret = nu1669_query_flags(rx, &flags, false);
+		if (ret || !(flags & NU1669_RX_DATA))
+			return ret;
+		usleep_range(1000, 2000);
+	}
+	return -ETIMEDOUT;
+}
+
+static int nu1669_query_reply(struct nu1669 *rx, u8 reply[6])
+{
+	u8 again[6];
+	int ret;
+
+	ret = nu1669_query_live(rx);
+	if (ret)
+		return ret;
+	ret = regmap_bulk_read(rx->regmap, NU1669_BC, reply, 6);
+	if (ret)
+		return ret;
+	ret = nu1669_query_live(rx);
+	if (ret)
+		return ret;
+	ret = regmap_bulk_read(rx->regmap, NU1669_BC, again, sizeof(again));
+	if (ret)
+		return ret;
+	ret = nu1669_query_live(rx);
+	if (ret)
+		return ret;
+	return memcmp(reply, again, sizeof(again)) ? -EPROTO : 0;
+}
+
+static int nu1669_query_tx_id(struct nu1669 *rx)
+{
+	u8 reply[6];
+	u32 flags;
+	int ret, stale, unrelated = 0;
+
+	if (!mutex_trylock(&rx->lock))
+		return -EBUSY;
+	if (rx->query_used && !rx->query_rearm) {
+		ret = -EBUSY;
+		goto unlock;
+	}
+	rx->query_used = true;
+	rx->query_rearm = false;
+	rx->result_valid = false;
+	memset(rx->query_reply, 0, sizeof(rx->query_reply));
+	rx->query_initial_flags = 0;
+	rx->query_last_flags = 0;
+	rx->query_sticky = 0;
+	rx->query_sequence++;
+	rx->query_generation = atomic_read(&rx->generation);
+	rx->query_deadline = jiffies + 2 * HZ;
+	ret = nu1669_query_context(rx, true);
+	if (ret)
+		goto finish;
+	ret = nu1669_query_flags(rx, &flags, true);
+	if (ret)
+		goto finish;
+	/* A retained BC frame is never a response to this query. Drain at most twice. */
+	for (stale = 0; flags & NU1669_RX_DATA; stale++) {
+		if (stale == 2) {
+			ret = -EBUSY;
+			goto finish;
+		}
+		ret = nu1669_query_reply(rx, reply);
+		if (ret)
+			goto finish;
+		ret = nu1669_query_ack(rx);
+		if (ret)
+			goto finish;
+		ret = nu1669_query_flags(rx, &flags, false);
+		if (ret)
+			goto finish;
+	}
+	ret = nu1669_query_context(rx, false);
+	if (ret)
+		goto finish;
+	/* Observe zero immediately before reserving and committing the GET05. */
+	ret = nu1669_query_flags(rx, &flags, false);
+	if (ret || (flags & NU1669_RX_DATA)) {
+		ret = ret ?: -EBUSY;
+		goto finish;
+	}
+	rx->query_quarantined = false;
+	ret = nu1669_query_mailbox(rx, false);
+	if (ret)
+		goto finish;
+	for (;;) {
+		ret = nu1669_query_flags(rx, &flags, false);
+		if (ret)
+			goto finish;
+		if (!(flags & NU1669_RX_DATA)) {
+			msleep(50);
+			continue;
+		}
+		ret = nu1669_query_reply(rx, reply);
+		if (ret)
+			goto finish;
+		if (reply[0] != 0x5f || reply[1] != 0x05) {
+			if ((reply[0] != 0x5f && reply[0] != 0x4f) ||
+			    (reply[0] == 0x4f && ((reply[1] ^ reply[2]) != 0xff ||
+					       (reply[3] ^ reply[4]) != 0xff)) || ++unrelated > 2) {
+				ret = -EPROTO;
+				goto finish;
+			}
+			ret = nu1669_query_ack(rx);
+			if (ret)
+				goto finish;
+			continue;
+		}
+		ret = nu1669_query_ack(rx);
+		if (ret)
+			goto finish;
+		ret = nu1669_query_context(rx, false);
+		if (ret)
+			goto finish;
+		memcpy(rx->query_reply, reply, sizeof(rx->query_reply));
+		rx->result_valid = true;
+		break;
+	}
+finish:
+	rx->query_status = ret;
+	if (ret) {
+		rx->result_valid = false;
+		rx->query_quarantined = true;
+		memset(rx->query_reply, 0, sizeof(rx->query_reply));
+	}
+unlock:
+	mutex_unlock(&rx->lock);
+	return ret;
+}
+
+static ssize_t nu1669_query_tx_id_write(struct file *file, const char __user *buffer,
+				      size_t count, loff_t *position)
+{
+	struct nu1669 *rx = file->private_data;
+	char trigger[2];
+	int ret;
+
+	if (count != 1 && count != 2)
+		return -EINVAL;
+	if (copy_from_user(trigger, buffer, count))
+		return -EFAULT;
+	if (trigger[0] != '1' || (count == 2 && trigger[1] != '\n'))
+		return -EINVAL;
+	ret = nu1669_query_tx_id(rx);
+	return ret ? ret : (ssize_t)count;
+}
+
+static const struct file_operations nu1669_query_tx_id_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = nu1669_query_tx_id_write,
+};
+
+static int nu1669_last_tx_id_show(struct seq_file *s, void *unused)
+{
+	struct nu1669 *rx = s->private;
+	int present;
+
+	mutex_lock(&rx->lock);
+	present = gpiod_get_value_cansleep(rx->connected);
+	nu1669_observe_presence(rx, present);
+	if (present <= 0 || READ_ONCE(rx->suspended) || READ_ONCE(rx->stopped) ||
+	    rx->query_generation != atomic_read(&rx->generation))
+		rx->result_valid = false;
+	seq_printf(s, "sequence=%u generation=%u status=%d physical_attach_verified=%u quarantined=%u\n",
+		   rx->query_sequence, rx->query_generation, rx->query_status,
+		   rx->physical_verified, rx->query_quarantined);
+	seq_printf(s, "initial_flags=0x%08x last_flags=0x%08x\n",
+		   rx->query_initial_flags, rx->query_last_flags);
+	if (rx->result_valid)
+		seq_printf(s, "reply=%*ph\n", (int)sizeof(rx->query_reply), rx->query_reply);
+	else
+		seq_puts(s, "reply=unavailable\n");
+	mutex_unlock(&rx->lock);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(nu1669_last_tx_id);
+
+/* Passive mailbox shadows only: no read command or calibration write is sent. */
+static int nu1669_fod_shadow_get(struct nu1669 *rx, u8 *magcvr, u8 *shadow)
+{
+	u8 before[NU1669_INFO_SIZE], after[NU1669_INFO_SIZE];
+	u8 first[NU1669_FOD_SHADOW_SIZE], second[NU1669_FOD_SHADOW_SIZE];
+	u32 generation;
+	int ret;
+
+	mutex_lock(&rx->lock);
+	generation = atomic_read(&rx->generation);
+	ret = nu1669_read_info(rx, generation, before);
+	if (ret)
+		goto out;
+	if (get_unaligned_le16(before) != 0x1669) {
+		ret = -ENODEV;
+		goto out;
+	}
+	ret = regmap_bulk_read(rx->regmap, NU1669_FOD_SHADOW, first, sizeof(first));
+	if (ret)
+		goto out;
+	ret = nu1669_live(rx, generation);
+	if (ret)
+		goto out;
+	ret = regmap_bulk_read(rx->regmap, NU1669_FOD_SHADOW, second, sizeof(second));
+	if (ret)
+		goto out;
+	ret = nu1669_read_info(rx, generation, after);
+	if (ret)
+		goto out;
+	if (memcmp(before, after, 5)) {
+		ret = -ESTALE;
+		goto out;
+	}
+	if (before[0x18] != after[0x18] || memcmp(first, second, sizeof(first))) {
+		ret = -EAGAIN;
+		goto out;
+	}
+	*magcvr = after[0x18];
+	memcpy(shadow, second, sizeof(second));
+out:
+	if (ret == -ECANCELED)
+		ret = READ_ONCE(rx->suspended) || READ_ONCE(rx->stopped) ? -EBUSY : -ESTALE;
+	mutex_unlock(&rx->lock);
+	return ret;
+}
+
+static int nu1669_fod_shadow_show(struct seq_file *s, void *unused)
+{
+	u8 magcvr, shadow[NU1669_FOD_SHADOW_SIZE];
+	int ret;
+
+	ret = nu1669_fod_shadow_get(s->private, &magcvr, shadow);
+	if (ret)
+		return ret;
+	seq_printf(s, "magcvr_shadow=0x%02x write_mode_shadow=0x%02x length_shadow=%u read_mode_shadow=0x%02x\n",
+		   magcvr, shadow[0], shadow[1], shadow[2]);
+	seq_printf(s, "parameters_shadow=%*ph\n", NU1669_FOD_SHADOW_SIZE - 3, shadow + 3);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(nu1669_fod_shadow);
