+static int qcom_battmgr_dodge_decode_voltage_samples(const void *data, size_t len,
+						    u32 *word2, u32 *word13, u32 *words)
+{
+	const struct qcom_battmgr_dodge_response *response = data;
+	u32 gauge[9];
+	int ret;
+
+	ret = qcom_battmgr_dodge_decode(data, len, gauge);
+	if (ret)
+		return ret;
