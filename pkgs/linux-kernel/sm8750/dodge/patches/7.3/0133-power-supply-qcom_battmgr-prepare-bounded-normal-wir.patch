+/* This development experiment owns requests, never an effective/applied limit. */
+static void qcom_battmgr_input_probe_unknown(struct qcom_battmgr *battmgr, int error)
+{
+	unsigned long flags;
+
+	WRITE_ONCE(battmgr->input_frozen, true);
+	battmgr->input_phase = "UNKNOWN";
+	battmgr->input_error = error;
+	if (!battmgr->input_failure_stage)
+		battmgr->input_failure_stage = battmgr->input_stage;
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	if (battmgr->input_generation == battmgr->dodge_service_generation)
+		battmgr->dodge_otg_broken = true;
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
