+static int qcom_battmgr_input_probe_status_show(struct seq_file *s, void *unused)
+{
+	struct qcom_battmgr *battmgr = s->private;
+	unsigned long remaining = 0;
+	int boot;
+
+	mutex_lock(&battmgr->lock);
+	boot = atomic_read(&dodge_input_boot_state);
+	if (battmgr->input_owned && time_before(jiffies, battmgr->input_deadline))
+		remaining = jiffies_to_msecs(battmgr->input_deadline - jiffies);
+	seq_printf(s, "phase=%s boot_consumed=%u may_own_request=%u instance_owner=%u frozen=%u\n",
+		   !battmgr->input_owned && boot == INPUT_BOOT_MAYBE_OWNED ?
+		   "UNKNOWN_OWNER_UNAVAILABLE" : battmgr->input_phase ?: "IDLE",
+		   boot != INPUT_BOOT_UNUSED, boot == INPUT_BOOT_MAYBE_OWNED,
+		   battmgr->input_owned, battmgr->input_frozen);
+	seq_printf(s, "stage=%s failure_stage=%s reason=%s error=%d start_ack=%d cleanup_ack=%d\n",
+		   battmgr->input_stage ?: "none", battmgr->input_failure_stage ?: "none",
+		   battmgr->input_reason ?: "none",
+		   battmgr->input_error, battmgr->input_start_ack, battmgr->input_cleanup_ack);
+	seq_printf(s, "service_generation=%u current_service_generation=%u receiver_generation=%u deadline_jiffies=%lu remaining_ms=%lu\n",
+		   battmgr->input_generation, READ_ONCE(battmgr->dodge_service_generation),
+		   battmgr->input_receiver.generation, battmgr->input_deadline, remaining);
+	seq_printf(s, "charge_owned=%u charge_pending=%u charge_frozen=%u charge_epoch=%u charge_session_epoch=%u\n",
+		   battmgr->charge_owned, battmgr->charge_pending, battmgr->charge_frozen,
+		   READ_ONCE(battmgr->charge_epoch), battmgr->charge_session_epoch);
+	seq_puts(s, "ACKs describe requests only; applied/original limit and power are unverified\n");
+	mutex_unlock(&battmgr->lock);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(qcom_battmgr_input_probe_status);
