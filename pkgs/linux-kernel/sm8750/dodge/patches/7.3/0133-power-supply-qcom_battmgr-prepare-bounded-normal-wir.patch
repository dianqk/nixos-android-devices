+/* Firmware STATUS misses normal wireless charging; qualify fresh gauge flow. */
+static int qcom_battmgr_dodge_wireless_status(struct qcom_battmgr *battmgr,
+					    union power_supply_propval *val)
+{
+	struct qcom_battmgr_dodge_request request = {
+		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_BATTMGR),
+		.hdr.type = cpu_to_le32(PMIC_GLINK_REQ_RESP),
+		.hdr.opcode = cpu_to_le32(DODGE_GAUGE_OPCODE),
+		.data_size = cpu_to_le32(DODGE_GAUGE_WORDS * sizeof(__le32)),
+	};
+	struct nu1669_snapshot before, after;
+	union power_supply_propval present;
+	unsigned long flags;
+	u32 generation, usb_epoch = 0;
+	bool derived = false;
+	int ret, present_ret, status;
+	s32 current_ua;
+
+	mutex_lock(&battmgr->lock);
+	generation = READ_ONCE(battmgr->dodge_service_generation);
+	if (!battmgr->service_up) {
+		ret = -EAGAIN;
+		goto out;
+	}
+	/* Even FULL is fetched fresh; an old cached enumeration is not authority. */
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_GET, BATT_STATUS, 0);
+	if (ret)
+		goto out;
+	status = battmgr->status.status;
+	if (status < POWER_SUPPLY_STATUS_UNKNOWN || status > POWER_SUPPLY_STATUS_FULL) {
+		ret = -EPROTO;
+		goto out;
+	}
+	if (!battmgr->wireless_receiver)
+		goto publish;
+	present_ret = power_supply_get_property(battmgr->wireless_receiver,
+					       POWER_SUPPLY_PROP_PRESENT, &present);
+	if (!present_ret && !present.intval)
+		goto publish;
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_GET, USB_ONLINE, 0);
+	if (ret)
+		goto out;
+	if (battmgr->usb.online)
+		goto publish;
+	if (present_ret) {
+		ret = present_ret;
+		goto out;
+	}
+	ret = nu1669_get_snapshot(battmgr->wireless_receiver, &before);
+	if (ret)
+		goto out;
+	if (!qcom_battmgr_dodge_status_receiver(&before))
+		goto publish;
+	usb_epoch = READ_ONCE(battmgr->input_usb_epoch);
+	/* STATUS always requests fresh gauge data, irrespective of the one-second cache. */
+	WRITE_ONCE(battmgr->dodge_gauge_valid, false);
+	WRITE_ONCE(battmgr->dodge_gauge_pending, true);
+	ret = qcom_battmgr_request(battmgr, &request, sizeof(request));
+	WRITE_ONCE(battmgr->dodge_gauge_pending, false);
+	if (ret)
+		goto out;
+	if ((s32)battmgr->dodge_gauge[1] == S32_MIN) {
+		ret = -ERANGE;
+		goto out;
+	}
+	/* Same OEM discharge-positive microamp conversion as CURRENT_NOW. */
+	current_ua = -(s32)battmgr->dodge_gauge[1];
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_GET, USB_ONLINE, 0);
+	if (ret)
+		goto out;
+	if (battmgr->usb.online) {
+		ret = -EAGAIN;
+		goto out;
+	}
+	ret = nu1669_get_snapshot(battmgr->wireless_receiver, &after);
+	if (ret)
+		goto out;
+	if (!qcom_battmgr_dodge_status_receiver(&after) ||
+	    before.generation != after.generation || before.hw_version != after.hw_version ||
+	    before.customer_id != after.customer_id || before.fw_version != after.fw_version) {
+		ret = -EAGAIN;
+		goto out;
+	}
+	if (current_ua > 50000)
+		status = POWER_SUPPLY_STATUS_CHARGING;
+	else if (current_ua < -50000)
+		status = POWER_SUPPLY_STATUS_DISCHARGING;
+	else if (status != POWER_SUPPLY_STATUS_FULL)
+		status = POWER_SUPPLY_STATUS_NOT_CHARGING;
+	derived = true;
+publish:
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	if (!battmgr->service_up || battmgr->dodge_otg_stopping ||
+	    generation != battmgr->dodge_service_generation)
+		ret = -ENOTCONN;
+	else if (derived && usb_epoch != battmgr->input_usb_epoch)
+		ret = -EAGAIN;
+	if (!ret) {
+		if (derived) {
+			battmgr->dodge_gauge_generation = generation;
+			battmgr->dodge_gauge_updated = jiffies;
+			WRITE_ONCE(battmgr->dodge_gauge_valid, true);
+		}
+		val->intval = status;
+	}
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+out:
+	mutex_unlock(&battmgr->lock);
+	return ret > 0 ? -EREMOTEIO : ret;
+}
