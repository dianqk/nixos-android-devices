+static int qcom_battmgr_input_probe_send(struct qcom_battmgr *battmgr, bool enable)
+{
+	int ret;
+
+	if (battmgr->input_frozen)
+		return -ENOTCONN;
+	if (!qcom_battmgr_charge_transport_current(battmgr, battmgr->input_generation)) {
+		ret = -ENOTCONN;
+		goto unknown;
+	}
+	ret = qcom_battmgr_dodge_otg_request(battmgr, BATTMGR_WLS_PROPERTY_SET,
+					   DODGE_WLS_INPUT_CURR_LIMIT, enable ? 750000 : 0,
+					   battmgr->input_generation);
+	if (!ret && !qcom_battmgr_charge_transport_current(battmgr, battmgr->input_generation))
+		ret = -ENOTCONN;
+	if (!ret)
+		return 0;
+unknown:
+	/* SET750000 and SET0 ACKs have no transaction ID or reliable value echo. */
+	qcom_battmgr_input_probe_unknown(battmgr, ret);
+	return ret;
+}
+
+/* Only an owned live request can send SET0; no health/provider/readback gate. */
+static int qcom_battmgr_input_probe_cleanup(struct qcom_battmgr *battmgr, const char *reason)
+{
+	int ret;
+
+	if (!battmgr->input_owned)
+		return atomic_read(&dodge_input_boot_state) == INPUT_BOOT_MAYBE_OWNED ?
+			-ENOTCONN : 0;
+	battmgr->input_reason = reason;
+	if (battmgr->input_frozen)
+		return -ENOTCONN;
+	battmgr->input_stage = "cleanup-set0";
+	ret = qcom_battmgr_input_probe_send(battmgr, false);
+	battmgr->input_cleanup_ack = ret;
+	if (ret)
+		return ret;
+	WRITE_ONCE(battmgr->input_owned, false);
+	atomic_set(&dodge_input_boot_state, INPUT_BOOT_CLEANUP_ACK);
+	battmgr->input_phase = "CLEANUP_ACKNOWLEDGED";
+	battmgr->input_stage = "cleanup-ack";
+	return 0;
+}
+
+static int qcom_battmgr_input_probe_current(struct qcom_battmgr *battmgr)
+{
+	unsigned long flags;
+	bool valid;
+
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	valid = battmgr->service_up && battmgr->dodge_otg_ready &&
+		!battmgr->dodge_otg_stopping && !battmgr->dodge_otg_broken &&
+		!battmgr->dodge_otg_requested && !battmgr->charge_closing &&
+		!battmgr->charge_suspending &&
+		battmgr->input_generation == battmgr->dodge_service_generation &&
+		battmgr->input_session_usb_epoch == battmgr->input_usb_epoch;
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+	if (!valid) {
+		battmgr->input_stage =
+			battmgr->input_session_usb_epoch != READ_ONCE(battmgr->input_usb_epoch) ?
+			"usb-state-event" : "service-lifecycle-or-otg";
+		return -EAGAIN;
+	}
+	if (battmgr->input_owned && time_after_eq(jiffies, battmgr->input_deadline)) {
+		battmgr->input_stage = "deadline";
+		return -ETIME;
+	}
+	return 0;
+}
+
+/* Gate0 is acceptable only while the existing manual pause owns this exact source. */
+static bool qcom_battmgr_input_probe_pause_confirmed(struct qcom_battmgr *battmgr)
+{
+	return battmgr->charge_owned && !battmgr->charge_pending && !battmgr->charge_frozen &&
+		battmgr->charge_generation == battmgr->input_generation &&
+		qcom_battmgr_charge_same_receiver(&battmgr->charge_receiver,
+						 &battmgr->input_receiver) &&
+		qcom_battmgr_charge_current(battmgr, battmgr->charge_generation,
+					    battmgr->charge_session_epoch);
+}
+
+/* Reuse health/temperature validation, but never charge_epoch or GET8 readback. */
+static int qcom_battmgr_input_probe_source(struct qcom_battmgr *battmgr, bool initial)
+{
+	struct nu1669_snapshot snapshot;
+	u32 gate;
+	int ret;
+	unsigned int i;
+	static const u32 properties[] = { USB_ONLINE, DODGE_USB_CID_STATUS, DODGE_USB_OTG_SWITCH };
+	static const char * const stages[] = { "usb-online", "usb-cid", "usb-otg" };
+
+	ret = qcom_battmgr_input_probe_current(battmgr);
+	if (ret)
+		return ret;
+	if (battmgr->dodge_power_state != DODGE_POWER_OFF)
+		return -EBUSY;
+	for (i = 0; i < ARRAY_SIZE(properties); i++) {
+		battmgr->input_stage = stages[i];
+		ret = qcom_battmgr_dodge_otg_request(battmgr, BATTMGR_USB_PROPERTY_GET,
+						   properties[i], 0, battmgr->input_generation);
+		if (ret || battmgr->dodge_otg_value)
+			return ret ?: -EBUSY;
+		ret = qcom_battmgr_input_probe_current(battmgr);
+		if (ret)
+			return ret;
+	}
+	battmgr->input_stage = "battery-health-temperature";
+	ret = qcom_battmgr_charge_healthy(battmgr, battmgr->input_generation);
+	if (ret)
+		return ret;
+	ret = qcom_battmgr_input_probe_current(battmgr);
+	if (ret)
+		return ret;
+	battmgr->input_stage = "battery-gate";
+	ret = qcom_battmgr_charge_raw_get(battmgr, battmgr->input_generation, &gate);
+	if (ret)
+		return ret;
+	if (gate != 1 && (gate != 0 || !qcom_battmgr_input_probe_pause_confirmed(battmgr)))
+		return -EBUSY;
+	battmgr->input_stage = "receiver-snapshot";
+	ret = nu1669_get_snapshot(battmgr->wireless_receiver, &snapshot);
+	if (ret)
+		return ret;
+	if (snapshot.chip_id != 0x1669 || snapshot.protocol != 0x04 || snapshot.b2b_on ||
+	    (snapshot.b2b_state & BIT(0)) || snapshot.vout_mv < 4500 || snapshot.vout_mv > 6000)
+		return -EOPNOTSUPP;
+	if (initial)
+		battmgr->input_receiver = snapshot;
+	else if (!qcom_battmgr_charge_same_receiver(&battmgr->input_receiver, &snapshot))
+		return -ESTALE;
+	return qcom_battmgr_input_probe_current(battmgr);
+}
