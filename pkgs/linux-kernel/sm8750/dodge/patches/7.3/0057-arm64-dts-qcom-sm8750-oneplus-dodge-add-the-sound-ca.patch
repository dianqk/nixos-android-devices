From 40fdb516bfead6b99d8642a580ed36c122ccb653 Mon Sep 17 00:00:00 2001
From: Martin Lund <mrlund@hotmail.com>
Date: Tue, 20 Oct 2026 11:56:34 +0200
Subject: [PATCH 062/144] arm64: dts: qcom: sm8750-oneplus-dodge: add the sound
 card

Secondary MI2S on q6apm to the two speaker amplifiers, with the i2s1
pins in their active state.

Assisted-by: Grok Bot
Signed-off-by: Martin Lund <mrlund@hotmail.com>
(cherry picked from commit 1868c5c3820580f05559234ba07ec4f558fb613d)
Link: https://github.com/mrlund/linux-omarchy-mobile/commit/1868c5c3820580f05559234ba07ec4f558fb613d

Import-Patch: pkgs/linux-kernel/sm8750/dodge/patches/7.3/0081-arm64-dts-qcom-sm8750-oneplus-dodge-add-the-sound-ca.patch
Import-SHA256: fb62e1edc65a113950ef38f2838bf6dfd38fd588829dc92ff5f984500e3fdf57
Import-Provenance: mail headers
(cherry picked from commit 5e04ef1dd79abe53874fc8b0e831d0e17c53aad6)
---
 .../boot/dts/qcom/sm8750-oneplus-dodge.dts    | 53 +++++++++++++++++++
 1 file changed, 53 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts b/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
index 72e7b34906..bdb9f69959 100644
--- a/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
+++ b/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
@@ -19,6 +19,30 @@ / {
 	compatible = "oneplus,dodge", "qcom,sm8750";
 	chassis-type = "handset";
 
+	sound {
+		compatible = "qcom,sm8750-sndcard", "qcom,sm8450-sndcard";
+		model = "OnePlus-dodge";
+
+		pinctrl-0 = <&i2s1_active>;
+		pinctrl-names = "default";
+
+		speaker-dai-link {
+			link-name = "Speaker Playback";
+
+			cpu {
+				sound-dai = <&q6apmbedai SECONDARY_MI2S_RX>;
+			};
+
+			codec {
+				sound-dai = <&speaker_left>, <&speaker_right>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+	};
+
 	pmic-glink {
 		compatible = "oneplus,dodge-pmic-glink", "qcom,sm8350-pmic-glink",
 			     "qcom,pmic-glink";
@@ -556,6 +580,35 @@ &pon_resin {
 };
 
 &tlmm {
+	i2s1_active: i2s1-active-state {
+		sck-pins {
+			pins = "gpio121";
+			function = "i2s1_sck";
+			drive-strength = <4>;
+			bias-disable;
+		};
+
+		data0-pins {
+			pins = "gpio122";
+			function = "i2s1_data0";
+			drive-strength = <4>;
+			bias-disable;
+		};
+
+		ws-pins {
+			pins = "gpio123";
+			function = "i2s1_ws";
+			drive-strength = <4>;
+			bias-disable;
+		};
+
+		data1-pins {
+			pins = "gpio124";
+			function = "i2s1_data1";
+			drive-strength = <4>;
+			bias-disable;
+		};
+	};
 	/* reserved for secure world */
 	gpio-reserved-ranges = <36 4>, <74 1>;
 
