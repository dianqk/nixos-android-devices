From 779e762be23d67cf8003985c6f4a2f4752b8fa10 Mon Sep 17 00:00:00 2001
From: Gianni Spadoni <me@gio.blue>
Date: Wed, 11 Mar 2026 16:19:06 +0800
Subject: [PATCH 015/144] wifi: ath12k: disable CNSS_QDSS_CFG_MISS_V01 for the
 WCN7860

This chip requires this change currently to negate a firmware crash. Follows up on the QDSS support in the previous commit.

Signed-off-by: Gianni Spadoni <me@gio.blue>
(cherry picked from commit c5394e3ae9909f7eccae3e5375958c41a2d48b0e)
(cherry picked from commit 61bb988128244d6a2f8444d0638dfc4234effb09)
(cherry picked from commit d2c08b194b2b1f10fa938033dd1faac303c238df)
(cherry picked from commit e30e787d8b21ea44a11e29c554bd133e8f8fa742)
Link: https://github.com/Xlie-Electronic-Customs/linux/commit/61bb988128244d6a2f8444d0638dfc4234effb09

Import-Patch: pkgs/linux-kernel/sm8750/dodge/patches/7.3/0026-wifi-ath12k-disable-CNSS_QDSS_CFG_MISS_V01-for-the-W.patch
Import-SHA256: 1ccbb8cc3e7bfd1e2662fc476e9c57254cf7379aaaab7cf66cf296787906f28d
Import-Provenance: mail headers
(cherry picked from commit f55c5a591e2037b26cace2d01351e9df715f58bc)
---
 drivers/net/wireless/ath/ath12k/wifi7/hw.c | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/drivers/net/wireless/ath/ath12k/wifi7/hw.c b/drivers/net/wireless/ath/ath12k/wifi7/hw.c
index d4155335f1..ad85dd85f5 100644
--- a/drivers/net/wireless/ath/ath12k/wifi7/hw.c
+++ b/drivers/net/wireless/ath/ath12k/wifi7/hw.c
@@ -768,8 +768,7 @@ static const struct ath12k_hw_params ath12k_wifi7_hw_params[] = {
 
 		.wmi_init = ath12k_wifi7_wmi_init_wcn7850,
 
-		.qmi_cnss_feature_bitmap = BIT(CNSS_QDSS_CFG_MISS_V01) |
-					   BIT(CNSS_PCIE_PERST_NO_PULL_V01) |
+		.qmi_cnss_feature_bitmap = BIT(CNSS_PCIE_PERST_NO_PULL_V01) |
 					   BIT(CNSS_AUX_UC_SUPPORT_V01),
 
 		.rfkill_pin = 0,
