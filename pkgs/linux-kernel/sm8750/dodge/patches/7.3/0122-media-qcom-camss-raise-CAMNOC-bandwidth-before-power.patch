From a60add8159275f9073757c3f4b592ebb4f9ca377 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Wed, 11 Nov 2026 05:02:36 +0800
Subject: [PATCH 127/144] media: qcom: camss: raise CAMNOC bandwidth before
 powering on

Keep the bandwidth-ordering and CPAS observation changes together.

Consolidated from local follow-ups:
  e7ddc2bbd8df0775754a8866825c5b11dda719d2 media: qcom: camss: raise bandwidth before waiting for CAMNOC on
  382ff3c2c337191a571779fafbe1045c2381620b media: qcom: camss: observe CPAS channels without requesting firmware ownership
---
 drivers/media/platform/qcom/camss/camss.c | 45 ++++++-----------------
 1 file changed, 11 insertions(+), 34 deletions(-)

diff --git a/drivers/media/platform/qcom/camss/camss.c b/drivers/media/platform/qcom/camss/camss.c
index 9da0645d04..7d698700e3 100644
--- a/drivers/media/platform/qcom/camss/camss.c
+++ b/drivers/media/platform/qcom/camss/camss.c
@@ -9,7 +9,6 @@
  */
 #include <linux/clk.h>
 #include <linux/interconnect.h>
-#include <linux/iopoll.h>
 #include <linux/media-bus-format.h>
 #include <linux/media.h>
 #include <linux/module.h>
@@ -6361,32 +6360,18 @@ static const struct of_device_id camss_dt_match[] = {
 
 MODULE_DEVICE_TABLE(of, camss_dt_match);
 
-/* CPAS-980 has one Q-channel for each of RT and NRT CAMNOC. Keep both
- * CAMNOC clocks running until idle is acknowledged, before dropping votes.
- */
-static int camss_qchannel_set(struct camss *camss, bool on)
+/* Observe the CPAS-980 handshake while the camera register clocks run. */
+static void camss_qchannel_log(struct camss *camss, const char *state)
 {
-	u32 status;
-	int i, ret;
+	int i;
 
 	if (!camss->qchannel_base)
-		return 0;
-
-	for (i = 0; i < 2; i++) {
-		writel(on, camss->qchannel_base + i * 8);
-		ret = readl_poll_timeout(camss->qchannel_base + i * 8 + 4,
-					status, !!(status & BIT(0)) == on,
-					10, 10000);
-		if (ret) {
-			dev_err(camss->dev, "CAMNOC %s Q-channel %u status %#x\n",
-				on ? "start" : "idle", i, status);
-			return ret;
-		}
-		dev_dbg(camss->dev, "CAMNOC Q-channel %u %s status %#x\n",
-			i, on ? "on" : "idle", status);
-	}
+		return;
 
-	return 0;
+	for (i = 0; i < 2; i++)
+		dev_dbg(camss->dev, "CAMNOC %s Q-channel %u control %#x status %#x\n",
+			state, i, readl(camss->qchannel_base + i * 8),
+			readl(camss->qchannel_base + i * 8 + 4));
 }
 
 static int __maybe_unused camss_runtime_suspend(struct device *dev)
@@ -6395,11 +6380,7 @@ static int __maybe_unused camss_runtime_suspend(struct device *dev)
 	int i;
 	int ret;
 
-	ret = camss_qchannel_set(camss, false);
-	if (ret) {
-		camss_qchannel_set(camss, true);
-		return ret;
-	}
+	camss_qchannel_log(camss, "suspend");
 
 	for (i = 0; i < camss->res->icc_path_num; i++) {
 		ret = icc_set_bw(camss->icc_path[i], 0, 0);
@@ -6427,12 +6408,6 @@ static int __maybe_unused camss_runtime_resume(struct device *dev)
 		return ret;
 #endif
 
-	ret = camss_qchannel_set(camss, true);
-	if (ret) {
-		pm_clk_suspend(dev);
-		return ret;
-	}
-
 	for (i = 0; i < camss->res->icc_path_num; i++) {
 		ret = icc_set_bw(camss->icc_path[i],
 				 icc_res[i].icc_bw_tbl.avg,
@@ -6441,6 +6416,8 @@ static int __maybe_unused camss_runtime_resume(struct device *dev)
 			return ret;
 	}
 
+	camss_qchannel_log(camss, "resume");
+
 	return 0;
 }
 
