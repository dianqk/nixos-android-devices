From ca2a1dcbd61fcee3540d574c16fe060d24415de1 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Fri, 6 Nov 2026 23:33:33 +0800
Subject: [PATCH 004/144] drm/msm: bring up the Dodge AA569 panel and MDSS
 reset path

Keep the panel adaptation, MDSS reset sequence and matching board resets together.

Consolidated from local follow-ups:
  68c9d899d76ef353b280bd469a05451d03ee6bd1 drm/panel: adapt Dodge AA569 power and backlight control
  598287bde6956387ce108132b8b581b881e8580d drm/msm: reset all MDSS reset lines on Dodge
  7df83b3ffc862018466c3a19e066eff4a5b7146c arm64: dts: qcom: limit Dodge MDSS resets to core and int2
---
 .../bindings/display/msm/mdss-common.yaml     |  25 +++-
 .../display/panel/oneplus,dodge-panel.yaml    |  48 ++++++++
 .../boot/dts/qcom/sm8750-oneplus-dodge.dts    | 110 ++++++++++++++++++
 drivers/gpu/drm/msm/msm_mdss.c                |  17 ++-
 .../gpu/drm/panel/panel-aa569-p-3-a0019-dsc.c |  94 +++++++++++----
 5 files changed, 266 insertions(+), 28 deletions(-)
 create mode 100644 Documentation/devicetree/bindings/display/panel/oneplus,dodge-panel.yaml

diff --git a/Documentation/devicetree/bindings/display/msm/mdss-common.yaml b/Documentation/devicetree/bindings/display/msm/mdss-common.yaml
index c6305a6e03..24c6c81636 100644
--- a/Documentation/devicetree/bindings/display/msm/mdss-common.yaml
+++ b/Documentation/devicetree/bindings/display/msm/mdss-common.yaml
@@ -84,8 +84,8 @@ properties:
           - const: cpu-cfg
 
   resets:
-    items:
-      - description: MDSS_CORE reset
+    minItems: 1
+    maxItems: 2
 
   memory-region:
     maxItems: 1
@@ -93,6 +93,27 @@ properties:
       Phandle to a node describing a reserved framebuffer memory region.
       For example, the splash memory region set up by the bootloader.
 
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: qcom,sm8750-mdss
+      required:
+        - compatible
+    then:
+      properties:
+        resets:
+          minItems: 1
+          items:
+            - description: MDSS_CORE reset
+            - description: MDSS_CORE_INT2 reset
+    else:
+      properties:
+        resets:
+          items:
+            - description: MDSS_CORE reset
+
 required:
   - reg
   - reg-names
diff --git a/Documentation/devicetree/bindings/display/panel/oneplus,dodge-panel.yaml b/Documentation/devicetree/bindings/display/panel/oneplus,dodge-panel.yaml
new file mode 100644
index 0000000000..ab871e11b6
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/panel/oneplus,dodge-panel.yaml
@@ -0,0 +1,48 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/oneplus,dodge-panel.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: OnePlus 13 AA569 P_3_A0019 AMOLED panel
+
+maintainers:
+  - dianqk <dianqk@dianqk.net>
+
+description:
+  The 1440x3168 panel uses four-lane MIPI DSI command mode with DSC.
+  Its power sequence requires VDDIO, the panel enable GPIO and VCI.
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: oneplus,dodge-panel
+
+  reg:
+    maxItems: 1
+
+  vddio-supply:
+    description: 1.8 V I/O supply
+
+  vci-supply:
+    description: 3.0 V analog supply
+
+  reset-gpios:
+    maxItems: 1
+
+  enable-gpios:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - vddio-supply
+  - vci-supply
+  - reset-gpios
+  - enable-gpios
+  - port
+
+unevaluatedProperties: false
+...
diff --git a/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts b/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
index a9ec6b286e..a628b2ed01 100644
--- a/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
+++ b/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
@@ -9,6 +9,8 @@
 #include <dt-bindings/regulator/qcom,rpmh-regulator.h>
 #include "sm8750.dtsi"
 #include "pm8550.dtsi"
+#define PMK8550VE_SID 5
+#include "pm8550ve.dtsi"
 #include "pmih0108.dtsi"
 #include "pmk8550.dtsi"
 
@@ -121,6 +123,8 @@ regulators-0 {
 		vdd-bob2-supply = <&vph_pwr>;
 		vdd-l1-l4-l10-supply = <&vreg_s3g_1p8>;
 		vdd-l5-l16-supply = <&vreg_bob1>;
+		vdd-l12-supply = <&vreg_s3g_1p8>;
+		vdd-l2-l13-l14-supply = <&vreg_bob1>;
 		vdd-l15-supply = <&vreg_s3g_1p8>;
 		vdd-l17-supply = <&vreg_bob2>;
 
@@ -158,6 +162,26 @@ vreg_l5b_3p1: ldo5 {
 						   RPMH_REGULATOR_MODE_HPM>;
 		};
 
+		vreg_l12b_1p8: ldo12 {
+			regulator-name = "vreg_l12b_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-allow-set-load;
+			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
+						   RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l13b_3p0: ldo13 {
+			regulator-name = "vreg_l13b_3p0";
+			regulator-min-microvolt = <3000000>;
+			regulator-max-microvolt = <3000000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-allow-set-load;
+			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
+						   RPMH_REGULATOR_MODE_HPM>;
+		};
+
 		vreg_l15b_1p8: ldo15 {
 			regulator-name = "vreg_l15b_1p8";
 			regulator-min-microvolt = <1800000>;
@@ -245,6 +269,7 @@ regulators-4 {
 		compatible = "qcom,pm8550ve-rpmh-regulators";
 		qcom,pmic-id = "i";
 		vdd-s7-supply = <&vph_pwr>;
+		vdd-l3-supply = <&vreg_s1d_0p97>;
 
 		vreg_s7i_1p2: smps7 {
 			regulator-name = "vreg_s7i_1p2";
@@ -252,6 +277,16 @@ vreg_s7i_1p2: smps7 {
 			regulator-max-microvolt = <1340000>;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 		};
+
+		vreg_l3i_0p88: ldo3 {
+			regulator-name = "vreg_l3i_0p88";
+			regulator-min-microvolt = <880000>;
+			regulator-max-microvolt = <912000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-allow-set-load;
+			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
+						   RPMH_REGULATOR_MODE_HPM>;
+		};
 	};
 
 	regulators-5 {
@@ -287,6 +322,15 @@ volume_down_n: volume-down-n-state {
 	};
 };
 
+&pm8550ve_gpios {
+	panel_enable: panel-enable-state {
+		pins = "gpio7";
+		function = "normal";
+		power-source = <1>;
+		bias-disable;
+	};
+};
+
 &pon_pwrkey {
 	status = "okay";
 };
@@ -300,6 +344,34 @@ &pon_resin {
 &tlmm {
 	/* reserved for secure world */
 	gpio-reserved-ranges = <36 4>, <74 1>;
+
+	disp0_reset_n_active: disp0-reset-n-active-state {
+		pins = "gpio98";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	disp0_reset_n_suspend: disp0-reset-n-suspend-state {
+		pins = "gpio98";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	mdp_vsync_active: mdp-vsync-active-state {
+		pins = "gpio86";
+		function = "mdp_vsync";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	mdp_vsync_suspend: mdp-vsync-suspend-state {
+		pins = "gpio86";
+		function = "mdp_vsync";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
 };
 
 &usb {
@@ -325,7 +397,45 @@ &usb_hsphy {
 };
 
 &mdss {
+	resets = <&dispcc DISP_CC_MDSS_CORE_BCR>,
+		 <&dispcc DISP_CC_MDSS_CORE_INT2_BCR>;
 	memory-region = <&cont_splash_mem>;
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	vdda-supply = <&vreg_l3g_1p2>;
+	status = "okay";
+
+	panel@0 {
+		compatible = "oneplus,dodge-panel";
+		reg = <0>;
+
+		pinctrl-names = "default", "sleep";
+		pinctrl-0 = <&disp0_reset_n_active>, <&mdp_vsync_active>, <&panel_enable>;
+		pinctrl-1 = <&disp0_reset_n_suspend>, <&mdp_vsync_suspend>, <&panel_enable>;
+
+		vddio-supply = <&vreg_l12b_1p8>;
+		vci-supply = <&vreg_l13b_3p0>;
+		reset-gpios = <&tlmm 98 GPIO_ACTIVE_LOW>;
+		enable-gpios = <&pm8550ve_gpios 7 GPIO_ACTIVE_HIGH>;
+
+		port {
+			panel0_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	remote-endpoint = <&panel0_in>;
+	data-lanes = <0 1 2 3>;
+};
+
+&mdss_dsi0_phy {
+	vdds-supply = <&vreg_l3i_0p88>;
+	status = "okay";
 };
 
 &ufs_mem_hc {
diff --git a/drivers/gpu/drm/msm/msm_mdss.c b/drivers/gpu/drm/msm/msm_mdss.c
index 9087c4b290..58d30119a8 100644
--- a/drivers/gpu/drm/msm/msm_mdss.c
+++ b/drivers/gpu/drm/msm/msm_mdss.c
@@ -309,27 +309,32 @@ static void msm_mdss_destroy(struct msm_mdss *msm_mdss)
 static int msm_mdss_reset(struct device *dev)
 {
 	struct reset_control *reset;
+	int ret;
 
-	reset = reset_control_get_optional_exclusive(dev, NULL);
+	reset = fwnode_reset_control_array_get(dev_fwnode(dev),
+					       RESET_CONTROL_OPTIONAL_EXCLUSIVE);
 	if (!reset) {
-		/* Optional reset not specified */
+		/* Optional resets not specified */
 		return 0;
 	} else if (IS_ERR(reset)) {
 		return dev_err_probe(dev, PTR_ERR(reset),
-				     "failed to acquire mdss reset\n");
+				     "failed to acquire mdss resets\n");
 	}
 
-	reset_control_assert(reset);
+	ret = reset_control_assert(reset);
+	if (ret)
+		goto out;
 	/*
 	 * Tests indicate that reset has to be held for some period of time,
 	 * make it one frame in a typical system
 	 */
 	msleep(20);
-	reset_control_deassert(reset);
+	ret = reset_control_deassert(reset);
 
+out:
 	reset_control_put(reset);
 
-	return 0;
+	return ret ? dev_err_probe(dev, ret, "failed to reset mdss\n") : 0;
 }
 
 /*
diff --git a/drivers/gpu/drm/panel/panel-aa569-p-3-a0019-dsc.c b/drivers/gpu/drm/panel/panel-aa569-p-3-a0019-dsc.c
index c1eb231482..269e575b24 100644
--- a/drivers/gpu/drm/panel/panel-aa569-p-3-a0019-dsc.c
+++ b/drivers/gpu/drm/panel/panel-aa569-p-3-a0019-dsc.c
@@ -21,13 +21,9 @@ struct panel_aa569_p_3_a0019_dsc {
 	struct mipi_dsi_device *dsi;
 	struct drm_dsc_config dsc;
 	struct gpio_desc *reset_gpio;
-	struct regulator_bulk_data *supplies;
-};
-
-static const struct regulator_bulk_data panel_aa569_supplies[] = {
-	{ .supply = "vddio" },
-	{ .supply = "vci" },
-	{ .supply = "vdd" },
+	struct gpio_desc *enable_gpio;
+	struct regulator *vddio;
+	struct regulator *vci;
 };
 
 static inline
@@ -36,6 +32,50 @@ struct panel_aa569_p_3_a0019_dsc *to_panel_aa569_p_3_a0019_dsc(struct drm_panel
 	return container_of(panel, struct panel_aa569_p_3_a0019_dsc, panel);
 }
 
+static int panel_aa569_p_3_a0019_dsc_power_on(struct panel_aa569_p_3_a0019_dsc *ctx)
+{
+	int ret, err;
+
+	usleep_range(1000, 1100);
+	ret = regulator_enable(ctx->vddio);
+	if (ret)
+		return ret;
+	usleep_range(3000, 3100);
+	gpiod_set_value_cansleep(ctx->enable_gpio, 1);
+	usleep_range(3000, 3100);
+	ret = regulator_enable(ctx->vci);
+	if (ret) {
+		/* VCI did not acquire a reference; unwind only the earlier steps. */
+		usleep_range(4000, 4100);
+		gpiod_set_value_cansleep(ctx->enable_gpio, 0);
+		usleep_range(3000, 3100);
+		err = regulator_disable(ctx->vddio);
+		if (err)
+			dev_err(&ctx->dsi->dev, "Failed to disable vddio: %d\n", err);
+		usleep_range(1000, 1100);
+		return ret;
+	}
+	msleep(10);
+	return 0;
+}
+
+static void panel_aa569_p_3_a0019_dsc_power_off(struct panel_aa569_p_3_a0019_dsc *ctx)
+{
+	int ret;
+
+	usleep_range(1000, 1100);
+	ret = regulator_disable(ctx->vci);
+	if (ret)
+		dev_err(&ctx->dsi->dev, "Failed to disable vci: %d\n", ret);
+	usleep_range(3000, 3100);
+	gpiod_set_value_cansleep(ctx->enable_gpio, 0);
+	usleep_range(3000, 3100);
+	ret = regulator_disable(ctx->vddio);
+	if (ret)
+		dev_err(&ctx->dsi->dev, "Failed to disable vddio: %d\n", ret);
+	usleep_range(1000, 1100);
+}
+
 static void panel_aa569_p_3_a0019_dsc_reset(struct panel_aa569_p_3_a0019_dsc *ctx)
 {
 	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
@@ -235,6 +275,14 @@ static int panel_aa569_p_3_a0019_dsc_on(struct panel_aa569_p_3_a0019_dsc *ctx)
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb7, 0xff, 0x01, 0x06);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb8, 0xff, 0x06, 0x03);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x5a, 0xa5, 0x00);
+	/* Start every prepare dark; the backlight core restores the low level. */
+	if (!dsi_ctx.accum_err) {
+		unsigned long mode_flags = ctx->dsi->mode_flags;
+
+		ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+		dsi_ctx.accum_err = mipi_dsi_dcs_set_display_brightness_large(ctx->dsi, 0);
+		ctx->dsi->mode_flags = mode_flags;
+	}
 	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
 
 	return dsi_ctx.accum_err;
@@ -262,8 +310,7 @@ static int panel_aa569_p_3_a0019_dsc_prepare(struct drm_panel *panel)
 	struct drm_dsc_picture_parameter_set pps;
 	int ret;
 
-	ret = regulator_bulk_enable(ARRAY_SIZE(panel_aa569_supplies),
-				    ctx->supplies);
+	ret = panel_aa569_p_3_a0019_dsc_power_on(ctx);
 	if (ret < 0)
 		return ret;
 
@@ -295,7 +342,7 @@ static int panel_aa569_p_3_a0019_dsc_prepare(struct drm_panel *panel)
 
 err_poweroff:
 	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
-	regulator_bulk_disable(ARRAY_SIZE(panel_aa569_supplies), ctx->supplies);
+	panel_aa569_p_3_a0019_dsc_power_off(ctx);
 	return ret;
 }
 
@@ -310,7 +357,7 @@ static int panel_aa569_p_3_a0019_dsc_unprepare(struct drm_panel *panel)
 		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
 
 	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
-	regulator_bulk_disable(ARRAY_SIZE(panel_aa569_supplies), ctx->supplies);
+	panel_aa569_p_3_a0019_dsc_power_off(ctx);
 
 	return 0;
 }
@@ -347,6 +394,7 @@ static int panel_aa569_p_3_a0019_dsc_bl_update_status(struct backlight_device *b
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
 	struct panel_aa569_p_3_a0019_dsc *ctx = mipi_dsi_get_drvdata(dsi);
 	u16 brightness = backlight_get_brightness(bl);
+	unsigned long mode_flags = dsi->mode_flags;
 	int ret;
 
 	if (!ctx->panel.prepared)
@@ -356,7 +404,7 @@ static int panel_aa569_p_3_a0019_dsc_bl_update_status(struct backlight_device *b
 
 	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
 
-	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	dsi->mode_flags = mode_flags;
 
 	return ret;
 }
@@ -367,6 +415,7 @@ static int panel_aa569_p_3_a0019_dsc_bl_get_brightness(struct backlight_device *
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
 	struct panel_aa569_p_3_a0019_dsc *ctx = mipi_dsi_get_drvdata(dsi);
 	u16 brightness;
+	unsigned long mode_flags = dsi->mode_flags;
 	int ret;
 
 	if (!ctx->panel.prepared)
@@ -376,7 +425,7 @@ static int panel_aa569_p_3_a0019_dsc_bl_get_brightness(struct backlight_device *
 
 	ret = mipi_dsi_dcs_get_display_brightness_large(dsi, &brightness);
 
-	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	dsi->mode_flags = mode_flags;
 
 	return ret < 0 ? ret : brightness;
 }
@@ -392,7 +441,7 @@ panel_aa569_p_3_a0019_dsc_create_backlight(struct mipi_dsi_device *dsi)
 	struct device *dev = &dsi->dev;
 	const struct backlight_properties props = {
 		.type = BACKLIGHT_RAW,
-		.brightness = 2047,
+		.brightness = 64,
 		.max_brightness = 3502, // 15% cut to prevent burn in ( original value 4095 )
 	};
 
@@ -417,12 +466,17 @@ static int panel_aa569_p_3_a0019_dsc_probe(struct mipi_dsi_device *dsi)
 		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
 				     "Failed to get reset-gpios\n");
 
-	ret = devm_regulator_bulk_get_const(dev,
-					    ARRAY_SIZE(panel_aa569_supplies),
-					    panel_aa569_supplies,
-					    &ctx->supplies);
-	if (ret)
-		return dev_err_probe(dev, ret, "Failed to get regulators\n");
+	ctx->enable_gpio = devm_gpiod_get(dev, "enable", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->enable_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->enable_gpio),
+				     "Failed to get enable-gpios\n");
+
+	ctx->vddio = devm_regulator_get(dev, "vddio");
+	if (IS_ERR(ctx->vddio))
+		return dev_err_probe(dev, PTR_ERR(ctx->vddio), "Failed to get vddio\n");
+	ctx->vci = devm_regulator_get(dev, "vci");
+	if (IS_ERR(ctx->vci))
+		return dev_err_probe(dev, PTR_ERR(ctx->vci), "Failed to get vci\n");
 
 	ctx->dsi = dsi;
 	mipi_dsi_set_drvdata(dsi, ctx);
