diff --git a/drivers/phy/qualcomm/phy-qcom-mipi-csi2-sm8750.c b/drivers/phy/qualcomm/phy-qcom-mipi-csi2-sm8750.c
new file mode 100644
index 0000000000..8b8a296ba7
--- /dev/null
+++ b/drivers/phy/qualcomm/phy-qcom-mipi-csi2-sm8750.c
@@ -0,0 +1,97 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Qualcomm SM8750 CSIPHY 2.3.0 three-phase operation. */
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/math64.h>
+#include <linux/time64.h>
+
+#include "phy-qcom-mipi-csi2.h"
+#include "phy-qcom-mipi-csi2-sm8750.h"
+
+static void sm8750_cphy_write(struct mipi_csi2phy_device *phy,
+			     const struct mipi_csi2phy_lane_regs *regs,
+			     size_t count, u16 settle)
+{
+	size_t i;
+
+	for (i = 0; i < count; i++) {
+		u32 value = regs[i].reg_data;
+
+		if (regs[i].param_type == 2)
+			value = settle & 0xff;
+		else if (regs[i].param_type == 3)
+			value = settle >> 8;
+		writel(value, phy->base + regs[i].reg_addr);
+		if (regs[i].delay_us)
+			fsleep(regs[i].delay_us);
+	}
+}
+
+static int sm8750_cphy_enable(struct mipi_csi2phy_device *phy,
+			      struct mipi_csi2phy_stream_cfg *cfg)
+{
+	const struct mipi_csi2phy_datarate_regs *tier = NULL;
+	u64 symbol_rate = cfg->link_freq * 2;
+	u64 count;
+	u32 lane_mask = 0;
+	unsigned int i;
+
+	if (!symbol_rate || !phy->timer_clk_rate || !cfg->num_data_lanes ||
+	    cfg->num_data_lanes > 3)
+		return -EINVAL;
+	for (i = 0; i < cfg->num_data_lanes; i++) {
+		unsigned int lane = cfg->lane_cfg.data[i].pos;
+
+		if (lane > 2 || cfg->lane_cfg.data[i].pol ||
+		    (lane_mask & BIT(lane * 2 + 1)))
+			return -EINVAL;
+		lane_mask |= BIT(lane * 2 + 1);
+	}
+	for (i = 0; i < ARRAY_SIZE(sm8750_cphy_rates); i++)
+		if (sm8750_cphy_rates[i].bandwidth >= symbol_rate) {
+			tier = &sm8750_cphy_rates[i];
+			break;
+		}
+	if (!tier)
+		return -ERANGE;
+
+	/* CPAS 2.3 compensates ten timer cycles, as in the OEM PHY driver. */
+	count = div64_u64((u64)cfg->cphy_settle_ps * phy->timer_clk_rate,
+			PSEC_PER_SEC);
+	if (count <= 10 || count > 0xffff + 10)
+		return -ERANGE;
+	count -= 10;
+
+	writel(0, phy->base + 0x1084);
+	writel(0x0e, phy->base + 0x108c);
+	fsleep(1);
+	writel(0x7a, phy->base + 0x101c);
+	writel(1, phy->base + 0x1018);
+	writel(0x0e, phy->base + 0x1000);
+	fsleep(3048);
+	writel(lane_mask, phy->base + 0x1014);
+
+	/* Preserve the OEM order: rate settings, then common per-trio setup. */
+	sm8750_cphy_write(phy, tier->reg_array, tier->reg_array_size, count);
+	sm8750_cphy_write(phy, csiphy_3ph_v2_3_0_reg,
+			  ARRAY_SIZE(csiphy_3ph_v2_3_0_reg), count);
+	for (i = 11; i < 22; i++)
+		writel(0, phy->base + 0x1000 + 4 * i);
+	dev_dbg(phy->dev, "C-PHY %llu sym/s timer %u settle %llu mask %#x\n",
+		symbol_rate, phy->timer_clk_rate, count, lane_mask);
+	return 0;
+}
+
+static void sm8750_cphy_disable(struct mipi_csi2phy_device *phy,
+				struct mipi_csi2phy_stream_cfg *cfg)
+{
+	writel(0, phy->base + 0x1014);
+	writel(0, phy->base + 0x1018);
+}
+
+const struct mipi_csi2phy_hw_ops phy_qcom_mipi_csi2_ops_sm8750_cphy = {
+	.hw_version_read = phy_qcom_mipi_csi2_hw_version_read,
+	.reset = phy_qcom_mipi_csi2_reset,
+	.lanes_enable = sm8750_cphy_enable,
+	.lanes_disable = sm8750_cphy_disable,
+};
