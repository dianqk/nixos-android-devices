+/* Caller holds lock; all checks and requests belong to the cached attachment. */
+static bool qcom_battmgr_dodge_pd_valid(struct qcom_battmgr *battmgr)
+{
+	unsigned long flags;
+	bool valid;
+
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	valid = qcom_battmgr_dodge_pd_current(battmgr) &&
+		!battmgr->dodge_otg_broken;
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+	return valid;
+}
