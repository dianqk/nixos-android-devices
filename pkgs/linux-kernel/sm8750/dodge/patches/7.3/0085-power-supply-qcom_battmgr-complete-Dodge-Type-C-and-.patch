+/* Caller holds dodge_otg_lock. */
+static bool qcom_battmgr_dodge_pd_current(struct qcom_battmgr *battmgr)
+{
+	return battmgr->service_up && !battmgr->dodge_otg_stopping &&
+		!battmgr->dodge_otg_requested &&
+		battmgr->dodge_pd_caps_revision == battmgr->dodge_pd_revision &&
+		battmgr->dodge_pd_generation == battmgr->dodge_service_generation &&
+		battmgr->dodge_pd_epoch == battmgr->dodge_otg_epoch &&
+		battmgr->dodge_pd_sequence == battmgr->dodge_cid_sequence;
+}
