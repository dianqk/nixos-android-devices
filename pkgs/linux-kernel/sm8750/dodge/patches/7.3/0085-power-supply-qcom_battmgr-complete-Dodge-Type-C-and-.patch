+/* Caller serializes firmware requests with battmgr->lock. */
+static int qcom_battmgr_dodge_otg_request(struct qcom_battmgr *battmgr,
+				       u32 opcode, u32 property, u32 value,
+				       u32 generation)
+{
+	struct qcom_battmgr_property_request req = {
+		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_BATTMGR),
+		.hdr.type = cpu_to_le32(PMIC_GLINK_REQ_RESP),
+		.hdr.opcode = cpu_to_le32(opcode),
+		.property = cpu_to_le32(property),
+		.value = cpu_to_le32(value),
+	};
+	bool power = opcode == BATTMGR_USB_PROPERTY_SET &&
+		     property == DODGE_USB_OTG_VBUS_ENABLE;
+	bool power_off = power && !value;
+	unsigned long flags, left;
+	int ret;
+
+	reinit_completion(&battmgr->dodge_otg_ack);
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	if (!battmgr->service_up ||
+	    (battmgr->dodge_otg_stopping && !power_off) ||
+	    (battmgr->dodge_otg_broken && !power_off) ||
+	    (power && battmgr->dodge_power_ambiguous) ||
+	    generation != battmgr->dodge_service_generation) {
+		spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+		return -ENOTCONN;
+	}
+	battmgr->dodge_otg_opcode = opcode;
+	battmgr->dodge_otg_property = property;
+	battmgr->dodge_otg_pending = true;
+	battmgr->dodge_otg_error = -ETIMEDOUT;
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+
+	ret = pmic_glink_send(battmgr->client, &req, sizeof(req));
+	if (!ret) {
+		left = wait_for_completion_timeout(&battmgr->dodge_otg_ack, HZ);
+		ret = left ? battmgr->dodge_otg_error : -ETIMEDOUT;
+	}
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	battmgr->dodge_otg_pending = false;
+	/* No transaction ID: never retry an ambiguous write in this service. */
+	if ((ret == -ETIMEDOUT || (power && ret)) &&
+	    generation == battmgr->dodge_service_generation) {
+		battmgr->dodge_otg_broken = true;
+		if (power && ret == -ETIMEDOUT)
+			battmgr->dodge_power_ambiguous = true;
+		if (!battmgr->dodge_otg_stopping)
+			mod_delayed_work(system_percpu_wq, &battmgr->dodge_otg_work, 0);
+	}
+	if (!battmgr->service_up ||
+	    generation != battmgr->dodge_service_generation)
+		ret = -ENOTCONN;
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+	return ret;
+}
