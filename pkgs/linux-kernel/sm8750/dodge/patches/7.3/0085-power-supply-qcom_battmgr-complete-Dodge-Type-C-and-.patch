+static void qcom_battmgr_remove(struct auxiliary_device *adev)
+{
+	struct qcom_battmgr *battmgr = dev_get_drvdata(&adev->dev);
+	unsigned long flags;
+
+	if (battmgr->variant != QCOM_BATTMGR_DODGE)
+		return;
+	/* Keep the client alive while in-flight requests drain and OFF is sent. */
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	battmgr->dodge_otg_stopping = true;
+	battmgr->dodge_cid_pending = false;
+	battmgr->dodge_cid_sequence++;
+	battmgr->dodge_otg_ready = false;
+	battmgr->dodge_otg_requested = false;
+	battmgr->dodge_otg_epoch++;
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+	cancel_work_sync(&battmgr->enable_work);
+	cancel_work_sync(&battmgr->dodge_cid_work);
+	cancel_delayed_work_sync(&battmgr->dodge_otg_work);
+	mutex_lock(&battmgr->lock);
+	qcom_battmgr_dodge_power_off(battmgr,
+				 READ_ONCE(battmgr->dodge_service_generation));
+	mutex_unlock(&battmgr->lock);
+}
