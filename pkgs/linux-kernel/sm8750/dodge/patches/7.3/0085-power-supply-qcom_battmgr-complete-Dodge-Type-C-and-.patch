+static unsigned int qcom_battmgr_dodge_pd_fixed_ma(
+		const struct qcom_battmgr_dodge_pd_caps *caps, unsigned int mv)
+{
+	unsigned int i;
+
+	for (i = 0; i < caps->count; i++) {
+		u32 pdo = caps->pdo[i];
+
+		if (!(pdo >> 30) && ((pdo >> 10) & 0x3ff) * 50 == mv)
+			return (pdo & 0x3ff) * 10;
+	}
+	return 0;
+}
+
+static int qcom_battmgr_dodge_pd_property(struct qcom_battmgr *battmgr,
+					u32 opcode, u32 property, u32 value)
+{
+	int ret;
+
+	if (!qcom_battmgr_dodge_pd_valid(battmgr))
+		return -ENOTCONN;
+	ret = qcom_battmgr_dodge_otg_request(battmgr, opcode, property, value,
+					   battmgr->dodge_pd_generation);
+	if (!ret && !qcom_battmgr_dodge_pd_valid(battmgr))
+		ret = -ENOTCONN;
+	return ret;
+}
+
+/* A conservative request gate, not a replacement for the OEM thermal policy. */
+static int qcom_battmgr_dodge_pd_check_battery(struct qcom_battmgr *battmgr)
+{
+	struct qcom_battmgr_dodge_request req = {
+		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_BATTMGR),
+		.hdr.type = cpu_to_le32(PMIC_GLINK_REQ_RESP),
+		.hdr.opcode = cpu_to_le32(DODGE_GAUGE_OPCODE),
+		.data_size = cpu_to_le32(DODGE_GAUGE_WORDS * sizeof(__le32)),
+	};
+	int ret;
+
+	ret = qcom_battmgr_dodge_pd_property(battmgr, BATTMGR_BAT_PROPERTY_GET,
+					   BATT_HEALTH, 0);
+	if (ret)
+		return ret;
+	if (battmgr->dodge_otg_value != POWER_SUPPLY_HEALTH_GOOD)
+		return -EAGAIN;
+	WRITE_ONCE(battmgr->dodge_gauge_pending, true);
+	ret = qcom_battmgr_request(battmgr, &req, sizeof(req));
+	WRITE_ONCE(battmgr->dodge_gauge_pending, false);
+	if (ret)
+		return ret;
+	/* Do not infer individual cell voltage from the ambiguous pack field. */
+	if (!qcom_battmgr_dodge_pd_valid(battmgr) ||
+	    (s32)battmgr->dodge_gauge[0] < 0 || battmgr->dodge_gauge[0] > 430 ||
+	    battmgr->dodge_gauge[3] >= 9500)
+		return -EAGAIN;
+	return 0;
+}
+
+static int qcom_battmgr_dodge_pd_wait_voltage(struct qcom_battmgr *battmgr,
+					    unsigned int mv)
+{
+	unsigned int i, uv;
+	int ret;
+
+	for (i = 0; i < 10; i++) {
+		ret = qcom_battmgr_dodge_pd_property(battmgr, BATTMGR_USB_PROPERTY_GET,
+						   USB_VOLT_NOW, 0);
+		if (ret)
+			return ret;
+		uv = battmgr->dodge_otg_value;
+		if ((mv == 9000 && uv >= 8000000 && uv <= 10000000) ||
+		    (mv == 5000 && uv >= 4000000 && uv <= 5500000))
+			return 0;
+		msleep(200);
+	}
+	return -ETIMEDOUT;
+}
+
+static int qcom_battmgr_dodge_usb_set_property(struct power_supply *psy,
+					    enum power_supply_property psp,
+					    const union power_supply_propval *val)
+{
+	struct qcom_battmgr *battmgr = power_supply_get_drvdata(psy);
+	unsigned int mv, current_ua;
+	int ret, fallback_ret;
+
+	if (battmgr->variant != QCOM_BATTMGR_DODGE || psp != POWER_SUPPLY_PROP_VOLTAGE_MAX)
+		return -EOPNOTSUPP;
+	if (val->intval != 5000000 && val->intval != 9000000)
+		return -EINVAL;
+	mv = val->intval / 1000;
+	mutex_lock(&battmgr->lock);
+	ret = qcom_battmgr_dodge_pd_read_caps(battmgr);
+	if (ret)
+		goto out;
+	/* Use an actual fixed PDO, never an APDO or a proprietary label rating. */
+	current_ua = min(qcom_battmgr_dodge_pd_fixed_ma(&battmgr->dodge_pd_caps, mv),
+			 2000U) * 1000;
+	if (current_ua < 500000 || (mv == 9000 && current_ua < 2000000)) {
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+	ret = qcom_battmgr_dodge_pd_property(battmgr, BATTMGR_USB_PROPERTY_GET,
+					   USB_ONLINE, 0);
+	if (ret || !battmgr->dodge_otg_value) {
+		ret = ret ?: -ENODEV;
+		goto out;
+	}
+	ret = qcom_battmgr_dodge_pd_property(battmgr, BATTMGR_WLS_PROPERTY_GET,
+					   WLS_ONLINE, 0);
+	if (ret || battmgr->dodge_otg_value) {
+		ret = ret ?: -EBUSY;
+		goto out;
+	}
+	ret = qcom_battmgr_dodge_pd_property(battmgr, BATTMGR_USB_PROPERTY_GET,
+					   USB_ADAP_TYPE, 0);
+	if (ret)
+		goto out;
+	if (battmgr->dodge_otg_value != POWER_SUPPLY_USB_TYPE_PD &&
+	    battmgr->dodge_otg_value != POWER_SUPPLY_USB_TYPE_PD_DRP &&
+	    battmgr->dodge_otg_value != POWER_SUPPLY_USB_TYPE_PD_PPS &&
+	    battmgr->dodge_otg_value != DODGE_USB_TYPE_PD_SDP) {
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+	if (mv == 9000) {
+		ret = qcom_battmgr_dodge_pd_check_battery(battmgr);
+		if (ret)
+			goto out;
+	}
+	/* OEM: lower input current before either voltage transition. */
+	ret = qcom_battmgr_dodge_pd_property(battmgr, BATTMGR_USB_PROPERTY_SET,
+					   USB_INPUT_CURR_LIMIT, 500000);
+	if (ret)
+		goto out;
+	/* Dodge's OEM battery property25 is SET_PDO, in millivolts. */
+	ret = qcom_battmgr_dodge_pd_property(battmgr, BATTMGR_BAT_PROPERTY_SET,
+					   DODGE_BATT_SET_PDO, mv);
+	if (ret)
+		goto fallback;
+	ret = qcom_battmgr_dodge_pd_wait_voltage(battmgr, mv);
+	if (ret)
+		goto fallback;
+	if (mv == 9000) {
+		ret = qcom_battmgr_dodge_pd_property(battmgr, BATTMGR_USB_PROPERTY_SET,
+						   USB_INPUT_CURR_LIMIT, 1500000);
+		if (ret)
+			goto fallback;
+		msleep(3000);
+		ret = qcom_battmgr_dodge_pd_check_battery(battmgr);
+		if (ret)
+			goto fallback;
+	}
+	ret = qcom_battmgr_dodge_pd_property(battmgr, BATTMGR_USB_PROPERTY_SET,
+					   USB_INPUT_CURR_LIMIT, current_ua);
+	if (!ret) {
+		dev_info(battmgr->dev, "PD sink requested %u mV at up to %u mA\n",
+			 mv, current_ua / 1000);
+		goto out;
+	}
+fallback:
+	/* Never replay an ambiguous command or act on a different attachment. */
+	if (qcom_battmgr_dodge_pd_valid(battmgr)) {
+		fallback_ret = qcom_battmgr_dodge_pd_property(battmgr, BATTMGR_USB_PROPERTY_SET,
+							    USB_INPUT_CURR_LIMIT, 500000);
+		if (!fallback_ret)
+			fallback_ret = qcom_battmgr_dodge_pd_property(battmgr,
+						BATTMGR_BAT_PROPERTY_SET, DODGE_BATT_SET_PDO, 5000);
+		if (!fallback_ret)
+			fallback_ret = qcom_battmgr_dodge_pd_wait_voltage(battmgr, 5000);
+		dev_warn(battmgr->dev, "PD sink transition failed (%d), 5 V fallback: %d\n",
+			 ret, fallback_ret);
+	}
+out:
+	mutex_unlock(&battmgr->lock);
+	if (!ret)
+		power_supply_changed(psy);
+	return ret;
+}
+
+/* Caller owns lock. Never claim OFF from an ambiguous same-property reply. */
+static int qcom_battmgr_dodge_power_off(struct qcom_battmgr *battmgr, u32 generation)
+{
+	struct qcom_battmgr_property_request req = {
+		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_BATTMGR),
+		.hdr.type = cpu_to_le32(PMIC_GLINK_REQ_RESP),
+		.hdr.opcode = cpu_to_le32(BATTMGR_USB_PROPERTY_SET),
+		.property = cpu_to_le32(DODGE_USB_OTG_VBUS_ENABLE),
+	};
+	unsigned long flags;
+	bool ambiguous, connected;
+	int ret;
+
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	ambiguous = battmgr->dodge_power_ambiguous;
+	connected = battmgr->service_up &&
+		generation == battmgr->dodge_service_generation;
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+	if (!connected) {
+		battmgr->dodge_power_state = DODGE_POWER_UNKNOWN;
+		return -ENOTCONN;
+	}
+	if (battmgr->dodge_power_generation != generation)
+		battmgr->dodge_power_state = DODGE_POWER_UNKNOWN;
+	if (battmgr->dodge_power_state == DODGE_POWER_OFF && !ambiguous)
+		return 0;
+	if (battmgr->dodge_power_emergency_sent &&
+	    battmgr->dodge_power_emergency_generation == generation)
+		return -EIO;
+	if (!ambiguous) {
+		ret = qcom_battmgr_dodge_otg_request(battmgr,
+			BATTMGR_USB_PROPERTY_SET, DODGE_USB_OTG_VBUS_ENABLE, 0,
+			generation);
+		if (!ret) {
+			battmgr->dodge_power_state = DODGE_POWER_OFF;
+			battmgr->dodge_power_generation = generation;
+			battmgr->dodge_power_current_ma = 0;
+			battmgr->dodge_power_protect_count = 0;
+			return 0;
+		}
+	}
+	battmgr->dodge_power_state = DODGE_POWER_UNKNOWN;
+	/* A timed-out ON ack could match OFF: send once, without trusting an ack. */
+	if (battmgr->dodge_power_emergency_sent &&
+	    battmgr->dodge_power_emergency_generation == generation)
+		return -EIO;
+	battmgr->dodge_power_emergency_sent = true;
+	battmgr->dodge_power_emergency_generation = generation;
+	ret = pmic_glink_send(battmgr->client, &req, sizeof(req));
+	dev_warn_ratelimited(battmgr->dev,
+		"OTG state unknown; best-effort disable sent (%d), awaiting service restart\n", ret);
+	return ret ? ret : -EIO;
+}
+
+static int qcom_battmgr_dodge_otg_init(struct qcom_battmgr *battmgr, u32 generation)
+{
+	int ret;
+
+	/* The stock board selects PMIC boost, not its unused external GPIO path. */
+	ret = qcom_battmgr_dodge_power_off(battmgr, generation);
+	if (ret)
+		return ret;
+	ret = qcom_battmgr_dodge_otg_request(battmgr, BATTMGR_USB_PROPERTY_SET,
+				DODGE_USB_OTG_AP_ENABLE, 1, generation);
+	if (ret)
+		return ret;
+	ret = qcom_battmgr_dodge_otg_request(battmgr, BATTMGR_USB_PROPERTY_GET,
+				DODGE_USB_CID_STATUS, 0, generation);
+	if (ret || !battmgr->dodge_otg_value)
+		return ret;
+	/* Match OEM CID initialization: restore DRP for an attached cable. */
+	ret = qcom_battmgr_dodge_otg_request(battmgr, BATTMGR_USB_PROPERTY_GET,
+				DODGE_USB_TYPEC_MODE, 0, generation);
+	if (ret)
+		return ret;
+	ret = qcom_battmgr_dodge_otg_request(battmgr, BATTMGR_USB_PROPERTY_SET,
+				DODGE_USB_TYPEC_MODE, DODGE_TYPEC_MODE_DRP, generation);
+	if (ret)
+		return ret;
+	ret = qcom_battmgr_dodge_otg_request(battmgr, BATTMGR_USB_PROPERTY_GET,
+				DODGE_USB_TYPEC_MODE, 0, generation);
+	if (!ret && (battmgr->dodge_otg_value & 7) != DODGE_TYPEC_MODE_DRP)
+		ret = -EPROTO;
+	return ret;
+}
+
+static bool qcom_battmgr_dodge_cid_current(struct qcom_battmgr *battmgr,
+					 u32 generation, u32 epoch, u32 sequence)
+{
+	unsigned long flags;
+	bool valid;
+
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	valid = battmgr->service_up && battmgr->dodge_otg_ready &&
+		!battmgr->dodge_otg_stopping && !battmgr->dodge_otg_broken &&
+		generation == battmgr->dodge_service_generation &&
+		epoch == battmgr->dodge_otg_epoch &&
+		sequence == battmgr->dodge_cid_sequence;
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+	return valid;
+}
+
+static void qcom_battmgr_dodge_cid_worker(struct work_struct *work)
+{
+	struct qcom_battmgr *battmgr = container_of(work, struct qcom_battmgr,
+						 dodge_cid_work);
+	unsigned long flags;
+	u32 generation, epoch, sequence, cid, mode;
+	int ret = 0, ack_ret;
+
+	mutex_lock(&battmgr->lock);
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	generation = battmgr->dodge_service_generation;
+	epoch = battmgr->dodge_otg_epoch;
+	sequence = battmgr->dodge_cid_sequence;
+	if (!battmgr->dodge_cid_pending || !battmgr->dodge_otg_ready ||
+	    !battmgr->service_up || battmgr->dodge_otg_stopping ||
+	    battmgr->dodge_otg_broken) {
+		spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+		goto out;
+	}
+	battmgr->dodge_cid_pending = false;
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+
+	ret = qcom_battmgr_dodge_otg_request(battmgr, BATTMGR_USB_PROPERTY_GET,
+				DODGE_USB_CID_STATUS, 0, generation);
+	if (ret)
+		goto out;
+	cid = battmgr->dodge_otg_value;
+	dev_info_ratelimited(battmgr->dev, "CID detect state %u\n", cid);
+	/* The OEM runtime cable-detect path restores DRP only for CID == 1. */
+	if (cid > 1 || !qcom_battmgr_dodge_cid_current(battmgr,
+						generation, epoch, sequence))
+		goto out;
+	if (!cid)
+		goto acknowledge;
+	ret = qcom_battmgr_dodge_otg_request(battmgr, BATTMGR_USB_PROPERTY_GET,
+				DODGE_USB_TYPEC_MODE, 0, generation);
+	if (ret)
+		goto acknowledge;
+	mode = battmgr->dodge_otg_value;
+	/* A fresh attach needs the command even when the reported mode is DRP. */
+	if (!qcom_battmgr_dodge_cid_current(battmgr, generation, epoch, sequence))
+		goto out;
+	ret = qcom_battmgr_dodge_otg_request(battmgr, BATTMGR_USB_PROPERTY_SET,
+				DODGE_USB_TYPEC_MODE, DODGE_TYPEC_MODE_DRP, generation);
+	if (ret || !qcom_battmgr_dodge_cid_current(battmgr,
+						generation, epoch, sequence))
+		goto acknowledge;
+	ret = qcom_battmgr_dodge_otg_request(battmgr, BATTMGR_USB_PROPERTY_GET,
+				DODGE_USB_TYPEC_MODE, 0, generation);
+	if (!ret && (battmgr->dodge_otg_value & 7) != DODGE_TYPEC_MODE_DRP)
+		ret = -EPROTO;
+	if (!ret && qcom_battmgr_dodge_cid_current(battmgr,
+						generation, epoch, sequence))
+		dev_info_ratelimited(battmgr->dev,
+				     "restored Type-C DRP after CID attach (from mode %#x)\n", mode);
+acknowledge:
+	/* The OEM completes either CID state even if the mode command failed. */
+	if (qcom_battmgr_dodge_cid_current(battmgr, generation, epoch, sequence)) {
+		ack_ret = qcom_battmgr_dodge_otg_request(battmgr, BATTMGR_USB_PROPERTY_SET,
+					DODGE_USB_CCDETECT_HAPPENED, 1, generation);
+		if (!ret)
+			ret = ack_ret;
+	}
+out:
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	/* An unrelated power event may race detection. Re-read CID once. */
+	if (!ret && generation == battmgr->dodge_service_generation &&
+	    sequence == battmgr->dodge_cid_sequence &&
+	    epoch != battmgr->dodge_otg_epoch && battmgr->service_up &&
+	    battmgr->dodge_otg_ready && !battmgr->dodge_otg_stopping &&
+	    !battmgr->dodge_otg_broken && !battmgr->dodge_cid_retried) {
+		battmgr->dodge_cid_pending = true;
+		battmgr->dodge_cid_retried = true;
+		schedule_work(&battmgr->dodge_cid_work);
+	}
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+	mutex_unlock(&battmgr->lock);
+	if (ret)
+		dev_warn_ratelimited(battmgr->dev, "CID attach handling failed: %d\n", ret);
+}
+
+static bool qcom_battmgr_dodge_otg_allowed(struct qcom_battmgr *battmgr,
+					 u32 generation, u32 epoch)
+{
+	unsigned long flags;
+	bool allowed;
+
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	allowed = battmgr->service_up && battmgr->dodge_otg_ready &&
+		battmgr->dodge_otg_requested && !battmgr->dodge_otg_stopping &&
+		!battmgr->dodge_otg_broken && !battmgr->dodge_otg_prohibited &&
+		generation == battmgr->dodge_service_generation &&
+		epoch == battmgr->dodge_otg_epoch;
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+	return allowed;
+}
+
+/* Standard POWER_SUPPLY CURRENT_NOW is negative during discharge. */
+static bool qcom_battmgr_dodge_power_protect(struct qcom_battmgr *battmgr,
+					   int soc, int current_ua)
+{
+	s64 discharge_ua = max_t(s64, -(s64)current_ua, 0);
+	unsigned long flags;
+	bool excessive;
+
+	if (time_before(jiffies, battmgr->dodge_power_checked + HZ))
+		return false;
+	battmgr->dodge_power_checked = jiffies;
+	excessive = discharge_ua > 3000000 || (soc < 10 && discharge_ua > 1700000);
+	if (excessive)
+		battmgr->dodge_power_protect_count++;
+	else
+		battmgr->dodge_power_protect_count = 0;
+	if (battmgr->dodge_power_protect_count < 2)
+		return false;
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	battmgr->dodge_otg_prohibited = true;
+	battmgr->dodge_otg_epoch++;
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+	dev_warn_ratelimited(battmgr->dev, "OTG disabled by current/SOC protection\n");
+	return true;
+}
+
+static void qcom_battmgr_dodge_otg_worker(struct work_struct *work)
+{
+	struct qcom_battmgr *battmgr = container_of(to_delayed_work(work),
+					struct qcom_battmgr, dodge_otg_work);
+	union power_supply_propval soc, current_sample;
+	unsigned long flags;
+	u32 generation, epoch, limit;
+	int ret = 0;
+
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	generation = battmgr->dodge_service_generation;
+	epoch = battmgr->dodge_otg_epoch;
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+	mutex_lock(&battmgr->lock);
+	if (!qcom_battmgr_dodge_otg_allowed(battmgr, generation, epoch))
+		goto off;
+	/* Drain a raced OFF before honoring a later ON or wireless recheck. */
+	if (battmgr->dodge_power_generation != generation ||
+	    (battmgr->dodge_power_state == DODGE_POWER_ON &&
+	     battmgr->dodge_power_epoch != epoch)) {
+		ret = qcom_battmgr_dodge_power_off(battmgr, generation);
+		if (ret)
+			goto out;
+	}
+	mutex_unlock(&battmgr->lock);
+
+	ret = qcom_battmgr_dodge_get_property(battmgr->bat_psy,
+					    POWER_SUPPLY_PROP_CAPACITY, &soc);
+	if (!ret)
+		ret = qcom_battmgr_dodge_get_property(battmgr->bat_psy,
+					POWER_SUPPLY_PROP_CURRENT_NOW, &current_sample);
+	mutex_lock(&battmgr->lock);
+	if (ret)
+		goto off;
+	if (soc.intval < 0 || soc.intval > 100 || current_sample.intval == S32_MIN) {
+		ret = -ERANGE;
+		goto off;
+	}
+	if (!qcom_battmgr_dodge_otg_allowed(battmgr, generation, epoch))
+		goto off;
+	if (battmgr->dodge_power_state == DODGE_POWER_ON &&
+	    qcom_battmgr_dodge_power_protect(battmgr, soc.intval, current_sample.intval))
+		goto off;
+	ret = qcom_battmgr_dodge_otg_request(battmgr, BATTMGR_WLS_PROPERTY_GET,
+					   WLS_ONLINE, 0, generation);
+	if (ret || battmgr->dodge_otg_value)
+		goto off;
+	limit = soc.intval <= 1 ? 500 : 1250;
+	if (battmgr->dodge_power_current_ma != limit) {
+		ret = qcom_battmgr_dodge_otg_request(battmgr, BATTMGR_USB_PROPERTY_SET,
+				DODGE_USB_OTG_BOOST_CURRENT, limit, generation);
+		if (ret)
+			goto off;
+		battmgr->dodge_power_current_ma = limit;
+	}
+	if (!qcom_battmgr_dodge_otg_allowed(battmgr, generation, epoch))
+		goto off;
+	if (battmgr->dodge_power_state != DODGE_POWER_ON) {
+		battmgr->dodge_power_state = DODGE_POWER_UNKNOWN;
+		ret = qcom_battmgr_dodge_otg_request(battmgr,
+			BATTMGR_USB_PROPERTY_SET, DODGE_USB_OTG_VBUS_ENABLE, 1,
+			generation);
+		if (ret)
+			goto off;
+		battmgr->dodge_power_state = DODGE_POWER_ON;
+		battmgr->dodge_power_generation = generation;
+		battmgr->dodge_power_epoch = epoch;
+		battmgr->dodge_power_checked = jiffies;
+		if (!qcom_battmgr_dodge_otg_allowed(battmgr, generation, epoch))
