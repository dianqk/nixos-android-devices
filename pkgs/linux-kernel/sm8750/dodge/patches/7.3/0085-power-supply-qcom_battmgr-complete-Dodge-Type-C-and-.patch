+/* Return true for all dedicated replies, including stale/unexpected ones. */
+static bool qcom_battmgr_dodge_otg_reply(struct qcom_battmgr *battmgr,
+				       const struct qcom_battmgr_message *msg,
+				       size_t len)
+{
+	u32 opcode = le32_to_cpu(msg->hdr.opcode);
+	unsigned long flags;
+	bool handled;
+
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	handled = battmgr->dodge_otg_pending || opcode == BATTMGR_USB_PROPERTY_SET;
+	if (!battmgr->dodge_otg_pending ||
+	    opcode != battmgr->dodge_otg_opcode ||
+	    len != sizeof(msg->hdr) + sizeof(msg->intval) ||
+	    le32_to_cpu(msg->hdr.type) != PMIC_GLINK_REQ_RESP ||
+	    le32_to_cpu(msg->intval.property) != battmgr->dodge_otg_property)
+		goto out;
+	battmgr->dodge_otg_pending = false;
+	battmgr->dodge_otg_value = le32_to_cpu(msg->intval.value);
+	battmgr->dodge_otg_error = le32_to_cpu(msg->intval.result) ? -EREMOTEIO : 0;
+	complete(&battmgr->dodge_otg_ack);
+out:
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+	return handled;
+}
+
+static bool qcom_battmgr_dodge_otg_notification(struct qcom_battmgr *battmgr,
+					      const struct qcom_battmgr_message *msg,
+					      size_t len)
+{
+	unsigned long flags;
+	u32 notification;
+	bool handled = false;
+
+	if (len != sizeof(msg->hdr) + sizeof(msg->notification) ||
+	    le32_to_cpu(msg->hdr.type) != PMIC_GLINK_NOTIFY)
+		return true;
+	notification = le32_to_cpu(msg->notification);
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	if (battmgr->dodge_otg_stopping || !battmgr->service_up)
+		goto out;
+	switch (notification) {
+	case DODGE_NOTIF_PD_SOURCECAP_DONE:
+	case DODGE_NOTIF_PD_SOFT_RESET:
+		battmgr->dodge_pd_revision++;
+		break;
+	case DODGE_NOTIF_CID_DETECT:
+		battmgr->dodge_cid_sequence++;
+		battmgr->dodge_cid_pending = true;
+		battmgr->dodge_cid_retried = false;
+		schedule_work(&battmgr->dodge_cid_work);
+		handled = true;
+		break;
+	case DODGE_NOTIF_OTG_ENABLE:
+	case DODGE_NOTIF_OTG_DISABLE:
+		battmgr->dodge_otg_requested = notification == DODGE_NOTIF_OTG_ENABLE;
+		if (!battmgr->dodge_otg_requested) {
+			battmgr->dodge_otg_prohibited = false;
+			battmgr->dodge_otg_epoch++;
+		}
+		handled = true;
+		mod_delayed_work(system_percpu_wq, &battmgr->dodge_otg_work, 0);
+		break;
+	case NOTIF_WLS_PROPERTY:
+		battmgr->dodge_otg_epoch++;
+		fallthrough;
+	case NOTIF_BAT_PROPERTY:
+	case NOTIF_BAT_STATUS:
+	case NOTIF_BAT_CHARGING_STATE:
+		mod_delayed_work(system_percpu_wq, &battmgr->dodge_otg_work, 0);
+		break;
+	}
+out:
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+	return handled;
+}
