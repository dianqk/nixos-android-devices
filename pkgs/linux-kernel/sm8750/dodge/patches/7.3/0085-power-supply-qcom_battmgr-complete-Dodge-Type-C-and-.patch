+static int qcom_battmgr_dodge_pd_decode(const void *data, size_t len,
+				      struct qcom_battmgr_dodge_pd_caps *caps)
+{
+	const struct qcom_battmgr_dodge_pd_response *resp = data;
+	unsigned int bytes, words, i;
+
+	if (len != sizeof(*resp))
+		return -EMSGSIZE;
+	if (le32_to_cpu(resp->hdr.owner) != PMIC_GLINK_OWNER_BATTMGR ||
+	    le32_to_cpu(resp->hdr.type) != PMIC_GLINK_REQ_RESP ||
+	    le32_to_cpu(resp->hdr.opcode) != DODGE_PD_READ_BUFFER)
+		return -EPROTO;
+	bytes = le32_to_cpu(resp->data_size);
+	if (bytes < 2 * sizeof(__le32) || bytes > sizeof(resp->data) ||
+	    bytes % sizeof(__le32))
+		return -EPROTO;
+
+	memset(caps, 0, sizeof(*caps));
+	/* OEM metadata precedes the source PDOs; it is not a pair of PDOs. */
+	caps->max_ma = le32_to_cpu(resp->data[0]);
+	caps->max_mv = le32_to_cpu(resp->data[1]);
+	words = min_t(unsigned int, bytes / sizeof(__le32) - 2, DODGE_PD_MAX_PDOS);
+	for (i = 0; i < words; i++) {
+		u32 pdo = le32_to_cpu(resp->data[i + 2]);
+
+		if (!pdo)
+			break;
+		/* Preserve the wire type, including APDOs; do not assume fixed PDOs. */
+		caps->pdo[caps->count++] = pdo;
+	}
+	return 0;
+}
 
