+static void qcom_battmgr_dodge_pd_reply(struct qcom_battmgr *battmgr,
+				      const void *data, size_t len)
+{
+	const struct pmic_glink_hdr *hdr = data;
+	unsigned long flags;
+
+	if (len < sizeof(*hdr) ||
+	    le32_to_cpu(hdr->owner) != PMIC_GLINK_OWNER_BATTMGR ||
+	    le32_to_cpu(hdr->type) != PMIC_GLINK_REQ_RESP ||
+	    le32_to_cpu(hdr->opcode) != DODGE_PD_READ_BUFFER)
+		return;
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	if (battmgr->dodge_request_pending &&
+	    battmgr->dodge_request_opcode == DODGE_PD_READ_BUFFER) {
+		battmgr->dodge_request_pending = false;
+		battmgr->error = qcom_battmgr_dodge_pd_current(battmgr) ?
+			qcom_battmgr_dodge_pd_decode(data, len, &battmgr->dodge_pd_caps) :
+			-EAGAIN;
+		complete(&battmgr->ack);
+	}
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+}
+
+/* Caller holds lock, shared with gauge, ordinary properties and OTG requests. */
+static int qcom_battmgr_dodge_pd_read_caps(struct qcom_battmgr *battmgr)
+{
+	struct qcom_battmgr_dodge_pd_request req = {
+		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_BATTMGR),
+		.hdr.type = cpu_to_le32(PMIC_GLINK_REQ_RESP),
+		.hdr.opcode = cpu_to_le32(DODGE_PD_READ_BUFFER),
+		.data_size = cpu_to_le32(DODGE_PD_BUFFER_WORDS * sizeof(__le32)),
+	};
+	unsigned long flags;
+	unsigned int i;
+	int ret;
+
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	if (!battmgr->service_up || battmgr->dodge_otg_stopping ||
+	    battmgr->dodge_otg_requested || battmgr->dodge_pd_broken) {
+		spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+		return -ENOTCONN;
+	}
+	if (battmgr->dodge_pd_attempted && qcom_battmgr_dodge_pd_current(battmgr)) {
+		ret = battmgr->dodge_pd_error;
+		spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+		return ret;
+	}
+	battmgr->dodge_pd_caps_revision = battmgr->dodge_pd_revision;
+	battmgr->dodge_pd_generation = battmgr->dodge_service_generation;
+	battmgr->dodge_pd_epoch = battmgr->dodge_otg_epoch;
+	battmgr->dodge_pd_sequence = battmgr->dodge_cid_sequence;
+	battmgr->dodge_pd_attempted = true;
+	battmgr->dodge_pd_error = -EINPROGRESS;
+	memset(&battmgr->dodge_pd_caps, 0, sizeof(battmgr->dodge_pd_caps));
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+
+	ret = qcom_battmgr_request(battmgr, &req, sizeof(req));
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	/* There is no wire transaction ID: do not retry an ambiguous read. */
+	if (ret == -ETIMEDOUT &&
+	    battmgr->dodge_pd_generation == battmgr->dodge_service_generation)
+		battmgr->dodge_pd_broken = true;
+	if (!ret && !qcom_battmgr_dodge_pd_current(battmgr))
+		ret = -EAGAIN;
+	battmgr->dodge_pd_error = ret;
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+	if (ret)
+		return ret;
+
+	dev_info(battmgr->dev, "PD source limits: %u mA, %u mV; %u PDOs\n",
+		 battmgr->dodge_pd_caps.max_ma, battmgr->dodge_pd_caps.max_mv,
+		 battmgr->dodge_pd_caps.count);
+	for (i = 0; i < battmgr->dodge_pd_caps.count; i++)
+		dev_info(battmgr->dev, "PD source PDO[%u] = %#010x\n",
+			 i, battmgr->dodge_pd_caps.pdo[i]);
+	return 0;
 }
 
