From b9fb06945295654929b5a0c3ff73e2e328092324 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Mon, 9 Nov 2026 23:21:35 +0800
Subject: [PATCH 085/144] clk: qcom: dispcc-sm8750: enable DSI branch parents

The DSI pixel and byte branches need running parents while their halt
status is checked. Normal display enable/disable has parent references,
but unused-clock cleanup can gate the bootloader-enabled branches without
preparing their parents, leaving the halt checks stuck at on.

Request parent enablement for the DSI0 pixel, byte and byte-interface
branches. The clock framework balances these temporary references after
the operation, allowing normal unused-clock cleanup without retaining the
clocks permanently.

The SM6350 byte branch uses the same parent-enable requirement.

Link: https://git.kernel.org/linus/92039e8c080c63748f8e133e7cfad33a75daefb6
Signed-off-by: dianqk <dianqk@dianqk.net>

Import-Patch: pkgs/linux-kernel/sm8750/dodge/patches/7.3/0108-clk-qcom-dispcc-sm8750-enable-DSI-branch-parents.patch
Import-SHA256: d8944804efdcaf308bc315c2e36d68b35de718da8eeb0a423c0566bf5ebede2d
Import-Provenance: mail headers
(cherry picked from commit 59c893c00335a1b9c43746e60aa4274cd292653f)
---
 drivers/clk/qcom/dispcc-sm8750.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/clk/qcom/dispcc-sm8750.c b/drivers/clk/qcom/dispcc-sm8750.c
index 18e86b80e5..058231cabe 100644
--- a/drivers/clk/qcom/dispcc-sm8750.c
+++ b/drivers/clk/qcom/dispcc-sm8750.c
@@ -1006,7 +1006,7 @@ static struct clk_branch disp_cc_mdss_byte0_clk = {
 				&disp_cc_mdss_byte0_clk_src.clkr.hw,
 			},
 			.num_parents = 1,
-			.flags = CLK_SET_RATE_PARENT,
+			.flags = CLK_SET_RATE_PARENT | CLK_OPS_PARENT_ENABLE,
 			.ops = &clk_branch2_ops,
 		},
 	},
@@ -1024,7 +1024,7 @@ static struct clk_branch disp_cc_mdss_byte0_intf_clk = {
 				&disp_cc_mdss_byte0_div_clk_src.clkr.hw,
 			},
 			.num_parents = 1,
-			.flags = CLK_SET_RATE_PARENT,
+			.flags = CLK_SET_RATE_PARENT | CLK_OPS_PARENT_ENABLE,
 			.ops = &clk_branch2_ops,
 		},
 	},
@@ -1654,7 +1654,7 @@ static struct clk_branch disp_cc_mdss_pclk0_clk = {
 				&disp_cc_mdss_pclk0_clk_src.clkr.hw,
 			},
 			.num_parents = 1,
-			.flags = CLK_SET_RATE_PARENT,
+			.flags = CLK_SET_RATE_PARENT | CLK_OPS_PARENT_ENABLE,
 			.ops = &clk_branch2_ops,
 		},
 	},
