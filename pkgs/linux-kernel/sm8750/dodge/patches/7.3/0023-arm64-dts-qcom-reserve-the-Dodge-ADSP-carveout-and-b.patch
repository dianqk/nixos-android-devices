From 478b126c6848de47839ee7593adb05bd7c1ae441 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Sun, 8 Nov 2026 02:50:20 +0800
Subject: [PATCH 023/144] arm64: dts: qcom: reserve the Dodge ADSP carveout and
 battery interface

Keep the ADSP carveout and battery telemetry board description together.

Consolidated from local follow-ups:
  406f07fb15d00fa9b0f1a8c4a1c7ff0e2a1b8b82 arm64: dts: qcom: enable Dodge ADSP battery telemetry
  d0e945463ee1c7e3510dd171a3c366e41bc9e503 arm64: dts: qcom: reserve the full Dodge ADSP carveout
---
 .../bindings/soc/qcom/qcom,pmic-glink.yaml       |  4 ++++
 .../arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts | 16 ++++++++++++++++
 drivers/soc/qcom/pmic_glink.c                    |  8 ++++++++
 3 files changed, 28 insertions(+)

diff --git a/Documentation/devicetree/bindings/soc/qcom/qcom,pmic-glink.yaml b/Documentation/devicetree/bindings/soc/qcom/qcom,pmic-glink.yaml
index 16ad4f5698..f0cd40af13 100644
--- a/Documentation/devicetree/bindings/soc/qcom/qcom,pmic-glink.yaml
+++ b/Documentation/devicetree/bindings/soc/qcom/qcom,pmic-glink.yaml
@@ -21,6 +21,10 @@ description:
 properties:
   compatible:
     oneOf:
+      - items:
+          - const: oneplus,dodge-pmic-glink
+          - const: qcom,sm8350-pmic-glink
+          - const: qcom,pmic-glink
       - items:
           - enum:
               - qcom,glymur-pmic-glink
diff --git a/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts b/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
index 7f13c79e58..210ce6f97e 100644
--- a/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
+++ b/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
@@ -19,6 +19,11 @@ / {
 	compatible = "oneplus,dodge", "qcom,sm8750";
 	chassis-type = "handset";
 
+	pmic-glink {
+		compatible = "oneplus,dodge-pmic-glink", "qcom,sm8350-pmic-glink",
+			     "qcom,pmic-glink";
+	};
+
 	aliases {
 		serial0 = &uart14;
 	};
@@ -750,3 +755,14 @@ touch_spi_mosi: touch-spi-mosi-state {
 		bias-disable;
 	};
 };
+
+&remoteproc_adsp {
+	firmware-name = "qcom/sm8750/oneplus/dodge/adsp.mdt",
+			"qcom/sm8750/oneplus/dodge/adsp_dtb.mdt";
+	status = "okay";
+};
+
+/* The shipping ADSP image occupies the complete Android carveout. */
+&adspslpi_mem {
+	reg = <0x0 0x9ee00000 0x0 0x5080000>;
+};
diff --git a/drivers/soc/qcom/pmic_glink.c b/drivers/soc/qcom/pmic_glink.c
index 3042261578..d49a9da326 100644
--- a/drivers/soc/qcom/pmic_glink.c
+++ b/drivers/soc/qcom/pmic_glink.c
@@ -397,6 +397,13 @@ static const struct pmic_glink_data pmic_glink_adsp_data = {
 	.charger_pdr_service_path = "msm/adsp/charger_pd",
 };
 
+/* Dodge uses the OEM property protocol, without the SM8550 charge controls. */
+static const struct pmic_glink_data pmic_glink_dodge_data = {
+	.client_mask = BIT(PMIC_GLINK_CLIENT_BATT),
+	.charger_pdr_service_name = "tms/servreg",
+	.charger_pdr_service_path = "msm/adsp/charger_pd",
+};
+
 static const struct pmic_glink_data pmic_glink_soccp_data = {
 	.client_mask = BIT(PMIC_GLINK_CLIENT_BATT) |
 		       BIT(PMIC_GLINK_CLIENT_ALTMODE) |
@@ -404,6 +411,7 @@ static const struct pmic_glink_data pmic_glink_soccp_data = {
 };
 
 static const struct of_device_id pmic_glink_of_match[] = {
+	{ .compatible = "oneplus,dodge-pmic-glink", .data = &pmic_glink_dodge_data },
 	{ .compatible = "qcom,glymur-pmic-glink", .data = &pmic_glink_soccp_data },
 	{ .compatible = "qcom,kaanapali-pmic-glink", .data = &pmic_glink_soccp_data },
 	{ .compatible = "qcom,pmic-glink", .data = &pmic_glink_adsp_data },
