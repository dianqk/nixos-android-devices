+/* Caller holds dodge_otg_lock; never wait for firmware in a notification. */
+static void qcom_battmgr_charge_event(struct qcom_battmgr *battmgr)
+{
+	battmgr->charge_epoch++;
+	if (battmgr->service_up && !battmgr->charge_closing && !battmgr->charge_suspending)
+		mod_delayed_work(system_percpu_wq, &battmgr->charge_work, 0);
+}
+
 /* No firmware transaction or battmgr mutex in the provider notifier. */
 static int qcom_battmgr_wireless_present(struct qcom_battmgr *battmgr, bool event)
 {
@@ -561,6 +585,7 @@ static int qcom_battmgr_wireless_present(struct qcom_battmgr *battmgr, bool even
 	battmgr->wireless_known = known;
 	battmgr->wireless_present = present;
 	if ((changed || event) && battmgr->variant == QCOM_BATTMGR_DODGE) {
+		qcom_battmgr_charge_event(battmgr);
 		/* Even coalesced attach/detach must revoke an in-flight authorization. */
 		battmgr->dodge_otg_epoch++;
 		battmgr->dodge_power_off_pending = true;
@@ -992,6 +1017,8 @@ static int qcom_battmgr_bat_get_property(struct power_supply *psy,
 	return 0;
 }
 
+#define DODGE_WLS_INPUT_CURR_LIMIT	8
+
 #define DODGE_GAUGE_OPCODE	0x10000
 #define DODGE_GAUGE_WORDS	128
 
@@ -1033,6 +1060,21 @@ static int qcom_battmgr_dodge_decode(const void *data, size_t len, u32 gauge[9])
 	return 0;
 }
 
+static int qcom_battmgr_charge_get_behaviour(struct qcom_battmgr *battmgr,
+					   union power_supply_propval *val)
+{
+	int ret = 0;
+
+	mutex_lock(&battmgr->lock);
+	if (battmgr->charge_owned && (battmgr->charge_pending || battmgr->charge_frozen))
+		ret = -EIO;
+	else
+		val->intval = battmgr->charge_owned ? POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE :
+			POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO;
+	mutex_unlock(&battmgr->lock);
+	return ret;
+}
+
 static int qcom_battmgr_dodge_get_property(struct power_supply *psy,
 					 enum power_supply_property psp,
 					 union power_supply_propval *val)
@@ -1047,6 +1089,9 @@ static int qcom_battmgr_dodge_get_property(struct power_supply *psy,
 	u32 generation;
 	int ret = 0;
 
+	if (psp == POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR)
+		return qcom_battmgr_charge_get_behaviour(battmgr, val);
+
 	switch (psp) {
 	case POWER_SUPPLY_PROP_STATUS:
 	case POWER_SUPPLY_PROP_HEALTH:
@@ -1342,7 +1387,14 @@ static const struct power_supply_desc sm8350_bat_psy_desc = {
 	.get_property = qcom_battmgr_bat_get_property,
 };
 
+static int qcom_battmgr_charge_set_property(struct power_supply *psy,
+					  enum power_supply_property prop,
+					  const union power_supply_propval *val);
+static int qcom_battmgr_charge_is_writeable(struct power_supply *psy,
+					  enum power_supply_property prop);
