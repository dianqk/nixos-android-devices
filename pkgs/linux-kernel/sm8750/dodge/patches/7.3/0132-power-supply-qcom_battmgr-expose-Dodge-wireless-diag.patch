 				   struct device_attribute *attr, char *buf)
@@ -144,7 +196,7 @@ static ssize_t firmware_state_show(struct device *dev,
 		return ret < 0 ? ret : -ENODATA;
 
 	mutex_lock(&rx->lock);
-	if (!rx->valid)
+	if (!rx->valid || rx->sample_generation != atomic_read(&rx->generation))
 		ret = -ENODATA;
 	else
 		ret = sysfs_emit(buf,
@@ -169,7 +221,9 @@ static const struct attribute_group nu1669_group = {
 
 static bool nu1669_online(struct nu1669 *rx)
 {
-	return rx->present > 0 && rx->valid && get_unaligned_le16(rx->info + 0x34);
+	return rx->present > 0 && rx->valid &&
+		rx->sample_generation == atomic_read(&rx->generation) &&
+		get_unaligned_le16(rx->info + 0x34);
 }
 
 static void nu1669_poll(struct work_struct *work)
@@ -181,7 +235,7 @@ static void nu1669_poll(struct work_struct *work)
 	int present, ret;
 
 	mutex_lock(&rx->lock);
-	generation = rx->generation;
+	generation = atomic_read(&rx->generation);
 	if (rx->suspended || rx->stopped) {
 		mutex_unlock(&rx->lock);
 		return;
@@ -198,13 +252,14 @@ static void nu1669_poll(struct work_struct *work)
 	}
 
 	mutex_lock(&rx->lock);
-	if (rx->suspended || rx->stopped || generation != rx->generation) {
+	if (rx->suspended || rx->stopped || generation != atomic_read(&rx->generation)) {
 		mutex_unlock(&rx->lock);
 		return;
 	}
 	online = nu1669_online(rx);
 	changed = rx->present != present || rx->valid != valid;
 	rx->present = present;
+	rx->sample_generation = generation;
 	rx->valid = valid;
 	if (valid)
 		memcpy(rx->info, info, sizeof(info));
@@ -218,12 +273,20 @@ static void nu1669_poll(struct work_struct *work)
 	mutex_unlock(&rx->lock);
 }
 
+static irqreturn_t nu1669_connected_irq_primary(int irq, void *data)
+{
+	struct nu1669 *rx = data;
+
+	/* Keep this atomic invalidation in hard IRQ context, including forced threading. */
+	atomic_inc(&rx->generation);
+	return IRQ_WAKE_THREAD;
+}
+
 static irqreturn_t nu1669_connected_irq(int irq, void *data)
 {
 	struct nu1669 *rx = data;
 
 	mutex_lock(&rx->lock);
-	rx->generation++;
 	rx->valid = false;
 	memset(rx->info, 0, sizeof(rx->info));
 	if (!rx->suspended && !rx->stopped) {
@@ -245,6 +308,7 @@ static void nu1669_stop(void *data)
 		return;
 	}
 	rx->stopped = true;
+	atomic_inc(&rx->generation);
 	rx->valid = false;
 	memset(rx->info, 0, sizeof(rx->info));
 	mutex_unlock(&rx->lock);
@@ -293,8 +357,9 @@ static int nu1669_probe(struct i2c_client *client)
 	rx->irq = gpiod_to_irq(rx->connected);
 	if (rx->irq < 0)
 		return dev_err_probe(dev, rx->irq, "connection IRQ\n");
-	ret = devm_request_threaded_irq(dev, rx->irq, NULL, nu1669_connected_irq,
-			IRQF_ONESHOT | IRQF_TRIGGER_RISING | IRQF_TRIGGER_FALLING,
+	ret = devm_request_threaded_irq(dev, rx->irq, nu1669_connected_irq_primary,
+			nu1669_connected_irq,
+			IRQF_NO_THREAD | IRQF_TRIGGER_RISING | IRQF_TRIGGER_FALLING,
 			dev_name(dev), rx);
 	if (ret)
 		return dev_err_probe(dev, ret, "connection IRQ\n");
@@ -314,7 +379,7 @@ static int nu1669_suspend(struct device *dev)
 
 	mutex_lock(&rx->lock);
 	rx->suspended = true;
-	rx->generation++;
+	atomic_inc(&rx->generation);
 	rx->valid = false;
 	memset(rx->info, 0, sizeof(rx->info));
 	mutex_unlock(&rx->lock);
