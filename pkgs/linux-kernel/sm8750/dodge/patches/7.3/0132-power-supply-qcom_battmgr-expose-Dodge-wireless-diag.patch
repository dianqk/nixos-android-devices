 static const enum power_supply_property dodge_bat_props[] = {
+	POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR,
 	POWER_SUPPLY_PROP_STATUS,
 	POWER_SUPPLY_PROP_HEALTH,
 	POWER_SUPPLY_PROP_PRESENT,
@@ -1360,6 +1412,10 @@ static const struct power_supply_desc dodge_bat_psy_desc = {
 	.properties = dodge_bat_props,
 	.num_properties = ARRAY_SIZE(dodge_bat_props),
 	.get_property = qcom_battmgr_dodge_get_property,
+	.set_property = qcom_battmgr_charge_set_property,
+	.property_is_writeable = qcom_battmgr_charge_is_writeable,
+	.charge_behaviours = BIT(POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO) |
+		BIT(POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE),
 };
 
 static const enum power_supply_property sm8550_bat_props[] = {
@@ -2175,6 +2231,523 @@ static int qcom_battmgr_dodge_otg_request(struct qcom_battmgr *battmgr,
 	return ret;
 }
 
+/* Charge state below is protected by lock; event/closing state by dodge_otg_lock. */
+static bool qcom_battmgr_charge_transport_current(struct qcom_battmgr *battmgr, u32 generation)
+{
+	unsigned long flags;
+	bool valid;
+
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	valid = battmgr->service_up && !battmgr->dodge_otg_stopping &&
+		!battmgr->dodge_otg_broken && generation == battmgr->dodge_service_generation;
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+	return valid;
+}
+
+static int qcom_battmgr_charge_request(struct qcom_battmgr *battmgr,
+				     u32 opcode, u32 property, u32 value, u32 generation)
+{
+	int ret;
+
+	if (battmgr->charge_frozen)
+		return -EIO;
+	ret = qcom_battmgr_dodge_otg_request(battmgr, opcode, property, value, generation);
+	if (!ret && !qcom_battmgr_charge_transport_current(battmgr, generation))
+		ret = -ENOTCONN;
+	if (battmgr->charge_owned &&
+	    (ret == -ETIMEDOUT || !qcom_battmgr_charge_transport_current(battmgr, generation) ||
+	     (opcode == BATTMGR_BAT_PROPERTY_SET && ret)))
+		battmgr->charge_frozen = true;
+	return ret;
+}
+
+static int qcom_battmgr_charge_raw_get(struct qcom_battmgr *battmgr, u32 generation, u32 *value)
+{
+	int ret;
+
+	ret = qcom_battmgr_charge_request(battmgr, BATTMGR_BAT_PROPERTY_GET,
+					BATT_CHG_CTRL_EN, 0, generation);
+	if (ret)
+		return ret;
+	if (battmgr->dodge_otg_value > 1) {
+		if (battmgr->charge_owned)
+			battmgr->charge_frozen = true;
+		return -EPROTO;
+	}
+	*value = battmgr->dodge_otg_value;
+	return 0;
+}
+
+static int qcom_battmgr_charge_healthy(struct qcom_battmgr *battmgr, u32 generation)
+{
+	struct qcom_battmgr_dodge_request req = {
+		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_BATTMGR),
+		.hdr.type = cpu_to_le32(PMIC_GLINK_REQ_RESP),
+		.hdr.opcode = cpu_to_le32(DODGE_GAUGE_OPCODE),
+		.data_size = cpu_to_le32(DODGE_GAUGE_WORDS * sizeof(__le32)),
+	};
+	int ret;
+
+	ret = qcom_battmgr_charge_request(battmgr, BATTMGR_BAT_PROPERTY_GET,
+					BATT_HEALTH, 0, generation);
+	if (ret)
+		return ret;
+	if (battmgr->dodge_otg_value != POWER_SUPPLY_HEALTH_GOOD)
+		return -EAGAIN;
+	WRITE_ONCE(battmgr->dodge_gauge_pending, true);
+	ret = qcom_battmgr_request(battmgr, &req, sizeof(req));
+	WRITE_ONCE(battmgr->dodge_gauge_pending, false);
+	if (ret == -ETIMEDOUT) {
+		unsigned long flags;
+
+		/* Retire this control channel; a late gauge reply has no transaction ID. */
+		spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+		if (generation == battmgr->dodge_service_generation)
+			battmgr->dodge_otg_broken = true;
+		spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+	}
+	if (!ret && !qcom_battmgr_charge_transport_current(battmgr, generation))
+		ret = -ENOTCONN;
+	if (ret && battmgr->charge_owned &&
+	    !qcom_battmgr_charge_transport_current(battmgr, generation))
+		battmgr->charge_frozen = true;
+	if (ret)
+		return ret;
+	/* OEM gauge temperature is in deci-C; no interpretation of pack voltage. */
+	if ((s32)battmgr->dodge_gauge[0] < 0 || battmgr->dodge_gauge[0] > 430)
+		return -EAGAIN;
+	return 0;
+}
+
+static bool qcom_battmgr_charge_current(struct qcom_battmgr *battmgr, u32 generation, u32 epoch)
+{
+	unsigned long flags;
+	bool valid;
+
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	valid = battmgr->service_up && battmgr->dodge_otg_ready &&
+		!battmgr->dodge_otg_stopping && !battmgr->dodge_otg_broken &&
+		!battmgr->dodge_otg_requested && !battmgr->charge_closing &&
+		!battmgr->charge_suspending && generation == battmgr->dodge_service_generation &&
+		epoch == battmgr->charge_epoch;
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+	return valid;
+}
+
+static bool qcom_battmgr_charge_same_receiver(const struct nu1669_snapshot *a,
+					     const struct nu1669_snapshot *b)
+{
+	return a->generation == b->generation && a->chip_id == b->chip_id &&
+		a->hw_version == b->hw_version && a->customer_id == b->customer_id &&
+		a->fw_version == b->fw_version;
+}
+
+static int qcom_battmgr_charge_source(struct qcom_battmgr *battmgr, u32 generation,
+				    u32 epoch, struct nu1669_snapshot *snapshot)
+{
+	int ret;
+
+	if (!qcom_battmgr_charge_current(battmgr, generation, epoch) ||
+	    battmgr->dodge_power_state != DODGE_POWER_OFF)
+		return -EBUSY;
+	ret = qcom_battmgr_charge_request(battmgr, BATTMGR_USB_PROPERTY_GET,
+					USB_ONLINE, 0, generation);
+	if (ret || battmgr->dodge_otg_value)
+		return ret ?: -EBUSY;
+	ret = qcom_battmgr_charge_request(battmgr, BATTMGR_USB_PROPERTY_GET,
+					DODGE_USB_CID_STATUS, 0, generation);
+	if (ret || battmgr->dodge_otg_value)
+		return ret ?: -EBUSY;
+	ret = qcom_battmgr_charge_request(battmgr, BATTMGR_USB_PROPERTY_GET,
+					DODGE_USB_OTG_SWITCH, 0, generation);
+	if (ret || battmgr->dodge_otg_value)
+		return ret ?: -EBUSY;
+	ret = qcom_battmgr_charge_healthy(battmgr, generation);
+	if (ret)
+		return ret;
+	/* Finish with a fresh receiver read after all potentially blocking GLINK queries. */
+	ret = nu1669_get_snapshot(battmgr->wireless_receiver, snapshot);
+	if (ret)
+		return ret;
+	if (snapshot->protocol != 0x04 || snapshot->b2b_on || (snapshot->b2b_state & BIT(0)) ||
+	    snapshot->vout_mv < 4500 || snapshot->vout_mv > 6000)
+		return -EOPNOTSUPP;
+	return qcom_battmgr_charge_current(battmgr, generation, epoch) ? 0 : -EAGAIN;
+}
+
+/* Cleanup deliberately does not require a connected/readable receiver or USB absence. */
+static int qcom_battmgr_charge_restore(struct qcom_battmgr *battmgr)
+{
+	u32 value, generation = battmgr->charge_generation;
+	int ret;
+
+	if (!battmgr->charge_owned)
+		return 0;
+	battmgr->charge_pending = true;
+	if (battmgr->charge_frozen || !qcom_battmgr_charge_transport_current(battmgr, generation)) {
+		battmgr->charge_frozen = true;
+		return -ENOTCONN;
+	}
+	ret = qcom_battmgr_charge_raw_get(battmgr, generation, &value);
+	if (ret)
+		return ret;
+	if (!value) {
+		ret = qcom_battmgr_charge_healthy(battmgr, generation);
+		if (ret)
+			return ret;
+		/* Only a session acquired from a confirmed 1 can reach this SET1. */
+		ret = qcom_battmgr_charge_request(battmgr, BATTMGR_BAT_PROPERTY_SET,
+						BATT_CHG_CTRL_EN, 1, generation);
+		if (ret)
+			return ret;
+		ret = qcom_battmgr_charge_raw_get(battmgr, generation, &value);
+		if (ret)
+			return ret;
+		if (value != 1) {
+			battmgr->charge_frozen = true;
+			return -EPROTO;
+		}
+	}
+	battmgr->charge_owned = false;
+	battmgr->charge_pending = false;
+	power_supply_changed(battmgr->bat_psy);
+	return 0;
+}
+
+static void qcom_battmgr_charge_schedule(struct qcom_battmgr *battmgr)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	if (battmgr->charge_owned && !battmgr->charge_frozen &&
+	    !battmgr->charge_closing && !battmgr->charge_suspending)
+		schedule_delayed_work(&battmgr->charge_work, 2 * HZ);
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+}
+
+static int qcom_battmgr_charge_inhibit(struct qcom_battmgr *battmgr)
+{
+	struct nu1669_snapshot before, after;
+	unsigned long flags;
+	u32 generation, epoch, value;
+	int ret;
+
+	if (battmgr->charge_pending || battmgr->charge_frozen)
+		return -EBUSY;
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	generation = battmgr->dodge_service_generation;
+	epoch = battmgr->charge_epoch;
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+	if (battmgr->charge_owned &&
+	    (generation != battmgr->charge_generation || epoch != battmgr->charge_session_epoch)) {
+		ret = -EAGAIN;
+		goto cleanup;
+	}
+	ret = qcom_battmgr_charge_source(battmgr, generation, epoch, &before);
+	if (ret)
+		goto cleanup;
+	ret = qcom_battmgr_charge_raw_get(battmgr, generation, &value);
+	if (ret)
+		goto cleanup;
+	if (battmgr->charge_owned) {
+		if (value ||
+		    !qcom_battmgr_charge_same_receiver(&before, &battmgr->charge_receiver)) {
+			ret = -EAGAIN;
+			goto cleanup;
+		}
+		goto verify;
+	}
+	/* A pre-existing 0 belongs to somebody else; AUTO may never enable it. */
+	if (value != 1)
+		return -EBUSY;
+	ret = qcom_battmgr_charge_source(battmgr, generation, epoch, &after);
+	if (ret || !qcom_battmgr_charge_same_receiver(&before, &after))
+		return ret ?: -EAGAIN;
+	battmgr->charge_generation = generation;
+	battmgr->charge_session_epoch = epoch;
+	battmgr->charge_receiver = after;
+	/* Record possible ownership before firmware can apply an unacknowledged SET0. */
+	battmgr->charge_owned = true;
+	battmgr->charge_pending = true;
+	ret = qcom_battmgr_charge_request(battmgr, BATTMGR_BAT_PROPERTY_SET,
+					BATT_CHG_CTRL_EN, 0, generation);
+	if (ret)
+		goto cleanup;
+	ret = qcom_battmgr_charge_raw_get(battmgr, generation, &value);
+	if (ret)
+		goto cleanup;
+	if (value != 0) {
+		ret = -EPROTO;
+		goto cleanup;
+	}
+verify:
+	ret = qcom_battmgr_charge_source(battmgr, generation, epoch, &after);
+	if (ret || !qcom_battmgr_charge_same_receiver(&before, &after)) {
+		ret = ret ?: -EAGAIN;
+		goto cleanup;
+	}
+	battmgr->charge_pending = false;
+	qcom_battmgr_charge_schedule(battmgr);
+	return 0;
+cleanup:
+	if (battmgr->charge_owned) {
+		int restore_ret = qcom_battmgr_charge_restore(battmgr);
+
+		if (restore_ret)
+			dev_warn_ratelimited(battmgr->dev,
+					     "normal charge restore pending: %d\n", restore_ret);
+		qcom_battmgr_charge_schedule(battmgr);
+	}
+	return ret;
+}
+
+static int qcom_battmgr_charge_set_property(struct power_supply *psy,
+					  enum power_supply_property prop,
+					  const union power_supply_propval *val)
+{
+	struct qcom_battmgr *battmgr = power_supply_get_drvdata(psy);
+	int ret;
+
+	if (prop != POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR ||
+	    (val->intval != POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO &&
+	     val->intval != POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE))
+		return -EINVAL;
+	mutex_lock(&battmgr->lock);
+	if (READ_ONCE(battmgr->charge_closing) || READ_ONCE(battmgr->charge_suspending)) {
+		ret = -EBUSY;
+	} else if (val->intval == POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO) {
+		ret = qcom_battmgr_charge_restore(battmgr);
+		qcom_battmgr_charge_schedule(battmgr);
+	} else {
+		ret = qcom_battmgr_charge_inhibit(battmgr);
+	}
+	mutex_unlock(&battmgr->lock);
+	power_supply_changed(psy);
+	return ret;
+}
+
+static int qcom_battmgr_charge_is_writeable(struct power_supply *psy,
+					  enum power_supply_property prop)
+{
+	return prop == POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR;
+}
+
+static void qcom_battmgr_charge_worker(struct work_struct *work)
+{
+	struct qcom_battmgr *battmgr = container_of(to_delayed_work(work),
+						 struct qcom_battmgr, charge_work);
+	struct nu1669_snapshot snapshot;
+	int ret = 0;
+	u32 value;
+
+	mutex_lock(&battmgr->lock);
+	if (!battmgr->charge_owned || READ_ONCE(battmgr->charge_closing) ||
+	    READ_ONCE(battmgr->charge_suspending))
+		goto out;
+	if (!battmgr->charge_pending) {
+		ret = qcom_battmgr_charge_source(battmgr, battmgr->charge_generation,
+					       battmgr->charge_session_epoch, &snapshot);
+		if (!ret &&
+		    !qcom_battmgr_charge_same_receiver(&snapshot, &battmgr->charge_receiver))
+			ret = -EAGAIN;
+		if (!ret)
+			ret = qcom_battmgr_charge_raw_get(battmgr,
+							battmgr->charge_generation, &value);
+		if (!ret && value)
+			ret = -EAGAIN;
+	}
+	if (ret || battmgr->charge_pending)
+		ret = qcom_battmgr_charge_restore(battmgr);
+	if (ret)
+		dev_warn_ratelimited(battmgr->dev, "normal charge restore pending: %d\n", ret);
+	qcom_battmgr_charge_schedule(battmgr);
+out:
+	mutex_unlock(&battmgr->lock);
+}
+
+static int qcom_battmgr_charge_suspend(struct device *dev)
+{
+	struct qcom_battmgr *battmgr = dev_get_drvdata(dev);
+	unsigned long flags;
+	int ret;
+
+	if (battmgr->variant != QCOM_BATTMGR_DODGE)
+		return 0;
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	battmgr->charge_suspending = true;
+	battmgr->charge_epoch++;
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+	cancel_delayed_work_sync(&battmgr->charge_work);
+	mutex_lock(&battmgr->lock);
+	ret = qcom_battmgr_charge_restore(battmgr);
+	if (ret) {
+		WRITE_ONCE(battmgr->charge_suspending, false);
+		qcom_battmgr_charge_schedule(battmgr);
+	}
+	mutex_unlock(&battmgr->lock);
+	return ret ? -EBUSY : 0;
+}
+
+static int qcom_battmgr_charge_resume(struct device *dev)
+{
+	struct qcom_battmgr *battmgr = dev_get_drvdata(dev);
+
+	if (battmgr->variant == QCOM_BATTMGR_DODGE)
+		WRITE_ONCE(battmgr->charge_suspending, false);
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(qcom_battmgr_charge_pm_ops,
+			       qcom_battmgr_charge_suspend, qcom_battmgr_charge_resume);
+
+/* Validate the normal gauge packet before reading its optional input flag. */
+static int qcom_battmgr_dodge_decode_input_suspend(const void *data, size_t len, u32 *value)
+{
+	const struct qcom_battmgr_dodge_response *response = data;
+	u32 gauge[9], flag;
+	int ret;
+
+	ret = qcom_battmgr_dodge_decode(data, len, gauge);
+	if (ret)
+		return ret;
+	if (le32_to_cpu(response->data_size) < 10 * sizeof(__le32))
+		return -ENODATA;
+	flag = le32_to_cpu(response->data[9]);
+	if (flag > 1)
+		return -EPROTO;
+	*value = flag;
+	return 0;
+}
+
+static int qcom_battmgr_dodge_normal_input_suspend_get(void *data, u64 *value)
+{
+	struct qcom_battmgr *battmgr = data;
+	struct qcom_battmgr_dodge_request req = {
+		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_BATTMGR),
+		.hdr.type = cpu_to_le32(PMIC_GLINK_REQ_RESP),
+		.hdr.opcode = cpu_to_le32(DODGE_GAUGE_OPCODE),
+		.data_size = cpu_to_le32(DODGE_GAUGE_WORDS * sizeof(__le32)),
+	};
+	unsigned long flags;
+	u32 generation;
+	int ret;
+
+	mutex_lock(&battmgr->lock);
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	generation = battmgr->dodge_service_generation;
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+	if (!qcom_battmgr_charge_transport_current(battmgr, generation)) {
+		ret = -ENOTCONN;
+		goto out;
+	}
+	/* Missing or failed replies must never expose a previous optional value. */
+	battmgr->dodge_input_suspend_error = -ENODATA;
+	WRITE_ONCE(battmgr->dodge_gauge_pending, true);
+	ret = qcom_battmgr_request(battmgr, &req, sizeof(req));
+	WRITE_ONCE(battmgr->dodge_gauge_pending, false);
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	if (ret == -ETIMEDOUT && generation == battmgr->dodge_service_generation)
+		battmgr->dodge_otg_broken = true;
+	if (!ret && (!battmgr->service_up || battmgr->dodge_otg_stopping ||
+		     battmgr->dodge_otg_broken || generation != battmgr->dodge_service_generation))
+		ret = -ENOTCONN;
+	if (!ret) {
+		ret = battmgr->dodge_input_suspend_error;
+		if (!ret)
+			*value = battmgr->dodge_input_suspend;
+	}
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+out:
+	mutex_unlock(&battmgr->lock);
+	return ret;
+}
+DEFINE_DEBUGFS_ATTRIBUTE(qcom_battmgr_dodge_normal_input_suspend_fops,
+			qcom_battmgr_dodge_normal_input_suspend_get, NULL, "%llu\n");
+
+/* Raw normal-path firmware gate, not a charging policy or aggregate status. */
+static int qcom_battmgr_dodge_normal_charge_enable_get(void *data, u64 *value)
+{
+	struct qcom_battmgr *battmgr = data;
+	unsigned long flags;
+	u32 generation;
+	int ret;
+
+	mutex_lock(&battmgr->lock);
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	generation = battmgr->dodge_service_generation;
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+	ret = qcom_battmgr_dodge_otg_request(battmgr, BATTMGR_BAT_PROPERTY_GET,
+					   BATT_CHG_CTRL_EN, 0, generation);
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	if (!ret && (!battmgr->service_up || battmgr->dodge_otg_stopping ||
+		     generation != battmgr->dodge_service_generation))
+		ret = -ENOTCONN;
+	if (!ret) {
+		if (battmgr->dodge_otg_value > 1)
+			ret = -EPROTO;
+		else
+			*value = battmgr->dodge_otg_value;
+	}
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+	mutex_unlock(&battmgr->lock);
+	return ret;
+}
+DEFINE_DEBUGFS_ATTRIBUTE(qcom_battmgr_dodge_normal_charge_enable_fops,
+			qcom_battmgr_dodge_normal_charge_enable_get, NULL, "%llu\n");
+
+/* OEM wireless input current limit, in microamps; no control writes. */
+static int qcom_battmgr_dodge_wireless_input_current_limit_get(void *data, u64 *value)
+{
+	struct qcom_battmgr *battmgr = data;
+	unsigned long flags;
+	u32 generation;
+	int ret;
+
+	mutex_lock(&battmgr->lock);
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	generation = battmgr->dodge_service_generation;
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+	ret = qcom_battmgr_dodge_otg_request(battmgr, BATTMGR_WLS_PROPERTY_GET,
+					   DODGE_WLS_INPUT_CURR_LIMIT, 0, generation);
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	if (!ret && (!battmgr->service_up || battmgr->dodge_otg_stopping ||
+		     generation != battmgr->dodge_service_generation))
+		ret = -ENOTCONN;
+	if (!ret)
+		*value = battmgr->dodge_otg_value;
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+	mutex_unlock(&battmgr->lock);
+	return ret;
+}
+DEFINE_DEBUGFS_ATTRIBUTE(qcom_battmgr_dodge_wireless_input_current_limit_fops,
+			qcom_battmgr_dodge_wireless_input_current_limit_get, NULL, "%llu\n");
