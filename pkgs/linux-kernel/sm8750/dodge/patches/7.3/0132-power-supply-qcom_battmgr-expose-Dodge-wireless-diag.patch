+static void qcom_battmgr_dodge_debugfs_remove(void *data)
+{
+	struct qcom_battmgr *battmgr = data;
+
+	/* Removal drains active accesses; retained open files cannot enter again. */
+	debugfs_remove_recursive(battmgr->dodge_debugfs);
+	battmgr->dodge_debugfs = NULL;
+}
+
+static int qcom_battmgr_dodge_debugfs_init(struct qcom_battmgr *battmgr)
+{
+	if (battmgr->variant != QCOM_BATTMGR_DODGE)
+		return 0;
+	battmgr->dodge_debugfs = debugfs_create_dir("qcom-battmgr-dodge", NULL);
+	if (IS_ERR_OR_NULL(battmgr->dodge_debugfs))
+		return 0;
+	debugfs_create_file("normal_charge_enable", 0400, battmgr->dodge_debugfs,
+			    battmgr, &qcom_battmgr_dodge_normal_charge_enable_fops);
+	debugfs_create_file("normal_input_suspend", 0400, battmgr->dodge_debugfs,
+			    battmgr, &qcom_battmgr_dodge_normal_input_suspend_fops);
+	debugfs_create_file("wireless_input_current_limit", 0400, battmgr->dodge_debugfs,
+			    battmgr, &qcom_battmgr_dodge_wireless_input_current_limit_fops);
+	return devm_add_action_or_reset(battmgr->dev, qcom_battmgr_dodge_debugfs_remove,
+				       battmgr);
+}
