+static int syna_tcm_foreach_end(const unsigned char *config, unsigned int size,
+				unsigned int start, bool inside, unsigned int *end)
+{
+	unsigned int depth = inside ? 1 : 0;
+	unsigned int i = start;
+
+	while (i < size) {
+		switch (config[i++]) {
+		case TOUCH_REPORT_FOREACH_ACTIVE_OBJECT:
+		case TOUCH_REPORT_FOREACH_OBJECT:
+			if (depth++)
+				return -EINVAL;
+			break;
+		case TOUCH_REPORT_FOREACH_END:
+			if (!depth)
+				return -EINVAL;
+			*end = i;
+			return 0;
+		case TOUCH_REPORT_END:
+			return -EINVAL;
+		case TOUCH_REPORT_PAD_TO_NEXT_BYTE:
+			break;
+		default:
+			/* Other opcodes consume the following field-width byte. */
+			if (i >= size)
+				return -EINVAL;
+			i++;
+			break;
+		}
+	}
+	return -EINVAL;
+}
