+			mod_delayed_work(system_percpu_wq, &battmgr->dodge_otg_work, 0);
+	}
+	spin_unlock_irqrestore(&battmgr->dodge_otg_lock, flags);
+
+	return ret ? ret : present;
+}
+
+static int qcom_battmgr_wireless_notifier(struct notifier_block *nb,
+					unsigned long event, void *data)
+{
