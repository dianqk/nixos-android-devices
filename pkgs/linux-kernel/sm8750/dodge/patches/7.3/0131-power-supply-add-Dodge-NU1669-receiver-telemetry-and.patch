diff --git a/drivers/power/supply/nu1669.c b/drivers/power/supply/nu1669.c
new file mode 100644
index 0000000000..ea0654a760
--- /dev/null
+++ b/drivers/power/supply/nu1669.c
@@ -0,0 +1,365 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (C) 2023-2024 Oplus. All rights reserved.
+ * Copyright (C) 2026 dianqk
+ *
+ * NU1669 firmware shadow layout derived from the Oplus NU1669 driver.
+ * This driver only observes the receiver. It never sends firmware commands,
+ * acknowledges events, changes protection settings or enables power transfer.
+ */
+
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/power_supply.h>
+#include <linux/regmap.h>
+#include <linux/unaligned.h>
+#include <linux/workqueue.h>
+
+#define NU1669_INFO_BASE		0x2100
+#define NU1669_INFO_SIZE		0x48
+#define NU1669_POLL_MS		2000
+
+struct nu1669 {
+	struct regmap *regmap;
+	struct gpio_desc *connected;
+	struct gpio_desc *event;
+	struct power_supply *psy;
+	struct delayed_work poll;
+	struct mutex lock;
+	int present;
+	int irq;
+	u32 generation;
+	bool suspended;
+	bool stopped;
+	bool valid;
+	u8 info[NU1669_INFO_SIZE];
+};
+
+static const struct regmap_range nu1669_read_ranges[] = {
+	regmap_reg_range(NU1669_INFO_BASE, NU1669_INFO_BASE + NU1669_INFO_SIZE - 1),
+};
+
+static const struct regmap_access_table nu1669_read_table = {
+	.yes_ranges = nu1669_read_ranges,
+	.n_yes_ranges = ARRAY_SIZE(nu1669_read_ranges),
+};
+
+static bool nu1669_writeable_reg(struct device *dev, unsigned int reg)
+{
+	return false;
+}
+
+static const struct regmap_config nu1669_regmap_config = {
+	.reg_bits = 16,
+	.val_bits = 8,
+	.reg_format_endian = REGMAP_ENDIAN_BIG,
+	.max_register = NU1669_INFO_BASE + NU1669_INFO_SIZE - 1,
+	.rd_table = &nu1669_read_table,
+	.writeable_reg = nu1669_writeable_reg,
+	.cache_type = REGCACHE_NONE,
+};
+
+static enum power_supply_property nu1669_properties[] = {
+	POWER_SUPPLY_PROP_ONLINE,
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_MANUFACTURER,
+	POWER_SUPPLY_PROP_MODEL_NAME,
+};
+
+static int nu1669_get_property(struct power_supply *psy,
+			      enum power_supply_property prop,
+			      union power_supply_propval *val)
+{
+	struct nu1669 *rx = power_supply_get_drvdata(psy);
+	int present, ret = 0;
+
+	if (prop == POWER_SUPPLY_PROP_PRESENT || prop == POWER_SUPPLY_PROP_ONLINE ||
+	    prop == POWER_SUPPLY_PROP_VOLTAGE_NOW || prop == POWER_SUPPLY_PROP_CURRENT_NOW) {
+		/* A safety consumer must never mistake a stale or errored input for absence. */
+		present = gpiod_get_value_cansleep(rx->connected);
+		if (present < 0)
+			return present;
+		if (prop == POWER_SUPPLY_PROP_PRESENT) {
+			val->intval = present;
+			return 0;
+		}
+		if (!present && prop != POWER_SUPPLY_PROP_ONLINE)
+			return -ENODATA;
+	} else {
+		present = 0;
+	}
+
+	mutex_lock(&rx->lock);
+	switch (prop) {
+	case POWER_SUPPLY_PROP_ONLINE:
+		/* Receiver output availability, never a battery charging-state claim. */
+		val->intval = present && rx->valid && get_unaligned_le16(rx->info + 0x34);
+		break;
+	case POWER_SUPPLY_PROP_MANUFACTURER:
+		val->strval = "NuVolta";
+		break;
+	case POWER_SUPPLY_PROP_MODEL_NAME:
+		val->strval = "NU1669";
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		if (!rx->valid) {
+			ret = -ENODATA;
+			break;
+		}
+		/* Firmware reports receiver output in mV and mA. */
+		val->intval = get_unaligned_le16(rx->info +
+			(prop == POWER_SUPPLY_PROP_VOLTAGE_NOW ? 0x34 : 0x36)) * 1000;
+		break;
+	default:
+		ret = -EINVAL;
+	}
+	mutex_unlock(&rx->lock);
+
+	return ret;
+}
+
+static const struct power_supply_desc nu1669_psy_desc = {
+	.name = "nu1669-receiver",
+	.type = POWER_SUPPLY_TYPE_WIRELESS,
+	.properties = nu1669_properties,
+	.num_properties = ARRAY_SIZE(nu1669_properties),
+	.get_property = nu1669_get_property,
+};
+
+/* Read-only diagnostics: raw firmware values, not charging-state claims. */
+static ssize_t firmware_state_show(struct device *dev,
+				   struct device_attribute *attr, char *buf)
+{
+	struct nu1669 *rx = dev_get_drvdata(dev);
+	ssize_t ret;
+
+	ret = gpiod_get_value_cansleep(rx->connected);
+	if (ret <= 0)
+		return ret < 0 ? ret : -ENODATA;
+
+	mutex_lock(&rx->lock);
+	if (!rx->valid)
+		ret = -ENODATA;
+	else
+		ret = sysfs_emit(buf,
+			"chip_id=0x%04x hw=0x%02x customer=0x%02x fw=0x%02x protocol=0x%02x events=0x%08x vrect_mv=%u b2b_on=0x%02x b2b_state=0x%02x\n",
+			get_unaligned_le16(rx->info), rx->info[2], rx->info[3],
+			rx->info[4], rx->info[0x11],
+			get_unaligned_le32(rx->info + 0x20),
+			get_unaligned_le16(rx->info + 0x38), rx->info[0x44], rx->info[0x46]);
+	mutex_unlock(&rx->lock);
+
+	return ret;
+}
+static DEVICE_ATTR_RO(firmware_state);
+
+static struct attribute *nu1669_attrs[] = {
+	&dev_attr_firmware_state.attr,
+	NULL,
+};
+static const struct attribute_group nu1669_group = {
+	.attrs = nu1669_attrs,
+};
+
+static bool nu1669_online(struct nu1669 *rx)
+{
+	return rx->present > 0 && rx->valid && get_unaligned_le16(rx->info + 0x34);
+}
+
+static void nu1669_poll(struct work_struct *work)
+{
+	struct nu1669 *rx = container_of(to_delayed_work(work), struct nu1669, poll);
+	u8 info[NU1669_INFO_SIZE] = {};
+	bool valid = false, changed, online;
+	u32 generation;
+	int present, ret;
+
+	mutex_lock(&rx->lock);
+	generation = rx->generation;
+	if (rx->suspended || rx->stopped) {
+		mutex_unlock(&rx->lock);
+		return;
+	}
+	mutex_unlock(&rx->lock);
+
+	present = gpiod_get_value_cansleep(rx->connected);
+	if (present > 0) {
+		ret = regmap_bulk_read(rx->regmap, NU1669_INFO_BASE, info, sizeof(info));
+		if (!ret) {
+			present = gpiod_get_value_cansleep(rx->connected);
+			valid = present > 0;
+		}
+	}
+
+	mutex_lock(&rx->lock);
+	if (rx->suspended || rx->stopped || generation != rx->generation) {
+		mutex_unlock(&rx->lock);
+		return;
+	}
+	online = nu1669_online(rx);
+	changed = rx->present != present || rx->valid != valid;
+	rx->present = present;
+	rx->valid = valid;
+	if (valid)
+		memcpy(rx->info, info, sizeof(info));
+	else
+		memset(rx->info, 0, sizeof(rx->info));
+	changed |= online != nu1669_online(rx);
+	/* Telemetry is sampled quietly; notify changes affecting authorization. */
+	if (changed)
+		power_supply_changed(rx->psy);
+	schedule_delayed_work(&rx->poll, msecs_to_jiffies(NU1669_POLL_MS));
+	mutex_unlock(&rx->lock);
+}
+
+static irqreturn_t nu1669_connected_irq(int irq, void *data)
+{
+	struct nu1669 *rx = data;
+
+	mutex_lock(&rx->lock);
+	rx->generation++;
+	rx->valid = false;
+	memset(rx->info, 0, sizeof(rx->info));
+	if (!rx->suspended && !rx->stopped) {
+		/* Always notify, including an attach/detach coalesced before sampling. */
+		power_supply_changed(rx->psy);
+		mod_delayed_work(system_percpu_wq, &rx->poll, 0);
+	}
+	mutex_unlock(&rx->lock);
+	return IRQ_HANDLED;
+}
+
+static void nu1669_stop(void *data)
+{
+	struct nu1669 *rx = data;
+
+	mutex_lock(&rx->lock);
+	if (rx->stopped) {
+		mutex_unlock(&rx->lock);
+		return;
+	}
+	rx->stopped = true;
+	rx->valid = false;
+	memset(rx->info, 0, sizeof(rx->info));
+	mutex_unlock(&rx->lock);
+	/* Quiesce the producer before draining work and before devres frees the IRQ. */
+	disable_irq(rx->irq);
+	cancel_delayed_work_sync(&rx->poll);
+}
+
+static int nu1669_probe(struct i2c_client *client)
+{
+	struct power_supply_config psy_cfg = {};
+	struct device *dev = &client->dev;
+	struct nu1669 *rx;
+	int ret;
+
+	rx = devm_kzalloc(dev, sizeof(*rx), GFP_KERNEL);
+	if (!rx)
+		return -ENOMEM;
+
+	mutex_init(&rx->lock);
+	INIT_DELAYED_WORK(&rx->poll, nu1669_poll);
+	i2c_set_clientdata(client, rx);
+	rx->regmap = devm_regmap_init_i2c(client, &nu1669_regmap_config);
+	if (IS_ERR(rx->regmap))
+		return PTR_ERR(rx->regmap);
+
+	rx->connected = devm_gpiod_get(dev, "connected", GPIOD_IN);
+	if (IS_ERR(rx->connected))
+		return dev_err_probe(dev, PTR_ERR(rx->connected), "connection input\n");
+
+	/* A level event IRQ needs a firmware write to acknowledge: leave it alone. */
+	rx->event = devm_gpiod_get_optional(dev, "event", GPIOD_IN);
+	if (IS_ERR(rx->event))
+		return dev_err_probe(dev, PTR_ERR(rx->event), "event input\n");
+
+	psy_cfg.drv_data = rx;
+	psy_cfg.fwnode = dev_fwnode(dev);
+	rx->psy = devm_power_supply_register(dev, &nu1669_psy_desc, &psy_cfg);
+	if (IS_ERR(rx->psy))
+		return dev_err_probe(dev, PTR_ERR(rx->psy), "power supply\n");
+
+	ret = devm_device_add_group(dev, &nu1669_group);
+	if (ret)
+		return ret;
+
+	rx->irq = gpiod_to_irq(rx->connected);
+	if (rx->irq < 0)
+		return dev_err_probe(dev, rx->irq, "connection IRQ\n");
+	ret = devm_request_threaded_irq(dev, rx->irq, NULL, nu1669_connected_irq,
+			IRQF_ONESHOT | IRQF_TRIGGER_RISING | IRQF_TRIGGER_FALLING,
+			dev_name(dev), rx);
+	if (ret)
+		return dev_err_probe(dev, ret, "connection IRQ\n");
+
+	ret = devm_add_action_or_reset(dev, nu1669_stop, rx);
+	if (ret)
+		return ret;
+
+	/* An unpowered receiver is normal; do not require an I2C reply at probe. */
+	schedule_delayed_work(&rx->poll, 0);
+	return 0;
+}
+
+static int nu1669_suspend(struct device *dev)
+{
+	struct nu1669 *rx = dev_get_drvdata(dev);
+
+	mutex_lock(&rx->lock);
+	rx->suspended = true;
+	rx->generation++;
+	rx->valid = false;
+	memset(rx->info, 0, sizeof(rx->info));
+	mutex_unlock(&rx->lock);
+	disable_irq(rx->irq);
+	cancel_delayed_work_sync(&rx->poll);
+	power_supply_changed(rx->psy);
+	return 0;
+}
+
+static int nu1669_resume(struct device *dev)
+{
+	struct nu1669 *rx = dev_get_drvdata(dev);
+
+	mutex_lock(&rx->lock);
+	rx->suspended = false;
+	mutex_unlock(&rx->lock);
+	enable_irq(rx->irq);
+	mod_delayed_work(system_percpu_wq, &rx->poll, 0);
+	return 0;
+}
+
+static void nu1669_shutdown(struct i2c_client *client)
+{
+	nu1669_stop(i2c_get_clientdata(client));
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(nu1669_pm_ops, nu1669_suspend, nu1669_resume);
+
