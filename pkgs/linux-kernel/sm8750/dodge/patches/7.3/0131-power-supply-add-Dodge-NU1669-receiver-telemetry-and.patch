diff --git a/Documentation/ABI/testing/sysfs-bus-i2c-nu1669 b/Documentation/ABI/testing/sysfs-bus-i2c-nu1669
new file mode 100644
index 0000000000..78d8c81d73
--- /dev/null
+++ b/Documentation/ABI/testing/sysfs-bus-i2c-nu1669
@@ -0,0 +1,24 @@
+What:           /sys/bus/i2c/devices/.../firmware_state
+Date:           November 2026
+Contact:        dianqk <dianqk@dianqk.net>
+Description:
+                Read-only NU1669 firmware shadow diagnostics. A line contains
+                chip_id, hw (hardware revision), customer, fw (firmware version),
+                protocol, events (unacknowledged firmware event bits), and
+                vrect_mv (rectifier voltage in millivolts), b2b_on and b2b_state
+                (raw firmware direct-path state). Identity, protocol
+                event and direct-path fields are hexadecimal raw firmware values. Protocol
+                0x04 denotes BPP and 0x31 denotes EPP; other values are not
+                interpreted. These values do not establish battery charging,
+                authentication, protection configuration or power-flow state.
+                Data is polled every two seconds while attached. Reads return
+                ENODATA after a failed sample, detach or system suspend until
+                a fresh attached sample succeeds. Events are never cleared by
+                this driver. The firmware shadow need not be an atomic hardware
+                snapshot.
+                Connection edges immediately invalidate the sampled shadow.
+                The power-supply PRESENT property reads the physical connection
+                input afresh and propagates GPIO errors. ONLINE means attached
+                with a valid sample reporting positive receiver output voltage;
+                it does not mean the battery is charging. No connection IRQ is
+                enabled as a system wake source.
diff --git a/Documentation/devicetree/bindings/power/supply/nuvolta,nu1669.yaml b/Documentation/devicetree/bindings/power/supply/nuvolta,nu1669.yaml
new file mode 100644
index 0000000000..d661bfacb7
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/nuvolta,nu1669.yaml
@@ -0,0 +1,52 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/nuvolta,nu1669.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: NuVolta NU1669 wireless power receiver
+
+maintainers:
+  - dianqk <dianqk@dianqk.net>
+
+description: |
+  NU1669 receiver with a firmware-managed wireless power interface. The
+  connection input indicates receiver attachment, independently of whether
+  output power is flowing. The event input requires firmware acknowledgment.
+
+properties:
+  compatible:
+    const: nuvolta,nu1669
+
+  reg:
+    maxItems: 1
+
+  connected-gpios:
+    maxItems: 1
+    description: Receiver connection indication, asserted while attached.
+
+  event-gpios:
+    maxItems: 1
+    description: Active-low firmware event indication.
+
+required:
+  - compatible
+  - reg
+  - connected-gpios
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        wireless-charger@36 {
+            compatible = "nuvolta,nu1669";
+            reg = <0x36>;
+            connected-gpios = <&gpio 172 GPIO_ACTIVE_HIGH>;
+            event-gpios = <&gpio 108 GPIO_ACTIVE_LOW>;
+        };
+    };
