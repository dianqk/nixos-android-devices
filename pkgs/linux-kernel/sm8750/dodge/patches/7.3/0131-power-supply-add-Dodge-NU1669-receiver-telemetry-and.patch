+/* No firmware transaction or battmgr mutex in the provider notifier. */
+static int qcom_battmgr_wireless_present(struct qcom_battmgr *battmgr, bool event)
+{
+	union power_supply_propval val;
+	unsigned long flags;
+	bool known, present, changed;
+	int ret;
+
+	if (!battmgr->wireless_receiver)
+		return 0;
+
+	ret = power_supply_get_property(battmgr->wireless_receiver,
+					POWER_SUPPLY_PROP_PRESENT, &val);
+	known = !ret;
+	present = known && val.intval;
+	spin_lock_irqsave(&battmgr->dodge_otg_lock, flags);
+	changed = known != battmgr->wireless_known || present != battmgr->wireless_present;
+	battmgr->wireless_known = known;
+	battmgr->wireless_present = present;
+	if ((changed || event) && battmgr->variant == QCOM_BATTMGR_DODGE) {
+		/* Even coalesced attach/detach must revoke an in-flight authorization. */
+		battmgr->dodge_otg_epoch++;
