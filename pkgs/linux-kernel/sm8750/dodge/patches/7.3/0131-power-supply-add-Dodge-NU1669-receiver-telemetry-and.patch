+	if (event != PSY_EVENT_PROP_CHANGED || data != battmgr->wireless_receiver)
+		return NOTIFY_DONE;
+	qcom_battmgr_wireless_present(battmgr, true);
+	power_supply_changed(battmgr->wls_psy);
+	return NOTIFY_OK;
+}
