From a832903a0513ec10c9a787a8e7b6a1ccdc5596fc Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Wed, 11 Nov 2026 04:11:26 +0800
Subject: [PATCH 117/144] media: camss: reconcile SM8750 resources with current
 split PHY API

Port the SM8750 v6 resource description to Kaanapali v24: six external PHYs, dedicated VFE RDI counts and the renamed shared VFE 1080 implementation. Preserve separate register/address update callbacks while retaining the 980 lite combined command shadow.

Import-Patch: pkgs/linux-kernel/sm8750/dodge/patches/7.3/0149-media-camss-reconcile-SM8750-resources-with-current-.patch
Import-SHA256: 53888077ad9a4af49bbf79b8288557e5f3b5d7929bd4470f4ec322df724d87a0
Import-Provenance: mail headers
(cherry picked from commit 36cb051cb51c48cffed726a411bb174f97dd4c14)
---
 .../platform/qcom/camss/camss-csid-980.c      |  22 ++-
 drivers/media/platform/qcom/camss/camss.c     | 126 +++++++++++++++++-
 2 files changed, 138 insertions(+), 10 deletions(-)

diff --git a/drivers/media/platform/qcom/camss/camss-csid-980.c b/drivers/media/platform/qcom/camss/camss-csid-980.c
index 16184fe693..4cc787f515 100644
--- a/drivers/media/platform/qcom/camss/camss-csid-980.c
+++ b/drivers/media/platform/qcom/camss/camss-csid-980.c
@@ -139,8 +139,8 @@ static void __csid_aup_update(struct csid_device *csid, int port_id)
 		csid->reg_update |= CSID_LITE_AUP_RDI(port_id);
 		writel(csid->reg_update, csid->base + CSID_LITE_RUP_AUP_CMD);
 	} else {
-		csid->aup_update |= CSID_RUP_AUP_RDI(port_id);
-		writel(csid->aup_update, csid->base + CSID_AUP_CMD);
+		csid->addr_update |= CSID_RUP_AUP_RDI(port_id);
+		writel(csid->addr_update, csid->base + CSID_AUP_CMD);
 
 		/* CSID Fulls in v980 split AUP and RUP commands, which requires
 		 * additional SET operation to make registers modification take
@@ -159,8 +159,8 @@ static void __csid_rup_update(struct csid_device *csid, int port_id)
 		csid->reg_update |= CSID_LITE_RUP_RDI(port_id);
 		writel(csid->reg_update, csid->base + CSID_LITE_RUP_AUP_CMD);
 	} else {
-		csid->rup_update |= CSID_RUP_AUP_RDI(port_id);
-		writel(csid->rup_update, csid->base + CSID_RUP_CMD);
+		csid->reg_update |= CSID_RUP_AUP_RDI(port_id);
+		writel(csid->reg_update, csid->base + CSID_RUP_CMD);
 
 		/* CSID Fulls in v980 split AUP and RUP commands, which requires
 		 * additional SET operation to make registers modification take
@@ -177,8 +177,8 @@ static void __csid_aup_rup_clear(struct csid_device *csid, int port_id)
 		csid->reg_update &= ~CSID_LITE_RUP_RDI(port_id);
 		csid->reg_update &= ~CSID_LITE_AUP_RDI(port_id);
 	} else {
-		csid->aup_update &= ~CSID_RUP_AUP_RDI(port_id);
-		csid->rup_update &= ~CSID_RUP_AUP_RDI(port_id);
+		csid->addr_update &= ~CSID_RUP_AUP_RDI(port_id);
+		csid->reg_update &= ~CSID_RUP_AUP_RDI(port_id);
 	}
 }
 
@@ -332,6 +332,15 @@ static int csid_configure_testgen_pattern(struct csid_device *csid, s32 val)
 
 static void csid_subdev_reg_update(struct csid_device *csid, int port_id,
 				   bool clear)
+{
+	if (clear)
+		__csid_aup_rup_clear(csid, port_id);
+	else
+		__csid_rup_update(csid, port_id);
+}
+
+static void csid_subdev_addr_update(struct csid_device *csid, int port_id,
+				   bool clear)
 {
 	if (clear)
 		__csid_aup_rup_clear(csid, port_id);
@@ -450,5 +459,6 @@ const struct csid_hw_ops csid_ops_980 = {
 	.src_pad_code = csid_src_pad_code,
 	.subdev_init = csid_subdev_init,
 	.reg_update = csid_subdev_reg_update,
+	.addr_update = csid_subdev_addr_update,
 };
 
