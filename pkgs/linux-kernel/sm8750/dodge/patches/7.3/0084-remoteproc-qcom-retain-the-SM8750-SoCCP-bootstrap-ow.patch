+	if (ret)
+		return ret; /* Built-in safety notifier/owners deliberately remain. */
+	ret = platform_driver_register(&qcom_soccp_driver);
+	if (ret)
+		platform_driver_unregister(&qcom_pas_driver);
+	return ret;
+}
