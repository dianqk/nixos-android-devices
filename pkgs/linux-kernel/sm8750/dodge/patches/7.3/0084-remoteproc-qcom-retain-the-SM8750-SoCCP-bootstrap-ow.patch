+/*
+ * SM8750's boot image runs without its own NoC vote. This owner deliberately
+ * outlives failed probes: devres must not remove the last vote from a D0 image.
+ * One owner per static DT node is retained for the built-in driver's lifetime.
+ * The dedicated driver has no bind/unbind attributes; modular SoCCP is rejected.
+ */
+#define SOCCP_COMPAT "qcom,sm8750-soccp-pas"
+#define SOCCP_BOOT_BW 1200
+#define SOCCP_DSTATE_MASK GENMASK(3, 1)
+#define SOCCP_D3 BIT(3)
+
+struct soccp_guard {
+	struct list_head list;
+	struct device_node *node;
+	struct device *dev;
+	struct icc_path *path;
+	struct rproc *rproc;
+	struct regmap *tcsr;
+	u32 offset;
+	u32 status;
+	unsigned long generation;
+	unsigned long handover_generation;
+	int error;
+	bool voted;
+	bool busy;
+	bool started;
+	bool shutdown;
+	bool accepting_handover;
+	bool proxy_acquired;
+	bool proxy_released;
+	bool stale_handover;
 };
 
+static LIST_HEAD(soccp_guards);
+static DEFINE_MUTEX(soccp_lock);
+static bool soccp_frozen;
+static bool soccp_registry_incomplete;
+
+static struct soccp_guard *soccp_find(struct device_node *node)
+{
+	struct soccp_guard *guard;
+
+	list_for_each_entry(guard, &soccp_guards, list)
+		if (guard->node == node)
+			return guard;
+	return NULL;
+}
+
+/* soccp_lock serializes ICC requests, status, and the complete PM gate. */
+static int soccp_vote(struct soccp_guard *guard)
+{
+	int ret;
+
+	if (!guard->path)
+		return guard->error = -ENODEV;
+	ret = icc_set_bw(guard->path, SOCCP_BOOT_BW, SOCCP_BOOT_BW);
+	if (!ret)
+		guard->voted = true;
+	return guard->error = ret;
+}
+
+static int soccp_release(struct soccp_guard *guard)
+{
+	int ret;
+
+	if (!guard->path || !guard->tcsr || guard->busy)
+		return guard->error = -EBUSY;
+	if (!guard->shutdown) {
+		if (!guard->started ||
+		    guard->handover_generation != guard->generation)
+			return guard->error = -EBUSY;
+		ret = regmap_read_poll_timeout(guard->tcsr, guard->offset,
+					       guard->status,
+					       (guard->status & SOCCP_DSTATE_MASK) == SOCCP_D3,
+					       200, 10000);
+		if (ret) {
+			/* The image left D3: restore protection, but reject this PM. */
+			soccp_vote(guard);
+			return guard->error = ret;
+		}
+	}
+	if (guard->voted) {
+		ret = icc_set_bw(guard->path, 0, 0);
+		if (ret) {
+			/* ICC rolls requests back, but provider rollback can fail too. */
+			soccp_vote(guard);
+			return guard->error = ret;
+		}
+		guard->voted = false;
+		dev_info(guard->dev, "SoCCP generation %lu safe, boot vote released (state %#x)\n",
+			 guard->generation, guard->status);
+	}
+	return guard->error = 0;
+}
+
+static int soccp_get_guard(struct device *dev, struct soccp_guard **result)
+{
+	struct soccp_guard *guard;
+	int ret = -EBUSY;
+
+	mutex_lock(&soccp_lock);
+	guard = soccp_find(dev->of_node);
+	if (!guard || soccp_frozen)
+		goto out;
+	if (!guard->dev)
+		guard->dev = get_device(dev);
+	if (!guard->path) {
+		guard->path = of_icc_get(dev, NULL);
+		if (IS_ERR(guard->path)) {
+			ret = PTR_ERR(guard->path);
+			guard->path = NULL;
+			goto error;
+		}
+		if (!guard->path) {
+			ret = -ENODEV;
+			goto error;
+		}
+	}
+	/* Protect the D0 boot image even if the status provider is deferred. */
+	ret = soccp_vote(guard);
+	if (ret)
+		goto error;
+	if (!guard->tcsr) {
+		guard->tcsr = syscon_regmap_lookup_by_phandle_args(dev->of_node,
+								   "qcom,soccp-dstate",
+								   1, &guard->offset);
+		if (IS_ERR(guard->tcsr)) {
+			ret = PTR_ERR(guard->tcsr);
+			guard->tcsr = NULL;
+			goto error;
+		}
+	}
+	guard->started = false;
+	guard->shutdown = false;
+	*result = guard;
+	goto out;
+error:
+	guard->error = ret;
+out:
+	mutex_unlock(&soccp_lock);
+	return ret;
+}
+
+static int soccp_begin(struct soccp_guard *guard)
+{
+	int ret = 0;
+
+	if (!guard)
+		return 0;
+	mutex_lock(&soccp_lock);
+	if (soccp_frozen || guard->busy) {
+		ret = -EBUSY;
+		goto out;
+	}
+	ret = soccp_vote(guard);
+	if (ret)
+		goto out;
+	guard->busy = true;
+	guard->started = false;
+	guard->shutdown = false;
+	guard->accepting_handover = false;
+	guard->handover_generation = 0;
+	guard->generation++;
+out:
+	mutex_unlock(&soccp_lock);
+	return ret;
+}
+
+static void soccp_finish(struct soccp_guard *guard, bool started, bool shutdown)
+{
+	if (!guard)
+		return;
+	mutex_lock(&soccp_lock);
+	guard->busy = false;
+	guard->started = started;
+	guard->shutdown = shutdown;
+	guard->accepting_handover = started;
+	/* Failure to prove safety keeps both the path and its vote owned. */
+	soccp_release(guard);
+	mutex_unlock(&soccp_lock);
+}
+
+static int soccp_reconcile(struct soccp_guard *guard);
+
+static int soccp_pm_notify(struct notifier_block *nb, unsigned long event, void *unused)
+{
+	struct soccp_guard *guard;
+	int ret = 0;
+
+	mutex_lock(&soccp_lock);
+	switch (event) {
+	case PM_HIBERNATION_PREPARE:
+	case PM_RESTORE_PREPARE:
+		/* Remote firmware/image restoration is not implemented here. */
+		ret = list_empty(&soccp_guards) && !soccp_registry_incomplete ? 0 :
+			-EOPNOTSUPP;
+		break;
+	case PM_SUSPEND_PREPARE:
+		/* Freeze first, under the same lock used by every new transition. */
+		soccp_frozen = true;
+		if (soccp_registry_incomplete)
+			ret = -ENODEV;
+		list_for_each_entry(guard, &soccp_guards, list) {
+			/* .start returns before the core's final subdevice start and
+			 * RUNNING publication. Do not freeze a half-started rproc.
+			 */
+			if (!ret && !guard->shutdown &&
+			    (!guard->rproc || READ_ONCE(guard->rproc->state) != RPROC_RUNNING))
+				ret = -EBUSY;
+			if (!ret)
+				ret = soccp_reconcile(guard);
+		}
+		/* Robust notifier rollback need not call the failing callback. */
+		if (ret)
+			soccp_frozen = false;
+		break;
+	case PM_POST_SUSPEND:
+	case PM_POST_HIBERNATION:
+	case PM_POST_RESTORE:
+		soccp_frozen = false;
+		break;
+	}
+	mutex_unlock(&soccp_lock);
+	return notifier_from_errno(ret);
+}
+
+static struct notifier_block soccp_pm_notifier = {
+	.notifier_call = soccp_pm_notify,
+};
+
+static int qcom_pas_soccp_prepare(struct rproc *rproc)
+{
+	struct qcom_pas *pas = rproc->priv;
+
+	return soccp_begin(pas->soccp);
+}
