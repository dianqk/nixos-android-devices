+		ret = register_pm_notifier(&soccp_pm_notifier);
+		if (ret)
+			return ret;
+		mutex_lock(&soccp_lock);
+		for_each_compatible_node(node, NULL, SOCCP_COMPAT) {
+			if (!of_device_is_available(node))
+				continue;
+			guard = kzalloc_obj(*guard);
+			if (!guard) {
+				soccp_registry_incomplete = true;
+				continue;
+			}
+			guard->node = of_node_get(node);
+			list_add_tail(&guard->list, &soccp_guards);
+		}
+		mutex_unlock(&soccp_lock);
+		debugfs_create_file("qcom_soccp_boot_guard", 0400, NULL, NULL,
+				    &soccp_guard_fops);
+	}
