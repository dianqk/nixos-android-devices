+static int __init qcom_pas_init(void)
+{
+	struct device_node *node;
+	struct soccp_guard *guard;
+	int ret;
+
+	if (!IS_MODULE(CONFIG_QCOM_Q6V5_PAS)) {
+		/* Register first: even a later allocation/registration failure must
+		 * leave enabled but unowned boot firmware blocking system sleep.
