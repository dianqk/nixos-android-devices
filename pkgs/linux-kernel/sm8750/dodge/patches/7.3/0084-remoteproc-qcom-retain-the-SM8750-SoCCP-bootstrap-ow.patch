+	clk_disable_unprepare(pas->xo);
+	qcom_pas_pds_disable(pas, pas->proxy_pds, pas->proxy_pd_count);
+}
+
+/* soccp_lock held. Reconcile BOTH bootstrap and actual proxy ownership. */
+static int soccp_reconcile(struct soccp_guard *guard)
+{
+	struct qcom_pas *pas;
+	int ret;
+
+	ret = soccp_release(guard);
+	if (ret || guard->shutdown)
+		return ret;
+	if (!guard->rproc || !guard->proxy_acquired)
+		return -EBUSY;
+	pas = guard->rproc->priv;
+	if (!guard->proxy_released) {
+		qcom_pas_proxy_handover(pas);
+		guard->proxy_released = true;
+	}
+	return 0;
+}
