diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 5c52007f9c..18ca92ddf0 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -299,6 +299,16 @@ config VIDEO_IMX471
 	  To compile this driver as a module, choose M here: the
 	  module will be called imx471.
 
+config VIDEO_IMX615
+	tristate "Sony IMX615 sensor support"
+	depends on I2C && VIDEO_DEV && COMMON_CLK
+	select V4L2_CCI_I2C
+	select V4L2_FWNODE
+	select VIDEO_V4L2_SUBDEV_API
+	help
+	  Sony IMX615 RAW10 image sensor with four-lane MIPI CSI-2 D-PHY.
+	  The initial mode is 1640x1232 with a 19.2 MHz input clock.
+
 config VIDEO_IMX678
 	tristate "Sony IMX678 sensor support"
 	depends on GPIOLIB
