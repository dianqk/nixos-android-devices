+// SPDX-License-Identifier: GPL-2.0-only
+/* Sony IMX615 RAW10 sensor. Initial mode: 1640x1232, four D-PHY lanes.
+ * Register sequences and power timing: OnePlus 13 dodgefront sensor module.
+ * See imx615-regs.h for the source identity.
+ */
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+#include "imx615-regs.h"
+
+#define IMX615_WIDTH 1640
+#define IMX615_HEIGHT 1232
+#define IMX615_LINE_LENGTH 2248
+#define IMX615_FRAME_LENGTH 4212
+#define IMX615_MARGIN 48
+#define IMX615_XCLK 19200000
+#define IMX615_LINK_FREQ 355200000LL
+#define IMX615_PIXEL_RATE 284160000
+
+struct imx615 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *xclk;
+	struct gpio_desc *reset;
+	struct regulator *vdda, *vddio, *vddd;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *exposure;
+	struct mutex lock;
+	bool streaming;
+};
+
+static const s64 imx615_link_freq[] = { IMX615_LINK_FREQ };
+static const char * const imx615_patterns[] = { "Disabled", "Solid colour" };
+
+static struct imx615 *to_imx615(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct imx615, sd);
+}
+
+static int imx615_power_on(struct device *dev)
+{
+	struct imx615 *s = to_imx615(dev_get_drvdata(dev));
+	int ret;
+
+	/* VANA -> VIO, 3 ms -> VDIG -> MCLK, 1 ms -> RESET, 3 ms. */
+	ret = regulator_enable(s->vdda);
+	if (ret)
+		return ret;
+	ret = regulator_enable(s->vddio);
+	if (ret)
+		goto disable_analog;
+	fsleep(3000);
+	ret = regulator_enable(s->vddd);
+	if (ret)
+		goto disable_io;
+	ret = clk_prepare_enable(s->xclk);
+	if (ret)
+		goto disable_digital;
+	fsleep(1000);
+	gpiod_set_value_cansleep(s->reset, 0);
+	fsleep(3000);
+	return 0;
+
+disable_digital:
+	regulator_disable(s->vddd);
+disable_io:
+	regulator_disable(s->vddio);
+disable_analog:
+	regulator_disable(s->vdda);
+	return ret;
+}
+
+static int imx615_power_off(struct device *dev)
+{
+	struct imx615 *s = to_imx615(dev_get_drvdata(dev));
+
+	clk_disable_unprepare(s->xclk);
+	fsleep(1000);
+	gpiod_set_value_cansleep(s->reset, 1);
+	fsleep(3000);
+	regulator_disable(s->vddd);
+	regulator_disable(s->vddio);
+	regulator_disable(s->vdda);
+	return 0;
+}
+
+static int imx615_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct imx615 *s = container_of(ctrl->handler, struct imx615, ctrls);
+	int ret = 0, err;
+
+	if (ctrl->id == V4L2_CID_VBLANK)
+		__v4l2_ctrl_modify_range(s->exposure, 1,
+			IMX615_HEIGHT + ctrl->val - IMX615_MARGIN, 1,
+			min(1000, IMX615_HEIGHT + ctrl->val - IMX615_MARGIN));
+
+	ret = pm_runtime_get_if_in_use(s->dev);
+	if (ret <= 0)
+		return ret;
+	ret = 0;
+
+	/* Commit multi-byte exposure/gain/frame length under group hold. */
+	cci_write(s->regmap, CCI_REG8(0x0104), 1, &ret);
+	switch (ctrl->id) {
+	case V4L2_CID_VBLANK:
+		cci_write(s->regmap, CCI_REG16(0x0340),
+			  IMX615_HEIGHT + ctrl->val, &ret);
+		break;
+	case V4L2_CID_EXPOSURE:
+		cci_write(s->regmap, CCI_REG16(0x0202), ctrl->val, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		cci_write(s->regmap, CCI_REG16(0x0204), ctrl->val, &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		cci_write(s->regmap, CCI_REG16(0x0600), ctrl->val, &ret);
+		break;
+	default:
+		ret = -EINVAL;
+	}
+	/* Release hold even if an earlier I2C transaction failed. */
+	err = cci_write(s->regmap, CCI_REG8(0x0104), 0, NULL);
+	if (!ret)
+		ret = err;
+	pm_runtime_put(s->dev);
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops imx615_ctrl_ops = {
+	.s_ctrl = imx615_set_ctrl,
+};
+
+static void imx615_format(struct v4l2_mbus_framefmt *fmt)
+{
+	*fmt = (struct v4l2_mbus_framefmt) {
+		.width = IMX615_WIDTH, .height = IMX615_HEIGHT,
+		.code = MEDIA_BUS_FMT_SRGGB10_1X10,
+		.field = V4L2_FIELD_NONE,
+		.colorspace = V4L2_COLORSPACE_RAW,
+		.ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT,
+		.quantization = V4L2_QUANTIZATION_FULL_RANGE,
+		.xfer_func = V4L2_XFER_FUNC_NONE,
+	};
+}
+
+static int imx615_init_state(struct v4l2_subdev *sd,
+			      struct v4l2_subdev_state *state)
+{
+	imx615_format(v4l2_subdev_state_get_format(state, 0));
+	return 0;
+}
+
+static int imx615_enum_code(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state,
+			     struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+	code->code = MEDIA_BUS_FMT_SRGGB10_1X10;
+	return 0;
+}
+
+static int imx615_enum_size(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state,
+			     struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index || fse->code != MEDIA_BUS_FMT_SRGGB10_1X10)
+		return -EINVAL;
+	fse->min_width = fse->max_width = IMX615_WIDTH;
+	fse->min_height = fse->max_height = IMX615_HEIGHT;
+	return 0;
+}
+
+static int imx615_set_format(struct v4l2_subdev *sd,
+			      struct v4l2_subdev_state *state,
+			      struct v4l2_subdev_format *fmt)
+{
+	struct imx615 *s = to_imx615(sd);
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE && s->streaming)
+		return -EBUSY;
+	imx615_format(&fmt->format);
+	*v4l2_subdev_state_get_format(state, fmt->pad) = fmt->format;
+	return 0;
+}
+
+static int imx615_get_selection(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP:
+		sel->r = (struct v4l2_rect) { .width = 6560, .height = 4928 };
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int imx615_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct imx615 *s = to_imx615(sd);
+	int ret = 0;
+
+	mutex_lock(&s->lock);
+	if (s->streaming == !!enable)
+		goto unlock;
+	if (!enable) {
+		ret = cci_write(s->regmap, CCI_REG8(0x0100), 0, NULL);
+		s->streaming = false;
+		pm_runtime_mark_last_busy(s->dev);
+		pm_runtime_put_autosuspend(s->dev);
+		goto unlock;
+	}
+	ret = pm_runtime_resume_and_get(s->dev);
+	if (ret)
+		goto unlock;
+	ret = cci_multi_reg_write(s->regmap, imx615_init_regs,
+				ARRAY_SIZE(imx615_init_regs), NULL);
+	if (ret)
+		goto power_off;
+	ret = cci_multi_reg_write(s->regmap, imx615_mode_regs,
+				ARRAY_SIZE(imx615_mode_regs), NULL);
+	if (ret)
+		goto power_off;
+	ret = __v4l2_ctrl_handler_setup(&s->ctrls);
+	if (ret)
+		goto power_off;
+	ret = cci_write(s->regmap, CCI_REG8(0x0100), 1, NULL);
+	if (ret)
+		goto power_off;
+	fsleep(5);
+	s->streaming = true;
+	goto unlock;
+
+power_off:
+	cci_write(s->regmap, CCI_REG8(0x0100), 0, NULL);
+	pm_runtime_put(s->dev);
+unlock:
+	mutex_unlock(&s->lock);
+	return ret;
+}
+
+static const struct v4l2_subdev_video_ops imx615_video_ops = {
+	.s_stream = imx615_stream,
+};
+static const struct v4l2_subdev_pad_ops imx615_pad_ops = {
+	.enum_mbus_code = imx615_enum_code,
+	.enum_frame_size = imx615_enum_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = imx615_set_format,
+	.get_selection = imx615_get_selection,
+};
+static const struct v4l2_subdev_ops imx615_ops = {
+	.video = &imx615_video_ops,
+	.pad = &imx615_pad_ops,
+};
+static const struct v4l2_subdev_internal_ops imx615_internal_ops = {
+	.init_state = imx615_init_state,
+};
+
+static int imx615_hwcfg(struct device *dev)
+{
+	struct v4l2_fwnode_endpoint ep = { .bus_type = V4L2_MBUS_CSI2_DPHY };
+	struct fwnode_handle *node;
+	bool freq_found = false;
+	unsigned int i;
+	int ret;
+
+	node = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!node)
+		return -EINVAL;
+	ret = v4l2_fwnode_endpoint_alloc_parse(node, &ep);
+	fwnode_handle_put(node);
+	if (ret)
+		return ret;
+	for (i = 0; i < ep.nr_of_link_frequencies; i++)
+		freq_found |= ep.link_frequencies[i] == IMX615_LINK_FREQ;
+	if (ep.bus.mipi_csi2.num_data_lanes != 4 || !freq_found)
+		ret = -EINVAL;
+	v4l2_fwnode_endpoint_free(&ep);
+	return ret;
+}
+
+static int imx615_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct v4l2_ctrl *ctrl;
+	struct imx615 *s;
+	u64 id;
+	int ret;
+
+	ret = imx615_hwcfg(dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "invalid four-lane D-PHY endpoint\n");
+	s = devm_kzalloc(dev, sizeof(*s), GFP_KERNEL);
+	if (!s)
+		return -ENOMEM;
+	s->dev = dev;
+	s->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(s->regmap))
+		return PTR_ERR(s->regmap);
+	s->xclk = devm_clk_get(dev, NULL);
+	if (IS_ERR(s->xclk))
+		return dev_err_probe(dev, PTR_ERR(s->xclk), "clock unavailable\n");
+	if (clk_get_rate(s->xclk) != IMX615_XCLK)
+		return dev_err_probe(dev, -EINVAL, "clock must be 19.2 MHz\n");
+	s->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(s->reset))
+		return dev_err_probe(dev, PTR_ERR(s->reset), "reset unavailable\n");
+	s->vdda = devm_regulator_get(dev, "vdda");
+	if (IS_ERR(s->vdda))
+		return dev_err_probe(dev, PTR_ERR(s->vdda), "analog supply unavailable\n");
+	s->vddio = devm_regulator_get(dev, "vddio");
+	if (IS_ERR(s->vddio))
+		return dev_err_probe(dev, PTR_ERR(s->vddio), "I/O supply unavailable\n");
+	s->vddd = devm_regulator_get(dev, "vddd");
+	if (IS_ERR(s->vddd))
+		return dev_err_probe(dev, PTR_ERR(s->vddd), "digital supply unavailable\n");
+
+	mutex_init(&s->lock);
+	v4l2_i2c_subdev_init(&s->sd, client, &imx615_ops);
+	s->sd.internal_ops = &imx615_internal_ops;
+	s->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	s->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&s->sd.entity, 1, &s->pad);
+	if (ret)
+		goto destroy_mutex;
+	v4l2_ctrl_handler_init(&s->ctrls, 8);
+	s->ctrls.lock = &s->lock;
+	ctrl = v4l2_ctrl_new_int_menu(&s->ctrls, NULL, V4L2_CID_LINK_FREQ,
+				    0, 0, imx615_link_freq);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	v4l2_ctrl_new_std(&s->ctrls, NULL, V4L2_CID_PIXEL_RATE,
+			 IMX615_PIXEL_RATE, IMX615_PIXEL_RATE, 1, IMX615_PIXEL_RATE);
+	ctrl = v4l2_ctrl_new_std(&s->ctrls, NULL, V4L2_CID_HBLANK,
+			       IMX615_LINE_LENGTH - IMX615_WIDTH,
+			       IMX615_LINE_LENGTH - IMX615_WIDTH, 1,
+			       IMX615_LINE_LENGTH - IMX615_WIDTH);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	v4l2_ctrl_new_std(&s->ctrls, &imx615_ctrl_ops, V4L2_CID_VBLANK,
+			 IMX615_FRAME_LENGTH - IMX615_HEIGHT, 0xffff - IMX615_HEIGHT,
+			 1, IMX615_FRAME_LENGTH - IMX615_HEIGHT);
+	s->exposure = v4l2_ctrl_new_std(&s->ctrls, &imx615_ctrl_ops,
+			V4L2_CID_EXPOSURE, 1, IMX615_FRAME_LENGTH - IMX615_MARGIN,
+			1, 1000);
+	v4l2_ctrl_new_std(&s->ctrls, &imx615_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			 0, 896, 1, 0);
+	v4l2_ctrl_new_std_menu_items(&s->ctrls, &imx615_ctrl_ops,
+			V4L2_CID_TEST_PATTERN, ARRAY_SIZE(imx615_patterns) - 1,
+			0, 0, imx615_patterns);
+	ret = s->ctrls.error;
+	if (ret)
+		goto free_controls;
+	s->sd.ctrl_handler = &s->ctrls;
+	s->sd.state_lock = &s->lock;
+	ret = v4l2_subdev_init_finalize(&s->sd);
+	if (ret)
+		goto free_controls;
+	ret = imx615_power_on(dev);
+	if (ret)
+		goto cleanup_subdev;
+	ret = cci_read(s->regmap, CCI_REG16(0x0016), &id, NULL);
+	if (ret)
+		goto power_off;
+	if (id != 0x0615) {
+		ret = dev_err_probe(dev, -ENODEV, "unexpected chip ID 0x%04llx\n", id);
+		goto power_off;
+	}
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	ret = v4l2_async_register_subdev_sensor(&s->sd);
+	if (ret)
+		goto disable_pm;
+	pm_runtime_mark_last_busy(dev);
+	pm_runtime_put_autosuspend(dev);
+	dev_info(dev, "IMX615 detected, four-lane 1640x1232 RAW10\n");
+	return 0;
+
+disable_pm:
+	pm_runtime_disable(dev);
+	pm_runtime_put_noidle(dev);
+	pm_runtime_set_suspended(dev);
+power_off:
+	imx615_power_off(dev);
+cleanup_subdev:
+	v4l2_subdev_cleanup(&s->sd);
+free_controls:
+	v4l2_ctrl_handler_free(&s->ctrls);
+	media_entity_cleanup(&s->sd.entity);
+destroy_mutex:
+	mutex_destroy(&s->lock);
+	return ret;
+}
+
+static void imx615_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx615 *s = to_imx615(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	mutex_lock(&s->lock);
+	if (s->streaming) {
+		cci_write(s->regmap, CCI_REG8(0x0100), 0, NULL);
+		s->streaming = false;
+		pm_runtime_put_noidle(s->dev);
+	}
+	mutex_unlock(&s->lock);
+	pm_runtime_disable(s->dev);
+	if (!pm_runtime_status_suspended(s->dev))
+		imx615_power_off(s->dev);
+	pm_runtime_set_suspended(s->dev);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&s->ctrls);
+	mutex_destroy(&s->lock);
+}
+
+static const struct dev_pm_ops imx615_pm_ops = {
+	SET_RUNTIME_PM_OPS(imx615_power_off, imx615_power_on, NULL)
+};
+static const struct of_device_id imx615_of_match[] = {
+	{ .compatible = "sony,imx615" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, imx615_of_match);
+static struct i2c_driver imx615_driver = {
+	.driver = {
+		.name = "imx615",
+		.of_match_table = imx615_of_match,
+		.pm = pm_ptr(&imx615_pm_ops),
+	},
+	.probe = imx615_probe,
+	.remove = imx615_remove,
+};
+module_i2c_driver(imx615_driver);
+MODULE_DESCRIPTION("Sony IMX615 image sensor driver");
+MODULE_LICENSE("GPL");
