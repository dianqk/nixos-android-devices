From 429af7db35e416bba877ad5cb9c1db47481547a9 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Sun, 8 Nov 2026 03:08:14 +0800
Subject: [PATCH 025/144] arm64: dts: qcom: leave Dodge ADSP audio GPR disabled

The available ADSP firmware supports the charger service, but the audio topology is not integrated. Keep its distinct GPR audio child disabled to avoid audio initialization timeouts while retaining GLINK QRTR/PDR battery management.

Import-Patch: pkgs/linux-kernel/sm8750/dodge/patches/7.3/0043-arm64-dts-qcom-leave-Dodge-ADSP-audio-GPR-disabled.patch
Import-SHA256: 8efaf79f88c5647a150a9532287f09608ef3973662d42ba1aaab920d47a4f3f2
Import-Provenance: mail headers
(cherry picked from commit 351ef541e668739f8e0ac52d72e978bdcc1b6ebe)
---
 arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts b/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
index 210ce6f97e..da0f1b0d9d 100644
--- a/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
+++ b/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
@@ -760,6 +760,13 @@ &remoteproc_adsp {
 	firmware-name = "qcom/sm8750/oneplus/dodge/adsp.mdt",
 			"qcom/sm8750/oneplus/dodge/adsp_dtb.mdt";
 	status = "okay";
+
+	glink-edge {
+		/* Charging uses QRTR/PDR; the audio GPR topology is not available. */
+		gpr {
+			status = "disabled";
+		};
+	};
 };
 
 /* The shipping ADSP image occupies the complete Android carveout. */
