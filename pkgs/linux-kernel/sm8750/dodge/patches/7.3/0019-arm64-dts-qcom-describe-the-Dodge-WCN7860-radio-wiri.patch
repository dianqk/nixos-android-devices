From 4aedae0d239c7a6fa64f295a68777151cf933e2c Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Sat, 7 Nov 2026 14:23:20 +0800
Subject: [PATCH 019/144] arm64: dts: qcom: describe the Dodge WCN7860 radio
 wiring

Add the WCN7860 board wiring, voltage/wake constraints and Bluetooth UART alias together.

Consolidated from local follow-ups:
  1fd6140475020aad3c2dfe8f062f23c0f2f8aad1 arm64: dts: qcom: describe Dodge WCN7860 board wiring
  1c497b9bbb74dbaab04b71cdc1b3fc3a5d1c04ad arm64: dts: qcom: align Dodge radio voltage and wake constraints
  cde710ca244338a83ab02b6b8501c193ba340908 arm64: dts: qcom: give Dodge Bluetooth UART a serial alias
---
 .../boot/dts/qcom/sm8750-oneplus-dodge.dts    | 204 ++++++++++++++++++
 1 file changed, 204 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts b/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
index 5fad8fabba..7f13c79e58 100644
--- a/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
+++ b/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
@@ -19,6 +19,10 @@ / {
 	compatible = "oneplus,dodge", "qcom,sm8750";
 	chassis-type = "handset";
 
+	aliases {
+		serial0 = &uart14;
+	};
+
 	chosen {
 		#address-cells = <2>;
 		#size-cells = <2>;
@@ -102,6 +106,66 @@ ramoops@880000000 {
 		};
 	};
 
+	wcn7860-pmu {
+		compatible = "qcom,wcn7860-pmu";
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&wlan_enable>, <&bluetooth_enable>;
+		wlan-enable-gpios = <&tlmm 16 GPIO_ACTIVE_HIGH>;
+		bt-enable-gpios = <&pm8550ve_gpios 3 GPIO_ACTIVE_HIGH>;
+
+		/* Shared inputs, named by their WLAN-side power domains. */
+		vddaon-supply = <&vreg_s4d_0p87>;
+		vdddig-supply = <&vreg_s5f_0p87>;
+		vddrfa1p2-supply = <&vreg_s7i_1p2>;
+		vddrfa1p8-supply = <&vreg_s3g_1p8>;
+		vddio1p2-supply = <&vreg_l2f_1p2>;
+		vddio-supply = <&vreg_l3f_1p8>;
+		clocks = <&rpmhcc RPMH_RF_CLK1>;
+
+		regulators {
+			vreg_wcn_rfa_cmn: ldo0 {
+				regulator-name = "vreg_wcn_rfa_cmn";
+			};
+
+			vreg_wcn_aon: ldo1 {
+				regulator-name = "vreg_wcn_aon";
+			};
+
+			vreg_wcn_wlcx: ldo2 {
+				regulator-name = "vreg_wcn_wlcx";
+			};
+
+			vreg_wcn_wlmx: ldo3 {
+				regulator-name = "vreg_wcn_wlmx";
+			};
+
+			vreg_wcn_btcmx: ldo4 {
+				regulator-name = "vreg_wcn_btcmx";
+			};
+
+			vreg_wcn_rfa_0p8: ldo5 {
+				regulator-name = "vreg_wcn_rfa_0p8";
+			};
+
+			vreg_wcn_rfa_1p2: ldo6 {
+				regulator-name = "vreg_wcn_rfa_1p2";
+			};
+
+			vreg_wcn_rfa_1p8: ldo7 {
+				regulator-name = "vreg_wcn_rfa_1p8";
+			};
+
+			vreg_wcn_pcie_0p9: ldo8 {
+				regulator-name = "vreg_wcn_pcie_0p9";
+			};
+
+			vreg_wcn_pcie_1p8: ldo9 {
+				regulator-name = "vreg_wcn_pcie_1p8";
+			};
+		};
+	};
+
 	vph_pwr: vph-pwr-regulator {
 		compatible = "regulator-fixed";
 
@@ -207,6 +271,7 @@ regulators-1 {
 		compatible = "qcom,pm8550ve-rpmh-regulators";
 		qcom,pmic-id = "d";
 		vdd-s1-supply = <&vph_pwr>;
+		vdd-s4-supply = <&vph_pwr>;
 		vdd-l1-supply = <&vreg_s7i_1p2>;
 		vdd-l2-supply = <&vreg_s1d_0p97>;
 
@@ -217,6 +282,13 @@ vreg_s1d_0p97: smps1 {
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 		};
 
+		vreg_s4d_0p87: smps4 {
+			regulator-name = "vreg_s4d_0p87";
+			regulator-min-microvolt = <876000>;
+			regulator-max-microvolt = <1036000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
 		vreg_l1d_1p2: ldo1 {
 			regulator-name = "vreg_l1d_1p2";
 			regulator-min-microvolt = <1200000>;
@@ -238,6 +310,43 @@ vreg_l2d_0p88: ldo2 {
 		};
 	};
 
+	regulators-2 {
+		compatible = "qcom,pm8550ve-rpmh-regulators";
+		qcom,pmic-id = "f";
+		vdd-s5-supply = <&vph_pwr>;
+		vdd-l1-supply = <&vreg_s1d_0p97>;
+		vdd-l2-supply = <&vreg_s7i_1p2>;
+		vdd-l3-supply = <&vreg_s3g_1p8>;
+
+		vreg_s5f_0p87: smps5 {
+			regulator-name = "vreg_s5f_0p87";
+			regulator-min-microvolt = <876000>;
+			regulator-max-microvolt = <1000000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l1f_0p88: ldo1 {
+			regulator-name = "vreg_l1f_0p88";
+			regulator-min-microvolt = <880000>;
+			regulator-max-microvolt = <920000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l2f_1p2: ldo2 {
+			regulator-name = "vreg_l2f_1p2";
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1200000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l3f_1p8: ldo3 {
+			regulator-name = "vreg_l3f_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+	};
+
 	regulators-3 {
 		compatible = "qcom,pm8550ve-rpmh-regulators";
 		qcom,pmic-id = "g";
@@ -306,6 +415,60 @@ vreg_l1j_0p91: ldo1 {
 	};
 };
 
+&pcie0 {
+	pinctrl-0 = <&pcie0_default_state>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
+&pcie0_phy {
+	vdda-phy-supply = <&vreg_l1f_0p88>;
+	vdda-pll-supply = <&vreg_l3g_1p2>;
+	status = "okay";
+};
+
+&pcieport0 {
+	wake-gpios = <&tlmm 104 GPIO_ACTIVE_LOW>;
+	reset-gpios = <&tlmm 102 GPIO_ACTIVE_LOW>;
+
+	wifi@0 {
+		compatible = "pci17cb,110e";
+		reg = <0x10000 0x0 0x0 0x0 0x0>;
+		vddrfacmn-supply = <&vreg_wcn_rfa_cmn>;
+		vddaon-supply = <&vreg_wcn_aon>;
+		vddwlcx-supply = <&vreg_wcn_wlcx>;
+		vddwlmx-supply = <&vreg_wcn_wlmx>;
+		vddrfa0p8-supply = <&vreg_wcn_rfa_0p8>;
+		vddrfa1p2-supply = <&vreg_wcn_rfa_1p2>;
+		vddrfa1p8-supply = <&vreg_wcn_rfa_1p8>;
+		vddpcie0p9-supply = <&vreg_wcn_pcie_0p9>;
+		vddpcie1p8-supply = <&vreg_wcn_pcie_1p8>;
+	};
+};
+
+&qupv3_2 {
+	status = "okay";
+};
+
+&uart14 {
+	pinctrl-0 = <&bluetooth_uart>;
+	pinctrl-names = "default";
+	status = "okay";
+
+	bluetooth {
+		compatible = "qcom,wcn7860-bt";
+		firmware-name = "brhbtnv20.bin", "brhbtfw20.mbn";
+		max-speed = <3200000>;
+		vddrfacmn-supply = <&vreg_wcn_rfa_cmn>;
+		vddaon-supply = <&vreg_wcn_aon>;
+		vddwlcx-supply = <&vreg_wcn_wlcx>;
+		vddwlmx-supply = <&vreg_wcn_wlmx>;
+		vddrfa0p8-supply = <&vreg_wcn_rfa_0p8>;
+		vddrfa1p2-supply = <&vreg_wcn_rfa_1p2>;
+		vddrfa1p8-supply = <&vreg_wcn_rfa_1p8>;
+	};
+};
+
 &pmih0108_eusb2_repeater {
 	vdd18-supply = <&vreg_l15b_1p8>;
 	vdd3-supply = <&vreg_l5b_3p1>;
@@ -446,6 +609,47 @@ &mdss_dsi0_phy {
 	status = "okay";
 };
 
+&pm8550ve_gpios {
+	bluetooth_enable: bluetooth-enable-state {
+		pins = "gpio3";
+		function = "normal";
+		power-source = <1>;
+		bias-disable;
+	};
+};
+
+&tlmm {
+	bluetooth_uart: bluetooth-uart-state {
+		cts-rx-pins {
+			pins = "gpio24", "gpio27";
+			function = "qup2_se6";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		rts-pins {
+			pins = "gpio25";
+			function = "qup2_se6";
+			drive-strength = <2>;
+			bias-pull-down;
+		};
+
+		tx-pins {
+			pins = "gpio26";
+			function = "qup2_se6";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+	};
+
+	wlan_enable: wlan-enable-state {
+		pins = "gpio16";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-down;
+	};
+};
+
 &ufs_mem_hc {
 	reset-gpios = <&tlmm 215 GPIO_ACTIVE_LOW>;
 
