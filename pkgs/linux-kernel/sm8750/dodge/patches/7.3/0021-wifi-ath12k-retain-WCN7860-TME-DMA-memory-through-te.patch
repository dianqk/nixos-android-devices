+/* Keep the firmware's DMA mapping alive across QMI restarts and responses. */
+static void ath12k_qmi_tme_lite_free(struct ath12k_base *ab)
+{
+	struct ath12k_qmi_tme_mem *mem = &ab->qmi.tme_mem;
+
+	if (!mem->vaddr)
+		return;
+
+	dma_free_coherent(ab->dev, mem->alloc_size, mem->vaddr, mem->paddr);
+	memset(mem, 0, sizeof(*mem));
+}
