From 6282c5b4d787886e766ee9e585d07f063538b575 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Sat, 7 Nov 2026 13:16:54 +0800
Subject: [PATCH 016/144] wifi: ath12k: scope QDSS configuration loading to
 WCN7860

Only WCN7860 has been established to require this firmware configuration download. Keep existing startup behavior for other hardware whose feature bitmap also omits CNSS_QDSS_CFG_MISS_V01.

Link: https://github.com/Xlie-Electronic-Customs/linux/commit/27fbb1cbed22a89661be86f04e12a0ab21c7e746
(cherry picked from commit ce7dc4ab5deaaa42af291dbaa713b35d371fca0b)
(cherry picked from commit 658c64cc50daf76e6941bb9f3dea84d67ffa4f1c)

Import-Patch: pkgs/linux-kernel/sm8750/dodge/patches/7.3/0027-wifi-ath12k-scope-QDSS-configuration-loading-to-WCN7.patch
Import-SHA256: a3a6c8ca4d5205e472aa07e40d3cf00d9e94098915c6bf128216b4ddb0d5ad0c
Import-Provenance: mail headers
(cherry picked from commit 2adca780db527d6fef266c4377788bf0dc838da0)
---
 drivers/net/wireless/ath/ath12k/qmi.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/drivers/net/wireless/ath/ath12k/qmi.c b/drivers/net/wireless/ath/ath12k/qmi.c
index 8c7c1936f1..785dab2316 100644
--- a/drivers/net/wireless/ath/ath12k/qmi.c
+++ b/drivers/net/wireless/ath/ath12k/qmi.c
@@ -4030,12 +4030,13 @@ int ath12k_qmi_event_load_bdf(struct ath12k_qmi *qmi)
 		}
 	}
 
-	if (!(hw_params->qmi_cnss_feature_bitmap & BIT(CNSS_QDSS_CFG_MISS_V01))) {
+	if (ab->hw_rev == ATH12K_HW_WCN7860_HW20 &&
+	    !(hw_params->qmi_cnss_feature_bitmap & BIT(CNSS_QDSS_CFG_MISS_V01))) {
 		ret = ath12k_qmi_wlanfw_qdss_dnld_send(ab);
 		if (ret < 0) {
 			ath12k_warn(ab, "qmi failed to send qdss info req: %d\n", ret);
 			return ret;
-		}		
+		}
 	}
 
 	return ret;
