+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/sony,imx615.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Sony IMX615 CMOS image sensor
+
+maintainers:
+  - dianqk <dianqk@dianqk.net>
+
+description:
+  The IMX615 is a CMOS image sensor with a four-lane MIPI CSI-2 D-PHY output.
+  A 19.2 MHz input clock is supported.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: sony,imx615
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  reset-gpios:
+    maxItems: 1
+    description: Active-low sensor reset.
+
+  vdda-supply:
+    description: Analog power supply (2.9 V).
+
+  vddio-supply:
+    description: I/O power supply (1.8 V).
+
+  vddd-supply:
+    description: Digital power supply (1.1 V).
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          bus-type:
+            const: 4
+
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+              - const: 3
+              - const: 4
+
+          link-frequencies:
+            items:
+              - const: 355200000
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+    required:
+      - endpoint
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - reset-gpios
+  - vdda-supply
+  - vddio-supply
+  - vddd-supply
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@10 {
+            compatible = "sony,imx615";
+            reg = <0x10>;
+            clocks = <&camera_mclk4>;
+            reset-gpios = <&gpio 7 GPIO_ACTIVE_LOW>;
+            vdda-supply = <&camera_analog>;
+            vddio-supply = <&camera_io>;
+            vddd-supply = <&camera_digital>;
+
+            port {
+                endpoint {
+                    data-lanes = <1 2 3 4>;
+                    link-frequencies = /bits/ 64 <355200000>;
+                    remote-endpoint = <&csi_in>;
+                };
+            };
+        };
+    };
