+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/qcom,sm8750-camera-aon-mux.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm SM8750 camera and always-on camera ownership selector
+
+maintainers:
+  - dianqk <dianqk@dianqk.net>
+
+description:
+  CPAS selects the owner of the shared camera MCLK and CSI connection. The
+  output clock represents main-camera ownership of the selected MCLK. Its
+  parent is the corresponding camera BIST MCLK output.
+
+properties:
+  compatible:
+    const: qcom,sm8750-camera-aon-mux
+
+  reg:
+    maxItems: 1
+    description: One camera/AON selection register.
+
+  clocks:
+    items:
+      - description: Camera BIST MCLK output.
+      - description: Camera top AHB clock.
+      - description: Camera top fast AHB clock.
+
+  clock-names:
+    items:
+      - const: mclk
+      - const: ahb
+      - const: fast-ahb
+
+  power-domains:
+    maxItems: 1
+
+  "#clock-cells":
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - power-domains
+  - "#clock-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    clock-controller@ac041e0 {
+        compatible = "qcom,sm8750-camera-aon-mux";
+        reg = <0x0ac041e0 0x4>;
+        clocks = <&cam_bist_mclk4>, <&camera_ahb>, <&camera_fast_ahb>;
+        clock-names = "mclk", "ahb", "fast-ahb";
+        power-domains = <&camera_top>;
+        #clock-cells = <0>;
+    };
