 	return ret ?: nu1669_live(rx, generation);
 }
 
+/* Fresh post-setup evidence; a reset without a GPIO edge must stop the consumer. */
+static int nu1669_bpp_verify(struct nu1669 *rx, u32 generation, u8 *before)
+{
+	u8 first[NU1669_FOD_SHADOW_SIZE], second[NU1669_FOD_SHADOW_SIZE];
+	u8 after[NU1669_INFO_SIZE];
+	int ret;
+
+	ret = regmap_bulk_read(rx->regmap, NU1669_FOD_SHADOW, first, sizeof(first));
+	if (!ret)
+		ret = nu1669_live(rx, generation);
+	if (!ret)
+		ret = regmap_bulk_read(rx->regmap, NU1669_FOD_SHADOW, second, sizeof(second));
+	if (!ret)
+		ret = nu1669_read_info(rx, generation, after);
+	if (!ret && (memcmp(first, second, sizeof(first)) || memcmp(before, after, 5) ||
+		     before[0x18] || after[0x18] || second[0] != 1 || second[1] != 12 ||
+		     memcmp(second + 3, rx->bpp_parameters, 40)))
+		ret = -EUCLEAN;
+	if (ret == -EUCLEAN) {
+		rx->bpp_quarantined = true;
+		atomic_set(&nu1669_bpp_uncertain, 1);
+	}
+	if (!ret)
+		memcpy(before, after, sizeof(after));
+	return ret;
+}
+
 int nu1669_get_snapshot(struct power_supply *psy, struct nu1669_snapshot *snapshot)
 {
 	struct nu1669 *rx;
@@ -228,8 +265,13 @@ int nu1669_get_snapshot(struct power_supply *psy, struct nu1669_snapshot *snapsh
 	ret = nu1669_read_info(rx, generation, info);
 	if (ret == -ECANCELED)
 		ret = READ_ONCE(rx->suspended) || READ_ONCE(rx->stopped) ? -EBUSY : -EAGAIN;
+	if (!ret && rx->bpp_prepared)
+		ret = nu1669_bpp_verify(rx, generation, info);
 	if (!ret) {
 		*snapshot = (struct nu1669_snapshot) {
+			.bpp_valid = rx->bpp_prepared && !rx->bpp_quarantined,
+			.flags = get_unaligned_le32(info + 0x20),
+			.iout_ma = get_unaligned_le16(info + 0x36),
 			.generation = generation,
 			.chip_id = get_unaligned_le16(info),
 			.vout_mv = get_unaligned_le16(info + 0x34),
@@ -246,6 +288,143 @@ int nu1669_get_snapshot(struct power_supply *psy, struct nu1669_snapshot *snapsh
 }
 EXPORT_SYMBOL_GPL(nu1669_get_snapshot);
 
+/* Caller holds lock. A partial setup stays quarantined for this driver lifetime. */
+static int nu1669_bpp_context(struct nu1669 *rx, u32 generation)
+{
+	u8 info[NU1669_INFO_SIZE];
+	u32 flags;
+	u16 mv;
+	int ret;
+
+	ret = nu1669_read_info(rx, generation, info);
+	if (ret)
+		return ret;
+	flags = get_unaligned_le32(info + 0x20);
+	mv = get_unaligned_le16(info + 0x34);
+	if (get_unaligned_le16(info) != 0x1669 || info[2] || info[3] != 4 ||
+	    info[4] != 0x6b || info[0x11] != 4 || info[0x44] ||
+	    (info[0x46] & BIT(0)) || mv < 4500 || mv > 6000)
+		return -EOPNOTSUPP;
+	return flags & NU1669_BPP_POWER_FAULTS ? -EIO : 0;
+}
+
+static int nu1669_bpp_idle(struct nu1669 *rx, u32 generation)
+{
+	unsigned int busy;
+	int i, ret;
+
+	for (i = 0; i < 30; i++) {
+		ret = nu1669_live(rx, generation);
+		if (ret)
+			return ret;
+		ret = regmap_read(rx->regmap, NU1669_BUSY, &busy);
+		if (ret)
+			return ret;
+		ret = nu1669_live(rx, generation);
+		if (ret || !busy)
+			return ret;
+		usleep_range(1000, 2000);
+	}
+	return -EBUSY;
+}
+
+/* Private whitelist: mag=0, length=40, four board-owned chunks, mode=1. */
+static int nu1669_bpp_write(struct nu1669 *rx, u32 generation, unsigned int step)
+{
+	static const u8 objects[] = { 0x18, 0xa1, 0xa3, 0xad, 0xb7, 0xc1, 0xa0 };
+	u8 value = step == 0 ? 0 : step == 1 ? 40 : 1;
+	const u8 *data;
+	size_t length;
+	int ret;
+
+	if (step >= ARRAY_SIZE(objects))
+		return -EINVAL;
+	data = step >= 2 && step <= 5 ? rx->bpp_parameters + (step - 2) * 10 : &value;
+	length = step >= 2 && step <= 5 ? 10 : 1;
+	ret = nu1669_bpp_context(rx, generation);
+	if (ret)
+		return ret;
+	ret = nu1669_bpp_idle(rx, generation);
+	if (ret)
+		return ret;
+	/* Even a failed reservation may have reached firmware. Never force-release. */
+	rx->bpp_quarantined = true;
+	atomic_set(&nu1669_bpp_uncertain, 1);
+	ret = regmap_write(rx->regmap, NU1669_BUSY, 1);
+	if (ret)
+		return ret;
+	ret = nu1669_live(rx, generation);
+	if (ret)
+		return ret;
+	ret = regmap_write(rx->regmap, 0, length);
+	if (ret)
+		return ret;
+	ret = nu1669_live(rx, generation);
+	if (ret)
+		return ret;
+	ret = regmap_bulk_write(rx->regmap, 1, data, length);
+	if (ret)
+		return ret;
+	ret = nu1669_bpp_context(rx, generation);
+	if (ret)
+		return ret;
+	ret = regmap_write(rx->regmap, 0x60, objects[step]);
+	return ret ?: nu1669_bpp_idle(rx, generation);
+}
+
+int nu1669_prepare_bpp(struct power_supply *psy, u32 generation)
+{
+	struct nu1669 *rx;
+	u8 first[NU1669_FOD_SHADOW_SIZE], second[NU1669_FOD_SHADOW_SIZE];
+	u8 info[NU1669_INFO_SIZE];
+	int ret, i;
+
+	if (!psy || psy->desc != &nu1669_psy_desc)
+		return -EOPNOTSUPP;
+	rx = power_supply_get_drvdata(psy);
+	mutex_lock(&rx->lock);
+	if (!rx->bpp_profile || rx->bpp_quarantined || atomic_read(&nu1669_bpp_uncertain)) {
+		ret = rx->bpp_profile ? -EUCLEAN : -EOPNOTSUPP;
+		goto out;
+	}
+	ret = nu1669_bpp_context(rx, generation);
+	if (ret)
+		goto out;
+	for (i = 0; i < 7; i++) {
+		ret = nu1669_bpp_write(rx, generation, i);
+		if (ret)
+			goto out;
+	}
+	ret = regmap_bulk_read(rx->regmap, NU1669_FOD_SHADOW, first, sizeof(first));
+	if (ret)
+		goto out;
+	ret = nu1669_bpp_context(rx, generation);
+	if (ret)
+		goto out;
+	ret = regmap_bulk_read(rx->regmap, NU1669_FOD_SHADOW, second, sizeof(second));
+	if (ret)
+		goto out;
+	ret = nu1669_read_info(rx, generation, info);
+	if (ret)
+		goto out;
+	/* Known firmware normalizes length 40 to shadow 12. These are shadows. */
+	if (memcmp(first, second, sizeof(first)) || second[0] != 1 || second[1] != 12 ||
+	    info[0x18] || memcmp(second + 3, rx->bpp_parameters, 40)) {
+		ret = -EPROTO;
+		goto out;
+	}
+	ret = nu1669_bpp_context(rx, generation);
+	if (!ret) {
+		rx->bpp_quarantined = false;
+		rx->bpp_prepared = true;
+		atomic_set(&nu1669_bpp_uncertain, 0);
+	}
+out:
+	mutex_unlock(&rx->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(nu1669_prepare_bpp);
+
 /* Read-only diagnostics: raw firmware values, not charging-state claims. */
