 				   struct device_attribute *attr, char *buf)
@@ -395,6 +574,8 @@ static int nu1669_query_context(struct nu1669 *rx, bool initial)
 	u16 mv;
 	int ret;
 
+	if (rx->bpp_profile)
+		return -EOPNOTSUPP;
 	ret = nu1669_query_live(rx);
 	if (ret)
 		return ret;
@@ -787,8 +968,21 @@ static int nu1669_debugfs_init(struct nu1669 *rx, struct device *dev)
 	return devm_add_action_or_reset(dev, nu1669_debugfs_remove, rx);
 }
 
+static bool nu1669_bpp_profile_valid(const u8 *parameters)
+{
+	static const u8 dodge_bpp[] = {
+		0x48, 0x32, 0x48, 0x2d, 0x48, 0x32, 0x48, 0x30, 0x48, 0x37,
+		0x48, 0x53, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
+		0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
+		0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
+	};
+
+	return !memcmp(parameters, dodge_bpp, sizeof(dodge_bpp));
+}
+
 static int nu1669_probe(struct i2c_client *client)
 {
+
 	struct power_supply_config psy_cfg = {};
 	struct device *dev = &client->dev;
 	struct nu1669 *rx;
@@ -798,6 +992,18 @@ static int nu1669_probe(struct i2c_client *client)
 	if (!rx)
 		return -ENOMEM;
 
+	if (device_property_present(dev, "nuvolta,bpp-fod-parameters")) {
+		ret = device_property_count_u8(dev, "nuvolta,bpp-fod-parameters");
+		if (ret != sizeof(rx->bpp_parameters))
+			return -EINVAL;
+		ret = device_property_read_u8_array(dev, "nuvolta,bpp-fod-parameters",
+						 rx->bpp_parameters, sizeof(rx->bpp_parameters));
+		if (ret)
+			return ret;
+		if (!nu1669_bpp_profile_valid(rx->bpp_parameters))
+			return dev_err_probe(dev, -EINVAL, "unsupported board BPP calibration\n");
+		rx->bpp_profile = true;
+	}
 	mutex_init(&rx->lock);
 	INIT_DELAYED_WORK(&rx->poll, nu1669_poll);
 	i2c_set_clientdata(client, rx);
