From 2fc159ae6d24405c2e0c57997475ae7ebf10e81f Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Sat, 7 Nov 2026 12:53:07 +0800
Subject: [PATCH 009/144] arm64: dts: qcom: enable Dodge Adreno 830

Enable the SoC GPU description and select the device-signed ZAP firmware. The shared SQE, GMU and AQE firmware names are provided by the Adreno 830 catalog.

Link: https://git.kernel.org/torvalds/c/9e39531ce39a98a77ddcf58f838a50dbf164092c

Import-Patch: pkgs/linux-kernel/sm8750/dodge/patches/7.3/0017-arm64-dts-qcom-enable-Dodge-Adreno-830.patch
Import-SHA256: 421b766c73acfa95e99fd01cc49b001369b8a81c3d091336206607598d0b1ba3
Import-Provenance: mail headers
(cherry picked from commit e8373fb50338a7ca4ccef4e2ac1248e7de03d353)
---
 arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts b/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
index a628b2ed01..614a37848d 100644
--- a/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
+++ b/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
@@ -396,6 +396,14 @@ &usb_hsphy {
 	status = "okay";
 };
 
+&gpu {
+	status = "okay";
+};
+
+&gpu_zap_shader {
+	firmware-name = "qcom/sm8750/oneplus/dodge/gen80000_zap.mbn";
+};
+
 &mdss {
 	resets = <&dispcc DISP_CC_MDSS_CORE_BCR>,
 		 <&dispcc DISP_CC_MDSS_CORE_INT2_BCR>;
