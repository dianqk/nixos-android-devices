From c91a0e9805f39afd5a469f2a68d20d559f0358d0 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Sun, 8 Nov 2026 12:37:04 +0800
Subject: [PATCH 053/144] arm64: dts: qcom: enable Dodge Iris with OEM VPU35
 firmware

Use the signed VPU35 firmware selected by Android on the OnePlus 13. The existing SM8750 Iris platform and 8 MiB video reservation match this image. Keep Iris disabled in RAM recovery.

Import-Patch: pkgs/linux-kernel/sm8750/dodge/patches/7.3/0066-arm64-dts-qcom-enable-Dodge-Iris.patch
Import-SHA256: 7ef85fd33c0f385882e9d86d58e8dba8a53680f01f858fa9c202f4aa3cfcbc21
Import-Provenance: mail headers
(cherry picked from commit 1bad21cf34334c0c3d4a3c1e1ec6545c9b5aef01)
---
 arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge-recovery.dts | 4 ++++
 arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts          | 5 +++++
 2 files changed, 9 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge-recovery.dts b/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge-recovery.dts
index 70bb4d1ba5..e330d8c015 100644
--- a/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge-recovery.dts
+++ b/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge-recovery.dts
@@ -58,3 +58,7 @@ &remoteproc_mpss {
 &rmtfs_mem {
 	status = "disabled";
 };
+
+&iris {
+	status = "disabled";
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts b/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
index 4c427f3e0c..7ab31667c1 100644
--- a/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
+++ b/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
@@ -868,3 +868,8 @@ &remoteproc_mpss {
 			"qcom/sm8750/oneplus/dodge/modem_dtb.mdt";
 	status = "okay";
 };
+
+&iris {
+	firmware-name = "qcom/sm8750/oneplus/dodge/vpu35_4v.mbn";
+	status = "okay";
+};
