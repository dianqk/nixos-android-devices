index 0000000000..4222a0991a
--- /dev/null
+++ b/drivers/media/platform/qcom/camss/camss-aon-mux.c
@@ -0,0 +1,127 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* SM8750 camera/AON MCLK and CSI ownership, held while MCLK is prepared. */
+#include <linux/clk.h>
+#include <linux/clk-provider.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+
+#define CAM_AON_SELECT_MASK (BIT(0) | BIT(8))
+
+struct camss_aon_mux {
+	struct clk_hw hw;
+	struct device *dev;
+	void __iomem *base;
+	struct clk_bulk_data clocks[2];
+	u32 saved;
+};
+
+static int camss_aon_prepare(struct clk_hw *hw)
+{
+	struct camss_aon_mux *mux = container_of(hw, struct camss_aon_mux, hw);
+	u32 val;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(mux->dev);
+	if (ret < 0)
+		return ret;
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(mux->clocks), mux->clocks);
+	if (ret) {
+		pm_runtime_put(mux->dev);
+		return ret;
+	}
+	val = readl(mux->base);
+	mux->saved = val & CAM_AON_SELECT_MASK;
+	writel(val & ~CAM_AON_SELECT_MASK, mux->base);
+	/* Flush before the parent MCLK is enabled and the sensor leaves reset. */
+	readl(mux->base);
+	return 0;
+}
+
+static void camss_aon_unprepare(struct clk_hw *hw)
+{
+	struct camss_aon_mux *mux = container_of(hw, struct camss_aon_mux, hw);
+	u32 val = readl(mux->base);
+
+	/* CCF has already disabled the parent MCLK at this point. */
+	writel((val & ~CAM_AON_SELECT_MASK) | mux->saved, mux->base);
+	readl(mux->base);
+	clk_bulk_disable_unprepare(ARRAY_SIZE(mux->clocks), mux->clocks);
+	pm_runtime_put(mux->dev);
+}
+
+static unsigned long camss_aon_recalc_rate(struct clk_hw *hw,
+					unsigned long parent_rate)
+{
+	return parent_rate;
+}
+
+static const struct clk_ops camss_aon_ops = {
+	.prepare = camss_aon_prepare,
+	.unprepare = camss_aon_unprepare,
+	.recalc_rate = camss_aon_recalc_rate,
+};
+
+static void camss_aon_disable_pm(void *data)
+{
+	pm_runtime_disable(data);
+}
+
+static int camss_aon_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct clk_parent_data parent = { .fw_name = "mclk" };
+	struct clk_init_data init = {
+		.name = dev_name(dev),
+		.ops = &camss_aon_ops,
+		.parent_data = &parent,
+		.num_parents = 1,
+		.flags = CLK_SET_RATE_PARENT,
+	};
+	struct camss_aon_mux *mux;
+	struct clk *mclk;
+	int ret;
+
+	mux = devm_kzalloc(dev, sizeof(*mux), GFP_KERNEL);
+	if (!mux)
+		return -ENOMEM;
+	mux->dev = dev;
+	mux->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(mux->base))
+		return PTR_ERR(mux->base);
+	/* Resolve the parent now, rather than registering an orphan output. */
+	mclk = devm_clk_get(dev, "mclk");
+	if (IS_ERR(mclk))
+		return dev_err_probe(dev, PTR_ERR(mclk), "MCLK unavailable\n");
+	mux->clocks[0].id = "ahb";
+	mux->clocks[1].id = "fast-ahb";
+	ret = devm_clk_bulk_get(dev, ARRAY_SIZE(mux->clocks), mux->clocks);
+	if (ret)
+		return dev_err_probe(dev, ret, "CPAS clocks unavailable\n");
+	pm_runtime_enable(dev);
+	ret = devm_add_action_or_reset(dev, camss_aon_disable_pm, dev);
+	if (ret)
+		return ret;
+	mux->hw.init = &init;
+	ret = devm_clk_hw_register(dev, &mux->hw);
+	if (ret)
+		return ret;
+	return devm_of_clk_add_hw_provider(dev, of_clk_hw_simple_get, &mux->hw);
+}
