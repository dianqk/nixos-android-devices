From 0a678b8b3b11e30c9b62c0c35a640529b4839b76 Mon Sep 17 00:00:00 2001
From: Xi Zhang <xz.ca.cn@gmail.com>
Date: Mon, 26 Oct 2026 17:25:45 -0300
Subject: [PATCH 041/144] drm/msm/dpu: Match setup_dither cleanup to the way it
 was set up

Cleanup hw_pp->ops.setup_dither with NULL for all PINGPONGs,
matching the way it was setup during enable.

Signed-off-by: Xi Zhang <xz.ca.cn@gmail.com>
Message-ID: <20261026-msm-dpu-res-clean-v2-4-3d864435186e@gmail.com>

Link: https://lore.kernel.org/r/20261026-msm-dpu-res-clean-v2-4-3d864435186e@gmail.com
(cherry picked from commit 62f8a6635327849ff348f59af6ba72e3b62bd52c)

Import-Patch: pkgs/linux-kernel/sm8750/dodge/patches/7.3/0059-drm-msm-dpu-Match-setup_dither-cleanup-to-the-way-it.patch
Import-SHA256: 4de7aeb87e5aff9ec9e0829ec8733d078a6f508247acb95b2ab806a2b892e777
Import-Provenance: mail headers
(cherry picked from commit 27f3cb8012618461ed16ba5a7057e55915229826)
---
 drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
index bb9819e1aa..a32c64acd7 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
@@ -1320,7 +1320,7 @@ static void _dpu_encoder_virt_enable_helper(struct drm_encoder *drm_enc)
 	if (dpu_enc->disp_info.intf_type == INTF_DSI &&
 			!WARN_ON(dpu_enc->num_phys_encs == 0)) {
 		unsigned bpc = dpu_enc->connector->display_info.bpc;
-		for (i = 0; i < MAX_CHANNELS_PER_ENC; i++) {
+		for (i = 0; i < ARRAY_SIZE(dpu_enc->hw_pp); i++) {
 			if (!dpu_enc->hw_pp[i])
 				continue;
 			_dpu_encoder_setup_dither(dpu_enc->hw_pp[i], bpc);
@@ -2308,8 +2308,10 @@ void dpu_encoder_helper_phys_cleanup(struct dpu_encoder_phys *phys_enc)
 		}
 	}
 
-	if (phys_enc->hw_pp && phys_enc->hw_pp->ops.setup_dither)
-		phys_enc->hw_pp->ops.setup_dither(phys_enc->hw_pp, NULL);
+	if (dpu_enc->disp_info.intf_type == INTF_DSI)
+		for (i = 0; i < ARRAY_SIZE(dpu_enc->hw_pp); i++)
+			if (dpu_enc->hw_pp[i] && dpu_enc->hw_pp[i]->ops.setup_dither)
+				dpu_enc->hw_pp[i]->ops.setup_dither(dpu_enc->hw_pp[i], NULL);
 
 	if (dpu_enc->cwb_mask)
 		dpu_encoder_helper_phys_setup_cwb(phys_enc, false);
