From 9d31cad49f6eba6b5ab73d9aa15285dd3026d196 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Wed, 23 Sep 2026 09:07:52 +0800
Subject: [PATCH] drm: panel: nt35596s: prepare before bridge enable

Port local polaris-panel-prepare.patch onto the cherry-picked panel driver.
---
 drivers/gpu/drm/panel/panel-novatek-nt35596s.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/drivers/gpu/drm/panel/panel-novatek-nt35596s.c b/drivers/gpu/drm/panel/panel-novatek-nt35596s.c
index 8ce068689..0ed449800 100644
--- a/drivers/gpu/drm/panel/panel-novatek-nt35596s.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt35596s.c
@@ -478,6 +478,12 @@ static int nt35596s_panel_add(struct nt35596s_panel *pinfo)
 
 	drm_panel_init(&pinfo->base, dev, &panel_funcs, DRM_MODE_CONNECTOR_DSI);
 
+	/* Init commands in prepare() require an already powered DSI host. */
+	pinfo->base.prepare_prev_first = true;
+	ret = drm_panel_of_backlight(&pinfo->base);
+	if (ret)
+		return ret;
+
 	drm_panel_add(&pinfo->base);
 
 	return 0;
-- 
