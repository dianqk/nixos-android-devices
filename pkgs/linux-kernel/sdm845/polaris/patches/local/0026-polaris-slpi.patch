From: dianqk <dianqk@dianqk.net>
Date: Fri, 2 Oct 2026 12:00:00 +0800
Subject: [PATCH] arm64: dts: qcom: enable polaris SLPI sensors

Enable the existing SLPI PAS/GLINK transport and request the board sensor
firmware. Subscribe to sensor_pd service notifications through FastRPC.

--- a/arch/arm64/boot/dts/qcom/sdm845-xiaomi-polaris.dts
+++ b/arch/arm64/boot/dts/qcom/sdm845-xiaomi-polaris.dts
@@ -982,3 +982,14 @@
 		bias-disable;
 	};
 };
+
+&slpi_pas {
+	firmware-name = "qcom/sdm845/Xiaomi/polaris/slpi.mbn";
+	status = "okay";
+
+	glink-edge {
+		fastrpc {
+			qcom,protection-domain = "tms/servreg", "msm/slpi/sensor_pd";
+		};
+	};
+};
