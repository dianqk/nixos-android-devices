From 4d47cae4a63c113000d3d6691d669e17ded6de84 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Wed, 23 Sep 2026 09:17:53 +0800
Subject: [PATCH] drm: panel: adapt NT35596S allocation for Linux 7.3

Keep the panel API adaptation independently of Polaris power-supply changes.

---
 drivers/gpu/drm/panel/panel-novatek-nt35596s.c | 9 ++++-----
 1 file changed, 4 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-novatek-nt35596s.c b/drivers/gpu/drm/panel/panel-novatek-nt35596s.c
index 0ed449800..04003bf13 100644
--- a/drivers/gpu/drm/panel/panel-novatek-nt35596s.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt35596s.c
@@ -476,8 +476,6 @@ static int nt35596s_panel_add(struct nt35596s_panel *pinfo)
 		return dev_err_probe(dev, PTR_ERR(pinfo->reset_gpio),
 				     "failed to get reset gpio from DT\n");
 
-	drm_panel_init(&pinfo->base, dev, &panel_funcs, DRM_MODE_CONNECTOR_DSI);
-
 	/* Init commands in prepare() require an already powered DSI host. */
 	pinfo->base.prepare_prev_first = true;
 	ret = drm_panel_of_backlight(&pinfo->base);
@@ -495,9 +493,10 @@ static int nt35596s_panel_probe(struct mipi_dsi_device *dsi)
 	const struct nt35596s_panel_desc *desc;
 	int err;
 
-	pinfo = devm_kzalloc(&dsi->dev, sizeof(*pinfo), GFP_KERNEL);
-	if (!pinfo)
-		return -ENOMEM;
+	pinfo = devm_drm_panel_alloc(&dsi->dev, __typeof(*pinfo), base,
+				     &panel_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(pinfo))
+		return PTR_ERR(pinfo);
 
 	desc = of_device_get_match_data(&dsi->dev);
 	dsi->mode_flags = desc->mode_flags;
-- 
2.55.0
