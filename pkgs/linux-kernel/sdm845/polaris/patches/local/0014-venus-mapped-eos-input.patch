From 2785fb3420f9f80bc03424f7f0922b8003083b07 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Wed, 23 Sep 2026 18:51:04 +0800
Subject: [PATCH] media: venus: map SDM845 decoder EOS input

Polaris Venus firmware rejects the unmapped 0xdeadb000 EOS input.
A NULL EOS input can produce a synthetic zero-address FBD instead of
returning a real CAPTURE buffer. Keep a 4 KiB DMA-mapped EOS input for
the lifetime of the decoder instance, pass its actual allocation
length, and distinguish its EBD from an ordinary OUTPUT buffer.

The Polaris Linux 7.3-rc4 decoder completed 20/20 H.264 and 20/20
HEVC 144-frame natural-EOF runs with a real CAPTURE FBD address and
no Venus session error in the bounded test.

Link: https://lkml.indiana.edu/hypermail/linux/kernel/2507.2/01962.html
Signed-off-by: dianqk <dianqk@dianqk.net>
---
 drivers/media/platform/qcom/venus/core.h |  3 ++
 drivers/media/platform/qcom/venus/vdec.c | 47 ++++++++++++++++++++----
 2 files changed, 42 insertions(+), 8 deletions(-)

diff --git a/drivers/media/platform/qcom/venus/core.h b/drivers/media/platform/qcom/venus/core.h
index 46705a666..b7f05e957 100644
--- a/drivers/media/platform/qcom/venus/core.h
+++ b/drivers/media/platform/qcom/venus/core.h
@@ -528,6 +528,9 @@ struct venus_inst {
 	bool drain_active;
 	enum venus_inst_modes flags;
 	struct ida dpb_ids;
+	/* Decoder-owned EOS input, retained until the HFI session is destroyed. */
+	void *eos_cpu;
+	dma_addr_t eos_dma;
 };
 
 #define IS_V1(core)	((core)->res->hfi_version == HFI_VERSION_1XX)
diff --git a/drivers/media/platform/qcom/venus/vdec.c b/drivers/media/platform/qcom/venus/vdec.c
index 6a43ea191..6b0225870 100644
--- a/drivers/media/platform/qcom/venus/vdec.c
+++ b/drivers/media/platform/qcom/venus/vdec.c
@@ -4,7 +4,9 @@
  * Copyright (C) 2017 Linaro Ltd.
  */
 #include <linux/clk.h>
+#include <linux/dma-mapping.h>
 #include <linux/module.h>
+#include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/pm_runtime.h>
 #include <linux/slab.h>
@@ -21,6 +23,8 @@
 #include "vdec.h"
 #include "pm_helpers.h"
 
+#define VENUS_EOS_BUFFER_SIZE 4096
+
 /*
  * Three resons to keep MPLANE formats (despite that the number of planes
  * currently is one):
@@ -569,15 +573,36 @@ vdec_decoder_cmd(struct file *file, void *fh, struct v4l2_decoder_cmd *cmd)
 		fdata.buffer_type = HFI_BUFFER_INPUT;
 		fdata.flags |= HFI_BUFFERFLAG_EOS;
 
-		/* Send NULL EOS addr for only IRIS2 (SM8250),for firmware <= 1.0.87.
-		 * SC7280 also reports "1.0.<hash>" parsed as 1.0.0; restricting to IRIS2
-		 * avoids misapplying this quirk and breaking VP9 decode on SC7280.
+		/* SDM845 firmware rejects the unmapped dummy EOS address. Keep
+		 * this input mapped until the session has been destroyed.
 		 */
-
-		if (IS_IRIS2(inst->core) && is_fw_rev_or_older(inst->core, 1, 0, 87))
-			fdata.device_addr = 0;
-		else
-			fdata.device_addr = 0xdeadb000;
+		if (of_device_is_compatible(inst->core->dev->of_node,
+					    "qcom,sdm845-venus") ||
+		    of_device_is_compatible(inst->core->dev->of_node,
+					    "qcom,sdm845-venus-v2")) {
+			if (!inst->eos_cpu) {
+				inst->eos_cpu = dma_alloc_coherent(inst->core->dev,
+							   VENUS_EOS_BUFFER_SIZE, &inst->eos_dma,
+							   GFP_KERNEL);
+				if (!inst->eos_cpu) {
+					ret = -ENOMEM;
+					goto unlock;
+				}
+			}
+			fdata.device_addr = (u32)inst->eos_dma;
+			fdata.alloc_len = VENUS_EOS_BUFFER_SIZE;
+			fdata.clnt_data = U32_MAX;
+		} else {
+			/* Send NULL EOS addr for only IRIS2 (SM8250),for firmware <= 1.0.87.
+			 * SC7280 also reports "1.0.<hash>" parsed as 1.0.0; restricting to IRIS2
+			 * avoids misapplying this quirk and breaking VP9 decode on SC7280.
+			 */
+			if (IS_IRIS2(inst->core) &&
+			    is_fw_rev_or_older(inst->core, 1, 0, 87))
+				fdata.device_addr = 0;
+			else
+				fdata.device_addr = 0xdeadb000;
+		}
 
 		ret = hfi_session_process_buf(inst, &fdata);
 
@@ -1423,6 +1448,8 @@ static void vdec_buf_done(struct venus_inst *inst, unsigned int buf_type,
 		type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
 	else
 		type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+	if (buf_type == HFI_BUFFER_INPUT && tag == U32_MAX && inst->eos_cpu)
+		return;
 
 	vbuf = venus_helper_find_buf(inst, type, tag);
 	if (!vbuf) {
@@ -1762,6 +1789,10 @@ static int vdec_close(struct file *file)
 	vdec_pm_get(inst);
 	cancel_work_sync(&inst->delayed_process_work);
 	venus_close_common(inst, file);
+	if (inst->eos_cpu)
+		dma_free_coherent(inst->core->dev, VENUS_EOS_BUFFER_SIZE,
+				  inst->eos_cpu,
+				  inst->eos_dma);
 	ida_destroy(&inst->dpb_ids);
 	vdec_pm_put(inst, false);
 
-- 
2.55.0

