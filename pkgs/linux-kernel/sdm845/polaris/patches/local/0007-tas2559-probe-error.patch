From 510aa4d147f6f907c189343a997891dadd22dba3 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Wed, 23 Sep 2026 09:07:52 +0800
Subject: [PATCH] ASoC: tas2559: propagate device-tree parse failure

Port the local tas2559-probe-error.patch onto the cherry-picked codec.
---
 sound/soc/codecs/tas2559.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/sound/soc/codecs/tas2559.c b/sound/soc/codecs/tas2559.c
index 5a2d0eda9..2c17ba66a 100644
--- a/sound/soc/codecs/tas2559.c
+++ b/sound/soc/codecs/tas2559.c
@@ -2204,8 +2204,11 @@ static int tas2559_i2c_probe(struct i2c_client *pClient)
 		goto err;
 	}
 
-	if (pClient->dev.of_node)
-		tas2559_parse_dt(&pClient->dev, pTAS2559);
+	if (pClient->dev.of_node) {
+		nResult = tas2559_parse_dt(&pClient->dev, pTAS2559);
+		if (nResult)
+			return nResult;
+	}
 
 	tas2559_hw_reset(pTAS2559);
 
-- 
2.55.0

