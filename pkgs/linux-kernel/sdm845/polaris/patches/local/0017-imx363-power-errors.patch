Subject: [PATCH] media: imx363: support module enable GPIO and handle power errors

Polaris uses CUSTOM_GPIO1 (TLMM102) in the stock sensor power sequence.
Keep reset asserted during probe and observe stock reset/clock settling delays.
Propagate clock failures and release supplies on failure.

--- a/drivers/media/i2c/imx363.c
+++ b/drivers/media/i2c/imx363.c
@@ -5,6 +5,7 @@
 #include <linux/clk.h>
 #include <linux/delay.h>
 #include <linux/i2c.h>
+#include <linux/gpio/consumer.h>
 #include <linux/module.h>
 #include <linux/pm_runtime.h>
 #include <linux/regulator/consumer.h>
@@ -612,6 +613,7 @@
 	unsigned int csi2_flags;
 
 	struct gpio_desc *reset_gpio;
+	struct gpio_desc *enable_gpio;
 
 	/*
 	 * Mutex for serialized access:
@@ -1048,17 +1050,22 @@
 		return ret;
 	}
 
-	usleep_range(400, 600);
+	gpiod_set_value_cansleep(imx363->enable_gpio, 1);
+	usleep_range(1000, 1200);
 
 	gpiod_set_value_cansleep(imx363->reset_gpio, 0);
+	usleep_range(12000, 13000);
 
 	ret = clk_prepare_enable(imx363->clk);
 	if (ret) {
 		dev_err(dev, "failed to enable clock\n");
+		gpiod_set_value_cansleep(imx363->reset_gpio, 1);
+		gpiod_set_value_cansleep(imx363->enable_gpio, 0);
 		regulator_bulk_disable(IMX363_NUM_SUPPLIES, imx363->supplies);
-	}
-
-	usleep_range(1000, 1200);
+		return ret;
+	}
+
+	usleep_range(10000, 11000);
 
 	return 0;
 }
@@ -1071,6 +1078,7 @@
 	clk_disable_unprepare(imx363->clk);
 
 	gpiod_set_value_cansleep(imx363->reset_gpio, 1);
+	gpiod_set_value_cansleep(imx363->enable_gpio, 0);
 
 	regulator_bulk_disable(IMX363_NUM_SUPPLIES, imx363->supplies);
 
@@ -1399,9 +1407,16 @@
 
 	/* request optional reset pin */
 	imx363->reset_gpio = devm_gpiod_get_optional(&client->dev, "reset",
-						     GPIOD_OUT_LOW);
+						     GPIOD_OUT_HIGH);
 	if (IS_ERR(imx363->reset_gpio))
 		return PTR_ERR(imx363->reset_gpio);
+
+	imx363->enable_gpio = devm_gpiod_get_optional(&client->dev, "enable",
+						      GPIOD_OUT_LOW);
+	if (IS_ERR(imx363->enable_gpio)) {
+		ret = PTR_ERR(imx363->enable_gpio);
+		goto error_endpoint_free;
+	}
 
 	/* Initialize subdev */
 	v4l2_i2c_subdev_init(&imx363->sd, client, &imx363_subdev_ops);
