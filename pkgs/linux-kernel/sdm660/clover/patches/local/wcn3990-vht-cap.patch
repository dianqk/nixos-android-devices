diff --git a/drivers/net/wireless/ath/ath10k/mac.c b/drivers/net/wireless/ath/ath10k/mac.c
index 107946175d52..75a638efc9cd 100644
--- a/drivers/net/wireless/ath/ath10k/mac.c
+++ b/drivers/net/wireless/ath/ath10k/mac.c
@@ -4904 +4904,11 @@ static struct ieee80211_sta_vht_cap ath10k_create_vht_cap(struct ath10k *ar)
-	vht_cap.cap = ar->vht_cap_info;
+	vht_cap.cap = ar->vht_cap_info;
+
+	/* The WCN3990 firmware uses a WMI VHT capability layout that defines
+	 * bits only through TX_FIXED_ANT (bit 29).  Qualcomm's qcacld driver
+	 * rebuilds the IEEE capability field member by member and consequently
+	 * drops bits 30-31.  Copying the complete WMI word instead interprets
+	 * firmware bit 30 as Extended NSS BW and can form a reserved IEEE
+	 * channel-width/NSS combination that some access points reject.
+	 */
+	if (QCA_REV_WCN3990(ar))
+		vht_cap.cap &= ~IEEE80211_VHT_CAP_EXT_NSS_BW_MASK;
