 }
 
+/**
+ * cprh_read_open_loop_fuse() - Read a fused open-loop voltage without rounding
+ * @thread: Structure holding CPR thread-specific parameters
+ * @fnum:   Fuse corner index
+ * @uV:     Returned voltage, including the fixed open-loop fuse adjustment
+ *
+ * Return: Zero for success, negative number on error
+ */
+static int cprh_read_open_loop_fuse(struct cpr_thread *thread, int fnum,
+				    int *uV)
+{
+	const struct cpr_thread_desc *tdesc = thread->desc;
+	const struct fuse_corner_data *fdata = &tdesc->fuse_corner_data[fnum];
+	int width = tdesc->init_voltage_width;
+	int steps, ret;
+	u32 bits;
+
+	ret = nvmem_cell_read_variable_le_u32(thread->drv->dev,
+					      thread->cpr_fuses[fnum].init_voltage,
+					      &bits);
+	if (ret)
+		return ret;
+
+	/* Sign and magnitude, not two's complement */
+	steps = bits & (BIT(width - 1) - 1);
+	if (bits & BIT(width - 1))
+		steps = -steps;
+
+	*uV = fdata->ref_uV + steps * tdesc->init_voltage_step +
+	      fdata->volt_oloop_adjust;
+
+	return 0;
+}
+
+/* Linear interpolation, rounding like cpr3_interpolate() of the vendor driver */
+static int cprh_interpolate(u64 f_low, int uV_low, u64 f_high, int uV_high,
+			    u64 freq)
+{
+	u64 temp;
+
+	if (f_low >= f_high || uV_low > uV_high || f_low > freq || freq > f_high)
+		return uV_high;
+
+	temp = (f_high - freq) * (u64)(uV_high - uV_low);
+	temp = div64_u64(temp, f_high - f_low);
+
+	return uV_high - (int)temp;
+}
+
+/**
+ * cprh_vendor_corner_voltages() - Compute corner voltages like the vendor driver
+ * @thread: Structure holding CPR thread-specific parameters
+ * @cdata:  Fuse corner and frequency of each corner, read from the OPP tables
+ *
+ * This follows cprh_kbss_init_regulator() of the vendor CPRh driver: the fused
+ * open-loop voltages plus their fixed adjustment are interpolated by frequency
+ * without intermediate rounding, rounded up to the regulator step, limited to
+ * the floor and ceiling of each corner, kept clear of the APM threshold, used
+ * as the corner ceiling, and the floor is raised to the floor to ceiling range.
+ *
+ * Return: Zero for success, negative number on error
+ */
+static int cprh_vendor_corner_voltages(struct cpr_thread *thread,
+				       const struct corner_data *cdata)
+{
+	const struct cpr_thread_desc *tdesc = thread->desc;
+	const struct cprh_corner_limits *lim = tdesc->corner_limits;
+	struct cpr_drv *drv = thread->drv;
+	const struct cpr_desc *desc = drv->desc;
+	int nfc = tdesc->num_fuse_corners, n = thread->num_corners;
+	int step = drv->vreg_step;
+	int fuse_uV[CPRH_MAX_FUSE_CORNERS], fmax[CPRH_MAX_FUSE_CORNERS];
+	int i, j, ret;
+
+	if (nfc > CPRH_MAX_FUSE_CORNERS)
+		return -EINVAL;
+
+	if (n != tdesc->num_corner_limits) {
+		dev_err(drv->dev, "%s: %d corners in the OPP tables, %u expected\n",
+			tdesc->name, n, tdesc->num_corner_limits);
+		return -EINVAL;
+	}
+
+	for (i = 0; i < n; i++) {
+		if (cdata[i].freq != lim[i].freq) {
+			dev_err(drv->dev, "%s: corner %d is %llu Hz, %llu Hz expected\n",
+				tdesc->name, i + 1, cdata[i].freq, lim[i].freq);
+			return -EINVAL;
+		}
+	}
+
+	for (i = 0; i < nfc; i++) {
+		ret = cprh_read_open_loop_fuse(thread, i, &fuse_uV[i]);
+		if (ret)
+			return ret;
+		if (i && fuse_uV[i] < fuse_uV[i - 1])
+			fuse_uV[i] = fuse_uV[i - 1];
+	}
+
+	/* Highest corner mapped to each fuse corner */
+	j = nfc - 1;
+	for (i = n - 1; i >= 0 && j >= 0; i--) {
+		if (cdata[i].fuse_corner == j) {
+			fmax[j] = i;
+			j--;
+		}
+	}
+	if (j >= 0) {
+		dev_err(drv->dev, "%s: invalid fuse corner mapping\n", tdesc->name);
+		return -EINVAL;
+	}
+
+	for (i = 0; i < n; i++) {
+		struct corner *corner = &thread->corners[i];
+		int fc = cdata[i].fuse_corner;
+		int uV, floor, ceiling, floor_new;
+
+		if (fc >= nfc)
+			return -EINVAL;
+
+		if (i <= fmax[0])
+			uV = fuse_uV[0];
+		else if (fc == 0 || i <= fmax[fc - 1])
+			return -EINVAL;
+		else
+			uV = cprh_interpolate(cdata[fmax[fc - 1]].freq,
+					      fuse_uV[fc - 1],
+					      cdata[fmax[fc]].freq,
+					      fuse_uV[fc], cdata[i].freq);
+
+		floor = lim[i].floor_uV;
+		ceiling = lim[i].ceiling_uV;
+
+		/* cpr3_limit_open_loop_voltages() */
+		uV = roundup(uV, step);
+		if (uV < floor)
+			uV = floor;
+		else if (uV > ceiling)
+			uV = ceiling;
+
+		/* cprh_adjust_voltages_for_apm() */
+		if (desc->apm_threshold) {
+			int threshold = roundup(desc->apm_threshold, step);
+			int adj = roundup(desc->apm_hysteresis, step);
+
+			if (threshold > floor && threshold <= ceiling) {
+				if (uV >= threshold) {
+					floor = max(floor, threshold - adj);
+					uV = max(uV, floor);
+				} else {
+					ceiling = threshold - step;
+				}
+			}
+		}
+
+		/* cpr3_open_loop_voltage_as_ceiling() */
+		ceiling = uV;
+
+		/* cpr3_limit_floor_voltages() */
+		floor_new = roundup(ceiling - lim[i].range_uV, step);
+		floor = max(floor, floor_new);
+		uV = max(uV, floor);
+
+		if (i && floor < thread->corners[i - 1].min_uV) {
+			floor = thread->corners[i - 1].min_uV;
+			uV = max(uV, floor);
+			ceiling = max(ceiling, floor);
+		}
+
+		corner->uV = uV;
+		corner->last_uV = uV;
+		corner->min_uV = floor;
+		corner->max_uV = ceiling;
+	}
+
+	return 0;
+}
+
 /**
  * cpr3_corner_init() - Calculate and set-up corners for the CPR HW
  * @thread: Structure holding CPR thread-specific parameters
@@ -1255,7 +1481,7 @@ static int cpr3_corner_init(struct cpr_thread *thread)
 		 * Make sure that the frequencies in the table are in ascending
 		 * order, as this is critical for the algorithm to work.
 		 */
-		if (cdata[level - 2].freq > freq) {
+		if (level > 1 && cdata[level - 2].freq > freq) {
 			dev_err(drv->dev, "Frequency table not in ascending order.\n");
 			return -EINVAL;
 		}
@@ -1420,6 +1646,24 @@ static int cpr3_corner_init(struct cpr_thread *thread)
 	if (desc->cpr_type != CTRL_TYPE_CPRH)
 		return 0;
 
+	if (tdesc->corner_limits) {
+		ret = cprh_vendor_corner_voltages(thread, cdata);
+		if (ret)
+			return ret;
+	}
+
+	if (desc->open_loop_only)
+		for (i = 0; i < thread->num_corners; i++)
+			thread->corners[i].is_open_loop = true;
+
+	for (i = 0; i < thread->num_corners; i++)
+		dev_info(drv->dev, "%s corner %d: %llu kHz open-loop %d mV floor %d mV ceiling %d mV%s\n",
+			 tdesc->name, i + 1, div_u64(thread->corners[i].freq, 1000),
+			 thread->corners[i].uV / 1000,
+			 thread->corners[i].min_uV / 1000,
+			 thread->corners[i].max_uV / 1000,
+			 thread->corners[i].is_open_loop ? ", closed loop off" : "");
+
 	/* If the OPPs can't be adjusted, programming the CPRh is useless */
 	ret = cprh_corner_adjust_opps(thread);
 	if (ret) {
@@ -1445,9 +1689,9 @@ static int cpr3_corner_init(struct cpr_thread *thread)
 		 */
 		thread->ext_data.apm_threshold_uV = desc->apm_threshold;
 
-		dev_dbg(drv->dev, "corner %d (APM): [%d %d %d] Open-Loop\n",
-			total_corners, desc->apm_crossover,
-			desc->apm_crossover, desc->apm_crossover);
+		dev_info(drv->dev, "%s corner %d: APM crossover %d mV, closed loop off\n",
+			 tdesc->name, total_corners + 1,
+			 desc->apm_crossover / 1000);
 
 		total_corners++;
 		extra_corners--;
@@ -1638,10 +1882,16 @@ static int cpr3_init_parameters(struct cpr_drv *drv)
 	do_div(drv->ref_clk_khz, 1000);
 
 	/* On CPRh this clock is not always-on... */
-	if (desc->cpr_type == CTRL_TYPE_CPRH)
-		clk_prepare_enable(clk);
-	else
+	if (desc->cpr_type == CTRL_TYPE_CPRH) {
+		int ret = clk_prepare_enable(clk);
+
+		if (ret) {
+			dev_err(drv->dev, "Couldn't enable the reference clock: %d\n", ret);
+			return ret;
+		}
+	} else {
 		devm_clk_put(drv->dev, clk);
+	}
 
 	/*
 	 * Read the CPR version register only from CPR3 onwards:
@@ -1655,7 +1905,7 @@ static int cpr3_init_parameters(struct cpr_drv *drv)
 	drv->cpr_hw_rev = cpr_read(&drv->threads[0], CPR3_REG_CPR_VERSION);
 	dev_dbg(drv->dev, "CPR hardware revision: 0x%x\n", drv->cpr_hw_rev);
 
-	if (drv->cpr_hw_rev >= CPRH_CPR_VERSION_4P5) {
+	if (drv->cpr_hw_rev >= CPRH_CPR_VERSION_4P5 && !desc->cprh_fixed_layout) {
 		drv->reg_corner = 0x3500;
 		drv->reg_corner_tid = 0xa0;
 		drv->reg_ctl = 0x3a80;
@@ -1755,6 +2005,7 @@ static const int msm8998_silver_scaling_factor[][CPR3_RO_COUNT] = {
 };
 
 static const struct cpr_thread_desc msm8998_thread_gold = {
+	.name = "gold",
 	.controller_id = 1,
 	.hw_tid = 0,
 	.ro_scaling_factor = msm8998_gold_scaling_factor,
@@ -1830,6 +2081,7 @@ static const struct cpr_thread_desc msm8998_thread_gold = {
 };
 
 static const struct cpr_thread_desc msm8998_thread_silver = {
+	.name = "silver",
 	.controller_id = 0,
 	.hw_tid = 0,
 	.ro_scaling_factor = msm8998_silver_scaling_factor,
@@ -1957,6 +2209,7 @@ static const int sdm630_silver_scaling_factor[][CPR3_RO_COUNT] = {
 };
 
 static const struct cpr_thread_desc sdm630_thread_gold = {
+	.name = "gold",
 	.controller_id = 0,
 	.hw_tid = 0,
 	.ro_scaling_factor = sdm630_gold_scaling_factor,
@@ -2048,6 +2301,7 @@ static const struct cpr_thread_desc sdm630_thread_gold = {
 };
 
 static const struct cpr_thread_desc sdm630_thread_silver = {
+	.name = "silver",
 	.controller_id = 1,
 	.hw_tid = 0,
 	.ro_scaling_factor = sdm630_silver_scaling_factor,
@@ -2142,6 +2396,164 @@ static const struct cpr_acc_desc sdm630_cpr_acc_desc = {
 	.cpr_desc = &sdm630_cpr_desc,
 };
 
+/*
+ * SDM660 KBSS CPRh, from the vendor cprh-kbss-regulator.c (fuse reference
+ * voltages, sensor counts) and the apc0/apc1 CPRh nodes of sdm660-regulator.dtsi
+ * (RO scaling factors, fuse adjustments, per-corner floors, ceilings and
+ * ranges, controller timings).
+ */
+static const int sdm660_gold_scaling_factor[][CPR3_RO_COUNT] = {
+	/* Same RO factors for all fuse corners */
+	{
+		4040, 4230,    0, 2210, 2560, 2450, 2230, 2220,
+		2410, 2300, 2560, 2470, 1600, 3120, 2620, 2280
+	}
+};
+
+static const int sdm660_silver_scaling_factor[][CPR3_RO_COUNT] = {
+	/* Same RO factors for all fuse corners */
+	{
+		3600, 3600, 3830, 2430, 2520, 2700, 1790, 1760,
+		1970, 1880, 2110, 2010, 2510, 4900, 4370, 4780
+	}
+};
+
+/* Speed bin 1 corner plan of the power (silver) cluster */
+static const struct cprh_corner_limits sdm660_silver_bin1_corners[] = {
+	{  300000000, 588000,  724000, 32000 },
+	{  633600000, 588000,  724000, 32000 },
+	{  902400000, 596000,  724000, 32000 },
+	{ 1113600000, 652000,  788000, 40000 },
+	{ 1401600000, 712000,  868000, 44000 },
+	{ 1536000000, 744000, 1068000, 40000 },
+	{ 1747200000, 784000, 1068000, 40000 },
+	{ 1843200000, 844000, 1068000, 40000 },
+};
+
+/* Speed bin 1 corner plan of the performance (gold) cluster */
+static const struct cprh_corner_limits sdm660_gold_bin1_corners[] = {
+	{  300000000, 588000,  724000, 40000 },
+	{ 1113600000, 596000,  724000, 40000 },
+	{ 1401600000, 652000,  788000, 40000 },
+	{ 1747200000, 712000,  868000, 40000 },
+	{ 1958400000, 744000,  988000, 66000 },
+	{ 2150400000, 784000,  988000, 66000 },
+	{ 2208000000, 844000, 1068000, 40000 },
+};
+
+/*
+ * Fuse corner limits are the widest floor/ceiling of the corners mapped to
+ * each fuse corner; the per-corner plan above sets the programmed values.
+ * The volt_cloop_adjust values only shape the target quotients, which are
+ * unused while closed-loop operation is disabled.
+ */
+#define SDM660_FUSE_CORNER(_ref, _min, _max, _range, _cl, _ol) {	\
+	.ref_uV = _ref,							\
+	.max_uV = _max,							\
+	.min_uV = _min,							\
+	.range_uV = _range,						\
+	.volt_cloop_adjust = _cl,					\
+	.volt_oloop_adjust = _ol,					\
+	.max_volt_scale = 2000,						\
+	.max_quot_scale = 1000,						\
+	.quot_offset = 0,						\
+	.quot_scale = 1,						\
+	.quot_adjust = 0,						\
+	.quot_offset_scale = 5,						\
+	.quot_offset_adjust = 0,					\
+}
+
+static const struct cpr_thread_desc sdm660_thread_silver = {
+	.controller_id = 0,
+	.hw_tid = 0,
+	.name = "silver",
+	.ro_scaling_factor = sdm660_silver_scaling_factor,
+	.ro_scaling_factor_common = true,
+	.sensor_range_start = 0,
+	.sensor_range_end = 6,
+	.init_voltage_step = 10000,
+	.init_voltage_width = 6,
+	.step_quot_init_min = 12,
+	.step_quot_init_max = 14,
+	.num_fuse_corners = 5,
+	.fuse_corner_data = (struct fuse_corner_data[]){
+		/* LowSVS, SVS, SVS+, NOM, TURBO_L1 */
+		SDM660_FUSE_CORNER( 644000, 588000,  724000, 32000, -32000, -4000),
