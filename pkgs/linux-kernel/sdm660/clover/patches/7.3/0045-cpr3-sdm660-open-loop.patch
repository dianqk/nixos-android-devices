@@ -922,6 +962,10 @@ static int cpr_configure(struct cpr_thread *thread)
 				 CPR4_MISC_THREAD_HAS_ALWAYS_VOTE_EN,
 				 CPR4_MISC_RESET_STEP_QUOT_LOOP_EN |
