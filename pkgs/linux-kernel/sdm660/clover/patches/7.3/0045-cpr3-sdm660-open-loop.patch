@@ -939,6 +983,10 @@ static int cpr_configure(struct cpr_thread *thread)
 			 desc->vreg_step_up_limit <<
 			 CPR4_SAW_ERROR_STEP_LIMIT_UP_SHIFT);
 
+	/* No fixed step quotient: use the dynamic per-RO one */
