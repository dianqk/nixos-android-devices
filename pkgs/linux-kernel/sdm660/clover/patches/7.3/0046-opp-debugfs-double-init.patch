From 06ded07acbc2c58df3a95cd8a51efe2791fc8c1f Mon Sep 17 00:00:00 2001
From: Konrad Dybcio <konrad.dybcio@linaro.org>
Date: Mon, 8 Jul 2024 12:20:58 +0200
Subject: [PATCH] opp: debugfs: Account for unlikely double OPP debugfs
 initialization

(cherry picked from commit e548cfd10dcbc907589173ad6bf292119fb01e38 https://github.com/SoMainline/linux)
Scope: SDM630/660 common
Porting notes: Applied unchanged on v7.3 from SoMainline topic/cpr3hh; this work-in-progress commit was never posted and carries no sign-off.
---
 drivers/opp/debugfs.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/drivers/opp/debugfs.c b/drivers/opp/debugfs.c
index 61506d30d5..169e141b84 100644
--- a/drivers/opp/debugfs.c
+++ b/drivers/opp/debugfs.c
@@ -192,6 +192,13 @@ static void opp_list_debug_create_link(struct opp_device *opp_dev,
 
 	opp_set_dev_name(opp_dev->dev, name);
 
+	/*
+	 * In some rare cases (e.g. pmdomain consumer's OPP table being initialized
+	 * in pmdomain->attach), the link may have already been created.
+	 */
+	if (unlikely(debugfs_lookup(name, rootdir)))
+		return;
+
 	/* Create device specific directory link */
 	opp_dev->dentry = debugfs_create_symlink(name, rootdir,
 						 opp_table->dentry_name);
