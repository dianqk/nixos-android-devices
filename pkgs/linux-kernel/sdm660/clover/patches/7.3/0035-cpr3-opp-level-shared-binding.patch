From bffb520afcbe75427f222cba3b8b6708e815148e Mon Sep 17 00:00:00 2001
From: Konrad Dybcio <konrad.dybcio@linaro.org>
Date: Mon, 8 Jul 2024 13:54:40 +0200
Subject: [PATCH] dt-bindings: opp: v2-qcom-level: Allow opp-shared

Some devices may use a shared OPP table, such as separate CPR threads.
Allow the table to be marked as such.

Signed-off-by: Konrad Dybcio <konrad.dybcio@linaro.org>
Link: https://lore.kernel.org/r/20240708-topic-cpr3h-v15-3-5bc8b8936489@linaro.org
(cherry picked from commit 8611e13d501d85103f2eb097a5d64ecd82f85c5d https://github.com/SoMainline/linux)
Scope: SDM630/660 common
Porting notes: Applied unchanged on v7.3 from SoMainline topic/cpr3hh (v15 3/10, not merged upstream).
---
 Documentation/devicetree/bindings/opp/opp-v2-qcom-level.yaml | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/Documentation/devicetree/bindings/opp/opp-v2-qcom-level.yaml b/Documentation/devicetree/bindings/opp/opp-v2-qcom-level.yaml
index b203ea01b1..cc694b254a 100644
--- a/Documentation/devicetree/bindings/opp/opp-v2-qcom-level.yaml
+++ b/Documentation/devicetree/bindings/opp/opp-v2-qcom-level.yaml
@@ -16,6 +16,8 @@ properties:
   compatible:
     const: operating-points-v2-qcom-level
 
+  opp-shared: true
+
 patternProperties:
   '^opp-?[0-9]+$':
     type: object
