{ lib }:
# Shared by every SoC and kernel variant. Keep the firewall and transparent
# proxy paths built in, including inet FIB lookups and NFQUEUE used by TUN
# auto-redirect. This makes them available before module loading in early boot.
lib.genAttrs [
  "INET"
  "IPV6"
  "NETFILTER"
  "NETFILTER_ADVANCED"
  "NETFILTER_INGRESS"
  "NETFILTER_EGRESS"
  "NETFILTER_NETLINK"
  "NETFILTER_NETLINK_QUEUE"
  "NETFILTER_NETLINK_LOG"
  "NF_CONNTRACK"
  "NF_CONNTRACK_MARK"
  "NF_CONNTRACK_ZONES"
  "NF_CONNTRACK_EVENTS"
  "NF_NAT"
  "NF_LOG_SYSLOG"
  "NF_TABLES"
  "NF_TABLES_INET"
  "NF_TABLES_IPV4"
  "NF_TABLES_IPV6"
  "NF_TABLES_ARP"
  "NF_TABLES_NETDEV"
  "BRIDGE"
  "NF_TABLES_BRIDGE"
  "NF_CONNTRACK_BRIDGE"
  "NFT_BRIDGE_META"
  "NFT_BRIDGE_REJECT"
  "NFT_CT"
  "NFT_CONNLIMIT"
  "NFT_LOG"
  "NFT_LIMIT"
  "NFT_QUOTA"
  "NFT_NUMGEN"
  "NFT_HASH"
  "NFT_NAT"
  "NFT_MASQ"
  "NFT_REDIR"
  "NFT_QUEUE"
  "NFT_REJECT"
  "NFT_REJECT_INET"
  "NFT_REJECT_IPV4"
  "NFT_REJECT_IPV6"
  "NFT_REJECT_NETDEV"
  "NFT_FIB"
  "NFT_FIB_INET"
  "NFT_FIB_IPV4"
  "NFT_FIB_IPV6"
  "NFT_FIB_NETDEV"
  "NFT_SOCKET"
  "NFT_TPROXY"
  "NFT_DUP_IPV4"
  "NFT_DUP_IPV6"
  "NFT_DUP_NETDEV"
  "NFT_FWD_NETDEV"
  "NF_FLOW_TABLE"
  "NF_FLOW_TABLE_INET"
  "NFT_FLOW_OFFLOAD"
] (_: lib.kernel.yes)
