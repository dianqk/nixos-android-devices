From 4ba4479132a986c10520a94c96be46463fc9eaf2 Mon Sep 17 00:00:00 2001
From: Tatsuki Tanaka <tatsuki@tanakatatsuki.dev>
Date: Thu, 22 Oct 2026 01:28:09 +0800
Subject: [PATCH 44/46] ASoC: qcom: q6apm: stop latching topology_uncertain on
 transient failures

q6apm marked the topology as uncertain after any failed graph, map,
unmap, stop or close command, and refused all later graph, map and
unmap requests with -EUCLEAN until the APM was reinitialized. A single
transient command timeout therefore left audio unusable until reboot.

Stop setting the flag from q6apm.c and stop checking it in the graph
get, map, unmap and close paths. Report the actual command result
instead.

The flag is still set when a PCM or compressed stream teardown fails in
q6apm-dai-driver.c, where it keeps the DMA buffer retained, and it is
still checked by q6apm_hostless_claim().

Signed-off-by: Tatsuki Tanaka <tatsuki@tanakatatsuki.dev>
(cherry picked from commit 617d1e32341c20a7165219f2b512f15c1669a860)
---
 sound/soc/qcom/qdsp6/q6apm.c | 25 +++----------------------
 1 file changed, 3 insertions(+), 22 deletions(-)

diff --git a/sound/soc/qcom/qdsp6/q6apm.c b/sound/soc/qcom/qdsp6/q6apm.c
index 955da19652..56a1ff7d0f 100644
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -46,8 +46,6 @@ static struct audioreach_graph *q6apm_get_audioreach_graph(struct q6apm *apm, ui
 	int id;
 
 	guard(mutex)(&apm->graph_lock);
-	if (READ_ONCE(apm->topology_uncertain))
-		return ERR_PTR(-EUCLEAN);
 	if (apm->hostless_owner)
 		return ERR_PTR(-EBUSY);
 	mutex_lock(&apm->lock);
@@ -99,7 +97,6 @@ static struct audioreach_graph *q6apm_get_audioreach_graph(struct q6apm *apm, ui
 	id = q6apm_send_cmd_sync(apm, graph->graph, 0);
 	if (id) {
 		mutex_lock(&apm->lock);
-		WRITE_ONCE(apm->topology_uncertain, true);
 		idr_remove(&apm->graph_idr, graph_id);
 		mutex_unlock(&apm->lock);
 		kfree(graph->graph);
@@ -151,8 +148,6 @@ static void q6apm_put_audioreach_graph(struct kref *ref)
 	ret = audioreach_graph_mgmt_cmd(graph, APM_CMD_GRAPH_CLOSE);
 
 	mutex_lock(&apm->lock);
-	if (ret)
-		WRITE_ONCE(apm->topology_uncertain, true);
 	graph = idr_remove(&apm->graph_idr, graph->id);
 	mutex_unlock(&apm->lock);
 
@@ -245,8 +240,6 @@ static int __q6apm_map_memory_fixed_region(struct device *dev, unsigned int grap
 		return PTR_ERR(pkt);
 
 	guard(mutex)(&apm->graph_lock);
-	if (READ_ONCE(apm->topology_uncertain))
-		return -EUCLEAN;
 	if (apm->hostless_owner)
 		return -EBUSY;
 	info = idr_find(&apm->graph_info_idr, graph_id);
@@ -282,8 +275,6 @@ static int __q6apm_map_memory_fixed_region(struct device *dev, unsigned int grap
 	ret = q6apm_send_cmd_sync(apm, pkt, APM_CMD_RSP_SHARED_MEM_MAP_REGIONS);
 	if (!ret && !(is_pos_buf ? info->pos_buf_mem_map_handle : info->mem_map_handle))
 		ret = -EPROTO;
-	if (ret)
-		WRITE_ONCE(apm->topology_uncertain, true);
 	return ret;
 }
 
@@ -359,15 +350,12 @@ static int __q6apm_unmap_memory_fixed_region(struct q6apm *apm, unsigned int gra
 	struct audioreach_graph_info *info;
 	uint32_t mem_map_handle;
 	uint32_t pos_mask = is_pos_buf ? APM_MMAP_TOKEN_MAP_TYPE_POS_BUF : 0;
-	int ret;
 	struct gpr_pkt *pkt __free(kfree) = audioreach_alloc_apm_cmd_pkt(sizeof(*cmd),
 					APM_CMD_SHARED_MEM_UNMAP_REGIONS, (graph_id | pos_mask));
 	if (IS_ERR(pkt))
 		return PTR_ERR(pkt);
 
 	guard(mutex)(&apm->graph_lock);
-	if (READ_ONCE(apm->topology_uncertain))
-		return -EUCLEAN;
 	info = idr_find(&apm->graph_info_idr, graph_id);
 	if (!info)
 		return -ENODEV;
@@ -388,10 +376,7 @@ static int __q6apm_unmap_memory_fixed_region(struct q6apm *apm, unsigned int gra
 	if (is_pos_buf)
 		pkt->hdr.token |= APM_MMAP_TOKEN_MAP_TYPE_POS_BUF;
 
-	ret = q6apm_send_cmd_sync(apm, pkt, APM_CMD_SHARED_MEM_UNMAP_REGIONS);
-	if (ret)
-		WRITE_ONCE(apm->topology_uncertain, true);
-	return ret;
+	return q6apm_send_cmd_sync(apm, pkt, APM_CMD_SHARED_MEM_UNMAP_REGIONS);
 }
 
 int q6apm_unmap_memory_fixed_region(struct device *dev, unsigned int graph_id)
@@ -838,7 +823,6 @@ EXPORT_SYMBOL_GPL(q6apm_graph_open);
 int q6apm_graph_close(struct q6apm_graph *graph)
 {
 	struct audioreach_graph *ar_graph = graph->ar_graph;
-	struct q6apm *apm = graph->apm;
 
 	/* A queued data/event callback may still use graph and its client context. */
 	gpr_free_port_sync(graph->port);
@@ -847,7 +831,7 @@ int q6apm_graph_close(struct q6apm_graph *graph)
 	kref_put(&ar_graph->refcount, q6apm_put_audioreach_graph);
 	kfree(graph);
 
-	return READ_ONCE(apm->topology_uncertain) ? -EUCLEAN : 0;
+	return 0;
 }
 EXPORT_SYMBOL_GPL(q6apm_graph_close);
 
@@ -888,9 +872,7 @@ int q6apm_graph_stop(struct q6apm_graph *graph)
 	}
 
 	ret = audioreach_graph_mgmt_cmd(ar_graph, APM_CMD_GRAPH_STOP);
-	if (ret)
-		WRITE_ONCE(graph->apm->topology_uncertain, true);
-	else
+	if (!ret)
 		ar_graph->start_count = 0;
 	return ret;
 }
@@ -1061,7 +1043,6 @@ static int apm_callback(const struct gpr_resp_pkt *data, void *priv, int op)
 				else
 					info->mem_map_handle = 0;
 			} else {
-				WRITE_ONCE(apm->topology_uncertain, true);
 				if (!info)
 					apm->result.status = EINVAL;
 			}
