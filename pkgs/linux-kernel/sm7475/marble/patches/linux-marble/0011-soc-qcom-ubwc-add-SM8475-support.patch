From b03c165107d83b9f7a994cf1753de2d58e93c28b Mon Sep 17 00:00:00 2001
From: Tatsuki Tanaka <tatsuki@tanakatatsuki.dev>
Date: Fri, 9 Oct 2026 18:40:24 +0800
Subject: [PATCH 11/46] soc: qcom: ubwc: add SM8475 support

Add SM8475 compatible to the UBWC configuration table to configure
Universal Bandwidth Compression for Adreno and display controllers.

Signed-off-by: Tatsuki Tanaka <tatsuki@tanakatatsuki.dev>
(cherry picked from commit 56c74fe38e8973efb98bca4e2e3c85ffaa407be8)

Conflict resolution for Linux 7.3: 7.3 replaced the per-SoC UBWC data with shared ubwc_<version>_hbb<n> descriptors; SM8475 uses the SM8450 entry (ubwc_4_0_hbb16).
---
 drivers/soc/qcom/ubwc_config.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/soc/qcom/ubwc_config.c b/drivers/soc/qcom/ubwc_config.c
index 23901a4c51f7..704324d49145 100644
--- a/drivers/soc/qcom/ubwc_config.c
+++ b/drivers/soc/qcom/ubwc_config.c
@@ -161,6 +161,7 @@ static const struct of_device_id qcom_ubwc_configs[] __maybe_unused = {
 	{ .compatible = "qcom,sm8250", .data = &ubwc_4_0_hbb16, },
 	{ .compatible = "qcom,sm8350", .data = &ubwc_4_0_hbb16, },
 	{ .compatible = "qcom,sm8450", .data = &ubwc_4_0_hbb16, },
+	{ .compatible = "qcom,sm8475", .data = &ubwc_4_0_hbb16, },
 	{ .compatible = "qcom,sm8550", .data = &ubwc_4_0_hbb16, },
 	{ .compatible = "qcom,sm8650", .data = &ubwc_4_0_hbb16, },
 	{ .compatible = "qcom,sm8750", .data = &ubwc_5_0_hbb16, },
