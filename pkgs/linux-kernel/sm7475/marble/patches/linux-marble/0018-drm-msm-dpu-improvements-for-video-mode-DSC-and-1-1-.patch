From 72d4c95404388883c2c79bc5ebbd8a996abd6fd3 Mon Sep 17 00:00:00 2001
From: Tatsuki Tanaka <tatsuki@tanakatatsuki.dev>
Date: Fri, 9 Oct 2026 18:40:26 +0800
Subject: [PATCH 18/46] drm/msm/dpu: improvements for video mode DSC and 1:1:1
 topology

Program DSC registers once per mode set in video mode, implement initial
line hardening model, and support 1:1:1 DSC encoder topology for marble.

Signed-off-by: Tatsuki Tanaka <tatsuki@tanakatatsuki.dev>
(cherry picked from commit 1e060330b55a8c549b22abc51ffcd0df84e58993)
---
 drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c   | 100 +++++++++++++-----
 .../drm/msm/disp/dpu1/dpu_encoder_phys_vid.c  |   8 +-
 2 files changed, 80 insertions(+), 28 deletions(-)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
index 1f20695f81e3..47f2260d3a1e 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
@@ -17,6 +17,7 @@
 #include <drm/drm_file.h>
 #include <drm/drm_probe_helper.h>
 #include <drm/drm_framebuffer.h>
+#include <drm/display/drm_dsc_helper.h>
 
 #include "msm_drv.h"
 #include "dpu_kms.h"
@@ -215,6 +216,8 @@ struct dpu_encoder_virt {
 
 	/* DSC configuration */
 	struct drm_dsc_config *dsc;
+	/* DSC already programmed since enable (video mode: program once) */
+	bool dsc_programmed;
 };
 
 #define to_dpu_encoder_virt(x) container_of(x, struct dpu_encoder_virt, base)
@@ -659,9 +662,7 @@ void dpu_encoder_update_topology(struct drm_encoder *drm_enc,
 				 const struct drm_display_mode *adj_mode)
 {
 	struct dpu_encoder_virt *dpu_enc = to_dpu_encoder_virt(drm_enc);
-	struct msm_drm_private *priv = dpu_enc->base.dev->dev_private;
 	struct msm_display_info *disp_info = &dpu_enc->disp_info;
-	struct dpu_kms *dpu_kms = to_dpu_kms(priv->kms);
 	struct drm_connector *connector;
 	struct drm_connector_state *conn_state;
 	struct drm_framebuffer *fb;
@@ -686,10 +687,12 @@ void dpu_encoder_update_topology(struct drm_encoder *drm_enc,
 		 */
 		WARN(topology->num_intf > 2,
 		     "DSC topology cannot support more than 2 interfaces\n");
-		if (topology->num_intf >= 2 || dpu_kms->catalog->dsc_count >= 2)
-			topology->num_dsc = 2;
-		else
-			topology->num_dsc = 1;
+		/*
+		 * marble: use one DSC per interface (1:1:1). The panel takes
+		 * two 540px slices per line from a single encoder, which is
+		 * what the stock driver does and what this port is tuned for.
+		 */
+		topology->num_dsc = topology->num_intf;
 	}
 
 	connector = drm_atomic_get_new_connector_for_encoder(state, drm_enc);
@@ -1342,6 +1345,7 @@ static void dpu_encoder_virt_atomic_enable(struct drm_encoder *drm_enc,
 
 	dpu_enc = to_dpu_encoder_virt(drm_enc);
 	dpu_enc->dsc = dpu_encoder_get_dsc_config(drm_enc);
+	dpu_enc->dsc_programmed = false;
 
 	atomic_set(&dpu_enc->frame_done_timeout_cnt, 0);
 
@@ -1390,6 +1394,7 @@ static void dpu_encoder_virt_atomic_disable(struct drm_encoder *drm_enc,
 
 	dpu_enc = to_dpu_encoder_virt(drm_enc);
 	DPU_DEBUG_ENC(dpu_enc, "\n");
+	dpu_enc->dsc_programmed = false;
 
 	crtc = drm_atomic_get_old_crtc_for_encoder(state, drm_enc);
 	if (crtc)
@@ -1964,27 +1969,56 @@ int dpu_encoder_vsync_time(struct drm_encoder *drm_enc, ktime_t *wakeup_time)
 
 static u32
 dpu_encoder_dsc_initial_line_calc(struct drm_dsc_config *dsc,
-				  u32 enc_ip_width)
+				  u32 enc_ip_width, int dsc_common_mode)
 {
-	int ssm_delay, total_pixels, soft_slice_per_enc;
-
-	soft_slice_per_enc = enc_ip_width / dsc->slice_width;
-
 	/*
-	 * minimum number of initial line pixels is a sum of:
-	 * 1. sub-stream multiplexer delay (83 groups for 8bpc,
-	 *    91 for 10 bpc) * 3
-	 * 2. for two soft slice cases, add extra sub-stream multiplexer * 3
-	 * 3. the initial xmit delay
-	 * 4. total pipeline delay through the "lock step" of encoder (47)
-	 * 5. 6 additional pixels as the output of the rate buffer is
-	 *    48 bits wide
+	 * Port of the downstream (Hardent core) latency model. The previous
+	 * approximation returned 3 lines for 1080px/2x540 slices at 10bpc/
+	 * 8bpp where the hardware needs 4, starving the encoder output on
+	 * busy content (noise on changing UI elements).
 	 */
-	ssm_delay = ((dsc->bits_per_component < 10) ? 84 : 92);
-	total_pixels = ssm_delay * 3 + dsc->initial_xmit_delay + 47;
-	if (soft_slice_per_enc > 1)
-		total_pixels += (ssm_delay * 3);
-	return DIV_ROUND_UP(total_pixels, dsc->slice_width);
+	const int rtl_max_bpc = 10, rtl_output_data_width = 64;
+	const int pipeline_latency = 28;
+	int num_ss = enc_ip_width / dsc->slice_width;
+	int bpp = drm_dsc_get_bpp_int(dsc);
+	bool yuv = dsc->native_422 || dsc->native_420;
+	int container_slice_width = dsc->native_422 ?
+				    dsc->slice_width / 2 : dsc->slice_width;
+	int max_muxword_size = rtl_max_bpc >= 12 ? 64 : 48;
+	int max_ssm_delay = 4 * (rtl_max_bpc + 1) + max_muxword_size - 1;
+	int mux_word_size = dsc->bits_per_component >= 12 ? 64 : 48;
+	int compress_bpp_group = dsc->native_422 ? 2 * bpp : bpp;
+	int input_ssm_out_latency = pipeline_latency +
+				    3 * (max_ssm_delay + 2) * num_ss;
+	int ob_data_width, obuf_latency, base_hs_latency, chunk_bits;
+	int output_rate_extra_budget_bits, multi_hs_extra_budget_bits;
+	bool multi_hs_c, multi_hs_d;
+
+	if (yuv)
+		ob_data_width = rtl_output_data_width >= 2 * max_muxword_size ?
+				rtl_output_data_width : 2 * rtl_output_data_width;
+	else
+		ob_data_width = rtl_output_data_width >= max_muxword_size ?
+				rtl_output_data_width : 2 * rtl_output_data_width;
+
+	obuf_latency = DIV_ROUND_UP(9 * ob_data_width + mux_word_size,
+				    compress_bpp_group) + 1;
+	base_hs_latency = dsc->initial_xmit_delay + input_ssm_out_latency +
+			  obuf_latency;
+	chunk_bits = 8 * dsc->slice_chunk_size;
+	output_rate_extra_budget_bits =
+		((ob_data_width - compress_bpp_group) * chunk_bits) >>
+		(ob_data_width == 128 ? 7 : 6);
+	multi_hs_c = (dsc_common_mode & DSC_MODE_SPLIT_PANEL) &&
+		     (dsc_common_mode & DSC_MODE_MULTIPLEX);
+	multi_hs_d = num_ss > 1 && ob_data_width > compress_bpp_group;
+	multi_hs_extra_budget_bits = (multi_hs_c || multi_hs_d) ?
+				     chunk_bits : output_rate_extra_budget_bits;
+
+	return DIV_ROUND_UP(base_hs_latency +
+			    DIV_ROUND_UP(multi_hs_extra_budget_bits,
+					 compress_bpp_group),
+			    container_slice_width);
 }
 
 static void dpu_encoder_dsc_pipe_cfg(struct dpu_hw_ctl *ctl,
@@ -2052,7 +2086,8 @@ static void dpu_encoder_prep_dsc(struct dpu_encoder_virt *dpu_enc,
 	intf_ip_w = this_frame_slices * dsc->slice_width;
 
 	enc_ip_w = intf_ip_w / num_dsc;
-	initial_lines = dpu_encoder_dsc_initial_line_calc(dsc, enc_ip_w);
+	initial_lines = dpu_encoder_dsc_initial_line_calc(dsc, enc_ip_w,
+							  dsc_common_mode);
 
 	for (i = 0; i < num_dsc; i++)
 		dpu_encoder_dsc_pipe_cfg(ctl, hw_dsc[i], hw_pp[i],
@@ -2098,8 +2133,21 @@ void dpu_encoder_prepare_for_kickoff(struct drm_encoder *drm_enc)
 		}
 	}
 
-	if (dpu_enc->dsc)
+	if (needs_hw_reset)
+		dpu_enc->dsc_programmed = false;
+
+	/*
+	 * In video mode the DSC encoder runs continuously; re-programming and
+	 * flushing it on every commit corrupts the slice row being encoded at
+	 * that moment (noise bands on updating content). Program it once per
+	 * enable (or after a CTL reset), like the downstream driver.
+	 */
+	if (dpu_enc->dsc && (!dpu_enc->dsc_programmed ||
+			     !dpu_enc->cur_master ||
+			     dpu_enc->cur_master->intf_mode != INTF_MODE_VIDEO)) {
 		dpu_encoder_prep_dsc(dpu_enc, dpu_enc->dsc);
+		dpu_enc->dsc_programmed = true;
+	}
 }
 
 /**
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
index ba810f26ea30..d4af7330675b 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
@@ -134,8 +134,12 @@ static void drm_mode_to_intf_timing_params(
 		 * TODO: replace drm_dsc_get_bpp_int with logic to handle
 		 * fractional part if there is fraction
 		 */
-		timing->width = timing->width * drm_dsc_get_bpp_int(dsc) /
-				(dsc->bits_per_component * 3);
+		/*
+		 * The DPU->DSI interface carries 24 bits per pclk regardless of
+		 * the panel's bpc, so the compressed line is bpp*width/24 pclks.
+		 * (bpc*3 only equals 24 for 8bpc; 10bpc panels underflow.)
+		 */
+		timing->width = timing->width * drm_dsc_get_bpp_int(dsc) / 24;
 		timing->xres = timing->width;
 		timing->dce_bytes_per_line = msm_dsc_get_bytes_per_line(dsc);
 	}
