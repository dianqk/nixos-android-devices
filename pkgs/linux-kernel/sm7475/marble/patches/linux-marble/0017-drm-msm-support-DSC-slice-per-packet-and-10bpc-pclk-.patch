From b2fff3d7eae601be7e98c32921e77b135c6bde8c Mon Sep 17 00:00:00 2001
From: Tatsuki Tanaka <tatsuki@tanakatatsuki.dev>
Date: Fri, 9 Oct 2026 18:40:26 +0800
Subject: [PATCH 17/46] drm/msm: support DSC slice per packet and 10bpc pclk
 calculation

Allow panels to request slice-per-packet DSC packetization in MIPI DSI,
and compute 24-bit byte-clock frequencies correctly for 10bpc video mode
displays.

Signed-off-by: Tatsuki Tanaka <tatsuki@tanakatatsuki.dev>
(cherry picked from commit dc485a6ffde3e8599769f5a338c8a594cef70259)

Conflict resolution for Linux 7.3: the slice-per-packet half is upstream as ce73a5db44e3 (drm/msm/dsi: support DSC configurations with slice_per_pkt > 1), so the mipi_dsi_device.dsc_slice_per_pkt field and its DSI-host use are dropped and the M16T panel driver (from 0a462f6a9edf) sets MIPI_DSI_MODE_DSC_ALL_SLICES_IN_PKT instead (slice_count = 2, the same 2 slices per packet). Kept: the 24-bit-per-pclk video-mode clock/timing for 10 bpc, and panel-provided RC parameters, now guarding the DSC 1.1/1.2 RC selection added by the shared dsi-dsc-12-rc-model patch. The shared DSC 1.2 first-line formula yields 13 for this panel's 20-line slices, equal to the panel's value.
---
 drivers/gpu/drm/msm/dsi/dsi_host.c            | 46 +++++++++++--------
 .../drm/panel/panel-xiaomi-m16t-36-02-0a.c    |  9 ++--
 2 files changed, 34 insertions(+), 21 deletions(-)

diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index c73a76c584eb..e421bc7ca892 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -617,8 +617,8 @@ dsi_adjust_pclk_for_compression(const struct drm_display_mode *mode,
 	if (is_bonded_dsi)
 		hdisplay /= 2;
 
-	new_hdisplay = DIV_ROUND_UP(hdisplay * drm_dsc_get_bpp_int(dsc),
-				    dsc->bits_per_component * 3);
+	/* 24 bits per pclk on the DPU->DSI bus, independent of bpc */
+	new_hdisplay = DIV_ROUND_UP(hdisplay * drm_dsc_get_bpp_int(dsc), 24);
 
 	if (is_bonded_dsi)
 		new_hdisplay *= 2;
@@ -1067,8 +1067,12 @@ static void dsi_timing_setup(struct msm_dsi_host *msm_host, bool is_bonded_dsi)
 		 */
 		h_total -= hdisplay;
 		if (wide_bus_enabled) {
+			/*
+			 * marble: keep video mode at 24 bits per pclk to match
+			 * the DPU timing and pclk adjustment (proven on 10bpc).
+			 */
 			if (msm_host->mode_flags & MIPI_DSI_MODE_VIDEO)
-				bits_per_pclk = dsc->bits_per_component * 3;
+				bits_per_pclk = 24;
 			else
 				bits_per_pclk = 48;
 		} else {
@@ -1914,21 +1918,27 @@ static int dsi_populate_dsc_params(struct msm_dsi_host *msm_host, struct drm_dsc
 		return -EOPNOTSUPP;
 	}
 
-	switch (dsc->dsc_version_minor) {
-	case 1:
-		/* Keep the existing pre-SCR parameters for DSC 1.1 panels. */
-		ret = drm_dsc_setup_rc_params(dsc, DRM_DSC_1_1_PRE_SCR);
-		break;
-	case 2:
-		/* DSI currently supplies RGB input, without native 4:2:x. */
-		ret = drm_dsc_setup_rc_params(dsc, DRM_DSC_1_2_444);
-		break;
-	default:
-		ret = -EOPNOTSUPP;
-	}
-	if (ret) {
-		DRM_DEV_ERROR(&msm_host->pdev->dev, "could not find DSC RC parameters\n");
-		return ret;
+	/*
+	 * Some panels (e.g. Novatek DDICs) have a fixed decoder config and
+	 * provide matching RC parameters themselves; don't overwrite them.
+	 */
+	if (!dsc->rc_range_params[DSC_NUM_BUF_RANGES - 1].range_max_qp) {
+		switch (dsc->dsc_version_minor) {
+		case 1:
+			/* Keep the existing pre-SCR parameters for DSC 1.1 panels. */
+			ret = drm_dsc_setup_rc_params(dsc, DRM_DSC_1_1_PRE_SCR);
+			break;
+		case 2:
+			/* DSI currently supplies RGB input, without native 4:2:x. */
+			ret = drm_dsc_setup_rc_params(dsc, DRM_DSC_1_2_444);
+			break;
+		default:
+			ret = -EOPNOTSUPP;
+		}
+		if (ret) {
+			DRM_DEV_ERROR(&msm_host->pdev->dev, "could not find DSC RC parameters\n");
+			return ret;
+		}
 	}
 
 	/* DSC 1.2's first-line budget depends on the actual slice height. */
diff --git a/drivers/gpu/drm/panel/panel-xiaomi-m16t-36-02-0a.c b/drivers/gpu/drm/panel/panel-xiaomi-m16t-36-02-0a.c
index 1260b4759968..6a931226f0c4 100644
--- a/drivers/gpu/drm/panel/panel-xiaomi-m16t-36-02-0a.c
+++ b/drivers/gpu/drm/panel/panel-xiaomi-m16t-36-02-0a.c
@@ -342,7 +342,8 @@ static int xiaomi_m16t_probe(struct mipi_dsi_device *dsi)
 	dsi->lanes = 4;
 	dsi->format = MIPI_DSI_FMT_RGB888;
 	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
-			  MIPI_DSI_CLOCK_NON_CONTINUOUS | MIPI_DSI_MODE_LPM;
+			  MIPI_DSI_CLOCK_NON_CONTINUOUS | MIPI_DSI_MODE_LPM |
+			  MIPI_DSI_MODE_DSC_ALL_SLICES_IN_PKT;
 
 	ctx->panel.prepare_prev_first = true;
 
@@ -359,8 +360,10 @@ static int xiaomi_m16t_probe(struct mipi_dsi_device *dsi)
 	ctx->dsc.dsc_version_major = 1;
 	ctx->dsc.dsc_version_minor = 2;
 
-	/* stock qcom,mdss-dsc-slice-per-pkt = <2>: one packet per line */
-	dsi->dsc_slice_per_pkt = 2;
+	/*
+	 * stock qcom,mdss-dsc-slice-per-pkt = <2>: one packet per line;
+	 * MIPI_DSI_MODE_DSC_ALL_SLICES_IN_PKT selects slice_count (2) per packet.
+	 */
 	ctx->dsc.slice_height = 20;
 	ctx->dsc.slice_width = 540;
 	/*
