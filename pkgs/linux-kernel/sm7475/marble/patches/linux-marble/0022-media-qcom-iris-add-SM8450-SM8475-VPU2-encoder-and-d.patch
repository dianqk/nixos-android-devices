@@ -554,6 +572,8 @@ static int iris_create_internal_buffer(struct iris_inst *inst,
 		return -ENOMEM;
 	}
 
+out:
+
 	list_add_tail(&buffer->list, &buffers->list);
 
 	return 0;
@@ -635,7 +655,8 @@ int iris_queue_internal_buffers(struct iris_inst *inst, u32 plane)
 				continue;
 			if (buffer->attr & BUF_ATTR_QUEUED)
 				continue;
-			if (buffer->type == BUF_DPB && inst->state != IRIS_INST_STREAMING) {
+			if (buffer->type == BUF_DPB && inst->domain == DECODER &&
+			    inst->state != IRIS_INST_STREAMING) {
 				buffer->attr |= BUF_ATTR_DEFERRED;
 				continue;
 			}
@@ -653,8 +674,11 @@ void iris_destroy_internal_buffer(struct iris_inst *inst, struct iris_buffer *bu
 	struct iris_core *core = inst->core;
 
 	list_del(&buffer->list);
-	dma_free_attrs(core->dev, buffer->buffer_size, buffer->kvaddr,
-		       buffer->device_addr, buffer->dma_attrs);
+	if (buffer->type == BUF_ARP && iris_arp_pool_enabled(core))
+		iris_arp_free(inst, buffer);
+	else
+		dma_free_attrs(core->dev, buffer->buffer_size, buffer->kvaddr,
+			       buffer->device_addr, buffer->dma_attrs);
 	kfree(buffer);
 }
 
