From 6e5b17f62a4a2cd868f971cbb2e4532ae12e1d58 Mon Sep 17 00:00:00 2001
From: Tatsuki Tanaka <tatsuki@tanakatatsuki.dev>
Date: Fri, 9 Oct 2026 18:40:25 +0800
Subject: [PATCH 15/46] clk: qcom: sm8450: poll USB GDSC and keep UFS PHY GDSC
 enabled

Poll USB30_PRIM_GDSC via CFG_GDSCR to ensure complete power-up
handshake and keep UFS_PHY_GDSC always on to prevent UFS bus faults
during power collapses.

Signed-off-by: Tatsuki Tanaka <tatsuki@tanakatatsuki.dev>
(cherry picked from commit c003e63411110863a6d087c3c79961e241ca266d)
---
 drivers/clk/qcom/gcc-sm8450.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/drivers/clk/qcom/gcc-sm8450.c b/drivers/clk/qcom/gcc-sm8450.c
index b18bb34889ab..46465db4115a 100644
--- a/drivers/clk/qcom/gcc-sm8450.c
+++ b/drivers/clk/qcom/gcc-sm8450.c
@@ -3134,6 +3134,7 @@ static struct gdsc ufs_phy_gdsc = {
 		.name = "ufs_phy_gdsc",
 	},
 	.pwrsts = PWRSTS_OFF_ON,
+	.flags = ALWAYS_ON,
 };
 
 static struct gdsc usb30_prim_gdsc = {
@@ -3142,6 +3143,7 @@ static struct gdsc usb30_prim_gdsc = {
 		.name = "usb30_prim_gdsc",
 	},
 	.pwrsts = PWRSTS_OFF_ON,
+	.flags = POLL_CFG_GDSCR | RETAIN_FF_ENABLE,
 };
 
 static struct clk_regmap *gcc_sm8450_clocks[] = {
