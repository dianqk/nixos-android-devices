From 71004c6fe5353a638a07a62d0cc452d43c4b6d60 Mon Sep 17 00:00:00 2001
From: Tatsuki Tanaka <tatsuki@tanakatatsuki.dev>
Date: Fri, 9 Oct 2026 18:40:29 +0800
Subject: [PATCH 26/46] arm64: dts: qcom: sm8450: add EPSS L3, iris, and IPA
 nodes

Add SoC-level device tree nodes for EPSS L3 cache interconnect, Iris
video accelerator, IPA networking block, and PM8350B SPMI haptics.

Signed-off-by: Tatsuki Tanaka <tatsuki@tanakatatsuki.dev>
(cherry picked from commit 484131af2ab8ca416df0fba50e936bfa2e1a9294)
---
 arch/arm64/boot/dts/qcom/pm8350b.dtsi |   9 +
 arch/arm64/boot/dts/qcom/sm8450.dtsi  | 472 ++++++++++++++++++++++++++
 2 files changed, 481 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/pm8350b.dtsi b/arch/arm64/boot/dts/qcom/pm8350b.dtsi
index cf82f8a64a9b..733ccbbaba67 100644
--- a/arch/arm64/boot/dts/qcom/pm8350b.dtsi
+++ b/arch/arm64/boot/dts/qcom/pm8350b.dtsi
@@ -53,5 +53,14 @@ pm8350b_gpios: gpio@8800 {
 			interrupt-controller;
 			#interrupt-cells = <2>;
 		};
+
+		pm8350b_haptics: haptics@f000 {
+			compatible = "qcom,spmi-haptics";
+			reg = <0xf000>, <0xf100>;
+			reg-names = "cfg", "ptn";
+			interrupts = <0x3 0xf0 0x1 IRQ_TYPE_EDGE_RISING>;
+			interrupt-names = "fifo-empty";
+			status = "disabled";
+		};
 	};
 };
