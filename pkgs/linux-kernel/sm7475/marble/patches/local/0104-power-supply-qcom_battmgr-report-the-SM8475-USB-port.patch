From 0ad96de14eabe2ee6dc7f070049d18bfa8f47876 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Mon, 2 Nov 2026 09:24:17 +0800
Subject: [PATCH 136/136] power: supply: qcom_battmgr: report the SM8475 USB
 port type

The SM8475 battery manager firmware answers USB_TYPE with SDP for any
wired USB input; the detected port type (SDP, DCP, CDP, ...) is in
USB_ADAP_TYPE, which is what the vendor driver (qti_battery_charger)
reports as the USB type. Read USB_ADAP_TYPE for the USB type on the
firmware with the SM8475 battery property layout.

Signed-off-by: dianqk <dianqk@dianqk.net>
---
 drivers/power/supply/qcom_battmgr.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/drivers/power/supply/qcom_battmgr.c b/drivers/power/supply/qcom_battmgr.c
index d984f9c9cc..63f30e8b8c 100644
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -1055,6 +1055,13 @@ static int qcom_battmgr_usb_sm8350_update(struct qcom_battmgr *battmgr,
 		return -EINVAL;
 
 	prop = sm8350_usb_prop_map[psp];
+	/*
+	 * The SM8475 firmware reports the detected port type (SDP, CDP, DCP,
+	 * ...) as USB_ADAP_TYPE, as its vendor driver reads it; USB_TYPE
+	 * stays at SDP for any wired USB input.
+	 */
+	if (psp == POWER_SUPPLY_PROP_USB_TYPE && battmgr->bat_const_curr_id)
+		prop = USB_ADAP_TYPE;
 
 	mutex_lock(&battmgr->lock);
 	ret = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_GET, prop, 0);
@@ -1601,6 +1608,7 @@ static void qcom_battmgr_sm8350_callback(struct qcom_battmgr *battmgr,
 			battmgr->usb.current_limit = le32_to_cpu(resp->intval.value);
 			break;
 		case USB_TYPE:
+		case USB_ADAP_TYPE:
 			battmgr->usb.usb_type = le32_to_cpu(resp->intval.value);
 			break;
 		default:
