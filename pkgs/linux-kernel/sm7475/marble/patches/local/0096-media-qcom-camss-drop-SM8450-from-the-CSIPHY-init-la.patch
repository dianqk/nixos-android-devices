From 097ce00deed1e88d396734fd189c9000592e3fdb Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Mon, 2 Nov 2026 07:43:21 +0800
Subject: [PATCH 122/135] media: qcom: camss: drop SM8450 from the CSIPHY init
 lane table

The C-PHY series that follows selects the CSIPHY lane table when the
lanes are enabled, once the PHY type is known, instead of in
csiphy_init(). Remove the SM8450 case that the SM8450 CAMSS patch added
to csiphy_init() so the series applies unchanged; the next SM8450 patch
adds it to the new selection.

SM8450 CAMSS has no lane table between this commit and that one.

Signed-off-by: dianqk <dianqk@dianqk.net>
---
 drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c | 1 -
 1 file changed, 1 deletion(-)

diff --git a/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c b/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c
index d347fdb0d3..6a756e3ab0 100644
--- a/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c
+++ b/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c
@@ -1250,7 +1250,6 @@ static int csiphy_init(struct csiphy_device *csiphy)
 		regs->lane_regs = &lane_regs_sc8280xp[0];
 		regs->lane_array_size = ARRAY_SIZE(lane_regs_sc8280xp);
 		break;
-	case CAMSS_8450:
 	case CAMSS_X1E80100:
 		regs->lane_regs = &lane_regs_x1e80100[0];
 		regs->lane_array_size = ARRAY_SIZE(lane_regs_x1e80100);
