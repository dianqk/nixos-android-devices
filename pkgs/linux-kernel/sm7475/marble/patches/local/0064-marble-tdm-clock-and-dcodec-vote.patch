From bd3b4971b533db561e1040f853c4443652739d46 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Sun, 25 Oct 2026 15:57:01 +0800
Subject: [PATCH] ASoC: qcom: hold the Marble TDM bit clock and DCODEC vote

Keep both resources under the card's backend lifetime, with the matching binding and DT clock entries.

Source changes (original messages and trailers follow).

Source-commit: d1b08fd469dd778d2faacf0e81c2801a6fa6b5ec
Source-author: dianqk <dianqk@dianqk.net>
Source-date: 2026-10-25T15:57:01+08:00
Imported-from: pkgs/linux-kernel/sm7475/marble/patches/local/0064-ASoC-dt-bindings-qcom-sm8250-add-the-optional-TDM-bi.patch

ASoC: dt-bindings: qcom,sm8250: add the optional TDM bit clock

Boards like the Xiaomi Poco F5 (marble) let the card request the TDM
bit clock for the whole backend session, as iLtanaka's linux-marble does
(f5bc71d7372e "ASoC: qcom: sc8280xp: support TDM backends and 32-bit
slots", https://github.com/iLtanaka/linux-marble). Allow a second
optional "tdm-bclk" clock after "tdm-vote".

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

Source-commit: 24ed8900315464573dd0fe429b688961419c93f8
Source-author: dianqk <dianqk@dianqk.net>
Source-date: 2026-10-25T15:57:25+08:00
Imported-from: pkgs/linux-kernel/sm7475/marble/patches/local/0065-ASoC-qcom-sc8280xp-hold-the-Marble-TDM-bit-clock-fro.patch

ASoC: qcom: sc8280xp: hold the Marble TDM bit clock from backend startup

On the Xiaomi Poco F5 (marble) the top AW88263S amplifier (slot 0) stays
silent on this kernel, while iLtanaka's linux-marble plays it cleanly with
the same amplifier registers, topology framing and DSP parameters. One
remaining difference on the speaker path is who requests the tertiary TDM
bit clock and when:

- linux-marble (f5bc71d7372e "ASoC: qcom: sc8280xp: support TDM backends
  and 32-bit slots", https://github.com/iLtanaka/linux-marble): the card
  sets the "tdm-bclk" clock to rate x slots x width and enables it in the
  backend startup, before the DSP graph is opened, and disables it in the
  backend shutdown, before the graph is stopped and closed;
- here: the backend DAI's "bclk" clock was enabled by set_sysclk() from
  the link hw_params and released by the DAI shutdown after the graph was
  closed.

Do the same as linux-marble for cards with "tdm-vote": an optional
"tdm-bclk" clock, rate from the board TDM rate and the DAI-node slot
layout (96 kHz x 4 x 32 = 12.288 MHz on Marble), held from backend
startup to shutdown. Without that clock nothing changes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

Source-commit: 4e95812d8e1b9a8cf193b07bcf8bdd9b3e6c0758
Source-author: dianqk <dianqk@dianqk.net>
Source-date: 2026-10-25T15:57:34+08:00
Imported-from: pkgs/linux-kernel/sm7475/marble/patches/local/0066-arm64-dts-qcom-sm8475-xiaomi-marble-let-the-card-hol.patch

arm64: dts: qcom: sm8475-xiaomi-marble: let the card hold the TDM bit clock

Move the tertiary TDM bit clock (LPASS_CLK_ID_TER_TDM_IBIT) from the
backend DAI node ("bclk", enabled from hw_params until after the DSP
graph is closed) to the sound card ("tdm-bclk", enabled from backend
startup until before the graph is stopped), as iLtanaka's linux-marble
DT does (f5bc71d7372e, c9f87aac17d3, https://github.com/iLtanaka/linux-marble),
whose top speaker plays.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

Source-commit: 51b8c269a6b6f97e3dd93496833eded8ead8f644
Source-author: dianqk <dianqk@dianqk.net>
Source-date: 2026-10-25T18:09:49+08:00
Imported-from: pkgs/linux-kernel/sm7475/marble/patches/local/0070-ASoC-dt-bindings-qcom-sm8250-add-the-optional-TDM-DC.patch

ASoC: dt-bindings: qcom,sm8250: add the optional TDM DCODEC vote

Since the LPASS WSA, VA, TX and RX macros moved their "macro" and
"dcodec" votes to the PM clock framework with a 100 ms autosuspend
(cd054a6e272c, eb667d0fbdd3, b9b23e72abef, b05482e7ce1b, all in 7.3),
no consumer holds LPASS_HW_DCODEC_VOTE while only a TDM backend plays;
before, each macro held both votes from probe to remove. Allow a third
optional "tdm-dcodec-vote" clock that the card holds for the TDM
backend session.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

Source-commit: 6b10f550a52047933d1170f5132552d97d9048b0
Source-author: dianqk <dianqk@dianqk.net>
Source-date: 2026-10-25T18:10:19+08:00
Imported-from: pkgs/linux-kernel/sm7475/marble/patches/local/0071-ASoC-qcom-sc8280xp-hold-the-LPASS-DCODEC-vote-for-th.patch

ASoC: qcom: sc8280xp: hold the LPASS DCODEC vote for the TDM backend

On the Xiaomi Poco F5 (marble) the bottom speaker plays noise on this
kernel and the piano on iLtanaka's 7.2.8 linux-marble. GPR traces of the
same trial on both kernels have byte-identical APM commands and data
buffers; the only difference is the PRM HW core votes. On 7.2.8 the
five LPASS macros (RX, TX, VA, WSA, WSA2) hold LPASS_HW_MACRO_VOTE and
LPASS_HW_DCODEC_VOTE from probe, so both stay requested (enable count 5
at idle) and playback sends no core votes. In 7.3 the macros moved
these votes to the PM clock framework with a 100 ms autosuspend
(cd054a6e272c, eb667d0fbdd3, b9b23e72abef, b05482e7ce1b), so with only
the speaker TDM backend running the card's "tdm-vote" keeps the MACRO
block and nothing keeps DCODEC: it is requested only when some LPASS
consumer resumes briefly (the LPI pinctrl when debugfs/gpio is read)
and released ~0.1 s later, every ~1.4 s during playback in the trace.

Hold an optional "tdm-dcodec-vote" clock with "tdm-vote" from backend
startup to shutdown, so the DCODEC block stays voted for the whole TDM
session as on 7.2.8. Without that clock nothing changes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

Source-commit: 39823fa14f42537eefb55f82a66b5ed4b2d5106e
Source-author: dianqk <dianqk@dianqk.net>
Source-date: 2026-10-25T18:10:28+08:00
Imported-from: pkgs/linux-kernel/sm7475/marble/patches/local/0072-arm64-dts-qcom-sm8475-xiaomi-marble-hold-the-DCODEC-.patch

arm64: dts: qcom: sm8475-xiaomi-marble: hold the DCODEC vote for the speakers

Give the sound card the optional "tdm-dcodec-vote" clock
(LPASS_HW_DCODEC_VOTE), so LPASS_HW_DCODEC stays voted while the speaker
TDM backend runs, as it is on iLtanaka's 7.2.8 linux-marble where the
LPASS macros hold it from probe.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/sound/qcom,sm8250.yaml           | 10 ++-
 .../boot/dts/qcom/sm8475-xiaomi-marble.dts    | 23 +++----
 sound/soc/qcom/sc8280xp.c                     | 67 ++++++++++++++++++-
 3 files changed, 82 insertions(+), 18 deletions(-)

diff --git a/Documentation/devicetree/bindings/sound/qcom,sm8250.yaml b/Documentation/devicetree/bindings/sound/qcom,sm8250.yaml
index 438d552184..698f4b738f 100644
--- a/Documentation/devicetree/bindings/sound/qcom,sm8250.yaml
+++ b/Documentation/devicetree/bindings/sound/qcom,sm8250.yaml
@@ -75,14 +75,20 @@ properties:
     description: User visible long sound card name
 
   clocks:
-    maxItems: 1
+    minItems: 1
+    maxItems: 3
 
   clock-names:
+    minItems: 1
     items:
       - const: tdm-vote
+      - const: tdm-bclk
+      - const: tdm-dcodec-vote
     description:
       LPASS core vote held while a TDM backend is active, for boards whose
-      TDM interface needs it.
+      TDM interface needs it, optionally the TDM bit clock, requested by
+      the card for the whole backend session, and optionally the LPASS
+      digital codec core vote, held for the same session.
 
   speaker-earpiece-gpios:
     maxItems: 1
diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-marble.dts b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-marble.dts
index 58f51e5b30..8f85d9767a 100644
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-marble.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-marble.dts
@@ -1185,17 +1185,6 @@ data1-pins {
 	};
 };
 
-&q6apmbedai {
-	#address-cells = <1>;
-	#size-cells = <0>;
-
-	dai@56 {
-		reg = <TERTIARY_TDM_RX_0>;
-		clocks = <&q6prmcc LPASS_CLK_ID_TER_TDM_IBIT LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
-		clock-names = "bclk";
-	};
-};
-
 &sound {
 	compatible = "xiaomi,marble-sndcard", "qcom,sm8450-sndcard";
 	model = "SM8475-Xiaomi-Marble";
@@ -1204,9 +1193,15 @@ &sound {
 	pinctrl-0 = <&tert_mi2s_active>;
 	pinctrl-names = "default";
 
-	/* Stock: qcom,mi2s-tdm-is-hw-vote-needed for the tertiary interface */
-	clocks = <&q6prmcc LPASS_HW_MACRO_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
-	clock-names = "tdm-vote";
+	/*
+	 * Stock: qcom,mi2s-tdm-is-hw-vote-needed for the tertiary interface.
+	 * The card holds the TDM bit clock and the DCODEC vote (no longer
+	 * held by the runtime-PM LPASS macros) for the whole backend session.
+	 */
+	clocks = <&q6prmcc LPASS_HW_MACRO_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+		 <&q6prmcc LPASS_CLK_ID_TER_TDM_IBIT LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+		 <&q6prmcc LPASS_HW_DCODEC_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
+	clock-names = "tdm-vote", "tdm-bclk", "tdm-dcodec-vote";
 
 	/* Analog mics on the WCD9385; ADCs feed the TX macro over SoundWire */
 	audio-routing = "AMIC1", "MIC BIAS1",
diff --git a/sound/soc/qcom/sc8280xp.c b/sound/soc/qcom/sc8280xp.c
index cc7c85bfa8..1f4d0eee30 100644
--- a/sound/soc/qcom/sc8280xp.c
+++ b/sound/soc/qcom/sc8280xp.c
@@ -88,6 +88,8 @@ struct sc8280xp_snd_data {
 	struct snd_soc_jack dp_jack[8];
 	const struct qcom_snd_soc_common *priv;
 	struct clk *tdm_vote;
+	struct clk *tdm_bclk;
+	struct clk *tdm_dcodec_vote;
 	bool jack_setup;
 };
 
@@ -390,6 +392,37 @@ static bool sc8280xp_is_tdm(struct snd_soc_dai *cpu_dai)
 	return cpu_dai->id >= PRIMARY_TDM_RX_0 && cpu_dai->id <= QUINARY_TDM_TX_7;
 }
 
+/*
+ * Card-held TDM bit clock ("tdm-bclk"): set to the backend rate times the
+ * DAI-node slot layout and enabled from backend startup to shutdown, so it
+ * runs before the DSP graph is opened and stops before the graph is torn
+ * down.
+ */
+static int sc8280xp_tdm_bclk_enable(struct snd_soc_pcm_runtime *rtd)
+{
+	struct sc8280xp_snd_data *data = snd_soc_card_get_drvdata(rtd->card);
+	struct qcom_snd_tdm_slot_cfg cpu_cfg;
+	struct qcom_snd_tdm_slot_cfg codec_cfg;
+	int ret;
+
+	if (!data->tdm_bclk)
+		return 0;
+
+	ret = qcom_snd_get_dai_tdm_slots(rtd, &cpu_cfg, &codec_cfg);
+	if (ret)
+		return ret;
+
+	if (!data->priv->tdm_rate || !cpu_cfg.slots || !cpu_cfg.slot_width)
+		return -EINVAL;
+
+	ret = clk_set_rate(data->tdm_bclk,
+			   data->priv->tdm_rate * cpu_cfg.slots * cpu_cfg.slot_width);
+	if (ret)
+		return ret;
+
+	return clk_prepare_enable(data->tdm_bclk);
+}
+
 static int sc8280xp_snd_startup(struct snd_pcm_substream *substream)
 {
 	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
@@ -401,11 +434,28 @@ static int sc8280xp_snd_startup(struct snd_pcm_substream *substream)
 		ret = clk_prepare_enable(data->tdm_vote);
 		if (ret)
 			return ret;
+
+		ret = clk_prepare_enable(data->tdm_dcodec_vote);
+		if (ret) {
+			clk_disable_unprepare(data->tdm_vote);
+			return ret;
+		}
+
+		ret = sc8280xp_tdm_bclk_enable(rtd);
+		if (ret) {
+			dev_err(rtd->dev, "failed to enable TDM bit clock: %d\n", ret);
+			clk_disable_unprepare(data->tdm_dcodec_vote);
+			clk_disable_unprepare(data->tdm_vote);
+			return ret;
+		}
 	}
 
 	ret = qcom_snd_sdw_startup(substream);
-	if (ret && sc8280xp_is_tdm(cpu_dai))
+	if (ret && sc8280xp_is_tdm(cpu_dai)) {
+		clk_disable_unprepare(data->tdm_bclk);
+		clk_disable_unprepare(data->tdm_dcodec_vote);
 		clk_disable_unprepare(data->tdm_vote);
+	}
 
 	return ret;
 }
@@ -418,8 +468,11 @@ static void sc8280xp_snd_shutdown(struct snd_pcm_substream *substream)
 
 	qcom_snd_sdw_shutdown(substream);
 
-	if (sc8280xp_is_tdm(cpu_dai))
+	if (sc8280xp_is_tdm(cpu_dai)) {
+		clk_disable_unprepare(data->tdm_bclk);
+		clk_disable_unprepare(data->tdm_dcodec_vote);
 		clk_disable_unprepare(data->tdm_vote);
+	}
 }
 
 static const struct snd_soc_ops sc8280xp_be_ops = {
@@ -470,6 +523,16 @@ static int sc8280xp_platform_probe(struct platform_device *pdev)
 		if (IS_ERR(data->tdm_vote))
 			return dev_err_probe(dev, PTR_ERR(data->tdm_vote),
 					     "failed to get tdm-vote clock\n");
+
+		data->tdm_bclk = devm_clk_get_optional(dev, "tdm-bclk");
+		if (IS_ERR(data->tdm_bclk))
+			return dev_err_probe(dev, PTR_ERR(data->tdm_bclk),
+					     "failed to get tdm-bclk clock\n");
+
+		data->tdm_dcodec_vote = devm_clk_get_optional(dev, "tdm-dcodec-vote");
+		if (IS_ERR(data->tdm_dcodec_vote))
+			return dev_err_probe(dev, PTR_ERR(data->tdm_dcodec_vote),
+					     "failed to get tdm-dcodec-vote clock\n");
 	}
 
 	/*
