From 0b1a170b6f124d1c5b293866971d6512341bee85 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Mon, 2 Nov 2026 07:43:50 +0800
Subject: [PATCH 128/135] media: qcom: camss: select the SM8450 CSIPHY lane
 table per PHY type

Restore the SM8450 CSIPHY D-PHY lane table (shared with X1E80100, the
Qualcomm CSIPHY v2.1.0 table) and its 0x1000 common block offset in the
lane selection introduced by the C-PHY series. C-PHY has no SM8450 lane
settings yet.

Signed-off-by: dianqk <dianqk@dianqk.net>
---
 drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c b/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c
index 4070ec11c0..322ab3a4e1 100644
--- a/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c
+++ b/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c
@@ -1293,6 +1293,7 @@ static void csiphy_lanes_enable(struct csiphy_device *csiphy,
 			regs->lane_array_size = 0;
 		}
 		break;
+	case CAMSS_8450:
 	case CAMSS_X1E80100:
 		if (c->phy_cfg == V4L2_MBUS_CSI2_DPHY) {
 			regs->lane_regs = &lane_regs_x1e80100[0];
@@ -1392,6 +1393,7 @@ static int csiphy_init(struct csiphy_device *csiphy)
 	regs->common_status_offset = 0xb0;
 
 	switch (csiphy->camss->res->version) {
+	case CAMSS_8450:
 	case CAMSS_X1E80100:
 	case CAMSS_8550:
 	case CAMSS_8650:
