+struct s5k3p9 {
+	struct device *dev;
+	struct i2c_client *client;
+	struct regmap *regmap;
+	struct clk *mclk;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(s5k3p9_supply_names)];
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *vblank;
+
+	ktime_t power_off_time;
+};
+
+static inline struct s5k3p9 *to_s5k3p9(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct s5k3p9, sd);
+}
+
+static int s5k3p9_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct s5k3p9 *s5k3p9 = container_of(ctrl->handler, struct s5k3p9, ctrls);
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		/* Keep the exposure within the new frame length. */
+		u32 max = S5K3P9_HEIGHT + ctrl->val - S5K3P9_EXPOSURE_MARGIN;
+
+		ret = __v4l2_ctrl_modify_range(s5k3p9->exposure,
+					       s5k3p9->exposure->minimum, max,
+					       s5k3p9->exposure->step,
+					       min_t(u32, max,
+						     s5k3p9->exposure->default_value));
+		if (ret)
+			return ret;
+	}
+
+	/* Registers are written when streaming starts. */
+	if (pm_runtime_get_if_in_use(s5k3p9->dev) <= 0)
+		return 0;
+
+	cci_write(s5k3p9->regmap, S5K3P9_REG_GROUP_HOLD, 1, &ret);
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(s5k3p9->regmap, S5K3P9_REG_EXPOSURE, ctrl->val, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		cci_write(s5k3p9->regmap, S5K3P9_REG_ANALOG_GAIN, ctrl->val, &ret);
+		break;
+	case V4L2_CID_DIGITAL_GAIN:
+		cci_write(s5k3p9->regmap, S5K3P9_REG_DIGITAL_GAIN, ctrl->val, &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(s5k3p9->regmap, S5K3P9_REG_FRAME_LENGTH,
+			  S5K3P9_HEIGHT + ctrl->val, &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		cci_write(s5k3p9->regmap, S5K3P9_REG_TEST_PATTERN, ctrl->val, &ret);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+	cci_write(s5k3p9->regmap, S5K3P9_REG_GROUP_HOLD, 0, &ret);
+
+	pm_runtime_put_autosuspend(s5k3p9->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops s5k3p9_ctrl_ops = {
+	.s_ctrl = s5k3p9_set_ctrl,
+};
+
+static const s64 s5k3p9_link_freq = S5K3P9_LINK_FREQ;
+
+static int s5k3p9_init_controls(struct s5k3p9 *s5k3p9)
+{
+	struct v4l2_ctrl_handler *hdl = &s5k3p9->ctrls;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *ctrl;
+	u32 hblank = S5K3P9_LINE_LENGTH - S5K3P9_WIDTH;
+	u32 vblank = S5K3P9_FRAME_LENGTH - S5K3P9_HEIGHT;
+	int ret;
+
+	ret = v4l2_fwnode_device_parse(s5k3p9->dev, &props);
+	if (ret)
+		return ret;
+
+	v4l2_ctrl_handler_init(hdl, 10);
+
+	ctrl = v4l2_ctrl_new_int_menu(hdl, NULL, V4L2_CID_LINK_FREQ, 0, 0,
+				      &s5k3p9_link_freq);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(hdl, NULL, V4L2_CID_PIXEL_RATE, S5K3P9_PIXEL_RATE,
+			  S5K3P9_PIXEL_RATE, 1, S5K3P9_PIXEL_RATE);
+
+	ctrl = v4l2_ctrl_new_std(hdl, NULL, V4L2_CID_HBLANK, hblank, hblank, 1,
+				 hblank);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	s5k3p9->vblank = v4l2_ctrl_new_std(hdl, &s5k3p9_ctrl_ops,
+					   V4L2_CID_VBLANK, vblank,
+					   S5K3P9_FRAME_LENGTH_MAX - S5K3P9_HEIGHT,
+					   1, vblank);
+
+	s5k3p9->exposure = v4l2_ctrl_new_std(hdl, &s5k3p9_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     S5K3P9_EXPOSURE_MIN,
+					     S5K3P9_FRAME_LENGTH -
+					     S5K3P9_EXPOSURE_MARGIN,
+					     1, S5K3P9_EXPOSURE_DEFAULT);
+
+	v4l2_ctrl_new_std(hdl, &s5k3p9_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  S5K3P9_ANA_GAIN_MIN, S5K3P9_ANA_GAIN_MAX, 1,
+			  S5K3P9_ANA_GAIN_DEFAULT);
+
+	v4l2_ctrl_new_std(hdl, &s5k3p9_ctrl_ops, V4L2_CID_DIGITAL_GAIN,
+			  S5K3P9_DGTL_GAIN_MIN, S5K3P9_DGTL_GAIN_MAX, 1,
+			  S5K3P9_DGTL_GAIN_DEFAULT);
+
+	v4l2_ctrl_new_std_menu_items(hdl, &s5k3p9_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(s5k3p9_test_pattern_menu) - 1,
+				     0, 0, s5k3p9_test_pattern_menu);
+
+	v4l2_ctrl_new_fwnode_properties(hdl, &s5k3p9_ctrl_ops, &props);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		v4l2_ctrl_handler_free(hdl);
+		return dev_err_probe(s5k3p9->dev, ret, "control init failed\n");
+	}
+
+	s5k3p9->sd.ctrl_handler = hdl;
+
+	return 0;
+}
+
+static int s5k3p9_identify(struct s5k3p9 *s5k3p9)
+{
+	u64 id;
+	int ret;
+
+	ret = cci_read(s5k3p9->regmap, S5K3P9_REG_CHIP_ID, &id, NULL);
+	/* The CCI resets itself after a timeout; one retry recovers it. */
+	if (ret == -ETIMEDOUT)
+		ret = cci_read(s5k3p9->regmap, S5K3P9_REG_CHIP_ID, &id, NULL);
+	if (ret)
+		return dev_err_probe(s5k3p9->dev, ret, "failed to read chip ID\n");
+	if (id != S5K3P9_CHIP_ID)
+		return dev_err_probe(s5k3p9->dev, -ENODEV,
+				     "chip ID %#06llx, expected %#06x\n",
+				     id, S5K3P9_CHIP_ID);
+
+	return 0;
+}
+
+/* Stream a byte block into the indirect access data window. */
+static int s5k3p9_write_window(struct s5k3p9 *s5k3p9, const u8 *data,
+			       size_t len)
+{
+	/* The CCI accepts ten bytes per write: the address and eight data. */
+	u8 buf[10] = { S5K3P9_REG_WINDOW >> 8, S5K3P9_REG_WINDOW & 0xff };
+	size_t chunk;
+	int ret;
+
+	while (len) {
+		chunk = min(len, sizeof(buf) - 2);
+		memcpy(buf + 2, data, chunk);
+		ret = i2c_master_send(s5k3p9->client, buf, chunk + 2);
+		if (ret < 0)
+			return ret;
+		data += chunk;
+		len -= chunk;
+	}
+
+	return 0;
+}
+
+static int s5k3p9_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct s5k3p9 *s5k3p9 = to_s5k3p9(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(s5k3p9->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = s5k3p9_identify(s5k3p9);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_multi_reg_write(s5k3p9->regmap, s5k3p9_reset_regs,
+				  ARRAY_SIZE(s5k3p9_reset_regs), NULL);
+	if (ret)
+		goto err_init;
+	usleep_range(3000, 3500);
+
+	ret = cci_multi_reg_write(s5k3p9->regmap, s5k3p9_init_regs,
+				  ARRAY_SIZE(s5k3p9_init_regs), NULL);
+	if (!ret)
+		ret = s5k3p9_write_window(s5k3p9, s5k3p9_tnp,
+					  ARRAY_SIZE(s5k3p9_tnp));
+	if (!ret)
+		ret = cci_multi_reg_write(s5k3p9->regmap, s5k3p9_mode_regs,
+					  ARRAY_SIZE(s5k3p9_mode_regs), NULL);
+	if (ret)
+		goto err_init;
+
+	ret = __v4l2_ctrl_handler_setup(s5k3p9->sd.ctrl_handler);
+	if (ret)
+		goto err_rpm_put;
+
+	cci_write(s5k3p9->regmap, S5K3P9_REG_PAGE, S5K3P9_PAGE_SENSOR, &ret);
+	cci_write(s5k3p9->regmap, S5K3P9_REG_ORIENTATION, S5K3P9_ORIENTATION,
+		  &ret);
+	cci_write(s5k3p9->regmap, S5K3P9_REG_MODE_SELECT, S5K3P9_MODE_STREAMING,
+		  &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_init:
+	dev_err(s5k3p9->dev, "failed to write init registers: %d\n", ret);
+err_rpm_put:
+	pm_runtime_put_autosuspend(s5k3p9->dev);
+	return ret;
+}
+
+static int s5k3p9_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct s5k3p9 *s5k3p9 = to_s5k3p9(sd);
+	int ret;
+
+	ret = cci_write(s5k3p9->regmap, S5K3P9_REG_MODE_SELECT,
+			S5K3P9_MODE_STANDBY, NULL);
+	if (ret)
+		dev_err(s5k3p9->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(s5k3p9->dev);
+
+	return ret;
+}
+
+static void s5k3p9_fill_format(struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = S5K3P9_WIDTH;
+	fmt->height = S5K3P9_HEIGHT;
+	fmt->code = MEDIA_BUS_FMT_SGBRG10_1X10;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int s5k3p9_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SGBRG10_1X10;
+
+	return 0;
+}
+
+static int s5k3p9_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index || fse->code != MEDIA_BUS_FMT_SGBRG10_1X10)
+		return -EINVAL;
+
+	fse->min_width = S5K3P9_WIDTH;
+	fse->max_width = S5K3P9_WIDTH;
+	fse->min_height = S5K3P9_HEIGHT;
+	fse->max_height = S5K3P9_HEIGHT;
+
+	return 0;
+}
+
+static int s5k3p9_set_format(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state,
+			     struct v4l2_subdev_format *fmt)
+{
+	s5k3p9_fill_format(&fmt->format);
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+
+	return 0;
+}
+
+static int s5k3p9_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+		sel->r.left = S5K3P9_CROP_LEFT;
+		sel->r.top = S5K3P9_CROP_TOP;
+		sel->r.width = S5K3P9_CROP_WIDTH;
+		sel->r.height = S5K3P9_CROP_HEIGHT;
+		return 0;
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = S5K3P9_NATIVE_WIDTH;
+		sel->r.height = S5K3P9_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int s5k3p9_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	s5k3p9_fill_format(v4l2_subdev_state_get_format(state, 0));
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops s5k3p9_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops s5k3p9_pad_ops = {
+	.enum_mbus_code = s5k3p9_enum_mbus_code,
+	.enum_frame_size = s5k3p9_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = s5k3p9_set_format,
+	.get_selection = s5k3p9_get_selection,
+	.enable_streams = s5k3p9_enable_streams,
+	.disable_streams = s5k3p9_disable_streams,
+};
+
+static const struct v4l2_subdev_ops s5k3p9_subdev_ops = {
+	.video = &s5k3p9_video_ops,
+	.pad = &s5k3p9_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops s5k3p9_internal_ops = {
+	.init_state = s5k3p9_init_state,
+};
+
+/*
+ * Power sequencing follows the vendor module: reset asserted, AVDD, DVDD
+ * and DOVDD in turn, reset released, then MCLK and 8 ms before the first
+ * register access. Power-down stops MCLK, asserts reset 2 ms later and
+ * removes the supplies in reverse.
+ */
+static int s5k3p9_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k3p9 *s5k3p9 = to_s5k3p9(sd);
+	unsigned int i;
+	s64 off;
+	int ret;
+
+	off = ktime_ms_delta(ktime_get(), s5k3p9->power_off_time);
+	if (s5k3p9->power_off_time && off >= 0 && off < S5K3P9_MIN_OFF_MS)
+		msleep(S5K3P9_MIN_OFF_MS - off);
+
+	gpiod_set_value_cansleep(s5k3p9->reset_gpio, 1);
+
+	for (i = 0; i < ARRAY_SIZE(s5k3p9->supplies); i++) {
+		ret = regulator_enable(s5k3p9->supplies[i].consumer);
+		if (ret) {
+			dev_err(dev, "failed to enable %s: %d\n",
+				s5k3p9->supplies[i].supply, ret);
+			goto err_supplies;
+		}
+		usleep_range(1000, 1500);
+	}
+	usleep_range(2000, 2500);
+
+	gpiod_set_value_cansleep(s5k3p9->reset_gpio, 0);
+	usleep_range(2000, 2500);
+
+	ret = clk_prepare_enable(s5k3p9->mclk);
+	if (ret) {
+		dev_err(dev, "failed to enable clock: %d\n", ret);
+		goto err_reset;
+	}
+	usleep_range(8000, 9000);
+
+	return 0;
+
+err_reset:
+	gpiod_set_value_cansleep(s5k3p9->reset_gpio, 1);
+err_supplies:
+	while (i--)
+		regulator_disable(s5k3p9->supplies[i].consumer);
+	s5k3p9->power_off_time = ktime_get();
+	return ret;
+}
+
+static int s5k3p9_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k3p9 *s5k3p9 = to_s5k3p9(sd);
+	unsigned int i;
+
+	clk_disable_unprepare(s5k3p9->mclk);
+	usleep_range(2000, 2500);
+
+	gpiod_set_value_cansleep(s5k3p9->reset_gpio, 1);
+	usleep_range(1000, 1500);
+
+	for (i = ARRAY_SIZE(s5k3p9->supplies); i--;)
+		regulator_disable(s5k3p9->supplies[i].consumer);
+	s5k3p9->power_off_time = ktime_get();
+
+	return 0;
+}
+
+static int s5k3p9_parse_endpoint(struct s5k3p9 *s5k3p9)
+{
+	struct v4l2_fwnode_endpoint ep = { .bus_type = V4L2_MBUS_CSI2_DPHY };
+	struct fwnode_handle *endpoint;
+	unsigned long link_freq_bitmap;
+	int ret;
+
+	endpoint = fwnode_graph_get_endpoint_by_id(dev_fwnode(s5k3p9->dev), 0, 0,
+						   FWNODE_GRAPH_ENDPOINT_NEXT);
+	if (!endpoint)
+		return dev_err_probe(s5k3p9->dev, -EINVAL, "missing endpoint\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return dev_err_probe(s5k3p9->dev, ret, "failed to parse endpoint\n");
+
+	if (ep.bus.mipi_csi2.num_data_lanes != 4) {
+		ret = dev_err_probe(s5k3p9->dev, -EINVAL,
+				    "%u data lanes unsupported, need 4\n",
+				    ep.bus.mipi_csi2.num_data_lanes);
+		goto out;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(s5k3p9->dev, ep.link_frequencies,
+				       ep.nr_of_link_frequencies,
+				       &s5k3p9_link_freq, 1, &link_freq_bitmap);
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+	return ret;
+}
+
+static int s5k3p9_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct s5k3p9 *s5k3p9;
+	unsigned long rate;
+	unsigned int i;
+	int ret;
+
+	s5k3p9 = devm_kzalloc(dev, sizeof(*s5k3p9), GFP_KERNEL);
+	if (!s5k3p9)
+		return -ENOMEM;
+
+	s5k3p9->dev = dev;
+	s5k3p9->client = client;
+	v4l2_i2c_subdev_init(&s5k3p9->sd, client, &s5k3p9_subdev_ops);
+
+	ret = s5k3p9_parse_endpoint(s5k3p9);
+	if (ret)
+		return ret;
+
+	s5k3p9->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(s5k3p9->regmap))
+		return dev_err_probe(dev, PTR_ERR(s5k3p9->regmap),
+				     "failed to init CCI\n");
+
+	s5k3p9->mclk = devm_clk_get(dev, NULL);
+	if (IS_ERR(s5k3p9->mclk))
+		return dev_err_probe(dev, PTR_ERR(s5k3p9->mclk),
+				     "failed to get clock\n");
+
+	rate = clk_get_rate(s5k3p9->mclk);
+	if (rate != S5K3P9_MCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "clock %lu Hz unsupported, need %lu Hz\n",
+				     rate, S5K3P9_MCLK_FREQ);
+
+	s5k3p9->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(s5k3p9->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(s5k3p9->reset_gpio),
+				     "failed to get reset GPIO\n");
+
+	for (i = 0; i < ARRAY_SIZE(s5k3p9_supply_names); i++)
+		s5k3p9->supplies[i].supply = s5k3p9_supply_names[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(s5k3p9->supplies),
+				      s5k3p9->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	ret = s5k3p9_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = s5k3p9_identify(s5k3p9);
+	if (ret)
+		goto err_power_off;
+
+	ret = s5k3p9_init_controls(s5k3p9);
+	if (ret)
+		goto err_power_off;
+
+	s5k3p9->sd.internal_ops = &s5k3p9_internal_ops;
+	s5k3p9->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s5k3p9->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	s5k3p9->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&s5k3p9->sd.entity, 1, &s5k3p9->pad);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init entity pads\n");
+		goto err_free_ctrls;
+	}
+
+	s5k3p9->sd.state_lock = s5k3p9->ctrls.lock;
+	ret = v4l2_subdev_init_finalize(&s5k3p9->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init subdev\n");
+		goto err_entity;
+	}
+
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, S5K3P9_AUTOSUSPEND_MS);
+	pm_runtime_use_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&s5k3p9->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to register subdev\n");
+		goto err_pm;
+	}
+
+	pm_runtime_put_autosuspend(dev);
+
+	return 0;
+
+err_pm:
+	pm_runtime_dont_use_autosuspend(dev);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+	pm_runtime_put_noidle(dev);
+	v4l2_subdev_cleanup(&s5k3p9->sd);
+err_entity:
+	media_entity_cleanup(&s5k3p9->sd.entity);
+err_free_ctrls:
+	v4l2_ctrl_handler_free(&s5k3p9->ctrls);
+err_power_off:
+	s5k3p9_power_off(dev);
+	return ret;
+}
+
+static void s5k3p9_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct s5k3p9 *s5k3p9 = to_s5k3p9(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&s5k3p9->ctrls);
+
+	pm_runtime_dont_use_autosuspend(s5k3p9->dev);
+	pm_runtime_disable(s5k3p9->dev);
+	if (!pm_runtime_status_suspended(s5k3p9->dev))
+		s5k3p9_power_off(s5k3p9->dev);
+	pm_runtime_set_suspended(s5k3p9->dev);
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(s5k3p9_pm_ops, s5k3p9_power_off,
+				 s5k3p9_power_on, NULL);
+
+static const struct of_device_id s5k3p9_of_match[] = {
+	{ .compatible = "samsung,s5k3p9" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, s5k3p9_of_match);
+
+static struct i2c_driver s5k3p9_driver = {
+	.driver = {
+		.name = "s5k3p9",
+		.of_match_table = s5k3p9_of_match,
+		.pm = pm_ptr(&s5k3p9_pm_ops),
+	},
+	.probe = s5k3p9_probe,
+	.remove = s5k3p9_remove,
+};
+module_i2c_driver(s5k3p9_driver);
+
+MODULE_DESCRIPTION("Samsung S5K3P9 image sensor driver");
+MODULE_LICENSE("GPL");
