+#define S5K3P9_MODE_STREAMING		0x01
+#define S5K3P9_REG_ORIENTATION		CCI_REG8(0x0101)
+#define S5K3P9_ORIENTATION		0x03
+#define S5K3P9_REG_GROUP_HOLD		CCI_REG8(0x0104)
+#define S5K3P9_REG_EXPOSURE		CCI_REG16(0x0202)
+#define S5K3P9_REG_ANALOG_GAIN		CCI_REG16(0x0204)
+#define S5K3P9_REG_DIGITAL_GAIN		CCI_REG16(0x020e)
+#define S5K3P9_REG_FRAME_LENGTH		CCI_REG16(0x0340)
+#define S5K3P9_REG_TEST_PATTERN		CCI_REG16(0x0600)
+/* Indirect access: page (0x6028), address (0x602a) and data window. */
+#define S5K3P9_REG_PAGE			CCI_REG16(0x6028)
+#define S5K3P9_PAGE_SENSOR		0x4000
+#define S5K3P9_REG_WINDOW		0x6f12
+
+#define S5K3P9_MCLK_FREQ		(19200 * HZ_PER_KHZ)
