From 3709d53bb23749d8e84c9d757b34af47abed4527 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Mon, 2 Nov 2026 08:04:30 +0800
Subject: [PATCH 133/135] media: i2c: add a Samsung S5K3P9 driver

Add a driver for the Samsung S5K3P9 16 MP sensor with one fixed mode:
2304x1728 RAW10, the 4624x3456 crop binned 2x2, 30 fps over four D-PHY
lanes at 544 Mbps from a 19.2 MHz MCLK.

The tables are the vendor sequences of the Xiaomi Redmi Note 12 Turbo
front module (S5K3P9SP04): a soft reset, the sensor firmware patch
streamed through the indirect access window (0x6028/0x602a/0x6f12; the
window takes a byte stream, written eight bytes per transfer), the
analogue settings and the mode. Stream on selects the stock mirrored
and flipped readout (0x0101 = 3).

Timing: VT 19.2 MHz / 5 * 255 / 7 = 139.89 MHz at four pixels per clock
(559.54 Mpixel/s); line length 7200, 2588 lines: 30.03 fps. OP 19.2 MHz
/ 3 * 85 = 544 Mbps per lane.

Controls: exposure (0x0202), analogue gain (0x0204, code / 32, up to
16x), digital gain (0x020e, 8.8), vertical blanking (0x0340), read-only
horizontal blanking, pixel rate and link frequency, the SMIA test
patterns (0x0600) and the fwnode orientation and rotation; writes are
wrapped in group hold.

Power sequencing follows the vendor module: reset asserted, AVDD, DVDD
and DOVDD, reset released, MCLK and 8 ms before the first register
access. Runtime PM autosuspends after 2 s and keeps the sensor off for
at least 1.2 s: a Qualcomm CCI master that stays clocked across a sensor
power cycle hangs until it reinitialises on runtime resume. The chip ID
(0x0000 = 0x3109) is checked again at stream start, with one retry.

Signed-off-by: dianqk <dianqk@dianqk.net>
---
 drivers/media/i2c/Kconfig  |   12 +
 drivers/media/i2c/Makefile |    1 +
 drivers/media/i2c/s5k3p9.c | 1160 ++++++++++++++++++++++++++++++++++++
 3 files changed, 1173 insertions(+)
 create mode 100644 drivers/media/i2c/s5k3p9.c

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index f27109b735..19d5f2dab0 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -816,6 +816,18 @@ config VIDEO_S5K3M5
 	  To compile this driver as a module, choose M here: the
 	  module will be called s5k3m5.
 
+config VIDEO_S5K3P9
+	tristate "Samsung S5K3P9 sensor support"
+	depends on OF && GPIOLIB
+	select V4L2_CCI_I2C
+	help
+	  This is a Video4Linux2 sensor driver for the Samsung
+	  S5K3P9
+	  camera.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called s5k3p9.
+
 config VIDEO_S5K5BAF
 	tristate "Samsung S5K5BAF sensor support"
 	help
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index a183b5e56a..c55b772ee9 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -131,6 +131,7 @@ obj-$(CONFIG_VIDEO_RDACM21) += rdacm21.o
 obj-$(CONFIG_VIDEO_RJ54N1) += rj54n1cb0c.o
 obj-$(CONFIG_VIDEO_S5C73M3) += s5c73m3/
 obj-$(CONFIG_VIDEO_S5K3M5) += s5k3m5.o
+obj-$(CONFIG_VIDEO_S5K3P9) += s5k3p9.o
 obj-$(CONFIG_VIDEO_S5K5BAF) += s5k5baf.o
 obj-$(CONFIG_VIDEO_S5K6A3) += s5k6a3.o
 obj-$(CONFIG_VIDEO_S5KJN1) += s5kjn1.o
diff --git a/drivers/media/i2c/s5k3p9.c b/drivers/media/i2c/s5k3p9.c
