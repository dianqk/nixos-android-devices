+#define S5K3P9_PIXEL_RATE		559542857LL
+#define S5K3P9_LINE_LENGTH		7200
+#define S5K3P9_FRAME_LENGTH		2588
+#define S5K3P9_FRAME_LENGTH_MAX		0xffff
+
+#define S5K3P9_AUTOSUSPEND_MS		2000
+/*
+ * Minimum time between power-off and power-on. A Qualcomm CCI master that
+ * stays clocked while the sensor's I/O supply is cycled hangs on its next
+ * transfer; the CCI is reinitialised when it runtime-resumes, which it
+ * does after 1 s without traffic.
+ */
+#define S5K3P9_MIN_OFF_MS		1200
+
+/* Pixel array addressed by the mode's crop (0x0344-0x034b). */
+#define S5K3P9_NATIVE_WIDTH		4640
+#define S5K3P9_NATIVE_HEIGHT		3488
+#define S5K3P9_CROP_LEFT		16
+#define S5K3P9_CROP_TOP			24
+#define S5K3P9_CROP_WIDTH		4624
+#define S5K3P9_CROP_HEIGHT		3456
+
+#define S5K3P9_WIDTH			2304
+#define S5K3P9_HEIGHT			1728
+#define S5K3P9_EXPOSURE_MARGIN		8
+#define S5K3P9_EXPOSURE_MIN		4
+#define S5K3P9_EXPOSURE_DEFAULT		1000
+
+/* Analogue gain = code / 32, 1x to 16x. */
+#define S5K3P9_ANA_GAIN_MIN		0x0020
+#define S5K3P9_ANA_GAIN_MAX		0x0200
+#define S5K3P9_ANA_GAIN_DEFAULT		0x0020
+/* Digital gain is 8.8 fixed point. */
+#define S5K3P9_DGTL_GAIN_MIN		0x0100
+#define S5K3P9_DGTL_GAIN_MAX		0x0fff
+#define S5K3P9_DGTL_GAIN_DEFAULT	0x0100
+
