From 7b20d6133012f809456ea92cd3ee8e256c23b999 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Sun, 25 Oct 2026 21:40:07 +0800
Subject: [PATCH 88/88] arm64: dts: qcom: sm8475-xiaomi-marble: enable the
 PMK8350 RTC

The stock device tree enables the PMK8350 RTC (rtc@6100) with its alarm
register block and interrupt. Enable it here too so that the alarm can
wake the system from suspend (rtcwake, alarmtimer). Time setting stays
disabled: stock does not set allow-set-time, and the firmware owns the
RTC time.

Signed-off-by: dianqk <dianqk@dianqk.net>
---
 arch/arm64/boot/dts/qcom/sm8475-xiaomi-marble.dts | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-marble.dts b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-marble.dts
index 6aa03bc6fc7a..faa8e2b92e0a 100644
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-marble.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-marble.dts
@@ -566,6 +566,14 @@ &pon_resin {
 	status = "okay";
 };
 
+/*
+ * Stock enables the PMK8350 RTC with its alarm. The firmware does not let
+ * HLOS set the time (no allow-set-time); the alarm is enough for RTC wake.
+ */
+&pmk8350_rtc {
+	status = "okay";
+};
+
 /*
  * Stock (qcom,gpu-pwrlevels) runs this A730v3 at 220..580 MHz only; the
  * inherited SM8475 table goes to 900 MHz at TURBO_L1, above this bin.
