+struct ov64b40 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *mclk;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(ov64b40_supply_names)];
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *vblank;
+
+	ktime_t power_off_time;
+};
+
+static inline struct ov64b40 *to_ov64b40(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct ov64b40, sd);
+}
+
+static int ov64b40_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct ov64b40 *ov64b40 = container_of(ctrl->handler, struct ov64b40, ctrls);
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		/* Keep the exposure within the new frame length. */
+		u32 max = OV64B40_HEIGHT + ctrl->val - OV64B40_EXPOSURE_MARGIN;
+
+		ret = __v4l2_ctrl_modify_range(ov64b40->exposure,
+					       ov64b40->exposure->minimum, max,
+					       ov64b40->exposure->step,
+					       min_t(u32, max,
+						     ov64b40->exposure->default_value));
+		if (ret)
+			return ret;
+	}
+
+	/* Registers are written when streaming starts. */
+	if (pm_runtime_get_if_in_use(ov64b40->dev) <= 0)
+		return 0;
+
+	cci_write(ov64b40->regmap, OV64B40_REG_GROUP_HOLD,
+		  OV64B40_GROUP_HOLD_START, &ret);
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(ov64b40->regmap, OV64B40_REG_EXPOSURE, ctrl->val, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		cci_write(ov64b40->regmap, OV64B40_REG_ANALOG_GAIN, ctrl->val,
+			  &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(ov64b40->regmap, OV64B40_REG_VTS_HIGH, 0, &ret);
+		cci_write(ov64b40->regmap, OV64B40_REG_VTS,
+			  OV64B40_HEIGHT + ctrl->val, &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		cci_write(ov64b40->regmap, OV64B40_REG_TEST_PATTERN,
+			  ov64b40_test_pattern_val[ctrl->val], &ret);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+	cci_write(ov64b40->regmap, OV64B40_REG_GROUP_HOLD,
+		  OV64B40_GROUP_HOLD_END, &ret);
+	cci_write(ov64b40->regmap, OV64B40_REG_GROUP_HOLD,
+		  OV64B40_GROUP_HOLD_LAUNCH, &ret);
+
+	pm_runtime_put_autosuspend(ov64b40->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops ov64b40_ctrl_ops = {
+	.s_ctrl = ov64b40_set_ctrl,
+};
+
+static const s64 ov64b40_link_freq = OV64B40_LINK_FREQ;
+
+static int ov64b40_init_controls(struct ov64b40 *ov64b40)
+{
+	struct v4l2_ctrl_handler *hdl = &ov64b40->ctrls;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *ctrl;
+	u32 hblank = OV64B40_LINE_LENGTH - OV64B40_WIDTH;
+	u32 vblank = OV64B40_FRAME_LENGTH - OV64B40_HEIGHT;
+	int ret;
+
+	ret = v4l2_fwnode_device_parse(ov64b40->dev, &props);
+	if (ret)
+		return ret;
+
+	v4l2_ctrl_handler_init(hdl, 9);
+
+	ctrl = v4l2_ctrl_new_int_menu(hdl, NULL, V4L2_CID_LINK_FREQ, 0, 0,
+				      &ov64b40_link_freq);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(hdl, NULL, V4L2_CID_PIXEL_RATE, OV64B40_PIXEL_RATE,
+			  OV64B40_PIXEL_RATE, 1, OV64B40_PIXEL_RATE);
+
+	ctrl = v4l2_ctrl_new_std(hdl, NULL, V4L2_CID_HBLANK, hblank, hblank, 1,
+				 hblank);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	ov64b40->vblank = v4l2_ctrl_new_std(hdl, &ov64b40_ctrl_ops,
+					    V4L2_CID_VBLANK, vblank,
+					    OV64B40_FRAME_LENGTH_MAX -
+					    OV64B40_HEIGHT, 1, vblank);
+
+	ov64b40->exposure = v4l2_ctrl_new_std(hdl, &ov64b40_ctrl_ops,
+					      V4L2_CID_EXPOSURE,
+					      OV64B40_EXPOSURE_MIN,
+					      OV64B40_FRAME_LENGTH -
+					      OV64B40_EXPOSURE_MARGIN,
+					      1, OV64B40_EXPOSURE_DEFAULT);
+
+	v4l2_ctrl_new_std(hdl, &ov64b40_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  OV64B40_ANA_GAIN_MIN, OV64B40_ANA_GAIN_MAX, 1,
+			  OV64B40_ANA_GAIN_DEFAULT);
+
+	v4l2_ctrl_new_std_menu_items(hdl, &ov64b40_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(ov64b40_test_pattern_menu) - 1,
+				     0, 0, ov64b40_test_pattern_menu);
+
+	v4l2_ctrl_new_fwnode_properties(hdl, &ov64b40_ctrl_ops, &props);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		v4l2_ctrl_handler_free(hdl);
+		return dev_err_probe(ov64b40->dev, ret, "control init failed\n");
+	}
+
+	ov64b40->sd.ctrl_handler = hdl;
+
+	return 0;
+}
+
+static int ov64b40_identify(struct ov64b40 *ov64b40)
+{
+	u64 id;
+	int ret;
+
+	ret = cci_read(ov64b40->regmap, OV64B40_REG_CHIP_ID, &id, NULL);
+	/* The CCI resets itself after a timeout; one retry recovers it. */
+	if (ret == -ETIMEDOUT)
+		ret = cci_read(ov64b40->regmap, OV64B40_REG_CHIP_ID, &id, NULL);
+	if (ret)
+		return dev_err_probe(ov64b40->dev, ret, "failed to read chip ID\n");
+	if (id >> 8 != OV64B40_CHIP_ID)
+		return dev_err_probe(ov64b40->dev, -ENODEV,
+				     "chip ID %#08llx, expected %#06x..\n",
+				     id, OV64B40_CHIP_ID);
+
+	dev_dbg(ov64b40->dev, "chip ID %#08llx\n", id);
+
+	return 0;
+}
+
+static int ov64b40_enable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct ov64b40 *ov64b40 = to_ov64b40(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(ov64b40->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = ov64b40_identify(ov64b40);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_multi_reg_write(ov64b40->regmap, ov64b40_reset_regs,
+				  ARRAY_SIZE(ov64b40_reset_regs), NULL);
+	if (ret)
+		goto err_init;
+	usleep_range(5000, 5500);
+
+	ret = cci_multi_reg_write(ov64b40->regmap, ov64b40_init_regs,
+				  ARRAY_SIZE(ov64b40_init_regs), NULL);
+	if (!ret)
+		ret = cci_multi_reg_write(ov64b40->regmap, ov64b40_mode_regs,
+					  ARRAY_SIZE(ov64b40_mode_regs), NULL);
+	if (!ret)
+		ret = cci_write(ov64b40->regmap, OV64B40_REG_DIGITAL_GAIN,
+				OV64B40_DGTL_GAIN_DEFAULT, NULL);
+	if (ret)
+		goto err_init;
+
+	ret = __v4l2_ctrl_handler_setup(ov64b40->sd.ctrl_handler);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_write(ov64b40->regmap, OV64B40_REG_MODE_SELECT,
+			OV64B40_MODE_STREAMING, NULL);
+	if (!ret)
+		ret = cci_multi_reg_write(ov64b40->regmap,
+					  ov64b40_post_stream_regs,
+					  ARRAY_SIZE(ov64b40_post_stream_regs),
+					  NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_init:
+	dev_err(ov64b40->dev, "failed to write init registers: %d\n", ret);
+err_rpm_put:
+	pm_runtime_put_autosuspend(ov64b40->dev);
+	return ret;
+}
+static int ov64b40_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct ov64b40 *ov64b40 = to_ov64b40(sd);
+	int ret;
+
+	ret = cci_write(ov64b40->regmap, OV64B40_REG_MODE_SELECT,
+			OV64B40_MODE_STANDBY, NULL);
+	if (ret)
+		dev_err(ov64b40->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(ov64b40->dev);
+
+	return ret;
+}
+
+static void ov64b40_fill_format(struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = OV64B40_WIDTH;
+	fmt->height = OV64B40_HEIGHT;
+	fmt->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int ov64b40_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+
+	return 0;
+}
+
+static int ov64b40_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index || fse->code != MEDIA_BUS_FMT_SBGGR10_1X10)
+		return -EINVAL;
+
+	fse->min_width = OV64B40_WIDTH;
+	fse->max_width = OV64B40_WIDTH;
+	fse->min_height = OV64B40_HEIGHT;
+	fse->max_height = OV64B40_HEIGHT;
+
+	return 0;
+}
+
+static int ov64b40_set_format(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state,
+			     struct v4l2_subdev_format *fmt)
+{
+	ov64b40_fill_format(&fmt->format);
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+
+	return 0;
+}
+
+static int ov64b40_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = OV64B40_NATIVE_WIDTH;
+		sel->r.height = OV64B40_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int ov64b40_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	ov64b40_fill_format(v4l2_subdev_state_get_format(state, 0));
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops ov64b40_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops ov64b40_pad_ops = {
+	.enum_mbus_code = ov64b40_enum_mbus_code,
+	.enum_frame_size = ov64b40_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = ov64b40_set_format,
+	.get_selection = ov64b40_get_selection,
+	.enable_streams = ov64b40_enable_streams,
+	.disable_streams = ov64b40_disable_streams,
+};
+
+static const struct v4l2_subdev_ops ov64b40_subdev_ops = {
+	.video = &ov64b40_video_ops,
+	.pad = &ov64b40_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops ov64b40_internal_ops = {
+	.init_state = ov64b40_init_state,
+};
+
+/*
+ * Power sequencing follows the vendor module: reset asserted, AVDD, DVDD
+ * and DOVDD in turn, MCLK, reset released 10 ms later and 8 ms before the
+ * first register access. Power-down asserts reset, stops MCLK 2 ms later
+ * and removes the supplies in reverse.
+ */
+static int ov64b40_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct ov64b40 *ov64b40 = to_ov64b40(sd);
+	unsigned int i;
+	s64 off;
+	int ret;
+
+	off = ktime_ms_delta(ktime_get(), ov64b40->power_off_time);
+	if (ov64b40->power_off_time && off >= 0 && off < OV64B40_MIN_OFF_MS)
+		msleep(OV64B40_MIN_OFF_MS - off);
+
+	gpiod_set_value_cansleep(ov64b40->reset_gpio, 1);
+
+	for (i = 0; i < ARRAY_SIZE(ov64b40->supplies); i++) {
+		ret = regulator_enable(ov64b40->supplies[i].consumer);
+		if (ret) {
+			dev_err(dev, "failed to enable %s: %d\n",
+				ov64b40->supplies[i].supply, ret);
+			goto err_supplies;
+		}
+		usleep_range(500, 1000);
+	}
+	usleep_range(2000, 2500);
+
+	ret = clk_prepare_enable(ov64b40->mclk);
+	if (ret) {
+		dev_err(dev, "failed to enable clock: %d\n", ret);
+		goto err_supplies;
+	}
+	usleep_range(10000, 11000);
+
+	gpiod_set_value_cansleep(ov64b40->reset_gpio, 0);
+	usleep_range(8000, 9000);
+
+	return 0;
+
+err_supplies:
+	while (i--)
+		regulator_disable(ov64b40->supplies[i].consumer);
+	ov64b40->power_off_time = ktime_get();
+	return ret;
+}
+
+static int ov64b40_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct ov64b40 *ov64b40 = to_ov64b40(sd);
+	unsigned int i;
+
+	gpiod_set_value_cansleep(ov64b40->reset_gpio, 1);
+	usleep_range(2000, 2500);
+
+	clk_disable_unprepare(ov64b40->mclk);
+
+	for (i = ARRAY_SIZE(ov64b40->supplies); i--;)
+		regulator_disable(ov64b40->supplies[i].consumer);
+	ov64b40->power_off_time = ktime_get();
+
+	return 0;
+}
+
+static int ov64b40_parse_endpoint(struct ov64b40 *ov64b40)
+{
+	struct v4l2_fwnode_endpoint ep = { .bus_type = V4L2_MBUS_CSI2_CPHY };
+	struct fwnode_handle *endpoint;
+	unsigned long link_freq_bitmap;
+	int ret;
+
+	endpoint = fwnode_graph_get_endpoint_by_id(dev_fwnode(ov64b40->dev), 0, 0,
+						   FWNODE_GRAPH_ENDPOINT_NEXT);
+	if (!endpoint)
+		return dev_err_probe(ov64b40->dev, -EINVAL, "missing endpoint\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return dev_err_probe(ov64b40->dev, ret, "failed to parse endpoint\n");
+
+	if (ep.bus.mipi_csi2.num_data_lanes != 3) {
+		ret = dev_err_probe(ov64b40->dev, -EINVAL,
+				    "%u trios unsupported, need 3\n",
+				    ep.bus.mipi_csi2.num_data_lanes);
+		goto out;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(ov64b40->dev, ep.link_frequencies,
+				       ep.nr_of_link_frequencies,
+				       &ov64b40_link_freq, 1, &link_freq_bitmap);
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+	return ret;
+}
+
+static int ov64b40_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct ov64b40 *ov64b40;
+	unsigned long rate;
+	unsigned int i;
+	int ret;
+
+	ov64b40 = devm_kzalloc(dev, sizeof(*ov64b40), GFP_KERNEL);
+	if (!ov64b40)
+		return -ENOMEM;
+
+	ov64b40->dev = dev;
+	v4l2_i2c_subdev_init(&ov64b40->sd, client, &ov64b40_subdev_ops);
+
+	ret = ov64b40_parse_endpoint(ov64b40);
+	if (ret)
+		return ret;
+
+	ov64b40->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(ov64b40->regmap))
+		return dev_err_probe(dev, PTR_ERR(ov64b40->regmap),
+				     "failed to init CCI\n");
+
+	ov64b40->mclk = devm_clk_get(dev, NULL);
+	if (IS_ERR(ov64b40->mclk))
+		return dev_err_probe(dev, PTR_ERR(ov64b40->mclk),
+				     "failed to get clock\n");
+
+	rate = clk_get_rate(ov64b40->mclk);
+	if (rate != OV64B40_MCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "clock %lu Hz unsupported, need %lu Hz\n",
+				     rate, OV64B40_MCLK_FREQ);
+
+	ov64b40->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(ov64b40->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ov64b40->reset_gpio),
+				     "failed to get reset GPIO\n");
+
+	for (i = 0; i < ARRAY_SIZE(ov64b40_supply_names); i++)
+		ov64b40->supplies[i].supply = ov64b40_supply_names[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ov64b40->supplies),
+				      ov64b40->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	ret = ov64b40_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = ov64b40_identify(ov64b40);
+	if (ret)
+		goto err_power_off;
+
+	ret = ov64b40_init_controls(ov64b40);
+	if (ret)
+		goto err_power_off;
+
+	ov64b40->sd.internal_ops = &ov64b40_internal_ops;
+	ov64b40->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	ov64b40->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	ov64b40->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&ov64b40->sd.entity, 1, &ov64b40->pad);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init entity pads\n");
+		goto err_free_ctrls;
+	}
+
+	ov64b40->sd.state_lock = ov64b40->ctrls.lock;
+	ret = v4l2_subdev_init_finalize(&ov64b40->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init subdev\n");
+		goto err_entity;
+	}
+
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, OV64B40_AUTOSUSPEND_MS);
+	pm_runtime_use_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&ov64b40->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to register subdev\n");
+		goto err_pm;
+	}
+
+	pm_runtime_put_autosuspend(dev);
+
+	return 0;
+
+err_pm:
+	pm_runtime_dont_use_autosuspend(dev);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+	pm_runtime_put_noidle(dev);
+	v4l2_subdev_cleanup(&ov64b40->sd);
+err_entity:
+	media_entity_cleanup(&ov64b40->sd.entity);
+err_free_ctrls:
+	v4l2_ctrl_handler_free(&ov64b40->ctrls);
+err_power_off:
+	ov64b40_power_off(dev);
+	return ret;
+}
+
+static void ov64b40_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct ov64b40 *ov64b40 = to_ov64b40(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&ov64b40->ctrls);
+
+	pm_runtime_dont_use_autosuspend(ov64b40->dev);
+	pm_runtime_disable(ov64b40->dev);
+	if (!pm_runtime_status_suspended(ov64b40->dev))
+		ov64b40_power_off(ov64b40->dev);
+	pm_runtime_set_suspended(ov64b40->dev);
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(ov64b40_pm_ops, ov64b40_power_off,
+				 ov64b40_power_on, NULL);
+
+static const struct of_device_id ov64b40_of_match[] = {
+	{ .compatible = "ovti,ov64b40" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ov64b40_of_match);
+
+static struct i2c_driver ov64b40_driver = {
+	.driver = {
+		.name = "ov64b40",
+		.of_match_table = ov64b40_of_match,
+		.pm = pm_ptr(&ov64b40_pm_ops),
+	},
+	.probe = ov64b40_probe,
+	.remove = ov64b40_remove,
+};
+module_i2c_driver(ov64b40_driver);
+
+MODULE_DESCRIPTION("OmniVision OV64B40 image sensor driver");
+MODULE_LICENSE("GPL");
