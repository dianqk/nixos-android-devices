+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+#define OV64B40_REG_MODE_SELECT		CCI_REG8(0x0100)
+#define OV64B40_MODE_STANDBY		0x00
+#define OV64B40_MODE_STREAMING		0x01
+#define OV64B40_REG_CHIP_ID		CCI_REG24(0x300a)
+/* The low byte is a revision; the vendor driver checks 0x5664. */
+#define OV64B40_CHIP_ID			0x5664
+#define OV64B40_REG_GROUP_HOLD		CCI_REG8(0x3208)
+#define OV64B40_GROUP_HOLD_START	0x00
+#define OV64B40_GROUP_HOLD_END		0x10
+#define OV64B40_GROUP_HOLD_LAUNCH	0xa0
+#define OV64B40_REG_EXPOSURE		CCI_REG24(0x3500)
+#define OV64B40_REG_ANALOG_GAIN		CCI_REG16(0x3508)
+#define OV64B40_REG_DIGITAL_GAIN	CCI_REG24(0x350a)
+#define OV64B40_REG_VTS_HIGH		CCI_REG8(0x3840)
+#define OV64B40_REG_VTS			CCI_REG16(0x380e)
+#define OV64B40_REG_TEST_PATTERN	CCI_REG8(0x50c1)
+
+#define OV64B40_MCLK_FREQ		(19200 * HZ_PER_KHZ)
+/*
+ * Three C-PHY trios at 1.684 Gsps (link frequency half the symbol rate)
+ * carry 1.684 G * 16 / 7 * 3 / 10 = 1154.7 Mpixel/s. The timing below
+ * expresses the 3628-line frame (0x380e) at 30 fps in those pixels.
+ */
+#define OV64B40_LINK_FREQ		842000000LL
+#define OV64B40_PIXEL_RATE		1154742857LL
+#define OV64B40_LINE_LENGTH		10610
+#define OV64B40_FRAME_LENGTH		3628
+#define OV64B40_FRAME_LENGTH_MAX	0xffff
+
+#define OV64B40_AUTOSUSPEND_MS		2000
+/*
+ * Minimum time between power-off and power-on. A Qualcomm CCI master that
+ * stays clocked while the sensor's I/O supply is cycled hangs on its next
+ * transfer; the CCI is reinitialised when it runtime-resumes, which it
+ * does after 1 s without traffic.
+ */
+#define OV64B40_MIN_OFF_MS		1200
+
+/* Pixel array addressed by the mode (0x3800-0x3807), binned 2x2. */
+#define OV64B40_NATIVE_WIDTH		9280
+#define OV64B40_NATIVE_HEIGHT		6976
+#define OV64B40_WIDTH			4624
+#define OV64B40_HEIGHT			3472
+#define OV64B40_EXPOSURE_MARGIN		32
+#define OV64B40_EXPOSURE_MIN		16
+#define OV64B40_EXPOSURE_DEFAULT	1000
+
+/* Analogue gain = code / 256, 1x to 15.9x. */
+#define OV64B40_ANA_GAIN_MIN		0x0100
+#define OV64B40_ANA_GAIN_MAX		0x0ff0
+#define OV64B40_ANA_GAIN_DEFAULT	0x0100
+/* Digital gain = code / 65536. */
+#define OV64B40_DGTL_GAIN_DEFAULT	0x010000
+
+/* In power-up order; powered down in reverse. */
+static const char * const ov64b40_supply_names[] = {
+	"avdd",		/* Analogue (2.8 V) */
+	"dvdd",		/* Digital core (1.1 V) */
+	"dovdd",	/* Digital I/O (1.8 V) */
+};
+
+static const char * const ov64b40_test_pattern_menu[] = {
+	"Disabled",
+	"Type1",
+	"Type2",
+	"Type3",
+	"Type4",
+};
+
