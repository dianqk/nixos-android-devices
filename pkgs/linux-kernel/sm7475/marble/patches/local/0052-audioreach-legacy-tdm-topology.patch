--- a/sound/soc/qcom/qdsp6/q6prm.h
+++ b/sound/soc/qcom/qdsp6/q6prm.h
@@ -18,6 +18,8 @@
 #define Q6PRM_LPASS_CLK_ID_TER_MI2S_IBIT                          0x104
 /* Clock ID for Tertiary I2S EBIT */
 #define Q6PRM_LPASS_CLK_ID_TER_MI2S_EBIT                          0x105
+#define Q6PRM_LPASS_CLK_ID_TER_TDM_IBIT                           0x204
+#define Q6PRM_LPASS_CLK_ID_TER_TDM_EBIT                           0x205
 /* Clock ID for Quartnery I2S IBIT */
 #define Q6PRM_LPASS_CLK_ID_QUAD_MI2S_IBIT                         0x106
 /* Clock ID for Quartnery I2S EBIT */
diff --git a/sound/soc/qcom/qdsp6/topology.c b/sound/soc/qcom/qdsp6/topology.c
index 4bfc772d9e..291d674dcc 100644
--- a/sound/soc/qcom/qdsp6/topology.c
+++ b/sound/soc/qcom/qdsp6/topology.c
@@ -903,6 +903,18 @@ static int audioreach_widget_load_buffer(struct snd_soc_component *component,
 	case MODULE_ID_I2S_SOURCE:
 		audioreach_widget_i2s_module_load(mod, mod_array);
 		break;
+	case MODULE_ID_TDM_SINK:
+	case MODULE_ID_TDM_SOURCE:
+		/*
+		 * Interface type/index, data format and sd line as for I2S;
+		 * sync source, data output enable, framing, slots and lanes
+		 * use the Audio IF tokens.
+		 */
+		audioreach_widget_i2s_module_load(mod, mod_array);
+		ret = audioreach_widget_audio_if_module_load(mod, mod_array);
+		if (ret)
+			return ret;
+		break;
 	case MODULE_ID_AUDIO_IF_SINK:
 	case MODULE_ID_AUDIO_IF_SOURCE:
 		ret = audioreach_widget_audio_if_module_load(mod, mod_array);
