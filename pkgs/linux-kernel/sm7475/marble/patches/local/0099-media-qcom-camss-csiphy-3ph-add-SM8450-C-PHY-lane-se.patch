 /* 4nm 2PH v 2.1.2 2p5Gbps 4 lane DPHY mode */
 static const struct
 csiphy_lane_regs lane_regs_x1e80100[] = {
@@ -1294,6 +1527,22 @@ static void csiphy_lanes_enable(struct csiphy_device *csiphy,
 		}
 		break;
 	case CAMSS_8450:
+		if (c->phy_cfg == V4L2_MBUS_CSI2_DPHY) {
+			regs->lane_regs = &lane_regs_x1e80100[0];
+			regs->lane_array_size = ARRAY_SIZE(lane_regs_x1e80100);
+		} else if (c->phy_cfg == V4L2_MBUS_CSI2_CPHY) {
+			/* The C-PHY symbol rate is twice the link frequency. */
+			if (link_freq * 2 <= 1700000000LL) {
+				regs->lane_regs = &lane_regs_sm8450_3ph_1p7gsps[0];
+				regs->lane_array_size =
+					ARRAY_SIZE(lane_regs_sm8450_3ph_1p7gsps);
+			} else {
+				regs->lane_regs = &lane_regs_sm8450_3ph_2p5gsps[0];
+				regs->lane_array_size =
+					ARRAY_SIZE(lane_regs_sm8450_3ph_2p5gsps);
+			}
+		}
+		break;
 	case CAMSS_X1E80100:
 		if (c->phy_cfg == V4L2_MBUS_CSI2_DPHY) {
 			regs->lane_regs = &lane_regs_x1e80100[0];
@@ -1339,6 +1588,10 @@ static void csiphy_lanes_enable(struct csiphy_device *csiphy,
 		WARN_ONCE(1, "Missing lane_regs definition!\n");
 
 	settle_cnt = csiphy_settle_cnt_calc(link_freq, csiphy->timer_clk_rate);
+	/* SM8450 C-PHY: the vendor settle time of 6 ns in 200 ps units. */
+	if (csiphy->camss->res->version == CAMSS_8450 &&
+	    c->phy_cfg == V4L2_MBUS_CSI2_CPHY)
+		settle_cnt = 30;
 
 	val = csiphy_get_lane_mask(c);
 	writel_relaxed(val, csiphy->base +
@@ -1361,6 +1614,16 @@ static void csiphy_lanes_enable(struct csiphy_device *csiphy,
 	else
 		csiphy_gen1_config_lanes(csiphy, cfg, settle_cnt);
 
+	/* SM8450 C-PHY: vendor common setting and 3-phase reset release. */
+	if (csiphy->camss->res->version == CAMSS_8450 &&
+	    c->phy_cfg == V4L2_MBUS_CSI2_CPHY) {
+		writel_relaxed(0x7a, csiphy->base +
+			       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, 7));
+		writel(0x0e, csiphy->base +
+		       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, 0));
+		usleep_range(3048, 3100);
+	}
+
 	/* IRQ_MASK registers - disable all interrupts */
 	for (i = 11; i < 22; i++) {
 		writel_relaxed(0, csiphy->base +
