From 5d10a7e29d67cce6b6d6c560a1d115a0d87ece68 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Mon, 2 Nov 2026 07:46:25 +0800
Subject: [PATCH 130/135] media: qcom: camss: select C-PHY on CSID 680

The C-PHY series sets the CSID PHY type select bit on gen2 CSIDs only.
CSID 680 (SM8450, SM8475, SM7475) defines the same field at bit 24 of
CSI2_RX_CFG0 but never set it, so a C-PHY stream would be decoded as
D-PHY. Set it from the configured PHY type, as for gen3 CSIDs.

Signed-off-by: dianqk <dianqk@dianqk.net>
---
 drivers/media/platform/qcom/camss/camss-csid-680.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/media/platform/qcom/camss/camss-csid-680.c b/drivers/media/platform/qcom/camss/camss-csid-680.c
index 345a67c8fb..53bf41847a 100644
--- a/drivers/media/platform/qcom/camss/camss-csid-680.c
+++ b/drivers/media/platform/qcom/camss/camss-csid-680.c
@@ -201,6 +201,7 @@ static void __csid_configure_rx(struct csid_device *csid,
 		val |= (phy->csiphy_id + CSI2_RX_CFG0_PHY_SEL_BASE_IDX)
 			<< CSI2_RX_CFG0_PHY_NUM_SEL;
 	}
+	val |= csid->phy.phy_sel << CSI2_RX_CFG0_PHY_TYPE_SEL;
 
 	writel(val, csid->base + CSID_CSI2_RX_CFG0);
 
