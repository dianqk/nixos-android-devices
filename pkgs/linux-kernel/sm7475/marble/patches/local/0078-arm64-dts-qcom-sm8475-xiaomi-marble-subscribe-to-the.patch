From faca4a3614affb2f28ff1789953043391c08f9cd Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Sun, 25 Oct 2026 20:36:45 +0800
Subject: [PATCH 87/87] arm64: dts: qcom: sm8475-xiaomi-marble: subscribe to
 the SLPI sensor PD

The stock SLPI firmware (SLPI.HY.5.0, slpius.jsn) registers the
msm/slpi/sensor_pd protection domain with the tms/servreg service, as on
the SM8475 Lenovo TB320FC. Let FastRPC subscribe to it so that the
sensor PD's service registry notifications are acknowledged before the
userspace sensor listener (sdsprpcd sensorspd) attaches.

Signed-off-by: dianqk <dianqk@dianqk.net>
---
 arch/arm64/boot/dts/qcom/sm8475-xiaomi-marble.dts | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-marble.dts b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-marble.dts
index 767c4a313f9a..6aa03bc6fc7a 100644
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-marble.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-marble.dts
@@ -613,6 +613,12 @@ &remoteproc_mpss {
 &remoteproc_slpi {
 	firmware-name = "qcom/sm8475/xiaomi/marble/slpi2.mdt";
 	status = "okay";
+
+	glink-edge {
+		fastrpc {
+			qcom,protection-domain = "tms/servreg", "msm/slpi/sensor_pd";
+		};
+	};
 };
 
 &i2c5 {
