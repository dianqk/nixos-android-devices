From: dianqk <dianqk@dianqk.net>
Date: Tue, 6 Oct 2026 23:00:00 +0800
Subject: [PATCH] arm: dts: add Xiaomi 14 Ultra boot firmware tree

Local board adaptation of the validated Aurora recovery description.
SoC/PMIC topology: Linux v7.3-rc5 qcom/sm8650-mtp.dts; board identity,
GPIO exclusions and reserved memory were checked against Aurora firmware.
https://github.com/torvalds/linux/blob/v7.3-rc5/arch/arm64/boot/dts/qcom/sm8650-mtp.dts

Retain the arch_timer symbol for ABL hypervisor overlays. Preserve secure
reservations and splash_region without guessing a framebuffer. Use USB2
UTMI pipe selection for the U-Boot DWC3 driver, not the Linux driver.
---
--- /dev/null
+++ b/dts/upstream/src/arm64/qcom/sm8650-xiaomi-aurora.dts
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/* SM8650/PMIC topology follows the upstream Linaro SM8650 MTP description.
+ * Board supplies and reserved memory follow Xiaomi aurora firmware.
+ * Boot firmware: USB peripheral and UFS; ABL retains regulator votes.
+ */
+/dts-v1/;
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include <dt-bindings/gpio/gpio.h>
+#include "sm8650.dtsi"
+#include "pm8550.dtsi"
+#include "pm8550b.dtsi"
+#define PMK8550VE_SID 8
+#include "pm8550ve.dtsi"
+#include "pm8550vs.dtsi"
+#include "pmk8550.dtsi"
+
+/ {
+	model = "Xiaomi 14 Ultra";
+	compatible = "xiaomi,aurora", "qcom,sm8650";
+	qcom,msm-id = <557 0x20000>, <557 0x10000>;
+	qcom,board-id = <8 0>;
+	xiaomi,miboard-id = <4 0>;
+
+	/* Firmware hypervisor overlay targets this symbol to set always-on. */
+	arch_timer: timer { };
+
+	reserved-memory {
+		dump-display@816e0000 { reg = <0 0x816e0000 0 0x800>; no-map; };
+		xbl-ramdump@84a00000 { reg = <0 0x84a00000 0 0x200000>; no-map; };
+		xiaomi-buffer@84c00000 { reg = <0 0x84c00000 0 0x400000>; no-map; };
+		lost-reg@9b09c000 { reg = <0 0x9b09c000 0 0x4000>; no-map; };
+		oem-vm-shm@fb400000 { reg = <0 0xfb400000 0 0x400000>; no-map; };
+		/* Preserve the bootloader's framebuffer allocation and node name. */
+		splash_region { reg = <0 0xfc400000 0 0x2b00000>; no-map; };
+		ramoops@a7000000 {
+			compatible = "ramoops";
+			reg = <0 0xa7000000 0 0x400000>;
+			console-size = <0x200000>;
+			pmsg-size = <0x200000>;
+			mem-type = <2>;
+			no-map;
+		};
+	};
+};
+
+&adspslpi_mem { reg = <0 0x9df00000 0 0x4680000>; };
+&hwfence_shbuf { reg = <0 0xff100000 0 0x2dd000>; };
+&oem_vm_mem { reg = <0 0xf7c00000 0 0x3800000>; };
+/* Keep the reservation, but do not assign modem memory during USB bring-up. */
+&rmtfs_mem { status = "disabled"; };
+&xo_board { clock-frequency = <76800000>; };
+&sleep_clk { clock-frequency = <32000>; };
+
+/* Firmware-owned pins listed by the stock Aurora TLMM description. */
+&tlmm { gpio-reserved-ranges = <8 4>, <36 4>, <42 1>, <74 1>; };
+
+
+/* ABL supplies the rails; the boot firmware leaves those votes intact. */
+&usb_1_hsphy {
+    phys = <&pm8550b_eusb2_repeater>;
+    status = "okay";
+};
+&usb_1 {
+    phys = <&usb_1_hsphy>;
+    phy-names = "usb2-phy";
+    qcom,select-utmi-as-pipe-clk;
+    dr_mode = "peripheral";
+    maximum-speed = "high-speed";
+    status = "okay";
+};
+&ufs_mem_hc {
+    reset-gpios = <&tlmm 210 GPIO_ACTIVE_LOW>;
+    status = "okay";
+};
+&ufs_mem_phy { status = "okay"; };
