From: dianqk <dianqk@dianqk.net>
Date: Fri, 9 Oct 2026 21:00:00 +0800
Subject: [PATCH] arm: dts: aurora: enable physical boot-menu keys

Local board adaptation from the working Aurora Linux key bindings in
pkgs/linux-kernel/sm8650/aurora/keys.patch. Enable PMK8550 power/resin
and PM8550 GPIO6 volume-up, including its input supply and pull-up.
This permits button-kbd navigation and Volume Down maintenance entry.
---
--- a/dts/upstream/src/arm64/qcom/sm8650-xiaomi-aurora.dts
+++ b/dts/upstream/src/arm64/qcom/sm8650-xiaomi-aurora.dts
@@ -75,1 +75,34 @@
 &ufs_mem_phy { status = "okay"; };
+
+/ {
+	gpio-keys {
+		compatible = "gpio-keys";
+		pinctrl-names = "default";
+		pinctrl-0 = <&volume_up_n>;
+		key-volume-up {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&pm8550_gpios 6 GPIO_ACTIVE_LOW>;
+		};
+	};
+};
+
+&pm8550_gpios {
+	volume_up_n: volume-up-n-state {
+		pins = "gpio6";
+		function = "normal";
+		bias-pull-up;
+		input-enable;
+		power-source = <1>;
+	};
+};
+
+&pon_pwrkey {
+	linux,code = <KEY_POWER>;
+	status = "okay";
+};
+
+&pon_resin {
+	linux,code = <KEY_VOLUMEDOWN>;
+	status = "okay";
+};
