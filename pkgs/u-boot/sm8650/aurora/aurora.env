# SPDX-License-Identifier: GPL-2.0+
# Keep ACM available before touching storage; no persistent environment.
boot_esp=linux-boot
stdin=serial,button-kbd
stdout=vidconsole,serial
stderr=vidconsole,serial
bootdelay=0
bootretry=60
serial_gadget=setenv stdin serial,button-kbd,usbacm; setenv stdout vidconsole,serial,usbacm; setenv stderr vidconsole,serial,usbacm
preboot=run serial_gadget; run detect_boot_mode; scsi scan
# Same outer-GPT ESP contract as the other devices. EFI gets the relocated,
# ABL-populated FDT, never the static control tree without firmware reservations.
boot_linux=for bootdev in 0 1 2 3 4 5 6 7; do if part number scsi ${bootdev} linux-boot bootpart; then if fatload scsi ${bootdev}:${bootpart} ${kernel_addr_r} /EFI/BOOT/BOOTAA64.EFI; then bootefi ${kernel_addr_r} ${fdt_addr_r}; fi; fi; done
# No countdown on normal boot; hold Volume Down for maintenance.
menucmd=setenv bootretry -1; setenv bootcmd run menucmd; bootmenu -1
bootmenu_0=Boot NixOS=run boot_linux; pause
bootmenu_1=Enable USB serial console=run serial_gadget
bootmenu_2=Drop to shell=setenv bootretry -1
bootmenu_3=Reset device=reset
bootmenu_4=Start wired charging=run boot_charger
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
fastboot=fastboot -l ${fastboot_addr_r} usb 0
