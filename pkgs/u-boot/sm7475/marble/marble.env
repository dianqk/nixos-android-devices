# SPDX-License-Identifier: GPL-2.0+
# Based on U-Boot v2026.10 board/qualcomm/qcom-phone.env and the marble
# environment by Tatsuki Tanaka (board/qualcomm/xiaomi-marble.env).
# Keep ACM available before touching storage; no persistent environment.
boot_esp=linux-boot
stdin=serial,button-kbd
stdout=vidconsole,serial
stderr=vidconsole,serial
# A 3 s countdown after the ACM console and UFS scan: any key on the ACM
# console or a volume key stops autoboot at the shell (Volume Down held
# from power-on opens the menu, see button_cmd_0). An idle shell runs
# bootcmd again after bootretry seconds, so stray console input cannot
# keep the phone from booting.
bootdelay=3
bootretry=60
# The ACM console holds the only USB gadget slot for this boot, so UMS and
# Fastboot are not offered here.
serial_gadget=setenv stdin serial,button-kbd,usbacm; setenv stdout vidconsole,serial,usbacm; setenv stderr vidconsole,serial,usbacm
preboot=run serial_gadget; scsi scan; run boot_payload
# RAM recovery: a boot image whose ramdisk is a FIT marked
# android-devices,payload = "ram-recovery" is copied into the fastboot buffer
# (its 0x7000000 size limit) and booted with the FIT's DTB and
# /chosen/bootargs. With an Android header v4 image ABL loads vendor_boot_b's
# ramdisk first and appends the boot image ramdisk after it (the AOSP v3/v4
# order), so the FIT starts vendor_ramdisk_size bytes (vendor boot header
# offset 0x18) after linux,initrd-start; a v0-v2 image would place it at the
# start. Only headers are read: the vendor_boot_b header and 0x40 bytes at
# each candidate. A normal boot (no FIT) changes nothing; a payload that does
# not boot opens the menu instead of starting the installed system.
payload_at=cp.b ${payload_addr} ${fastboot_addr_r} 0x40 && itest.l *${fastboot_addr_r} == 0xedfe0dd0 && \
	fdt addr ${fastboot_addr_r} && fdt header get payload_size totalsize && \
	itest ${payload_size} -le 0x7000000 && cp.b ${payload_addr} ${fastboot_addr_r} ${payload_size} && \
	fdt addr ${fastboot_addr_r} && fdt get value payload_kind / android-devices,payload && \
	test "${payload_kind}" = "ram-recovery"
payload_vendor=setenv payload_vendor_size; for bootdev in 0 1 2 3 4 5 6 7; do \
	if test -z "${payload_vendor_size}" && part start scsi ${bootdev} vendor_boot_b payload_vendor_start && \
		scsi dev ${bootdev} && scsi read ${fastboot_addr_r} ${payload_vendor_start} 1 && \
		itest.l *${fastboot_addr_r} == 0x52444e56; then \
		setexpr payload_field ${fastboot_addr_r} + 4; \
		if itest.l *${payload_field} == 0x544f4f42; then \
			setexpr payload_field ${fastboot_addr_r} + 0x18; setexpr.l payload_vendor_size *${payload_field}; \
		fi; \
	fi; done
payload_boot=echo "Boot: RAM recovery FIT at ${payload_addr}, ${payload_size} bytes (hex)"; setenv bootargs; \
	bootm ${fastboot_addr_r}; echo "Boot: RAM recovery FIT did not boot"; setenv bootcmd run menucmd
boot_payload=if test -n "${prevbl_initrd_start_addr}"; then \
	setenv payload_addr ${prevbl_initrd_start_addr}; \
	if run payload_at; then run payload_boot; else \
		run payload_vendor; \
		if test -n "${payload_vendor_size}"; then \
			setexpr payload_addr ${prevbl_initrd_start_addr} + ${payload_vendor_size}; \
			if run payload_at; then run payload_boot; fi; \
		fi; \
	fi; \
fi
# Same outer-GPT ESP contract as the other devices. Without a linux-boot
# partition this only reads GPTs and falls through to the menu.
boot_linux=for bootdev in 0 1 2 3 4 5 6 7; do if part number scsi ${bootdev} ${boot_esp} bootpart; then if fatload scsi ${bootdev}:${bootpart} ${kernel_addr_r} /EFI/BOOT/BOOTAA64.EFI; then bootefi ${kernel_addr_r}; fi; fi; done
bootcmd=run boot_linux; echo "No ${boot_esp} EFI entry found"; run menucmd
# Read-only listing of every UFS LUN's partition table.
list_storage=for bootdev in 0 1 2 3 4 5 6 7; do echo "== UFS LUN ${bootdev}"; part list scsi ${bootdev}; done
# Hold Volume Down from power-on for the maintenance menu.
menucmd=setenv bootretry -1; setenv bootcmd run menucmd; bootmenu -1
bootmenu_0=Boot NixOS=run boot_linux; pause
bootmenu_1=List UFS partitions=run list_storage; pause
bootmenu_2=Enable USB serial console=run serial_gadget
bootmenu_3=Drop to shell=setenv bootretry -1
bootmenu_4=Reset device=reset
bootmenu_5=Power off=poweroff
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
