From 6a4e7a384f944349f438ad0b4dbe077f0999d287 Mon Sep 17 00:00:00 2001
From: Tatsuki Tanaka <tatsuki@tanakatatsuki.dev>
Date: Fri, 9 Oct 2026 18:32:25 +0800
Subject: [PATCH] gpio: qcom_spmi_gpio: add PM8350, PM8350B and PM8350C

Add compatibles for PM8350, PM8350B, and PM8350C PMICs used on
SM8450/SM8475 platforms.

Signed-off-by: Tatsuki Tanaka <tatsuki@tanakatatsuki.dev>
(cherry picked from commit e97417a555bdbec0ace679275ed2857f4363901b)
---
 drivers/gpio/qcom_spmi_gpio.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/gpio/qcom_spmi_gpio.c b/drivers/gpio/qcom_spmi_gpio.c
index 3efee2060..8dcd4691b 100644
--- a/drivers/gpio/qcom_spmi_gpio.c
+++ b/drivers/gpio/qcom_spmi_gpio.c
@@ -748,6 +748,9 @@ static const struct udevice_id qcom_spmi_pmic_gpio_ids[] = {
 	{ .compatible = "qcom,pm660l-gpio" },
 	{ .compatible = "qcom,pm7325-gpio" },
 	{ .compatible = "qcom,pm7550-gpio" },
+	{ .compatible = "qcom,pm8350-gpio" },
+	{ .compatible = "qcom,pm8350b-gpio" },
+	{ .compatible = "qcom,pm8350c-gpio" },
 	{ .compatible = "qcom,pm8550-gpio" },
 	{ .compatible = "qcom,pm8550b-gpio" },
 	{ .compatible = "qcom,pm8550ve-gpio" },
