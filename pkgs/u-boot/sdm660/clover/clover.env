# SPDX-License-Identifier: GPL-2.0+
# Based on U-Boot v2026.10-rc5 board/qualcomm/qcom-phone.env.
bootdelay=0
bootretry=1
stdin=serial,button-kbd
# EFI queries the first output console for the screen grid.
stdout=vidconsole,serial
stderr=vidconsole,serial

# Fastboot is keen to use the address from kconfig, but we
# allocate its buffer at runtime.
fastboot=fastboot -l $fastboot_addr_r usb 0

# Keep USB diagnostics available on phones without an exposed UART.
# SDM630/660 aliases number internal eMMC as mmc 1 and microSD as mmc 2.
preboot=run serial_gadget; mmc dev 1; mmc rescan

# Shortcut to enable USB serial gadget and disable bootretry
serial_gadget=setenv stdin serial,button-kbd,usbacm; \
	setenv stdout vidconsole,serial,usbacm; \
	setenv stderr vidconsole,serial,usbacm; \
	setenv bootretry -1; \
	echo Enabled U-Boot console serial gadget

# bootretry will run this command over and over, if we fail once
# then bail out to the boot menu instead (with a pause to read
# the error message)
boot_linux=if mmc dev 1 && mmc rescan; then if part number mmc 1 system bootpart; then if fatload mmc 1:${bootpart} ${kernel_addr_r} /EFI/BOOT/BOOTAA64.EFI; then bootefi ${kernel_addr_r}; fi; fi; fi
bootcmd=run boot_linux; pause; run menucmd

# When entering the menu (either from button press or failed boot)
# remap bootcmd so it will re-open the menu and we won't get stuck
# at the console with no way to type
menucmd=setenv bootcmd run menucmd; bootmenu -1

# Pause is used so the output can be read on the display
bootmenu_0=Boot NixOS=run boot_linux; pause
bootmenu_1=Enable serial console gadget=run serial_gadget
bootmenu_2=Enable USB mass storage=echo "Press any key to exit UMS mode"; ums 0 mmc 1
bootmenu_3=Enable fastboot mode=echo "Press any key to exit fastboot mode"; run fastboot
# Disabling bootretry means we'll just drop the shell
bootmenu_4=Drop to shell=setenv bootretry -1
bootmenu_5=Reset device=reset
bootmenu_6=Dump clocks=clk dump; pause
bootmenu_7=Dump environment=printenv; pause
bootmenu_8=Board info=bdinfo; pause
bootmenu_9=Dump bootargs=fdt addr $fdt_addr_r; fdt print /chosen bootargs; pause
bootmenu_10=Power off=poweroff

# Allow holding the volume down button while U-Boot loads to enter
# the boot menu
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
