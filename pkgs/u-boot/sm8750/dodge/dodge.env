# SPDX-License-Identifier: GPL-2.0+
stdin=usbacm
stdout=vidconsole,usbacm
stderr=vidconsole,usbacm
bootdelay=5
bootcmd=run boot_linux; run ram_download; run ram_console
serial#=DODGE
boot_esp=linux-boot
preboot=scsi scan; run boot_payload
# Release ACM while fastboot owns USB; bootcmd restores the console on return.
usb_release=setenv stdin button-kbd; setenv stdout vidconsole; setenv stderr vidconsole
ram_download=setenv ram_fit_ready; run usb_release; echo "Dodge U-Boot: waiting for recovery over USB"; fastboot usb 0; if test "${ram_fit_ready}" = 1; then setenv ram_fit_ready; run ram_boot; fi; setenv stdin button-kbd,usbacm
ram_console=setenv stdin button-kbd,usbacm; setenv stdout vidconsole,usbacm; setenv stderr vidconsole,usbacm; echo ACM-READY
# Boot only after fastboot has detached and unregistered its USB gadget.
fastboot_bootcmd=setenv ram_fit_ready 1
# Accept a raw FIT or the host fastboot client's Android wrapper around it.
ram_boot=setexpr fbimg ${fastboot_addr_r}; if itest.l *${fbimg} == 0x52444e41; then setexpr fbps ${fbimg} + 0x24; setexpr.l fbpage *${fbps}; setexpr fbimg ${fbimg} + ${fbpage}; fi; if itest.l *${fbimg} == 0xedfe0dd0; then bootm ${fbimg}; else bootm ${fastboot_addr_r}; fi; echo "fastboot boot: image did not boot"

# A marked RAM FIT takes precedence over the installed ESP. Use the ABL
# initrd span retained in the control tree, including both slot header offsets.
payload_at=setexpr payload_limit ${payload_addr} + 0x40 && itest.q ${payload_addr} -ge ${payload_start} && \
	itest.q ${payload_limit} -le ${payload_end} && \
	cp.b ${payload_addr} ${fastboot_addr_r} 0x40 && itest.l *${fastboot_addr_r} == 0xedfe0dd0 && \
	fdt addr ${fastboot_addr_r} && fdt header get payload_size totalsize && \
	itest ${payload_size} -ge 0x40 && itest ${payload_size} -le 0x4000000 && \
	setexpr payload_limit ${payload_addr} + ${payload_size} && itest.q ${payload_limit} -le ${payload_end} && \
	cp.b ${payload_addr} ${fastboot_addr_r} ${payload_size} && \
	fdt addr ${fastboot_addr_r} && fdt get value payload_kind / android-devices,payload && \
	test "${payload_kind}" = "ram-recovery"
# Header v4 ABL prepends the selected vendor ramdisk. Match the FIT marker
# within the saved span rather than assuming that RAM boot selected slot B.
payload_vendor=for payload_vendor_part in vendor_boot_a vendor_boot_b; do \
	for bootdev in 0 1 2 3 4 5 6 7; do \
		if test -z "${payload_found}" && part start scsi ${bootdev} ${payload_vendor_part} payload_vendor_start && \
			scsi dev ${bootdev} && scsi read ${fastboot_addr_r} ${payload_vendor_start} 1 && \
			itest.l *${fastboot_addr_r} == 0x52444e56; then \
			setexpr payload_field ${fastboot_addr_r} + 4; \
			if itest.l *${payload_field} == 0x544f4f42; then \
				setexpr payload_field ${fastboot_addr_r} + 0x18; setexpr.l payload_vendor_size *${payload_field}; \
				setexpr payload_addr ${payload_start} + ${payload_vendor_size}; \
				if run payload_at; then run payload_boot; fi; \
			fi; \
		fi; \
	done; \
done
payload_boot=setenv payload_found 1; echo "Boot: RAM recovery FIT at ${payload_addr}, ${payload_size} bytes (hex)"; \
	setenv bootargs; run usb_release; bootm ${fastboot_addr_r}; \
	echo "Boot: RAM recovery FIT did not boot"; setenv bootcmd 'run ram_download; run ram_console'
boot_payload=setenv payload_found; fdt addr ${fdtcontroladdr}; \
	if fdt get value payload_start /chosen linux,initrd-start && \
		fdt get value payload_end /chosen linux,initrd-end && itest.q ${payload_end} -gt ${payload_start}; then \
		setenv payload_addr ${payload_start}; \
		if run payload_at; then run payload_boot; else run payload_vendor; fi; \
	fi
# Context is required by native import and EFI initialization. No BOOTAA64 bypass.
boot_choice_failure=echo "Boot-choice helper missing, invalid context, or returned: maintenance required"; run ram_console
boot_linux=fdt addr ${fdtcontroladdr}; if fdt get size choice_size /chosen android-devices,boot-choice-intent && test "${choice_size}" = 50; then for bootdev in 0 1 2 3 4 5 6 7; do if part number scsi ${bootdev} ${boot_esp} bootpart; then if fatload scsi ${bootdev}:${bootpart} ${loadaddr} /EFI/android-devices/boot-choice.efi; then run usb_release; bootefi ${loadaddr}; run boot_choice_failure; exit; fi; fi; done; fi; run boot_choice_failure
