From c9c7c50943e3a134959655bc35ae011b667eeb6e Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Sat, 7 Nov 2026 11:59:16 +0800
Subject: [PATCH] arm: qualcomm: allow filesystem loads into Dodge transfer
 buffer

Use the same writable LMB reservation as the standard Snapdragon load buffers. Filesystem reads reserve their destination again with LMB_NONE, which intentionally cannot overlap a NOOVERWRITE region. Keep the validated fixed 64 MiB address and allocator reservation; firmware and secure memory exclusions remain enforced.
---
 arch/arm/mach-snapdragon/board.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm/mach-snapdragon/board.c b/arch/arm/mach-snapdragon/board.c
index 6beae3c5..4d96c426 100644
--- a/arch/arm/mach-snapdragon/board.c
+++ b/arch/arm/mach-snapdragon/board.c
@@ -589,7 +589,7 @@ int board_late_init(void)
 				transfer_valid = true;
 		if (!transfer_valid ||
 		    lmb_alloc_mem(LMB_MEM_ALLOC_ADDR, SZ_4K, &addr, SZ_64M,
-				  LMB_NOOVERWRITE))
+				  LMB_NONE))
 			panic("Dodge: no safe 64MiB transfer region\n");
 #ifdef CONFIG_QCOM_DODGE
 		dodge_map_initrd();
-- 
