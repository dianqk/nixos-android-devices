From 0925f1412d215bb4414b069d18a15dc0a85f67b2 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Thu, 5 Nov 2026 22:04:13 +0800
Subject: [PATCH] arm64: dts: qcom: describe the Dodge PMK8550 at SPMI SID0

Expose the PMK8550 through the existing Qualcomm generic PMIC driver, retaining the repeater PMIC at SID7. The PMK8550 identity and bus address match the OEM device tree.
---
 dts/upstream/src/arm64/qcom/sm8750-oneplus-dodge.dts | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/dts/upstream/src/arm64/qcom/sm8750-oneplus-dodge.dts b/dts/upstream/src/arm64/qcom/sm8750-oneplus-dodge.dts
index 855d2dcc..675631c3 100644
--- a/dts/upstream/src/arm64/qcom/sm8750-oneplus-dodge.dts
+++ b/dts/upstream/src/arm64/qcom/sm8750-oneplus-dodge.dts
@@ -101,6 +101,12 @@
 			qcom,bus-id = <0>;
 			#address-cells = <2>;
 			#size-cells = <0>;
+			pmk8550: pmic@0 {
+				compatible = "qcom,pmk8550", "qcom,spmi-pmic";
+				reg = <0 0>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+			};
 			pmih010: pmic@7 {
 				compatible = "qcom,spmi-pmic";
 				reg = <7 0>;
