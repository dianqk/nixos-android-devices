+/* HC v4+ requires SYS1CLK_1US before link startup (Linux cfg_timers). */
+static int ufs_qcom_cfg_sys1clk(struct ufs_hba *hba)
+{
+	struct ufs_qcom_priv *priv = dev_get_priv(hba->dev);
+	u32 cycles, programmed;
+
+	if (!device_is_compatible(hba->dev, "qcom,sm8750-ufshc"))
+		return 0;
+	if (priv->core_clk_rate < 1000000 || priv->core_clk_rate % 1000000)
+		return -EINVAL;
