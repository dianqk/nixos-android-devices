--- a/drivers/clk/qcom/clock-sm8750.c
+++ b/drivers/clk/qcom/clock-sm8750.c
@@ -1,7 +1,7 @@
 // SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
 /*
  * Copyright (c) 2024, Qualcomm Innovation Center, Inc. All rights reserved.
- * Minimal USB2 support adapted from Linux gcc-sm8750.c/tcsrcc-sm8750.c
+ * USB2 and UFS support adapted from Linux gcc-sm8750.c/tcsrcc-sm8750.c
  * by Taniya Das; see the patch message for source revisions.
  */
 #include <clk-uclass.h>
@@ -24,15 +24,31 @@ static ulong sm8750_set_rate(struct clk *clk, ulong rate)
 	struct msm_clk_priv *priv = dev_get_priv(clk->dev);
 	const struct freq_tbl *f;
 	switch (clk->id) {
+	case GCC_UFS_PHY_AXI_CLK:
+	case GCC_UFS_PHY_UNIPRO_CORE_CLK:
+		/* First read-only profile uses the documented 100MHz OPP/GPLL0 divider. */
+		if (rate != 100000000)
+			return -EINVAL;
+		clk_rcg_set_rate(priv->base,
+				 clk->id == GCC_UFS_PHY_AXI_CLK ? 0x77034 :
+								  0x770a4,
+				 3, CFG_CLK_SRC_GPLL0_EVEN);
+		return rate;
+	case GCC_UFS_PHY_PHY_AUX_CLK:
+		if (rate != 19200000)
+			return -EINVAL;
+		clk_rcg_set_rate(priv->base, 0x770c0, 1, CFG_CLK_SRC_CXO);
+		return rate;
 	case GCC_USB30_PRIM_MASTER_CLK:
 		f = qcom_find_freq(usb_master_rates, rate);
 		clk_rcg_set_rate_mnd(priv->base, 0x39030, f->pre_div, f->m,
 				     f->n, f->src, 8);
 		return f->freq;
 	case GCC_USB30_PRIM_MOCK_UTMI_CLK:
-		/* CXO is 19.2MHz after the SM8750 GCC input divide-by-two.
-   * Preserve the read-only postdivider; reject an unexpected divider.
-   */
+		/*
+		 * CXO is 19.2MHz after the SM8750 GCC input divide-by-two.
+		 * Preserve the read-only postdivider; reject an unexpected divider.
+		 */
 		if (rate != 19200000 || (readl(priv->base + 0x39060) & 0xf))
 			return -EINVAL;
 		clk_rcg_set_rate(priv->base, 0x39048, 1, CFG_CLK_SRC_CXO);
@@ -42,6 +58,14 @@ static ulong sm8750_set_rate(struct clk *clk, ulong rate)
 	}
 }
 static const struct gate_clk sm8750_clks[] = {
+	GATE_CLK_POLLED(GCC_AGGRE_UFS_PHY_AXI_CLK, 0x770f0, BIT(0), 0x770f0),
+	GATE_CLK_POLLED(GCC_UFS_PHY_AXI_CLK, 0x77018, BIT(0), 0x77018),
+	GATE_CLK_POLLED(GCC_UFS_PHY_AHB_CLK, 0x77028, BIT(0), 0x77028),
+	GATE_CLK_POLLED(GCC_UFS_PHY_UNIPRO_CORE_CLK, 0x7706c, BIT(0), 0x7706c),
+	GATE_CLK_POLLED(GCC_UFS_PHY_PHY_AUX_CLK, 0x770bc, BIT(0), 0x770bc),
+	GATE_CLK(GCC_UFS_PHY_TX_SYMBOL_0_CLK, 0x7702c, BIT(0)),
+	GATE_CLK(GCC_UFS_PHY_RX_SYMBOL_0_CLK, 0x77030, BIT(0)),
+	GATE_CLK(GCC_UFS_PHY_RX_SYMBOL_1_CLK, 0x770d8, BIT(0)),
 	GATE_CLK_POLLED(GCC_CFG_NOC_USB3_PRIM_AXI_CLK, 0x3908c, BIT(0),
 			0x3908c),
 	GATE_CLK_POLLED(GCC_USB30_PRIM_MASTER_CLK, 0x39018, BIT(0), 0x39018),
@@ -52,13 +76,52 @@ static const struct gate_clk sm8750_clks[] = {
 static int sm8750_enable(struct clk *clk)
 {
 	struct msm_clk_priv *priv = dev_get_priv(clk->dev);
-	return qcom_gate_clk_en(priv, clk->id);
+	u32 cbcr;
+	int ret;
+
+	switch (clk->id) {
+	case GCC_AGGRE_UFS_PHY_AXI_CLK:
+	case GCC_UFS_PHY_AXI_CLK:
+	case GCC_UFS_PHY_AHB_CLK:
+	case GCC_UFS_PHY_UNIPRO_CORE_CLK:
+	case GCC_UFS_PHY_PHY_AUX_CLK:
+		/* Linux clk-branch.c does not poll halt in hardware-gated mode. */
+		setbits_le32(priv->base + sm8750_clks[clk->id].reg, BIT(0));
+		cbcr = readl(priv->base + sm8750_clks[clk->id].reg);
+		printf("UFS clock %lu CBCR=%#010x HWCG=%u\n", clk->id, cbcr,
+		       !!(cbcr & BIT(1)));
+		if (cbcr & BIT(1))
+			return 0;
+		break;
+	default:
+		break;
+	}
+
+	ret = qcom_gate_clk_en(priv, clk->id);
+	if (ret && clk->id < ARRAY_SIZE(sm8750_clks) && sm8750_clks[clk->id].reg)
+		printf("Clock %lu failed: raw CBCR=%#010x\n", clk->id,
+		       readl(priv->base + sm8750_clks[clk->id].reg));
+	if (!ret && (clk->id == GCC_UFS_PHY_TX_SYMBOL_0_CLK ||
+		     clk->id == GCC_UFS_PHY_RX_SYMBOL_0_CLK ||
+		     clk->id == GCC_UFS_PHY_RX_SYMBOL_1_CLK)) {
+		u32 mux = clk->id == GCC_UFS_PHY_TX_SYMBOL_0_CLK ? 0x77058 :
+			  clk->id == GCC_UFS_PHY_RX_SYMBOL_0_CLK ? 0x77068 : 0x770ec;
+		u32 val = readl(priv->base + mux);
+
+		printf("UFS symbol clock %lu mux[%#x]=%#x selector=%u\n",
+		       clk->id, mux, val, val & 3);
+		udelay(10); /* Linux BRANCH_HALT_DELAY. */
+	}
+	return ret;
 }
 static const struct qcom_reset_map sm8750_resets[] = {
+	[GCC_UFS_PHY_BCR] = { 0x77000 },
 	[GCC_QUSB2PHY_PRIM_BCR] = { 0x12000 },
 	[GCC_USB30_PRIM_BCR] = { 0x39000 },
 };
 static const struct qcom_power_map sm8750_domains[] = {
+	[GCC_UFS_PHY_GDSC] = { 0x77004 },
+	[GCC_UFS_MEM_PHY_GDSC] = { 0x9e000 },
 	[GCC_USB30_PRIM_GDSC] = { 0x39004 },
 };
 static struct msm_clk_data sm8750_data = {
@@ -85,9 +148,16 @@ U_BOOT_DRIVER(gcc_sm8750) = {
 static int tcsr_enable(struct clk *clk)
 {
 	fdt_addr_t base = dev_read_addr(clk->dev);
-	if (clk->id != TCSR_USB2_CLKREF_EN)
+	switch (clk->id) {
+	case TCSR_UFS_CLKREF_EN:
+		setbits_le32(base + 0x1000, BIT(0));
+		break;
+	case TCSR_USB2_CLKREF_EN:
+		setbits_le32(base + 0x2000, BIT(0));
+		break;
+	default:
 		return -EINVAL;
-	setbits_le32(base + 0x2000, BIT(0));
+	}
 	udelay(10);
 	return 0;
 }
