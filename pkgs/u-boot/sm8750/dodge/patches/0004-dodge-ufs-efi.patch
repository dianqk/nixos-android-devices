+// SPDX-License-Identifier: GPL-2.0+
+/* Read-only, return-to-caller UEFI protocol probe. Never writes media/variables. */
+#include <efi_api.h>
+
+static struct efi_system_table *st;
+static const efi_guid_t image_guid = EFI_LOADED_IMAGE_PROTOCOL_GUID;
+static const efi_guid_t block_guid = EFI_BLOCK_IO_PROTOCOL_GUID;
+
+static void field(const u16 *name, u64 value)
+{
+	u16 text[19];
+	unsigned int i;
+
+	text[0] = '0';
+	text[1] = 'x';
+	for (i = 0; i < 16; i++) {
+		u32 n = (value >> (60 - i * 4)) & 15;
+		text[i + 2] = n < 10 ? '0' + n : 'a' + n - 10;
+	}
+	text[18] = 0;
+	st->con_out->output_string(st->con_out, name);
+	st->con_out->output_string(st->con_out, text);
+	st->con_out->output_string(st->con_out, u"\r\n");
+}
+
+efi_status_t EFIAPI efi_main(efi_handle_t handle,
+			     struct efi_system_table *table)
+{
+	struct efi_boot_services *bs = table->boottime;
+	struct efi_loaded_image *image;
+	struct efi_mem_desc *map = NULL, *desc;
+	efi_handle_t *handles = NULL;
+	efi_uintn_t size = 0, key, stride = 0, count = 0, i, raw = 0;
+	efi_physical_addr_t buffer = 0xefffffff;
+	efi_status_t ret;
+	u32 version, crc;
+	u64 conventional_end = 0;
+
+	st = table;
+	st->con_out->output_string(st->con_out, u"EFI-DODGE-PROBE v1\r\n");
+	ret = bs->open_protocol(handle, &image_guid, (void **)&image, handle,
+				NULL, EFI_OPEN_PROTOCOL_GET_PROTOCOL);
+	if (ret != EFI_SUCCESS)
+		goto out;
+	field(u"image_base=", (uintptr_t)image->image_base);
+	field(u"image_size=", image->image_size);
+	ret = bs->get_memory_map(&size, NULL, &key, &stride, &version);
+	if (ret != EFI_BUFFER_TOO_SMALL || !stride)
+		goto out;
+	size += 8 * stride;
+	ret = bs->allocate_pool(EFI_LOADER_DATA, size, (void **)&map);
+	if (ret != EFI_SUCCESS)
+		goto out;
+	ret = bs->get_memory_map(&size, map, &key, &stride, &version);
+	if (ret != EFI_SUCCESS)
+		goto out;
+	field(u"memory_descriptors=", size / stride);
+	for (i = 0; i < size / stride; i++) {
+		u64 end;
+		desc = (void *)((u8 *)map + i * stride);
+		if (desc->type != EFI_CONVENTIONAL_MEMORY)
+			continue;
+		end = desc->physical_start + desc->num_pages * EFI_PAGE_SIZE;
+		if (end > conventional_end)
+			conventional_end = end;
+		if (desc->physical_start < 0xc4000000 && end > 0xc0000000) {
+			ret = EFI_ABORTED;
+			goto out;
+		}
+	}
+	field(u"conventional_memory_end=", conventional_end);
+	if (conventional_end > 0xf0000000) {
+		ret = EFI_ABORTED;
+		goto out;
+	}
+	ret = bs->allocate_pages(EFI_ALLOCATE_MAX_ADDRESS, EFI_LOADER_DATA, 1,
+				 &buffer);
+	if (ret != EFI_SUCCESS) {
+		buffer = 0;
+		goto out;
+	}
+	field(u"read_buffer=", buffer);
+	if (buffer < 0x90000000 || buffer + EFI_PAGE_SIZE > 0xf0000000 ||
+	    (buffer < 0xc4000000 && buffer + EFI_PAGE_SIZE > 0xc0000000)) {
+		ret = EFI_ABORTED;
+		goto out;
+	}
+	ret = bs->locate_handle_buffer(BY_PROTOCOL, &block_guid, NULL, &count,
+				       &handles);
+	if (ret == EFI_NOT_FOUND)
+		goto out;
+	if (ret != EFI_SUCCESS)
+		goto out;
+	for (i = 0; i < count; i++) {
+		struct efi_block_io *io;
+		ret = bs->open_protocol(handles[i], &block_guid, (void **)&io,
+					handle, NULL,
+					EFI_OPEN_PROTOCOL_GET_PROTOCOL);
+		if (ret != EFI_SUCCESS)
+			goto out;
+		if (io->media->logical_partition)
+			continue;
+		field(u"raw_disk=", raw++);
+		field(u"read_only=", io->media->read_only);
+		field(u"block_size=", io->media->block_size);
+		field(u"last_block=", io->media->last_block);
+		if (!io->media->read_only || !io->media->media_present ||
+		    io->media->block_size != EFI_PAGE_SIZE ||
+		    !io->media->last_block) {
+			ret = EFI_ABORTED;
+			goto out;
+		}
+		ret = io->read_blocks(io, io->media->media_id, 0,
+				      io->media->block_size,
+				      (void *)(uintptr_t)buffer);
+		if (ret != EFI_SUCCESS)
+			goto out;
+		ret = bs->calculate_crc32((void *)(uintptr_t)buffer,
+					  io->media->block_size, &crc);
+		if (ret != EFI_SUCCESS)
+			goto out;
+		field(u"lba0_crc32=", crc);
+	}
+	if (raw != 6)
+		ret = EFI_NOT_FOUND;
+
+out:
+	field(u"raw_disks=", raw);
+	field(u"status=", ret);
+	if (handles)
+		bs->free_pool(handles);
+	if (buffer && buffer != 0xefffffff)
+		bs->free_pages(buffer, 1);
+	if (map)
+		bs->free_pool(map);
+	st->con_out->output_string(
+		st->con_out, ret == EFI_SUCCESS ? u"EFI-DODGE-PROBE PASS\r\n" :
+						  u"EFI-DODGE-PROBE FAIL\r\n");
+	return ret;
+}
