diff --git a/include/scsi_read_only.h b/include/scsi_read_only.h
new file mode 100644
index 00000000..99dc12e8
--- /dev/null
+++ b/include/scsi_read_only.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+#ifndef __SCSI_READ_ONLY_H
+#define __SCSI_READ_ONLY_H
+/* Default-deny: these commands cannot modify media or persistent settings. */
+static inline int scsi_command_is_read_only(const unsigned char *cdb,
+					    unsigned int length)
+{
+	if (!length)
+		return 0;
+	switch (cdb[0]) {
+	case 0x00: /* TEST UNIT READY */
+	case 0x03: /* REQUEST SENSE */
+	case 0x08: /* READ(6) */
+	case 0x12: /* INQUIRY */
+	case 0x25: /* READ CAPACITY(10) */
+	case 0x28: /* READ(10) */
+	case 0x88: /* READ(16) */
+	case 0xa0: /* REPORT LUNS */
+	case 0xa8: /* READ(12) */
+		return 1;
+	case 0x9e: /* SERVICE ACTION IN: only READ CAPACITY(16) */
+		return length >= 16 && (cdb[1] & 0x1f) == 0x10;
+	default:
+		return 0;
+	}
+}
+#endif
