+
+static int ufs_qcom_phy_reset_set(struct reset_ctl *reset, bool assert)
+{
+	void __iomem *base = dev_read_addr_ptr(reset->dev);
+	u32 val;
+
+	if (reset->id || !base)
+		return -EINVAL;
+	val = readl(base + REG_UFS_CFG1);
+	if (assert)
+		val |= UFS_PHY_SOFT_RESET;
+	else
+		val &= ~UFS_PHY_SOFT_RESET;
+	writel(val, base + REG_UFS_CFG1);
+	/* Complete the posted write before the settling interval. */
+	val = readl(base + REG_UFS_CFG1);
