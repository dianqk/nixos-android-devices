From 7d187c93c5f1061759b061ad9e16c44c72fb9ff3 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Fri, 6 Nov 2026 17:17:45 +0800
Subject: [PATCH] arm64: dts: qcom: describe Dodge inherited framebuffer

Describe the ABL-initialized 1440x3168 framebuffer for the simple video console. Its splash allocation is already reserved by the imported ABL memory map. Set the optional rotation property explicitly for the simple display driver.

Link: https://github.com/derekross/omarchy-mobile/blob/8f7e25d3574f34f9fb862f98722e59aef33eeca1/device/dodge/chainload/stage2-dtb.py
---
 .../src/arm64/qcom/sm8750-oneplus-dodge.dts     | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/dts/upstream/src/arm64/qcom/sm8750-oneplus-dodge.dts b/dts/upstream/src/arm64/qcom/sm8750-oneplus-dodge.dts
index a89b5263..86952fc1 100644
--- a/dts/upstream/src/arm64/qcom/sm8750-oneplus-dodge.dts
+++ b/dts/upstream/src/arm64/qcom/sm8750-oneplus-dodge.dts
@@ -11,7 +11,22 @@
 	/* ABL supplies the complete memory and reservation contract at entry. */
 	memory { device_type = "memory"; };
 	reserved-memory { #address-cells = <2>; #size-cells = <2>; ranges; };
-	chosen { };
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		framebuffer@fc800000 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0xfc800000 0x0 0x1167000>;
+			width = <1440>;
+			height = <3168>;
+			stride = <5760>;
+			format = "a8r8g8b8";
+			rot = <0>;
+			status = "okay";
+		};
+	};
 	psci { compatible = "arm,psci-1.0"; method = "smc"; };
 	timer { compatible = "arm,armv8-timer"; };
 	soc {
