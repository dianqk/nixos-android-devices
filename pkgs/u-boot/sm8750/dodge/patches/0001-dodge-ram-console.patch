diff --git a/arch/arm/mach-snapdragon/dodge.c b/arch/arm/mach-snapdragon/dodge.c
new file mode 100644
index 00000000..431a39a9
--- /dev/null
+++ b/arch/arm/mach-snapdragon/dodge.c
@@ -0,0 +1,196 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* ABL runtime memory contract for the OnePlus 13 embedded control tree. */
+#include <asm/sections.h>
+
+#define DODGE_MAX_RESERVED 128
+#define DODGE_FDT_BYTES SZ_64K
+/* board_fdt_blob_setup runs before BSS is available. */
+static u8 dodge_fdt[DODGE_FDT_BYTES] __aligned(8) __section(".data") = { 1 };
+
+struct dodge_range {
+	u64 start, end;
+};
+
+/* Select a contiguous, DMA-addressable arena without the running Image. */
+static u64 dodge_select_arena(const fdt64_t *banks, int count, u64 image_start,
+			      u64 image_end, u64 needed)
+{
+	u64 top = 0, start, end;
+	int i;
+	for (i = 0; i < count; i++) {
+		start = max_t(u64, fdt64_to_cpu(banks[i * 2]), 0x90000000);
+		end = min_t(u64,
+			    fdt64_to_cpu(banks[i * 2]) +
+				    fdt64_to_cpu(banks[i * 2 + 1]),
+			    0xf0000000);
+		if (end <= start)
+			continue;
+		if (start < image_end && image_start < end) {
+			if (end > image_end && end - image_end >= needed)
+				start = image_end;
+			else
+				end = image_start;
+		}
+		if (end > start && end - start >= needed)
+			top = max(top, end);
+	}
+	return top;
+}
+
+static void dodge_add_range(struct dodge_range *ranges, int *count, u64 start,
+			    u64 size)
+{
+	if (!size)
+		return;
+	if (start + size < start || *count == DODGE_MAX_RESERVED)
+		panic("Dodge: invalid or excessive reserved ranges\n");
+	ranges[*count].start = ALIGN_DOWN(start, SZ_4K);
+	if (start + size > U64_MAX - (SZ_4K - 1))
+		panic("Dodge: reserved range overflow\n");
+	ranges[*count].end = ALIGN(start + size, SZ_4K);
+	(*count)++;
+}
+
+/* Called only for the embedded Dodge DT. Never alter the caller's ABL DT. */
+static void *dodge_import_fdt(const void *internal, const void *external)
+{
+	struct dodge_range reserved[DODGE_MAX_RESERVED];
+	const fdt64_t *reg;
+	fdt64_t banks[CONFIG_NR_DRAM_BANKS * 2];
+	int root, src, dst, node, len, nres = 0, nbanks = 0, i, j, ret;
+	u64 start, size, end, pos, next;
+	const void *prop;
+	const char *name;
+
+	if (!external || fdt_check_header(external) ||
+	    (fdt_node_check_compatible(external, 0, "qcom,sun") &&
+	     fdt_node_check_compatible(external, 0, "qcom,sm8750")))
+		panic("Dodge: SM8750 ABL FDT required\n");
+	if (fdt_address_cells(external, 0) != 2 ||
+	    fdt_size_cells(external, 0) != 2)
+		panic("Dodge: unsupported ABL cell widths\n");
+	ret = fdt_open_into(internal, dodge_fdt, sizeof(dodge_fdt));
+	if (ret)
+		panic("Dodge: cannot expand control FDT\n");
+	root = fdt_path_offset(external, "/reserved-memory");
+	if (root < 0 || fdt_address_cells(external, root) != 2 ||
+	    fdt_size_cells(external, root) != 2)
+		panic("Dodge: complete ABL reservations required\n");
+	/* Geometry only: OEM phandles and compatibles cannot collide or bind drivers. */
+	fdt_for_each_subnode(node, external, root) {
+		reg = fdt_getprop(external, node, "reg", &len);
+		if (!reg)
+			continue; /* size-only pools have no allocation before Linux. */
+		if (len <= 0 || len % 16)
+			panic("Dodge: invalid reservation tuple\n");
+		for (i = 0; i < len / 16; i++)
+			dodge_add_range(reserved, &nres,
+					get_unaligned_be64(&reg[i * 2]),
+					get_unaligned_be64(&reg[i * 2 + 1]));
+		dst = fdt_path_offset(dodge_fdt, "/reserved-memory");
+		name = fdt_get_name(external, node, NULL);
+		dst = fdt_add_subnode(dodge_fdt, dst, name);
+		if (dst < 0 || fdt_setprop(dodge_fdt, dst, "reg", reg, len))
+			panic("Dodge: reservation import exceeds control FDT\n");
+		if (fdt_getprop(external, node, "no-map", NULL) &&
+		    fdt_setprop(dodge_fdt, dst, "no-map", NULL, 0))
+			panic("Dodge: reservation flag import failed\n");
+	}
+	for (i = 0; i < fdt_num_mem_rsv(external); i++) {
+		if (fdt_get_mem_rsv(external, i, &start, &size))
+			panic("Dodge: invalid FDT reservation\n");
+		dodge_add_range(reserved, &nres, start, size);
+		if (fdt_add_mem_rsv(dodge_fdt, start, size))
+			panic("Dodge: reservation map import failed\n");
+	}
+	/* Keep the source FDT intact until relocation has copied the control tree. */
+	dodge_add_range(reserved, &nres, (uintptr_t)external,
+			fdt_totalsize(external));
+	src = fdt_path_offset(external, "/chosen");
+	if (src < 0)
+		panic("Dodge: missing ABL chosen node\n");
+	dst = fdt_path_offset(dodge_fdt, "/chosen");
+	name = "bootargs";
+	prop = fdt_getprop(external, src, name, &len);
+	if (prop && (len <= 0 || ((const char *)prop)[len - 1] ||
+		     fdt_setprop(dodge_fdt, dst, name, prop, len)))
+		panic("Dodge: invalid bootargs\n");
+	reg = fdt_getprop(external, src, "linux,initrd-start", &len);
+	if (reg) {
+		if (len != 8)
+			panic("Dodge: invalid initrd start\n");
+		start = get_unaligned_be64(reg);
+		reg = fdt_getprop(external, src, "linux,initrd-end", &len);
+		if (!reg || len != 8)
+			panic("Dodge: invalid initrd end\n");
+		end = get_unaligned_be64(reg);
+		if (end <= start)
+			panic("Dodge: invalid initrd range\n");
+		dodge_add_range(reserved, &nres, start, end - start);
+		if (fdt_setprop_u64(dodge_fdt, dst, "linux,initrd-start",
+				    start) ||
+		    fdt_setprop_u64(dodge_fdt, dst, "linux,initrd-end", end) ||
+		    fdt_add_mem_rsv(dodge_fdt, start, end - start))
+			panic("Dodge: initrd reservation import failed\n");
+	}
+	src = fdt_path_offset(external, "/memory");
+	reg = fdt_getprop(external, src, "reg", &len);
+	if (!reg || len <= 0 || len % 16 || len / 16 > CONFIG_NR_DRAM_BANKS)
+		panic("Dodge: invalid or excessive ABL memory banks\n");
+	/* Subtract every fixed reservation. No speculative mapping or relocation may
+  * touch a carveout; dynamic CMA allocation is left to the eventual kernel.
+  */
+	for (i = 0; i < len / 16; i++) {
+		start = get_unaligned_be64(&reg[i * 2]);
+		size = get_unaligned_be64(&reg[i * 2 + 1]);
+		if (!size)
+			continue;
+		end = start + size;
+		if (end < start || (start | size) & (SZ_4K - 1))
+			panic("Dodge: invalid ABL memory range\n");
+		for (j = 0; j < i; j++) {
+			u64 a = get_unaligned_be64(&reg[j * 2]);
+			u64 b = get_unaligned_be64(&reg[j * 2 + 1]);
+			if (b && start < a + b && a < end)
+				panic("Dodge: overlapping ABL memory banks\n");
+		}
+		pos = start;
+		while (pos < end) {
+			next = end;
+			for (j = 0; j < nres; j++) {
+				if (reserved[j].start <= pos &&
+				    reserved[j].end > pos) {
+					pos = min(end, reserved[j].end);
+					break;
+				}
+				if (reserved[j].start > pos)
+					next = min(next, reserved[j].start);
+			}
+			if (j < nres)
+				continue;
+			if (nbanks == CONFIG_NR_DRAM_BANKS)
+				panic("Dodge: carveouts exceed memory bank capacity\n");
+			banks[nbanks * 2] = cpu_to_fdt64(pos);
+			banks[nbanks * 2 + 1] = cpu_to_fdt64(next - pos);
+			nbanks++;
+			pos = next;
+		}
+	}
+	/* The Image header reserves the BSS/early-stack footprint for ABL. Check that
+  * footprint against the actual handoff before any relocation or MMU setup.
+  */
+	start = (uintptr_t)_start;
+	end = (uintptr_t)__bss_start + CONFIG_SYS_INIT_SP_BSS_OFFSET;
+	for (i = 0; i < nbanks; i++) {
+		u64 a = fdt64_to_cpu(banks[i * 2]);
+		u64 b = fdt64_to_cpu(banks[i * 2 + 1]);
+		if (a <= start && end <= a + b)
+			break;
+	}
+	if (i == nbanks)
+		panic("Dodge: Image and early stack outside usable ABL RAM\n");
+	dst = fdt_path_offset(dodge_fdt, "/memory");
+	if (!nbanks || fdt_setprop(dodge_fdt, dst, "reg", banks, nbanks * 16))
+		panic("Dodge: memory import failed\n");
+	return dodge_fdt;
+}
