diff --git a/drivers/phy/qcom/phy-dodge-eusb2-repeater.c b/drivers/phy/qcom/phy-dodge-eusb2-repeater.c
new file mode 100644
index 00000000..ae098234
--- /dev/null
+++ b/drivers/phy/qcom/phy-dodge-eusb2-repeater.c
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * PMI H010 device-mode repeater for OnePlus 13.
+ * Register protocol follows Linux phy-qcom-eusb2-repeater.c (Abel Vesa).
+ * Tuning is the PJZ110 shipped qcom,param-override-seq, not PM8550B defaults.
+ * ABL owns the shared supply votes.
+ */
+#include <dm.h>
+#include <generic-phy.h>
+#include <power/pmic.h>
+#include <linux/delay.h>
+static int dodge_repeater_init(struct phy *phy)
+{
+	static const struct {
+		u8 reg, value;
+	} seq[] = {
+
+		{ 0x51, 0x0e }, { 0x53, 0x07 }, { 0x54, 0x04 },
+		{ 0x55, 0x02 }, { 0x57, 0x04 },
+
+	};
+	int i, ret;
+	ret = pmic_clrsetbits(phy->dev->parent, 0xfd46, 0x80, 0x80);
+	if (ret)
+		return ret;
+	for (i = 0; i < ARRAY_SIZE(seq); i++) {
+		ret = pmic_reg_write(phy->dev->parent, 0xfd00 + seq[i].reg,
+				     seq[i].value);
+		if (ret)
+			return ret;
+	}
+	/* Clear only the CM.Lx host workaround bit; preserve unrelated forces. */
+	ret = pmic_clrsetbits(phy->dev->parent, 0xfde8, 0x40, 0);
+	if (ret)
+		return ret;
+	ret = pmic_clrsetbits(phy->dev->parent, 0xfded, 0x40, 0);
+	if (ret)
+		return ret;
+	for (i = 0; i < 100; i++) {
+		ret = pmic_reg_read(phy->dev->parent, 0xfd08);
+		if (ret < 0)
+			return ret;
+		if (ret & 0x80)
+			return 0;
+		udelay(50);
+	}
+	return -ETIMEDOUT;
+}
+static struct phy_ops dodge_repeater_ops = { .init = dodge_repeater_init };
+static const struct udevice_id dodge_repeater_ids[] = {
+	{ .compatible = "oneplus,dodge-eusb2-repeater" },
+	{}
+};
+U_BOOT_DRIVER(dodge_eusb2_repeater) = {
+	.name = "dodge_eusb2_repeater",
+	.id = UCLASS_PHY,
+	.of_match = dodge_repeater_ids,
+	.ops = &dodge_repeater_ops,
+};
diff --git a/drivers/phy/qcom/phy-qcom-m31-eusb2.c b/drivers/phy/qcom/phy-qcom-m31-eusb2.c
new file mode 100644
index 00000000..ed9b0237
--- /dev/null
+++ b/drivers/phy/qcom/phy-qcom-m31-eusb2.c
@@ -0,0 +1,187 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Copyright (c) 2024-2025 Qualcomm Innovation Center, Inc. All rights reserved.
+ * Adapted from Wesley Cheng's Linux M31 eUSB2 driver.
+ * ABL retains the shared supply votes; this driver does not change rails.
+ */
+#include <clk.h>
+#include <dm.h>
+#include <generic-phy.h>
+#include <reset.h>
+#include <asm/io.h>
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#define USB_PHY_UTMI_CTRL0 (0x3c)
+#define SLEEPM BIT(0)
+
+#define USB_PHY_UTMI_CTRL5 (0x50)
+#define POR BIT(1)
+
+#define USB_PHY_HS_PHY_CTRL_COMMON0 (0x54)
+#define PHY_ENABLE BIT(0)
+#define SIDDQ_SEL BIT(1)
+#define SIDDQ BIT(2)
+#define FSEL GENMASK(6, 4)
+#define FSEL_38_4_MHZ_VAL (0x6)
+
+#define USB_PHY_HS_PHY_CTRL2 (0x64)
+#define USB2_SUSPEND_N BIT(2)
+#define USB2_SUSPEND_N_SEL BIT(3)
+
+#define USB_PHY_CFG0 (0x94)
+#define UTMI_PHY_CMN_CTRL_OVERRIDE_EN BIT(1)
+
+#define USB_PHY_CFG1 (0x154)
+#define PLL_EN BIT(0)
+
+#define USB_PHY_FSEL_SEL (0xb8)
+#define FSEL_SEL BIT(0)
+
+#define USB_PHY_XCFGI_39_32 (0x16c)
+#define HSTX_PE GENMASK(3, 2)
+
+#define USB_PHY_XCFGI_71_64 (0x17c)
+#define HSTX_SWING GENMASK(3, 0)
+
+#define USB_PHY_XCFGI_31_24 (0x168)
+#define HSTX_SLEW GENMASK(2, 0)
+
+#define USB_PHY_XCFGI_7_0 (0x15c)
+#define PLL_LOCK_TIME GENMASK(1, 0)
+
+#define M31_EUSB_PHY_INIT_CFG(o, b, v) \
+	{                              \
+		.off = o,              \
+		.mask = b,             \
+		.val = v,              \
+	}
+
+struct m31_phy_tbl_entry {
+	u32 off;
+	u32 mask;
+	u32 val;
+};
+
+static const struct m31_phy_tbl_entry m31_eusb2_setup_tbl[] = {
+	M31_EUSB_PHY_INIT_CFG(USB_PHY_CFG0, UTMI_PHY_CMN_CTRL_OVERRIDE_EN, 1),
+	M31_EUSB_PHY_INIT_CFG(USB_PHY_UTMI_CTRL5, POR, 1),
+	M31_EUSB_PHY_INIT_CFG(USB_PHY_HS_PHY_CTRL_COMMON0, PHY_ENABLE, 1),
+	M31_EUSB_PHY_INIT_CFG(USB_PHY_CFG1, PLL_EN, 0),
+	M31_EUSB_PHY_INIT_CFG(USB_PHY_FSEL_SEL, FSEL_SEL, 1),
+};
+
+static const struct m31_phy_tbl_entry m31_eusb_phy_override_tbl[] = {
+	M31_EUSB_PHY_INIT_CFG(USB_PHY_XCFGI_39_32, HSTX_PE, 0),
+	M31_EUSB_PHY_INIT_CFG(USB_PHY_XCFGI_71_64, HSTX_SWING, 7),
+	M31_EUSB_PHY_INIT_CFG(USB_PHY_XCFGI_31_24, HSTX_SLEW, 0),
+	M31_EUSB_PHY_INIT_CFG(USB_PHY_XCFGI_7_0, PLL_LOCK_TIME, 0),
+};
+
+static const struct m31_phy_tbl_entry m31_eusb_phy_reset_tbl[] = {
+	M31_EUSB_PHY_INIT_CFG(USB_PHY_HS_PHY_CTRL2, USB2_SUSPEND_N_SEL, 1),
+	M31_EUSB_PHY_INIT_CFG(USB_PHY_HS_PHY_CTRL2, USB2_SUSPEND_N, 1),
+	M31_EUSB_PHY_INIT_CFG(USB_PHY_UTMI_CTRL0, SLEEPM, 1),
+	M31_EUSB_PHY_INIT_CFG(USB_PHY_HS_PHY_CTRL_COMMON0, SIDDQ_SEL, 1),
+	M31_EUSB_PHY_INIT_CFG(USB_PHY_HS_PHY_CTRL_COMMON0, SIDDQ, 0),
+	M31_EUSB_PHY_INIT_CFG(USB_PHY_UTMI_CTRL5, POR, 0),
+	M31_EUSB_PHY_INIT_CFG(USB_PHY_HS_PHY_CTRL2, USB2_SUSPEND_N_SEL, 0),
+	M31_EUSB_PHY_INIT_CFG(USB_PHY_CFG0, UTMI_PHY_CMN_CTRL_OVERRIDE_EN, 0),
+};
+
+struct m31_priv {
+	void __iomem *base;
+	struct clk ref;
+	struct reset_ctl reset;
+	struct phy repeater;
+};
+static int m31_write(struct m31_priv *p, u32 off, u32 mask, u32 value)
+{
+	clrsetbits_le32(p->base + off, mask, value);
+	return (readl(p->base + off) & mask) == value ? 0 : -EIO;
+}
+static int m31_sequence(struct m31_priv *p, const struct m31_phy_tbl_entry *t,
+			int n)
+{
+	int i, ret;
+	for (i = 0; i < n; i++) {
+		ret = m31_write(p, t[i].off, t[i].mask,
+				t[i].val << __ffs(t[i].mask));
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+static int m31_on(struct phy *phy)
+{
+	struct m31_priv *p = dev_get_priv(phy->dev);
+	int ret;
+	if (clk_get_rate(&p->ref) != 38400000)
+		return -EINVAL;
+	ret = generic_phy_init(&p->repeater);
+	if (ret)
+		return ret;
+	ret = clk_enable(&p->ref);
+	if (ret)
+		goto exit_repeater;
+	ret = reset_assert(&p->reset);
+	if (ret)
+		goto exit_repeater;
+	udelay(5);
+	ret = reset_deassert(&p->reset);
+	if (ret)
+		goto exit_repeater;
+	ret = m31_sequence(p, m31_eusb2_setup_tbl,
+			   ARRAY_SIZE(m31_eusb2_setup_tbl));
+	if (ret)
+		goto assert_reset;
+	ret = m31_write(p, USB_PHY_HS_PHY_CTRL_COMMON0, FSEL,
+			FIELD_PREP(FSEL, FSEL_38_4_MHZ_VAL));
+	if (ret)
+		goto assert_reset;
+	ret = m31_sequence(p, m31_eusb_phy_override_tbl,
+			   ARRAY_SIZE(m31_eusb_phy_override_tbl));
+	if (ret)
+		goto assert_reset;
+	ret = m31_sequence(p, m31_eusb_phy_reset_tbl,
+			   ARRAY_SIZE(m31_eusb_phy_reset_tbl));
+	if (!ret)
+		return 0;
+assert_reset:
+	reset_assert(&p->reset);
+exit_repeater:
+	generic_phy_exit(&p->repeater);
+	return ret;
+}
+static int m31_off(struct phy *phy)
+{
+	struct m31_priv *p = dev_get_priv(phy->dev);
+	reset_assert(&p->reset);
+	return generic_phy_exit(&p->repeater);
+}
+static int m31_probe(struct udevice *dev)
+{
+	struct m31_priv *p = dev_get_priv(dev);
+	int ret;
+	p->base = dev_read_addr_ptr(dev);
+	if (!p->base)
+		return -EINVAL;
+	ret = clk_get_by_name(dev, "ref", &p->ref);
+	if (ret)
+		return ret;
+	ret = reset_get_by_index(dev, 0, &p->reset);
+	if (ret)
+		return ret;
+	return generic_phy_get_by_index(dev, 0, &p->repeater);
+}
+static struct phy_ops m31_ops = { .power_on = m31_on, .power_off = m31_off };
+static const struct udevice_id m31_ids[] = {
+	{ .compatible = "qcom,sm8750-m31-eusb2-phy" },
+	{}
+};
+U_BOOT_DRIVER(qcom_m31_eusb2) = {
+	.name = "qcom_m31_eusb2",
+	.id = UCLASS_PHY,
+	.of_match = m31_ids,
+	.probe = m31_probe,
+	.ops = &m31_ops,
+	.priv_auto = sizeof(struct m31_priv),
+};
diff --git a/dts/upstream/src/arm64/qcom/sm8750-oneplus-dodge.dts b/dts/upstream/src/arm64/qcom/sm8750-oneplus-dodge.dts
new file mode 100644
index 00000000..671f976e
--- /dev/null
+++ b/dts/upstream/src/arm64/qcom/sm8750-oneplus-dodge.dts
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/dts-v1/;
+#include <dt-bindings/clock/qcom,sm8750-gcc.h>
+#include <dt-bindings/clock/qcom,sm8750-tcsr.h>
+/ {
+	model = "OnePlus 13";
+	compatible = "oneplus,dodge", "qcom,sm8750";
+	#address-cells = <2>;
+	#size-cells = <2>;
+	/* ABL supplies the complete memory and reservation contract at entry. */
+	memory { device_type = "memory"; };
+	reserved-memory { #address-cells = <2>; #size-cells = <2>; ranges; };
+	chosen { };
+	psci { compatible = "arm,psci-1.0"; method = "smc"; };
+	timer { compatible = "arm,armv8-timer"; };
+	soc {
+		compatible = "simple-bus";
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+		gcc: clock-controller@100000 {
+			compatible = "qcom,sm8750-gcc";
+			reg = <0 0x100000 0 0xc7000>;
+			#clock-cells = <1>;
+			#reset-cells = <1>;
+			#power-domain-cells = <1>;
+		};
+		tcsrcc: clock-controller@f204008 {
+			compatible = "qcom,sm8750-tcsr";
+			reg = <0 0xf204008 0 0x2004>;
+			#clock-cells = <1>;
+		};
+		spmi: spmi@c400000 {
+			compatible = "qcom,spmi-pmic-arb";
+			reg = <0 0xc400000 0 0x3000>, <0 0xc500000 0 0x400000>,
+				     <0 0xc440000 0 0x80000>, <0 0xc4c0000 0 0x10000>,
+				     <0 0xc42d000 0 0x4000>;
+			reg-names = "core", "chnls", "obsrvr", "intr", "cnfg";
+			qcom,ee = <0>;
+			qcom,channel = <0>;
+			qcom,bus-id = <0>;
+			#address-cells = <2>;
+			#size-cells = <0>;
+			pmih010: pmic@7 {
+				compatible = "qcom,spmi-pmic";
+				reg = <7 0>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+				repeater: phy@fd00 {
+					compatible = "oneplus,dodge-eusb2-repeater";
+					reg = <0xfd00>;
+					#phy-cells = <0>;
+				};
+			};
+		};
+		hsphy: phy@88e3000 {
+			compatible = "qcom,sm8750-m31-eusb2-phy";
+			reg = <0 0x88e3000 0 0x29c>;
+			clocks = <&tcsrcc TCSR_USB2_CLKREF_EN>;
+			clock-names = "ref";
+			resets = <&gcc GCC_QUSB2PHY_PRIM_BCR>;
+			phys = <&repeater>;
+			#phy-cells = <0>;
+		};
+		usb@a600000 {
+			compatible = "qcom,sm8750-dwc3", "qcom,snps-dwc3";
+			reg = <0 0xa600000 0 0xfc100>;
+			clocks = <&gcc GCC_CFG_NOC_USB3_PRIM_AXI_CLK>,
+				        <&gcc GCC_USB30_PRIM_MASTER_CLK>,
+				        <&gcc GCC_AGGRE_USB3_PRIM_AXI_CLK>,
+				        <&gcc GCC_USB30_PRIM_SLEEP_CLK>,
+				        <&gcc GCC_USB30_PRIM_MOCK_UTMI_CLK>;
+			clock-names = "cfg_noc", "core", "iface", "sleep", "mock_utmi";
+			assigned-clocks = <&gcc GCC_USB30_PRIM_MOCK_UTMI_CLK>,
+				                 <&gcc GCC_USB30_PRIM_MASTER_CLK>;
+			assigned-clock-rates = <19200000>, <200000000>;
+			power-domains = <&gcc GCC_USB30_PRIM_GDSC>;
+			resets = <&gcc GCC_USB30_PRIM_BCR>;
+			phys = <&hsphy>;
+			phy-names = "usb2-phy";
+			dr_mode = "peripheral";
+			maximum-speed = "high-speed";
+			qcom,select-utmi-as-pipe-clk;
+			snps,dis_u2_susphy_quirk;
+			snps,dis_enblslpm_quirk;
+			snps,usb2-gadget-lpm-disable;
+		};
+	};
+};
