diff --git a/drivers/clk/qcom/clock-sm8750.c b/drivers/clk/qcom/clock-sm8750.c
new file mode 100644
index 00000000..56f83189
--- /dev/null
+++ b/drivers/clk/qcom/clock-sm8750.c
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/*
+ * Copyright (c) 2024, Qualcomm Innovation Center, Inc. All rights reserved.
+ * Minimal USB2 support adapted from Linux gcc-sm8750.c/tcsrcc-sm8750.c
+ * by Taniya Das; see the patch message for source revisions.
+ */
+#include <clk-uclass.h>
+#include <dm.h>
+#include <asm/io.h>
+#include <linux/delay.h>
+#include <dt-bindings/clock/qcom,sm8750-gcc.h>
+#include <dt-bindings/clock/qcom,sm8750-tcsr.h>
+#include "clock-qcom.h"
+
+static const struct freq_tbl usb_master_rates[] = {
+	F(66666667, CFG_CLK_SRC_GPLL0_EVEN, 4.5, 0, 0),
+	F(133333333, CFG_CLK_SRC_GPLL0, 4.5, 0, 0),
+	F(200000000, CFG_CLK_SRC_GPLL0, 3, 0, 0),
+	F(240000000, CFG_CLK_SRC_GPLL0, 2.5, 0, 0),
+	{}
+};
+static ulong sm8750_set_rate(struct clk *clk, ulong rate)
+{
+	struct msm_clk_priv *priv = dev_get_priv(clk->dev);
+	const struct freq_tbl *f;
+	switch (clk->id) {
+	case GCC_USB30_PRIM_MASTER_CLK:
+		f = qcom_find_freq(usb_master_rates, rate);
+		clk_rcg_set_rate_mnd(priv->base, 0x39030, f->pre_div, f->m,
+				     f->n, f->src, 8);
+		return f->freq;
+	case GCC_USB30_PRIM_MOCK_UTMI_CLK:
+		/* CXO is 19.2MHz after the SM8750 GCC input divide-by-two.
+   * Preserve the read-only postdivider; reject an unexpected divider.
+   */
+		if (rate != 19200000 || (readl(priv->base + 0x39060) & 0xf))
+			return -EINVAL;
+		clk_rcg_set_rate(priv->base, 0x39048, 1, CFG_CLK_SRC_CXO);
+		return rate;
+	default:
+		return -EINVAL;
+	}
+}
+static const struct gate_clk sm8750_clks[] = {
+	GATE_CLK_POLLED(GCC_CFG_NOC_USB3_PRIM_AXI_CLK, 0x3908c, BIT(0),
+			0x3908c),
+	GATE_CLK_POLLED(GCC_USB30_PRIM_MASTER_CLK, 0x39018, BIT(0), 0x39018),
+	GATE_CLK_POLLED(GCC_AGGRE_USB3_PRIM_AXI_CLK, 0x39090, BIT(0), 0x39090),
+	GATE_CLK_POLLED(GCC_USB30_PRIM_SLEEP_CLK, 0x39028, BIT(0), 0x39028),
+	GATE_CLK_POLLED(GCC_USB30_PRIM_MOCK_UTMI_CLK, 0x3902c, BIT(0), 0x3902c),
+};
+static int sm8750_enable(struct clk *clk)
+{
+	struct msm_clk_priv *priv = dev_get_priv(clk->dev);
+	return qcom_gate_clk_en(priv, clk->id);
+}
+static const struct qcom_reset_map sm8750_resets[] = {
+	[GCC_QUSB2PHY_PRIM_BCR] = { 0x12000 },
+	[GCC_USB30_PRIM_BCR] = { 0x39000 },
+};
+static const struct qcom_power_map sm8750_domains[] = {
+	[GCC_USB30_PRIM_GDSC] = { 0x39004 },
+};
+static struct msm_clk_data sm8750_data = {
+	.clks = sm8750_clks,
+	.num_clks = ARRAY_SIZE(sm8750_clks),
+	.resets = sm8750_resets,
+	.num_resets = ARRAY_SIZE(sm8750_resets),
+	.power_domains = sm8750_domains,
+	.num_power_domains = ARRAY_SIZE(sm8750_domains),
+	.enable = sm8750_enable,
+	.set_rate = sm8750_set_rate,
+};
+static const struct udevice_id sm8750_ids[] = {
+	{ .compatible = "qcom,sm8750-gcc", .data = (ulong)&sm8750_data },
+	{}
+};
+U_BOOT_DRIVER(gcc_sm8750) = {
+	.name = "gcc_sm8750",
+	.id = UCLASS_NOP,
+	.of_match = sm8750_ids,
+	.bind = qcom_cc_bind,
+	.flags = DM_FLAG_PRE_RELOC | DM_FLAG_DEFAULT_PD_CTRL_OFF,
+};
+static int tcsr_enable(struct clk *clk)
+{
+	fdt_addr_t base = dev_read_addr(clk->dev);
+	if (clk->id != TCSR_USB2_CLKREF_EN)
+		return -EINVAL;
+	setbits_le32(base + 0x2000, BIT(0));
+	udelay(10);
+	return 0;
+}
+static ulong tcsr_rate(struct clk *clk)
+{
+	return 38400000;
+}
+static struct clk_ops tcsr_ops = { .enable = tcsr_enable,
+				   .get_rate = tcsr_rate };
+static const struct udevice_id tcsr_ids[] = { { .compatible =
+							"qcom,sm8750-tcsr" },
+					      {} };
+U_BOOT_DRIVER(tcsr_sm8750) = {
+	.name = "tcsr_sm8750",
+	.id = UCLASS_CLK,
+	.of_match = tcsr_ids,
+	.ops = &tcsr_ops,
+};
