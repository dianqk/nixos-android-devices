# SPDX-License-Identifier: GPL-2.0+
# Requires the board to set boot_esp, boot_linux and menucmd.
# Read ABL's bootargs before EFI replaces the OS device tree's /chosen.
# Match a complete token, never cable presence or a substring of another mode.
detect_boot_mode=setenv charger_mode 0; setenv abl_bootargs; \
	fdt addr ${fdtcontroladdr}; \
	if fdt get value abl_bootargs /chosen bootargs; then \
		for bootarg in ${abl_bootargs}; do \
			if test "${bootarg}" = "androidboot.mode=charger"; then setenv charger_mode 1; fi; \
		done; \
	fi; \
	setenv bootarg; fdt addr ${fdt_addr_r}

boot_charger=for bootdev in 0 1 2 3 4 5 6 7; do if part number scsi ${bootdev} ${boot_esp} bootpart; then if fatload scsi ${bootdev}:${bootpart} ${kernel_addr_r} /EFI/android-devices/charger.efi; then setenv bootargs; bootefi ${kernel_addr_r}; fi; fi; done; echo Charging environment unavailable; poweroff; run menucmd
bootcmd=if test "${charger_mode}" = "1"; then run boot_charger; else run boot_linux; pause; run menucmd; fi
