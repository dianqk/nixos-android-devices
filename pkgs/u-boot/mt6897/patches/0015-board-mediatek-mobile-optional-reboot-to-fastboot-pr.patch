From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Wed, 14 Oct 2026 21:56:22 +0800
Subject: [PATCH 15/24] board: mediatek-mobile: optional reboot-to-fastboot
 probe per boot stage

MEDIATEK_MOBILE_PROBE_STAGE makes progress observable from the USB host
without UART, screen or reliable pstore: on reaching the configured stage
(1 entry, 2 LK FDT parsed, 3 DRAM window, 4 relocated, 5 misc_init_r
done) U-Boot sets the RGU reboot mode to bootloader (3) and resets, so the
stock LK comes up in fastboot instead of the device looping on a
watchdog timeout. Bring-up aid; disabled by default.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm/lib/save_prev_bl_data.c              | 11 ++++++++++
 arch/arm/mach-mediatek/Kconfig                | 10 +++++++++
 .../mediatek-mobile/mediatek-mobile.c         | 21 +++++++++++++++++++
 3 files changed, 42 insertions(+)

diff --git a/arch/arm/lib/save_prev_bl_data.c b/arch/arm/lib/save_prev_bl_data.c
index f411a36905a..55c01a6969f 100644
--- a/arch/arm/lib/save_prev_bl_data.c
+++ b/arch/arm/lib/save_prev_bl_data.c
@@ -43,6 +43,17 @@ static __always_inline void mediatek_mobile_entry_trace(void)
 	header[0] = 0x43474244; /* "DBGC", ramoops console without ECC */
 	header[1] = sizeof(marker) - 1;
 	header[2] = sizeof(marker) - 1;
+	if (CONFIG_MEDIATEK_MOBILE_PROBE_STAGE == 1 &&
+	    CONFIG_MEDIATEK_MOBILE_ENTRY_WDT_RESTART) {
+		/* RGU: reboot mode "bootloader" (3) at 0x24, then reset at 0x14. */
+		volatile u32 *rgu = (volatile u32 *)
+			(CONFIG_MEDIATEK_MOBILE_ENTRY_WDT_RESTART - 0x8);
+
+		rgu[0x24 / 4] = (rgu[0x24 / 4] & ~0xf) | 0x3;
+		rgu[0x14 / 4] = 0x1209;
+		for (;;)
+			;
+	}
 }
 #endif
 
diff --git a/arch/arm/mach-mediatek/Kconfig b/arch/arm/mach-mediatek/Kconfig
index 678c1a83be0..f2bf3bfb417 100644
--- a/arch/arm/mach-mediatek/Kconfig
+++ b/arch/arm/mach-mediatek/Kconfig
@@ -226,6 +226,16 @@ config MEDIATEK_MOBILE_ENTRY_WDT_RESTART
 	depends on MEDIATEK_MOBILE_ENTRY_TRACE
 	default 0x0
 
+config MEDIATEK_MOBILE_PROBE_STAGE
+	int "Reboot to the stock bootloader's fastboot at this boot stage"
+	depends on MEDIATEK_MOBILE_ENTRY_TRACE
+	default 0
+	help
+	  Bring-up probe without UART or screen: on reaching the stage (1 entry,
+	  2 LK FDT parsed, 3 DRAM window chosen, 4 relocated, 5 misc_init_r
+	  done), set the RGU reboot mode to bootloader and reset, so the host
+	  sees the stock fastboot instead of a watchdog loop. 0 disables it.
+
 config MEDIATEK_MOBILE_ENTRY_WDT_RESTART_KEY
 	hex "Value written to the watchdog restart register"
 	depends on MEDIATEK_MOBILE_ENTRY_TRACE
diff --git a/board/mediatek/mediatek-mobile/mediatek-mobile.c b/board/mediatek/mediatek-mobile/mediatek-mobile.c
index 2a7c4031dce..af0273b198f 100644
--- a/board/mediatek/mediatek-mobile/mediatek-mobile.c
+++ b/board/mediatek/mediatek-mobile/mediatek-mobile.c
@@ -275,6 +275,21 @@ static void __maybe_unused mtk_trace(const char *fmt, ...)
 	mtk_wdt_kick();
 }
 
+/* See MEDIATEK_MOBILE_PROBE_STAGE: prove progress by rebooting to fastboot. */
+static void mtk_probe(int stage)
+{
+	void *rgu = (void *)(CONFIG_MEDIATEK_MOBILE_ENTRY_WDT_RESTART - 0x8);
+
+	if (stage != CONFIG_MEDIATEK_MOBILE_PROBE_STAGE ||
+	    !CONFIG_MEDIATEK_MOBILE_ENTRY_WDT_RESTART)
+		return;
+	mtk_trace("U-Boot: probe stage %d reached, rebooting to bootloader\n", stage);
+	clrsetbits_le32(rgu + 0x24, 0xf, 0x3);
+	writel(0x1209, rgu + 0x14);
+	for (;;)
+		;
+}
+
 static void mtk_pstore_putc(struct stdio_dev *dev, const char c)
 {
 	mtk_pstore_write(&c, 1);
@@ -311,6 +326,7 @@ static void mtk_pstore_console(void)
 #else
 static inline void mtk_trace(const char *fmt, ...) {}
 static inline void mtk_pstore_console(void) {}
+static inline void mtk_probe(int stage) {}
 #endif
 
 /* Keep our own control DT; LK's Android FDT only supplies runtime facts. */
@@ -330,6 +346,7 @@ int board_fdt_blob_setup(void **fdtp)
 		  mtk_reserved_count, mtk_initrd_start, mtk_initrd_end,
 		  mtk_fb_start, mtk_fb_size);
 
+	mtk_probe(2);
 	if (internal)
 		return -EEXIST;
 
@@ -481,6 +498,7 @@ int dram_init(void)
 	mtk_build_mem_map();
 	mtk_trace("U-Boot: relocation window 0x%llx+0x%llx\n",
 		  (u64)gd->ram_base, (u64)gd->ram_size);
+	mtk_probe(3);
 	return 0;
 }
 
@@ -499,6 +517,7 @@ int dram_init_banksize(void)
 int board_init(void)
 {
 	mtk_trace("U-Boot: relocated, board_init\n");
+	mtk_probe(4);
 	return 0;
 }
 
@@ -678,6 +697,8 @@ int misc_init_r(void)
 	    !mtk_alloc_low(CONFIG_FASTBOOT_BUF_SIZE, SZ_2M, &fastboot))
 		env_set_hex("fastboot_addr_r", fastboot);
 
+	mtk_trace("U-Boot: misc_init_r done\n");
+	mtk_probe(5);
 	return 0;
 }
 
