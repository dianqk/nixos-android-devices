+{
+	if (mtk_select_window())
+		panic("No usable DRAM window for U-Boot\n");
+
+	mtk_build_mem_map();
+	return 0;
+}
+
+int dram_init_banksize(void)
+{
+	int i;
+
+	for (i = 0; i < CONFIG_NR_DRAM_BANKS; i++) {
+		gd->dram[i].start = i < mtk_bank_count ? mtk_banks[i].start : 0;
+		gd->dram[i].size = i < mtk_bank_count ? mtk_banks[i].size : 0;
+	}
+
+	return 0;
+}
+
+int board_init(void)
+{
+	return 0;
+}
+
+/* Point the simplefb node at LK's framebuffer, or leave it disabled. */
+int board_fix_fdt(void *fdt)
+{
+	const fdt32_t *cell;
+	fdt64_t reg[2];
+	u32 stride, height;
+	int node, parent;
+
+	node = fdt_node_offset_by_compatible(fdt, -1, "simple-framebuffer");
+	if (node < 0 || !mtk_fb_size)
+		return 0;
+
+	parent = fdt_parent_offset(fdt, node);
+	if (fdt_address_cells(fdt, parent) != 2 || fdt_size_cells(fdt, parent) != 2)
+		return 0;
+
+	cell = fdt_getprop(fdt, node, "stride", NULL);
+	stride = cell ? fdt32_to_cpu(*cell) : 0;
+	cell = fdt_getprop(fdt, node, "height", NULL);
+	height = cell ? fdt32_to_cpu(*cell) : 0;
+	if (!stride || !height || (u64)stride * height > mtk_fb_size) {
+		log_warning("LK framebuffer (0x%llx bytes) does not hold the simplefb geometry\n",
+			    mtk_fb_size);
+		return 0;
+	}
+
+	reg[0] = cpu_to_fdt64(mtk_fb_start);
+	reg[1] = cpu_to_fdt64((u64)stride * height);
+	if (fdt_setprop_inplace(fdt, node, "reg", reg, sizeof(reg)))
+		return 0;
+
+	return fdt_setprop_string(fdt, node, "status", "okay");
+}
+
+static void mtk_reserve(u64 start, u64 size, u32 flags)
+{
+	phys_addr_t addr = start;
+
+	if (size)
+		lmb_alloc_mem(LMB_MEM_ALLOC_ADDR, 0, &addr, size, flags);
+}
+
+static int mtk_alloc_low(phys_size_t size, u64 align, phys_addr_t *addr)
+{
+	*addr = MTK_DMA_LIMIT - 1;
+	return lmb_alloc_mem(LMB_MEM_ALLOC_MAX, align, addr, size, LMB_NONE);
+}
+
+static void mtk_env_buffer(const char *name, phys_size_t size)
+{
+	phys_addr_t addr;
+
+	if (mtk_alloc_low(size, SZ_2M, &addr)) {
+		log_err("Cannot allocate %s\n", name);
+		return;
+	}
+	env_set_hex(name, addr);
+}
+
+static void mtk_set_serial(void)
+{
+	const void *fdt = (const void *)(uintptr_t)mtk_lk_fdt;
+	const char *bootargs = NULL, *value, *end;
+	char serial[65];
+	int node;
+
+	node = fdt_path_offset(fdt, "/chosen");
+	if (node >= 0)
+		bootargs = fdt_getprop(fdt, node, "bootargs", NULL);
+	if (!bootargs)
+		return;
+
+	for (value = bootargs; (value = strstr(value, "androidboot.serialno=")); value++) {
+		if (value != bootargs && value[-1] != ' ')
+			continue;
+		value += strlen("androidboot.serialno=");
+		end = strchrnul(value, ' ');
+		if (end == value || end - value >= sizeof(serial))
+			return;
+		memcpy(serial, value, end - value);
+		serial[end - value] = '\0';
+		env_set("serial#", serial);
+		return;
+	}
+}
+
+static bool mtk_fdt_header_fits(const u8 *p, u64 avail)
+{
+	u32 total, structure, strings, version;
+
+	if (avail < sizeof(struct fdt_header) ||
+	    get_unaligned_be32(p) != FDT_MAGIC)
+		return false;
+	total = get_unaligned_be32(p + 4);
+	structure = get_unaligned_be32(p + 8);
+	strings = get_unaligned_be32(p + 12);
+	version = get_unaligned_be32(p + 20);
+
+	return total >= sizeof(struct fdt_header) && total <= avail &&
+	       version >= 16 && structure < total && strings < total;
+}
+
+/*
+ * A boot image may carry a FIT payload (kernel, initrd and DTB) as its
+ * ramdisk. LK may concatenate other ramdisks before it, so search the whole
+ * initrd window it reports, copy the FIT to an aligned buffer and verify it.
+ */
+static void mtk_find_payload(void)
+{
+	const u8 *base, *p, *end;
+	phys_addr_t addr;
+	u32 total;
+
+	if (!mtk_initrd_start)
+		return;
+
+	base = map_sysmem(mtk_initrd_start, mtk_initrd_end - mtk_initrd_start);
+	end = base + (mtk_initrd_end - mtk_initrd_start);
+	for (p = base; p < end; p++) {
+		void *copy;
+
+		p = memchr(p, 0xd0, end - p);
+		if (!p)
+			break;
+		if (!mtk_fdt_header_fits(p, end - p))
+			continue;
+
+		total = get_unaligned_be32(p + 4);
+		if (mtk_alloc_low(total, SZ_4K, &addr))
+			break;
+		copy = map_sysmem(addr, total);
+		memcpy(copy, p, total);
+		if (!fdt_check_header(copy) &&
+		    fdt_getprop(copy, 0, MTK_PAYLOAD_PROP, NULL) &&
+		    !fit_check_format(copy, total)) {
+			log_info("Boot payload: FIT at initrd offset 0x%lx, %u bytes, copied to 0x%llx\n",
+				 (ulong)(p - base), total, (u64)addr);
+			env_set_hex("payload_addr", addr);
+			unmap_sysmem(copy);
+			break;
+		}
+		unmap_sysmem(copy);
+		lmb_free(addr, total, LMB_NONE);
+	}
+	unmap_sysmem(base);
+}
+
 int misc_init_r(void)
 {
-	return mediatek_fastboot_setup();
+	phys_addr_t fastboot;
+	int i;
+
+	for (i = 0; i < mtk_reserved_count; i++)
+		mtk_reserve(mtk_reserved[i].start, mtk_reserved[i].size,
+			    mtk_reserved[i].nomap ? LMB_NOMAP : LMB_NOOVERWRITE);
+	/* ft_board_setup() reads LK's FDT again; keep it and the initrd intact. */
+	mtk_reserve(mtk_lk_fdt, mtk_lk_fdt_size, LMB_NOOVERWRITE);
+	mtk_reserve(mtk_initrd_start, mtk_initrd_end - mtk_initrd_start,
+		    LMB_NOOVERWRITE);
+
+	mtk_set_serial();
+	mtk_find_payload();
+
+	mtk_env_buffer("kernel_addr_r", SZ_128M);
+	mtk_env_buffer("ramdisk_addr_r", SZ_256M);
+	mtk_env_buffer("fdt_addr_r", SZ_2M);
+	mtk_env_buffer("kernel_comp_addr_r", SZ_128M);
+	env_set_hex("kernel_comp_size", SZ_128M);
+	env_set("loadaddr", env_get("kernel_addr_r"));
+	if (CONFIG_IS_ENABLED(USB_FUNCTION_FASTBOOT) &&
+	    !mtk_alloc_low(CONFIG_FASTBOOT_BUF_SIZE, SZ_2M, &fastboot))
+		env_set_hex("fastboot_addr_r", fastboot);
+
+	return 0;
+}
+
+/* Forward LK's fixed reservations to the operating system's FDT. */
+int ft_board_setup(void *blob, struct bd_info *bd)
+{
+	int parent, node, i, ret;
+	char name[40];
+
+	parent = fdt_path_offset(blob, "/reserved-memory");
+	if (parent < 0) {
+		parent = fdt_add_subnode(blob, 0, "reserved-memory");
+		if (parent < 0)
+			return parent;
+		ret = fdt_setprop_u32(blob, parent, "#address-cells", 2);
+		ret = ret ?: fdt_setprop_u32(blob, parent, "#size-cells", 2);
+		ret = ret ?: fdt_setprop_empty(blob, parent, "ranges");
+		if (ret)
+			return ret;
+	} else if (fdt_address_cells(blob, parent) != 2 ||
+		   fdt_size_cells(blob, parent) != 2) {
+		log_err("OS /reserved-memory must use two address and size cells\n");
+		return -EINVAL;
+	}
+
+	for (i = 0; i < mtk_reserved_count; i++) {
+		const struct mtk_region *r = &mtk_reserved[i];
+		fdt64_t reg[2] = { cpu_to_fdt64(r->start), cpu_to_fdt64(r->size) };
+
+		snprintf(name, sizeof(name), "lk-reserved@%llx", r->start);
+		node = fdt_add_subnode(blob, parent, name);
+		if (node == -FDT_ERR_EXISTS)
+			continue;
+		if (node < 0)
+			return node;
+		ret = fdt_setprop(blob, node, "reg", reg, sizeof(reg));
+		if (!ret && r->nomap)
+			ret = fdt_setprop_empty(blob, node, "no-map");
+		if (ret)
+			return ret;
+	}
+
+	return 0;
 }
