+/*
+ * The largest DRAM window below 4 GiB that avoids every LK reservation, the
+ * LK FDT, the initrd LK loaded and this image. U-Boot relocates to its top.
+ */
+static int mtk_select_window(void)
+{
+	struct mtk_region avoid[MTK_MAX_RESERVED + 3];
+	u64 best_start = 0, best_size = 0;
+	u64 image = (uintptr_t)__image_copy_start;
+	u64 image_end = (uintptr_t)_end + fdt_totalsize(gd->fdt_blob);
+	int count = 0, b, i;
 
-		// works printk("Partition: %s\n", info.name);
+	for (i = 0; i < mtk_reserved_count; i++)
+		avoid[count++] = mtk_reserved[i];
+	avoid[count++] = (struct mtk_region){ mtk_lk_fdt, mtk_lk_fdt_size };
+	avoid[count++] = (struct mtk_region){ image, image_end - image };
+	if (mtk_initrd_start)
+		avoid[count++] = (struct mtk_region){
+			mtk_initrd_start, mtk_initrd_end - mtk_initrd_start };
+	mtk_sort(avoid, count);
+
+	for (b = 0; b < mtk_bank_count; b++) {
+		u64 cursor = mtk_banks[b].start;
+		u64 end = min_t(u64, mtk_banks[b].start + mtk_banks[b].size,
+				MTK_DMA_LIMIT);
+
+		for (i = 0; i <= count && cursor < end; i++) {
+			u64 start = ALIGN(cursor, SZ_4K);
+			u64 limit = i < count ? max(avoid[i].start, cursor) : end;
+
+			limit = ALIGN_DOWN(min(limit, end), SZ_4K);
+			if (limit > start && limit - start > best_size) {
+				best_start = start;
+				best_size = limit - start;
+			}
+			if (i < count)
+				cursor = max(cursor, avoid[i].start + avoid[i].size);
+		}
 	}
 
+	if (best_size < SZ_64M)
+		return -ENOMEM;
+
+	gd->ram_base = best_start;
+	gd->ram_size = best_size;
 	return 0;
 }
 
+static void mtk_map(int *index, u64 start, u64 end, u64 attrs)
+{
+	start = ALIGN(start, SZ_4K);
+	end = ALIGN_DOWN(end, SZ_4K);
+	if (end <= start || *index >= ARRAY_SIZE(mtk_mem_map) - 1)
+		return;
+	mtk_mem_map[*index].phys = start;
+	mtk_mem_map[*index].virt = start;
+	mtk_mem_map[*index].size = end - start;
+	mtk_mem_map[*index].attrs = attrs;
+	(*index)++;
+}
+
+/*
+ * Map DRAM except the no-map reservations, so that speculative accesses never
+ * reach secure carve-outs. The LK framebuffer stays mapped for simplefb.
+ */
+static void mtk_build_mem_map(void)
+{
+	const u64 normal = PTE_BLOCK_MEMTYPE(MT_NORMAL) | PTE_BLOCK_INNER_SHARE;
+	const u64 framebuffer = PTE_BLOCK_MEMTYPE(MT_NORMAL_NC) |
+				PTE_BLOCK_INNER_SHARE | PTE_BLOCK_PXN |
+				PTE_BLOCK_UXN;
+	int index = 0, b, i;
+
+	mtk_map(&index, SZ_4K, mtk_banks[0].start,
+		PTE_BLOCK_MEMTYPE(MT_DEVICE_NGNRNE) | PTE_BLOCK_NON_SHARE |
+		PTE_BLOCK_PXN | PTE_BLOCK_UXN);
+
+	for (b = 0; b < mtk_bank_count; b++) {
+		u64 cursor = mtk_banks[b].start;
+		u64 end = mtk_banks[b].start + mtk_banks[b].size;
+
+		for (i = 0; i < mtk_reserved_count && cursor < end; i++) {
+			const struct mtk_region *r = &mtk_reserved[i];
+			u64 hole = ALIGN_DOWN(r->start, SZ_4K);
+			u64 hole_end = ALIGN(r->start + r->size, SZ_4K);
+
+			if (!r->nomap || hole_end <= cursor || hole >= end)
+				continue;
+			mtk_map(&index, cursor, min(hole, end), normal);
+			if (mtk_fb_size &&
+			    mtk_overlaps(hole, hole_end - hole, mtk_fb_start, mtk_fb_size))
+				mtk_map(&index, max(hole, mtk_fb_start),
+					min(hole_end, mtk_fb_start + mtk_fb_size),
+					framebuffer);
+			cursor = max(cursor, hole_end);
+		}
+		mtk_map(&index, cursor, end, normal);
+	}
+	/* Zero size and attributes terminate the map. */
+}
