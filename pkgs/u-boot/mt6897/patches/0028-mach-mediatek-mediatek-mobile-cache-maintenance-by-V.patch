From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Thu, 15 Oct 2026 10:24:56 +0800
Subject: [PATCH 28/29] mach-mediatek: mediatek-mobile: cache maintenance by VA
 only

LK enters U-Boot at EL1 as a guest of the GenieZone hypervisor, where
set/way cache maintenance does not reach the data: with it, the kernel
that bootm prepared was not in memory when the MMU went off. Select
CMO_BY_VA_ONLY (see the next commit for the flushed range).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm/mach-mediatek/Kconfig | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/arch/arm/mach-mediatek/Kconfig b/arch/arm/mach-mediatek/Kconfig
index e6fd1394763..3ad961ec388 100644
--- a/arch/arm/mach-mediatek/Kconfig
+++ b/arch/arm/mach-mediatek/Kconfig
@@ -193,6 +193,9 @@ config TARGET_MEDIATEK_MOBILE
 	select OF_BOARD_FIXUP
 	select OF_BOARD_SETUP
 	select ARMV8_CNTFRQ_BROKEN
+	# LK enters at EL1 under the GenieZone hypervisor; set/way cache
+	# maintenance is not available to the guest.
+	select CMO_BY_VA_ONLY
 	select LMB_ARCH_MEM_MAP
 	select POSITION_INDEPENDENT
 	select SAVE_PREV_BL_FDT_ADDR
-- 
2.55.0

