# SPDX-License-Identifier: GPL-2.0+
# No persistent environment and no storage writes (misc is only read).
# Without an ESP or when recovery is requested, wait in USB fastboot
# (fastboot boot <FIT>, fastboot oem console/run);
# the USB ACM console is in the menu.
boot_esp=linux-boot
misc_part=misc
stdin=serial,button-kbd
stdout=vidconsole,serial
stderr=vidconsole,serial
bootdelay=0
bootretry=-1
# Bring-up: if no USB host addresses the device within this many seconds,
# stop servicing the watchdog; LK counts that reset as a failed boot and
# falls back to the stock slot. A host connection or setenv autoreset_s
# (empty) keeps U-Boot running.
autoreset_s=90
serial_gadget=setenv stdin serial,button-kbd,usbacm; setenv stdout vidconsole,serial,usbacm,pstore; setenv stderr vidconsole,serial,usbacm,pstore
# Fastboot needs the USB controller: release the ACM console first and
# restore it when fastboot ends (host: fastboot continue).
console_local=setenv stdin serial,button-kbd; setenv stdout vidconsole,serial,pstore; setenv stderr vidconsole,serial,pstore
fastboot=run console_local; echo "Fastboot on USB (fastboot boot <image.itb>; fastboot continue returns)"; if fastboot -l ${fastboot_addr_r} usb 0; then run serial_gadget; echo "Fastboot ended"; else run usb_failed; fi
# fastboot boot: a raw FIT, or the FIT that host fastboot wrapped as the
# kernel of an Android v0-v2 image (kernel at +page_size). A failed boot
# returns to the console instead of resetting.
fastboot_bootcmd=setexpr fbimg ${fastboot_addr_r}; if itest.l *${fbimg} == 0x52444e41; then setexpr fbps ${fbimg} + 0x24; setexpr.l fbpage *${fbps}; setexpr fbimg ${fbimg} + ${fbpage}; fi; if itest.l *${fbimg} == 0xedfe0dd0; then bootm ${fbimg}; else bootm ${fastboot_addr_r}; fi; echo "fastboot boot: image did not boot"
# Without USB nobody can reach this U-Boot: the autoreset watchdog reset
# then lets the stock LK fall back to the other slot.
usb_failed=echo "USB fastboot unavailable"
banner=echo "== Alldocube T880 U-Boot =="; echo "${ver}"
ufs_probe=echo "UFS: scanning"; if scsi scan; then echo "UFS: scan done"; else echo "UFS: FAILED (USB still available)"; fi
usb_probe=echo "USB: starting ACM console"; run serial_gadget; echo "USB: ACM console requested (usbacm)"
# LK leaves the backlight at full duty (CON1 0x03ff03ff, period 0x3ff).
# Manual mode without double buffering (BLS debug 0x80), then a modest duty
# out of 1023: bright enough to read, much less heat.
backlight_level=0x100
backlight=mw.l 0x1100e080 3; setexpr.l bl ${backlight_level} * 0x10000; setexpr.l bl ${bl} + 0x3ff; mw.l 0x1100e01c ${bl}
preboot=run backlight; run banner; run ufs_probe
# Boot an embedded RAM recovery payload first. Requested recovery goes to
# USB fastboot; otherwise try the ESP, then fall back to USB fastboot.
boot_payload=if test -n "${payload_addr}"; then echo "Boot: RAM recovery payload at ${payload_addr}"; bootm ${payload_addr}; else echo "Boot: no RAM recovery payload"; fi
boot_linux=for bootdev in 0 1 2 3 4 5 6 7; do if part number scsi ${bootdev} ${boot_esp} bootpart; then if fatload scsi ${bootdev}:${bootpart} ${kernel_addr_r} /EFI/BOOT/BOOTAA64.EFI; then bootefi ${kernel_addr_r}; fi; fi; done; echo "Boot: no ${boot_esp} partition with /EFI/BOOT/BOOTAA64.EFI"
boot_requested=if recoveryrequest ${misc_part}; then run fastboot; fi
default_boot=run boot_payload; run boot_requested; run boot_linux; run fastboot
bootcmd=run default_boot
# The menu times out to the default flow if the keys misread.
menucmd=bootmenu 10
bootmenu_0=Default boot (payload, ESP, fastboot)=run default_boot
bootmenu_1=Fastboot (USB)=run fastboot
bootmenu_2=USB ACM console=run usb_probe
bootmenu_3=Drop to shell=echo "Shell"
bootmenu_4=Stock bootloader fastboot (LK)=rebootmode bootloader
bootmenu_5=Reset device=reset
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
