From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Wed, 14 Oct 2026 15:46:01 +0800
Subject: [PATCH] arm: dts: mt6897: add the Alldocube iPlay 80 mini Ultra
 (T880)

Minimal control DT for the T880 chainloaded from LK: UFS, the USB 2.0
gadget path, the keypad volume-down key and a disabled simple-framebuffer
whose base comes from LK at runtime. All board values are placeholders
from the MT6897 Lenovo TB373FU/TB375FC trees until the T880's own FDT is
available.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm/dts/mt6897-alldocube-t880.dts | 70 ++++++++++++++++++++++++++
 1 file changed, 70 insertions(+)
 create mode 100644 arch/arm/dts/mt6897-alldocube-t880.dts

diff --git a/arch/arm/dts/mt6897-alldocube-t880.dts b/arch/arm/dts/mt6897-alldocube-t880.dts
new file mode 100644
index 0000000000..5177b64be8
--- /dev/null
+++ b/arch/arm/dts/mt6897-alldocube-t880.dts
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause
+/*
+ * Alldocube iPlay 80 mini Ultra (T880, MediaTek MT8883 / MT6897 class)
+ *
+ * PLACEHOLDER VALUES: nothing below has been read from a T880 yet. SoC
+ * addresses come from the MT6897 Lenovo TB373FU/TB375FC device trees;
+ * the keypad and framebuffer geometry are assumptions. Replace them with
+ * the T880's own FDT (/sys/firmware/fdt) before flashing.
+ *
+ * Memory, reserved memory, the initrd and the framebuffer base are taken
+ * at runtime from the FDT that LK passes to U-Boot.
+ */
+
+/dts-v1/;
+#include "mt6897.dtsi"
+#include <dt-bindings/input/input.h>
+
+/ {
+	model = "Alldocube iPlay 80 mini Ultra (T880)";
+	compatible = "alldocube,t880", "mediatek,mt6897";
+	chassis-type = "tablet";
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/*
+		 * PLACEHOLDER: portrait 1600x2560 a8r8g8b8 is assumed for the
+		 * 2560x1600 panel. board_fix_fdt() fills reg from LK's videolfb
+		 * tags and enables the node only if LK's VRAM holds this size.
+		 */
+		framebuffer: framebuffer@0 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0x0 0x0 0x0>;
+			width = <1600>;
+			height = <2560>;
+			stride = <(1600 * 4)>;
+			format = "a8r8g8b8";
+			status = "disabled";
+		};
+	};
+
+	/* PLACEHOLDER (TB373FU): volume down on the keypad controller. */
+	kp_keys: kp-keys {
+		compatible = "mediatek,kp-raw";
+
+		voldown-key {
+			label = "Volume Down";
+			linux,code = <KEY_VOLUMEDOWN>;
+		};
+	};
+};
+
+&ufshci {
+	compatible = "mediatek,mt6897-ufshci";
+	status = "okay";
+};
+
+&ufsphy {
+	status = "okay";
+};
+
+&usbphy {
+	status = "okay";
+};
+
+&u2port {
+	status = "okay";
+};
