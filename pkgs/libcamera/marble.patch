Subject: [PATCH] libcamera: add Xiaomi Redmi Note 12 Turbo camera sensor helpers

Sony IMX355 (ultra-wide): 1.12 um pixels, Sony analogue gain 1024 /
(1024 - code), SMIA test patterns. Samsung S5K3P9 (front): 1.0 um
pixels, analogue gain code / 32, SMIA test patterns. OmniVision OV64B40
(wide): 0.7 um pixels, analogue gain code / 256, the OV64A40 colour bar
patterns. GalaxyCore GC02M1 (macro): 1.75 um pixels, total gain code /
1024, no test pattern. Black level 64 (10-bit) and two-frame control
delays for all four.

---
diff --git a/src/ipa/libipa/camera_sensor_helper.cpp b/src/ipa/libipa/camera_sensor_helper.cpp
index e765ad5..65489a8 100644
--- a/src/ipa/libipa/camera_sensor_helper.cpp
+++ b/src/ipa/libipa/camera_sensor_helper.cpp
@@ -710,6 +710,50 @@ public:
 };
 REGISTER_CAMERA_SENSOR_HELPER("ov32b40", CameraSensorHelperOv32b40)
 
+class CameraSensorHelperImx355 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperImx355()
+	{
+		blackLevel_ = 4096;
+		gain_ = AnalogueGainLinear{ 0, 1024, -1, 1024 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("imx355", CameraSensorHelperImx355)
+
+class CameraSensorHelperS5k3p9 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperS5k3p9()
+	{
+		blackLevel_ = 4096;
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 32 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("s5k3p9", CameraSensorHelperS5k3p9)
+
+class CameraSensorHelperOv64b40 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperOv64b40()
+	{
+		blackLevel_ = 4096;
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 256 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("ov64b40", CameraSensorHelperOv64b40)
+
+class CameraSensorHelperGc02m1 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperGc02m1()
+	{
+		blackLevel_ = 4096;
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 1024 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("gc02m1", CameraSensorHelperGc02m1)
+
