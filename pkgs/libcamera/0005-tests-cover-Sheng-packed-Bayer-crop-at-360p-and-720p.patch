From: dianqk <dianqk@dianqk.net>
Date: Sat, 31 Oct 2026 20:06:53 +0800
Subject: [PATCH 5/5] tests: cover Sheng packed Bayer crop at 360p and 720p

---
 test/debayer-geometry.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/test/debayer-geometry.cpp b/test/debayer-geometry.cpp
index cfc757f..7114eb4 100644
--- a/test/debayer-geometry.cpp
+++ b/test/debayer-geometry.cpp
@@ -43,6 +43,11 @@ private:
 			{ { 1928, 1092 }, { 1920, 1092 }, { 640, 480 }, { 236, 0, 1456, 1092 } },
 			{ { 1928, 1092 }, { 1920, 1092 }, { 512, 768 }, { 600, 0, 728, 1092 } },
 			{ { 1928, 1092 }, { 1920, 1092 }, { 1280, 640 }, { 4, 66, 1920, 960 } },
+			/* Sheng BGGR10P: keep the same sensor crop at 360p and 720p. */
+			{ { 3264, 1836 }, { 3256, 1836 }, { 640, 360 }, { 4, 3, 3256, 1831 } },
+			{ { 3264, 1836 }, { 3256, 1836 }, { 1280, 720 }, { 4, 3, 3256, 1831 } },
+			/* A 4:3 output is centered rather than anchored at the left. */
+			{ { 3264, 1836 }, { 3256, 1836 }, { 640, 480 }, { 408, 0, 2448, 1836 } },
 			/* A smaller Bayer border leaves an odd top coordinate. */
 			{ { 1928, 1092 }, { 1924, 1092 }, { 1280, 720 }, { 2, 5, 1924, 1082 } },
 		};
