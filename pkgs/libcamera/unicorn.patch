Subject: [PATCH] libcamera: match the Unicorn sensor gain controls

Unicorn's S5KJN1 and OV32B40 drivers use gain units of 1/32 and 1/256.
IMX707 uses Sony's 1024 / (1024 - code) law. Keep their model names distinct
from other boards with different register modes and control scaling.

diff --git a/src/ipa/libipa/camera_sensor_helper.cpp b/src/ipa/libipa/camera_sensor_helper.cpp
--- a/src/ipa/libipa/camera_sensor_helper.cpp
+++ b/src/ipa/libipa/camera_sensor_helper.cpp
@@ -841,6 +841,31 @@
 };
 REGISTER_CAMERA_SENSOR_HELPER("s5kjn1", CameraSensorHelperS5kjn1)
 
+class CameraSensorHelperImx707Unicorn : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperImx707Unicorn()
+	{
+		gain_ = AnalogueGainLinear{ 0, 1024, -1, 1024 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("imx707-unicorn", CameraSensorHelperImx707Unicorn)
+
+class CameraSensorHelperS5kjn1Unicorn : public CameraSensorHelperS5kjn1
+{
+};
+REGISTER_CAMERA_SENSOR_HELPER("s5kjn1-unicorn", CameraSensorHelperS5kjn1Unicorn)
+
+class CameraSensorHelperOv32b40Unicorn : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperOv32b40Unicorn()
+	{
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 256 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("ov32b40-unicorn", CameraSensorHelperOv32b40Unicorn)
+
 class CameraSensorHelperVd55g1 : public CameraSensorHelper
 {
 public:
