Subject: [PATCH] libcamera: add TB320FC sensor gain and static properties

Black levels and pixel sizes follow the device sensor modules; gain
formulas match the HI1339, S5K4H7 and SC202CS V4L2 controls.

---
diff --git a/src/ipa/libipa/camera_sensor_helper.cpp b/src/ipa/libipa/camera_sensor_helper.cpp
--- a/src/ipa/libipa/camera_sensor_helper.cpp
+++ b/src/ipa/libipa/camera_sensor_helper.cpp
@@ -665,6 +665,39 @@
 };
 REGISTER_CAMERA_SENSOR_HELPER("imx708", CameraSensorHelperImx708)
 
+class CameraSensorHelperHi1339 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperHi1339()
+	{
+		blackLevel_ = 4096;
+		gain_ = AnalogueGainLinear{ 1, 16, 0, 16 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("hi1339", CameraSensorHelperHi1339)
+
+class CameraSensorHelperS5k4h7 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperS5k4h7()
+	{
+		blackLevel_ = 4096;
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 32 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("s5k4h7", CameraSensorHelperS5k4h7)
+
+class CameraSensorHelperSc202cs : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperSc202cs()
+	{
+		blackLevel_ = 4160;
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 1024 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("sc202cs", CameraSensorHelperSc202cs)
+
 class CameraSensorHelperOv01a10 : public CameraSensorHelper
 {
 public:
