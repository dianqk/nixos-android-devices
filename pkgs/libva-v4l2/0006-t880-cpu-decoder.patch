+// Keep replay framing separate from ordinary serialization. The cached raw
+// sequence payload must be framed after the temporal delimiter on later keys.
+std::vector<uint8_t> replay_anchor(const std::vector<uint8_t> &out, size_t td_end,
+                                  const std::vector<uint8_t> &sequence, unsigned type,
+                                  bool show, bool new_sequence) {
+    if (type != key_frame || !(show || new_sequence)) return {};
+    if (new_sequence) return out;
+    check(td_end <= out.size() && !sequence.empty(), "AV1 replay sequence missing", invalid);
+    std::vector<uint8_t> anchor(out.begin(), out.begin() + td_end);
+    obu(anchor, 1, sequence);
+    anchor.insert(anchor.end(), out.begin() + td_end, out.end());
+    return anchor;
+}
