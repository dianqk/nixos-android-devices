+// SPDX-License-Identifier: MIT
+#include "t880-decoder.hpp"
+#include <linux/dma-buf.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <poll.h>
+#include <cerrno>
+#include <limits>
+
+namespace irisva {
+namespace {
+struct CpuWrite {
+    int fd; bool active = false;
+    explicit CpuWrite(Memory &m) : fd(m.fd) {
+        wait_surface_access(m, POLLOUT);
+        dma_buf_sync sync{DMA_BUF_SYNC_START | DMA_BUF_SYNC_WRITE};
+        checked_begin(sync); active = true;
+    }
+    void checked_begin(dma_buf_sync &sync) {
+        int r; do { r = ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync); } while (r < 0 && errno == EINTR);
+        check(r == 0, "T880 CPU write cache access");
+    }
+    void finish() {
+        dma_buf_sync sync{DMA_BUF_SYNC_END | DMA_BUF_SYNC_WRITE};
+        checked_begin(sync); active = false;
+    }
+    ~CpuWrite() {
+        if (active) { dma_buf_sync sync{DMA_BUF_SYNC_END | DMA_BUF_SYNC_WRITE};
+            while (ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync) < 0 && errno == EINTR) {} }
+    }
+};
+constexpr unsigned OUT = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+constexpr unsigned CAP = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+constexpr size_t AU_LIMIT = 4u * 1024 * 1024;
+constexpr size_t HISTORY_LIMIT = 64u * 1024 * 1024;
+constexpr size_t COUNT_LIMIT = 4096;
+int call(int fd, unsigned long request, void *arg) {
+    int r;
+    do { r = ioctl(fd, request, arg); } while (r < 0 && errno == EINTR);
+    return r;
+}
+void checked(int fd, unsigned long request, void *arg, const char *what) {
+    check(call(fd, request, arg) == 0, (std::string(what) + ": " + strerror(errno)).c_str());
+}
+struct T880Buffer {
+    v4l2_plane planes[VIDEO_MAX_PLANES]{};
+    v4l2_buffer value{};
+    T880Buffer(unsigned type, unsigned index = 0) {
+        value.type = type; value.index = index; value.memory = V4L2_MEMORY_MMAP;
+        value.length = VIDEO_MAX_PLANES; value.m.planes = planes;
+    }
+};
+uint64_t token(const timeval &t) {
+    check(t.tv_sec >= 0 && t.tv_usec >= 0 && t.tv_usec < 1000000 &&
+          uint64_t(t.tv_sec) <= (UINT64_MAX - uint64_t(t.tv_usec)) / 1000000,
+          "invalid T880 timestamp");
+    return uint64_t(t.tv_sec) * 1000000 + t.tv_usec;
+}
+}
+T880Decoder::Plane::Plane(Plane &&p) noexcept : address(p.address), size(p.size) {
+    p.address = nullptr; p.size = 0;
+}
+T880Decoder::Plane::~Plane() { if (address) munmap(address, size); }
+T880Decoder::T880Decoder(const std::string &device, unsigned width, unsigned height,
+                         VAProfile profile, unsigned rt_format, int render_fd)
+    : render_fd_(render_fd), width_(width), height_(height) {
+    check(rt_format == VA_RT_FORMAT_YUV420 && width >= 128 && height >= 128 && !(width & 1) &&
+          !(height & 1) && width <= 4096 && height <= 2176 &&
+          uint64_t(width) * height <= uint64_t(4096) * 2176,
+          "T880 requires bounded even 8-bit geometry", VA_STATUS_ERROR_UNSUPPORTED_RT_FORMAT);
+    check(profile == VAProfileH264ConstrainedBaseline || profile == VAProfileH264Main ||
+          profile == VAProfileH264High || profile == VAProfileHEVCMain ||
+          profile == VAProfileVP9Profile0 || profile == VAProfileAV1Profile0,
+          "T880 profile not enabled", VA_STATUS_ERROR_UNSUPPORTED_PROFILE);
+    fd_ = open(device.c_str(), O_RDWR | O_NONBLOCK | O_CLOEXEC);
+    check(fd_ >= 0, "open T880 decoder");
+    try {
+        v4l2_capability caps{};
+        checked(fd_, VIDIOC_QUERYCAP, &caps, "T880 QUERYCAP");
+        unsigned capabilities = caps.capabilities & V4L2_CAP_DEVICE_CAPS
+                                    ? caps.device_caps : caps.capabilities;
+        check(!strcmp(reinterpret_cast<const char *>(caps.driver), "mtk-vcp-dec") &&
+              (capabilities & V4L2_CAP_VIDEO_M2M_MPLANE) &&
+              (capabilities & V4L2_CAP_STREAMING), "T880 decoder identity changed");
+        v4l2_event_subscription sub{}; sub.type = V4L2_EVENT_SOURCE_CHANGE;
+        checked(fd_, VIDIOC_SUBSCRIBE_EVENT, &sub, "subscribe SOURCE_CHANGE");
+        v4l2_format fmt{}; fmt.type = OUT;
+        auto &p = fmt.fmt.pix_mp;
+        p.width = width; p.height = height;
+        p.pixelformat = is_av1(profile) ? v4l2_fourcc('A', 'V', '0', '1')
+                         : is_vp9(profile) ? V4L2_PIX_FMT_VP9
+                         : is_hevc(profile) ? V4L2_PIX_FMT_HEVC : V4L2_PIX_FMT_H264;
+        unsigned codec = p.pixelformat;
+        p.num_planes = 1; p.plane_fmt[0].sizeimage = AU_LIMIT;
+        checked(fd_, VIDIOC_S_FMT, &fmt, "S_FMT OUTPUT");
+        check(p.pixelformat == codec && p.num_planes == 1 &&
+              p.plane_fmt[0].sizeimage >= AU_LIMIT, "T880 OUTPUT capacity mismatch");
+        allocate(OUT, 4, output_);
+        unsigned type = OUT;
+        checked(fd_, VIDIOC_STREAMON, &type, "STREAMON OUTPUT"); output_on_ = true;
+    } catch (...) { fail(VA_STATUS_ERROR_DECODING_ERROR); throw; }
+}
+T880Decoder::~T880Decoder() { fail(VA_STATUS_ERROR_DECODING_ERROR); }
+void T880Decoder::fail(VAStatus status) noexcept {
+    failure_ = status;
+    if (fd_ >= 0) {
+        unsigned type = OUT; if (output_on_) call(fd_, VIDIOC_STREAMOFF, &type);
+        type = CAP; if (capture_on_) call(fd_, VIDIOC_STREAMOFF, &type);
+        close(fd_); fd_ = -1;
+    }
+    output_on_ = capture_on_ = false;
+    for (auto &[id, s] : pending_) { s->status = status; s->pending = false; }
+    pending_.clear(); wire_.clear(); capture_.clear(); output_.clear();
+}
+void T880Decoder::check_deadline() {
+    check(failure_ == VA_STATUS_SUCCESS, "T880 session failed", failure_);
+    check(Clock::now() < deadline_, "T880 operation deadline", VA_STATUS_ERROR_TIMEDOUT);
+}
+void T880Decoder::allocate(unsigned type, unsigned count, std::vector<Slot> &slots) {
+    v4l2_requestbuffers req{}; req.type = type; req.memory = V4L2_MEMORY_MMAP; req.count = count;
+    checked(fd_, VIDIOC_REQBUFS, &req, "REQBUFS");
+    check(req.count >= count && req.count <= 64, "T880 invalid pool size");
+    slots.resize(req.count);
+    for (unsigned i = 0; i < req.count; ++i) {
+        T880Buffer q(type, i); checked(fd_, VIDIOC_QUERYBUF, &q.value, "QUERYBUF");
+        check(q.value.length == (type == CAP ? 2u : 1u), "T880 plane count");
+        for (unsigned j = 0; j < q.value.length; ++j) {
+            Plane p; p.size = q.planes[j].length;
+            check(p.size && p.size <= 16u * 1024 * 1024, "T880 plane allocation budget");
+            void *mapping = mmap(nullptr, p.size, PROT_READ | PROT_WRITE, MAP_SHARED,
+                                 fd_, q.planes[j].m.mem_offset);
+            check(mapping != MAP_FAILED, "T880 mmap"); p.address = mapping;
+            slots[i].planes.push_back(std::move(p));
+        }
+    }
+}
+void T880Decoder::queue_capture(unsigned index) {
+    auto &slot = capture_.at(index); check(!slot.queued, "T880 double CAPTURE QBUF");
+    T880Buffer q(CAP, index); q.value.length = 2;
+    for (unsigned p = 0; p < 2; ++p) q.planes[p].length = slot.planes[p].size;
+    checked(fd_, VIDIOC_QBUF, &q.value, "QBUF CAPTURE"); slot.queued = true;
+}
+void T880Decoder::configure_capture() {
+    check(!capture_on_ && capture_.empty(), "T880 dynamic resolution change unsupported",
+          VA_STATUS_ERROR_UNIMPLEMENTED);
+    v4l2_format fmt{}; fmt.type = CAP;
+    checked(fd_, VIDIOC_G_FMT, &fmt, "G_FMT CAPTURE");
+    fmt.fmt.pix_mp.pixelformat = V4L2_PIX_FMT_NV12M;
+    checked(fd_, VIDIOC_S_FMT, &fmt, "S_FMT CAPTURE");
+    auto &p = fmt.fmt.pix_mp;
+    check(p.pixelformat == V4L2_PIX_FMT_NV12M && p.num_planes == 2 &&
+          p.width >= width_ && p.height >= height_ && p.width <= 4096 && p.height <= 2176,
+          "T880 unsupported CAPTURE geometry");
+    v4l2_selection selection{}; selection.type = CAP; selection.target = V4L2_SEL_TGT_COMPOSE;
+    checked(fd_, VIDIOC_G_SELECTION, &selection, "G_SELECTION visible");
+    check(selection.r.left == 0 && selection.r.top == 0 &&
+          selection.r.width == width_ && selection.r.height == height_,
+          "T880 visible crop mismatch");
+    storage_height_ = p.height;
+    for (unsigned i = 0; i < 2; ++i) {
+        stride_[i] = p.plane_fmt[i].bytesperline;
+        check(stride_[i] >= width_ && stride_[i] <= 16384 &&
+              uint64_t(stride_[i]) * (i ? (p.height + 1) / 2 : p.height) <=
+                  p.plane_fmt[i].sizeimage, "T880 invalid plane layout");
+    }
+    v4l2_control min{}; min.id = V4L2_CID_MIN_BUFFERS_FOR_CAPTURE;
+    checked(fd_, VIDIOC_G_CTRL, &min, "minimum CAPTURE");
+    check(min.value > 0 && min.value <= 60, "T880 capture minimum");
+    allocate(CAP, unsigned(min.value) + 4, capture_);
+    for (const auto &slot : capture_)
+        for (unsigned i = 0; i < 2; ++i)
+            check(slot.planes[i].size >= p.plane_fmt[i].sizeimage,
+                  "T880 mapped plane smaller than negotiated layout");
+    for (unsigned i = 0; i < capture_.size(); ++i) queue_capture(i);
+    unsigned type = CAP; checked(fd_, VIDIOC_STREAMON, &type, "STREAMON CAPTURE");
+    capture_on_ = true;
+}
+void T880Decoder::copy(unsigned index, const v4l2_buffer &, const v4l2_plane *planes,
+                        const std::shared_ptr<Surface> &s) {
+    check(s->width >= width_ && s->height >= height_ && s->fourcc == VA_FOURCC_NV12,
+          "T880 destination mismatch");
+    auto m = s->memory;
+    check(bool(m) && m->origin != MemoryOrigin::Iris && m->fourcc == VA_FOURCC_NV12,
+          "T880 stable destination missing");
+    for (unsigned p = 0; p < 2; ++p) {
+        size_t rows = p ? height_ / 2 : height_;
+        size_t end = size_t(planes[p].data_offset) + (rows - 1) * stride_[p] + width_;
+        check(planes[p].bytesused <= capture_[index].planes[p].size &&
+              planes[p].data_offset <= planes[p].bytesused && end <= planes[p].bytesused,
+              "T880 invalid CAPTURE payload");
+    }
+    check(m->stride >= width_ && m->storage_height >= height_ &&
+          m->data_offset <= m->size, "T880 destination bounds");
+    size_t available = m->size - m->data_offset;
+    check(m->stride && m->storage_height <= available / m->stride,
+          "T880 destination chroma offset");
+    size_t chroma = size_t(m->stride) * m->storage_height;
+    check(width_ <= available - chroma &&
+          size_t(height_ / 2 - 1) <= (available - chroma - width_) / m->stride,
+          "T880 destination chroma bounds");
+    auto *dst = m->map();
+    CpuWrite access(*m);
+    for (unsigned p = 0; p < 2; ++p) {
+        auto *src = static_cast<uint8_t *>(capture_[index].planes[p].address) + planes[p].data_offset;
+        size_t base = m->data_offset + (p ? size_t(m->stride) * m->storage_height : 0);
+        for (unsigned y = 0; y < (p ? height_ / 2 : height_); ++y)
+            memcpy(dst + base + size_t(y) * m->stride, src + size_t(y) * stride_[p], width_);
+    }
+    access.finish();
+    check_deadline();
+}
+void T880Decoder::pump(int timeout) {
+    check_deadline();
+    pollfd p{fd_, POLLIN | POLLOUT | POLLPRI, 0};
+    int r; do { r = poll(&p, 1, timeout); } while (r < 0 && errno == EINTR);
+    check(r >= 0 && !(p.revents & (POLLHUP | POLLNVAL)), "T880 poll failure");
+    for (;;) {
+        v4l2_event event{};
+        if (call(fd_, VIDIOC_DQEVENT, &event) < 0) {
+            check(errno == EAGAIN || errno == ENOENT, "T880 DQEVENT failure"); break;
+        }
+        if (event.type == V4L2_EVENT_SOURCE_CHANGE) configure_capture();
+        else check(event.type == V4L2_EVENT_EOS, "T880 unexpected event");
+    }
+    for (;;) {
+        T880Buffer q(OUT);
+        if (call(fd_, VIDIOC_DQBUF, &q.value) < 0) {
+            check(errno == EAGAIN, "T880 OUTPUT DQBUF failure"); break;
+        }
+        check(q.value.index < output_.size() && q.value.length == 1 &&
+              !(q.value.flags & V4L2_BUF_FLAG_ERROR), "T880 OUTPUT error");
+        auto &slot = output_[q.value.index];
+        auto it = wire_.find(token(q.value.timestamp));
+        check(slot.queued && slot.wire == token(q.value.timestamp) && it != wire_.end() &&
+              !it->second.returned, "T880 unknown/duplicate OUTPUT token");
+        it->second.returned = true; slot.queued = false;
+    }
+    if (!capture_on_ || last_) return;
+    for (;;) {
+        T880Buffer q(CAP);
+        if (call(fd_, VIDIOC_DQBUF, &q.value) < 0) {
+            check(errno == EAGAIN || (errno == EPIPE && last_), "T880 CAPTURE DQBUF failure");
+            break;
+        }
+        check(q.value.index < capture_.size() && q.value.length == 2 &&
+              !(q.value.flags & V4L2_BUF_FLAG_ERROR), "T880 CAPTURE error");
+        auto &slot = capture_[q.value.index];
+        check(slot.queued, "T880 duplicate CAPTURE index"); slot.queued = false;
+        bool payload = q.planes[0].bytesused || q.planes[1].bytesused;
+        if (payload) {
+            uint64_t id = token(q.value.timestamp);
+            auto it = wire_.find(id);
+            check(it != wire_.end() && !it->second.displayed,
+                  "T880 unknown/duplicate DISPLAY token");
+            auto &job = it->second;
+            if (!job.replay) {
+                auto target = pending_.find(job.client);
+                check(target != pending_.end() && target->second->pending &&
+                      target->second->token == job.client, "T880 missing CLIENT surface");
+                copy(q.value.index, q.value, q.planes, target->second);
+                target->second->status = VA_STATUS_SUCCESS;
+                target->second->pending = false; pending_.erase(target);
+            } else {
+                // Replay duplicates never replace stable outputs, but malformed
+                // scratch payloads are still errors, including byte bounds.
+                for (unsigned plane = 0; plane < 2; ++plane) {
+                    size_t rows = plane ? height_ / 2 : height_;
+                    size_t end = size_t(q.planes[plane].data_offset) +
+                                 (rows - 1) * stride_[plane] + width_;
+                    check(end <= q.planes[plane].bytesused &&
+                          q.planes[plane].bytesused <= slot.planes[plane].size,
+                          "T880 replay payload bounds");
+                }
+            }
+            job.displayed = true;
+            trace("T880 display wire=%llu client=%llu replay=%d",
+                  (unsigned long long)id, (unsigned long long)job.client, job.replay);
+        }
+        if (q.value.flags & V4L2_BUF_FLAG_LAST) { last_ = true; break; }
+        check(payload, "T880 empty non-LAST CAPTURE");
+        queue_capture(q.value.index);
+    }
+}
+void T880Decoder::wait_inputs() {
+    for (;;) {
+        bool busy = false; for (auto &slot : output_) busy |= slot.queued;
+        if (!busy) return;
+        pump(10);
+    }
+}
+void T880Decoder::drain() {
+    if (drained_) return;
+    wait_inputs();
+    v4l2_decoder_cmd cmd{}; cmd.cmd = V4L2_DEC_CMD_STOP;
+    checked(fd_, VIDIOC_DECODER_CMD, &cmd, "T880 STOP");
+    while (!last_) pump(10);
+    wait_inputs();
+    for (const auto &[id, job] : wire_)
+        check(job.returned && job.displayed, "T880 missing completion at LAST");
+    check(pending_.empty(), "T880 pending CLIENT at LAST");
+    drained_ = true;
+}
+void T880Decoder::send(const History &picture, bool replay) {
+    unsigned index;
+    for (;;) {
+        pump(0);
+        for (index = 0; index < output_.size(); ++index) if (!output_[index].queued) break;
+        if (index < output_.size()) break;
+        pump(10);
+    }
+    auto &slot = output_[index];
+    check(picture.bytes.size() <= slot.planes[0].size, "T880 negotiated OUTPUT limit");
+    check(next_wire_ < uint64_t(INT64_MAX),
+          "T880 wire token exhausted");
+    uint64_t id = next_wire_++;
+    // Allocate ledger nodes before transferring queue ownership.
+    wire_.emplace(id, Submission{picture.client, replay, false, false});
+    memcpy(slot.planes[0].address, picture.bytes.data(), picture.bytes.size());
+    T880Buffer q(OUT, index); q.value.length = 1;
+    q.planes[0].length = slot.planes[0].size; q.planes[0].bytesused = picture.bytes.size();
+    q.value.timestamp.tv_sec = id / 1000000; q.value.timestamp.tv_usec = id % 1000000;
+    checked(fd_, VIDIOC_QBUF, &q.value, "T880 QBUF OUTPUT");
+    slot.wire = id; slot.queued = true;
+    trace("T880 submit wire=%llu client=%llu replay=%d bytes=%zu",
+          (unsigned long long)id, (unsigned long long)picture.client, replay, picture.bytes.size());
+    while (!capture_on_) pump(10);
+}
+void T880Decoder::rebuild() {
+    check(drained_ && last_ && pending_.empty(), "T880 unsafe replay reset");
+    unsigned type = CAP;
+    checked(fd_, VIDIOC_STREAMOFF, &type, "T880 powered CAPTURE reset");
+    capture_on_ = false;
+    for (auto &s : capture_) s.queued = false;
+    wire_.clear(); last_ = false;
+    for (unsigned i = 0; i < capture_.size(); ++i) queue_capture(i);
+    checked(fd_, VIDIOC_STREAMON, &type, "T880 powered CAPTURE resume");
+    capture_on_ = true; drained_ = false;
+    for (const auto &picture : history_) send(picture, true);
+    // Return all compressed ownership before accepting a new CLIENT AU. The
+    // replay tail remains in the DPB and may display only with later input.
+    wait_inputs();
+}
+void T880Decoder::submit(const std::vector<uint8_t> &bytes,
+                          const std::shared_ptr<Surface> &s,
+                          const std::vector<uint8_t> &anchor) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    check(failure_ == VA_STATUS_SUCCESS, "T880 failed session", failure_);
+    deadline_ = Clock::now() + std::chrono::seconds(30);
+    // Validate engineering bounds and allocate AU/stable backing before reset.
+    // Later ledger allocation failure is fatal and closes the session safely.
+    const auto &accepted = anchor.empty() ? bytes : anchor;
+    check(!accepted.empty() && accepted.size() <= AU_LIMIT, "T880 AU size limit",
+          VA_STATUS_ERROR_INVALID_BUFFER);
+    check(!history_.empty() || !anchor.empty(), "T880 first picture must be an independent key anchor",
+          VA_STATUS_ERROR_INVALID_PARAMETER);
+    check(next_client_ != std::numeric_limits<uint64_t>::max(), "T880 CLIENT token exhausted");
+    check(!anchor.empty() || (history_.size() < COUNT_LIMIT &&
+          accepted.size() <= HISTORY_LIMIT - history_bytes_), "T880 contiguous history limit",
+          VA_STATUS_ERROR_ALLOCATION_FAILED);
+    History picture{next_client_, accepted};
+    auto memory = s->memory ? s->memory : allocate_surface(render_fd_, s->width, s->height,
+                                                          VA_FOURCC_NV12);
+    history_.reserve(history_.size() + 1);
+    try {
+        pump(0);
+        if (!anchor.empty() && !history_.empty()) {
+            // Retire an old anchor only after every accepted CLIENT has a
+            // stable completed output. Reset also releases old DPB references.
+            drain();
+            history_.clear(); history_bytes_ = 0;
+        }
+        if (drained_) rebuild();
+        s->memory = std::move(memory);
+        pending_.emplace(picture.client, s);
+        s->token = picture.client; s->status = VA_STATUS_SUCCESS; s->pending = true;
+        send(picture, false);
+        history_bytes_ += picture.bytes.size(); history_.push_back(std::move(picture));
+        ++next_client_;
+    } catch (const Error &e) { fail(e.status); throw; }
+      catch (...) { fail(VA_STATUS_ERROR_ALLOCATION_FAILED); throw; }
+}
+void T880Decoder::sync(const std::shared_ptr<Surface> &s) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    check(failure_ == VA_STATUS_SUCCESS, "T880 failed session", failure_);
+    deadline_ = Clock::now() + std::chrono::seconds(30);
+    try {
+        pump(0);
+        if (s->pending) {
+            wait_inputs(); pump(0);
+            if (s->pending) drain();
+        }
+        check(!s->pending && s->status == VA_STATUS_SUCCESS, "T880 sync failed");
+    } catch (const Error &e) { fail(e.status); throw; }
+      catch (...) { fail(VA_STATUS_ERROR_ALLOCATION_FAILED); throw; }
+}
+void T880Decoder::finish() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (failure_ != VA_STATUS_SUCCESS) return;
+    deadline_ = Clock::now() + std::chrono::seconds(30);
+    try { if (!history_.empty()) drain(); }
+    catch (const Error &e) { fail(e.status); throw; }
+    catch (...) { fail(VA_STATUS_ERROR_ALLOCATION_FAILED); throw; }
+}
+void T880Decoder::refresh() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    check(failure_ == VA_STATUS_SUCCESS, "T880 failed session", failure_);
+    deadline_ = Clock::now() + std::chrono::seconds(30);
+    try { pump(0); } catch (const Error &e) { fail(e.status); throw; }
+      catch (...) { fail(VA_STATUS_ERROR_ALLOCATION_FAILED); throw; }
+}
+} // namespace irisva
