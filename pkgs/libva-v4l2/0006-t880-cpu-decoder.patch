new file mode 100644
index 00000000..5c5d7a05
--- /dev/null
+++ b/src/t880-decoder.hpp
@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include "internal.hpp"
+#include <linux/videodev2.h>
+
+namespace irisva {
+// One serialized V4L2 owner. Scratch mappings never escape this object; CLIENT
+// surfaces own independent DMA-heap memory. Wire tokens identify submissions,
+// not VA surface IDs or recycled CAPTURE indices.
+class T880Decoder {
+    struct Plane {
+        void *address = nullptr;
+        size_t size = 0;
+        Plane() = default;
+        Plane(const Plane &) = delete;
+        Plane &operator=(const Plane &) = delete;
+        Plane(Plane &&other) noexcept;
+        ~Plane();
+    };
+    struct Slot {
+        std::vector<Plane> planes;
+        bool queued = false;
+        uint64_t wire = 0;
+    };
+    struct History {
+        uint64_t client;
+        std::vector<uint8_t> bytes;
+    };
+    struct Submission {
+        uint64_t client;
+        bool replay;
+        bool displayed = false;
+        bool returned = false;
+    };
+    using Clock = std::chrono::steady_clock;
+    int fd_ = -1, render_fd_;
+    unsigned width_, height_, stride_[2]{}, storage_height_ = 0;
+    std::mutex mutex_;
+    bool output_on_ = false, capture_on_ = false, drained_ = false, last_ = false;
+    VAStatus failure_ = VA_STATUS_SUCCESS;
+    uint64_t next_client_ = 1, next_wire_ = 1;
+    size_t history_bytes_ = 0;
+    std::vector<Slot> output_, capture_;
+    std::vector<History> history_;
+    std::map<uint64_t, Submission> wire_;
+    std::map<uint64_t, std::shared_ptr<Surface>> pending_;
+    Clock::time_point deadline_;
+    void allocate(unsigned type, unsigned count, std::vector<Slot> &slots);
+    void configure_capture();
+    void queue_capture(unsigned index);
+    void pump(int timeout);
+    void wait_inputs();
+    void drain();
+    void rebuild();
+    void send(const History &picture, bool replay);
+    void copy(unsigned index, const v4l2_buffer &buffer, const v4l2_plane *planes,
+              const std::shared_ptr<Surface> &surface);
+    void check_deadline();
+    void fail(VAStatus status) noexcept;
+  public:
+    T880Decoder(const std::string &device, unsigned width, unsigned height,
+                VAProfile profile, unsigned rt_format, int render_fd);
+    ~T880Decoder();
+    // anchor contains complete codec parameters and an independent key AU.
+    // Empty anchor means this AU depends on the current contiguous history.
+    void submit(const std::vector<uint8_t> &bytes, const std::shared_ptr<Surface> &surface,
+                const std::vector<uint8_t> &anchor);
+    void sync(const std::shared_ptr<Surface> &surface);
+    void finish();
+    void refresh();
+};
+} // namespace irisva
diff --git a/tests/t880/anchors.cpp b/tests/t880/anchors.cpp
new file mode 100644
index 00000000..edded36c
--- /dev/null
+++ b/tests/t880/anchors.cpp
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: MIT
+#include "../../src/av1.cpp"
+#include <cassert>
+#include <iostream>
+using namespace irisva;
+std::vector<unsigned> types(const std::vector<uint8_t> &bytes) {
+    std::vector<unsigned> result;
+    for (size_t at = 0; at < bytes.size();) {
+        unsigned header = bytes[at++]; assert((header & 7) == 2);
+        result.push_back(header >> 3); size_t size = 0; unsigned shift = 0, byte;
+        do { assert(at < bytes.size() && shift < 56); byte = bytes[at++];
+             size |= size_t(byte & 127) << shift; shift += 7; } while (byte & 128);
+        assert(size <= bytes.size() - at); at += size;
+    }
+    return result;
+}
+int main() {
+    std::vector<uint8_t> cached(130, 0xab), out;
+    obu(out, 2, {}); size_t td_end = out.size(); obu(out, 6, {1, 2, 3});
+    auto unchanged = out;
+    auto anchor = replay_anchor(out, td_end, cached, 0, true, false);
+    assert(types(anchor) == std::vector<unsigned>({2, 1, 6}));
+    std::vector<uint8_t> expected; obu(expected, 2, {}); obu(expected, 1, cached); obu(expected, 6, {1,2,3});
+    assert(anchor == expected && out == unchanged);
+    assert(replay_anchor(out, td_end, cached, 0, false, false).empty()); // hidden cached KEY
+    assert(replay_anchor(out, td_end, cached, 1, true, false).empty()); // INTER
+    assert(replay_anchor(out, td_end, cached, 2, true, false).empty()); // INTRA_ONLY
+    assert(replay_anchor(out, td_end, cached, 3, true, false).empty()); // SWITCH
+    assert(replay_anchor(expected, td_end, cached, 0, false, true) == expected); // initial KEY
+    assert(replay_anchor(expected, td_end, cached, 0, true, true) == expected);
+    std::cout << "AV1 initial/cached/hidden/switch anchor framing passed\n";
+}
diff --git a/tests/t880/replay.cpp b/tests/t880/replay.cpp
new file mode 100644
index 00000000..71668fdb
--- /dev/null
+++ b/tests/t880/replay.cpp
@@ -0,0 +1,225 @@
+// SPDX-License-Identifier: MIT
+// Exercise the production class against a deterministic stateful V4L2 model.
+#include "../../src/t880-decoder.hpp"
+#include <linux/dma-buf.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <poll.h>
+#include <cerrno>
+#include <limits>
+#include <deque>
+#include <cassert>
+#include <iostream>
+using namespace irisva;
+namespace {
+struct Fake {
+    bool event = false, configured = false, last = false;
+    bool duplicate = false, wrong_output = false, bad_alloc = false, bad_payload = false;
+    unsigned resets = 0, stops = 0, accepted = 0;
+    std::deque<std::pair<unsigned, timeval>> output;
+    std::deque<timeval> decoded, display;
+    std::deque<unsigned> capture;
+    std::map<unsigned, uint8_t *> mapped;
+    std::vector<uint64_t> submitted;
+} f;
+int fake_open(const char *, int, ...) { return 900; }
+int fake_close(int) { return 0; }
+void *fake_mmap(void *, size_t n, int, int, int, off_t offset) {
+    auto p = static_cast<uint8_t *>(calloc(1, n));
+    f.mapped[unsigned(offset)] = p; return p;
+}
+int fake_munmap(void *p, size_t) { free(p); return 0; }
+int fake_poll(pollfd *, nfds_t, int) { if (f.bad_alloc) throw std::bad_alloc(); return 0; }
+int fake_ioctl(int fd, unsigned long request, void *arg) {
+    if (fd != 900) { assert(request == DMA_BUF_IOCTL_SYNC); return 0; }
+    if (request == VIDIOC_QUERYCAP) {
+        auto &cap = *static_cast<v4l2_capability *>(arg);
+        strcpy(reinterpret_cast<char *>(cap.driver), "mtk-vcp-dec");
+        cap.capabilities = V4L2_CAP_VIDEO_M2M_MPLANE | V4L2_CAP_STREAMING; return 0;
+    }
+    if (request == VIDIOC_SUBSCRIBE_EVENT) return 0;
+    if (request == VIDIOC_S_FMT || request == VIDIOC_G_FMT) {
+        auto &p = static_cast<v4l2_format *>(arg)->fmt.pix_mp;
+        if (static_cast<v4l2_format *>(arg)->type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE) {
+            p.pixelformat = V4L2_PIX_FMT_NV12M; p.num_planes = 2;
+            p.width = 160; p.height = 128;
+            for (unsigned i = 0; i < 2; ++i) {
+                p.plane_fmt[i].bytesperline = 160;
+                p.plane_fmt[i].sizeimage = i ? 10240 : 20480;
+            }
+        }
+        return 0;
+    }
+    if (request == VIDIOC_G_SELECTION) {
+        auto &r = static_cast<v4l2_selection *>(arg)->r;
+        r.width = 160; r.height = 128; return 0;
+    }
+    if (request == VIDIOC_G_CTRL) { static_cast<v4l2_control *>(arg)->value = 1; return 0; }
+    if (request == VIDIOC_REQBUFS) return 0;
+    if (request == VIDIOC_QUERYBUF) {
+        auto &q = *static_cast<v4l2_buffer *>(arg);
+        bool cap = q.type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+        q.length = cap ? 2 : 1;
+        for (unsigned p = 0; p < q.length; ++p) {
+            q.m.planes[p].length = cap ? (p ? 10240 : 20480) : 4u * 1024 * 1024;
+            q.m.planes[p].m.mem_offset = (cap ? 100 : 0) + q.index * 2 + p;
+        }
+        return 0;
+    }
+    if (request == VIDIOC_STREAMON) return 0;
+    if (request == VIDIOC_STREAMOFF) {
+        if (*static_cast<unsigned *>(arg) == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE) {
+            f.capture.clear(); f.decoded.clear(); f.last = false; ++f.resets;
+        }
+        return 0;
+    }
+    if (request == VIDIOC_QBUF) {
+        auto &q = *static_cast<v4l2_buffer *>(arg);
+        if (q.type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE) f.capture.push_back(q.index);
+        else {
+            if (!f.configured) { f.event = true; f.configured = true; }
+            f.output.emplace_back(q.index, q.timestamp);
+            f.decoded.push_back(q.timestamp);
+            f.submitted.push_back(uint64_t(q.timestamp.tv_sec) * 1000000 + q.timestamp.tv_usec);
+            ++f.accepted;
+        }
+        return 0;
+    }
+    if (request == VIDIOC_DQEVENT) {
+        if (!f.event) { errno = ENOENT; return -1; }
+        f.event = false; static_cast<v4l2_event *>(arg)->type = V4L2_EVENT_SOURCE_CHANGE; return 0;
+    }
+    if (request == VIDIOC_DECODER_CMD) {
+        assert(static_cast<v4l2_decoder_cmd *>(arg)->cmd == V4L2_DEC_CMD_STOP);
+        ++f.stops; f.display = f.decoded; f.decoded.clear(); f.last = true;
+        if (f.duplicate && !f.display.empty()) f.display.push_back(f.display.front());
+        return 0;
+    }
+    if (request == VIDIOC_DQBUF) {
+        auto &q = *static_cast<v4l2_buffer *>(arg);
+        if (q.type == V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE) {
+            if (f.output.empty()) { errno = EAGAIN; return -1; }
+            auto [index, ts] = f.output.front(); f.output.pop_front();
+            q.index = index; q.timestamp = ts; q.length = 1;
+            if (f.wrong_output) ++q.timestamp.tv_usec;
+            return 0;
+        }
+        if (f.capture.empty() || (!f.last && f.display.empty())) { errno = EAGAIN; return -1; }
+        q.index = f.capture.front(); f.capture.pop_front(); q.length = 2;
+        if (f.display.empty()) { q.flags = V4L2_BUF_FLAG_LAST; f.last = false; }
+        else {
+            q.timestamp = f.display.front(); f.display.pop_front();
+            for (unsigned p = 0; p < 2; ++p) {
+                q.m.planes[p].bytesused = p ? 10240 : 20480;
+                if (f.bad_payload) ++q.m.planes[p].bytesused;
+                memset(f.mapped.at(100 + q.index * 2 + p), q.timestamp.tv_usec & 255,
+                       p ? 10240 : 20480);
+            }
+        }
+        return 0;
+    }
+    assert(false); return -1;
+}
+}
+#define open fake_open
+#define close fake_close
+#define mmap fake_mmap
+#define munmap fake_munmap
+#define ioctl fake_ioctl
+#define poll fake_poll
+#include "../../src/t880-decoder.cpp"
+#undef open
+#undef close
+#undef mmap
+#undef munmap
+#undef ioctl
+#undef poll
+namespace irisva {
+Memory::~Memory() { free(mapping); }
+uint8_t *Memory::map() { return static_cast<uint8_t *>(mapping); }
+void wait_surface_access(const Memory &, short) {}
+std::shared_ptr<Memory> allocate_surface(int, unsigned w, unsigned h, unsigned fourcc) {
+    auto m = std::make_shared<Memory>(); m->fd = 901; m->origin = MemoryOrigin::DmaHeap;
+    m->width = w; m->height = h; m->stride = w; m->storage_height = h;
+    m->fourcc = fourcc; m->size = size_t(w) * h * 3 / 2; m->mapping = calloc(1, m->size);
+    return m;
+}
+}
+std::shared_ptr<Surface> surface() {
+    auto s = std::make_shared<Surface>(); s->width = 160; s->height = 128; return s;
+}
+template<class F> void rejects(F action) { bool rejected = false;
+    try { action(); } catch (const Error &) { rejected = true; } if (!rejected) std::cerr << "missing rejection\n"; assert(rejected); }
+int main() {
+    for (auto profile : {VAProfileH264Main, VAProfileHEVCMain, VAProfileVP9Profile0, VAProfileAV1Profile0}) {
+        f = Fake{};
+        T880Decoder d("fake", 160, 128, profile, VA_RT_FORMAT_YUV420, -1);
+        auto a = surface(), b = surface(), c = surface();
+        rejects([&] { d.submit({1}, a, {}); }); assert(f.accepted == 0);
+        d.submit({1}, a, {7, 8, 1}); d.sync(a);
+        assert(!a->pending && a->memory->map()[0] == 1);
+        d.submit({2}, b, {}); d.sync(b);
+        assert(a->memory->map()[0] == 1 && b->memory->map()[0] == 3);
+        d.submit({3}, c, {}); d.sync(c);
+        assert(a->memory->map()[0] == 1 && b->memory->map()[0] == 3 && c->memory->map()[0] == 6);
+        assert(f.accepted == 6 && f.stops == 3 && f.resets == 2);
+        for (unsigned i = 0; i < f.submitted.size(); ++i) assert(f.submitted[i] == i + 1);
+        unsigned count = f.accepted;
+        rejects([&] { d.submit(std::vector<uint8_t>(4u * 1024 * 1024 + 1), surface(), {}); });
+        assert(f.accepted == count); // Limits fail before reset or QBUF.
+        auto anchor = surface(); d.submit({4}, anchor, {9, 4}); d.sync(anchor);
+        assert(f.accepted == count + 1 && a->memory->map()[0] == 1);
+        d.finish();
+    }
+    f = Fake{};
+    {
+        T880Decoder d("fake", 160, 128, VAProfileHEVCMain, VA_RT_FORMAT_YUV420, -1);
+        auto s = surface(); d.submit({1}, s, {1}); f.duplicate = true;
+        rejects([&] { d.sync(s); });
+        rejects([&] { d.submit({2}, surface(), {}); });
+    }
+    f = Fake{};
+    {
+        T880Decoder d("fake", 160, 128, VAProfileH264Main, VA_RT_FORMAT_YUV420, -1);
+        auto s = surface(); f.wrong_output = true;
+        rejects([&] { d.submit({1}, s, {1}); }); assert(!s->pending && s->status != VA_STATUS_SUCCESS);
+    }
+    f = Fake{};
+    {
+        T880Decoder d("fake", 160, 128, VAProfileH264Main, VA_RT_FORMAT_YUV420, -1);
+        auto s = surface(); d.submit({1}, s, {1}); f.bad_alloc = true;
+        bool failed = false;
+        try { d.sync(s); } catch (const std::bad_alloc &) { failed = true; }
+        assert(failed && !s->pending && s->status == VA_STATUS_ERROR_ALLOCATION_FAILED);
+        f.bad_alloc = false; rejects([&] { d.submit({2}, surface(), {}); });
+    }
+    f = Fake{};
+    {
+        T880Decoder d("fake", 160, 128, VAProfileH264Main, VA_RT_FORMAT_YUV420, -1);
+        auto s = surface(); d.submit({1}, s, {1}); f.bad_payload = true;
+        rejects([&] { d.sync(s); }); assert(!s->pending && s->status != VA_STATUS_SUCCESS);
+    }
+    f = Fake{};
+    {
+        T880Decoder d("fake", 160, 128, VAProfileH264Main, VA_RT_FORMAT_YUV420, -1);
+        std::vector<uint8_t> megabyte(1024 * 1024, 1);
+        d.submit(megabyte, surface(), megabyte);
+        for (unsigned i = 1; i < 64; ++i) d.submit(megabyte, surface(), {});
+        unsigned accepted = f.accepted;
+        rejects([&] { d.submit({1}, surface(), {}); });
+        assert(f.accepted == accepted && f.resets == 0);
+    }
+    f = Fake{};
+    {
+        T880Decoder d("fake", 160, 128, VAProfileH264Main, VA_RT_FORMAT_YUV420, -1);
+        d.submit({1}, surface(), {1});
+        for (unsigned i = 1; i < 4096; ++i) d.submit({1}, surface(), {});
+        unsigned accepted = f.accepted;
+        rejects([&] { d.submit({1}, surface(), {}); });
+        assert(f.accepted == accepted && f.resets == 0);
+    }
+    rejects([] { token(timeval{std::numeric_limits<long>::max(), 999999}); });
+    std::cout << "T880 replay ownership, stable pixels, fresh anchor, limits and sticky faults passed\n";
+}
