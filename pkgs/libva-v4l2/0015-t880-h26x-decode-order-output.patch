+// SPDX-License-Identifier: MIT
+#include "../../src/h264.cpp"
+#include <cassert>
+using namespace irisva;
+static unsigned restriction(const std::vector<uint8_t>& nal, bool wanted) {
+    Reader r(std::vector<uint8_t>(nal.begin()+4,nal.end()));
+    unsigned profile=r.bits(8); r.bits(8); assert(r.bits(8)==51); r.ue();
+    if(profile==100) { assert(r.ue()==1); assert(r.ue()==0 && r.ue()==0); r.bit(); assert(!r.bit()); }
+    r.ue(); unsigned poc=r.ue(); if(poc==0)r.ue();
+    r.ue(); r.bit(); r.ue(); r.ue(); assert(r.bit()); r.bit(); assert(!r.bit());
+    assert(r.bit()==wanted); if(!wanted)return 0;
+    for(unsigned i=0;i<8;i++)assert(!r.bit());
+    assert(r.bit() && r.bit()); assert(r.ue()==2 && r.ue()==1);
+    assert(r.ue()==16 && r.ue()==16); assert(r.ue()==0); return r.ue();
+}
+int main() {
+    for(auto profile:{VAProfileH264ConstrainedBaseline,VAProfileH264Main,VAProfileH264High})
+      for(auto geometry:{std::pair{20u,12u},std::pair{120u,68u},std::pair{256u,136u}}) {
+        Picture p; p.has_params=true; p.params.seq_fields.bits.chroma_format_idc=1;
+        p.params.seq_fields.bits.frame_mbs_only_flag=1;
+        p.params.picture_width_in_mbs_minus1=geometry.first-1;
+        p.params.picture_height_in_mbs_minus1=geometry.second-1;
+        p.params.num_ref_frames=4; p.slices.push_back({{}, {0x65,0xb8}});
+        H264State original,explicit_default,ordered;
+        auto a=h264_bitstream(profile,p,original);
+        assert(a==h264_bitstream(profile,p,explicit_default,false));
+        auto b=h264_bitstream(profile,p,ordered,true);
+        assert(a!=b); assert(!restriction(original.sps,false));
+        unsigned capacity=std::min(16u,184320/(geometry.first*geometry.second));
+        assert(restriction(ordered.sps,true)==capacity);
+        assert(original.pps==ordered.pps);
+        assert(std::equal(p.slices[0].bytes.rbegin(),p.slices[0].bytes.rend(),b.rbegin()));
+        p.params.num_ref_frames=capacity+1; H264State rejected; bool failed=false;
+        try{h264_bitstream(profile,p,rejected,true);}catch(const Error&){failed=true;} assert(failed);
+      }
+    // Existing POC type-1 conversion and CABAC/CAVLC payloads are identical
+    // with either output policy; only the generated SPS output restriction changes.
+    for(bool cabac:{false,true}) {
+        Picture p; p.has_params=true;p.params.seq_fields.bits.chroma_format_idc=1;
+        p.params.seq_fields.bits.frame_mbs_only_flag=1;
+        p.params.seq_fields.bits.pic_order_cnt_type=1;
+        p.params.seq_fields.bits.delta_pic_order_always_zero_flag=1;
+        p.params.pic_fields.bits.entropy_coding_mode_flag=cabac;
+        p.params.picture_width_in_mbs_minus1=19;p.params.picture_height_in_mbs_minus1=11;
+        p.params.num_ref_frames=4;p.params.CurrPic.TopFieldOrderCnt=6;
+        p.params.CurrPic.BottomFieldOrderCnt=6;
+        Bits bits;bits.ue(0);bits.ue(2);bits.ue(0);bits.bits(0,4);bits.ue(0);
+        Slice slice;slice.params.slice_data_bit_offset=bits.position()+8;
+        if(cabac)while(bits.position()&7)bits.bit(1);
+        bits.bits(0x1234,16);bits.nal(slice.bytes,0x65);
+        slice.bytes.erase(slice.bytes.begin(),slice.bytes.begin()+4);p.slices.push_back(slice);
+        H264State original,ordered;
+        auto a=h264_bitstream(VAProfileH264High,p,original,false);
+        auto b=h264_bitstream(VAProfileH264High,p,ordered,true);
+        assert(original.pps==ordered.pps);
+        size_t pa=original.sps.size(),pb=ordered.sps.size();
+        for(auto &[id,bytes]:original.pps){pa+=bytes.size();pb+=bytes.size();}
+        assert(std::vector<uint8_t>(a.begin()+pa,a.end())==std::vector<uint8_t>(b.begin()+pb,b.end()));
+        assert(restriction(ordered.sps,true)==16);
+    }
+    Picture p; p.has_params=true;p.params.seq_fields.bits.chroma_format_idc=1;
+    p.params.seq_fields.bits.frame_mbs_only_flag=1;
+    p.params.picture_width_in_mbs_minus1=65535;p.params.picture_height_in_mbs_minus1=65535;
+    p.slices.push_back({{}, {0x65,0xb8}}); H264State state;bool failed=false;
+    try{h264_bitstream(VAProfileH264High,p,state,true);}catch(const Error&){failed=true;}assert(failed);
+}
