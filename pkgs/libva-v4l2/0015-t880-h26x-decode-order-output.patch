+// SPDX-License-Identifier: MIT
+#include "../../src/hevc.cpp"
+#include <cassert>
+using namespace irisva;
+static void restriction(Reader &r,unsigned dpb,bool ordered) {
+    assert(!r.bit()); assert(r.ue()==dpb); assert(r.ue()==(ordered?0:dpb)); assert(r.ue()==0);
+}
+static void parameter_sets(const HevcState &state,unsigned dpb,bool ordered) {
+    Reader v(std::vector<uint8_t>(state.vps.begin()+4,state.vps.end()));
+    v.skip(4+2+6); assert(v.bits(3)==6); assert(v.bit());v.skip(16+112);
+    restriction(v,dpb,ordered);
+    Reader s(std::vector<uint8_t>(state.sps.begin()+4,state.sps.end()));
+    s.skip(4);assert(s.bits(3)==6);assert(s.bit());s.skip(112);
+    assert(s.ue()==0 && s.ue()==1);assert(s.ue()==1920 && s.ue()==1080);assert(!s.bit());
+    s.ue();s.ue();s.ue();restriction(s,dpb,ordered);
+}
+int main() {
+    for(unsigned dpb:{0u,4u,15u}) {
+        HevcPicture p; p.has_params=true;
+        p.params.pic_fields.bits.chroma_format_idc=1;
+        p.params.pic_width_in_luma_samples=1920;p.params.pic_height_in_luma_samples=1080;
+        p.params.sps_max_dec_pic_buffering_minus1=dpb;
+        for(auto &r:p.params.ReferenceFrames)r.picture_id=VA_INVALID_SURFACE;
+        HevcSlice slice; slice.params.LongSliceFlags.fields.slice_type=2;
+        slice.params.slice_data_byte_offset=3;slice.bytes={0x26,0x01,0xae,0x55};
+        p.slices.push_back(slice);
+        HevcState original,explicit_default,ordered;
+        auto a=hevc_bitstream(VAProfileHEVCMain,p,original);
+        assert(a==hevc_bitstream(VAProfileHEVCMain,p,explicit_default,false));
+        auto b=hevc_bitstream(VAProfileHEVCMain,p,ordered,true);
+        parameter_sets(original,dpb,false);parameter_sets(ordered,dpb,true);
+        assert(original.pps==ordered.pps);
+        assert(a.back()==b.back() && b.back()==0x55);
+        assert(dpb==0 ? a==b : a!=b);
+    }
+}
