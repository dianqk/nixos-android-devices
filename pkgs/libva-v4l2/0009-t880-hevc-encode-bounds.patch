From: dianqk <dianqk@dianqk.net>
Subject: [PATCH] t880: bound HEVC encoding to supported frame sizes

Limit HEVC to 1920 pixels on either axis and 1920x1080 pixels per frame,
including portrait input. Larger HEVC frames can trigger firmware SMI timeout;
reject them before hardware submission. Keep H264 and decode limits unchanged.

--- a/src/internal.hpp
+++ b/src/internal.hpp
@@ -29,6 +29,22 @@
 extern "C" int irisva_msm_allocate_coherent(int drm_fd, uint64_t size);
 
 namespace irisva {
+inline bool t880_encode_geometry(bool hevc, unsigned width, unsigned height) {
+    const unsigned axis = hevc ? 1920 : 4096;
+    const uint64_t pixels = hevc ? uint64_t(1920) * 1080 : uint64_t(4096) * 2176;
+    return width >= 160 && height >= 128 && !(width & 1) && !(height & 1) &&
+           width <= axis && height <= axis && uint64_t(width) * height <= pixels;
+}
+
+// Contexts may include coding-block padding; visible pictures are checked separately.
+inline bool t880_encode_context_geometry(bool hevc, unsigned width, unsigned height) {
+    if (!hevc)
+        return t880_encode_geometry(false, width, height);
+    return width >= 160 && height >= 128 && !(width & 1) && !(height & 1) &&
+           width <= 1920 && height <= 1920 &&
+           uint64_t(width) * height <= uint64_t(1920) * 1088;
+}
+
 inline bool is_rgb(unsigned fourcc) {
     return fourcc == VA_FOURCC_BGRA || fourcc == VA_FOURCC_RGBA;
 }
