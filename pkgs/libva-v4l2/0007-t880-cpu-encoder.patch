+// Destination ownership is the V4L2 slot's QUERYBUF/QBUF/DQBUF contract,
+// not a DMA-BUF fence. Never apply this exception to imported/exported memory.
+void copy_to_v4l2_mmap(Memory &dst, Memory &src, unsigned width, unsigned height) {
+    check(dst.origin == MemoryOrigin::V4l2Mmap && dst.fd == -1 && dst.mapping && !dst.queued,
+          "V4L2 MMAP destination is not CPU-owned");
+    check(src.fd >= 0 && src.origin != MemoryOrigin::V4l2Mmap &&
+          dst.fourcc == VA_FOURCC_NV12 && src.fourcc == VA_FOURCC_NV12 &&
+          width && height && !(width & 1) && !(height & 1), "NV12 CPU copy format");
+    auto bounds = [width, height](const Memory &m) {
+        check(width <= m.width && height <= m.height && m.stride >= width &&
+              m.storage_height >= height && m.data_offset <= m.size, "NV12 copy layout");
+        size_t remaining = m.size - m.data_offset;
+        check(m.stride && m.storage_height <= remaining / m.stride, "NV12 copy UV offset");
+        size_t uv = size_t(m.stride) * m.storage_height;
+        check(width <= remaining - uv &&
+              size_t(height / 2 - 1) <= (remaining - uv - width) / m.stride,
+              "NV12 copy UV bounds");
+        return uv;
+    };
+    size_t src_uv = bounds(src), dst_uv = bounds(dst);
+    check(dst.storage_height % 2 == 0 && dst_uv / 2 <= dst.size - dst.data_offset - dst_uv,
+          "V4L2 MMAP padded UV bounds");
+    auto *input = src.map(); auto *output = static_cast<uint8_t *>(dst.mapping);
+    CpuAccess read(src, DMA_BUF_SYNC_READ);
+    memset(output + dst.data_offset, 16, dst_uv);
+    memset(output + dst.data_offset + dst_uv, 128, dst_uv / 2);
+    for (unsigned plane = 0; plane < 2; ++plane) {
+        size_t a = src.data_offset + (plane ? src_uv : 0);
+        size_t b = dst.data_offset + (plane ? dst_uv : 0);
+        for (unsigned y = 0; y < (plane ? height / 2 : height); ++y)
+            memcpy(output + b + size_t(y) * dst.stride,
+                   input + a + size_t(y) * src.stride, width);
+    }
+    read.finish();
+}
