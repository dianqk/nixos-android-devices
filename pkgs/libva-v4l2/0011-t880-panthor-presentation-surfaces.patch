diff --git a/src/t880-presentation.cpp b/src/t880-presentation.cpp
new file mode 100644
index 0000000..84c0e72
--- /dev/null
+++ b/src/t880-presentation.cpp
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: MIT
+#include "internal.hpp"
+#include <drm/panthor_drm.h>
+#include <xf86drm.h>
+#include <fcntl.h>
+#include <cstring>
+#include <sys/ioctl.h>
+#include <unistd.h>
+#include <utility>
+
+namespace irisva {
+namespace {
+// A PRIME fd owns its storage independently of this temporary DRM handle.
+// Never retry a numeric handle after an attempted close: it may be recycled.
+struct BoHandle {
+    int fd;
+    uint32_t handle;
+    int release() {
+        drm_gem_close request{};
+        request.handle = std::exchange(handle, 0);
+        return ioctl(fd, DRM_IOCTL_GEM_CLOSE, &request);
+    }
+    ~BoHandle() { if (handle) release(); }
+};
+constexpr size_t PRESENTATION_LIMIT = 16u * 1024 * 1024;
+}
+std::shared_ptr<Memory> allocate_t880_presentation_surface(int render_fd, unsigned width,
+                                                         unsigned height, unsigned fourcc) {
+    check(render_fd >= 0 && fourcc == VA_FOURCC_NV12 && width && height &&
+          !(width & 1) && !(height & 1) && width <= 4096 && height <= 2176,
+          "T880 presentation geometry", VA_STATUS_ERROR_INVALID_PARAMETER);
+    auto version = drmGetVersion(render_fd);
+    bool panthor = version && version->name && !std::strcmp(version->name, "panthor");
+    if (version) drmFreeVersion(version);
+    check(panthor, "T880 presentation requires a Panthor render node",
+          VA_STATUS_ERROR_UNSUPPORTED_MEMORY_TYPE);
+    auto m = std::make_shared<Memory>();
+    m->width = width; m->height = height; m->fourcc = fourcc;
+    m->stride = (width + 127) & ~127u;
+    m->storage_height = (height + 31) & ~31u;
+    long page = sysconf(_SC_PAGESIZE);
+    check(page > 0 && size_t(page) <= PRESENTATION_LIMIT, "T880 presentation page size");
+    size_t bytes = size_t(m->stride) * m->storage_height * 3 / 2;
+    m->size = (bytes + size_t(page) - 1) / size_t(page) * size_t(page);
+    check(m->size <= PRESENTATION_LIMIT, "T880 presentation allocation limit",
+          VA_STATUS_ERROR_ALLOCATION_FAILED);
+    // flags=0 uses Panthor's coherent/default WC CPU mapping policy. VM=0
+    // permits PRIME export. These buffers are GPU presentation storage, not
+    // attachments of the noncoherent VPU: keep DMA heaps for upload/encoding.
+    // https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git/tree/include/uapi/drm/panthor_drm.h?h=v7.3
+    drm_panthor_bo_create create{};
+    create.size = m->size;
+    check(ioctl(render_fd, DRM_IOCTL_PANTHOR_BO_CREATE, &create) == 0,
+          "create Panthor presentation BO", VA_STATUS_ERROR_ALLOCATION_FAILED);
+    BoHandle handle{render_fd, create.handle};
+    check(create.handle && create.size >= m->size && create.size <= PRESENTATION_LIMIT,
+          "invalid Panthor presentation BO", VA_STATUS_ERROR_ALLOCATION_FAILED);
+    check(drmPrimeHandleToFD(render_fd, create.handle, DRM_CLOEXEC | DRM_RDWR, &m->fd) == 0,
+          "export Panthor presentation BO", VA_STATUS_ERROR_ALLOCATION_FAILED);
+    check(handle.release() == 0, "close Panthor presentation handle",
+          VA_STATUS_ERROR_ALLOCATION_FAILED);
+    m->origin = MemoryOrigin::PanthorPresentation;
+    // Memory::map and all CPU reads/writes retain DMA_BUF_IOCTL_SYNC and
+    // reservation-fence waits. Panthor provides real PRIME CPU-access callbacks.
+    return m;
+}
+std::shared_ptr<Memory> allocate_t880_export_surface(int render_fd, unsigned width,
+                                                     unsigned height, unsigned fourcc, unsigned flags) {
+    if ((flags & VA_EXPORT_SURFACE_READ_ONLY) && !(flags & VA_EXPORT_SURFACE_WRITE_ONLY))
+        return allocate_t880_presentation_surface(render_fd, width, height, fourcc);
+    return allocate_surface(render_fd, width, height, fourcc);
+}
+} // namespace irisva
diff --git a/tests/t880/presentation.cpp b/tests/t880/presentation.cpp
new file mode 100644
index 0000000..fa8ad64
--- /dev/null
+++ b/tests/t880/presentation.cpp
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: MIT
+#include "../../src/internal.hpp"
+#include <drm/panthor_drm.h>
+#include <xf86drm.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <cassert>
+#include <cerrno>
+#include <iostream>
+using namespace irisva;
+namespace {
+struct Fake { bool create_fail=false,export_fail=false,close_fail=false,bad_size=false,wrong_driver=false;
+ unsigned creates=0,exports=0,closes=0,heap=0,live=0;int last_fd=-1;uint64_t size=0; } f;
+drmVersion version{};
+drmVersionPtr fake_version(int fd){assert(fd==100);version.name=const_cast<char*>(f.wrong_driver?"msm":"panthor");return &version;}
+void fake_free_version(drmVersionPtr v){assert(v==&version);}
+int fake_ioctl(int fd,unsigned long request,void*arg) {
+ assert(fd==100);
+ if(request==DRM_IOCTL_PANTHOR_BO_CREATE){auto&r=*static_cast<drm_panthor_bo_create*>(arg);
+  ++f.creates;assert(r.flags==0&&r.exclusive_vm_id==0&&r.size<=16u*1024*1024);
+  if(f.create_fail){errno=ENOMEM;return -1;}f.size=r.size;r.handle=7;f.live=1;if(f.bad_size)r.size=0;return 0;}
+ assert(request==DRM_IOCTL_GEM_CLOSE);auto&r=*static_cast<drm_gem_close*>(arg);assert(r.handle==7&&f.live==1);f.live=0;++f.closes;
+ if(f.close_fail){errno=EIO;return -1;}return 0;
+}
+int fake_export(int fd,uint32_t handle,uint32_t flags,int*out) {
+ assert(fd==100&&handle==7&&flags==(DRM_CLOEXEC|DRM_RDWR));++f.exports;
+ if(f.export_fail){errno=ENOMEM;return -1;}
+ f.last_fd=memfd_create("presentation-test",MFD_CLOEXEC);assert(f.last_fd>=0);assert(!ftruncate(f.last_fd,f.size));*out=f.last_fd;return 0;
+}
+}
+#define drmGetVersion fake_version
+#define drmFreeVersion fake_free_version
+#define ioctl fake_ioctl
+#define drmPrimeHandleToFD fake_export
+#include "../../src/t880-presentation.cpp"
+#undef drmGetVersion
+#undef drmFreeVersion
+#undef ioctl
+#undef drmPrimeHandleToFD
+namespace irisva {
+Memory::~Memory(){if(mapping)munmap(mapping,size);if(fd>=0)close(fd);}
+std::shared_ptr<Memory> allocate_surface(int,unsigned w,unsigned h,unsigned fourcc) {
+ ++f.heap;auto m=std::make_shared<Memory>();m->width=w;m->height=h;m->fourcc=fourcc;m->origin=MemoryOrigin::DmaHeap;return m;
+}
+}
+template<class F>void rejects(F action){bool failed=false;try{action();}catch(const Error&){failed=true;}assert(failed);}
+int main(){
+ for(unsigned flags:{unsigned(VA_EXPORT_SURFACE_READ_ONLY),unsigned(VA_EXPORT_SURFACE_READ_ONLY|VA_EXPORT_SURFACE_SEPARATE_LAYERS)}){
+  f={};auto m=allocate_t880_export_surface(100,1920,1080,VA_FOURCC_NV12,flags);
+  assert(f.creates==1&&f.exports==1&&f.closes==1&&!f.live&&!f.heap);
+  assert(m->origin==MemoryOrigin::PanthorPresentation&&m->stride==1920&&m->storage_height==1088);
+  int held=fcntl(m->fd,F_DUPFD_CLOEXEC,0);assert(held>=0);struct stat a{},b{};assert(!fstat(m->fd,&a)&&!fstat(held,&b));assert(a.st_ino==b.st_ino);
+  int original=m->fd;m.reset();assert(fcntl(original,F_GETFD)==-1&&errno==EBADF);assert(!fstat(held,&b)&&b.st_ino==a.st_ino);close(held);
+ }
+ for(unsigned flags:{0u,unsigned(VA_EXPORT_SURFACE_WRITE_ONLY),unsigned(VA_EXPORT_SURFACE_READ_WRITE)}){
+  f={};auto m=allocate_t880_export_surface(100,1920,1080,VA_FOURCC_NV12,flags);assert(f.heap==1&&!f.creates&&m->origin==MemoryOrigin::DmaHeap);
+ }
+ for(int mode=0;mode<4;mode++){
+  // A failed close verifies single-attempt handling and fd cleanup,
+  // not a guarantee that an arbitrary kernel failure released its handle.
+  f={};f.create_fail=mode==0;f.export_fail=mode==1;f.close_fail=mode==2;f.bad_size=mode==3;
+  rejects([]{allocate_t880_presentation_surface(100,1920,1080,VA_FOURCC_NV12);});assert(!f.live);
+  assert(f.closes==(mode==0?0u:1u));
+  if(f.last_fd>=0)assert(fcntl(f.last_fd,F_GETFD)==-1&&errno==EBADF);
+ }
+ f={};f.wrong_driver=true;rejects([]{allocate_t880_presentation_surface(100,1920,1080,VA_FOURCC_NV12);});assert(!f.creates);
+ f={};for(auto size:{std::pair<unsigned,unsigned>{0,1080},{1921,1080},{4098,2176},{4096,2178}})
+  rejects([&]{allocate_t880_presentation_surface(100,size.first,size.second,VA_FOURCC_NV12);});
+ rejects([]{allocate_t880_presentation_surface(100,1920,1080,VA_FOURCC_P010);});assert(!f.creates);
+ auto max=allocate_t880_presentation_surface(100,4096,2176,VA_FOURCC_NV12);assert(max->size<=16u*1024*1024&&f.closes==1);
+ std::cout<<"T880 read-only/early presentation, upload policy, PRIME lifetime, failures and bounds passed\n";
+}
