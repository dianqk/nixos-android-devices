new file mode 100644
index 0000000..40ea6e4
--- /dev/null
+++ b/tests/rgb-vpp-parameters.cpp
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: MIT
+#include "internal.hpp"
+#include <cassert>
+using namespace irisva;
+int main() {
+    auto source = std::make_shared<Surface>();
+    source->width = source->height = 64;
+    source->fourcc = VA_FOURCC_BGRA;
+    source->memory = std::make_shared<Memory>();
+    Surface target;
+    target.width = target.height = 64;
+    target.fourcc = VA_FOURCC_NV12;
+    VAProcPipelineParameterBuffer p{};
+    p.output_color_standard = VAProcColorStandardExplicit;
+    auto parse = [&] {
+        Buffer b{};
+        b.data.resize(sizeof(p));
+        std::memcpy(b.data.data(), &p, sizeof(p));
+        return gles_rgb_picture(b, source, target);
+    };
+    auto reject = [&] {
+        try { parse(); assert(false); }
+        catch (const Error &e) { assert(e.status == VA_STATUS_ERROR_UNIMPLEMENTED); }
+    };
+    for (unsigned matrix : {0u, 1u, 2u, 5u, 6u}) {
+        p.output_color_properties.matrix_coefficients = matrix;
+        assert(parse().bt709 == (matrix != 5 && matrix != 6));
+    }
+    p.output_color_properties.matrix_coefficients = 1;
+    p.output_color_properties.color_range = VA_SOURCE_RANGE_FULL;
+    assert(parse().full_range);
+    p.output_color_properties.color_range = VA_SOURCE_RANGE_REDUCED;
+    assert(!parse().full_range);
+    for (unsigned matrix : {9u, 10u}) {
+        p.output_color_properties.matrix_coefficients = matrix;
+        reject();
+    }
+    p.output_color_properties.matrix_coefficients = 1;
+    p.output_color_properties.colour_primaries = 9;
+    reject();
+    p.output_color_properties.colour_primaries = 1;
+    for (unsigned hdr : {16u, 18u}) {
+        p.input_color_properties.transfer_characteristics = hdr;
+        reject();
+        p.input_color_properties.transfer_characteristics = 0;
+        p.output_color_properties.transfer_characteristics = hdr;
+        reject();
+        p.output_color_properties.transfer_characteristics = 0;
+    }
+    p.output_color_standard = VAProcColorStandardBT601;
+    assert(!parse().bt709);
+    p.output_color_standard = VAProcColorStandardBT709;
+    assert(parse().bt709);
+}
