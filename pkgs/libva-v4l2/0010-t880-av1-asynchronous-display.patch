From: dianqk <dianqk@dianqk.net>
Subject: [PATCH] t880: wait for AV1 display without flushing references

AV1 pictures can complete asynchronously after their compressed buffer is
returned. Wait for the requested CAPTURE completion within the fixed operation
deadline instead of flushing the DPB and replaying the prefix. Preserve the
existing stable output storage and sticky failure ownership. Other codecs keep
their current completion policy.

diff --git a/src/t880-decoder.cpp b/src/t880-decoder.cpp
index f2f31ed..ebc0380 100644
--- a/src/t880-decoder.cpp
+++ b/src/t880-decoder.cpp
@@ -65,7 +65,8 @@ T880Decoder::Plane::Plane(Plane &&p) noexcept : address(p.address), size(p.size)
 T880Decoder::Plane::~Plane() { if (address) munmap(address, size); }
 T880Decoder::T880Decoder(const std::string &device, unsigned width, unsigned height,
                          VAProfile profile, unsigned rt_format, int render_fd)
-    : render_fd_(render_fd), width_(width), height_(height) {
+    : render_fd_(render_fd), width_(width), height_(height),
+      display_without_lookahead_(is_av1(profile)) {
     check(rt_format == VA_RT_FORMAT_YUV420 && width >= 128 && height >= 128 && !(width & 1) &&
           !(height & 1) && width <= 4096 && height <= 2176 &&
           uint64_t(width) * height <= uint64_t(4096) * 2176,
@@ -392,7 +393,13 @@ void T880Decoder::sync(const std::shared_ptr<Surface> &s) {
         pump(0);
         if (s->pending) {
             wait_inputs(); pump(0);
-            if (s->pending) drain();
+            // AV1 DISPLAY arrives asynchronously after compressed ownership
+            // returns. Wait for that completion; STOP would flush the DPB and
+            // force prefix replay on the next picture. The operation deadline
+            // stays fixed even if unrelated outputs arrive while pumping.
+            if (display_without_lookahead_) {
+                while (s->pending) pump(10);
+            } else if (s->pending) drain();
         }
         check(!s->pending && s->status == VA_STATUS_SUCCESS, "T880 sync failed");
     } catch (const Error &e) { fail(e.status); throw; }
diff --git a/src/t880-decoder.hpp b/src/t880-decoder.hpp
index 5c5d7a0..a0e36d2 100644
--- a/src/t880-decoder.hpp
+++ b/src/t880-decoder.hpp
