+++ b/src/t880-gpu.cpp
@@ -0,0 +1,306 @@
+// SPDX-License-Identifier: MIT
+#include "t880-gpu.hpp"
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <GLES3/gl3.h>
+#include <GLES2/gl2ext.h>
+#include <gbm.h>
+#include <drm_fourcc.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <unistd.h>
+#include <climits>
+#include <sys/stat.h>
+
+namespace irisva {
+namespace {
+using Clock = std::chrono::steady_clock;
+struct SavedEgl {
+    EGLDisplay display = eglGetCurrentDisplay();
+    EGLContext context = eglGetCurrentContext();
+    EGLSurface draw = eglGetCurrentSurface(EGL_DRAW), read = eglGetCurrentSurface(EGL_READ);
+    EGLenum api = eglQueryAPI();
+    ~SavedEgl() {
+        auto current = eglGetCurrentDisplay();
+        if (current != EGL_NO_DISPLAY)
+            eglMakeCurrent(current, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+        eglBindAPI(api);
+        if (display != EGL_NO_DISPLAY)
+            eglMakeCurrent(display, draw, read, context);
+    }
+};
+unsigned remaining_ms(Clock::time_point deadline) {
+    auto now = Clock::now();
+    check(now < deadline, "T880 GPU conversion deadline", VA_STATUS_ERROR_TIMEDOUT);
+    auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(deadline - now).count();
+    return unsigned(std::min<int64_t>(INT_MAX, std::max<int64_t>(1, ms)));
+}
+void wait_dma(int fd, short events, Clock::time_point deadline) {
+    pollfd p{fd, events, 0};
+    int ret;
+    do { ret = poll(&p, 1, remaining_ms(deadline)); } while (ret < 0 && errno == EINTR);
+    check(ret > 0 && (p.revents & events) && !(p.revents & (POLLERR | POLLHUP | POLLNVAL)),
+          "T880 GPU DMA reservation wait", VA_STATUS_ERROR_TIMEDOUT);
+}
+GLuint compile(GLenum type, const char *text) {
+    GLuint shader = glCreateShader(type);
+    check(shader, "T880 GPU shader allocation");
+    glShaderSource(shader, 1, &text, nullptr);
+    glCompileShader(shader);
+    GLint ok = 0;
+    glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+    if (!ok) {
+        glDeleteShader(shader);
+        check(false, "T880 GPU shader compilation");
+    }
+    return shader;
+}
+struct Layout {
+    unsigned width, height, stride;
+    size_t offset, size;
+};
+void validate(const Layout &l, unsigned bytes_per_texel) {
+    check(l.width && l.height && l.width <= 16384 && l.height <= 16384 &&
+          l.stride && l.stride <= 16384 &&
+          uint64_t(l.width) * bytes_per_texel <= l.stride &&
+          l.offset <= INT_MAX && l.offset <= l.size &&
+          uint64_t(l.stride) * l.height <= l.size - l.offset,
+          "T880 GPU plane bounds", VA_STATUS_ERROR_INVALID_PARAMETER);
+}
+}
+struct T880GpuDetiler::Impl {
+    int fd = -1;
+    gbm_device *gbm = nullptr;
+    EGLDisplay display = EGL_NO_DISPLAY;
+    EGLContext context = EGL_NO_CONTEXT;
+    bool initialized = false;
+    GLuint program = 0, vao = 0, fbo = 0;
+    GLint max_texture = 0;
+    PFNEGLCREATEIMAGEKHRPROC create = nullptr;
+    PFNEGLDESTROYIMAGEKHRPROC destroy = nullptr;
+    PFNGLEGLIMAGETARGETTEXTURE2DOESPROC bind = nullptr;
+    struct View {
+        Impl *owner;
+        EGLImageKHR image = EGL_NO_IMAGE_KHR;
+        GLuint texture = 0;
+        explicit View(Impl &o) : owner(&o) {}
+        View(const View &) = delete;
+        ~View() {
+            if (texture) glDeleteTextures(1, &texture);
+            if (image != EGL_NO_IMAGE_KHR) owner->destroy(owner->display, image);
+        }
+    };
+    // Cache owns only imported views; VA surface ownership stays with its caller.
+    struct TargetViews {
+        std::weak_ptr<Memory> memory;
+        unsigned width, height, stride, storage_height;
+        size_t offset, size;
+        std::unique_ptr<View> plane[2];
+    };
+    std::map<Memory *, TargetViews> targets;
+    struct SourceViews {
+        std::array<Plane, 2> layout;
+        struct stat identity[2]{};
+        int fd[2] = {-1, -1}; // duplicate descriptors identify and pin imported storage
+        std::unique_ptr<View> plane[2];
+        ~SourceViews() { for (auto f : fd) if (f >= 0) close(f); }
+    };
+    std::vector<std::unique_ptr<SourceViews>> sources;
+    void current() {
+        check(eglBindAPI(EGL_OPENGL_ES_API) &&
+              eglMakeCurrent(display, EGL_NO_SURFACE, EGL_NO_SURFACE, context),
+              "T880 GPU current context");
+    }
+    std::unique_ptr<View> view(int dma, unsigned fourcc, const Layout &l) {
+        validate(l, fourcc == DRM_FORMAT_GR88 ? 2 : 1);
+        check(dma >= 0, "T880 GPU invalid DMA fd");
+        auto v = std::make_unique<View>(*this);
+        EGLint a[] = {EGL_WIDTH, EGLint(l.width), EGL_HEIGHT, EGLint(l.height),
+            EGL_LINUX_DRM_FOURCC_EXT, EGLint(fourcc), EGL_DMA_BUF_PLANE0_FD_EXT, dma,
+            EGL_DMA_BUF_PLANE0_OFFSET_EXT, EGLint(l.offset),
+            EGL_DMA_BUF_PLANE0_PITCH_EXT, EGLint(l.stride),
+            EGL_DMA_BUF_PLANE0_MODIFIER_LO_EXT, 0, EGL_DMA_BUF_PLANE0_MODIFIER_HI_EXT, 0,
+            EGL_NONE};
+        v->image = create(display, EGL_NO_CONTEXT, EGL_LINUX_DMA_BUF_EXT, nullptr, a);
+        check(v->image != EGL_NO_IMAGE_KHR, "T880 GPU linear plane import");
+        glGenTextures(1, &v->texture);
+        glBindTexture(GL_TEXTURE_2D, v->texture);
+        bind(GL_TEXTURE_2D, v->image);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        check(glGetError() == GL_NO_ERROR, "T880 GPU texture binding");
+        return v;
+    }
+    explicit Impl(int render_fd) {
+        SavedEgl saved;
+        try {
+            fd = fcntl(render_fd, F_DUPFD_CLOEXEC, 0);
+            check(fd >= 0, "T880 GPU duplicate render fd");
+            gbm = gbm_create_device(fd);
+            check(gbm, "T880 GPU private GBM device");
+            auto platform = reinterpret_cast<PFNEGLGETPLATFORMDISPLAYEXTPROC>(eglGetProcAddress("eglGetPlatformDisplayEXT"));
