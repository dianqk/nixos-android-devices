+// SPDX-License-Identifier: MIT
+#pragma once
+#include "internal.hpp"
+#include <array>
+namespace irisva {
+class T880GpuDetiler {
+    struct Impl;
+    std::unique_ptr<Impl> impl_;
+  public:
+    struct Plane {
+        int fd = -1;
+        unsigned stride = 0, storage_height = 0;
+        size_t offset = 0, size = 0;
+    };
+    explicit T880GpuDetiler(int render_fd);
+    ~T880GpuDetiler();
+    void detile(const std::array<Plane, 2> &source, const std::shared_ptr<Memory> &target,
+                unsigned width, unsigned height, std::chrono::milliseconds remaining);
+};
+}
