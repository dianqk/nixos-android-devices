+// SPDX-License-Identifier: MIT
+// Header/state tests do not open a decoder or claim hardware validation.
+#include "../src/av1.cpp"
+#include <functional>
+#include <iostream>
+using namespace irisva;
+void require(bool value) {
+    if (!value)
+        throw std::runtime_error("AV1 test assertion failed");
+}
+void rejects(const std::function<void()> &f, VAStatus status) {
+    try {
+        f();
+    } catch (const Error &e) {
+        require(e.status == status);
+        return;
+    }
+    throw std::runtime_error("invalid AV1 request accepted");
+}
+Av1Picture key() {
+    Av1Picture pic{};
+    pic.has_params = true;
+    auto &p = pic.params;
+    p.current_frame = 1;
+    p.frame_width_minus1 = p.frame_height_minus1 = 127;
+    p.tile_cols = p.tile_rows = 1;
+    p.base_qindex = 80;
+    p.matrix_coefficients = 2;
+    p.seq_info_fields.fields.subsampling_x = p.seq_info_fields.fields.subsampling_y = 1;
+    p.seq_info_fields.fields.enable_order_hint = 1;
+    p.order_hint_bits_minus_1 = 6;
+    p.pic_info_fields.bits.show_frame = 1;
+    p.pic_info_fields.bits.error_resilient_mode = 1;
+    p.pic_info_fields.bits.uniform_tile_spacing_flag = 1;
+    std::fill(std::begin(p.ref_frame_map), std::end(p.ref_frame_map), VA_INVALID_SURFACE);
+    Av1Slice tile{};
+    tile.bytes = {0};
+    pic.slices.push_back(tile);
+    return pic;
+}
+int main() {
+    // AV1 segmentation uses signed two's complement, not magnitude/sign coding.
+    Bits signed_value;
+    signed_value.su(-55, 9);
+    require(signed_value.data == std::vector<uint8_t>({0xe4, 0x80}));
+    Bits singleton;
+    singleton.ns(0, 1);
+    require(singleton.data.empty());
+    rejects([&] { singleton.ns(1, 1); }, VA_STATUS_ERROR_INVALID_BUFFER);
+    rejects([&] { singleton.put(8, 3); }, VA_STATUS_ERROR_INVALID_BUFFER);
+    rejects([&] { singleton.su(-65, 7); }, VA_STATUS_ERROR_INVALID_BUFFER);
+
+    auto pic = key();
+    Av1State state;
+    auto first = av1_bitstream(pic, state, VA_FOURCC_NV12);
+    require(first.replay.empty() && !first.picture.empty());
+    for (const auto &slot : state.slots)
+        require(slot.surface == 1);
+    pic.params.current_frame = 2;
+    pic.params.order_hint = 1;
+    pic.params.pic_info_fields.bits.frame_type = 1;
+    pic.params.pic_info_fields.bits.error_resilient_mode = 0;
+    std::fill(std::begin(pic.params.ref_frame_map), std::end(pic.params.ref_frame_map), 1);
+    auto second = av1_bitstream(pic, state, VA_FOURCC_NV12);
+    require(second.replay.empty());
+    for (const auto &slot : state.slots)
+        require(slot.surface == 1);
+    auto pending = state.pending_packet;
+    size_t bit = state.refresh_bit;
+    pic.params.current_frame = 3;
+    pic.params.order_hint = 2;
+    pic.params.ref_frame_map[6] = 2;
+    pic.params.ref_frame_idx[0] = 6;
+    auto third = av1_bitstream(pic, state, VA_FOURCC_NV12);
+    require(!third.replay.empty() && third.replay.size() == pending.size());
+    for (unsigned i = 0; i < 8; ++i)
+        require(((third.replay[(bit + i) / 8] >> (7 - (bit + i) % 8)) & 1) ==
+                ((0x40 >> (7 - i)) & 1));
+    for (unsigned i = 0; i < 8; ++i)
+        require(state.slots[i].surface == (i == 6 ? 2u : 1u));
+    pic.params.current_frame = 4;
+    pic.params.ref_frame_map[6] = 99;
+    rejects([&] { av1_bitstream(pic, state, VA_FOURCC_NV12); }, VA_STATUS_ERROR_UNIMPLEMENTED);
+
+    // Fill all eight VA slots, then keep rotating references without guessing
+    // which of the seven current references may be needed by future frames.
+    Av1State full_state;
+    auto full = key();
+    av1_bitstream(full, full_state, VA_FOURCC_NV12);
+    std::array<VASurfaceID, 8> map;
+    map.fill(1);
+    full.params.pic_info_fields.bits.frame_type = 1;
+    full.params.pic_info_fields.bits.error_resilient_mode = 0;
+    for (unsigned frame = 2; frame <= 20; ++frame) {
+        if (frame > 2)
+            map[(frame - 3) % 8] = frame - 1;
+        std::copy(map.begin(), map.end(), full.params.ref_frame_map);
+        for (unsigned i = 0; i < 7; ++i)
+            full.params.ref_frame_idx[i] = i;
+        full.params.current_frame = frame;
+        full.params.order_hint = frame - 1;
+        auto packets = av1_bitstream(full, full_state, VA_FOURCC_NV12);
+        require((frame == 2) == packets.replay.empty());
+        for (unsigned i = 0; i < 8; ++i)
+            require(full_state.slots[i].surface == map[i]);
+    }
+
+    auto bad = key();
+    bad.params.bit_depth_idx = 1;
+    rejects(
+        [&] {
+            Av1State s;
+            av1_bitstream(bad, s, VA_FOURCC_NV12);
+        },
+        VA_STATUS_ERROR_UNSUPPORTED_RT_FORMAT);
+    {
+        Av1State s;
+        require(!av1_bitstream(bad, s, VA_FOURCC_P010).picture.empty());
+    }
+    bad = key();
+    bad.params.film_grain_info.film_grain_info_fields.bits.apply_grain = 1;
+    rejects(
+        [&] {
+            Av1State s;
+            av1_bitstream(bad, s, VA_FOURCC_NV12);
+        },
+        VA_STATUS_ERROR_UNIMPLEMENTED);
+    bad = key();
+    bad.params.pic_info_fields.bits.use_superres = 1;
+    rejects(
+        [&] {
+            Av1State s;
+            av1_bitstream(bad, s, VA_FOURCC_NV12);
+        },
+        VA_STATUS_ERROR_UNIMPLEMENTED);
+    bad = key();
+    bad.params.tile_cols = 2;
+    bad.slices.push_back(bad.slices[0]);
+    rejects(
+        [&] {
+            Av1State s;
+            av1_bitstream(bad, s, VA_FOURCC_NV12);
+        },
+        VA_STATUS_ERROR_INVALID_BUFFER);
+    bad = key();
+    bad.slices[0].params.tile_column = 1;
+    rejects(
+        [&] {
+            Av1State s;
+            av1_bitstream(bad, s, VA_FOURCC_NV12);
+        },
+        VA_STATUS_ERROR_INVALID_BUFFER);
+    bad = key();
+    bad.slices.clear();
+    rejects(
+        [&] {
+            Av1State s;
+            av1_bitstream(bad, s, VA_FOURCC_NV12);
+        },
+        VA_STATUS_ERROR_INVALID_BUFFER);
+    bad = key();
+    bad.params.seq_info_fields.fields.enable_order_hint = 0;
+    {
+        Av1State s;
+        require(!av1_bitstream(bad, s, VA_FOURCC_NV12).picture.empty());
+    }
+    std::cout << "AV1 header, reference replay, format and rejection tests passed\n";
+}
