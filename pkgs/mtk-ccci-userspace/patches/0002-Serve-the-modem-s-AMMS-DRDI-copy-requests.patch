new file mode 100644
index 0000000..976451a
--- /dev/null
+++ b/src/mtk_ccci_userspace/mtk_drdi.py
@@ -0,0 +1,84 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""AMMS DRDI copy service (IPC_RPC_AMMS_DRDI_CONTROL, 0x4014).
+
+The modem's dynamic radio settings (DRDI) are not part of the image LK
+loads: the modem asks the AP to copy pieces of the "md1drdi" entry of the
+modem partition into the DRDI shared memory, which the AP maps through
+/dev/ccci_rpc. Protocol as observed on a running Android (file and port
+traffic of its RPC daemon only):
+
+request: one 188-byte block, u8 type, u8 sequence, u16 0, then u32 words
+  type 1 (start): byte 4 carries the DRDI version; reply {0, seq<<8, version}
+  type 2 (copy):  word 1 = last-request flag, then 15 triples
+                  (source offset in md1drdi, destination offset in the
+                  shared memory, size); size 0 = unused; reply
+                  {0, seq<<8, 0xff (more) or 0 (last)}
+Both replies are two blocks: int32 status, 8 bytes.
+
+The partition is only read. Offsets are checked against the entry and the
+shared memory window.
+"""
+import mmap
+import os
+import struct
+
+DRDI_CONTROL = 0x4014
+SMEM_SIZE = 0x10000
+ENTRY_MAGIC = 0x58881688
+ENTRY_HEADER = 0x200
+TRIPLES = 15
+
+
+def find_entry(fd, name, limit=64):
+    """(data offset, size) of a named entry of the MediaTek partition container."""
+    off = 0
+    for _ in range(limit):
+        hdr = os.pread(fd, ENTRY_HEADER, off)
+        if len(hdr) < 40:
+            break
+        magic, size = struct.unpack_from('<II', hdr)
+        if magic != ENTRY_MAGIC:
+            break
+        entry = hdr[8:40].split(b'\0', 1)[0].decode('ascii', 'replace')
+        if entry == name:
+            return off + ENTRY_HEADER, size
+        off = (off + ENTRY_HEADER + size + 15) & ~15
+    raise ValueError('no %s entry in the modem partition' % name)
+
+
+class DrdiService:
+    def __init__(self, rpc_fd, image, log):
+        self.log = log
+        self.image = os.open(image, os.O_RDONLY | os.O_CLOEXEC)
+        self.base, self.size = find_entry(self.image, 'md1drdi')
+        self.smem = mmap.mmap(rpc_fd, SMEM_SIZE, mmap.MAP_SHARED,
+                              mmap.PROT_READ | mmap.PROT_WRITE)
+        log('DRDI: %s md1drdi at %#x size %#x, shared memory mapped'
+            % (image, self.base, self.size))
+
+    def handle(self, block):
+        if len(block) < 8 + 12 * TRIPLES:
+            raise ValueError('short DRDI request (%d bytes)' % len(block))
+        kind, seq = block[0], block[1]
+        if kind == 1:
+            version = block[4]
+            return struct.pack('<II', seq << 8, version), \
+                'start seq=%d version=%d' % (seq, version)
+        if kind != 2:
+            raise ValueError('unknown DRDI request type %d' % kind)
+        last = struct.unpack_from('<I', block, 4)[0]
+        copied = []
+        for i in range(TRIPLES):
+            src, dst, n = struct.unpack_from('<III', block, 8 + 12 * i)
+            if not n:
+                continue
+            if src + n > self.size or dst + n > SMEM_SIZE:
+                raise ValueError('DRDI copy out of range: %#x->%#x+%#x' % (src, dst, n))
+            data = os.pread(self.image, n, self.base + src)
+            if len(data) != n:
+                raise ValueError('short read at %#x' % (self.base + src))
+            self.smem[dst:dst + n] = data
+            copied.append('%#x->%#x+%#x' % (src, dst, n))
+        status = 0 if last else 0xff
+        return struct.pack('<II', seq << 8, status), \
+            'copy seq=%d last=%d %s' % (seq, last, ' '.join(copied))
