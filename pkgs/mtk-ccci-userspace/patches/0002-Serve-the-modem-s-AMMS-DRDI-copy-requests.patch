     while True:
         try:
             raw = os.read(fd, 4096)
@@ -136,7 +156,7 @@ def rpc_reader(fd, evidence_dir, log):
         op = struct.unpack_from('<I', raw, 16)[0] if len(raw) >= 20 else -1
         log('RPC-REQ #%d len=%d op=0x%x raw=%s' % (n, len(raw), op, raw.hex()))
