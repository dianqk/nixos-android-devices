diff --git a/tests/test_drdi.py b/tests/test_drdi.py
new file mode 100644
index 0000000..694e916
--- /dev/null
+++ b/tests/test_drdi.py
@@ -0,0 +1,69 @@
+import importlib.util
+import os
+from pathlib import Path
+import struct
+import sys
+import tempfile
+
+SRC = Path(__file__).parents[1] / "src/mtk_ccci_userspace"
+sys.path.insert(0, str(SRC))
+spec = importlib.util.spec_from_file_location("rpc_sar_drdi", SRC / "qqc_rpc_sar.py")
+rpc_sar = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(rpc_sar)
+import mtk_drdi  # noqa: E402
+
+
+def entry(name, data):
+    hdr = struct.pack("<II", mtk_drdi.ENTRY_MAGIC, len(data)) + name.encode().ljust(32, b"\0")
+    hdr = hdr.ljust(mtk_drdi.ENTRY_HEADER, b"\xff")
+    blob = hdr + data
+    return blob + b"\0" * ((-len(blob)) & 15)
+
+
+def frame(block, seq=1):
+    body = struct.pack("<II", 0x4014, 1) + struct.pack("<I", len(block)) + block
+    return struct.pack("<4I", 0, 16 + len(body), 0x80000020 | (seq << 16), 0) + body
+
+
+def request(kind, seq, words):
+    block = bytes([kind, seq, 0, 0]) + b"".join(struct.pack("<I", w) for w in words)
+    return block.ljust(188, b"\0")
+
+
+def test_drdi_start_and_copies():
+    drdi_data = bytes(range(256)) * 64
+    image = entry("md1rom", b"r" * 777) + entry("cert1md", b"c" * 33) + entry("md1drdi", drdi_data)
+    with tempfile.TemporaryDirectory() as d:
+        img = os.path.join(d, "modem")
+        Path(img).write_bytes(image)
+        smem_path = os.path.join(d, "smem")
+        Path(smem_path).write_bytes(b"\0" * mtk_drdi.SMEM_SIZE)
+        fd = os.open(smem_path, os.O_RDWR)
+        svc = mtk_drdi.DrdiService(fd, img, lambda m: None)
+        start = bytes([1, 1, 0x47, 0x50, 3]).ljust(188, b"\0")
+        reply, note = rpc_sar.rpc_reply(frame(start), svc)
+        assert reply[-8:] == struct.pack("<II", 0x100, 3), note
+        words = [0] * 46
+        words[0] = 0                      # not last
+        words[19:22] = [0x100, 0x0, 0x40]  # triple 6
+        reply, note = rpc_sar.rpc_reply(frame(request(2, 2, words), 2), svc)
+        assert reply[-8:] == struct.pack("<II", 0x200, 0xFF), note
+        words = [0] * 46
+        words[0] = 1                      # last
+        words[1:4] = [0x10, 0x40, 0x20]
+        words[4:7] = [0x200, 0x60, 0x10]
+        reply, note = rpc_sar.rpc_reply(frame(request(2, 3, words), 3), svc)
+        assert reply[-8:] == struct.pack("<II", 0x300, 0), note
+        os.close(fd)
+        smem = Path(smem_path).read_bytes()
+        assert smem[0:0x40] == drdi_data[0x100:0x140]
+        assert smem[0x40:0x60] == drdi_data[0x10:0x30]
+        assert smem[0x60:0x70] == drdi_data[0x200:0x210]
+        bad = [0] * 46
+        bad[1:4] = [len(drdi_data) - 4, 0, 0x10]
+        try:
+            rpc_sar.rpc_reply(frame(request(2, 4, bad), 4), svc)
+        except ValueError:
+            pass
+        else:
+            raise AssertionError("out-of-range copy accepted")
