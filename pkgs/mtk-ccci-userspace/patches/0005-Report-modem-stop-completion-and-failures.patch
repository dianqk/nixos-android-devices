diff --git a/tests/test_stop.py b/tests/test_stop.py
--- /dev/null
+++ b/tests/test_stop.py
@@ -0,0 +1,121 @@
+"""Run owner shutdown functions without importing its device-serving module."""
+import ast
+import errno
+import io
+from pathlib import Path
+import struct
+import types
+
+SOURCE = Path(__file__).resolve().parents[1] / "src/mtk_ccci_userspace/mdinit.py"
+
+
+def owner(samples=(), request_error=None, raw_error=None):
+    tree = ast.parse(SOURCE.read_text())
+    body = [node for node in tree.body if isinstance(node, ast.FunctionDef)
+            and node.name in ("md_stop_hw", "bye")]
+    body += [node for node in tree.body if isinstance(node, ast.Assign)
+             and any(isinstance(t, ast.Name) and t.id in
+                     ("CCCI_IOC_DO_STOP_MD", "CCCI_IOC_GET_MD_STATE") for t in node.targets)]
+    rows = list(samples) or [(0, "md1:4")]
+    clock = [0.0]
+    logs, closed, requests, queries = [], [], [], []
+    current = [rows[0]]
+
+    def ioctl(fd, command, buf, mutate):
+        if command == namespace["CCCI_IOC_DO_STOP_MD"]:
+            requests.append(command)
+            if request_error:
+                raise request_error
+            return 0
+        queries.append(command)
+        row = rows.pop(0) if len(rows) > 1 else rows[0]
+        current[0] = row
+        if isinstance(row, OSError):
+            raise row
+        buf[:] = struct.pack("<I", row[0])
+        return 0
+
+    def read_raw(path, mode):
+        assert path == "/sys/kernel/ccci/boot" and mode == "r"
+        if raw_error:
+            raise raw_error
+        return io.StringIO(current[0][1] + " | extra diagnostics\n")
+
+    def sleep(seconds):
+        clock[0] += seconds
+
+    def exit_status(status):
+        raise SystemExit(status)
+
+    namespace = {"mon_fd": 10, "fs_fd": 11, "rpc_fd": 12,
+                 "struct": struct, "errno": errno, "log": logs.append,
+                 "fcntl": types.SimpleNamespace(ioctl=ioctl), "open": read_raw,
+                 "time": types.SimpleNamespace(monotonic=lambda: clock[0], sleep=sleep),
+                 "os": types.SimpleNamespace(close=closed.append),
+                 "sys": types.SimpleNamespace(exit=exit_status)}
+    exec(compile(ast.Module(body=body, type_ignores=[]), str(SOURCE), "exec"), namespace)
+    return namespace, logs, closed, requests, queries, clock
+
+
+def test_stop_contract():
+    # Public INVALID/EXCEPTION are not physical stop completion.
+    for sample in [(0, "md1:4"), (3, "md1:5"), (0, "md1:0"),
+                   (9, "md1:1"), (0, "md1:99"), (0, "unknown")]:
+        ns, logs, _, requests, _, _ = owner([sample])
+        assert ns["md_stop_hw"]() is False
+        assert len(requests) == 1 and not any("completion observed" in s for s in logs)
+    for error in [OSError(errno.EIO, "failed"), OSError(errno.ETIMEDOUT, "failed")]:
+        ns, _, _, _, queries, _ = owner(request_error=error)
+        assert ns["md_stop_hw"]() is False and not queries
+        ns, _, _, _, queries, _ = owner([error])
+        assert ns["md_stop_hw"]() is False and len(queries) == 1
+    ns, _, _, _, _, _ = owner([(0, "md1:1")], raw_error=OSError(errno.EIO, "read"))
+    assert ns["md_stop_hw"]() is False
+    # Accepted STOP can be queued behind START while the old raw state is GATED.
+    busy = OSError(errno.EINPROGRESS, "pending stop")
+    ns, logs, _, requests, queries, _ = owner([busy, busy, (0, "md1:1")])
+    assert ns["md_stop_hw"]() is True and len(queries) == 3 and len(requests) == 1
+    assert logs[-1] == "GATED stop completion observed"
+    ns, _, _, _, queries, clock = owner([busy])
+    assert ns["md_stop_hw"]() is False and clock[0] >= 4 and len(queries) <= 41
+    # Request accepted first; the later GET reports the asynchronously latched errno.
+    ns, _, _, requests, queries, _ = owner([(0, "md1:4"), OSError(errno.EBUSY, "stop failed")])
+    assert ns["md_stop_hw"]() is False and len(requests) == 1 and len(queries) == 2
+    ns, _, _, requests, _, _ = owner()
+    ns["mon_fd"] = None
+    assert ns["md_stop_hw"]() is True and not requests
+
+
+def test_bye_status_and_cleanup():
+    for result in [True, False, RuntimeError("failure")]:
+        ns, _, closed, _, _, _ = owner()
+
+        def stop():
+            if isinstance(result, Exception):
+                raise result
+            return result
+
+        ns["md_stop_hw"] = stop
+        ns["rpc_fd"] = ns["fs_fd"]  # Each owned descriptor is closed only once.
+        try:
+            ns["bye"](15, None)
+        except SystemExit as status:
+            assert status.code == (0 if result is True else 1)
+        else:
+            raise AssertionError("bye did not exit")
+        assert closed == [11, 10]
+    # Execute the actual lifetime-expiry tail, not a duplicate shutdown model.
+    tree = ast.parse(SOURCE.read_text())
+    last = tree.body[-1]
+    assert isinstance(last, ast.Expr) and isinstance(last.value, ast.Call)
+    assert isinstance(last.value.func, ast.Name) and last.value.func.id == "bye"
+    calls = []
+    exec(compile(ast.Module(body=[last], type_ignores=[]), str(SOURCE), "exec"),
+         {"bye": lambda signum, frame: calls.append((signum, frame))})
+    assert calls == [(0, None)]
+
+
+if __name__ == "__main__":
+    test_stop_contract()
+    test_bye_status_and_cleanup()
+    print("Owner production AST stop completion/error/cleanup PASS")
