@@ -10,9 +10,19 @@ import runpy
 import subprocess
 import sys
 
-PROTECTED = {
-    "nvdata": "nvdata", "nvcfg": "nvcfg", "protect_f": "protect1",
-    "protect_s": "protect2", "mcf_ota": "mcf_ota_a",
+# Read-only modem partitions per board: mount point under the vendor root ->
+# GPT partition label.
+BOARDS = {
+    "qqcandy": {
+        "nvdata": "nvdata", "nvcfg": "nvcfg", "protect_f": "protect1",
+        "protect_s": "protect2", "mcf_ota": "mcf_ota_a",
+    },
+    # Alldocube iPlay 80 mini Ultra (MT6897): Android mounts the modem OTA
+    # store at /mnt/vendor/mdota; Linux boots slot A, whose LK loads md1img_a.
+    "t880": {
+        "nvdata": "nvdata", "nvcfg": "nvcfg", "protect_f": "protect1",
+        "protect_s": "protect2", "mdota": "mcf_ota_a",
+    },
 }
 
 
@@ -42,8 +52,10 @@ def validate_write_root(path, protected):
 def preflight():
     if os.geteuid() != 0:
         raise RuntimeError("modem owner requires root")
-    if os.environ.get("MTK_CCCI_BOARD") != "qqcandy":
-        raise RuntimeError("only the explicitly selected qqcandy profile is supported")
+    board = os.environ.get("MTK_CCCI_BOARD")
+    if board not in BOARDS:
+        raise RuntimeError("only an explicitly selected known board profile is supported")
+    protected_mounts = BOARDS[board]
     expected_release = os.environ.get("MTK_CCCI_EXPECTED_KERNEL", "")
     expected_notes = os.environ.get("MTK_CCCI_EXPECTED_NOTES_SHA256", "")
     if not expected_release or len(expected_notes) != 64:
@@ -60,8 +72,8 @@ def preflight():
             raise RuntimeError(f"missing device node: {name}")
 
     vendor = Path(os.environ.get("MTK_CCCI_VENDOR_ROOT", "/mnt/vendor"))
-    protected = [vendor / name for name in PROTECTED]
-    for name, label in PROTECTED.items():
+    protected = [vendor / name for name in protected_mounts]
+    for name, label in protected_mounts.items():
         target = vendor / name
         result = subprocess.run(
             ["findmnt", "--json", "--output", "TARGET,SOURCE,OPTIONS", "--mountpoint", str(target)],
